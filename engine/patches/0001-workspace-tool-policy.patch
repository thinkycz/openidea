+#[cfg(test)]
+mod execution_policy_tests {
+    #[test]
+    fn restricted_launch_cannot_write_a_marker() {
+        let directory = tempfile::tempdir().unwrap();
+        let marker = directory.path().join("executed");
+        let mut command = std::process::Command::new("sh");
+        command
+            .arg("-c")
+            .arg("printf executed > \"$1\"")
+            .arg("guard-test")
+            .arg(&marker);
+        let result = super::run_command_with_permission(
+            &mut command,
+            std::time::Duration::from_secs(1),
+            &std::sync::atomic::AtomicBool::new(false),
+            "test project tool",
+            None,
+            || false,
+        );
+        assert!(result.unwrap_err().contains("disabled"));
+        assert!(!marker.exists());
+    }
+
+    #[test]
+    fn grants_are_exact_and_revocation_is_observed_by_running_services() {
+        let directory = tempfile::tempdir().unwrap();
+        let registry = directory.path().join("trust.json");
+        let workspace = directory.path().join("project");
+        let grant = super::ProjectToolGrant {
+            registry: registry.clone(),
+            workspace: workspace.clone(),
+        };
+        assert!(!grant.allowed());
+        std::fs::write(
+            &registry,
+            serde_json::json!({"schema": 1, "workspaces": [workspace]}).to_string(),
+        )
+        .unwrap();
+        assert!(grant.allowed());
+        let nested = super::ProjectToolGrant {
+            registry: registry.clone(),
+            workspace: workspace.join("nested"),
+        };
+        assert!(!nested.allowed());
+        std::fs::write(&registry, "invalid").unwrap();
+        assert!(!grant.allowed());
+        std::fs::write(&registry, r#"{"schema": 1, "workspaces": []}"#).unwrap();
+        assert!(!grant.allowed());
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn revoking_permission_stops_a_running_tool() {
+        let calls = std::cell::Cell::new(0);
+        let mut command = std::process::Command::new("sleep");
+        command.arg("10");
+        let start = std::time::Instant::now();
+        let result = super::run_command_with_permission(
+            &mut command,
+            std::time::Duration::from_secs(5),
+            &std::sync::atomic::AtomicBool::new(false),
+            "test tool",
+            None,
+            || {
+                calls.set(calls.get() + 1);
+                calls.get() < 3
+            },
+        );
+        assert!(result.unwrap_err().contains("revoked"));
+        assert!(start.elapsed() < std::time::Duration::from_secs(2));
+    }
+}

 //! stdout/stderr draining, binary auto-detection, and tool-reported
 //! path matching.
 
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::{path::PathBuf, sync::OnceLock};
+
+static PROJECT_TOOLS_ALLOWED: AtomicBool = AtomicBool::new(true);
+static PROJECT_TOOL_GRANT: OnceLock<ProjectToolGrant> = OnceLock::new();
+
+struct ProjectToolGrant {
+    registry: PathBuf,
+    workspace: PathBuf,
+}
+
+impl ProjectToolGrant {
+    fn allowed(&self) -> bool {
+        #[derive(serde::Deserialize)]
+        struct Grants {
+            schema: u32,
+            workspaces: Vec<PathBuf>,
+        }
+        std::fs::read(&self.registry)
+            .ok()
+            .and_then(|content| serde_json::from_slice::<Grants>(&content).ok())
+            .is_some_and(|grants| grants.schema == 1 && grants.workspaces.contains(&self.workspace))
+    }
+}
+
+pub(crate) fn require_project_tool_grant(registry: PathBuf, workspace: PathBuf) {
+    // Configured once, before the backend or any worker is constructed.
+    if PROJECT_TOOL_GRANT
+        .set(ProjectToolGrant {
+            registry,
+            workspace,
+        })
+        .is_err()
+    {
+        restrict_project_tools();
+    }
+}
+
+pub(crate) fn restrict_project_tools() {
+    PROJECT_TOOLS_ALLOWED.store(false, Ordering::Release);
+}
+
+pub(crate) fn project_tools_allowed() -> bool {
+    PROJECT_TOOLS_ALLOWED.load(Ordering::Acquire)
+        && PROJECT_TOOL_GRANT
+            .get()
+            .is_none_or(ProjectToolGrant::allowed)
+}

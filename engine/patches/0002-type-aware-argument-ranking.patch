+async fn ranked_variables_with_backend(backend: &Backend, text: &str) -> Vec<CompletionItem> {
+    let uri = Url::parse("file:///argument-ranking.php").unwrap();
+    let position = crate::common::position_after(text, "/*complete*/$");
+    let mut items = complete_at(backend, &uri, text, position.line, position.character).await;
+    items.retain(|item| item.kind == Some(CompletionItemKind::VARIABLE));
+    items.sort_by(|a, b| a.sort_text.cmp(&b.sort_text));
+    items
+}

 use crate::Backend;
 
 impl Backend {
+    /// Close unfinished delimiters at EOF for a query-local variable scope.
+    /// Appending preserves every original cursor and definition offset.
+    pub(super) fn patch_variable_at_eof(content: &str, position: Position) -> Option<String> {
+        let offset = crate::text_position::position_to_offset(content, position) as usize;
+        if !content.get(offset..)?.trim().is_empty() {
+            return None;
+        }
+        let prefix = content.get(..offset)?;
+        let bytes = prefix.as_bytes();
+        let mut stack = Vec::new();
+        let mut at = 0;
+        while at < bytes.len() {
+            if let Some(end) = crate::text_scan::skip_php_comment(bytes, at) {
+                at = end;
+                continue;
+            }
+            match bytes[at] {
+                b'\'' | b'"' => {
+                    at = crate::text_scan::skip_string_forward(bytes, at);
+                    continue;
+                }
+                b'(' => stack.push(')'),
+                b'[' => stack.push(']'),
+                b'{' => stack.push('}'),
+                b')' | b']' | b'}' if stack.pop()? != bytes[at] as char => {
+                    return None;
+                }
+                _ => {}
+            }
+            at += 1;
+        }
+        if stack.is_empty() {
+            return None;
+        }
+        let mut patched = prefix.to_owned();
+        if prefix.ends_with('$') {
+            patched.push_str("__phpantom_completion");
+        }
+        for close in stack.into_iter().rev() {
+            if close == '}' {
+                patched.push(';');
+            }
+            patched.push(close);
+        }
+        patched.push(';');
+        Some(patched)
+    }

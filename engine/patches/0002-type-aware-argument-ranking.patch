+//! Argument ranking over the shared forward walker's scope snapshot.
+
+use tower_lsp::lsp_types::{CompletionItem, Position};
+
+use crate::Backend;
+use crate::class_lookup::is_subtype_of_typed;
+use crate::text_position::position_to_offset;
+use crate::type_engine::resolver::LendsLoaders;
+use crate::type_engine::variable::forward_walk;
+use crate::types::{FileContext, ResolvedType};
+
+impl Backend {
+    /// Promote variables known to satisfy the active parameter, retaining
+    /// unknown and incompatible variables as ordinary fallback suggestions.
+    pub(crate) fn rank_variable_arguments(
+        &self,
+        items: &mut [CompletionItem],
+        uri: &str,
+        content: &str,
+        position: Position,
+        ctx: &FileContext,
+        prefix: &str,
+    ) {
+        let Some(expected) =
+            self.expected_variable_argument_type(uri, content, position, ctx, prefix)
+        else {
+            return;
+        };
+        let offset = position_to_offset(content, position);
+        let class_loader = self.class_loader(ctx);
+        let class_loaders = self.class_loaders(ctx);
+        let owned_loaders = self.diagnostic_loaders(ctx);
+        let _scope_guard = forward_walk::with_diagnostic_scope_cache();
+        // Walk the enclosing body once, rather than re-running inference for
+        // every visible candidate. The cache is dropped with this request.
+        forward_walk::build_diagnostic_scopes_for_offsets(
+            content,
+            &ctx.classes,
+            &class_loaders.as_dyn(),
+            Some(self),
+            owned_loaders.loaders(),
+            Some(&self.resolved_class_cache),
+            &[offset],
+        );
+        for item in items {
+            if item
+                .sort_text
+                .as_deref()
+                .is_some_and(|key| key.starts_with("z_"))
+            {
+                continue;
+            }
+            let mut compatible = false;
+            if let Some(types) = forward_walk::lookup_diagnostic_scope(&item.label, offset)
+                && !types.is_empty()
+            {
+                let actual = ResolvedType::types_joined(&types);
+                compatible = !actual.contains_mixed()
+                    && !actual.is_never()
+                    && is_subtype_of_typed(&actual, &expected, &class_loader);
+                item.detail = Some(actual.to_string());
+            }
+            item.sort_text = Some(format!(
+                "0_{}_{}",
+                u8::from(!compatible),
+                item.label.to_lowercase()
+            ));
+        }
+    }
+}

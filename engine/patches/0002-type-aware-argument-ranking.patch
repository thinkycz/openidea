+    /// Resolve the declared type of a directly entered variable argument.
+    /// Reuses signature-help call detection and the shared callable resolver.
+    pub(crate) fn expected_variable_argument_type(
+        &self,
+        uri: &str,
+        content: &str,
+        position: Position,
+        ctx: &FileContext,
+        prefix: &str,
+    ) -> Option<PhpType> {
+        let cursor = position_to_offset(content, position);
+        let map = self.symbol_maps.read().get(uri).cloned();
+        if let Some(map) = &map
+            && let Some(call) = map.find_enclosing_call_site(cursor)
+            && map.is_inside_nested_scope_of_call(cursor, call)
+        {
+            return None;
+        }
+        let site = map
+            .as_ref()
+            .and_then(|map| detect_call_site_from_map(map, content, position))
+            .or_else(|| detect_call_site_text_fallback(content, position))?;
+        let text = content.get(site.args_start..cursor as usize)?;
+        let args = crate::type_engine::types::conditional::split_text_args(text);
+        let current = trim_argument_trivia(args.last()?);
+        let (name, value) = crate::call_args::split_named_text_arg(current);
+        // An outer parameter does not determine the type of a variable
+        // nested in an array, binary expression, interpolation or spread.
+        if trim_argument_trivia(value) != prefix {
+            return None;
+        }
+        if args.iter().take(args.len() - 1).any(|arg| {
+            crate::call_args::text_arg_value(trim_argument_trivia(arg)).starts_with("...")
+        }) {
+            return None;
+        }
+        let target = self
+            .resolve_callable_target(&site.call_expression, content, position, ctx)
+            .or_else(|| {
+                // Callable types retain positional parameter types, but not
+                // PHP parameter names. Use them only for positional ranking;
+                // they must not invent names for diagnostics or named calls.
+                if name.is_some() {
+                    return None;
+                }
+                let parsed =
+                    crate::type_engine::subject_expr::SubjectExpr::parse(&site.call_expression);
+                let crate::type_engine::subject_expr::SubjectExpr::Variable(variable) = &parsed
+                else {
+                    return None;
+                };
+                use crate::type_engine::resolver::LendsLoaders;
+                let class_loader = self.class_loader(ctx);
+                let loaders = self.diagnostic_loaders(ctx);
+                let ty = crate::type_engine::variable::resolution::resolve_variable_php_type(
+                    variable,
+                    content,
+                    cursor,
+                    crate::class_lookup::find_class_at_offset(&ctx.classes, cursor),
+                    &ctx.classes,
+                    &class_loader,
+                    Some(self),
+                    loaders.loaders(),
+                )?;
+                crate::type_engine::call_resolution::callable_type_as_target(&ty)
+            })?;
+        let parameter = if let Some(name) = name {
+            target
+                .parameters
+                .iter()
+                .find(|param| param.name.trim_start_matches('$') == name)?
+        } else {
+            target
+                .parameters
+                .get(site.active_parameter as usize)
+                .or_else(|| target.parameters.last().filter(|param| param.is_variadic))?
+        };
+        parameter
+            .type_hint
+            .clone()
+            .filter(|hint| !hint.contains_mixed() && !hint.is_never())
     }
 

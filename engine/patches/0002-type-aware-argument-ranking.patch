+    let text = "<?php\nfunction take(string $v): void {}\nfunction demo(string $𐐀name): void { take(/*complete*/$𐐀); }\n";
+    let pos = crate::common::position_after(text, "/*complete*/$𐐀");
+    let items = complete_at(&backend, &uri, text, pos.line, pos.character).await;
+    let item = items.iter().find(|item| item.label == "$𐐀name").unwrap();

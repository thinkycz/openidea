+#[tokio::test]
+async fn named_argument_signature_tracks_declaration_not_comma_order() {
+    for (index, call, expected) in [
+        (0, "format(suffix: ", Some(1)),
+        (1, "format(suffix: 'Z', prefix: ", Some(0)),
+        (2, "format(/* ž 🐘 */ suffix: ", Some(1)),
+        (3, "format(prefix: 'A', suffix: ", Some(1)),
+        (4, "format(unknown: ", None),
+        (5, "format('A', ", Some(1)),
+        (6, "unicode(druhý: ", Some(1)),
+        (7, "format(suffix /* label */ : ", Some(1)),
+        (8, "format(suffix\t: ", Some(1)),
+    ] {
+        let backend = create_test_backend();
+        let uri = Url::parse(&format!("file:///named_signature_{index}.php")).unwrap();
+        let text = format!(
+            "<?php\nfunction format(string $prefix, string $suffix): string {{ return $prefix.$suffix; }} function unicode(string $první, string $druhý): void {{}}\n{call}"
+        );
+        let character = call.encode_utf16().count() as u32;
+        let result = sig_help_at(&backend, &uri, &text, 2, character).await;
+        assert_eq!(result.as_ref().map(active_param), expected, "{call}");
+    }
+}
+
+#[tokio::test]
+async fn named_variadic_arguments_select_the_variadic_parameter() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///named_variadic_signature.php").unwrap();
+    let call = "format(extraName: ";
+    let text =
+        format!("<?php\nfunction format(string $prefix = '', int ...$extra): void {{}}\n{call}");
+    let result = sig_help_at(&backend, &uri, &text, 2, call.len() as u32)
+        .await
+        .unwrap();
+    assert_eq!(active_param(&result), 1);
+}

+// ── Type-aware return and property value suggestions ───────────────────────
+class ExpectedValueRankingDemo
+{
+    public string $label = '';
+
+    public function returned(int $aCount, string $zLabel): string
+    {
+        // Try: replace `$zLabel` with `$`; string values precede the count.
+        return $zLabel;
+    }
+
+    public function assigned(int $aCount, string $zLabel): void
+    {
+        // The declared string property supplies the same preference here.
+        $this->label = $zLabel;
+    }
+
+    public function deferred(int $aCount, string $zLabel): string
+    {
+        // Try the arrow body: its own return hint supplies the preference.
+        $label = fn(): string => $zLabel;
+        return $label();
+    }
+}

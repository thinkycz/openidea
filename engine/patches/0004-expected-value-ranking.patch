+//! Value-position context over the shared callable/property type metadata.
+
+use crate::atom::bytes_to_str;
+use crate::php_type::{PhpType, TypeKind};
+use crate::text_position::position_to_offset;
+use crate::type_engine::resolver::CtxLoaders;
+use crate::types::FileContext;
+use crate::{AccessKind, Backend};
+use mago_span::HasSpan;
+use mago_syntax::cst::*;
+use mago_syntax::walker::Walker;
+use std::borrow::Cow;
+use tower_lsp::lsp_types::Position;
+
+/// A value constraint discovered without walking the receiver's variable scope.
+pub(crate) enum ExpectedValue {
+    Declared(PhpType),
+    Property {
+        receiver: String,
+        name: String,
+        access: AccessKind,
+    },
+}
+
+impl ExpectedValue {
+    pub(crate) fn resolve(
+        self,
+        backend: &Backend,
+        content: &str,
+        position: Position,
+        file: &FileContext,
+    ) -> Option<PhpType> {
+        match self {
+            Self::Declared(ty) => Some(ty),
+            Self::Property {
+                receiver,
+                name,
+                access,
+            } => {
+                let cursor = position_to_offset(content, position);
+                let class_loader = backend.class_loader_with(
+                    &file.classes,
+                    file.use_map_at(cursor),
+                    file.namespace_at(cursor),
+                );
+                let function_loader = backend.function_loader(file);
+                let current = crate::class_lookup::find_class_at_offset(&file.classes, cursor);
+                let resolution = backend.resolution_ctx_at(
+                    current,
+                    &file.classes,
+                    content,
+                    cursor,
+                    CtxLoaders::without_macro_this(&class_loader, &function_loader),
+                );
+                let owners = crate::type_engine::resolver::resolve_target_classes(
+                    &receiver,
+                    access,
+                    &resolution,
+                );
+                if owners.is_empty() {
+                    return None;
+                }
+                let mut expected = None;
+                for owner in owners {
+                    let class = owner.class_info.as_ref()?;
+                    let args = match owner.type_string.kind() {
+                        TypeKind::Generic(generic) => generic.args.clone(),
+                        _ => crate::inheritance::default_type_args(class),
+                    };
+                    let strings: Vec<_> = args.iter().map(ToString::to_string).collect();
+                    let class = crate::virtual_members::resolve_class_fully_with_generics(
+                        class,
+                        &class_loader,
+                        Some(&backend.resolved_class_cache),
+                        &strings,
+                        &args,
+                    );
+                    let hint = crate::inheritance::resolve_property_type_hint(
+                        &class,
+                        &name,
+                        &class_loader,
+                    )?;
+                    // A union receiver must agree on the declaration. Choosing one
+                    // arm would advertise a preference that fails another arm.
+                    if expected.as_ref().is_some_and(|previous| *previous != hint) {
+                        return None;
+                    }
+                    expected = Some(hint);
+                }
+                expected.filter(usable_hint)
+            }
+        }
+    }
+}
+
+fn usable_hint(hint: &PhpType) -> bool {
+    !hint.contains_mixed() && !hint.is_never() && !hint.is_void() && !hint.is_untyped()
+}
+
+struct CallableValue {
+    ty: Option<PhpType>,
+    generator: bool,
+}
+
+struct ValueContext<'a> {
+    backend: &'a Backend,
+    file: &'a FileContext,
+    content: &'a str,
+    cursor: u32,
+    position: Position,
+    prefix: &'a str,
+    callables: Vec<CallableValue>,
+    expected: Option<ExpectedValue>,
+}
+
+impl ValueContext<'_> {
+    fn direct(&self, expr: &Expression<'_>) -> bool {
+        matches!(expr, Expression::Variable(Variable::Direct(variable))
+            if variable.span().start.offset as usize + self.prefix.len() == self.cursor as usize)
+    }
+
+    fn hint(&self, hint: Option<&FunctionLikeReturnTypeHint<'_>>) -> Option<PhpType> {
+        let ty = crate::parser::extract_hint_type(&hint?.hint);
+        let class = crate::class_lookup::find_class_at_offset(&self.file.classes, self.cursor);
+        let ty = if let Some(class) = class {
+            ty.resolve_self_refs(class.fqn().as_str(), class.parent_class.as_deref())
+        } else {
+            ty
+        };
+        let loader = self.backend.class_loader_with(
+            &self.file.classes,
+            self.file.use_map_at(self.cursor),
+            self.file.namespace_at(self.cursor),
+        );
+        Some(ty.resolve_names(&|name| {
+            loader(name).map_or_else(
+                || self.file.resolve_name_at(name, self.cursor),
+                |class| class.fqn().to_string(),
+            )
+        }))
+    }
+
+    fn return_value(&self) -> Option<PhpType> {
+        let callable = self.callables.last()?;
+        let ty = callable.ty.as_ref()?;
+        if callable.generator {
+            // A generator's function return hint describes the generator object;
+            // its `return` statement instead produces the fourth PHPDoc argument.
+            if let TypeKind::Generic(generic) = ty.kind()
+                && generic
+                    .name
+                    .as_str()
+                    .trim_start_matches('\\')
+                    .eq_ignore_ascii_case("Generator")
+                && generic.args.len() == 4
+            {
+                return Some(generic.args[3].clone());
+            }
+            return None;
+        }
+        Some(ty.clone())
+    }
+
+    fn property(&self, lhs: &Expression<'_>) -> Option<ExpectedValue> {
+        let (receiver, name, access) = match lhs {
+            Expression::Access(Access::Property(property)) => {
+                let ClassLikeMemberSelector::Identifier(name) = &property.property else {
+                    return None;
+                };
+                (property.object, bytes_to_str(name.value), AccessKind::Arrow)
+            }
+            Expression::Access(Access::StaticProperty(property)) => {
+                let Variable::Direct(name) = &property.property else {
+                    return None;
+                };
+                (
+                    property.class,
+                    bytes_to_str(name.name).trim_start_matches('$'),
+                    AccessKind::DoubleColon,
+                )
+            }
+            _ => return None,
+        };
+        let span = receiver.span();
+        let receiver = self
+            .content
+            .get(span.start.offset as usize..span.end.offset as usize)?;
+        Some(ExpectedValue::Property {
+            receiver: receiver.to_owned(),
+            name: name.to_owned(),
+            access,
+        })
+    }
+}
+
+struct YieldFinder;
+impl<'ast, 'arena> Walker<'ast, 'arena, bool> for YieldFinder {
+    fn walk_in_yield(&self, _: &'ast Yield<'arena>, found: &mut bool) {
+        *found = true;
+    }
+    fn walk_function(&self, _: &'ast Function<'arena>, _: &mut bool) {}
+    fn walk_method(&self, _: &'ast Method<'arena>, _: &mut bool) {}
+    fn walk_closure(&self, _: &'ast Closure<'arena>, _: &mut bool) {}
+    fn walk_arrow_function(&self, _: &'ast ArrowFunction<'arena>, _: &mut bool) {}
+}
+fn generator(body: &Block<'_>) -> bool {
+    let mut found = false;
+    for statement in body.statements.iter() {
+        YieldFinder.walk_statement(statement, &mut found);
+    }
+    found
+}
+
+struct ExpectedValueWalker;
+impl<'ast, 'arena, 'a> Walker<'ast, 'arena, ValueContext<'a>> for ExpectedValueWalker {
+    fn walk_statement(&self, node: &'ast Statement<'arena>, ctx: &mut ValueContext<'a>) {
+        let span = node.span();
+        if span.start.offset <= ctx.cursor && ctx.cursor <= span.end.offset {
+            mago_syntax::walker::walk_statement(self, node, ctx);
+        }
+    }
+    fn walk_expression(&self, node: &'ast Expression<'arena>, ctx: &mut ValueContext<'a>) {
+        let span = node.span();
+        if span.start.offset <= ctx.cursor && ctx.cursor <= span.end.offset {
+            mago_syntax::walker::walk_expression(self, node, ctx);
+        }
+    }
+    fn walk_method(&self, node: &'ast Method<'arena>, ctx: &mut ValueContext<'a>) {
+        let span = node.span();
+        if span.start.offset <= ctx.cursor && ctx.cursor <= span.end.offset {
+            mago_syntax::walker::walk_method(self, node, ctx);
+        }
+    }
+    fn walk_in_function(&self, node: &'ast Function<'arena>, ctx: &mut ValueContext<'a>) {
+        let ty = ctx
+            .backend
+            .resolve_callable_target(
+                bytes_to_str(node.name.value),
+                ctx.content,
+                ctx.position,
+                ctx.file,
+            )
+            .and_then(|callable| callable.return_type)
+            .or_else(|| ctx.hint(node.return_type_hint.as_ref()));
+        ctx.callables.push(CallableValue {
+            ty,
+            generator: generator(&node.body),
+        });
+    }
+    fn walk_out_function(&self, _: &'ast Function<'arena>, ctx: &mut ValueContext<'a>) {
+        ctx.callables.pop();
+    }
+    fn walk_in_method(&self, node: &'ast Method<'arena>, ctx: &mut ValueContext<'a>) {
+        let ty = ctx
+            .backend
+            .resolve_callable_target(
+                &format!("self::{}", bytes_to_str(node.name.value)),
+                ctx.content,
+                ctx.position,
+                ctx.file,
+            )
+            .and_then(|callable| callable.return_type)
+            .or_else(|| ctx.hint(node.return_type_hint.as_ref()));
+        let is_generator = match &node.body {
+            MethodBody::Concrete(body) => generator(body),
+            _ => false,
+        };
+        ctx.callables.push(CallableValue {
+            ty,
+            generator: is_generator,
+        });
+    }
+    fn walk_out_method(&self, _: &'ast Method<'arena>, ctx: &mut ValueContext<'a>) {
+        ctx.callables.pop();
+    }
+    fn walk_in_closure(&self, node: &'ast Closure<'arena>, ctx: &mut ValueContext<'a>) {
+        ctx.callables.push(CallableValue {
+            ty: ctx.hint(node.return_type_hint.as_ref()),
+            generator: generator(&node.body),
+        });
+    }
+    fn walk_out_closure(&self, _: &'ast Closure<'arena>, ctx: &mut ValueContext<'a>) {
+        ctx.callables.pop();
+    }
+    fn walk_in_arrow_function(
+        &self,
+        node: &'ast ArrowFunction<'arena>,
+        ctx: &mut ValueContext<'a>,
+    ) {
+        let ty = ctx.hint(node.return_type_hint.as_ref());
+        ctx.callables.push(CallableValue {
+            ty,
+            generator: false,
+        });
+        if ctx.direct(node.expression) {
+            ctx.expected = ctx
+                .return_value()
+                .filter(usable_hint)
+                .map(ExpectedValue::Declared);
+        }
+    }
+    fn walk_out_arrow_function(&self, _: &'ast ArrowFunction<'arena>, ctx: &mut ValueContext<'a>) {
+        ctx.callables.pop();
+    }
+    fn walk_in_property_hook(&self, _: &'ast PropertyHook<'arena>, ctx: &mut ValueContext<'a>) {
+        ctx.callables.push(CallableValue {
+            ty: None,
+            generator: false,
+        });
+    }
+    fn walk_out_property_hook(&self, _: &'ast PropertyHook<'arena>, ctx: &mut ValueContext<'a>) {
+        ctx.callables.pop();
+    }
+    fn walk_in_return(&self, node: &'ast Return<'arena>, ctx: &mut ValueContext<'a>) {
+        if node.value.is_some_and(|value| ctx.direct(value)) {
+            ctx.expected = ctx
+                .return_value()
+                .filter(usable_hint)
+                .map(ExpectedValue::Declared);
+        }
+    }
+    fn walk_in_assignment(&self, node: &'ast Assignment<'arena>, ctx: &mut ValueContext<'a>) {
+        if node.operator.is_assign() && ctx.direct(node.rhs) {
+            ctx.expected = ctx.property(node.lhs);
+        }
+    }
+}
+
+impl Backend {
+    /// The expected type of a directly entered variable in a value position.
+    pub(crate) fn expected_variable_value_context(
+        &self,
+        content: &str,
+        position: Position,
+        file: &FileContext,
+        prefix: &str,
+    ) -> Option<ExpectedValue> {
+        let cursor = position_to_offset(content, position);
+        // A bare `$` is incomplete PHP. Recovery stays after the cursor and never
+        // changes the original content, candidate inference or replacement range.
+        let source = if prefix == "$" {
+            let mut patched = String::with_capacity(content.len() + 19);
+            patched.push_str(&content[..cursor as usize]);
+            patched.push_str("_workbench_expected");
+            patched.push_str(&content[cursor as usize..]);
+            Cow::Owned(patched)
+        } else {
+            Cow::Borrowed(content)
+        };
+        crate::parser::with_parsed_program(
+            &source,
+            "expected_variable_value_context",
+            |program, _| {
+                let mut ctx = ValueContext {
+                    backend: self,
+                    file,
+                    content,
+                    cursor,
+                    position,
+                    prefix,
+                    callables: Vec::new(),
+                    expected: None,
+                };
+                for statement in program.statements.iter() {
+                    ExpectedValueWalker.walk_statement(statement, &mut ctx);
+                }
+                ctx.expected
+            },
+        )
+    }
+}

+/// Whether a built-in function's PHP introduction version is newer than the target.
+/// Only numeric PHP `@since` tags are used; extension release notes such as
+/// `@since PECL 1.0` are not PHP language-version constraints.
+pub fn is_stub_function_introduced_after(
+    source: &str,
+    func_name: &str,
+    php_version: crate::types::PhpVersion,
+) -> bool {
+    let short = func_name.rsplit('\\').next().unwrap_or(func_name);
+    let needle = format!("function {short}(");
+    let position = source
+        .find(&needle)
+        .or_else(|| source.find(&format!("function {short} ")));
+    position.is_some_and(|position| introduced_after_at(source, position, php_version))
+}
+
+/// Check a parsed stub function using its identifier offset, avoiding another
+/// whole-file name search while its sibling declarations are cached.
+pub(crate) fn is_stub_function_introduced_after_offset(
+    source: &str,
+    name_offset: usize,
+    php_version: crate::types::PhpVersion,
+) -> bool {
+    source
+        .get(..name_offset)
+        .and_then(|before| before.rfind("function"))
+        .is_some_and(|position| introduced_after_at(source, position, php_version))
+}
+
+fn introduced_after_at(source: &str, position: usize, version: crate::types::PhpVersion) -> bool {
+    let Some(docblock) = preceding_docblock(source, position) else {
+        return false;
+    };
+    let body = docblock
+        .get(3..docblock.len().saturating_sub(2))
+        .unwrap_or("");
+    body.lines().any(|line| {
+        let line = line.trim().trim_start_matches('*').trim();
+        let Some(since) = line
+            .strip_prefix("@since")
+            .and_then(|s| s.strip_prefix(char::is_whitespace))
+        else {
+            return false;
+        };
+        let Some(token) = since.split_whitespace().next() else {
+            return false;
+        };
+        let mut parts = token.split('.');
+        let (Some(major), Some(minor)) = (
+            parts.next().and_then(|v| v.parse::<u8>().ok()),
+            parts.next().and_then(|v| v.parse::<u8>().ok()),
+        ) else {
+            return false;
+        };
+        // Numeric PECL releases below PHP's major-version range are not PHP targets.
+        major >= 4 && version < crate::types::PhpVersion::new(major, minor)
+    })
+}
+
+fn preceding_docblock(source: &str, decl_pos: usize) -> Option<&str> {
+    let before = source.get(..decl_pos)?;
+    let doc_end = before.rfind("*/")?;
+    let between = &source[doc_end + 2..decl_pos];
+    if between.contains("function ")
+        || between.contains("class ")
+        || between.contains("interface ")
+        || between.contains("trait ")
+        || between.contains("enum ")
+        || between.contains("const ")
+    {
+        return None;
+    }
+    let doc_start = source[..doc_end].rfind("/**")?;
+    Some(&source[doc_start..doc_end + 2])
+}

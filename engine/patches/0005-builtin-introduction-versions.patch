+// Built-in introduction versions must apply before lazy parsing and after it.
+#[tokio::test]
+async fn builtin_since_versions_filter_completion_and_lazy_cache() {
+    use crate::common::complete_at;
+    use std::collections::HashMap;
+    use tower_lsp::lsp_types::Url;
+    const SOURCE: &str = "<?php\n/** @since 4.0 */\nfunction array_filter($array) {}\n/**\n * @since 8.4\n */\nfunction array_find($array, $callback) {}\n/**\n * @since 8.5\n */\nfunction array_first($array) {}\n";
+    for (version, find, first) in [
+        (PhpVersion::new(7, 4), false, false),
+        (PhpVersion::new(8, 4), true, false),
+        (PhpVersion::new(8, 5), true, true),
+    ] {
+        let functions = ["array_filter", "array_find", "array_first"]
+            .into_iter()
+            .map(|name| (name, SOURCE))
+            .collect();
+        let backend = Backend::new_test_with_all_stubs(HashMap::new(), functions, HashMap::new());
+        backend.set_php_version(version);
+        let uri = Url::parse("file:///target.php").unwrap();
+        let items = complete_at(&backend, &uri, "<?php\narray_f", 1, 7).await;
+        let labels: Vec<_> = items.iter().map(|i| i.label.as_str()).collect();
+        assert!(labels.contains(&"array_filter"));
+        assert_eq!(labels.contains(&"array_find"), find, "target {version:?}");
+        assert_eq!(labels.contains(&"array_first"), first, "target {version:?}");
+        assert!(backend.find_or_load_function(&["array_filter"]).is_some());
+        assert_eq!(
+            backend.find_or_load_function(&["array_find"]).is_some(),
+            find
+        );
+        assert_eq!(
+            backend.find_or_load_function(&["array_first"]).is_some(),
+            first
+        );
+        let items = complete_at(&backend, &uri, "<?php\nuse function array_f", 1, 20).await;
+        assert_eq!(
+            items
+                .iter()
+                .any(|i| i.filter_text.as_deref() == Some("array_find")),
+            find
+        );
+        assert_eq!(
+            items
+                .iter()
+                .any(|i| i.filter_text.as_deref() == Some("array_first")),
+            first
+        );
+    }
+}

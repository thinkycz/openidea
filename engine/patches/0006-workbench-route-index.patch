diff --git a/tests/integration/workbench_routes.rs b/tests/integration/workbench_routes.rs
new file mode 100644
index 0000000..068f45f
--- /dev/null
+++ b/tests/integration/workbench_routes.rs
@@ -0,0 +1,205 @@
+use super::common::{create_test_backend, open_php};
+use phpantom_lsp::workbench_routes::RouteQuery;
+use tower_lsp::{
+    LanguageServer,
+    lsp_types::{
+        DidChangeTextDocumentParams, TextDocumentContentChangeEvent, Url,
+        VersionedTextDocumentIdentifier,
+    },
+};
+
+#[tokio::test]
+async fn workbench_routes_lists_grouped_names_uri_parameters_and_resources() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///app/routes/web.php").unwrap();
+    let source = "<?php\nRoute::prefix('admin')->name('admin.')->group(function () { Route::get('/users/{user}/{tab?}', 'show')->name('users.show'); Route::resource('posts', 'PostController')->only(['index', 'show']); });\n";
+    open_php(&backend, &uri, source).await;
+    backend.update_ast(uri.as_str(), source);
+    let reply = backend
+        .workbench_routes(RouteQuery::default())
+        .await
+        .unwrap();
+    let route = reply
+        .routes
+        .iter()
+        .find(|route| route.name == "admin.users.show")
+        .unwrap();
+    assert_eq!(route.uri, "admin/users/{user}/{tab?}");
+    assert_eq!(
+        route.parameters.as_deref(),
+        Some(["user".to_string(), "tab".to_string()].as_slice())
+    );
+    assert!(
+        reply
+            .routes
+            .iter()
+            .any(|route| route.name == "admin.posts.index")
+    );
+    assert!(
+        reply
+            .routes
+            .iter()
+            .any(|route| route.name == "admin.posts.show")
+    );
+    assert!(
+        !reply
+            .routes
+            .iter()
+            .any(|route| route.name == "admin.posts.create")
+    );
+}
+
+#[tokio::test]
+async fn workbench_routes_resolves_selected_name_to_registration() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///app/routes/web.php").unwrap();
+    let source = "<?php\n/* café 🐘 */ Route::get('/user/{id}', 'show')->name('users.show');\n";
+    open_php(&backend, &uri, source).await;
+    backend.update_ast(uri.as_str(), source);
+    let reply = backend
+        .workbench_routes(RouteQuery {
+            name: Some("users.show".into()),
+            limit: None,
+        })
+        .await
+        .unwrap();
+    assert_eq!(reply.locations.len(), 1);
+    assert_eq!(reply.locations[0].uri, uri);
+    assert_eq!(reply.locations[0].range.start.line, 1);
+    let character = source.lines().nth(1).unwrap().find("users.show").unwrap();
+    let utf16 = source.lines().nth(1).unwrap()[..character]
+        .encode_utf16()
+        .count();
+    assert_eq!(reply.locations[0].range.start.character, utf16 as u32);
+}
+
+#[tokio::test]
+async fn workbench_routes_limits_rows_and_rejects_invalid_queries() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///app/routes/web.php").unwrap();
+    let source = "<?php Route::get('/a', 'a')->name('a'); Route::get('/b', 'b')->name('b');";
+    open_php(&backend, &uri, source).await;
+    backend.update_ast(uri.as_str(), source);
+    assert!(
+        backend
+            .workbench_routes(RouteQuery {
+                name: Some(String::new()),
+                limit: None
+            })
+            .await
+            .is_err()
+    );
+    assert!(
+        backend
+            .workbench_routes(RouteQuery {
+                name: None,
+                limit: Some(5001)
+            })
+            .await
+            .is_err()
+    );
+    let reply = backend
+        .workbench_routes(RouteQuery {
+            name: None,
+            limit: Some(1),
+        })
+        .await
+        .unwrap();
+    assert_eq!(reply.routes.len(), 1);
+    assert!(reply.incomplete);
+    assert!(
+        backend
+            .workbench_routes(RouteQuery {
+                name: None,
+                limit: Some(0)
+            })
+            .await
+            .is_err()
+    );
+    assert!(
+        backend
+            .workbench_routes(RouteQuery {
+                name: Some("x".repeat(257)),
+                limit: None
+            })
+            .await
+            .is_err()
+    );
+}
+
+#[tokio::test]
+async fn workbench_routes_empty_project_and_unknown_name_are_explicit() {
+    let backend = create_test_backend();
+    let reply = backend
+        .workbench_routes(RouteQuery::default())
+        .await
+        .unwrap();
+    assert!(reply.routes.is_empty() && reply.locations.is_empty() && !reply.incomplete);
+    assert!(
+        backend
+            .workbench_routes(RouteQuery {
+                name: Some("missing".into()),
+                limit: None
+            })
+            .await
+            .unwrap()
+            .locations
+            .is_empty()
+    );
+}
+
+#[tokio::test]
+async fn workbench_routes_preserves_duplicates_and_resolves_live_changes() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///app/routes/web.php").unwrap();
+    let source = "<?php\nRoute::get('/first', 'first')->name('duplicate');\nRoute::get('/second', 'second')->name('duplicate');\n";
+    open_php(&backend, &uri, source).await;
+    backend.update_ast(uri.as_str(), source);
+    let reply = backend
+        .workbench_routes(RouteQuery {
+            name: Some("duplicate".into()),
+            limit: None,
+        })
+        .await
+        .unwrap();
+    assert_eq!(reply.locations.len(), 2);
+    assert_eq!(reply.locations[0].range.start.line, 1);
+    assert_eq!(reply.locations[1].range.start.line, 2);
+    let changed = "<?php\nRoute::get('/changed', 'first')->name('changed');\n";
+    backend
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: uri.clone(),
+                version: 2,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: changed.to_owned(),
+            }],
+        })
+        .await;
+    backend.update_ast(uri.as_str(), changed);
+    let reply = backend
+        .workbench_routes(RouteQuery::default())
+        .await
+        .unwrap();
+    assert!(
+        reply
+            .routes
+            .iter()
+            .any(|route| route.name == "changed" && route.uri == "changed")
+    );
+    assert!(!reply.routes.iter().any(|route| route.name == "duplicate"));
+    assert!(
+        backend
+            .workbench_routes(RouteQuery {
+                name: Some("duplicate".into()),
+                limit: None
+            })
+            .await
+            .unwrap()
+            .locations
+            .is_empty()
+    );
+}

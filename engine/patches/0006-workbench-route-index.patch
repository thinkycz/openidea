+//! Read-only named-route discovery for the PHP Workbench client.
+
+use serde::{Deserialize, Serialize};
+use tower_lsp::{
+    jsonrpc::{Error, Result},
+    lsp_types::Location,
+};
+
+use crate::{
+    Backend,
+    virtual_members::laravel::{
+        enumerate_all_routes, resolve_route_definitions, route_uri_parameters,
+    },
+};
+
+/// List routes, or resolve one selected route name to its registrations.
+#[derive(Debug, Default, Deserialize)]
+pub struct RouteQuery {
+    /// A selected name. Omit to list route names and statically known URIs.
+    pub name: Option<String>,
+    /// Maximum number of rows or locations, between one and five thousand.
+    pub limit: Option<usize>,
+}
+
+/// A named route recovered by the existing Laravel source index.
+#[derive(Debug, Serialize)]
+pub struct RouteItem {
+    /// Fully qualified name including statically known group prefixes.
+    pub name: String,
+    /// Group-prefixed URI, or an empty string when not statically known.
+    pub uri: String,
+    /// URI parameter names, or none when the URI is unknown.
+    pub parameters: Option<Vec<String>>,
+    /// Whether the registration belongs to an installed package.
+    pub from_vendor: bool,
+}
+
+/// A bounded route table or the registrations of a selected name.
+#[derive(Debug, Default, Serialize)]
+pub struct RouteReply {
+    /// Named routes, populated for a list query.
+    pub routes: Vec<RouteItem>,
+    /// Registrations, populated for a selected-name query; duplicates stay visible.
+    pub locations: Vec<Location>,
+    /// More results or dynamically computed route names may exist.
+    pub incomplete: bool,
+}
+
+impl Backend {
+    /// Query the static route index without executing PHP or booting Laravel.
+    pub async fn workbench_routes(&self, query: RouteQuery) -> Result<RouteReply> {
+        let limit = query.limit.unwrap_or(2000);
+        if !(1..=5000).contains(&limit) {
+            return Err(Error::invalid_params(
+                "Route limit must be between 1 and 5000",
+            ));
+        }
+        if let Some(name) = query.name {
+            if name.is_empty() || name.len() > 256 {
+                return Err(Error::invalid_params(
+                    "Route name must contain 1 to 256 bytes",
+                ));
+            }
+            let mut locations = resolve_route_definitions(self, &name);
+            locations.sort_unstable_by(|a, b| {
+                (
+                    a.uri.as_str(),
+                    a.range.start.line,
+                    a.range.start.character,
+                    a.range.end.line,
+                    a.range.end.character,
+                )
+                    .cmp(&(
+                        b.uri.as_str(),
+                        b.range.start.line,
+                        b.range.start.character,
+                        b.range.end.line,
+                        b.range.end.character,
+                    ))
+            });
+            locations.dedup();
+            let incomplete = locations.len() > limit;
+            locations.truncate(limit);
+            return Ok(RouteReply {
+                locations,
+                incomplete,
+                ..RouteReply::default()
+            });
+        }
+        let discovery = enumerate_all_routes(self);
+        let mut routes = discovery.routes;
+        routes.sort_unstable_by(|a, b| {
+            (&a.name, &a.uri, a.from_vendor).cmp(&(&b.name, &b.uri, b.from_vendor))
+        });
+        routes
+            .dedup_by(|a, b| a.name == b.name && a.uri == b.uri && a.from_vendor == b.from_vendor);
+        let incomplete = routes.len() > limit
+            || !discovery.open_prefixes.is_empty()
+            || !discovery.open_suffixes.is_empty();
+        routes.truncate(limit);
+        Ok(RouteReply {
+            routes: routes
+                .into_iter()
+                .map(|route| RouteItem {
+                    parameters: (!route.uri.is_empty()).then(|| {
+                        route_uri_parameters(&route.uri)
+                            .into_iter()
+                            .map(str::to_owned)
+                            .collect()
+                    }),
+                    name: route.name,
+                    uri: route.uri,
+                    from_vendor: route.from_vendor,
+                })
+                .collect(),
+            incomplete,
+            ..RouteReply::default()
+        })
+    }
+}

+++ b/tests/integration/definition_ambiguous_members.rs
@@ -0,0 +1,63 @@
+use super::common::{create_test_backend, definition_locations, goto_definition_at, open_php};
+use tower_lsp::lsp_types::{Position, Url};
+
+async fn definitions(source: &str, marker: &str) -> Vec<tower_lsp::lsp_types::Location> {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///app/main.php").unwrap();
+    open_php(&backend, &uri, source).await;
+    backend.update_ast(uri.as_str(), source);
+    let offset = source.find(marker).unwrap() + marker.len() - 1;
+    let prefix = &source[..offset];
+    let position = Position::new(
+        prefix.matches('\n').count() as u32,
+        prefix.rsplit('\n').next().unwrap().encode_utf16().count() as u32,
+    );
+    definition_locations(
+        goto_definition_at(&backend, &uri, position.line, position.character).await,
+    )
+}
+
+#[tokio::test]
+async fn definition_ambiguous_methods_retains_every_union_target() {
+    let source = "<?php\nclass A { public function run(): void {} }\nclass B { public function run(): void {} }\nfunction demo(A|B $value): void { $value->run(); }\n";
+    let locations = definitions(source, "$value->run").await;
+    assert_eq!(
+        locations.len(),
+        2,
+        "Both concrete method declarations are valid targets"
+    );
+    assert_eq!(
+        locations
+            .iter()
+            .map(|location| location.range.start.line)
+            .collect::<Vec<_>>(),
+        vec![1, 2]
+    );
+}
+
+#[tokio::test]
+async fn definition_ambiguous_properties_retains_every_union_target() {
+    let source = "<?php\nclass A { public string $name; }\nclass B { public string $name; }\nfunction demo(A|B $value): void { echo $value->name; }\n";
+    let locations = definitions(source, "$value->name").await;
+    assert_eq!(
+        locations.len(),
+        2,
+        "Both concrete property declarations are valid targets"
+    );
+}
+
+#[tokio::test]
+async fn definition_ambiguous_inherited_member_deduplicates_one_declaration() {
+    let source = "<?php\nclass Base { public function run(): void {} }\nclass A extends Base {}\nclass B extends Base {}\nfunction demo(A|B $value): void { $value->run(); }\n";
+    let locations = definitions(source, "$value->run").await;
+    assert_eq!(locations.len(), 1);
+    assert_eq!(locations[0].range.start.line, 1);
+}
+
+#[tokio::test]
+async fn definition_ambiguous_trait_alias_deduplicates_original_member() {
+    let source = "<?php\ntrait Shared { public function run(): void {} }\nclass A { use Shared { run as execute; } }\nclass B { use Shared { run as execute; } }\nfunction demo(A|B $value): void { $value->execute(); }\n";
+    let locations = definitions(source, "$value->execute").await;
+    assert_eq!(locations.len(), 1);
+    assert_eq!(locations[0].range.start.line, 1);
+}

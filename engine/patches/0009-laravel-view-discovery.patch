@@ -0,0 +1,127 @@
+use phpantom_lsp::{Backend, workbench_views::ViewQuery};
+
+fn project() -> (tempfile::TempDir, Backend) {
+    let directory = tempfile::tempdir().unwrap();
+    let root = directory.path();
+    std::fs::create_dir_all(root.join("resources/views/users")).unwrap();
+    std::fs::write(root.join("composer.json"), "{}").unwrap();
+    std::fs::write(
+        root.join("resources/views/users/show.blade.php"),
+        "<h1>Hello</h1>",
+    )
+    .unwrap();
+    std::fs::write(root.join("resources/views/welcome.php"), "hello").unwrap();
+    let backend = Backend::new_test_with_workspace(root.to_path_buf(), Default::default());
+    (directory, backend)
+}
+
+#[tokio::test]
+async fn workbench_views_lists_sorted_names_and_resolves_the_shared_definition() {
+    let (directory, backend) = project();
+    let reply = backend.workbench_views(ViewQuery::default()).await.unwrap();
+    assert_eq!(reply.views, vec!["users.show", "welcome"]);
+    assert!(!reply.incomplete);
+    let reply = backend
+        .workbench_views(ViewQuery {
+            name: Some("users.show".into()),
+            limit: None,
+        })
+        .await
+        .unwrap();
+    assert_eq!(reply.locations.len(), 1);
+    assert_eq!(
+        reply.locations[0].uri.to_file_path().unwrap(),
+        directory
+            .path()
+            .join("resources/views/users/show.blade.php")
+    );
+    assert_eq!(reply.locations[0].range.start.line, 0);
+}
+
+#[tokio::test]
+async fn workbench_views_marks_limits_and_rejects_invalid_requests() {
+    let (_directory, backend) = project();
+    let reply = backend
+        .workbench_views(ViewQuery {
+            name: None,
+            limit: Some(1),
+        })
+        .await
+        .unwrap();
+    assert_eq!(reply.views, vec!["users.show"]);
+    assert!(reply.incomplete);
+    for limit in [0, 5001] {
+        assert!(
+            backend
+                .workbench_views(ViewQuery {
+                    name: None,
+                    limit: Some(limit)
+                })
+                .await
+                .is_err()
+        );
+    }
+    for name in [
+        "",
+        "../secret",
+        "users/../../secret",
+        "/absolute",
+        "users\\secret",
+        "users..secret",
+    ] {
+        assert!(
+            backend
+                .workbench_views(ViewQuery {
+                    name: Some(name.into()),
+                    limit: None
+                })
+                .await
+                .is_err(),
+            "{name}"
+        );
+    }
+    assert!(
+        backend
+            .workbench_views(ViewQuery {
+                name: Some("x".repeat(257)),
+                limit: None
+            })
+            .await
+            .is_err()
+    );
+}
+
+#[tokio::test]
+async fn workbench_views_resolves_selection_again_after_template_removal() {
+    let (directory, backend) = project();
+    assert!(
+        !backend
+            .workbench_views(ViewQuery::default())
+            .await
+            .unwrap()
+            .views
+            .is_empty()
+    );
+    std::fs::remove_file(
+        directory
+            .path()
+            .join("resources/views/users/show.blade.php"),
+    )
+    .unwrap();
+    let reply = backend
+        .workbench_views(ViewQuery {
+            name: Some("users.show".into()),
+            limit: None,
+        })
+        .await
+        .unwrap();
+    assert!(reply.locations.is_empty());
+    let reply = backend
+        .workbench_views(ViewQuery {
+            name: Some("missing".into()),
+            limit: None,
+        })
+        .await
+        .unwrap();
+    assert!(reply.locations.is_empty());
+}

+//! Read-only access to the shared Blade/template index for PHP Workbench.
+
+use crate::{
+    Backend, symbol_map::LaravelStringKind, virtual_members::laravel::resolve_laravel_string_key,
+};
+use serde::{Deserialize, Serialize};
+use tower_lsp::{
+    jsonrpc::{Error, Result},
+    lsp_types::Location,
+};
+
+/// List known views, or resolve a selected view name to its current template.
+#[derive(Debug, Default, Deserialize)]
+pub struct ViewQuery {
+    /// Selected dotted view name; omit to list names.
+    pub name: Option<String>,
+    /// Maximum result count from one to five thousand; defaults to two thousand.
+    pub limit: Option<usize>,
+}
+
+/// Bounded template discovery shared with PHP literal completion/navigation.
+#[derive(Debug, Default, Serialize)]
+pub struct ViewReply {
+    /// Sorted unique view names for a list query.
+    pub views: Vec<String>,
+    /// Current targets for a selected-name query.
+    pub locations: Vec<Location>,
+    /// The response limit excluded some rows or targets.
+    pub incomplete: bool,
+}
+
+impl Backend {
+    /// Browse templates without booting Laravel or executing project code.
+    pub async fn workbench_views(&self, query: ViewQuery) -> Result<ViewReply> {
+        let limit = query.limit.unwrap_or(2000);
+        if !(1..=5000).contains(&limit) {
+            return Err(Error::invalid_params(
+                "View limit must be between 1 and 5000",
+            ));
+        }
+        if let Some(name) = query.name {
+            // A browse request is a logical name, never an arbitrary filesystem path.
+            if name.is_empty()
+                || name.len() > 256
+                || name.contains(['\\', '/', '\0'])
+                || name
+                    .split("::")
+                    .any(|part| part.split('.').any(str::is_empty))
+            {
+                return Err(Error::invalid_params(
+                    "View name must be a dotted logical name of 1 to 256 bytes",
+                ));
+            }
+            let mut locations =
+                resolve_laravel_string_key(self, &LaravelStringKind::View, &name, "");
+            locations.sort_unstable_by(|a, b| a.uri.as_str().cmp(b.uri.as_str()));
+            locations.dedup();
+            let incomplete = locations.len() > limit;
+            locations.truncate(limit);
+            return Ok(ViewReply {
+                locations,
+                incomplete,
+                ..ViewReply::default()
+            });
+        }
+        let mut views = self.blade_view_names();
+        let incomplete = views.len() > limit;
+        views.truncate(limit);
+        Ok(ViewReply {
+            views,
+            incomplete,
+            ..ViewReply::default()
+        })
+    }
+}

+use crate::common::{create_test_backend, open_document};
+use tower_lsp::lsp_types::{Diagnostic, Url};
+
+async fn functions(body: &str) -> Vec<Diagnostic> {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///view.blade.php").unwrap();
+    open_document(&backend, &uri, "php", body).await;
+    let php = backend.blade_virtual_php(uri.as_str()).unwrap();
+    let mut diagnostics = Vec::new();
+    backend.collect_unknown_function_diagnostics(uri.as_str(), &php, &mut diagnostics);
+    diagnostics
+}
+
+#[tokio::test]
+async fn generated_escape_helper_is_not_a_template_error() {
+    let diagnostics = functions("<p>🐘 {{ 'ok' }}</p>").await;
+    assert!(diagnostics.is_empty(), "{diagnostics:?}");
+}
+
+#[tokio::test]
+async fn actual_unknown_function_survives_with_original_unicode_range() {
+    let body = "<p>café 🐘 {{ userWrittenMissing() }}</p>";
+    let diagnostics = functions(body).await;
+    assert_eq!(diagnostics.len(), 1, "{diagnostics:?}");
+    assert!(diagnostics[0].message.contains("userWrittenMissing"));
+    let column = body[..body.find("userWrittenMissing").unwrap()]
+        .encode_utf16()
+        .count() as u32;
+    assert_eq!(diagnostics[0].range.start.line, 0);
+    assert_eq!(diagnostics[0].range.start.character, column);
+    assert_eq!(diagnostics[0].range.end.character, column + 18);
+}
+
+#[tokio::test]
+async fn user_written_escape_helper_is_still_checked() {
+    let body = "<p>{{ e('ok') }}</p>";
+    let diagnostics = functions(body).await;
+    assert_eq!(diagnostics.len(), 1, "{diagnostics:?}");
+    assert!(diagnostics[0].message.contains("'e'"));
+    assert_eq!(
+        diagnostics[0].range.start.character,
+        body.find("e(").unwrap() as u32
+    );
+    assert_eq!(
+        diagnostics[0].range.end.character,
+        diagnostics[0].range.start.character + 1
+    );
+}
+
+#[tokio::test]
+async fn php_block_unknown_function_keeps_its_source_location() {
+    let diagnostics = functions("@php\nuserWrittenMissing();\n@endphp\n").await;
+    assert_eq!(diagnostics.len(), 1, "{diagnostics:?}");
+    assert_eq!(diagnostics[0].range.start.line, 1);
+    assert_eq!(diagnostics[0].range.start.character, 0);
+}
+
+#[tokio::test]
+async fn directive_generated_helpers_have_no_user_php_range() {
+    let diagnostics = functions("@include('parts.header')\n@csrf\n").await;
+    assert!(diagnostics.is_empty(), "{diagnostics:?}");
+}

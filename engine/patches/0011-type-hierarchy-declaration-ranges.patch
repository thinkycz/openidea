+
+#[tokio::test]
+async fn hierarchy_ranges_enclose_type_names_for_every_class_like_kind() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///hierarchy.php").unwrap();
+    let text = "<?php\n// café 🐘\ninterface Shape {}\ntrait Shared {}\nclass ParentType implements Shape {}\nfinal class Child extends ParentType {}\nenum Status implements Shape { case Ready; }\n";
+    open_php(&backend, &uri, text).await;
+    for (line, column) in [(2, 10), (3, 6), (4, 6), (5, 12), (6, 5)] {
+        let items = prepare_at(&backend, &uri, line, column).await;
+        assert_eq!(items.len(), 1);
+        let item = &items[0];
+        assert!(
+            item.range.start <= item.selection_range.start,
+            "{}: {:?}",
+            item.name,
+            item
+        );
+        assert!(
+            item.selection_range.end <= item.range.end,
+            "{}: {:?}",
+            item.name,
+            item
+        );
+    }
+}
+
+#[tokio::test]
+async fn related_type_ranges_enclose_parent_interface_and_child_names() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///hierarchy.php").unwrap();
+    open_php(&backend,&uri,"<?php\ninterface Shape {}\nclass ParentType implements Shape {}\nclass Child extends ParentType {}\n").await;
+    let parent = prepare_at(&backend, &uri, 2, 6).await.remove(0);
+    let mut items = supertypes_of(&backend, &parent).await;
+    items.extend(subtypes_of(&backend, &parent).await);
+    assert_eq!(item_names(&items), vec!["Child", "Shape"]);
+    for item in items {
+        assert!(item.range.start <= item.selection_range.start);
+        assert!(item.selection_range.end <= item.range.end);
+    }
+}

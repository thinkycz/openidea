diff --git a/src/workbench_builtins.rs b/src/workbench_builtins.rs
new file mode 100644
index 0000000..bc0f8c5
--- /dev/null
+++ b/src/workbench_builtins.rs
@@ -0,0 +1,85 @@
+//! Bounded read-only access to the PHP service's embedded declarations.
+use crate::Backend;
+use serde::{Deserialize, Serialize};
+use tower_lsp::jsonrpc::{Error, Result};
+
+/// An embedded declaration URI, never an arbitrary file path.
+#[derive(Debug, Deserialize)]
+pub struct BuiltinQuery {
+    /// Virtual URI returned by semantic navigation.
+    pub uri: String,
+}
+
+/// Immutable PHP stub text for a virtual editor document.
+#[derive(Debug, Serialize)]
+pub struct BuiltinDocument {
+    /// The requested embedded-document identity.
+    pub uri: String,
+    /// Original PHP source used for declaration coordinates.
+    pub content: String,
+}
+
+impl Backend {
+    /// Read embedded standard-library source without reading project files.
+    pub async fn workbench_builtin(&self, query: BuiltinQuery) -> Result<BuiltinDocument> {
+        let (is_function, encoded) = if let Some(name) = query.uri.strip_prefix("phpantom-stub://")
+        {
+            (false, name)
+        } else if let Some(name) = query.uri.strip_prefix("phpantom-stub-fn://") {
+            (true, name)
+        } else {
+            return Err(Error::invalid_params("Unsupported embedded declaration"));
+        };
+        let name = decode_name(encoded)
+            .ok_or_else(|| Error::invalid_params("Invalid embedded declaration identity"))?;
+        // Never consult open_files: a client cannot replace embedded source
+        // by opening a forged virtual document with the same URI.
+        let content = if is_function {
+            self.stub_function_index.read().get(name.as_str()).copied()
+        } else {
+            self.stub_index.read().get(name.as_str()).copied()
+        }
+        .ok_or_else(|| Error::invalid_params("Embedded declaration is unavailable"))?;
+        if content.len() > 2 * 1024 * 1024 {
+            return Err(Error::invalid_params(
+                "Embedded declaration exceeds the source viewer limit",
+            ));
+        }
+        Ok(BuiltinDocument {
+            uri: query.uri,
+            content: content.to_owned(),
+        })
+    }
+}
+
+fn decode_name(encoded: &str) -> Option<String> {
+    if encoded.len() > 4096 {
+        return None;
+    }
+    let mut bytes = Vec::new();
+    let mut chars = encoded.bytes();
+    while let Some(byte) = chars.next() {
+        if byte == b'%' {
+            let a = (chars.next()? as char).to_digit(16)?;
+            let b = (chars.next()? as char).to_digit(16)?;
+            bytes.push((a * 16 + b) as u8);
+        } else {
+            bytes.push(byte);
+        }
+    }
+    let name = String::from_utf8(bytes).ok()?;
+    if name.len() > 512
+        || !name.split('\\').all(|part| {
+            !part.is_empty()
+                && part.bytes().enumerate().all(|(index, byte)| {
+                    byte == b'_'
+                        || byte.is_ascii_alphabetic()
+                        || byte >= 0x80
+                        || (index > 0 && byte.is_ascii_digit())
+                })
+        })
+    {
+        return None;
+    }
+    Some(name)
+}
diff --git a/tests/integration/definition_classes.rs b/tests/integration/definition_classes.rs
index 914b1bc..c533ef0 100644
--- a/tests/integration/definition_classes.rs
+++ b/tests/integration/definition_classes.rs
@@ -3,6 +3,102 @@ use phpantom_lsp::Backend;
 use tower_lsp::LanguageServer;
 use tower_lsp::lsp_types::*;
 
+#[tokio::test]
+async fn workbench_builtin_class_source_uses_original_coordinates() {
+    let backend = crate::common::create_test_backend_with_full_stubs();
+    let uri = Url::parse("file:///builtin.php").unwrap();
+    open_php(&backend, &uri, "<?php\n$clock = new DateTimeImmutable();\n").await;
+    let Some(GotoDefinitionResponse::Scalar(location)) =
+        goto_definition_at(&backend, &uri, 1, 17).await
+    else {
+        panic!("Missing builtin class definition");
+    };
+    let document = backend
+        .workbench_builtin(phpantom_lsp::workbench_builtins::BuiltinQuery {
+            uri: location.uri.to_string(),
+        })
+        .await
+        .unwrap();
+    assert_eq!(document.uri, location.uri.as_str());
+    let line = document
+        .content
+        .lines()
+        .nth(location.range.start.line as usize)
+        .unwrap();
+    assert!(line.contains("class DateTimeImmutable"), "{line}");
+}
+
+#[tokio::test]
+async fn workbench_builtin_function_definitions_have_readable_source() {
+    let backend = crate::common::create_test_backend_with_full_stubs();
+    let uri = Url::parse("file:///builtin.php").unwrap();
+    open_php(
+        &backend,
+        &uri,
+        "<?php\nstrlen('hi');\narray_map('strval', [1]);\n",
+    )
+    .await;
+    for (line, name) in [(1, "strlen"), (2, "array_map")] {
+        let Some(GotoDefinitionResponse::Scalar(location)) =
+            goto_definition_at(&backend, &uri, line, 3).await
+        else {
+            panic!("Missing builtin function definition: {name}");
+        };
+        assert_eq!(location.uri.scheme(), "phpantom-stub-fn");
+        let document = backend
+            .workbench_builtin(phpantom_lsp::workbench_builtins::BuiltinQuery {
+                uri: location.uri.to_string(),
+            })
+            .await
+            .unwrap();
+        let line = document
+            .content
+            .lines()
+            .nth(location.range.start.line as usize)
+            .unwrap();
+        assert!(line.contains(&format!("function {name}(")), "{line}");
+    }
+}
+
+#[tokio::test]
+async fn workbench_builtin_source_is_embedded_and_rejects_other_locations() {
+    use phpantom_lsp::workbench_builtins::BuiltinQuery;
+    let backend = crate::common::create_test_backend_with_full_stubs();
+    let uri = Url::parse("phpantom-stub://DateTimeImmutable").unwrap();
+    open_php(&backend, &uri, "<?php class ForgedProjectContent {}").await;
+    let document = backend
+        .workbench_builtin(BuiltinQuery {
+            uri: uri.to_string(),
+        })
+        .await
+        .unwrap();
+    assert!(!document.content.contains("ForgedProjectContent"));
+    assert!(document.content.contains("class DateTimeImmutable"));
+    let document = backend
+        .workbench_builtin(BuiltinQuery {
+            uri: "phpantom-stub://FFI%5CCData".into(),
+        })
+        .await
+        .unwrap();
+    assert!(document.content.contains("class CData"));
+    for uri in [
+        "file:///etc/passwd",
+        "https://example.com/source",
+        "phpantom-stub://../secret",
+        "phpantom-stub://DateTimeImmutable?secret",
+        "phpantom-stub://unknown",
+        "phpantom-stub-fn://../../secret",
+    ] {
+        assert!(
+            backend
+                .workbench_builtin(BuiltinQuery { uri: uri.into() })
+                .await
+                .is_err(),
+            "{uri}"
+        );
+    }
+}

+/// Deterministic word boundaries, without edit-distance or substring guesses.
+/// Preserve Unicode in tokens; ASCII camel case/acronyms and underscores split.
+fn name_tokens(name: &str) -> Vec<String> {
+    let chars: Vec<char> = name.trim_start_matches('$').chars().collect();
+    let mut tokens = Vec::new();
+    let mut word = String::new();
+    for (index, &character) in chars.iter().enumerate() {
+        if character == '_' {
+            if !word.is_empty() {
+                tokens.push(std::mem::take(&mut word));
+            }
+            continue;
+        }
+        let boundary = character.is_ascii_uppercase()
+            && index > 0
+            && (chars[index - 1].is_ascii_lowercase()
+                || chars[index - 1].is_ascii_digit()
+                || (chars[index - 1].is_ascii_uppercase()
+                    && chars.get(index + 1).is_some_and(char::is_ascii_lowercase)));
+        if boundary && !word.is_empty() {
+            tokens.push(std::mem::take(&mut word));
+        }
+        word.push(character.to_ascii_lowercase());
+    }
+    if !word.is_empty() {
+        tokens.push(word);
+    }
+    tokens
+}
+
+fn name_affinity(variable: &str, parameter: &str, parameter_tokens: &[String]) -> u8 {
+    if variable.trim_start_matches('$') == parameter {
+        return 0;
+    }
+    if parameter_tokens.is_empty() {
+        return 3;
+    }
+    let variable_tokens = name_tokens(variable);
+    if variable_tokens == parameter_tokens {
+        1
+    } else if variable_tokens.ends_with(parameter_tokens) {
+        2
+    } else {
+        3
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{name_affinity, name_tokens};
+
+    #[test]
+    fn parameter_name_affinity_uses_word_boundaries_and_ordered_tiers() {
+        assert_eq!(name_tokens("$HTTPClient_ID"), vec!["http", "client", "id"]);
+        let tokens = name_tokens("user_email");
+        for (variable, score) in [
+            ("$user_email", 0),
+            ("$userEmail", 1),
+            ("$billing_user_email", 2),
+            ("$email_user", 3),
+            ("$userVoicemail", 3),
+        ] {
+            assert_eq!(
+                name_affinity(variable, "user_email", &tokens),
+                score,
+                "{variable}"
+            );
+        }
+        assert_eq!(name_affinity("$valid", "id", &name_tokens("id")), 3);
+        assert_eq!(name_affinity("$a", "", &[]), 3);
+    }
+}

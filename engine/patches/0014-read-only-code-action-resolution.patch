--- a/tests/integration/code_action_remove_unused_import.rs
+++ b/tests/integration/code_action_remove_unused_import.rs
@@ -210,3 +210,45 @@ fn an_import_used_only_in_another_namespace_block_is_unused() {
     let lines: Vec<u32> = diags.iter().map(|d| d.range.start.line).collect();
     assert_eq!(lines, [2], "only block A's import is unused: {diags:?}");
 }
+
+#[test]
+fn quick_fix_resolution_does_not_publish_or_clear_diagnostics_before_application() {
+    let backend = create_test_backend();
+    let source = "<?php\nuse Foo\\Bar;\nfunction demo(): int { return 1; }\n";
+    let actions = actions_at(&backend, source, 1, 6);
+    let action = find_action(&actions, SINGLE).unwrap();
+    let diagnostic = action.diagnostics.clone().unwrap();
+    backend
+        .open_files()
+        .write()
+        .insert(URI.to_owned(), std::sync::Arc::new(source.to_owned()));
+    let (resolved, republish) = backend.resolve_code_action(action.clone());
+    assert!(resolved.edit.is_some());
+    assert_eq!(
+        republish, None,
+        "Resolving a proposal is not edit acceptance"
+    );
+    assert_eq!(resolved.diagnostics, Some(diagnostic));
+    let (again, republish) = backend.resolve_code_action(action.clone());
+    assert_eq!(again.edit, resolved.edit);
+    assert_eq!(republish, None);
+}
+
+#[test]
+fn quick_fix_applied_source_recomputes_native_diagnostics() {
+    let backend = create_test_backend();
+    let source = "<?php\nuse Foo\\Bar;\nfunction demo(): int { return 1; }\n";
+    let actions = actions_at(&backend, source, 1, 6);
+    let action = find_action(&actions, SINGLE).unwrap();
+    backend
+        .open_files()
+        .write()
+        .insert(URI.to_owned(), std::sync::Arc::new(source.to_owned()));
+    let (resolved, _) = backend.resolve_code_action(action.clone());
+    let edited = apply_edits(source, &extract_edits(&resolved));
+    assert!(!edited.contains("use Foo"));
+    backend.update_ast(URI, &edited);
+    let mut diagnostics = Vec::new();
+    backend.collect_unused_import_diagnostics(URI, &edited, &mut diagnostics);
+    assert!(diagnostics.is_empty());
+}

--- /dev/null
+++ b/src/diagnostics/revision.rs
@@ -0,0 +1,245 @@
+//! Source ownership for live diagnostic phases. Stamps retain no source payload.
+use std::{
+    collections::HashMap,
+    sync::{Arc, Weak},
+};
+
+#[derive(Clone)]
+pub(crate) struct Revision {
+    pub version: i32,
+    pub open: u64,
+    text: Weak<String>,
+}
+impl Revision {
+    pub fn same(&self, other: &Self) -> bool {
+        self.version == other.version && self.open == other.open && self.text.ptr_eq(&other.text)
+    }
+    fn owns(&self, text: &Arc<String>) -> bool {
+        self.text.ptr_eq(&Arc::downgrade(text))
+    }
+}
+#[derive(Default)]
+struct Document {
+    open: u64,
+    current: Option<Revision>,
+    parsed: Option<Revision>,
+    fast: Option<Revision>,
+    slow: Option<Revision>,
+}
+#[derive(Default)]
+pub(crate) struct Revisions(HashMap<String, Document>);
+impl Revisions {
+    pub fn open(&mut self, uri: &str, version: i32, text: &Arc<String>) {
+        let entry = self.0.entry(uri.to_owned()).or_default();
+        let Some(open) = entry.open.checked_add(1) else {
+            entry.current = None;
+            entry.parsed = None;
+            entry.fast = None;
+            entry.slow = None;
+            return;
+        };
+        entry.open = open;
+        entry.current = Some(Revision {
+            version,
+            open: entry.open,
+            text: Arc::downgrade(text),
+        });
+        entry.parsed = None;
+        entry.fast = None;
+        entry.slow = None;
+    }
+    pub fn change(&mut self, uri: &str, version: i32, text: &Arc<String>) -> bool {
+        let Some(entry) = self.0.get_mut(uri) else {
+            return false;
+        };
+        let Some(current) = &entry.current else {
+            return false;
+        };
+        if version <= current.version {
+            return false;
+        }
+        entry.current = Some(Revision {
+            version,
+            open: entry.open,
+            text: Arc::downgrade(text),
+        });
+        entry.parsed = None;
+        true
+    }
+    pub fn close(&mut self, uri: &str) {
+        if let Some(entry) = self.0.get_mut(uri) {
+            entry.current = None;
+            entry.parsed = None;
+            entry.fast = None;
+            entry.slow = None;
+        }
+    }
+    /// None means an untracked test/CLI snapshot; Err means obsolete/closed.
+    pub fn capture(&self, uri: &str, text: &Arc<String>) -> Result<Option<Revision>, ()> {
+        match self.0.get(uri) {
+            None => Ok(None),
+            Some(entry) => entry
+                .current
+                .as_ref()
+                .filter(|r| r.owns(text))
+                .cloned()
+                .map(Some)
+                .ok_or(()),
+        }
+    }
+    pub fn current(&self, uri: &str, revision: Option<&Revision>) -> bool {
+        match (self.0.get(uri), revision) {
+            (None, None) => true,
+            (Some(entry), Some(revision)) => entry
+                .current
+                .as_ref()
+                .is_some_and(|current| current.same(revision) && current.text.strong_count() > 0),
+            _ => false,
+        }
+    }
+    pub fn parsed(&self, uri: &str, revision: Option<&Revision>) -> bool {
+        self.current(uri, revision)
+            && revision.is_none_or(|revision| {
+                self.0
+                    .get(uri)
+                    .and_then(|e| e.parsed.as_ref())
+                    .is_some_and(|p| p.same(revision))
+            })
+    }
+    pub fn mark_parsed(&mut self, uri: &str, revision: Option<&Revision>) -> bool {
+        if !self.current(uri, revision) {
+            return false;
+        }
+        if let Some(revision) = revision {
+            self.0.get_mut(uri).unwrap().parsed = Some(revision.clone());
+        }
+        true
+    }
+    pub fn mark_phase(&mut self, uri: &str, revision: Option<&Revision>, slow: bool) -> bool {
+        if !self.parsed(uri, revision) {
+            return false;
+        }
+        if let Some(revision) = revision {
+            let entry = self.0.get_mut(uri).unwrap();
+            if slow {
+                entry.slow = Some(revision.clone());
+            } else {
+                entry.fast = Some(revision.clone());
+            }
+        }
+        true
+    }
+    pub fn phase_current(&self, uri: &str, revision: Option<&Revision>, slow: bool) -> bool {
+        if !self.parsed(uri, revision) {
+            return false;
+        }
+        revision.is_none_or(|revision| {
+            self.0
+                .get(uri)
+                .and_then(|e| {
+                    if slow {
+                        e.slow.as_ref()
+                    } else {
+                        e.fast.as_ref()
+                    }
+                })
+                .is_some_and(|p| p.same(revision))
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn an_edit_retires_both_phases_and_waits_for_its_own_parse() {
+        let mut revisions = Revisions::default();
+        let a = Arc::new("old".into());
+        let b = Arc::new("new".into());
+        revisions.open("file:///a.php", 1, &a);
+        let old = revisions.capture("file:///a.php", &a).unwrap().unwrap();
+        assert!(!revisions.mark_phase("file:///a.php", Some(&old), false));
+        assert!(revisions.mark_parsed("file:///a.php", Some(&old)));
+        assert!(revisions.mark_phase("file:///a.php", Some(&old), false));
+        assert!(revisions.mark_phase("file:///a.php", Some(&old), true));
+        assert!(revisions.change("file:///a.php", 2, &b));
+        assert!(!revisions.current("file:///a.php", Some(&old)));
+        assert!(!revisions.mark_phase("file:///a.php", Some(&old), true));
+        let new = revisions.capture("file:///a.php", &b).unwrap().unwrap();
+        assert!(!revisions.phase_current("file:///a.php", Some(&new), false));
+        assert!(revisions.mark_parsed("file:///a.php", Some(&new)));
+        assert!(revisions.mark_phase("file:///a.php", Some(&new), false));
+        assert!(revisions.phase_current("file:///a.php", Some(&new), false));
+        assert!(!revisions.phase_current("file:///a.php", Some(&new), true));
+    }
+    #[test]
+    fn text_aba_and_close_reopen_do_not_reuse_ownership() {
+        let mut revisions = Revisions::default();
+        let a = Arc::new("same".into());
+        revisions.open("u", 1, &a);
+        let first = revisions.capture("u", &a).unwrap().unwrap();
+        let b = Arc::new("different".into());
+        assert!(revisions.change("u", 2, &b));
+        let same = Arc::new("same".into());
+        assert!(revisions.change("u", 3, &same));
+        assert!(!revisions.current("u", Some(&first)));
+        assert!(revisions.capture("u", &a).is_err());
+        revisions.close("u");
+        assert!(revisions.capture("u", &same).is_err());
+        revisions.open("u", 1, &a);
+        let reopened = revisions.capture("u", &a).unwrap().unwrap();
+        assert_eq!(reopened.open, 2);
+        assert!(!reopened.same(&first));
+    }
+    #[test]
+    fn older_and_duplicate_changes_cannot_replace_latest_text() {
+        let mut revisions = Revisions::default();
+        let a = Arc::new("current".into());
+        let b = Arc::new("stale".into());
+        revisions.open("u", 9, &a);
+        assert!(!revisions.change("u", 8, &b));
+        assert!(!revisions.change("u", 9, &b));
+        assert!(revisions.capture("u", &a).is_ok());
+    }
+    #[test]
+    fn cache_stamps_do_not_keep_old_source_payloads_alive() {
+        let mut revisions = Revisions::default();
+        let a = Arc::new("private large source".into());
+        revisions.open("u", 1, &a);
+        let old = revisions.capture("u", &a).unwrap().unwrap();
+        revisions.mark_parsed("u", Some(&old));
+        revisions.mark_phase("u", Some(&old), true);
+        let weak = Arc::downgrade(&a);
+        revisions.change("u", 2, &Arc::new("new".into()));
+        drop(a);
+        assert!(weak.upgrade().is_none());
+        assert!(!revisions.current("u", Some(&old)));
+    }
+}
+
+/// Version and incarnation travel with the computed payload, never with the latest buffer.
+#[derive(serde::Serialize, serde::Deserialize)]
+pub(crate) struct Publication {
+    #[serde(flatten)]
+    pub params: tower_lsp::lsp_types::PublishDiagnosticsParams,
+    #[serde(
+        rename = "phpantomDocumentOpen",
+        skip_serializing_if = "Option::is_none"
+    )]
+    pub open: Option<u64>,
+    #[serde(
+        rename = "phpantomDiagnosticComplete",
+        skip_serializing_if = "Option::is_none"
+    )]
+    pub complete: Option<bool>,
+    #[serde(
+        rename = "phpantomDiagnosticSequence",
+        skip_serializing_if = "Option::is_none"
+    )]
+    pub sequence: Option<u64>,
+}
+pub(crate) enum Publish {}
+impl tower_lsp::lsp_types::notification::Notification for Publish {
+    type Params = Publication;
+    const METHOD: &'static str = "textDocument/publishDiagnostics";
+}

new file mode 100644
index 0000000..6a3767b
--- /dev/null
+++ b/src/backend/semantic_snapshot.rs
@@ -0,0 +1,171 @@
+//! Interactive requests must not resolve against pending open-file parses.
+use std::sync::Arc;
+
+use tower_lsp::jsonrpc::{Error, ErrorCode, Result};
+
+use crate::Backend;
+
+fn content_modified() -> Error {
+    Error {
+        code: ErrorCode::ServerError(-32801),
+        message: "PHP sources changed during the request".into(),
+        data: None,
+    }
+}
+
+impl Backend {
+    pub(crate) fn restore_closed_semantic_source(&self, uri: &str, opening: u64) -> bool {
+        let lock = self.diagnostic_parse_lock(uri);
+        let _guard = lock.lock();
+        let pending = self.diag.documents.lock().closed_opening(uri) == Some(opening);
+        if !pending {
+            return true;
+        }
+        if self.open_files.read().contains_key(uri) {
+            return false;
+        }
+        if crate::resource_navigation::is_resource_document(uri) {
+            if let Some(content) = self.get_file_content(uri) {
+                self.update_resource_symbol_index(uri, &content);
+            } else {
+                self.clear_file_maps(uri);
+            }
+        } else if let Some(path) = self.workspace_index_path(uri) {
+            match std::fs::read_to_string(path) {
+                Ok(content) => {
+                    self.update_ast(uri, &content);
+                }
+                Err(_) => self.clear_file_maps(uri),
+            }
+        } else {
+            self.clear_file_maps(uri);
+        }
+        self.diag.documents.lock().finish_closed(uri, opening)
+    }
+
+    /// Refresh pending sources on the existing request blocking worker, then
+    /// reject the result if an opening or text changes during its computation.
+    /// No source payload is added to a persistent cache by this guard.
+    pub(crate) fn with_current_semantics<T>(&self, body: impl FnOnce() -> Result<T>) -> Result<T> {
+        let (mut sources, closed, epoch) = {
+            let documents = self.diag.documents.lock();
+            let files = self.open_files.read();
+            let sources: Vec<(String, Arc<String>)> = files
+                .iter()
+                .map(|(uri, text)| (uri.clone(), Arc::clone(text)))
+                .collect();
+            (
+                sources,
+                documents.pending_closed(),
+                documents.semantic_epoch(),
+            )
+        };
+        for (uri, opening) in closed {
+            if !self.restore_closed_semantic_source(&uri, opening) {
+                return Err(content_modified());
+            }
+        }
+        sources.sort_unstable_by(|a, b| a.0.cmp(&b.0));
+        for (uri, text) in &sources {
+            if crate::resource_navigation::is_resource_document(uri) {
+                continue;
+            }
+            let revision = self
+                .diag
+                .documents
+                .lock()
+                .capture(uri, text)
+                .map_err(|()| content_modified())?;
+            let parsed = self.diag.documents.lock().parsed(uri, revision.as_ref());
+            if !parsed && !self.parse_diagnostic_snapshot(uri, text) {
+                return Err(content_modified());
+            }
+        }
+        let current = || {
+            let documents = self.diag.documents.lock();
+            let files = self.open_files.read();
+            documents.epoch_matches(&epoch)
+                && !documents.has_pending_closed()
+                && files.len() == sources.len()
+                && sources
+                    .iter()
+                    .all(|(uri, text)| files.get(uri).is_some_and(|now| Arc::ptr_eq(now, text)))
+        };
+        if !current() {
+            return Err(content_modified());
+        }
+        let result = body();
+        if !current() {
+            return Err(content_modified());
+        }
+        result
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn a_change_during_resolution_discards_the_result() {
+        let backend = Backend::new_test();
+        let uri = "file:///Dependency.php";
+        let text = Arc::new("<?php class Dependency {}".to_owned());
+        backend.open_files.write().insert(uri.to_owned(), text);
+        let result = backend.with_current_semantics(|| {
+            backend.open_files.write().insert(
+                uri.to_owned(),
+                Arc::new("<?php class Changed {}".to_owned()),
+            );
+            Ok("obsolete result")
+        });
+        assert_eq!(result.unwrap_err().code, ErrorCode::ServerError(-32801));
+    }
+    #[test]
+    fn same_text_reopen_and_new_overlays_discard_in_flight_results() {
+        let backend = Backend::new_test();
+        let uri = "file:///Dependency.php";
+        backend.open_files.write().insert(
+            uri.to_owned(),
+            Arc::new("<?php class Dependency {}".to_owned()),
+        );
+        let result = backend.with_current_semantics(|| {
+            backend.open_files.write().insert(
+                uri.to_owned(),
+                Arc::new("<?php class Dependency {}".to_owned()),
+            );
+            Ok(())
+        });
+        assert!(
+            result.is_err(),
+            "new opening identity is significant even for identical source"
+        );
+        let result = backend.with_current_semantics(|| {
+            backend.open_files.write().insert(
+                "file:///New.php".to_owned(),
+                Arc::new("<?php class Added {}".to_owned()),
+            );
+            Ok(())
+        });
+        assert!(result.is_err(), "new unsaved classes can change resolution");
+    }
+    #[test]
+    fn an_overlay_opened_and_closed_during_resolution_changes_the_epoch() {
+        let root = tempfile::tempdir().unwrap();
+        let path = root.path().join("Dependency.php");
+        std::fs::write(&path, "<?php class Changed {}").unwrap();
+        let uri = tower_lsp::lsp_types::Url::from_file_path(&path)
+            .unwrap()
+            .to_string();
+        let backend = Backend::new_test_with_workspace(root.path().to_path_buf(), vec![]);
+        let result = backend.with_current_semantics(|| {
+            let text = Arc::new("<?php class Changed {}".to_owned());
+            backend.diag.documents.lock().open(&uri, 1, &text);
+            backend.open_files.write().insert(uri.clone(), text);
+            backend.diag.documents.lock().close(&uri);
+            backend.open_files.write().remove(&uri);
+            assert!(backend.restore_closed_semantic_source(&uri, 1));
+            Ok("old result")
+        });
+        assert_eq!(result.unwrap_err().code, ErrorCode::ServerError(-32801));
+    }
+}

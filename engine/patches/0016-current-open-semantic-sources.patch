+#[cfg(test)]
+mod semantic_source_tests {
+    use super::*;
+    use serde_json::json;
+
+    const DEP: &str = "file:///Dependency.php";
+    const MAIN: &str = "file:///main.php";
+    const OLD: &str = "<?php\nclass Dependency { public function oldMember(): void {} }\n";
+    const NEW: &str =
+        "<?php\n// changed source\nclass Dependency {\npublic function newMember(): void {}\n}\n";
+    const CALLER: &str =
+        "<?php\nfunction demo(Dependency $value): void {\n$value->oldMember();\n}\n";
+
+    fn install(backend: &Backend, uri: &str, text: &str) {
+        let text = Arc::new(text.to_owned());
+        backend.diag.documents.lock().open(uri, 1, &text);
+        backend
+            .open_files
+            .write()
+            .insert(uri.to_owned(), Arc::clone(&text));
+        backend.update_ast(uri, &text);
+        let revision = backend.diag.documents.lock().capture(uri, &text).unwrap();
+        assert!(
+            backend
+                .diag
+                .documents
+                .lock()
+                .mark_parsed(uri, revision.as_ref())
+        );
+    }
+    fn pending(backend: &Backend, uri: &str, text: &str) {
+        let text = Arc::new(text.to_owned());
+        assert!(backend.diag.documents.lock().change(uri, 2, &text));
+        backend.open_files.write().insert(uri.to_owned(), text);
+    }
+    async fn complete(backend: &Backend) -> Vec<String> {
+        let params = serde_json::from_value(
+            json!({"textDocument":{"uri":MAIN},"position":{"line":2,"character":8}}),
+        )
+        .unwrap();
+        let items = match LanguageServer::completion(backend, params)
+            .await
+            .unwrap()
+            .unwrap()
+        {
+            CompletionResponse::Array(items) => items,
+            CompletionResponse::List(list) => list.items,
+        };
+        items
+            .into_iter()
+            .map(|item| item.label.split('(').next().unwrap().to_owned())
+            .collect()
+    }
+    #[tokio::test]
+    async fn completion_refreshes_a_dependency_whose_parse_is_pending() {
+        let backend = Backend::new_test();
+        install(&backend, DEP, OLD);
+        install(&backend, MAIN, CALLER);
+        assert!(complete(&backend).await.contains(&"oldMember".to_owned()));
+        pending(&backend, DEP, NEW);
+        let labels = complete(&backend).await;
+        assert!(
+            labels.contains(&"newMember".to_owned()),
+            "request must parse the current dependency before resolving: {labels:?}"
+        );
+        assert!(
+            !labels.contains(&"oldMember".to_owned()),
+            "request must not return the prior parsed dependency"
+        );
+    }
+    #[tokio::test]
+    async fn definition_refreshes_pending_source_and_dependency_together() {
+        let backend = Backend::new_test();
+        install(&backend, DEP, OLD);
+        install(&backend, MAIN, CALLER);
+        pending(&backend, DEP, NEW);
+        pending(&backend, MAIN, &CALLER.replace("oldMember", "newMember"));
+        let params = serde_json::from_value(
+            json!({"textDocument":{"uri":MAIN},"position":{"line":2,"character":11}}),
+        )
+        .unwrap();
+        let response = LanguageServer::goto_definition(&backend, params)
+            .await
+            .unwrap();
+        let locations = match response {
+            Some(GotoDefinitionResponse::Scalar(location)) => vec![location],
+            Some(GotoDefinitionResponse::Array(locations)) => locations,
+            _ => vec![],
+        };
+        assert_eq!(
+            locations.len(),
+            1,
+            "the new method must resolve from the current source"
+        );
+        assert_eq!(locations[0].uri.as_str(), DEP);
+        assert_eq!(locations[0].range.start.line, 3);
+    }
+    #[tokio::test]
+    async fn completion_restores_closed_dependency_before_background_disk_parse() {
+        let root = tempfile::tempdir().unwrap();
+        let path = root.path().join("Dependency.php");
+        std::fs::write(&path, OLD).unwrap();
+        let dependency = Url::from_file_path(&path).unwrap().to_string();
+        let backend = Backend::new_test_with_workspace(root.path().to_path_buf(), vec![]);
+        install(&backend, &dependency, NEW);
+        install(&backend, MAIN, CALLER);
+        assert!(complete(&backend).await.contains(&"newMember".to_owned()));
+        backend.diag.documents.lock().close(&dependency);
+        backend.open_files.write().remove(&dependency);
+        let labels = complete(&backend).await;
+        assert!(
+            labels.contains(&"oldMember".to_owned()),
+            "a closed overlay must restore disk semantics before the first query: {labels:?}"
+        );
+        assert!(!labels.contains(&"newMember".to_owned()));
+    }

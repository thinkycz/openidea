+#[tokio::test]
+async fn test_explicit_workbench_variable_rank_carries_type_and_name_priority() {
+    let items = ranked_variables("<?php\nfunction send(string $email): void {}\nfunction demo(int $email, string $zText): void { send(/*complete*/$); }\n").await;
+    let good = items.iter().find(|item| item.label == "$zText").unwrap();
+    let wrong = items.iter().find(|item| item.label == "$email").unwrap();
+    assert_eq!(
+        good.data
+            .as_ref()
+            .and_then(|data| data.get("phpWorkbenchRanking")),
+        Some(&serde_json::json!({"version":1,"type":0,"name":3}))
+    );
+    assert_eq!(
+        wrong
+            .data
+            .as_ref()
+            .and_then(|data| data.get("phpWorkbenchRanking")),
+        Some(&serde_json::json!({"version":1,"type":1,"name":0}))
+    );
+    assert!(
+        items
+            .iter()
+            .filter(|item| item.label.starts_with("$_"))
+            .all(|item| item
+                .data
+                .as_ref()
+                .and_then(|data| data.get("phpWorkbenchRanking"))
+                .is_none())
+    );
+}
+
+#[tokio::test]
+async fn test_explicit_workbench_variable_rank_is_absent_without_a_context() {
+    let items = ranked_variables(
+        "<?php\nfunction demo(int $email, string $zText): void { unknown(/*complete*/$); }\n",
+    )
+    .await;
+    assert!(!items.is_empty());
+    assert!(items.iter().all(|item| {

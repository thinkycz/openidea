+#[cfg(test)]
+mod rank_metadata_tests {
+    use super::*;
+    #[test]
+    fn rank_metadata_preserves_existing_opaque_resolve_fields() {
+        let mut item = CompletionItem {
+            label: "$user".into(),
+            data: Some(serde_json::json!({"opaque":"keep","kind":"variable"})),
+            ..Default::default()
+        };
+        set_variable_rank(&mut item, 0, 2);
+        assert_eq!(item.data.as_ref().unwrap()["opaque"], "keep");
+        assert_eq!(item.data.as_ref().unwrap()["kind"], "variable");
+        assert_eq!(
+            item.data.as_ref().unwrap()["phpWorkbenchRanking"],
+            serde_json::json!({"version":1,"type":0,"name":2})
+        );
+        item.data = Some(serde_json::json!(["opaque"]));
+        set_variable_rank(&mut item, 1, 0);
+        assert_eq!(item.data, Some(serde_json::json!(["opaque"])));
+    }
+}

+/// Carry explicit tiers alongside opaque LSP sort keys, so cached client-side
+/// filtering can retain semantic priority without parsing the sort-text format.
+fn set_variable_rank(item: &mut CompletionItem, type_rank: u8, name_rank: u8) {
+    item.sort_text = Some(format!(
+        "0_{}_{}_{}",
+        type_rank,
+        name_rank,
+        item.label.to_lowercase()
+    ));
+    let data = item.data.get_or_insert_with(|| serde_json::json!({}));
+    if let Some(fields) = data.as_object_mut() {
+        fields.insert(
+            "phpWorkbenchRanking".into(),
+            serde_json::json!({
+                "version": 1,
+                "type": type_rank,
+                "name": name_rank,
+            }),
+        );
+    }
+}

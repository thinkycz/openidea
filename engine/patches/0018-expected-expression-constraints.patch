+#[tokio::test]
+async fn test_expected_expression_ranking_parentheses_branches_and_coalescing() {
+    for value in [
+        "(/*complete*/$)",
+        "true ? /*complete*/$ : ''",
+        "true ? '' : /*complete*/$",
+        "null ?? /*complete*/$",
+        "/*complete*/$ ?? ''",
+    ] {
+        let source = format!(
+            "<?php function demo(int $aCount, string $zText): string {{ return {value}; }}"
+        );
+        let items = ranked_variables(&source).await;
+        assert_eq!(items[0].label, "$zText", "{value}");
+        assert!(items.iter().any(|i| i.label == "$aCount"));
+    }
+}

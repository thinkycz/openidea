@@ -0,0 +1,129 @@
+//! Type constraints projected through value-preserving expression structure.
+use crate::php_type::{PhpType, TypeKind};
+
+#[derive(Clone)]
+pub(crate) enum Projection {
+    ArrayValue(Option<String>),
+    ArrayKey,
+    CallableReturn,
+    GeneratorReturn,
+    Nullable,
+}
+
+impl Projection {
+    pub(super) fn apply(&self, ty: &PhpType) -> Option<PhpType> {
+        if matches!(self, Self::Nullable) {
+            return Some(PhpType::nullable(ty.clone()));
+        }
+        match ty.kind() {
+            TypeKind::Nullable(inner) => return self.apply(inner),
+            TypeKind::Union(members) => {
+                // An array/closure literal excludes unrelated union arms, but an
+                // unconstrained matching arm must prevent a fabricated constraint.
+                let members: Vec<_> = members
+                    .iter()
+                    .filter(|member| match self {
+                        Self::ArrayValue(_) | Self::ArrayKey => {
+                            member.is_array_like()
+                                || matches!(
+                                    member.kind(),
+                                    TypeKind::ListShape(_) | TypeKind::UnsealedShape(_)
+                                )
+                        }
+                        Self::CallableReturn => member.is_callable(),
+                        _ => true,
+                    })
+                    .collect();
+                if members.is_empty() {
+                    return None;
+                }
+                let projected: Option<Vec<_>> = members
+                    .into_iter()
+                    .map(|member| self.apply(member))
+                    .collect();
+                return projected.map(PhpType::union);
+            }
+            _ => {}
+        }
+        match self {
+            Self::ArrayValue(key) => {
+                if let TypeKind::ListShape(inner) = ty.kind() {
+                    return self.apply(inner);
+                }
+                if !ty.is_array_like() && !matches!(ty.kind(), TypeKind::UnsealedShape(_)) {
+                    return None;
+                }
+                if ty.known_shape_entries().is_some() {
+                    return key
+                        .as_deref()
+                        .and_then(|key| ty.shape_value_type(key))
+                        .cloned();
+                }
+                ty.is_array_like()
+                    .then(|| ty.extract_element_type().cloned())
+                    .flatten()
+            }
+            Self::ArrayKey => ty.is_array_like().then(|| ty.iterable_key_type()).flatten(),
+            Self::CallableReturn => match ty.kind() {
+                TypeKind::Callable(callable) => callable.return_type.clone(),
+                _ => None,
+            },
+            Self::GeneratorReturn => match ty.kind() {
+                TypeKind::Generic(generic)
+                    if generic
+                        .name
+                        .as_str()
+                        .trim_start_matches('\\')
+                        .eq_ignore_ascii_case("Generator")
+                        && generic.args.len() == 4 =>
+                {
+                    Some(generic.args[3].clone())
+                }
+                _ => None,
+            },
+            Self::Nullable => unreachable!(),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn an_unconstrained_matching_union_arm_prevents_false_precision() {
+        for hint in [
+            "(callable():string)|callable",
+            "(callable():string)|Closure",
+        ] {
+            assert!(
+                Projection::CallableReturn
+                    .apply(&PhpType::parse(hint))
+                    .is_none(),
+                "{hint}"
+            );
+        }
+        assert!(
+            Projection::ArrayValue(None)
+                .apply(&PhpType::parse("array|list<string>"))
+                .is_none()
+        );
+    }
+
+    #[test]
+    fn array_projection_respects_shapes_and_unrelated_union_arms() {
+        assert!(
+            Projection::ArrayValue(Some("label".into()))
+                .apply(&PhpType::parse("object{label:string}"))
+                .is_none()
+        );
+        assert_eq!(
+            Projection::ArrayValue(None).apply(&PhpType::parse("list<string>|int")),
+            Some(PhpType::string())
+        );
+        assert_eq!(
+            Projection::CallableReturn.apply(&PhpType::parse("(callable():string)|int")),
+            Some(PhpType::string())
+        );
+    }
+}

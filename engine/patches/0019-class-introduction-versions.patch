+#[cfg(test)]
+mod workbench_class_introduction_tests {
+    use crate::{Backend, types::PhpVersion};
+    use std::collections::HashMap;
+    const SOURCE: &str =
+        "<?php\nclass LegacyVersionClass {}\n/** @since 8.1 */\nclass FutureVersionClass {}\n";
+    #[test]
+    fn future_builtin_classes_are_not_indexed_for_an_older_php_target() {
+        let backend = Backend::new_test_with_stubs(HashMap::from([
+            ("LegacyVersionClass", SOURCE),
+            ("FutureVersionClass", SOURCE),
+        ]));
+        backend.set_php_version(PhpVersion::new(7, 4));
+        assert!(backend.stub_index.read().contains_key("LegacyVersionClass"));
+        assert!(
+            !backend.stub_index.read().contains_key("FutureVersionClass"),
+            "PHP7.4 must not offer an8.1 built-in class"
+        );
+    }
+    #[test]
+    fn loading_an_older_sibling_does_not_resurrect_a_future_builtin_class() {
+        let backend = Backend::new_test_with_stubs(HashMap::from([("LegacyVersionClass", SOURCE)]));
+        backend.set_php_version(PhpVersion::new(7, 4));
+        assert!(backend.find_or_load_class("LegacyVersionClass").is_some());
+        assert!(
+            backend.find_or_load_class("FutureVersionClass").is_none(),
+            "lazy stub parsing must keep the same target gate"
+        );
+    }
+}
+
+#[cfg(test)]
+mod workbench_class_introduction_boundaries {
+    use crate::{Backend, types::PhpVersion};
+    use std::collections::HashMap;
+    #[test]
+    fn introduced_class_is_available_at_its_exact_minor_version() {
+        let source = "<?php\n/** @since 8.1 */\nclass VersionReady {}";
+        let backend = Backend::new_test_with_stubs(HashMap::from([("VersionReady", source)]));
+        backend.set_php_version(PhpVersion::new(8, 1));
+        assert!(backend.find_or_load_class("VersionReady").is_some());
+    }
+    #[test]
+    fn a_project_polyfill_is_not_filtered_as_a_stub() {
+        let source = "<?php\n/** @since 8.1 */\nclass VersionPolyfill {}";
+        let backend = Backend::new_test_with_stubs(HashMap::from([("VersionPolyfill", source)]));
+        backend.set_php_version(PhpVersion::new(7, 4));
+        backend.update_ast("file:///project.php", source);
+        assert!(backend.find_or_load_class("VersionPolyfill").is_some());
+    }
+    #[test]
+    fn duplicate_short_names_use_their_own_namespace_and_source_position() {
+        let source = "<?php\nnamespace Newer {\n/** @since 8.1 */\nclass Twin {}\n}\nnamespace Older {\nclass Twin {}\n}";
+        let backend = Backend::new_test_with_stubs(HashMap::from([
+            ("Newer\\Twin", source),
+            ("Older\\Twin", source),
+        ]));
+        backend.set_php_version(PhpVersion::new(7, 4));
+        assert!(!backend.stub_index.read().contains_key("Newer\\Twin"));
+        assert!(backend.stub_index.read().contains_key("Older\\Twin"));
+        assert!(backend.find_or_load_class("Older\\Twin").is_some());
+        assert!(backend.find_or_load_class("Newer\\Twin").is_none());
+    }
+    #[test]
+    fn pecl_release_notes_and_docblock_class_mentions_do_not_hide_legacy_classes() {
+        let source =
+            "<?php\n/** Example: class Mentioned {} */\n/** @since PECL 8.4 */\nclass Mentioned {}";
+        let backend = Backend::new_test_with_stubs(HashMap::from([("Mentioned", source)]));
+        backend.set_php_version(PhpVersion::new(7, 4));
+        assert!(backend.find_or_load_class("Mentioned").is_some());
+    }
+}

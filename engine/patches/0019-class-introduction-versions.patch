+/// Whether a built-in class-like declaration was introduced after the target.
+pub fn is_stub_class_introduced_after(
+    source: &str,
+    class_name: &str,
+    version: crate::types::PhpVersion,
+) -> bool {
+    if !source.contains("@since") {
+        return false;
+    }
+    let short = class_name.rsplit('\\').next().unwrap_or(class_name);
+    let mut positions = Vec::new();
+    for kind in ["class", "interface", "trait", "enum"] {
+        let needle = format!("{kind} {short}");
+        for (position, _) in source.match_indices(&needle) {
+            let after = position + needle.len();
+            if source
+                .as_bytes()
+                .get(after)
+                .is_some_and(|b| !b.is_ascii_whitespace() && !matches!(b, b'{' | b':'))
+            {
+                continue;
+            }
+            let line = source[..position].rfind('\n').map_or(0, |p| p + 1);
+            if source[line..position]
+                .split_whitespace()
+                .all(|word| matches!(word, "abstract" | "final" | "readonly"))
+            {
+                positions.push(position);
+            }
+        }
+    }
+    let position = if positions.len() == 1 {
+        positions.first().copied()
+    } else {
+        // Duplicate short names or unusual declaration layout need the same
+        // canonical parser used by resolution, not a second namespace parser.
+        let (classes, _) = crate::Backend::parse_php_classes_by_block(source, None);
+        classes.into_iter().find_map(|(class, namespace, _)| {
+            let fqn = namespace.filter(|ns| !ns.is_empty()).map_or_else(
+                || class.name.to_string(),
+                |ns| format!("{ns}\\{}", class.name),
+            );
+            (fqn.eq_ignore_ascii_case(class_name.trim_start_matches('\\'))
+                && class.keyword_offset > 0)
+                .then_some(class.keyword_offset as usize)
+        })
+    };
+    position.is_some_and(|position| introduced_after_at(source, position, version))
+}
+
+pub(crate) fn is_stub_class_introduced_after_offset(
+    source: &str,
+    keyword_offset: u32,
+    version: crate::types::PhpVersion,
+) -> bool {
+    keyword_offset > 0 && introduced_after_at(source, keyword_offset as usize, version)
+}

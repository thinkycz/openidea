index 0000000..a14b28f
--- /dev/null
+++ b/tests/integration/extension_profiles.rs
@@ -0,0 +1,115 @@
+//! Deployment extension availability uses the same built-in lookup path as LSP.
+use phpantom_lsp::{Backend, config::Config};
+use tower_lsp::lsp_types::Url;
+
+async fn class_available(backend: &Backend, name: &str) -> bool {
+    let text = format!("<?php\nnew {name}");
+    let labels = super::common::complete_labels_at(
+        backend,
+        &Url::parse("file:///extensions.php").unwrap(),
+        &text,
+        1,
+        (4 + name.len()) as u32,
+    )
+    .await;
+    labels
+        .iter()
+        .any(|label| label.trim_start_matches('\\') == name)
+}
+
+fn with_profile(names: Option<&[&str]>) -> Backend {
+    let backend = Backend::new_test_with_full_stubs();
+    let text = names.map_or_else(String::new, |names| {
+        format!(
+            "[php]\nextensions = {}",
+            serde_json::to_string(names).unwrap()
+        )
+    });
+    backend.set_config(toml::from_str::<Config>(&text).unwrap());
+    backend.set_php_version(backend.php_version());
+    backend
+}
+
+#[tokio::test]
+async fn extension_profiles_filter_all_three_builtin_indices() {
+    let backend = with_profile(Some(&[]));
+    assert!(backend.stub_function_index_mut().contains_key("strlen"));
+    assert!(class_available(&backend, "Exception").await);
+    assert!(class_available(&backend, "ReflectionClass").await);
+    assert!(class_available(&backend, "ArrayIterator").await);
+    assert!(!backend.stub_function_index_mut().contains_key("curl_init"));
+    assert!(!class_available(&backend, "CURLFile").await);
+    assert!(!backend.stub_constant_index().contains_key("CURLOPT_URL"));
+    assert!(
+        !backend
+            .stub_function_index_mut()
+            .contains_key("mysqli_connect")
+    );
+    assert!(!class_available(&backend, "PDO").await);
+}
+
+#[tokio::test]
+async fn extension_profiles_normalize_composer_case_and_directory_aliases() {
+    let backend = with_profile(Some(&["ext-CuRL", "PDO", "sqlite3", "opcache"]));
+    assert!(backend.stub_function_index_mut().contains_key("curl_init"));
+    assert!(class_available(&backend, "CURLFile").await);
+    assert!(backend.stub_constant_index().contains_key("CURLOPT_URL"));
+    assert!(class_available(&backend, "PDO").await);
+    assert!(class_available(&backend, "SQLite3").await);
+    assert!(
+        backend
+            .stub_function_index_mut()
+            .contains_key("opcache_get_status")
+    );
+    assert!(
+        !backend
+            .stub_function_index_mut()
+            .contains_key("mysqli_connect")
+    );
+}
+
+#[tokio::test]
+async fn extension_profiles_default_and_explicit_all_preserve_bundled_symbols() {
+    for names in [None, Some(["*"].as_slice())] {
+        let backend = with_profile(names);
+        assert!(backend.stub_function_index_mut().contains_key("curl_init"));
+        assert!(class_available(&backend, "mysqli").await);
+        assert!(backend.stub_constant_index().contains_key("CURLOPT_URL"));
+    }
+}
+
+#[tokio::test]
+async fn extension_profiles_do_not_make_unknown_extensions_enable_everything() {
+    let backend = with_profile(Some(&["future_custom_extension"]));
+    assert!(backend.stub_function_index_mut().contains_key("strlen"));
+    assert!(backend.find_or_load_function(&["curl_init"]).is_none());
+    assert!(!class_available(&backend, "CURLFile").await);
+}
+
+#[test]
+fn extension_profiles_do_not_restore_lazy_symbols_after_a_fresh_service() {
+    let enabled = with_profile(Some(&["curl"]));
+    assert!(enabled.find_or_load_function(&["curl_init"]).is_some());
+    assert!(enabled.find_or_load_function(&["curl_exec"]).is_some());
+    let disabled = with_profile(Some(&[]));
+    assert!(disabled.find_or_load_function(&["curl_init"]).is_none());
+    assert!(disabled.find_or_load_function(&["curl_exec"]).is_none());
+}
+
+#[test]
+fn extension_profiles_reject_invalid_and_unbounded_settings() {
+    for text in [
+        "[php]\nextensions='curl'".to_string(),
+        "[php]\nextensions=[true]".to_string(),
+        "[php]\nextensions=['*','curl']".to_string(),
+        "[php]\nextensions=['curl/../../file']".to_string(),
+        "[php]\nextensions=['']".to_string(),
+        format!("[php]\nextensions=['{}']", "a".repeat(65)),
+        format!(
+            "[php]\nextensions={}",
+            serde_json::to_string(&vec!["curl"; 257]).unwrap()
+        ),
+    ] {
+        assert!(toml::from_str::<Config>(&text).is_err(), "{text}");
+    }
+}

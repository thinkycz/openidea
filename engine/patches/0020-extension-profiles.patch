index b579dce..89e76ca 100644
--- a/src/config.rs
+++ b/src/config.rs
@@ -148,6 +148,34 @@ pub struct PhpConfig {
     /// Override the detected PHP version (e.g. `"8.3"`).
     /// When `None`, PHPantom infers from `composer.json`.
     pub version: Option<String>,
+    /// Built-in extension allowlist. Absent or `["*"]` keeps every bundled
+    /// extension; `[]` keeps only Core, standard, Reflection and SPL.
+    /// This describes the deployment target and never probes a PHP process.
+    #[serde(deserialize_with = "deserialize_php_extensions")]
+    pub extensions: Option<Vec<String>>,
+}
+
+fn deserialize_php_extensions<'de, D>(deserializer: D) -> Result<Option<Vec<String>>, D::Error>
+where
+    D: serde::Deserializer<'de>,
+{
+    use serde::de::Error;
+    let names = Vec::<String>::deserialize(deserializer)?;
+    if names.len() > 256
+        || names.iter().any(|name| {
+            name.is_empty()
+                || name.len() > 64
+                || !name
+                    .bytes()
+                    .all(|b| b.is_ascii_alphanumeric() || b"_- *".contains(&b))
+        })
+        || (names.iter().any(|name| name == "*") && names.len() != 1)
+    {
+        return Err(D::Error::custom(
+            "PHP extensions must be up to 256 names or [\"*\"]",
+        ));
+    }
+    Ok(Some(names))
 }
 

+/// Normalize pinned stub directory names and Composer's `ext-` spelling.
+fn extension_name(name: &str) -> String {
+    let lower = name.trim().to_ascii_lowercase();
+    let name = lower.strip_prefix("ext-").unwrap_or(&lower);
+    match name {
+        "zend opcache" | "zendopcache" | "zend_opcache" => "opcache".to_string(),
+        "sqlite" => "sqlite3".to_string(),
+        "apache2handler" => "apache".to_string(),
+        _ => name.to_string(),
+    }
+}
+
+/// Stub sources excluded by an explicit extension profile. Pointer plus length
+/// avoids hashing megabytes of source once for every symbol in a shared file.
+/// Identical embedded strings may share storage: keep a source if any owner is
+/// enabled, because that enabled extension supplies the same declarations.
+pub(crate) fn disabled_extension_sources(
+    names: &[String],
+) -> std::collections::HashSet<(usize, usize)> {
+    use std::collections::HashSet;
+    if names.iter().any(|name| name == "*") {
+        return HashSet::new();
+    }
+    let enabled: HashSet<String> = names.iter().map(|name| extension_name(name)).collect();
+    let mut allowed = HashSet::new();
+    let mut disabled = HashSet::new();
+    for (&source, &owner) in STUB_FILES.iter().zip(STUB_FILE_EXTENSIONS.iter()) {
+        let owner = extension_name(owner);
+        let identity = (source.as_ptr() as usize, source.len());
+        if matches!(owner.as_str(), "core" | "standard" | "reflection" | "spl")
+            || enabled.contains(&owner)
+        {
+            allowed.insert(identity);
+        } else {
+            disabled.insert(identity);
+        }
+    }
+    disabled.retain(|identity| !allowed.contains(identity));
+    disabled
+}
+

+/// Describe actual selected groups and unknown names without reading disk.
+pub(crate) fn describe_extension_selection(
+    names: Option<&[String]>,
+) -> (Option<Vec<String>>, Vec<String>) {
+    use std::collections::BTreeSet;
+    let Some(names) = names.filter(|names| !names.iter().any(|name| name == "*")) else {
+        return (None, Vec::new());
+    };
+    let known: BTreeSet<String> = STUB_FILE_EXTENSIONS
+        .iter()
+        .map(|name| extension_name(name))
+        .collect();
+    let requested: BTreeSet<String> = names.iter().map(|name| extension_name(name)).collect();
+    let (enabled, unknown): (Vec<_>, Vec<_>) =
+        requested.into_iter().partition(|name| known.contains(name));
+    (Some(enabled), unknown)
+}

index 0000000..a70354d
--- /dev/null
+++ b/src/workbench_active_target.rs
@@ -0,0 +1,51 @@
+//! Applied language-intelligence settings, independent of watched saved config.
+use crate::{Backend, stubs, types::PhpVersion};
+use serde::{Deserialize, Serialize};
+use tower_lsp::jsonrpc::{Error, Result};
+
+/// Read-only active-target query; no project files or processes are accessed.
+#[derive(Debug, Default, Deserialize)]
+pub struct TargetQuery {}
+
+/// Settings already applied to the current service's built-in indexes.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct ActiveTarget {
+    /// Major/minor language target used by the service.
+    pub php_version: String,
+    /// Available selected extension groups; `None` means all bundled groups.
+    pub extensions: Option<Vec<String>>,
+    /// Requested groups without declarations in the pinned bundled stubs.
+    pub unknown_extensions: Vec<String>,
+    /// Version of the service producing this snapshot.
+    pub engine_version: String,
+    /// Version of the embedded declaration corpus.
+    pub stubs_version: String,
+}
+
+impl ActiveTarget {
+    pub(crate) fn applied(version: PhpVersion, names: Option<&[String]>, engine: &str) -> Self {
+        let (extensions, unknown_extensions) = stubs::describe_extension_selection(names);
+        Self {
+            php_version: version.to_string(),
+            extensions,
+            unknown_extensions,
+            engine_version: engine.to_string(),
+            stubs_version: stubs::STUBS_VERSION.to_string(),
+        }
+    }
+}
+
+impl Backend {
+    /// Return only applied settings, never relabel a service from changed TOML.
+    pub async fn workbench_active_target(&self, _: TargetQuery) -> Result<ActiveTarget> {
+        self.workspace
+            .active_php_target
+            .read()
+            .clone()
+            .ok_or_else(|| {
+                let mut error = Error::new(tower_lsp::jsonrpc::ErrorCode::ServerError(-32002));
+                error.message = "PHP target is still initializing; retry shortly".into();
+                error
+            })
+    }
+}

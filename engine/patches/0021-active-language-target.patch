diff --git a/tests/integration/active_php_target.rs b/tests/integration/active_php_target.rs
new file mode 100644
index 0000000..b829ce3
--- /dev/null
+++ b/tests/integration/active_php_target.rs
@@ -0,0 +1,124 @@
+use phpantom_lsp::{
+    Backend, config::Config, types::PhpVersion, workbench_active_target::TargetQuery,
+};
+use tower_lsp::{
+    LanguageServer,
+    lsp_types::{InitializeParams, InitializedParams},
+};
+
+#[tokio::test]
+async fn target_snapshot_refuses_to_claim_defaults_before_settings_are_applied() {
+    let backend = Backend::new_test();
+    let error = backend
+        .workbench_active_target(TargetQuery {})
+        .await
+        .unwrap_err();
+    assert_eq!(error.code.code(), -32002);
+}
+
+#[tokio::test]
+async fn target_snapshot_describes_canonical_extensions_unknown_names_and_versions() {
+    let backend = Backend::new_test();
+    let config: Config =
+        toml::from_str("[php]\nextensions=['ext-CuRL', 'PDO', 'curl', 'future_private']").unwrap();
+    backend.set_config(config);
+    backend.set_php_version(PhpVersion::new(8, 3));
+    let target = backend
+        .workbench_active_target(TargetQuery {})
+        .await
+        .unwrap();
+    assert_eq!(target.php_version, "8.3");
+    assert_eq!(target.extensions, Some(vec!["curl".into(), "pdo".into()]));
+    assert_eq!(target.unknown_extensions, vec!["future_private"]);
+    assert!(!target.engine_version.is_empty());
+    assert!(!target.stubs_version.is_empty());
+}
+
+#[tokio::test]
+async fn target_snapshot_does_not_follow_config_without_application() {
+    let backend = Backend::new_test();
+    backend.set_config(toml::from_str("[php]\nversion='8.3'\nextensions=['curl']").unwrap());
+    backend.set_php_version(PhpVersion::new(8, 3));
+    let original = backend
+        .workbench_active_target(TargetQuery {})
+        .await
+        .unwrap();
+    backend.set_config(toml::from_str("[php]\nversion='7.4'\nextensions=[]").unwrap());
+    let current = backend
+        .workbench_active_target(TargetQuery {})
+        .await
+        .unwrap();
+    assert_eq!(current, original);
+}
+
+#[tokio::test]
+async fn target_snapshot_distinguishes_all_and_core_only() {
+    for (text, expected) in [
+        ("", None),
+        ("[php]\nextensions=['*']", None),
+        ("[php]\nextensions=[]", Some(Vec::new())),
+    ] {
+        let backend = Backend::new_test();
+        backend.set_config(toml::from_str(text).unwrap());
+        backend.set_php_version(PhpVersion::new(8, 2));
+        assert_eq!(
+            backend
+                .workbench_active_target(TargetQuery {})
+                .await
+                .unwrap()
+                .extensions,
+            expected
+        );
+    }
+}
+
+#[tokio::test]
+async fn target_snapshot_query_is_advertised_independently_of_readiness() {
+    let backend = Backend::new_test();
+    let response = backend
+        .initialize(InitializeParams::default())
+        .await
+        .unwrap();
+    assert_eq!(
+        response.capabilities.experimental.unwrap()["phpWorkbenchActiveTarget"],
+        true
+    );
+    assert!(
+        backend
+            .workbench_active_target(TargetQuery {})
+            .await
+            .is_err()
+    );
+}
+
+#[tokio::test]
+async fn target_snapshot_does_not_read_new_saved_project_settings() {
+    let root = tempfile::tempdir().unwrap();
+    let backend = Backend::new_test_with_workspace(root.path().to_path_buf(), Vec::new());
+    backend.set_config(toml::from_str("[php]\nextensions=['pdo']").unwrap());
+    backend.set_php_version(PhpVersion::new(8, 1));
+    let config = root.path().join(".phpantom.toml");
+    std::fs::write(&config, "[php]\nversion='8.5'\nextensions=['*']\n").unwrap();
+    let target = backend
+        .workbench_active_target(TargetQuery {})
+        .await
+        .unwrap();
+    assert_eq!(target.php_version, "8.1");
+    assert_eq!(target.extensions, Some(vec!["pdo".into()]));
+}
+
+#[tokio::test]
+async fn standalone_initialization_applies_the_default_target_before_reporting_it() {
+    let backend = Backend::new_test();
+    backend
+        .initialize(InitializeParams::default())
+        .await
+        .unwrap();
+    backend.initialized(InitializedParams {}).await;
+    let target = backend
+        .workbench_active_target(TargetQuery {})
+        .await
+        .unwrap();
+    assert_eq!(target.php_version, backend.php_version().to_string());
+    assert!(target.extensions.is_none());
+}

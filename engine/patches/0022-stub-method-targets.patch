+/// Check a declaration's own parsed PHPDoc, without searching nearby members.
+pub(crate) fn docblock_introduced_after(docblock: &str, version: crate::types::PhpVersion) -> bool {
+    if !docblock.contains("@since") {
+        return false;
+    }
     let body = docblock
         .get(3..docblock.len().saturating_sub(2))
         .unwrap_or("");

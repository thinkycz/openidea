--- /dev/null
+++ b/tests/integration/stub_method_versions.rs
@@ -0,0 +1,105 @@
+//! Stub PHP method introduction tags must govern the shared class model.
+use crate::common::complete_at;
+use phpantom_lsp::{Backend, types::PhpVersion};
+use std::collections::HashMap;
+use tower_lsp::lsp_types::Url;
+
+const STUB: &str = r#"<?php
+class Clock {
+    public static function createLegacy() {}
+    /** @since 8.4 */
+    #[\JetBrains\PhpStorm\Pure]
+    public static function createFuture() {}
+    /** @since PECL 9.0 */
+    public static function createExtension() {}
+}
+class OtherClock {
+    /** @since 8.2 */
+    public static function createFuture() {}
+}
+"#;
+fn backend(version: u8) -> Backend {
+    let backend = Backend::new_test_with_all_stubs(
+        HashMap::from([("Clock", STUB), ("OtherClock", STUB)]),
+        HashMap::new(),
+        HashMap::new(),
+    );
+    backend.set_php_version(PhpVersion::new(8, version));
+    backend
+}
+async fn has(backend: &Backend, source: &str, name: &str) -> bool {
+    let line = source.lines().count() - 1;
+    let col = source.lines().last().unwrap().len();
+    complete_at(
+        backend,
+        &Url::parse("file:///method-target.php").unwrap(),
+        source,
+        line as u32,
+        col as u32,
+    )
+    .await
+    .iter()
+    .any(|i| {
+        i.filter_text
+            .as_deref()
+            .unwrap_or(i.label.split('(').next().unwrap())
+            == name
+    })
+}
+#[tokio::test]
+async fn stub_method_since_boundaries_preserve_legacy_and_extension_versions() {
+    for (version, expected) in [(3, false), (4, true), (5, true)] {
+        let b = backend(version);
+        assert!(has(&b, "<?php\nClock::create", "createLegacy").await);
+        assert!(has(&b, "<?php\nClock::create", "createExtension").await);
+        assert_eq!(
+            has(&b, "<?php\nClock::create", "createFuture").await,
+            expected,
+            "8.{version}"
+        );
+    }
+}
+#[tokio::test]
+async fn inherited_stub_methods_use_the_target_filtered_model() {
+    let b = backend(3);
+    assert!(
+        !has(
+            &b,
+            "<?php\nclass LocalClock extends Clock {}\nLocalClock::create",
+            "createFuture"
+        )
+        .await
+    );
+    assert!(
+        has(
+            &b,
+            "<?php\nclass LocalClock extends Clock {}\nLocalClock::create",
+            "createLegacy"
+        )
+        .await
+    );
+}
+#[tokio::test]
+async fn sibling_classes_with_equal_method_names_keep_their_own_tags() {
+    let b = backend(3);
+    assert!(has(&b, "<?php\nOtherClock::create", "createFuture").await);
+    assert!(!has(&b, "<?php\nClock::create", "createFuture").await);
+    assert!(has(&b, "<?php\nOtherClock::create", "createFuture").await);
+}
+#[tokio::test]
+async fn project_method_since_is_not_a_php_release_constraint() {
+    let b = backend(3);
+    assert!(has(&b,"<?php\nclass LocalClock { /** @since 99.0 */ public static function createFuture() {} }\nLocalClock::create", "createFuture").await);
+}
+#[tokio::test]
+async fn member_tags_do_not_leak_to_adjacent_undocumented_methods() {
+    const ADJACENT: &str = "<?php class Adjacent { /** @since 8.4 */ public $future; public static function createLegacy() {} /** @since 8.5 */ public const FUTURE = 1; public static function createOther() {} }";
+    let b = Backend::new_test_with_all_stubs(
+        HashMap::from([("Adjacent", ADJACENT)]),
+        HashMap::new(),
+        HashMap::new(),
+    );
+    b.set_php_version(PhpVersion::new(8, 3));
+    assert!(has(&b, "<?php\nAdjacent::create", "createLegacy").await);
+    assert!(has(&b, "<?php\nAdjacent::create", "createOther").await);
+}

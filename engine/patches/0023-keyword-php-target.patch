+fn keyword_available_for_target(keyword: &str, ctx: KeywordContext, version: PhpVersion) -> bool {
+    let minimum = match keyword {
+        "fn" => PhpVersion::new(7, 4),
+        "match" => PhpVersion::new(8, 0),
+        "enum" => PhpVersion::new(8, 1),
+        // Outside class-member declarations, readonly introduces a class.
+        "readonly" if ctx.class_body_kind.is_some() => PhpVersion::new(8, 1),
+        "readonly" => PhpVersion::new(8, 2),
+        _ => return true,
+    };
+    version >= minimum
+}

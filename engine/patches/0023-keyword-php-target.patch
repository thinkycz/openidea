diff --git a/tests/integration/keyword_php_target.rs b/tests/integration/keyword_php_target.rs
new file mode 100644
index 0000000..cd07385
--- /dev/null
+++ b/tests/integration/keyword_php_target.rs
@@ -0,0 +1,131 @@
+//! Modern keyword suggestions must follow the selected PHP target.
+use crate::common::complete_at;
+use phpantom_lsp::{Backend, types::PhpVersion};
+use tower_lsp::lsp_types::{CompletionItemKind, Url};
+async fn offered(backend: &Backend, source: &str, label: &str, kind: CompletionItemKind) -> bool {
+    let position = source.find("<caret>").unwrap();
+    let before = &source[..position];
+    let line = before.bytes().filter(|b| *b == b'\n').count() as u32;
+    let col = before.rsplit('\n').next().unwrap().encode_utf16().count() as u32;
+    let items = complete_at(
+        backend,
+        &Url::parse("file:///keyword-target.php").unwrap(),
+        &source.replace("<caret>", ""),
+        line,
+        col,
+    )
+    .await;
+    items.iter().any(|item| {
+        item.kind == Some(kind)
+            && item
+                .filter_text
+                .as_deref()
+                .unwrap_or(item.label.split('(').next().unwrap())
+                == label
+    })
+}
+fn backend(major: u8, minor: u8) -> Backend {
+    let backend = Backend::new_test();
+    backend.set_php_version(PhpVersion::new(major, minor));
+    backend
+}
+#[tokio::test]
+async fn arrow_keyword_starts_at_php74() {
+    for (minor, expected) in [(3, false), (4, true)] {
+        assert_eq!(
+            offered(
+                &backend(7, minor),
+                "<?php\n$callback = fn<caret>",
+                "fn",
+                CompletionItemKind::KEYWORD
+            )
+            .await,
+            expected
+        );
+    }
+}
+#[tokio::test]
+async fn match_and_enum_keywords_follow_separate_release_boundaries() {
+    for (major, minor) in [(7, 4), (8, 0), (8, 1), (8, 5)] {
+        let b = backend(major, minor);
+        let v = PhpVersion::new(major, minor);
+        assert_eq!(
+            offered(
+                &b,
+                "<?php\nfunction demo() { mat<caret> }",
+                "match",
+                CompletionItemKind::KEYWORD
+            )
+            .await,
+            v >= PhpVersion::new(8, 0)
+        );
+        assert_eq!(
+            offered(&b, "<?php\nen<caret>", "enum", CompletionItemKind::KEYWORD).await,
+            v >= PhpVersion::new(8, 1)
+        );
+    }
+}
+#[tokio::test]
+async fn readonly_properties_and_promoted_parameters_start_at_php81() {
+    for (minor, expected) in [(0, false), (1, true), (2, true)] {
+        let b = backend(8, minor);
+        for source in [
+            "<?php\nclass Demo { public rea<caret> }",
+            "<?php\nclass Demo { public function __construct(public rea<caret>) {} }",
+            "<?php\ntrait Demo { public rea<caret> }",
+        ] {
+            assert_eq!(
+                offered(&b, source, "readonly", CompletionItemKind::KEYWORD).await,
+                expected,
+                "8.{minor}: {source}"
+            );
+        }
+    }
+}
+#[tokio::test]
+async fn readonly_classes_require_php82_even_in_function_bodies() {
+    for (minor, expected) in [(0, false), (1, false), (2, true), (5, true)] {
+        let b = backend(8, minor);
+        for source in ["<?php\nrea<caret>", "<?php\nfunction demo() { rea<caret> }"] {
+            assert_eq!(
+                offered(&b, source, "readonly", CompletionItemKind::KEYWORD).await,
+                expected,
+                "8.{minor}: {source}"
+            );
+        }
+    }
+}
+#[tokio::test]
+async fn empty_member_modifier_prefix_keeps_legacy_keywords_and_gates_readonly() {
+    for (minor, expected) in [(0, false), (1, true)] {
+        let b = backend(8, minor);
+        let source = "<?php\nclass Demo { public <caret> }";
+        assert!(offered(&b, source, "function", CompletionItemKind::KEYWORD).await);
+        assert_eq!(
+            offered(&b, source, "readonly", CompletionItemKind::KEYWORD).await,
+            expected
+        );
+    }
+}
+#[tokio::test]
+async fn keyword_gates_do_not_filter_project_symbols_or_ordinary_keywords() {
+    let b = backend(7, 4);
+    assert!(
+        offered(
+            &b,
+            "<?php\nfun<caret>",
+            "function",
+            CompletionItemKind::KEYWORD
+        )
+        .await
+    );
+    assert!(
+        offered(
+            &b,
+            "<?php\nfunction matchProjectTimer() {}\nmat<caret>",
+            "matchProjectTimer",
+            CompletionItemKind::FUNCTION
+        )
+        .await
+    );
+}

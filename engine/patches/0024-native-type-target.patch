+/// Declaration roles have different native-type and language-version rules.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum TypeHintPosition {
+    Parameter,
+    Return,
+    Property,
+    PromotedProperty,

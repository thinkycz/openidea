+++ b/tests/integration/native_type_php_target.rs
@@ -0,0 +1,233 @@
+//! Native declarations must use the selected PHP language and declaration kind.
+use crate::common::complete_at;
+use phpantom_lsp::{Backend, types::PhpVersion};
+use tower_lsp::lsp_types::{CompletionItemKind, Url};
+fn backend(major: u8, minor: u8) -> Backend {
+    let backend = Backend::new_test();
+    backend.set_php_version(PhpVersion::new(major, minor));
+    backend
+}
+async fn offered(b: &Backend, source: &str, label: &str, kind: CompletionItemKind) -> bool {
+    let offset = source.find("<caret>").unwrap();
+    let before = &source[..offset];
+    let line = before.bytes().filter(|b| *b == b'\n').count() as u32;
+    let col = before.rsplit('\n').next().unwrap().encode_utf16().count() as u32;
+    complete_at(
+        b,
+        &Url::parse("file:///native-type-target.php").unwrap(),
+        &source.replace("<caret>", ""),
+        line,
+        col,
+    )
+    .await
+    .iter()
+    .any(|item| {
+        item.kind == Some(kind)
+            && (kind != CompletionItemKind::KEYWORD
+                || item.detail.as_deref() == Some("PHP built-in type"))
+            && item.filter_text.as_deref().unwrap_or(&item.label) == label
+    })
+}
+async fn keyword(b: &Backend, source: &str, label: &str) -> bool {
+    offered(b, source, label, CompletionItemKind::KEYWORD).await
+}
+#[tokio::test]
+async fn mixed_starts_at_php80_in_parameters_returns_and_properties() {
+    for (major, minor, expected) in [(7, 4, false), (8, 0, true), (8, 5, true)] {
+        let b = backend(major, minor);
+        for source in [
+            "<?php function demo(mi<caret>) {}",
+            "<?php function demo(): mi<caret> {}",
+            "<?php class Demo { public mi<caret> }",
+        ] {
+            assert_eq!(
+                keyword(&b, source, "mixed").await,
+                expected,
+                "{major}.{minor} {source}"
+            );
+        }
+    }
+}
+#[tokio::test]
+async fn never_starts_at_php81_as_return_type() {
+    for (minor, expected) in [(0, false), (1, true), (5, true)] {
+        let b = backend(8, minor);
+        assert_eq!(
+            keyword(&b, "<?php function demo(): ne<caret> {}", "never").await,
+            expected
+        );
+    }
+}
+#[tokio::test]
+async fn return_only_types_do_not_leak_into_parameters_or_properties() {
+    let b = backend(8, 5);
+    for (prefix, label) in [("vo", "void"), ("ne", "never"), ("sta", "static")] {
+        for template in [
+            "<?php function demo(PREFIX<caret>) {}",
+            "<?php class Demo { public PREFIX<caret> }",
+            "<?php class Demo { function __construct(public PREFIX<caret>) {} }",
+        ] {
+            let source = template.replace("PREFIX", prefix);
+            assert!(
+                !keyword(&b, &source, label).await,
+                "{source} offered {label}"
+            );
+        }
+    }
+}
+#[tokio::test]
+async fn callable_is_a_parameter_or_return_type_but_not_a_property_type() {
+    let b = backend(8, 5);
+    for source in [
+        "<?php function demo(ca<caret>) {}",
+        "<?php function demo(): ca<caret> {}",
+    ] {
+        assert!(keyword(&b, source, "callable").await, "{source}");
+    }
+    for source in [
+        "<?php class Demo { public ca<caret> }",
+        "<?php class Demo { function __construct(public ca<caret>) {} }",
+    ] {
+        assert!(!keyword(&b, source, "callable").await, "{source}");
+    }
+}
+#[tokio::test]
+async fn standalone_literal_types_start_at_php82() {
+    for (minor, expected) in [(0, false), (1, false), (2, true), (5, true)] {
+        let b = backend(8, minor);
+        for (prefix, label) in [("tr", "true"), ("fa", "false"), ("nu", "null")] {
+            for template in [
+                "<?php function demo(PREFIX<caret>) {}",
+                "<?php function demo(): PREFIX<caret> {}",
+                "<?php class Demo { public PREFIX<caret> }",
+            ] {
+                let source = template.replace("PREFIX", prefix);
+                assert_eq!(
+                    keyword(&b, &source, label).await,
+                    expected,
+                    "8.{minor} {source}"
+                );
+            }
+        }
+    }
+}
+#[tokio::test]
+async fn union_literal_types_have_separate_availability_from_standalone_types() {
+    for (major, minor) in [(7, 4), (8, 0), (8, 1), (8, 2)] {
+        let b = backend(major, minor);
+        for (prefix, label, min_minor) in [("fa", "false", 0), ("nu", "null", 0), ("tr", "true", 2)]
+        {
+            let source = format!("<?php function demo(): int|{prefix}<caret> {{}}");
+            assert_eq!(
+                keyword(&b, &source, label).await,
+                major >= 8 && minor >= min_minor,
+                "{major}.{minor} {source}"
+            );
+        }
+    }
+}
+#[tokio::test]
+async fn non_composable_types_are_excluded_after_union_and_nullable_modifiers() {
+    let b = backend(8, 5);
+    for modifier in ["int|", "?"] {
+        for (prefix, label) in [
+            ("mi", "mixed"),
+            ("vo", "void"),
+            ("ne", "never"),
+            ("nu", "null"),
+        ] {
+            if modifier == "int|" && label == "null" {
+                continue;
+            }
+            let source = format!("<?php function demo(): {modifier}{prefix}<caret> {{}}");
+            assert!(!keyword(&b, &source, label).await, "{source}");
+        }
+    }
+    assert!(keyword(&b, "<?php function demo(): ?str<caret> {}", "string").await);
+}
+#[tokio::test]
+async fn intersection_positions_offer_classes_without_native_scalar_types() {
+    let b = backend(8, 5);
+    for (prefix, label) in [
+        ("str", "string"),
+        ("mi", "mixed"),
+        ("self", "self"),
+        ("sta", "static"),
+        ("par", "parent"),
+    ] {
+        let source = format!("<?php class Demo {{ function f(): Countable&{prefix}<caret> {{}} }}");
+        assert!(!keyword(&b, &source, label).await, "{source}");
+    }
+    assert!(
+        offered(
+            &b,
+            "<?php interface ProjectItem {} function f(): Countable&Proj<caret> {}",
+            "ProjectItem",
+            CompletionItemKind::CLASS
+        )
+        .await
+    );
+}
+#[tokio::test]
+async fn property_and_promoted_type_positions_follow_introduction_versions() {
+    for (major, minor) in [(7, 3), (7, 4), (8, 0)] {
+        let b = backend(major, minor);
+        assert_eq!(
+            keyword(&b, "<?php class Demo { public str<caret> }", "string").await,
+            (major, minor) >= (7, 4)
+        );
+        assert_eq!(
+            keyword(
+                &b,
+                "<?php class Demo { function __construct(public str<caret>) {} }",
+                "string"
+            )
+            .await,
+            major >= 8
+        );
+    }
+}
+#[tokio::test]
+async fn project_classes_and_phpdoc_types_keep_their_own_semantics() {
+    let b = backend(7, 4);
+    assert!(
+        offered(
+            &b,
+            "<?php class MixedProjectType {} function f(Mi<caret>) {}",
+            "MixedProjectType",
+            CompletionItemKind::CLASS
+        )
+        .await
+    );
+    assert!(
+        keyword(
+            &b,
+            "<?php /** @param mi<caret> $value */ function demo($value) {}",
+            "mixed"
+        )
+        .await
+    );
+}
+
+#[tokio::test]
+async fn literal_only_unions_require_php82_but_concrete_union_members_keep_php80() {
+    for (minor, expected) in [(0, false), (1, false), (2, true), (5, true)] {
+        let b = backend(8, minor);
+        for source in [
+            "<?php function demo(): false|nu<caret> {}",
+            "<?php function demo(): null|fa<caret> {}",
+        ] {
+            let label = if source.contains("|nu") {
+                "null"
+            } else {
+                "false"
+            };
+            assert_eq!(
+                keyword(&b, source, label).await,
+                expected,
+                "8.{minor} {source}"
+            );
+        }
+        assert!(keyword(&b, "<?php function demo(): int|false|nu<caret> {}", "null").await);
+    }
+}

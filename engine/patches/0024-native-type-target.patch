+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+struct TypeModifiers {
+    nullable: bool,
+    union: bool,
+    intersection: bool,
+    has_non_literal_member: bool,
+}
+impl TypeModifiers {
+    fn add(&mut self, operator: char) {
+        match operator {
+            '?' => self.nullable = true,
+            '|' => self.union = true,
+            '&' => self.intersection = true,
+            _ => {}
+        }
+    }
+    fn is_plain(self) -> bool {
+        !self.nullable && !self.union && !self.intersection
+    }

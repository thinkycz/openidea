+impl TypeHintContext {
+    fn plain(partial: String, needs_space_prefix: bool, position: TypeHintPosition) -> Self {
+        Self {
+            partial,
+            needs_space_prefix,
+            position,
+            modifiers: TypeModifiers::default(),

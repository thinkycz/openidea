+    pub(crate) fn available_for_target(&self, version: PhpVersion) -> bool {
+        let minimum = match self.position {
+            TypeHintPosition::Property => PhpVersion::new(7, 4),
+            TypeHintPosition::PromotedProperty => PhpVersion::new(8, 0),
+            TypeHintPosition::Return => PhpVersion::new(7, 0),
+            TypeHintPosition::Parameter => PhpVersion::new(5, 0),
+        };
+        version >= minimum
+            && (!self.modifiers.nullable || version >= PhpVersion::new(7, 1))
+            && (!self.modifiers.union || version >= PhpVersion::new(8, 0))
+            && (!self.modifiers.intersection || version >= PhpVersion::new(8, 1))
+    }
+    pub(crate) fn native_type_available(&self, name: &str, version: PhpVersion) -> bool {
+        if !self.available_for_target(version) || self.modifiers.intersection {
+            return false;
+        }
+        match name {
+            "mixed" => version >= PhpVersion::new(8, 0) && self.modifiers.is_plain(),
+            "never" => {
+                version >= PhpVersion::new(8, 1)
+                    && self.position == TypeHintPosition::Return
+                    && self.modifiers.is_plain()
+            }
+            "void" => {
+                version >= PhpVersion::new(7, 1)
+                    && self.position == TypeHintPosition::Return
+                    && self.modifiers.is_plain()
+            }
+            "static" => {
+                version >= PhpVersion::new(8, 0) && self.position == TypeHintPosition::Return
+            }
+            "callable" => !matches!(
+                self.position,
+                TypeHintPosition::Property | TypeHintPosition::PromotedProperty
+            ),
+            "object" => version >= PhpVersion::new(7, 2),
+            "iterable" => version >= PhpVersion::new(7, 1),
+            "true" => version >= PhpVersion::new(8, 2),
+            "false" | "null" => {
+                !(name == "null" && self.modifiers.nullable)
+                    && (version >= PhpVersion::new(8, 2)
+                        || (version >= PhpVersion::new(8, 0)
+                            && self.modifiers.union
+                            && self.modifiers.has_non_literal_member
+                            && !self.modifiers.nullable))
+            }
+            "string" | "int" | "float" | "bool" => version >= PhpVersion::new(7, 0),
+            _ => true,
+        }
+    }
 }
 

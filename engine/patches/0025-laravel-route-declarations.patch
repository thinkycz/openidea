+#[derive(Default)]
+struct RouteConflicts<'a> {
+    names: Vec<&'a str>,
+    related: Vec<Location>,
+}
+
 impl Backend {
+    /// Warn at distinct statically discovered declarations of the same route name.
+    /// Conditional registration can still depend on runtime configuration.
+    pub(super) fn collect_duplicate_laravel_route_diagnostics(
+        &self,
+        uri: &str,
+        content: &str,
+        out: &mut Vec<Diagnostic>,
+    ) {
+        use std::collections::{BTreeMap, HashMap};
+        let discovery = self.cached_routes();
+        let Some(indices) = discovery.declarations_by_uri.get(uri) else {
+            return;
+        };
+        if discovery
+            .sources
+            .get(uri)
+            .is_none_or(|source| source.as_ref() != content)
+        {
+            return;
+        }
+        if self
+            .get_file_content_arc(uri)
+            .is_none_or(|now| now.as_str() != content)
+        {
+            return;
+        }
+        // Check each other file once, so moved text never contributes a stale
+        // related location even if an edit races the cached enumeration.
+        let mut current = HashMap::new();
+        current.insert(uri.to_owned(), true);
+        let mut groups: BTreeMap<(u32, u32, u32, u32), RouteConflicts<'_>> = BTreeMap::new();
+        for &index in indices {
+            let declaration = &discovery.declarations[index];
+            let Some(others) = discovery.duplicate_names.get(&declaration.name) else {
+                continue;
+            };
+            let related: Vec<_> = others
+                .iter()
+                .filter_map(|&other| {
+                    let other = &discovery.declarations[other];
+                    if other.location == declaration.location {
+                        return None;
+                    }
+                    let other_uri = other.location.uri.as_str();
+                    let fresh = *current.entry(other_uri.to_owned()).or_insert_with(|| {
+                        discovery.sources.get(other_uri).is_some_and(|source| {
+                            self.get_file_content_arc(other_uri)
+                                .is_some_and(|now| now.as_str() == source.as_ref())
+                        })
+                    });
+                    fresh.then_some(other.location.clone())
+                })
+                .take(16)
+                .collect();
+            if related.is_empty() {
+                continue;
+            }
+            let r = declaration.location.range;
+            let group = groups
+                .entry((r.start.line, r.start.character, r.end.line, r.end.character))
+                .or_default();
+            group.names.push(&declaration.name);
+            for location in related {
+                if group.related.len() < 16 && !group.related.contains(&location) {
+                    group.related.push(location)
+                }
+            }
+        }
+        for ((sl, sc, el, ec), group) in groups {
+            let names = group.names;
+            let locations = group.related;
+            let shown = names
+                .iter()
+                .take(8)
+                .map(|name| format!("'{name}'"))
+                .collect::<Vec<_>>()
+                .join(", ");
+            let remainder = if names.len() > 8 {
+                format!(" and {} more", names.len() - 8)
+            } else {
+                String::new()
+            };
+            let mut diagnostic = helpers::make_diagnostic(
+                Range::new(Position::new(sl, sc), Position::new(el, ec)),
+                DiagnosticSeverity::WARNING,
+                "duplicate_laravel_route",
+                format!(
+                    "Route name(s) {shown}{remainder} have multiple statically discovered declarations"
+                ),
+            );
+            diagnostic.related_information = Some(
+                locations
+                    .into_iter()
+                    .map(|location| DiagnosticRelatedInformation {
+                        location,
+                        message: "Another declaration of the same route name".into(),
+                    })
+                    .collect(),
+            );
+            out.push(diagnostic);
+        }
+    }

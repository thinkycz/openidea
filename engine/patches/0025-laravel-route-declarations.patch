diff --git a/tests/integration/laravel_route_duplicates.rs b/tests/integration/laravel_route_duplicates.rs
new file mode 100644
index 0000000..d6bbe6c
--- /dev/null
+++ b/tests/integration/laravel_route_duplicates.rs
@@ -0,0 +1,228 @@
+use crate::common::{LARAVEL_SRC_COMPOSER, create_initialized_psr4_workspace, open_php};
+use phpantom_lsp::Backend;
+use tower_lsp::{LanguageServer, lsp_types::*};
+
+fn duplicates(backend: &Backend, uri: &Url, source: &str) -> Vec<Diagnostic> {
+    let mut out = Vec::new();
+    backend.collect_slow_diagnostics(uri.as_str(), source, &mut out);
+    out.retain(|d| d.code == Some(NumberOrString::String("duplicate_laravel_route".into())));
+    out
+}
+
+async fn workspace(source: &str, other: &str) -> (Backend, tempfile::TempDir, Url) {
+    create_initialized_psr4_workspace(
+        LARAVEL_SRC_COMPOSER,
+        &[("routes/web.php", source), ("routes/api.php", other)],
+        "routes/web.php",
+    )
+    .await
+}
+
+#[tokio::test]
+async fn duplicate_route_names_have_exact_ranges_and_related_declarations() {
+    let source = "<?php\n// 🐘 žluťoučký\nRoute::get('/first', 'a')->name('same');\nRoute::get('/second', 'b')->name('same');\n";
+    let (backend, _dir, uri) = workspace(source, "<?php\n").await;
+    let out = duplicates(&backend, &uri, source);
+    assert_eq!(out.len(), 2, "{out:?}");
+    for (index, d) in out.iter().enumerate() {
+        assert_eq!(d.severity, Some(DiagnosticSeverity::WARNING));
+        assert_eq!(d.range.start.line, index as u32 + 2);
+        assert_eq!(d.range.end.character - d.range.start.character, 6);
+        assert!(d.message.contains("same"));
+        let related = d.related_information.as_ref().unwrap();
+        assert_eq!(related.len(), 1);
+        assert_eq!(related[0].location.uri, uri);
+        assert_ne!(related[0].location.range, d.range);
+    }
+}
+
+#[tokio::test]
+async fn duplicate_routes_cross_files_and_group_prefixes() {
+    let source = "<?php\nRoute::name('admin.')->group(function () { Route::get('/a', 'a')->name('home'); });\nRoute::get('/b', 'b')->name('home');\n";
+    let other = "<?php\nRoute::get('/c', 'c')->name('admin.home');\n";
+    let (backend, _dir, uri) = workspace(source, other).await;
+    let out = duplicates(&backend, &uri, source);
+    assert_eq!(out.len(), 1, "{out:?}");
+    assert!(out[0].message.contains("admin.home"));
+    let related = out[0].related_information.as_ref().unwrap();
+    assert_eq!(related.len(), 1);
+    assert!(
+        related[0]
+            .location
+            .uri
+            .as_str()
+            .ends_with("/routes/api.php")
+    );
+}
+
+#[tokio::test]
+async fn duplicate_resource_names_aggregate_per_declaration() {
+    let source = "<?php\nRoute::resource('posts', 'A');\nRoute::resource('posts', 'B');\n";
+    let (backend, _dir, uri) = workspace(source, "<?php\n").await;
+    let out = duplicates(&backend, &uri, source);
+    assert_eq!(out.len(), 2, "{out:?}");
+    for d in &out {
+        assert!(d.message.contains("posts.index"));
+        assert!(d.message.contains("posts.destroy"));
+        assert_eq!(d.related_information.as_ref().unwrap().len(), 1);
+    }
+}
+
+#[tokio::test]
+async fn dynamic_groups_and_unique_names_do_not_report_duplicates() {
+    let source = "<?php\nRoute::name($prefix)->group(function () { Route::get('/a', 'a')->name('same'); });\nRoute::get('/b', 'b')->name('same');\nRoute::get('/c', 'c')->name('different');\n";
+    let (backend, _dir, uri) = workspace(source, "<?php\n").await;
+    assert!(duplicates(&backend, &uri, source).is_empty());
+}
+
+#[tokio::test]
+async fn unsaved_cross_file_edit_adds_moves_and_removes_duplicate_warning() {
+    let source = "<?php\nRoute::get('/a', 'a')->name('same');\n";
+    let initial = "<?php\nRoute::get('/b', 'b')->name('other');\n";
+    let (backend, dir, uri) = workspace(source, initial).await;
+    assert!(duplicates(&backend, &uri, source).is_empty());
+    let other_uri = Url::from_file_path(dir.path().join("routes/api.php")).unwrap();
+    open_php(&backend, &other_uri, initial).await;
+    for (version, changed, expected, line) in [
+        (2, "<?php\nRoute::get('/b', 'b')->name('same');\n", 1, 1),
+        (
+            3,
+            "<?php\n// moved 🐘\n\nRoute::get('/b', 'b')->name('same');\n",
+            1,
+            3,
+        ),
+        (4, "<?php\n", 0, 0),
+    ] {
+        backend
+            .did_change(DidChangeTextDocumentParams {
+                text_document: VersionedTextDocumentIdentifier {
+                    uri: other_uri.clone(),
+                    version,
+                },
+                content_changes: vec![TextDocumentContentChangeEvent {
+                    range: None,
+                    range_length: None,
+                    text: changed.into(),
+                }],
+            })
+            .await;
+        backend.update_ast(other_uri.as_str(), changed);
+        let out = duplicates(&backend, &uri, source);
+        assert_eq!(out.len(), expected, "version {version}: {out:?}");
+        if expected > 0 {
+            assert_eq!(
+                out[0].related_information.as_ref().unwrap()[0]
+                    .location
+                    .range
+                    .start
+                    .line,
+                line
+            );
+        }
+    }
+    assert_eq!(
+        std::fs::read_to_string(dir.path().join("routes/api.php")).unwrap(),
+        initial
+    );
+}
+
+#[tokio::test]
+async fn unrelated_route_class_in_laravel_project_is_not_a_route_declaration() {
+    let source = "<?php\nuse App\\Route;\nRoute::get('/a', 'a')->name('same');\nRoute::get('/b', 'b')->name('same');\n";
+    let (backend, _dir, uri) = workspace(source, "<?php\n").await;
+    assert!(duplicates(&backend, &uri, source).is_empty());
+}
+
+#[tokio::test]
+async fn imported_route_facade_alias_keeps_route_identity() {
+    let source = "<?php\nuse Illuminate\\Support\\Facades\\Route as Routes;\nRoutes::get('/a', 'a')->name('same');\nRoutes::get('/b', 'b')->name('same');\n";
+    let (backend, _dir, uri) = workspace(source, "<?php\n").await;
+    assert_eq!(duplicates(&backend, &uri, source).len(), 2);
+}
+
+#[tokio::test]
+async fn non_laravel_route_shaped_calls_do_not_get_framework_diagnostics() {
+    let source =
+        "<?php\nRoute::get('/a', 'a')->name('same');\nRoute::get('/b', 'b')->name('same');\n";
+    let (backend, _dir, uri) =
+        create_initialized_psr4_workspace("{}", &[("routes/web.php", source)], "routes/web.php")
+            .await;
+    assert!(duplicates(&backend, &uri, source).is_empty());
+}
+
+#[tokio::test]
+async fn repeated_include_is_one_static_declaration_site() {
+    let source = "<?php\nRoute::group([], __DIR__ . '/sub/one.php');\nRoute::group([], __DIR__ . '/sub/one.php');\n";
+    let (backend, _dir, uri) = create_initialized_psr4_workspace(
+        LARAVEL_SRC_COMPOSER,
+        &[
+            ("routes/web.php", source),
+            (
+                "routes/sub/one.php",
+                "<?php Route::get('/a', 'a')->name('same');",
+            ),
+        ],
+        "routes/web.php",
+    )
+    .await;
+    assert!(duplicates(&backend, &uri, source).is_empty());
+}
+
+#[tokio::test]
+async fn utf16_duplicate_declaration_ranges_and_stale_input_guard() {
+    let source = "<?php\n/* 🐘 */ Route::get('/a', 'a')->name('same'); Route::get('/b', 'b')->name('same');\n";
+    let (backend, _dir, uri) = workspace(source, "<?php\n").await;
+    let out = duplicates(&backend, &uri, source);
+    assert_eq!(out.len(), 2);
+    let line = source.lines().nth(1).unwrap();
+    assert_eq!(
+        out[0].range.start.character,
+        line[..line.find("'same'").unwrap()].encode_utf16().count() as u32
+    );
+    assert!(
+        duplicates(
+            &backend,
+            &uri,
+            &source.replace("/* 🐘 */", "/* moved 🐘 */")
+        )
+        .is_empty()
+    );
+}
+
+#[tokio::test]
+async fn fully_qualified_facade_is_case_insensitive() {
+    let source = "<?php\n\\illuminate\\support\\facades\\route::get('/a', 'a')->name('same');\n\\Illuminate\\Support\\Facades\\Route::get('/b', 'b')->name('same');\n";
+    let (backend, _dir, uri) = workspace(source, "<?php\n").await;
+    assert_eq!(duplicates(&backend, &uri, source).len(), 2);
+}
+
+#[tokio::test]
+async fn included_declaration_is_not_duplicated_by_repeated_discovery() {
+    let source = "<?php\nRoute::group([], __DIR__ . '/sub/one.php');\nRoute::group([], __DIR__ . '/sub/one.php');\n";
+    let child = "<?php Route::get('/a', 'a')->name('same');";
+    let (backend, dir, _) = create_initialized_psr4_workspace(
+        LARAVEL_SRC_COMPOSER,
+        &[("routes/web.php", source), ("routes/sub/one.php", child)],
+        "routes/web.php",
+    )
+    .await;
+    let uri = Url::from_file_path(dir.path().join("routes/sub/one.php")).unwrap();
+    open_php(&backend, &uri, child).await;
+    assert!(duplicates(&backend, &uri, child).is_empty());
+}
+
+#[tokio::test]
+async fn many_duplicates_bound_related_information() {
+    let mut source = "<?php\n".to_owned();
+    for n in 0..20 {
+        source.push_str(&format!("Route::get('/{n}', 'a')->name('same');\n"));
+    }
+    let (backend, _dir, uri) = workspace(&source, "<?php\n").await;
+    let out = duplicates(&backend, &uri, &source);
+    assert_eq!(out.len(), 20);
+    for d in out {
+        let related = d.related_information.unwrap();
+        assert_eq!(related.len(), 16);
+        assert!(!related.iter().any(|r| r.location.range == d.range));
+    }
+}

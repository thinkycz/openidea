--- /dev/null
+++ b/src/rename/route.rs
@@ -0,0 +1,355 @@
+//! Route-name edits use a concrete declaration and exact indexed usages.
+use super::{
+    RenameOutcome,
+    validate::{range_text, span_spells_its_name},
+};
+use crate::virtual_members::laravel::{self, RouteDiscovery};
+use crate::{
+    Backend,
+    symbol_map::{LaravelStringKind, SymbolKind},
+    text_position::ranges_overlap,
+};
+use mago_span::HasSpan;
+use mago_syntax::cst::{Call, Expression, Node};
+use std::{
+    collections::{HashMap, HashSet},
+    sync::Arc,
+};
+use tower_lsp::lsp_types::*;
+
+pub(super) struct RouteRenameSite {
+    name: String,
+    range: Range,
+}
+struct RouteRenamePlan {
+    discovery: Arc<RouteDiscovery>,
+    declaration: Location,
+    prefix: String,
+}
+impl Backend {
+    pub(super) fn route_rename_site(
+        &self,
+        uri: &str,
+        content: &str,
+        position: Position,
+    ) -> Option<RouteRenameSite> {
+        if !self.resolved_class_cache.read().is_laravel() || !self.rename_map_matches(uri, content)
+        {
+            return None;
+        }
+        if let Some(span) = self.lookup_symbol_at_position(uri, content, position)
+            && let SymbolKind::LaravelStringKey {
+                kind: LaravelStringKind::Route,
+                ref key,
+                ..
+            } = span.kind
+            && span_spells_its_name(content, &span)
+        {
+            if self
+                .foreign_route_helper_arguments(uri, content)
+                .contains(&(span.start as usize, span.end as usize))
+            {
+                return None;
+            }
+            return Some(RouteRenameSite {
+                name: key.clone(),
+                range: Range::new(
+                    crate::text_position::offset_to_position(content, span.start as usize),
+                    crate::text_position::offset_to_position(content, span.end as usize),
+                ),
+            });
+        }
+        let discovery = self.cached_routes();
+        if discovery
+            .sources
+            .get(uri)
+            .is_none_or(|s| s.as_ref() != content)
+        {
+            return None;
+        }
+        let indices = discovery.declarations_by_uri.get(uri)?;
+        let found = indices
+            .iter()
+            .map(|&i| &discovery.declarations[i])
+            .find(|d| {
+                let r = d.location.range;
+                position >= r.start && position <= r.end
+            })?;
+        Some(RouteRenameSite {
+            name: found.name.clone(),
+            range: found.literal_range?,
+        })
+    }
+
+    fn route_rename_plan(&self, site: &RouteRenameSite) -> Result<RouteRenamePlan, String> {
+        if site.name.contains('*') {
+            return Err("A route-name pattern is not a single route".into());
+        }
+        let discovery = self.cached_routes();
+        let mut matching = discovery
+            .declarations
+            .iter()
+            .filter(|d| d.name == site.name);
+        let Some(declaration) = matching.next() else {
+            return Err("No concrete route declaration was found".into());
+        };
+        if matching.next().is_some()
+            || laravel::resolve_route_definitions(self, &site.name).len() != 1
+        {
+            return Err("The route name has more than one declaration".into());
+        }
+        if discovery
+            .declarations
+            .iter()
+            .any(|d| d.location == declaration.location && d.name != site.name)
+        {
+            return Err("This declaration generates more than one route identity".into());
+        }
+        let range = declaration
+            .literal_range
+            .ok_or("Generated or computed route names need a different refactoring")?;
+        let uri = declaration.location.uri.as_str();
+        if declaration
+            .location
+            .uri
+            .to_file_path()
+            .ok()
+            .is_none_or(|p| p.components().any(|part| part.as_os_str() == "vendor"))
+        {
+            return Err("Package route declarations cannot be renamed".into());
+        }
+        for (uri, snapshot) in &discovery.sources {
+            if self
+                .get_file_content_arc(uri)
+                .is_none_or(|now| now.as_str() != snapshot.as_ref())
+            {
+                return Err("Route declarations changed; retry rename after indexing".into());
+            }
+        }
+        let source = discovery
+            .sources
+            .get(uri)
+            .ok_or("Route declaration source is unavailable")?;
+        let leaf = range_text(source, range).ok_or("Route declaration range is stale")?;
+        let prefix = site
+            .name
+            .strip_suffix(leaf)
+            .ok_or("Route declaration spelling cannot be edited safely")?
+            .to_owned();
+        let declaration = Location::new(declaration.location.uri.clone(), range);
+        Ok(RouteRenamePlan {
+            discovery,
+            declaration,
+            prefix,
+        })
+    }
+
+    pub(super) fn prepare_route_rename(
+        &self,
+        site: &RouteRenameSite,
+    ) -> Option<PrepareRenameResponse> {
+        self.route_rename_plan(site).ok()?;
+        Some(PrepareRenameResponse::RangeWithPlaceholder {
+            range: site.range,
+            placeholder: site.name.clone(),
+        })
+    }
+
+    pub(super) fn rename_route(&self, site: &RouteRenameSite, new_name: &str) -> RenameOutcome {
+        let plan = self.route_rename_plan(site)?;
+        if new_name.is_empty()
+            || new_name.len() > 256
+            || !new_name
+                .chars()
+                .all(|c| c.is_alphanumeric() || matches!(c, '_' | '.' | '-' | ':'))
+        {
+            return Err("Use a route name of 1–256 bytes containing letters, numbers, dots, dashes, colons or underscores".into());
+        }
+        if new_name == site.name {
+            return Ok(None);
+        }
+        if plan
+            .discovery
+            .names
+            .binary_search_by(|n| n.as_str().cmp(new_name))
+            .is_ok()
+        {
+            return Err("Another route already uses the new name".into());
+        }
+        let leaf = new_name
+            .strip_prefix(&plan.prefix)
+            .filter(|s| !s.is_empty())
+            .ok_or_else(|| format!("Keep the route group prefix '{}'", plan.prefix))?;
+        let key = crate::reference_index::laravel_string_reference_key(
+            LaravelStringKind::Route,
+            &site.name,
+        );
+        let snapshot = self.user_file_symbol_maps_for_reference_keys(&[key]);
+        let locations = laravel::find_laravel_string_key_references(
+            self,
+            &LaravelStringKind::Route,
+            &site.name,
+            plan.declaration.uri.as_str(),
+            &snapshot,
+            false,
+        );
+        let mut changes: HashMap<Url, Vec<TextEdit>> = HashMap::new();
+        changes.insert(
+            plan.declaration.uri.clone(),
+            vec![TextEdit {
+                range: plan.declaration.range,
+                new_text: leaf.to_owned(),
+            }],
+        );
+        let mut contents = HashMap::new();
+        let mut foreign_by_uri = HashMap::new();
+        for location in locations {
+            let uri = location.uri.as_str();
+            let source = contents
+                .entry(uri.to_owned())
+                .or_insert_with(|| self.reference_file_content_arc(uri));
+            let source = source.as_ref().ok_or("Route usage source is unavailable")?;
+            let start = crate::text_position::position_to_byte_offset(source, location.range.start);
+            let end = crate::text_position::position_to_byte_offset(source, location.range.end);
+            if foreign_by_uri
+                .entry(uri.to_owned())
+                .or_insert_with(|| self.foreign_route_helper_arguments(uri, source))
+                .contains(&(start, end))
+            {
+                continue;
+            }
+            if !self.rename_map_matches(uri, source)
+                || range_text(source, location.range) != Some(site.name.as_str())
+            {
+                return Err("A route usage changed; retry rename after indexing".into());
+            }
+            let range = self
+                .try_translate_blade_range(uri, location.range)
+                .ok_or("A template route usage cannot be mapped safely")?;
+            let raw = self
+                .get_file_content_arc(uri)
+                .ok_or("Route usage source is unavailable")?;
+            if range_text(&raw, range) != Some(site.name.as_str()) {
+                return Err("Route usage spelling cannot be edited safely".into());
+            }
+            let edits = changes.entry(location.uri).or_default();
+            let edit = TextEdit {
+                range,
+                new_text: new_name.to_owned(),
+            };
+            if edits.contains(&edit) {
+                continue;
+            }
+            if edits.iter().any(|e| ranges_overlap(&e.range, &range)) {
+                return Err("Route rename edits overlap".into());
+            }
+            edits.push(edit);
+        }
+        for (uri, source) in contents {
+            if self.reference_file_content_arc(&uri).as_deref() != source.as_deref() {
+                return Err("A route usage changed while preparing rename".into());
+            }
+        }
+        for (uri, source) in &plan.discovery.sources {
+            if self
+                .get_file_content_arc(uri)
+                .is_none_or(|now| now.as_str() != source.as_ref())
+            {
+                return Err("Route declarations changed while preparing rename".into());
+            }
+        }
+        Ok(Some(crate::code_actions::multi_file_edit(changes)))
+    }
+}
+
+impl Backend {
+    /// The PHP function resolver, including namespace fallback, separates a
+    /// project helper from Laravel's global helper before its string is edited.
+    fn foreign_route_helper_arguments(&self, uri: &str, content: &str) -> HashSet<(usize, usize)> {
+        use crate::virtual_members::laravel::helpers::extract_string_literal;
+        let ctx = self.file_context(uri);
+        let foreign = |raw: &str, offset: u32, allowed: &[&str]| {
+            if let Some(function) = self.resolve_function_name_at(
+                raw,
+                ctx.resolved_names.as_deref(),
+                offset,
+                ctx.use_map_at(offset),
+                ctx.namespace_at(offset),
+            ) {
+                return function.namespace.as_ref().is_some_and(|ns| !ns.is_empty())
+                    || !allowed
+                        .iter()
+                        .any(|name| function.name.eq_ignore_ascii_case(name));
+            }
+            if let Some(names) = &ctx.resolved_names
+                && names.is_imported(offset)
+            {
+                return names.get(offset).is_none_or(|resolved| {
+                    !allowed
+                        .iter()
+                        .any(|name| resolved.trim_start_matches('\\').eq_ignore_ascii_case(name))
+                });
+            }
+            let bare = raw.trim_start_matches('\\');
+            !allowed.iter().any(|name| bare.eq_ignore_ascii_case(name))
+        };
+        crate::parser::with_parsed_program(content, "route_rename_helpers", |program, content| {
+            let mut out = HashSet::new();
+            visit_route_nodes(Node::Program(program), &mut |node| {
+                let args = match node {
+                    Node::FunctionCall(call) => {
+                        let Expression::Identifier(ident) = call.function else {
+                            return;
+                        };
+                        let raw = crate::atom::bytes_to_str(ident.value());
+                        if !["route", "to_route"]
+                            .iter()
+                            .any(|name| raw.trim_start_matches('\\').eq_ignore_ascii_case(name))
+                            || !foreign(raw, ident.span().start.offset, &["route", "to_route"])
+                        {
+                            return;
+                        }
+                        &call.argument_list
+                    }
+                    Node::MethodCall(call) => {
+                        let Expression::Call(Call::Function(receiver)) = call.object else {
+                            return;
+                        };
+                        let Expression::Identifier(ident) = receiver.function else {
+                            return;
+                        };
+                        let raw = crate::atom::bytes_to_str(ident.value());
+                        if !["redirect", "url", "response"]
+                            .iter()
+                            .any(|name| raw.trim_start_matches('\\').eq_ignore_ascii_case(name))
+                            || !foreign(
+                                raw,
+                                ident.span().start.offset,
+                                &["redirect", "url", "response"],
+                            )
+                        {
+                            return;
+                        }
+                        &call.argument_list
+                    }
+                    _ => return,
+                };
+                for argument in args.arguments.iter() {
+                    if let Some((_, start, end)) = extract_string_literal(argument.value(), content)
+                    {
+                        out.insert((start, end));
+                    }
+                }
+            });
+            out
+        })
+    }
+}
+
+fn visit_route_nodes<'a, 'arena>(node: Node<'a, 'arena>, visit: &mut impl FnMut(Node<'a, 'arena>)) {
+    let mut pending = vec![node];
+    while let Some(node) = pending.pop() {
+        visit(node);
+        node.visit_children(|child| pending.push(child));
+    }
+}

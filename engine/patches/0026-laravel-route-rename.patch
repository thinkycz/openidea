+/// Resolve explicit function imports while keeping unqualified names available
+/// for PHP's namespace-to-global function fallback.
+pub(super) fn route_helper_name<'a>(
+    raw: &'a str,
+    offset: u32,
+    resolved: Option<&'a crate::names::OwnedResolvedNames>,
+) -> &'a str {
+    resolved
+        .filter(|names| names.is_imported(offset))
+        .and_then(|names| names.get(offset))
+        .map(strip_fqn_prefix)
+        .unwrap_or_else(|| strip_fqn_prefix(raw))
+}
+
+/// Whether the receiver is Laravel's redirector, URL generator or response
+/// factory helper, including an explicit import alias.
+pub(super) fn is_route_name_helper_receiver(
+    object: &Expression<'_>,
+    resolved: Option<&crate::names::OwnedResolvedNames>,
+) -> bool {
+    let Expression::Call(Call::Function(call)) = object else {
+        return false;
+    };
+    let Expression::Identifier(ident) = call.function else {
+        return false;
+    };
+    let name = route_helper_name(
+        bytes_to_str(ident.value()),
+        ident.span().start.offset,
+        resolved,
+    );
+    call.argument_list.arguments.is_empty()
+        && ["redirect", "url", "response"]
+            .iter()
+            .any(|helper| name.eq_ignore_ascii_case(helper))
 }
 

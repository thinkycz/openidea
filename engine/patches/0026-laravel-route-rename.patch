+use crate::common::{
+    LARAVEL_SRC_COMPOSER, apply_edits, create_initialized_psr4_workspace, edits_for_uri,
+    position_after, prepare_rename, rename_result,
+};
+use tower_lsp::lsp_types::*;
+
+async fn workspace(
+    routes: &str,
+    consumer: &str,
+) -> (phpantom_lsp::Backend, tempfile::TempDir, Url) {
+    create_initialized_psr4_workspace(
+        LARAVEL_SRC_COMPOSER,
+        &[("routes/web.php", routes), ("src/Links.php", consumer)],
+        "src/Links.php",
+    )
+    .await
+}
+
+fn usage(name: &str) -> String {
+    format!(
+        "<?php\nnamespace App;\nclass Links {{ function demo() {{ return route('{name}'); }} }}\n"
+    )
+}
+
+#[tokio::test]
+async fn rename_route_usage_updates_declaration_and_exact_php_usages() {
+    let routes =
+        "<?php\nuse Illuminate\\Support\\Facades\\Route;\nRoute::get('/a', 'a')->name('home');\n";
+    let consumer = "<?php\nnamespace App;\nclass Links { function demo() { $literal = 'home'; config('home'); return route('home'); } }\n";
+    let (backend, dir, uri) = workspace(routes, consumer).await;
+    let pos = position_after(consumer, "route('ho");
+    let prepared = prepare_rename(&backend, &uri, pos.line, pos.character).await;
+    assert!(
+        matches!(prepared, Some(PrepareRenameResponse::RangeWithPlaceholder {ref placeholder, ..}) if placeholder == "home"),
+        "{prepared:?}"
+    );
+    let edit = rename_result(&backend, &uri, pos.line, pos.character, "dashboard")
+        .await
+        .unwrap()
+        .expect("route rename");
+    let route_uri = Url::from_file_path(dir.path().join("routes/web.php")).unwrap();
+    assert_eq!(
+        apply_edits(routes, &edits_for_uri(&edit, &route_uri)),
+        routes.replace("name('home')", "name('dashboard')")
+    );
+    assert_eq!(
+        apply_edits(consumer, &edits_for_uri(&edit, &uri)),
+        consumer.replace("route('home')", "route('dashboard')")
+    );
+    assert_eq!(
+        std::fs::read_to_string(dir.path().join("routes/web.php")).unwrap(),
+        routes
+    );
+}

+/// The namespace-local function the receiver may resolve to instead of Laravel.
+pub(super) fn route_helper_receiver_dependency(
+    object: &Expression<'_>,
+    resolved: Option<&crate::names::OwnedResolvedNames>,
+) -> Option<crate::symbol_map::LaravelStringDependency> {
+    let Expression::Call(Call::Function(call)) = object else {
+        return None;
+    };
+    let Expression::Identifier(ident) = call.function else {
+        return None;
+    };
+    resolved?
+        .get(ident.span().start.offset)
+        .and_then(crate::symbol_map::LaravelStringDependency::namespaced_route_helper)
+}

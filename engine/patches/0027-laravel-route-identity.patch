+    let source = "<?php\nnamespace Foo {\nfunction route(string $name): string { return $name; }\nclass LocalLinks { function demo() { return route('home'); } }\n}\nnamespace Bar {\nclass GlobalLinks { function demo() { return route('home'); } }\n}\n";

+#[tokio::test]
+async fn global_imported_helpers_and_facades_retain_their_route_identity() {
+    let source = "<?php\nnamespace App;\nuse function route as link_to;\nuse Illuminate\\Support\\Facades\\URL as Urls;\nfunction route(string $name): string { return $name; }\nclass Links { function demo() {\n    route('home');\n    link_to('home');\n    Urls::route('home');\n    \\route('home');\n    route('local.missing'); link_to('global.missing');\n} }\n";
+    let (backend, _dir, uri) = workspace(source).await;
+    let imported = position_after(source, "link_to('ho");
+    assert!(
+        goto_definition_at(&backend, &uri, imported.line, imported.character)
+            .await
+            .is_some()
+    );
+    assert!(
+        hover_text_at(&backend, &uri, imported.line, imported.character)
+            .await
+            .is_some()
+    );
+    assert_eq!(
+        find_references(&backend, &uri, imported, true).await.len(),
+        4
+    );
+    let callee = position_after(source, "    ro");
+    let locations = crate::common::definition_locations(
+        goto_definition_at(&backend, &uri, callee.line, callee.character).await,
+    );
+    assert!(
+        locations
+            .iter()
+            .any(|l| l.uri == uri && l.range.start.line == 4)
+    );
+    let mut diagnostics = Vec::new();
+    backend.collect_slow_diagnostics(uri.as_str(), source, &mut diagnostics);
+    let warnings = messages_with_code(&diagnostics, "invalid_laravel_route");
+    assert_eq!(warnings.len(), 1, "{warnings:?}");
+    assert!(warnings[0].contains("global.missing"));
+}

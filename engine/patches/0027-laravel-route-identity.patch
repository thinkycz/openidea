+#[tokio::test]
+async fn url_and_response_receiver_helpers_use_canonical_function_identity() {
+    for (helper, method) in [("url", "signedRoute"), ("response", "redirectToRoute")] {
+        let source = format!(
+            "<?php\nnamespace App;\nfunction {helper}(): object {{ return new class {{ function {method}(string $name): void {{}} }}; }}\nclass Links {{ function demo() {{\n    {helper}()->{method}('home');\n    \\{helper}()->{method}('home');\n    {helper}()->{method}('local.missing');\n}} }}\n"
+        );
+        let (backend, _dir, uri) = workspace(&source).await;
+        let local = position_after(&source, &format!("    {helper}()->{method}('ho"));
+        assert!(
+            goto_definition_at(&backend, &uri, local.line, local.character)
+                .await
+                .is_none(),
+            "{helper}"
+        );
+        assert!(
+            hover_text_at(&backend, &uri, local.line, local.character)
+                .await
+                .is_none(),
+            "{helper}"
+        );
+        let global = position_after(&source, &format!("\\{helper}()->{method}('ho"));
+        assert!(
+            goto_definition_at(&backend, &uri, global.line, global.character)
+                .await
+                .is_some(),
+            "{helper}"
+        );
+        assert_eq!(
+            find_references(&backend, &uri, global, true).await.len(),
+            2,
+            "{helper}"
+        );
+        let mut diagnostics = Vec::new();
+        backend.collect_slow_diagnostics(uri.as_str(), &source, &mut diagnostics);
+        assert!(
+            messages_with_code(&diagnostics, "invalid_laravel_route").is_empty(),
+            "{helper}"
+        );
+    }
+}

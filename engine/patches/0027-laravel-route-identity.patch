+    /// A namespace-local route/URL helper that prevents global fallback.
+    pub(crate) fn namespaced_route_helper(name: &str) -> Option<Self> {
+        let name = name.trim_start_matches('\\');
+        let (namespace, short) = name.rsplit_once('\\')?;
+        (!namespace.is_empty()
+            && ["route", "to_route", "redirect", "url", "response"]
+                .iter()
+                .any(|helper| short.eq_ignore_ascii_case(helper)))
+        .then(|| Self::Function(crate::atom::ascii_lowercase_atom(name)))
+    }

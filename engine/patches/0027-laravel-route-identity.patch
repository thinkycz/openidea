+#[tokio::test]
+async fn unsaved_cross_file_shadowing_changes_navigation_without_editing_caller() {
+    let caller = "<?php\nnamespace App;\nclass Links { function demo() { route('unregistered'); return route('home'); } }\n";
+    let empty = "<?php namespace App;\n";
+    let (backend, dir, uri) = create_initialized_psr4_workspace(
+        LARAVEL_SRC_COMPOSER,
+        &[
+            ("routes/web.php", ROUTES),
+            ("src/Links.php", caller),
+            ("src/Helpers.php", empty),
+        ],
+        "src/Links.php",
+    )
+    .await;
+    let helpers = Url::from_file_path(dir.path().join("src/Helpers.php")).unwrap();
+    open_php(&backend, &helpers, empty).await;
+    let position = position_after(caller, "route('ho");
+    assert!(
+        goto_definition_at(&backend, &uri, position.line, position.character)
+            .await
+            .is_some()
+    );
+    for (version, source, framework) in [
+        (
+            2,
+            "<?php namespace App; function route(string $name): string { return $name; }\n",
+            false,
+        ),
+        (3, empty, true),
+    ] {
+        backend
+            .did_change(DidChangeTextDocumentParams {
+                text_document: VersionedTextDocumentIdentifier {
+                    uri: helpers.clone(),
+                    version,
+                },
+                content_changes: vec![TextDocumentContentChangeEvent {
+                    range: None,
+                    range_length: None,
+                    text: source.into(),
+                }],
+            })
+            .await;
+        backend.update_ast(helpers.as_str(), source);
+        assert_eq!(
+            goto_definition_at(&backend, &uri, position.line, position.character)
+                .await
+                .is_some(),
+            framework,
+            "version {version}"
+        );
+        assert_eq!(
+            hover_text_at(&backend, &uri, position.line, position.character)
+                .await
+                .is_some(),
+            framework,
+            "version {version}"
+        );
+        assert_eq!(
+            find_references(&backend, &uri, position, true).await.len(),
+            if framework { 2 } else { 0 },
+            "version {version}"
+        );
+        let mut diagnostics = Vec::new();
+        backend.collect_slow_diagnostics(uri.as_str(), caller, &mut diagnostics);
+        assert_eq!(
+            messages_with_code(&diagnostics, "invalid_laravel_route").len(),
+            usize::from(framework),
+            "version {version}"
+        );
+    }
+    assert_eq!(
+        std::fs::read_to_string(dir.path().join("src/Helpers.php")).unwrap(),
+        empty
+    );
+    assert_eq!(
+        std::fs::read_to_string(dir.path().join("src/Links.php")).unwrap(),
+        caller
+    );
+}

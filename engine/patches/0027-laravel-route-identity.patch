+++ b/tests/integration/laravel_route_identity.rs
@@ -0,0 +1,319 @@
+use crate::common::{
+    LARAVEL_SRC_COMPOSER, create_initialized_psr4_workspace, find_references, goto_definition_at,
+    hover_text_at, messages_with_code, open_php, position_after,
+};
+use tower_lsp::{LanguageServer, lsp_types::*};
+
+const ROUTES: &str = "<?php Route::get('/a', 'a')->name('home');";
+const CALLER: &str = "<?php\nnamespace App;\nfunction route(string $name): string { return $name; }\nclass Links { function demo() {\n    route('home');\n    \\route('home');\n    route('local.missing');\n    \\route('global.missing');\n} }\n";
+
+async fn workspace(source: &str) -> (phpantom_lsp::Backend, tempfile::TempDir, Url) {
+    create_initialized_psr4_workspace(
+        LARAVEL_SRC_COMPOSER,
+        &[("routes/web.php", ROUTES), ("src/Links.php", source)],
+        "src/Links.php",
+    )
+    .await
+}
+
+#[tokio::test]
+async fn local_route_argument_has_no_framework_navigation_or_hover() {
+    let (backend, _dir, uri) = workspace(CALLER).await;
+    let local = position_after(CALLER, "    route('ho");
+    assert!(
+        goto_definition_at(&backend, &uri, local.line, local.character)
+            .await
+            .is_none()
+    );
+    assert!(
+        hover_text_at(&backend, &uri, local.line, local.character)
+            .await
+            .is_none()
+    );
+    let global = position_after(CALLER, "\\route('ho");
+    assert!(
+        goto_definition_at(&backend, &uri, global.line, global.character)
+            .await
+            .is_some()
+    );
+    assert!(
+        hover_text_at(&backend, &uri, global.line, global.character)
+            .await
+            .is_some()
+    );
+}
+
+#[tokio::test]
+async fn route_reference_queries_exclude_local_helpers_at_both_ends() {
+    let (backend, _dir, uri) = workspace(CALLER).await;
+    let local = position_after(CALLER, "    route('ho");
+    assert!(
+        find_references(&backend, &uri, local, true)
+            .await
+            .is_empty()
+    );
+    let global = position_after(CALLER, "\\route('ho");
+    let references = find_references(&backend, &uri, global, true).await;
+    assert_eq!(references.len(), 2, "{references:?}");
+    assert!(
+        !references
+            .iter()
+            .any(|l| l.uri == uri && l.range.start.line == local.line)
+    );
+}
+
+#[tokio::test]
+async fn unknown_route_warning_judges_only_the_framework_helper() {
+    let (backend, _dir, uri) = workspace(CALLER).await;
+    let mut diagnostics = Vec::new();
+    backend.collect_slow_diagnostics(uri.as_str(), CALLER, &mut diagnostics);
+    let warnings = messages_with_code(&diagnostics, "invalid_laravel_route");
+    assert_eq!(warnings.len(), 1, "{warnings:?}");
+    assert!(warnings[0].contains("global.missing"));
+}
+
+#[tokio::test]
+async fn declaration_references_do_not_include_unrelated_local_route_calls() {
+    let (backend, dir, _) = workspace(CALLER).await;
+    let uri = Url::from_file_path(dir.path().join("routes/web.php")).unwrap();
+    open_php(&backend, &uri, ROUTES).await;
+    let pos = position_after(ROUTES, "name('ho");
+    let references = find_references(&backend, &uri, pos, true).await;
+    assert_eq!(references.len(), 2, "{references:?}");
+    assert!(
+        !references
+            .iter()
+            .any(|l| l.uri.as_str().ends_with("/src/Links.php") && l.range.start.line == 4)
+    );
+}
+
+#[tokio::test]
+async fn local_receiver_helper_does_not_become_a_framework_route() {
+    let source = "<?php\nnamespace App;\nfunction redirect(): object { return new class { function route(string $name): void {} }; }\nclass Links { function demo() {\n    redirect()->route('home');\n    \\redirect()->route('home');\n    redirect()->route('local.missing');\n} }\n";
+    let (backend, _dir, uri) = workspace(source).await;
+    let local = position_after(source, "    redirect()->route('ho");
+    assert!(
+        goto_definition_at(&backend, &uri, local.line, local.character)
+            .await
+            .is_none()
+    );
+    assert!(
+        hover_text_at(&backend, &uri, local.line, local.character)
+            .await
+            .is_none()
+    );
+    let global = position_after(source, "\\redirect()->route('ho");
+    assert!(
+        goto_definition_at(&backend, &uri, global.line, global.character)
+            .await
+            .is_some()
+    );
+    let refs = find_references(&backend, &uri, global, true).await;
+    assert_eq!(refs.len(), 2);
+    let mut diagnostics = Vec::new();
+    backend.collect_slow_diagnostics(uri.as_str(), source, &mut diagnostics);
+    assert!(messages_with_code(&diagnostics, "invalid_laravel_route").is_empty());
+}

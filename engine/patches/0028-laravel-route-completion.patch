diff --git a/src/completion/laravel_route_calls.rs b/src/completion/laravel_route_calls.rs
new file mode 100644
index 0000000..1ecd2ed
--- /dev/null
+++ b/src/completion/laravel_route_calls.rs
@@ -0,0 +1,254 @@
+//! PHP identity and argument roles for live route URL completion.
+use super::laravel_string_keys::receiver_chain_start;
+use super::source::helpers::{split_trailing_ident, trailing_class_name};
+use crate::{Backend, types::FileContext};
+
+pub(crate) type RouteCallRole<'a> = dyn Fn(&str) -> Option<&'static str> + 'a;
+
+impl Backend {
+    fn global_route_helper(
+        &self,
+        content: &str,
+        callable: &str,
+        ctx: &FileContext,
+    ) -> Option<&'static str> {
+        let written = trailing_class_name(callable);
+        let offset = (callable.len() - written.len()) as u32;
+        let names = ctx.resolved_names.as_deref();
+        let resolved = names.and_then(|names| names.get(offset));
+        let helpers = ["route", "to_route", "redirect", "url", "response"];
+        if let Some(name) = resolved.and_then(|name| {
+            helpers
+                .iter()
+                .copied()
+                .find(|h| name.trim_start_matches('\\').eq_ignore_ascii_case(h))
+        }) {
+            return Some(name);
+        }
+        // An unfinished string may leave the callee out of mago-names while
+        // retaining its imports. Check the typed PHP import, since the legacy
+        // use map merges class/function/constant symbol tables.
+        let recovered = (resolved.is_none() && !written.contains('\\'))
+            .then(|| incomplete_function_context(content, offset, written))
+            .flatten();
+        if let Some(recovered) = &recovered {
+            if let Some(target) = &recovered.imported {
+                return helpers
+                    .into_iter()
+                    .find(|name| target.trim_start_matches('\\').eq_ignore_ascii_case(name));
+            }
+            if recovered.local_declared {
+                return None;
+            }
+        }
+        let name = helpers
+            .into_iter()
+            .find(|name| written.trim_start_matches('\\').eq_ignore_ascii_case(name))?;
+        if written.starts_with('\\') {
+            return Some(name);
+        }
+        if names.is_some_and(|names| names.is_imported(offset)) {
+            return None;
+        }
+        let local = resolved.map(str::to_owned).or_else(|| {
+            let namespace = recovered
+                .as_ref()
+                .map(|r| r.namespace.as_deref())
+                .unwrap_or_else(|| ctx.namespace_at(offset).as_deref());
+            namespace.map(|ns| format!("{ns}\\{name}"))
+        });
+        (!local.is_some_and(|name| self.has_indexed_function(&name))).then_some(name)
+    }
+
+    pub(crate) fn laravel_route_call_role(
+        &self,
+        content: &str,
+        callable: &str,
+        ctx: &FileContext,
+    ) -> Option<&'static str> {
+        let (method, before) = split_trailing_ident(callable);
+        let before = before.trim_end();
+        if !before.ends_with("::") && !before.ends_with("->") {
+            return match self.global_route_helper(content, callable, ctx)? {
+                "route" => Some("name"),
+                "to_route" => Some("route"),
+                _ => None,
+            };
+        }
+        let method = method.to_ascii_lowercase();
+        if !matches!(
+            method.as_str(),
+            "route" | "signedroute" | "temporarysignedroute" | "redirecttoroute"
+        ) {
+            return None;
+        }
+        if let Some(class_prefix) = before.strip_suffix("::") {
+            let written = trailing_class_name(class_prefix);
+            let offset = (class_prefix.trim_end().len() - written.len()) as u32;
+            let resolved = ctx.resolve_name_at(written, offset);
+            for (facade, family) in [
+                ("URL", "url"),
+                ("Redirect", "redirect"),
+                ("Response", "response"),
+            ] {
+                let fqn = format!("Illuminate\\Support\\Facades\\{facade}");
+                if resolved.trim_start_matches('\\').eq_ignore_ascii_case(&fqn)
+                    || (resolved
+                        .trim_start_matches('\\')
+                        .eq_ignore_ascii_case(facade)
+                        && !self.has_indexed_class(facade))
+                {
+                    return route_method_role(family, &method);
+                }
+            }
+            return None;
+        }
+        let receiver = before
+            .strip_suffix("->")?
+            .trim_end()
+            .trim_end_matches('?')
+            .trim_end();
+        if let Some(call) = receiver.strip_suffix(')')
+            && let Some(open) = call.rfind('(')
+            && call[open + 1..].trim().is_empty()
+            && let Some(helper) = self.global_route_helper(content, call[..open].trim_end(), ctx)
+        {
+            return route_method_role(helper, &method);
+        }
+        let start = receiver_chain_start(receiver);
+        let expression = &callable[start..];
+        let target = self.resolve_callable_target_at_offset(
+            expression,
+            content,
+            callable.len() as u32,
+            ctx,
+        )?;
+        let owner = target.owner_class?;
+        let loader = self.class_loader(ctx);
+        for (class, family) in [
+            ("Illuminate\\Routing\\UrlGenerator", "url"),
+            ("Illuminate\\Contracts\\Routing\\UrlGenerator", "url"),
+            ("Illuminate\\Routing\\Redirector", "redirect"),
+            ("Illuminate\\Routing\\ResponseFactory", "response"),
+            (
+                "Illuminate\\Contracts\\Routing\\ResponseFactory",
+                "response",
+            ),
+        ] {
+            if owner.as_str().eq_ignore_ascii_case(class)
+                || crate::class_lookup::is_subclass_of(owner.as_str(), class, &loader)
+            {
+                return route_method_role(family, &method);
+            }
+        }
+        None
+    }
+}
+
+fn route_method_role(family: &str, method: &str) -> Option<&'static str> {
+    match (family, method) {
+        ("url", "route" | "signedroute" | "temporarysignedroute") => Some("name"),
+        ("redirect", "route" | "signedroute" | "temporarysignedroute")
+        | ("response", "redirecttoroute") => Some("route"),
+        _ => None,
+    }
+}
+
+/// Recover typed imports from the active namespace when the incomplete call
+/// has no resolved-name entry. The repaired prefix preserves import offsets.
+#[derive(Default)]
+struct IncompleteFunctionContext {
+    namespace: Option<String>,
+    imported: Option<String>,
+    local_declared: bool,
+}
+
+fn incomplete_function_context(
+    content: &str,
+    offset: u32,
+    alias: &str,
+) -> Option<IncompleteFunctionContext> {
+    use crate::atom::bytes_to_str;
+    use mago_span::HasSpan;
+    use mago_syntax::cst::{Statement, UseItem, UseItems};
+    // Complete only the prefix before the callee. This keeps a later unfinished
+    // namespace body from being discarded and reusing an earlier block's imports.
+    let prefix = &content[..offset as usize];
+    let code = crate::completion::source::code_context::code_context_at(content, offset as usize)?;
+    let mut repaired = prefix.to_owned();
+    repaired.push_str("null");
+    for bracket in code.open_brackets.iter().rev() {
+        match bracket.byte {
+            b'(' => repaired.push(')'),
+            b'[' => repaired.push(']'),
+            b'{' => repaired.push_str(";}"),
+            _ => {}
+        }
+    }
+    repaired.push(';');
+    crate::parser::with_parsed_program(&repaired, "route_completion_import", |program, _| {
+        let namespace = program
+            .statements
+            .iter()
+            .filter_map(|statement| match statement {
+                Statement::Namespace(namespace) if namespace.span().start.offset <= offset => {
+                    Some(namespace)
+                }
+                _ => None,
+            })
+            .next_back();
+        let statements = namespace
+            .map(|namespace| namespace.statements())
+            .unwrap_or(&program.statements);
+        let namespace_name = namespace
+            .and_then(|namespace| namespace.name.as_ref())
+            .map(|name| bytes_to_str(name.value()).to_owned());
+        let local_declared = statements.iter().any(|statement| matches!(statement,
+            Statement::Function(function) if bytes_to_str(function.name.value).eq_ignore_ascii_case(alias)));
+        let target = |item: &UseItem<'_>, prefix: Option<&str>| {
+            let name = bytes_to_str(item.name.value());
+            let imported_alias = item
+                .alias
+                .as_ref()
+                .map(|alias| bytes_to_str(alias.identifier.value))
+                .unwrap_or_else(|| name.rsplit('\\').next().unwrap_or(name));
+            imported_alias.eq_ignore_ascii_case(alias).then(|| {
+                prefix.map_or_else(|| name.to_owned(), |prefix| format!("{prefix}\\{name}"))
+            })
+        };
+        for statement in statements.iter() {
+            let Statement::Use(statement) = statement else {
+                continue;
+            };
+            let found = match &statement.items {
+                UseItems::TypedSequence(sequence) if sequence.r#type.is_function() => {
+                    sequence.items.iter().find_map(|item| target(item, None))
+                }
+                UseItems::TypedList(list) if list.r#type.is_function() => list
+                    .items
+                    .iter()
+                    .find_map(|item| target(item, Some(bytes_to_str(list.namespace.value())))),
+                UseItems::MixedList(list) => list
+                    .items
+                    .iter()
+                    .filter(|item| item.r#type.as_ref().is_some_and(|kind| kind.is_function()))
+                    .find_map(|item| {
+                        target(&item.item, Some(bytes_to_str(list.namespace.value())))
+                    }),
+                _ => None,
+            };
+            if found.is_some() {
+                return Some(IncompleteFunctionContext {
+                    namespace: namespace_name,
+                    imported: found,
+                    local_declared,
+                });
+            }
+        }
+        Some(IncompleteFunctionContext {
+            namespace: namespace_name,
+            imported: None,
+            local_declared,
+        })
+    })
+}

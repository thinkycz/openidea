+    for (imports, expression, expected) in [
+        ("use SomeClass as route;", "route('users.", true),
+        ("use function Other\\route;", "route('users.", false),
+        (
+            "use function route as link_to; use SomeClass as link_to;",
+            "link_to('users.",
+            true,
+        ),
+        ("use SomeClass as link_to;", "link_to('users.", false),
+        ("use const Other\\R as route;", "route('users.", true),
+        ("use Other\\{function route};", "route('users.", false),
+        ("use function \\route as LINK_TO;", "link_to('users.", true),
+    ] {
+        let source = format!("<?php\nnamespace App;\n{imports}\nfunction demo() {{ {expression}");
+        let got = labels(&source, "users.").await;
+        assert_eq!(
+            got.contains(&"users.show".into()),
+            expected,
+            "{source}: {got:?}"
+        );
+    }
+
+    for (source, expected) in [
+        (
+            "<?php NAMESPACE App; USE FUNCTION route AS LINK_TO; function demo() { link_to('users.",
+            true,
+        ),
+        (
+            "<?php namespace First {} namespace Second { use function route as link_to; function demo() { link_to('users.",
+            true,
+        ),
+        (
+            "<?php namespace First {} namespace Second { function route(string $name): string { return $name; } function demo() { route('users.",

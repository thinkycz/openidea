+#[tokio::test]
+async fn unsaved_other_file_helper_presence_changes_completion_without_caller_edits() {
+    let source = "<?php namespace App; route(''); route('users.show', ['']);";
+    let empty = "<?php namespace App;";
+    let (backend, dir, _) = create_initialized_psr4_workspace(
+        LARAVEL_SRC_COMPOSER,
+        &[
+            ("routes/web.php", ROUTES),
+            ("src/Links.php", source),
+            ("src/Helpers.php", empty),
+        ],
+        "routes/web.php",
+    )
+    .await;
+    let uri = open_php_file(&backend, "src/Links.php").await;
+    let helper = Url::from_file_path(dir.path().join("src/Helpers.php")).unwrap();
+    for (text, expected) in [
+        (empty, true),
+        (
+            "<?php namespace App; function route(string $name, array $parameters = []): string { return $name; }",
+            false,
+        ),
+        (empty, true),
+    ] {
+        backend.update_ast(helper.as_str(), text);
+        let names = complete(&backend, &uri, source, "route('").await;
+        let parameters = complete(&backend, &uri, source, "['").await;
+        assert_eq!(names.contains(&"users.show".into()), expected, "{names:?}");
+        assert_eq!(
+            parameters.contains(&"user".into()),
+            expected,
+            "{parameters:?}"
+        );
+    }
+    assert_eq!(
+        std::fs::read_to_string(dir.path().join("src/Helpers.php")).unwrap(),
+        empty
+    );
+}

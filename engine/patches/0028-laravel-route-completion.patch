diff --git a/tests/integration/laravel_route_completion_identity.rs b/tests/integration/laravel_route_completion_identity.rs
new file mode 100644
index 0000000..8463a14
--- /dev/null
+++ b/tests/integration/laravel_route_completion_identity.rs
@@ -0,0 +1,343 @@
+use crate::common::{
+    LARAVEL_SRC_COMPOSER, create_initialized_psr4_workspace, open_php_file, position_after,
+    response_labels,
+};
+use tower_lsp::{LanguageServer, lsp_types::*};
+
+const ROUTES: &str = "<?php Route::get('/users/{user}', 'show')->name('users.show');";
+
+async fn labels(source: &str, needle: &str) -> Vec<String> {
+    let (backend, _dir, _) = create_initialized_psr4_workspace(
+        LARAVEL_SRC_COMPOSER,
+        &[("routes/web.php", ROUTES), ("src/Links.php", source)],
+        "routes/web.php",
+    )
+    .await;
+    let uri = open_php_file(&backend, "src/Links.php").await;
+    complete(&backend, &uri, source, needle).await
+}
+
+async fn complete(
+    backend: &phpantom_lsp::Backend,
+    uri: &Url,
+    source: &str,
+    needle: &str,
+) -> Vec<String> {
+    response_labels(
+        backend
+            .completion(CompletionParams {
+                text_document_position: TextDocumentPositionParams {
+                    text_document: TextDocumentIdentifier { uri: uri.clone() },
+                    position: position_after(source, needle),
+                },
+                work_done_progress_params: Default::default(),
+                partial_result_params: Default::default(),
+                context: None,
+            })
+            .await
+            .unwrap(),
+    )
+}

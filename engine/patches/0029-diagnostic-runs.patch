+#[cfg(test)]
+mod run_ownership_tests {
+    use crate::Backend;
+    use std::sync::{Arc, atomic::Ordering};
+
+    fn parsed_caller() -> (Backend, Arc<String>) {
+        let backend = Backend::new_test();
+        let text = Arc::new("<?php namespace App; class Caller {}".to_owned());
+        let uri = "file:///Caller.php";
+        backend
+            .open_files
+            .write()
+            .insert(uri.to_owned(), Arc::clone(&text));
+        backend.diag.documents.lock().open(uri, 1, &text);
+        backend.update_ast(uri, &text);
+        {
+            let mut documents = backend.diag.documents.lock();
+            let revision = documents.capture(uri, &text).unwrap();
+            assert!(documents.mark_parsed(uri, revision.as_ref()));
+            assert!(documents.mark_phase(uri, revision.as_ref(), false));
+            assert!(documents.mark_phase(uri, revision.as_ref(), true));
+        }
+        backend.init_complete.store(true, Ordering::Release);
+        (backend, text)
+    }
+
+    #[test]
+    fn queued_refresh_rejects_prior_work_for_unchanged_caller() {
+        let (backend, text) = parsed_caller();
+        let uri = "file:///Caller.php";
+        let old = backend.diag.documents.lock().capture(uri, &text).unwrap();
+        backend.schedule_diagnostics(uri.to_owned());
+        let mut documents = backend.diag.documents.lock();
+        assert!(
+            documents.parsed(uri, old.as_ref()),
+            "source parsing is still current"
+        );
+        assert!(
+            !documents.mark_phase(uri, old.as_ref(), true),
+            "a queued dependency refresh must retire earlier diagnostic work"
+        );
+        let fresh = documents.capture(uri, &text).unwrap();
+        assert_eq!(fresh.as_ref().unwrap().version, 1);
+        assert!(
+            fresh.as_ref().unwrap().same(old.as_ref().unwrap()),
+            "source revision remains reusable"
+        );
+        assert!(documents.mark_phase(uri, fresh.as_ref(), true));
+        assert!(
+            !documents.phase_current(uri, old.as_ref(), true),
+            "old run cannot own a fresh phase"
+        );
+    }
+
+    #[test]
+    fn queued_refresh_cannot_pair_new_fast_with_previous_slow_results() {
+        let (backend, text) = parsed_caller();
+        let uri = "file:///Caller.php";
+        backend.schedule_diagnostics(uri.to_owned());
+        let mut documents = backend.diag.documents.lock();
+        let fresh = documents.capture(uri, &text).unwrap();
+        assert!(documents.parsed(uri, fresh.as_ref()));
+        assert!(documents.mark_phase(uri, fresh.as_ref(), false));
+        assert!(documents.phase_current(uri, fresh.as_ref(), false));
+        assert!(
+            !documents.phase_current(uri, fresh.as_ref(), true),
+            "old slow results must not complete a new run"
+        );
+        assert!(documents.mark_phase(uri, fresh.as_ref(), true));
+        assert!(documents.phase_current(uri, fresh.as_ref(), true));
+    }
+
+    #[test]
+    fn scheduling_another_document_preserves_caller_phase_ownership() {
+        let (backend, text) = parsed_caller();
+        let uri = "file:///Caller.php";
+        let revision = backend.diag.documents.lock().capture(uri, &text).unwrap();
+        let other = Arc::new("<?php class Other {}".to_owned());
+        backend
+            .open_files
+            .write()
+            .insert("file:///Unrelated.php".to_owned(), Arc::clone(&other));
+        backend
+            .diag
+            .documents
+            .lock()
+            .open("file:///Unrelated.php", 1, &other);
+        backend.schedule_diagnostics("file:///Unrelated.php".to_owned());
+        let documents = backend.diag.documents.lock();
+        assert!(documents.phase_current(uri, revision.as_ref(), false));
+        assert!(documents.phase_current(uri, revision.as_ref(), true));
+    }
+
+    #[test]
+    fn save_fanout_retires_unchanged_caller_run() {
+        let (backend, text) = parsed_caller();
+        let uri = "file:///Caller.php";
+        let revision = backend.diag.documents.lock().capture(uri, &text).unwrap();
+        backend.schedule_diagnostics_for_open_files("file:///Saved.php");
+        assert!(backend.diag.pending_uris.lock().contains(uri));
+        let mut documents = backend.diag.documents.lock();
+        assert!(documents.parsed(uri, revision.as_ref()));
+        assert!(!documents.mark_phase(uri, revision.as_ref(), true));
+    }
+
+    #[test]
+    fn repeated_pull_requests_do_not_retire_pending_current_work() {
+        let (backend, text) = parsed_caller();
+        let uri = "file:///Caller.php";
+        let revision = backend.diag.documents.lock().capture(uri, &text).unwrap();
+        backend.trigger_diagnostics_for_pull(uri);
+        backend.trigger_diagnostics_for_pull(uri);
+        assert!(backend.diag.pending_uris.lock().contains(uri));
+        let mut documents = backend.diag.documents.lock();
+        assert!(documents.mark_phase(uri, revision.as_ref(), true));
+        assert!(documents.phase_current(uri, revision.as_ref(), true));
+    }
+}

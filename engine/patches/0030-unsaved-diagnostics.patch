+/// Publication differs from Save: empty scripts do not fan out, and typed
+/// function bodies are irrelevant to callers. Existing class/member narrowing
+/// also accounts for return types inferred from untyped method bodies.
+pub(crate) fn published_class_keys(
+    old: &[ClassInfo],
+    new: &[Arc<ClassInfo>],
+) -> Vec<ReferenceIndexKey> {
+    affected_reference_keys(
+        &FileDeclarations {
+            classes: old.iter().cloned().map(Arc::new).collect(),
+            ..Default::default()
+        },
+        &FileDeclarations {
+            classes: new.to_vec(),
+            ..Default::default()
+        },
+    )
+}
+
+pub(crate) fn published_function_keys(
+    old: &[(String, FunctionInfo)],
+    new_name: &str,
+    new: Option<&FunctionInfo>,
+) -> Vec<ReferenceIndexKey> {
+    let previous = old
+        .iter()
+        .find(|(name, _)| name.eq_ignore_ascii_case(new_name));
+    let changed = match (previous, new) {
+        (Some((_, old)), Some(new)) => {
+            !old.signature_eq(new) || new.return_type.as_ref().is_none_or(|ty| ty.is_mixed())
+        }
+        _ => true,
+    };
+    let mut keys = HashSet::new();
+    if changed {
+        push_name_keys(&mut keys, new_name, ReferenceIndexKey::function_owned);
+    }
+    keys.into_iter().collect()
+}
+
+pub(crate) fn published_constant_keys(
+    names: impl Iterator<Item = String>,
+) -> Vec<ReferenceIndexKey> {
+    let mut keys = HashSet::new();
+    for name in names {
+        push_name_keys(&mut keys, &name, ReferenceIndexKey::Constant);
+    }
+    keys.into_iter().collect()
+}

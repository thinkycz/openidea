+#[cfg(test)]
+mod unsaved_fanout_tests {
+    use crate::Backend;
+    use std::sync::atomic::Ordering;
+    use tower_lsp::lsp_types::*;
+
+    const DEPENDENCY: &str = "<?php namespace App; final class Dependency { public function message(): string { return 'ready'; } }";
+    const CALLER: &str = "<?php namespace App; final class Caller { public function read(Dependency $dep): string { return $dep->message(); } }";
+
+    struct Fixture {
+        backend: Backend,
+        _dir: tempfile::TempDir,
+        helper: Url,
+        caller: Url,
+        other: Url,
+        original: String,
+    }
+
+    async fn fixture(helper: &str, caller: &str) -> Fixture {
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path().canonicalize().unwrap();
+        let backend = Backend::new_test_with_workspace(root.clone(), Vec::new());
+        let mut uris = Vec::new();
+        for (name, source) in [
+            ("Dependency.php", helper),
+            ("Caller.php", caller),
+            (
+                "Other.php",
+                "<?php namespace App; final class Other { public function value(): int { return 7; } }",
+            ),
+        ] {
+            let path = root.join(name);
+            std::fs::write(&path, source).unwrap();
+            let uri = Url::from_file_path(&path).unwrap();
+            backend
+                .on_did_open(DidOpenTextDocumentParams {
+                    text_document: TextDocumentItem {
+                        uri: uri.clone(),
+                        language_id: "php".to_owned(),
+                        version: 1,
+                        text: source.to_owned(),
+                    },
+                })
+                .await;
+            uris.push(uri);
+        }
+        backend.workspace_indexed.store(true, Ordering::Release);
+        backend.init_complete.store(true, Ordering::Release);
+        backend.diag.pending_uris.lock().clear();
+        Fixture {
+            backend,
+            _dir: dir,
+            helper: uris[0].clone(),
+            caller: uris[1].clone(),
+            other: uris[2].clone(),
+            original: helper.to_owned(),
+        }
+    }
+
+    async fn change(f: &Fixture, text: &str) {
+        f.backend
+            .on_did_change(DidChangeTextDocumentParams {
+                text_document: VersionedTextDocumentIdentifier {
+                    uri: f.helper.clone(),
+                    version: 2,
+                },
+                content_changes: vec![TextDocumentContentChangeEvent {
+                    range: None,
+                    range_length: None,
+                    text: text.to_owned(),
+                }],
+            })
+            .await;
+        assert_eq!(
+            std::fs::read_to_string(f.helper.to_file_path().unwrap()).unwrap(),
+            f.original
+        );
+    }
+
+    #[tokio::test]
+    async fn unsaved_method_declaration_change_queues_unchanged_caller() {
+        let f = fixture(DEPENDENCY, CALLER).await;
+        change(
+            &f,
+            &DEPENDENCY.replace("function message()", "function removed()"),
+        )
+        .await;
+        let pending = f.backend.diag.pending_uris.lock();
+        assert!(
+            pending.contains(f.caller.as_str()),
+            "the caller must update without a Save or caller edit"
+        );
+        assert!(
+            !pending.contains(f.other.as_str()),
+            "unrelated tabs do not re-diagnose"
+        );
+        drop(pending);
+        let text = f
+            .backend
+            .open_files
+            .read()
+            .get(f.caller.as_str())
+            .cloned()
+            .unwrap();
+        assert_eq!(
+            f.backend
+                .diag
+                .documents
+                .lock()
+                .capture(f.caller.as_str(), &text)
+                .unwrap()
+                .unwrap()
+                .version,
+            1
+        );
+    }
+
+    #[tokio::test]
+    async fn typed_method_body_edit_does_not_queue_callers() {
+        let f = fixture(DEPENDENCY, CALLER).await;
+        change(&f, &DEPENDENCY.replace("'ready'", "'changed'")).await;
+        assert!(
+            !f.backend
+                .diag
+                .pending_uris
+                .lock()
+                .contains(f.caller.as_str())
+        );
+    }
+
+    #[tokio::test]
+    async fn added_class_after_empty_overlay_queues_unresolved_caller() {
+        let f = fixture("<?php namespace App;", CALLER).await;
+        change(&f, DEPENDENCY).await;
+        assert!(
+            f.backend
+                .diag
+                .pending_uris
+                .lock()
+                .contains(f.caller.as_str()),
+            "a first declaration must refresh earlier unresolved uses"
+        );
+    }
+
+    #[tokio::test]
+    async fn unsaved_function_signature_change_queues_caller() {
+        let original = "<?php namespace App; function value(): int { return 7; }";
+        let caller = "<?php namespace App; final class Caller { public function read(): int { return value(); } }";
+        let f = fixture(original, caller).await;
+        change(
+            &f,
+            "<?php namespace App; function value(): string { return 'seven'; }",
+        )
+        .await;
+        assert!(
+            f.backend
+                .diag
+                .pending_uris
+                .lock()
+                .contains(f.caller.as_str())
+        );
+    }
+
+    #[tokio::test]
+    async fn typed_function_body_edit_does_not_queue_callers() {
+        let original = "<?php namespace App; function value(): int { return 7; }";
+        let caller = "<?php namespace App; final class Caller { public function read(): int { return value(); } }";
+        let f = fixture(original, caller).await;
+        change(
+            &f,
+            "<?php namespace App; function value(): int { return 9; }",
+        )
+        .await;
+        assert!(
+            !f.backend
+                .diag
+                .pending_uris
+                .lock()
+                .contains(f.caller.as_str())
+        );
+    }
+
+    #[tokio::test]
+    async fn closing_unsaved_dependency_queues_caller_against_restored_disk() {
+        let f = fixture(DEPENDENCY, CALLER).await;
+        change(
+            &f,
+            &DEPENDENCY.replace("function message()", "function removed()"),
+        )
+        .await;
+        f.backend.diag.pending_uris.lock().clear();
+        f.backend
+            .on_did_close(DidCloseTextDocumentParams {
+                text_document: TextDocumentIdentifier {
+                    uri: f.helper.clone(),
+                },
+            })
+            .await;
+        assert!(
+            f.backend
+                .diag
+                .pending_uris
+                .lock()
+                .contains(f.caller.as_str()),
+            "discarding an overlay must refresh restored declarations"
+        );
+        assert!(!f.backend.open_files.read().contains_key(f.helper.as_str()));
+    }
+
+    #[tokio::test]
+    async fn declaration_free_body_edit_does_not_fan_out() {
+        let f = fixture("<?php $value = 1;", CALLER).await;
+        change(&f, "<?php $value = 2;").await;
+        assert!(
+            !f.backend
+                .diag
+                .pending_uris
+                .lock()
+                .contains(f.caller.as_str())
+        );
+        assert!(
+            !f.backend
+                .diag
+                .pending_uris
+                .lock()
+                .contains(f.other.as_str())
+        );
+    }
+    #[tokio::test]
+    async fn untyped_method_body_edit_queues_consumers() {
+        let original = DEPENDENCY.replace("message(): string", "message()");
+        let f = fixture(&original, CALLER).await;
+        change(&f, &original.replace("'ready'", "123")).await;
+        assert!(
+            f.backend
+                .diag
+                .pending_uris
+                .lock()
+                .contains(f.caller.as_str())
+        );
+    }
+
+    #[tokio::test]
+    async fn untyped_function_body_edit_queues_consumers() {
+        let original = "<?php namespace App; function value() { return 7; }";
+        let caller = "<?php namespace App; final class Caller { public function read(): int { return value(); } }";
+        let f = fixture(original, caller).await;
+        change(&f, &original.replace("return 7", "return 'seven'")).await;
+        assert!(
+            f.backend
+                .diag
+                .pending_uris
+                .lock()
+                .contains(f.caller.as_str())
+        );
+    }
+
+    #[tokio::test]
+    async fn identical_reparse_of_inferred_bodies_does_not_loop() {
+        let original = DEPENDENCY.replace("message(): string", "message()");
+        let f = fixture(&original, CALLER).await;
+        f.backend.update_ast(f.helper.as_str(), &original);
+        assert!(f.backend.diag.pending_uris.lock().is_empty());
+    }
+
+    #[tokio::test]
+    async fn added_function_after_empty_overlay_queues_unresolved_caller() {
+        let caller = "<?php namespace App; final class Caller { public function read(): int { return value(); } }";
+        let f = fixture("<?php namespace App;", caller).await;
+        change(
+            &f,
+            "<?php namespace App; function value(): int { return 7; }",
+        )
+        .await;
+        assert!(
+            f.backend
+                .diag
+                .pending_uris
+                .lock()
+                .contains(f.caller.as_str())
+        );
+    }
+}

+    /// Remove both parsed declarations and discovery entries for an overlay
+    /// with no backing source. Empty publication uses the normal declaration
+    /// diff, duplicate-owner promotion, cache invalidation and consumer fanout;
+    /// the existing deletion purge then drops discovery/per-URI bookkeeping.
+    fn retire_closed_semantic_source(&self, uri: &str) {
+        self.update_ast(uri, "");
+        if let Some(path) = tower_lsp::lsp_types::Url::parse(uri)
+            .ok()
+            .and_then(|url| url.to_file_path().ok())

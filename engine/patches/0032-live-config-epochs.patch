+    }
+    #[test]
+    fn reload_on_worker_clone_retires_main_request() {
+        let f = fixture();
+        let worker = f.backend.clone_for_blocking();
+        modified(f.backend.with_current_semantics(|| {
+            write_config(f.dir.path(), true);
+            worker.reload_config(f.dir.path());
+            Ok("result from prior configuration")
+        }));
+    }
+    #[test]
+    fn native_prior_phase_is_rejected_while_parsed_source_stays_reusable() {
+        let f = fixture();

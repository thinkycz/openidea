+    #[test]
+    fn live_reload_queues_all_unchanged_open_consumers() {
+        let f = fixture();
+        let (other, _) = open(&f.backend, f.dir.path(), "Other");
+        f.backend.diag.pending_uris.lock().clear();
+        write_config(f.dir.path(), true);
+        f.backend.reload_config(f.dir.path());
+        let pending = f.backend.diag.pending_uris.lock();
+        assert!(

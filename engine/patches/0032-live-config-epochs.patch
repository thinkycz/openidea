+        let root = dir.path().canonicalize().unwrap();
+        let backend = Backend::new_test_with_workspace(root.clone(), vec![]);
+        write_config(&root, false);
+        backend.reload_config(&root);
+        let (uri, text) = open(&backend, &root, "Caller");
+        backend.workspace_indexed.store(true, Ordering::Release);
+        backend.init_complete.store(true, Ordering::Release);
+        backend.diag.pending_uris.lock().clear();
+        Fixture {
+            backend,
+            dir,
+            uri,
+            text,
+        }

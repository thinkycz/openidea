+/// Keep requests and native phases outside a partially published configuration.
+/// Counting overlapping guards also covers project/global reloads racing on
+/// separate worker clones. No lock is held across cache/index reconciliation.
+struct ConfigurationPublication<'a>(&'a Backend);
+impl Drop for ConfigurationPublication<'_> {
+    fn drop(&mut self) {
+        let ready = self.0.diag.documents.lock().finish_configuration_change();
+        if ready {
+            self.0.schedule_diagnostics_after_configuration_reload();
+        }
+    }

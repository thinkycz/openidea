+    fn reload_retires_requests_even_with_no_open_documents() {
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path().canonicalize().unwrap();
+        let backend = Backend::new_test_with_workspace(root.clone(), vec![]);
+        write_config(&root, false);
+        backend.reload_config(&root);
+        modified(backend.with_current_semantics(|| {
+            write_config(&root, true);
+            backend.reload_config(&root);
+            Ok("old workspace result")
+        }));
+    }
+    #[test]
+    fn overlapping_publications_block_requests_and_capture_until_last_finish() {
+        let f = fixture();
+        let old = f
+            .backend
+            .diag
+            .documents
+            .lock()
+            .capture(&f.uri, &f.text)
+            .unwrap()
+            .unwrap();
+        {
+            let mut documents = f.backend.diag.documents.lock();
+            documents.begin_configuration_change();
+            documents.begin_configuration_change();
+            assert!(documents.capture(&f.uri, &f.text).is_err());
+            assert!(!documents.mark_phase(&f.uri, Some(&old), true));
+        }
+        modified(f.backend.with_current_semantics(|| Ok(())));
+        {
+            let mut documents = f.backend.diag.documents.lock();
+            assert!(!documents.finish_configuration_change());
+            assert!(documents.capture(&f.uri, &f.text).is_err());
+        }
+        modified(f.backend.with_current_semantics(|| Ok(())));
+        {
+            let mut documents = f.backend.diag.documents.lock();
+            assert!(documents.finish_configuration_change());
+            let current = documents.capture(&f.uri, &f.text).unwrap().unwrap();
+            assert!(documents.parsed(&f.uri, Some(&current)));
+            assert!(documents.mark_phase(&f.uri, Some(&current), true));
+            assert!(!documents.mark_phase(&f.uri, Some(&old), true));
+        }
+        assert!(f.backend.with_current_semantics(|| Ok(())).is_ok());
+    }
+    #[test]
+    fn pull_reload_retires_cached_full_result_without_reusing_result_ids() {
+        let f = fixture();
+        f.backend
+            .supports_pull_diagnostics
+            .store(true, Ordering::Release);
+        f.backend
+            .diag
+            .last_full
+            .lock()
+            .insert(f.uri.clone(), vec![Default::default()]);
+        f.backend.diag.result_ids.lock().insert(f.uri.clone(), 55);
+        write_config(f.dir.path(), true);
+        f.backend.reload_config(f.dir.path());
+        assert!(!f.backend.diag.last_full.lock().contains_key(&f.uri));
+        assert_eq!(f.backend.diag.result_ids.lock().get(&f.uri), Some(&55));
+        assert!(f.backend.diag.pending_uris.lock().contains(&f.uri));
+    }

+        ));
+        std::fs::write(&path, text.as_str()).unwrap();
+        let uri = Url::from_file_path(path).unwrap().to_string();
+        backend.diag.documents.lock().open(&uri, 1, &text);
+        backend
+            .open_files
+            .write()
+            .insert(uri.clone(), Arc::clone(&text));
+        assert!(backend.parse_diagnostic_snapshot(&uri, &text));
+        (uri, text)

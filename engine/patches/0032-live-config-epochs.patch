+        modified(f.backend.with_current_semantics(|| {
+            write_config(f.dir.path(), true);
+            f.backend.reload_config(f.dir.path());
+            write_config(f.dir.path(), false);
+            f.backend.reload_config(f.dir.path());
+            Ok("mixed configuration result")

+    #[test]
+    fn invalid_reload_preserves_current_request_configuration_and_run() {
+        let f = fixture();
+        let old = f
+            .backend
+            .diag
+            .documents
+            .lock()
+            .capture(&f.uri, &f.text)
+            .unwrap()
+            .unwrap();

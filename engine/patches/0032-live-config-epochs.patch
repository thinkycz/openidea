+    /// A successful configuration transaction retired all prior runs before
+    /// changing settings. Queue unchanged open documents after publication.
+    pub(crate) fn schedule_diagnostics_after_configuration_reload(&self) {
+        if !self.init_complete.load(Ordering::Acquire) {
+            return;
+        }
+        let uris: Vec<String> = self.open_files.read().keys().cloned().collect();
+        if uris.is_empty() {
+            return;
+        }
+        if self.supports_pull_diagnostics.load(Ordering::Acquire) {
+            let mut cache = self.diag.last_full.lock();
+            for uri in &uris {
+                cache.remove(uri);
+            }
+        }
+        self.diag.pending_uris.lock().extend(uris);
+        self.diag.version.fetch_add(1, Ordering::Release);
+        self.diag.notify.notify_one();
+    }
+

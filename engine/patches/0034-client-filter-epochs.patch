+        b.supports_pull_diagnostics.store(true, Ordering::Release);
+        b.diag
+            .last_full
+            .lock()
+            .insert(uri.clone(), vec![Default::default()]);
+        b.diag.result_ids.lock().insert(uri.clone(), 44);
+        b.set_client_indexing_options(options());
+        assert!(b.diag.pending_uris.lock().contains(&uri));
+        assert!(!b.diag.last_full.lock().contains_key(&uri));
+        assert_eq!(b.diag.result_ids.lock().get(&uri), Some(&44));
+    }
+    #[test]
+    fn repeated_client_filters_preserve_request_and_native_run() {
+        let (b, uri, text) = fixture();

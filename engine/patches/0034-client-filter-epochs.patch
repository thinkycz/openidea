+        );
+        assert!(b.diag.documents.lock().mark_phase(&uri, Some(&old), true));
+        assert!(b.diag.pending_uris.lock().is_empty());
+    }
+    #[test]
+    fn client_filter_guard_blocks_capture_through_index_reconciliation() {
+        let (b, uri, text) = fixture();
+        let dir = tempfile::tempdir().unwrap();
+        *b.workspace.workspace_root.write() = Some(dir.path().to_path_buf());
+        let old = b
+            .diag
+            .documents
+            .lock()
+            .capture(&uri, &text)
+            .unwrap()
+            .unwrap();
+        let publication = b.client_indexing_publication(options()).unwrap();
+        assert!(
+            b.index_filters()
+                .is_excluded_entry(&dir.path().join("generated"), true)
+        );
+        assert!(b.diag.documents.lock().capture(&uri, &text).is_err());
+        modified(b.with_current_semantics(|| Ok(())));
+        assert!(
+            b.diag.pending_uris.lock().is_empty(),
+            "queue only after reconciliation finishes"
+        );
+        drop(publication);
+        let mut docs = b.diag.documents.lock();
+        let current = docs.capture(&uri, &text).unwrap().unwrap();
+        assert!(docs.parsed(&uri, Some(&current)));
+        assert!(!docs.mark_phase(&uri, Some(&old), true));
+        assert!(docs.mark_phase(&uri, Some(&current), true));
+    }
+    #[test]
+    fn toml_reload_cannot_finish_a_pending_client_filter_publication() {
+        let (b, uri, text) = fixture();
+        let dir = tempfile::tempdir().unwrap();
+        std::fs::write(
+            dir.path().join(".phpantom.toml"),
+            "[diagnostics]\nreport-magic-properties=true\n",
+        )
+        .unwrap();
+        let publication = b.client_indexing_publication(options()).unwrap();
+        b.reload_config(dir.path());
+        assert!(b.diag.documents.lock().capture(&uri, &text).is_err());
+        modified(b.with_current_semantics(|| Ok(())));
+        assert!(b.diag.pending_uris.lock().is_empty());
+        drop(publication);
+        assert!(b.diag.documents.lock().capture(&uri, &text).is_ok());
+        assert!(b.diag.pending_uris.lock().contains(&uri));
+    }
+    #[test]
+    fn identical_push_during_publication_does_not_finish_or_queue_it() {
+        let (b, uri, text) = fixture();
+        let publication = b.client_indexing_publication(options()).unwrap();
+        assert!(b.client_indexing_publication(options()).is_none());
+        assert!(b.diag.documents.lock().capture(&uri, &text).is_err());
+        assert!(b.diag.pending_uris.lock().is_empty());
+        drop(publication);
+        assert!(b.diag.documents.lock().capture(&uri, &text).is_ok());
+        assert!(b.diag.pending_uris.lock().contains(&uri));
+    }
+}

+/// A live semantic configuration mutation owns its whole synchronous
+/// publication, including cache and index reconciliation. Overlapping changes
+/// block captures until the last guard finishes, without holding an index lock.
+struct ConfigurationPublication<'a>(&'a Backend);
+impl Drop for ConfigurationPublication<'_> {
+    fn drop(&mut self) {
+        let ready = self.0.diag.documents.lock().finish_configuration_change();
+        if ready {
+            self.0.schedule_diagnostics_after_configuration_reload();
+        }
+    }
+}

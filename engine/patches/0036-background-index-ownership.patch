+        assert_eq!(calls, 1);
+    }
+    #[test]
+    fn query_preparation_waits_for_an_already_parsed_background_merge() {
+        use std::{sync::mpsc, time::Duration};
+        let b = Backend::new_test();
+        let worker = b.clone_for_blocking();
+        let (started, ready) = mpsc::channel();
+        let (finish, proceed) = mpsc::channel();
+        let merge = std::thread::spawn(move || {
+            let _merge = worker.index_merge_gate.lock();

+            7
+        );
+        assert_eq!(calls, 1);
+    }
+    #[test]
+    fn query_preparation_cannot_enter_a_pending_background_publication() {
+        let b = Backend::new_test();
+        let publication = b.begin_background_index_publication();
+        let mut calls = 0;
+        let result = b.with_prepared_current_semantics(|| {
+            calls += 1;
+            Ok("not ready")

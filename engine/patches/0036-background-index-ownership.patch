+        let final_batch = Arc::clone(&finished);
+        let (started, ready) = mpsc::channel();
+        let (finish, proceed) = mpsc::channel();
+        let pass = std::thread::spawn(move || {
+            let _index = worker.workspace_index_lock.lock();
+            {
+                let _merge = worker.index_merge_gate.lock();
+                let _publication = worker.begin_background_index_publication();
+                started.send(()).unwrap();
+                proceed.recv_timeout(Duration::from_secs(3)).unwrap();
+            }
+            std::thread::sleep(Duration::from_millis(100));
+            let _merge = worker.index_merge_gate.lock();
+            let _publication = worker.begin_background_index_publication();
+            final_batch.store(true, Ordering::Release);
+        });
+        ready.recv_timeout(Duration::from_secs(2)).unwrap();
+        let release = std::thread::spawn(move || {
+            std::thread::sleep(Duration::from_millis(100));
+            finish.send(()).unwrap();
+        });
+        let result = b.with_prepared_current_semantics(|| Ok(finished.load(Ordering::Acquire)));
+        release.join().unwrap();
+        pass.join().unwrap();
+        assert!(
+            result.unwrap(),
+            "query admission must not stop between known index batches"
+        );
+    }
+}

+        assert_eq!(calls, 2);
+        assert_eq!(result.unwrap_err().code, ErrorCode::ServerError(-32801));
+    }
+    #[test]
+    fn query_preparation_does_not_repeat_a_warm_query() {
+        let b = Backend::new_test();
+        let mut calls = 0;
+        assert_eq!(

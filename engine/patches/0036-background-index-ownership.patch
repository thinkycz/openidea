+    /// A cold read may discover required framework symbols while resolving.
+    /// Discard that attempt and retry once against the published index, only
+    /// while editor/configuration/watch inputs still match the original call.
+    pub(crate) fn with_prepared_current_semantics<T>(
+        &self,
+        mut body: impl FnMut() -> Result<T>,
+    ) -> Result<T> {
+        let (input, before) = {
+            let documents = self.diag.documents.lock();
+            (documents.input_epoch(), documents.semantic_epoch())
+        };
+        let first = self.with_current_semantics(&mut body);
+        if !first
+            .as_ref()
+            .is_err_and(|error| error.code == ErrorCode::ServerError(-32801))
+        {
+            return first;
+        }
+        {
+            let documents = self.diag.documents.lock();
+            if !documents.input_matches(&input)
+                || (documents.epoch_matches(&before) && !documents.configuration_changing())
+            {
+                return first;
+            }
+        }
+        // A first lookup can arrive during the synchronous merge of a batch
+        // already parsed by startup. Wait at that boundary, then revalidate
+        // inputs before considering a new query attempt.
+        {
+            // A full workspace pass can publish several batches. Waiting only
+            // for one merge lets the next batch retire the retry immediately.
+            // Join an existing pass without starting a new filesystem scan.
+            let _index = self.workspace_index_lock.lock();
+            let _merge = self.index_merge_gate.lock();
+            let documents = self.diag.documents.lock();
+            if !documents.input_matches(&input)
+                || documents.configuration_changing()
+                || documents.epoch_matches(&before)
+            {
+                return first;
+            }
+        }
+        self.with_current_semantics(|| {
+            if !self.diag.documents.lock().input_matches(&input) {
+                return Err(content_modified());
+            }
+            body()
+        })
+    }
+
+    pub(crate) fn index_source_ticket(&self, uri: &str) -> Arc<()> {
+        let _merge = self.index_merge_gate.lock();
+        self.diag.documents.lock().index_ticket(uri)
+    }
+    pub(crate) fn release_index_source_ticket(&self, uri: &str, ticket: &Arc<()>) {
+        let _merge = self.index_merge_gate.lock();
+        self.diag.documents.lock().release_index_ticket(uri, ticket);
+    }

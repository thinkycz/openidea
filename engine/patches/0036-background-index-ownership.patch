+            calls += 1;
+            let uri = format!("file:///Widget{calls}.php");
+            let parsed = b.parse_ast_index_update_for_index(&uri, NEW);
+            b.apply_ast_index_parse_results_batch(vec![parsed]);
+            Ok("discard this attempt")

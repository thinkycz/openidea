+    #[tokio::test]
+    async fn workspace_symbol_prepares_pending_open_change_and_close_sources() {
+        for changed in [false, true] {
+            let dir = tempfile::tempdir().unwrap();
+            let path = dir.path().join("Widget.php");
+            let uri = Url::from_file_path(&path).unwrap().to_string();
+            let disk = std::sync::Arc::new("<?php\nclass DiskWidget {}\n".to_owned());
+            let current = std::sync::Arc::new("<?php\nclass CurrentWidget {}\n".to_owned());
+            std::fs::write(&path, disk.as_str()).unwrap();
+            let backend = Backend::new_test();
+            backend.update_ast(&uri, &disk);
+            if changed {
+                backend.diag.documents.lock().open(&uri, 1, &disk);
+                backend.open_files.write().insert(uri.clone(), disk.clone());
+                assert!(backend.parse_diagnostic_snapshot(&uri, &disk));
+                assert!(backend.diag.documents.lock().change(&uri, 2, &current));
+            } else {
+                backend.diag.documents.lock().open(&uri, 1, &current);
+            }
+            backend
+                .open_files
+                .write()
+                .insert(uri.clone(), current.clone());
+            let query = || WorkspaceSymbolParams {
+                query: "Widget".to_owned(),
+                ..Default::default()
+            };
+            let symbols = backend.symbol(query()).await.unwrap().unwrap_or_default();
+            assert!(
+                symbols.iter().any(|s| s.name == "CurrentWidget"),
+                "changed={changed}"
+            );
+            assert!(!symbols.iter().any(|s| s.name == "DiskWidget"));
+            backend.diag.documents.lock().close(&uri);
+            backend.open_files.write().remove(&uri);
+            let symbols = backend.symbol(query()).await.unwrap().unwrap_or_default();
+            assert!(symbols.iter().any(|s| s.name == "DiskWidget"));
+            assert!(!symbols.iter().any(|s| s.name == "CurrentWidget"));
+            assert_eq!(std::fs::read_to_string(path).unwrap(), *disk);
+        }
+    }

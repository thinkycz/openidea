+#[tokio::test]
+async fn dnf_group_and_union_tail_follow_php82_in_every_declaration_role() {
+    for minor in [0, 1, 2, 5] {
+        let b = backend(8, minor);
+        for declaration in [
+            "function f((First&Proj<caret>)|null $value) {}",
+            "function f(): (First&Proj<caret>)|null {}",
+            "class Demo { public (First&Proj<caret>)|null $value; }",
+            "class Demo { function __construct(public (First&Proj<caret>)|null $value) {} }",
+            "function f((First&Second)|Proj<caret> $value) {}",
+            "function f(): (First&Second)|Proj<caret> {}",
+        ] {
+            let source = format!(
+                "<?php interface First {{}} interface Second {{}} interface ProjectItem {{}} {declaration}"
+            );
+            assert_eq!(
+                offered(&b, &source, "ProjectItem", CompletionItemKind::CLASS).await,
+                minor >= 2,
+                "8.{minor} {source}"
+            );
+        }
+    }
+}
+
+#[tokio::test]
+async fn dnf_closed_intersections_allow_legal_scalar_union_members() {
+    let b = backend(8, 2);
+    for (prefix, label) in [("str", "string"), ("nu", "null"), ("fa", "false")] {
+        let source = format!(
+            "<?php interface First {{}} interface Second {{}} function f(): (First&Second)|{prefix}<caret> {{}}"
+        );
+        assert!(keyword(&b, &source, label).await, "{source}");
+    }
+    for declaration in [
+        "function f(): (First&Second)|ca<caret> {}",
+        "function f((First&Second)|ca<caret> $value) {}",
+    ] {
+        assert!(keyword(&b, &format!("<?php {declaration}"), "callable").await);
+    }
+    for declaration in [
+        "class Demo { public (First&Second)|ca<caret> $value; }",
+        "class Demo { function __construct(public (First&Second)|ca<caret> $value) {} }",
+    ] {
+        assert!(!keyword(&b, &format!("<?php {declaration}"), "callable").await);
+    }
+}

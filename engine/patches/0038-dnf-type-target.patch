+#[test]
+fn dnf_detects_parenthesized_prefixes_without_claiming_call_expressions() {
+    for source in [
+        "<?php function f(): (First&Second)|Proj",
+        "<?php function f((First&Proj",
+        "<?php class Demo { public (First&Second)|Proj",
+        "<?php class Demo { function __construct(public (First&Proj",
+    ] {
+        let ctx = detect(source, 0, source.encode_utf16().count() as u32).unwrap();
+        assert_eq!(ctx.partial, "Proj");
+        assert!(!ctx.available_for_target(PhpVersion::new(8, 1)), "{source}");
+        assert!(ctx.available_for_target(PhpVersion::new(8, 2)), "{source}");
+    }
+    for source in ["<?php foo((First&Proj", "<?php $x = (First&Second)|Proj"] {
+        assert!(detect(source, 0, source.encode_utf16().count() as u32).is_none());
+    }
+}

+        let uri = Url::from_file_path(path).unwrap();
+        let backend = Backend::new_test_with_workspace(root.clone(), Vec::new());
+        Self {
+            backend,
+            _directory: directory,
+            root,
+            uri,
+        }
+    }
+
+    async fn open(&self, text: &str) {
+        self.backend
+            .did_open(DidOpenTextDocumentParams {
+                text_document: TextDocumentItem {
+                    uri: self.uri.clone(),
+                    language_id: "php".into(),
+                    version: 1,
+                    text: text.into(),
+                },
+            })
+            .await;
+    }
+
+    async fn initialize(&self) {
+        self.backend.initialized(InitializedParams {}).await;
+    }
+
+    async fn save(&self, text: &str) {
+        fs::write(self.uri.to_file_path().unwrap(), text).unwrap();
+        self.backend
+            .did_save(DidSaveTextDocumentParams {
+                text_document: TextDocumentIdentifier {
+                    uri: self.uri.clone(),
+                },
+                text: Some(text.into()),
+            })
+            .await;
+    }
+
+    fn runs(&self) -> Vec<String> {
+        fs::read_to_string(self.root.join("analyzer-runs.txt"))
+            .unwrap_or_default()
+            .lines()
+            .map(str::to_owned)
+            .collect()
+    }
+
+    async fn wait_for_runs(&self, count: usize) -> bool {
+        tokio::time::timeout(Duration::from_secs(2), async {
+            loop {
+                if self.runs().len() >= count {
+                    return;
+                }
+                tokio::time::sleep(Duration::from_millis(10)).await;
+            }
+        })
+        .await
+        .is_ok()
+    }
+}

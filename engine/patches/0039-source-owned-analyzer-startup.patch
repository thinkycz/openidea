+#[tokio::test]
+async fn analyzer_startup_open_intent_runs_without_an_extra_save() {
+    let fixture = Fixture::new();
+    fixture.open(A).await;
+    assert!(
+        fixture.runs().is_empty(),
+        "opening before initialized must not execute a tool early"
+    );
+    fixture.initialize().await;
+    let caught_up = fixture.wait_for_runs(1).await;
+    let before_save = fixture.runs();
+    fixture.save(A).await;
+    assert!(
+        fixture.wait_for_runs(before_save.len() + 1).await,
+        "positive control: explicitly saving after initialized must invoke the configured executable"
+    );
+    fixture.backend.shutdown().await.unwrap();
+    assert!(
+        caught_up,
+        "initial open intent was dropped: initialization completed without analysis, while the explicit-save positive control works"
+    );
+    assert_eq!(before_save, ["A"]);
+}

+
+    fn open_source(backend: &Backend, root: &Path, name: &str, text: &str) -> String {
+        let uri = Url::from_file_path(root.join(name)).unwrap().to_string();
+        let content = Arc::new(text.to_owned());
+        let mut documents = backend.diag.documents.lock();
+        documents.open(&uri, 1, &content);
+        let revision = documents.capture_source(&uri, &content).unwrap();
+        documents.mark_parsed(&uri, revision.as_ref());
+        backend.open_files.write().insert(uri.clone(), content);
+        uri
+    }
+
+    fn schedule(backend: &Backend, tool: &ExternalToolWorker, uri: String) {
+        let source = Arc::clone(backend.open_files.read().get(&uri).unwrap());
+        backend.schedule_external_tools(&[tool], uri, &source);
+    }
+
+    fn worker(
+        backend: &Backend,
+        tool: &ExternalToolWorker,
+    ) -> (
+        tokio::task::JoinHandle<()>,
+        tokio::sync::mpsc::UnboundedReceiver<String>,
+    ) {
+        let backend = backend.clone_for_diagnostic_worker();
+        let tool = tool.clone();
+        let (sender, receiver) = tokio::sync::mpsc::unbounded_channel();
+        let handle = tokio::spawn(async move {
+            backend
+                .external_tool_worker(&tool, "startup-test", move |_, _| {
+                    let sender = sender.clone();
+                    Some(Box::new(move |content, _, _, _| {
+                        sender.send(content.to_owned()).unwrap();
+                        Ok(Vec::new())
+                    }))
+                })
+                .await;
+        });
+        (handle, receiver)
+    }
+
+    async fn stop(
+        backend: &Backend,
+        tool: &ExternalToolWorker,
+        handle: tokio::task::JoinHandle<()>,
+    ) {
+        backend.shutdown_flag.store(true, Ordering::Release);
+        tool.notify.notify_one();
+        tokio::time::timeout(Duration::from_secs(1), handle)
+            .await
+            .unwrap()
+            .unwrap();
+    }
+
+    #[tokio::test]
+    async fn analyzer_startup_latest_slot_survives_configuration_refresh_without_duplicates() {
+        let directory = tempfile::tempdir().unwrap();
+        let backend = Backend::new_test_with_workspace(directory.path().to_owned(), Vec::new());
+        let tool = ExternalToolWorker::new();
+        let first = open_source(&backend, directory.path(), "First.php", "first");
+        let latest = open_source(&backend, directory.path(), "Latest.php", "latest");
+        backend.diag.documents.lock().begin_configuration_change();
+        // A bounded slot supersedes both repeated requests and other URIs.
+        for _ in 0..1000 {
+            schedule(&backend, &tool, first.clone());
+        }
+        schedule(&backend, &tool, latest.clone());
+        assert_eq!(tool.pending_request.lock().as_ref().unwrap().uri, latest);
+        let content = Arc::clone(backend.open_files.read().get(&latest).unwrap());
+        assert_eq!(
+            Arc::strong_count(&content),
+            2,
+            "pending work retains no source payload"
+        );
+        assert!(
+            backend
+                .diag
+                .documents
+                .lock()
+                .capture(&latest, &content)
+                .is_err(),
+            "ordinary diagnostic capture stays configuration-sensitive"
+        );
+        backend.diag.documents.lock().finish_configuration_change();
+        backend.diag.documents.lock().begin_configuration_change();
+        backend.diag.documents.lock().finish_configuration_change();
+        let (handle, mut receiver) = worker(&backend, &tool);
+        assert!(
+            tokio::time::timeout(Duration::from_millis(30), receiver.recv())
+                .await
+                .is_err()
+        );
+        backend.init_complete.store(true, Ordering::Release);
+        assert_eq!(
+            tokio::time::timeout(Duration::from_secs(1), receiver.recv())
+                .await
+                .unwrap()
+                .as_deref(),
+            Some("latest")
+        );
+        assert!(
+            tokio::time::timeout(Duration::from_millis(60), receiver.recv())
+                .await
+                .is_err(),
+            "coalesced permits must not duplicate a run"
+        );
+        // A fresh save of unchanged source must still request another run.
+        schedule(&backend, &tool, latest);
+        assert_eq!(
+            tokio::time::timeout(Duration::from_secs(1), receiver.recv())
+                .await
+                .unwrap()
+                .as_deref(),
+            Some("latest")
+        );
+        stop(&backend, &tool, handle).await;
+    }
+

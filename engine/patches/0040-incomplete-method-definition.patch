+// A closed call at EOF is a common intermediate state after accepting completion.
+#[tokio::test]
+async fn test_definition_unterminated_final_method_cross_file_and_utf16() {
+    use crate::common::{definition_locations, goto_definition_at, position_after};
+    for ending in ["", "\n", "\r\n"] {
+        let backend = create_test_backend();
+        let declaration = Url::parse("file:///B.php").unwrap();
+        open_php(&backend, &declaration, "<?php\nclass RenameWitness { public function dirtyOverlay(): string { return 'live'; } }\n").await;
+        let uri = Url::parse("file:///consumer.php").unwrap();
+        let source = format!(
+            "<?php\n// café 🐘\n$instance = new RenameWitness();\n$instance->dirtyOverlay(){ending}"
+        );
+        open_php(&backend, &uri, &source).await;
+        for needle in ["$instance->dirty", "$instance->dirtyOverlay"] {
+            let position = position_after(&source, needle);
+            let locations = definition_locations(
+                goto_definition_at(&backend, &uri, position.line, position.character).await,
+            );
+            assert_eq!(
+                locations.len(),
+                1,
+                "closed call without terminator: {ending:?}"
+            );
+            assert_eq!(locations[0].uri, declaration);
+            assert_eq!(locations[0].range.start.line, 1);
+        }
+    }
+}

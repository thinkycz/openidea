+// Mago drops a final expression statement when only its semicolon is missing.
+// Recover a request-local method span without publishing synthetic source or
+// changing the original diagnostics, reference index, or rename participants.
+fn recover_trailing_method_call(content: &str, position: Position) -> Option<SymbolSpan> {
+    const MAX_RECOVERY_BYTES: usize = 1024 * 1024;
+    if content.len() > MAX_RECOVERY_BYTES || !content.trim_end().ends_with(')') {
+        return None;
+    }
+    let offset = position_to_offset(content, position);
+    let identifier_byte = |byte: u8| byte.is_ascii_alphanumeric() || byte == b'_' || byte >= 0x80;
+    if !content
+        .as_bytes()
+        .get(offset as usize)
+        .is_some_and(|byte| identifier_byte(*byte))
+        && !offset
+            .checked_sub(1)
+            .and_then(|offset| content.as_bytes().get(offset as usize))
+            .is_some_and(|byte| identifier_byte(*byte))
+    {
+        return None;
+    }
+    let mut terminated = String::with_capacity(content.len() + 1);
+    terminated.push_str(content);
+    terminated.push(';');
+    crate::parser::with_parsed_program(
+        &terminated,
+        "definition_missing_semicolon",
+        |program, source| {
+            if !program.errors.is_empty() {
+                return None;
+            }
+            let map = crate::symbol_map::extraction::extract_symbol_map(program, source);
+            let mut symbol = map
+                .lookup(offset)
+                .or_else(|| offset.checked_sub(1).and_then(|offset| map.lookup(offset)))?
+                .clone();
+            if symbol.end as usize > content.len() {
+                return None;
+            }
+            let SymbolKind::MemberAccess {
+                subject_text,
+                is_method_call: true,
+                ..
+            } = &mut symbol.kind
+            else {
+                return None;
+            };
+            // Subject ranges belong to the temporary map. Own the recovered text
+            // before ordinary resolution validates the live original source map.
+            let subject = subject_text.as_str(map.source(source)?).to_owned();
+            *subject_text = SubjectText::owned(subject);
+            Some(symbol)
+        },
+    )
+}
 

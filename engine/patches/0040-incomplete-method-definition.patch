+#[tokio::test]
+async fn test_definition_unterminated_final_method_updates_do_not_reuse_old_member() {
+    use crate::common::{definition_locations, goto_definition_at, position_after};
+    let backend = create_test_backend();
+    let declaration = Url::parse("file:///B.php").unwrap();
+    open_php(&backend, &declaration, "<?php\nclass RenameWitness { public function dirtyOverlay(): string { return 'live'; } }\n").await;
+    let uri = Url::parse("file:///consumer.php").unwrap();
+    let original = "<?php\n$instance = new RenameWitness();\n$instance->missingMember();\n";
+    open_php(&backend, &uri, original).await;
+    let changed = "<?php\n$instance = new RenameWitness();\n$instance->dirtyOverlay()";
+    backend
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: uri.clone(),
+                version: 2,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: changed.into(),
+            }],
+        })
+        .await;
+    let position = position_after(changed, "$instance->dirty");
+    let locations = definition_locations(
+        goto_definition_at(&backend, &uri, position.line, position.character).await,
+    );
+    assert_eq!(locations.len(), 1);
+    assert_eq!(locations[0].uri, declaration);
+}

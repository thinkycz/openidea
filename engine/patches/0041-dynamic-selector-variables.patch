+#[tokio::test]
+async fn direct_static_property_and_single_quoted_text_are_not_local_variables() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///static-property-control.php").unwrap();
+    let text = "<?php\nclass Target { public static string $name = 'field'; }\nfunction demo(): void {\n    $name = 'request';\n    $literal = '$name';\n    echo Target::$name;\n}\n";
+    open_php(&backend, &uri, text).await;
+    let declaration = position_of(text, "$name = 'request'");
+    let references = find_references(&backend, &uri, declaration, true).await;
+    assert_eq!(references.len(), 1);
+    let edit = rename(
+        &backend,
+        &uri,
+        declaration.line,
+        declaration.character + 2,
+        "operation",
+    )
+    .await
+    .unwrap();
+    assert_eq!(
+        apply_edits(text, &edits_for_uri(&edit, &uri)),
+        text.replace("$name = 'request'", "$operation = 'request'")
+    );
+    let property = in_context(text, "Target::$name", "$name");
+    let locations = definition_locations(
+        goto_definition_at(&backend, &uri, property.line, property.character + 2).await,
+    );
+    assert_eq!(locations.len(), 1);
+    assert_eq!(locations[0].range.start.line, 1);
+    assert_ne!(locations[0].range.start, declaration);
+    let literal = in_context(text, "'$name'", "$name");
+    assert!(
+        definition_locations(
+            goto_definition_at(&backend, &uri, literal.line, literal.character + 2).await
+        )
+        .is_empty()
+    );
+}

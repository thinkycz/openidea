+#[tokio::test]
+async fn ordinary_member_receiver_chain_is_still_navigable() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///receiver-chain-control.php").unwrap();
+    let text = "<?php\nclass Target { public function next(): self { return $this; } public function request(): void {} }\nfunction demo(Target $object): void { $object->next()->request(); }\n";
+    open_php(&backend, &uri, text).await;
+    let use_position = in_context(text, "->request()", "request");
+    let locations = definition_locations(
+        goto_definition_at(
+            &backend,
+            &uri,
+            use_position.line,
+            use_position.character + 2,
+        )
+        .await,
+    );
+    assert_eq!(locations.len(), 1);
+    assert_eq!(locations[0].uri, uri);
+    assert_eq!(locations[0].range.start.line, 1);
+    assert_eq!(
+        locations[0].range.start,
+        position_of(text, "request(): void")
+    );
+}

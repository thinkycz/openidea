+#[test]
+fn diagnostics_dynamic_selector_literal_and_direct_static_property_do_not_read_local() {
+    let php = "<?php\nclass Target { public static string $name = 'field'; }\nfunction demo(): void {\n    $name = 'field';\n    echo Target::$name;\n    echo '$name';\n}\n";
+    let diagnostics = crate::common::collect_diagnostics_with(

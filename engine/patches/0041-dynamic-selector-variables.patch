new file mode 100644
--- /dev/null
+++ b/tests/integration/dynamic_selector_variables.rs
@@ -0,0 +1,474 @@
+//! Local variables inside dynamic member selectors participate in navigation
+//! and rename without inferring which runtime member the expression names.
+
+use crate::common::{
+    apply_edits, create_test_backend, definition_locations, edits_for_uri, find_references,
+    goto_definition_at, open_php, position_of, rename,
+};
+use tower_lsp::lsp_types::{Position, Url};
+
+fn in_context(text: &str, context: &str, token: &str) -> Position {
+    let mut position = position_of(text, context);
+    let offset = context.find(token).expect("token inside context");
+    position.character += context[..offset].encode_utf16().count() as u32;
+    position
+}
+
+async fn assert_selector_variable(selector: &str, initial: &str) {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///dynamic-selector.php").unwrap();
+    let text = format!(
+        "<?php\nclass SelectorTarget {{\n    public static string $name = 'static';\n    public const VALUE = 'value';\n    public function next(): self {{ return $this; }}\n}}\nfunction demo(SelectorTarget $object, ?SelectorTarget $nullable): void {{\n    $name = {initial};\n    $literal = '$name';\n    {selector}\n}}\n"
+    );
+    open_php(&backend, &uri, &text).await;
+    let declaration = position_of(&text, &format!("$name = {initial};"));
+    let use_position = in_context(&text, selector, "$name");
+    let locations = definition_locations(
+        goto_definition_at(
+            &backend,
+            &uri,
+            use_position.line,
+            use_position.character + 2,
+        )
+        .await,
+    );
+    assert_eq!(locations.len(), 1, "selector {selector}");
+    assert_eq!(locations[0].uri, uri);
+    assert_eq!(locations[0].range.start, declaration, "selector {selector}");
+
+    let references = find_references(&backend, &uri, use_position, true).await;
+    let mut actual: Vec<_> = references
+        .iter()
+        .map(|location| location.range.start)
+        .collect();
+    actual.sort_by_key(|position| (position.line, position.character));
+    assert_eq!(
+        actual,
+        vec![declaration, use_position],
+        "selector {selector}"
+    );
+    assert!(references.iter().all(|location| location.uri == uri));
+
+    let edit = rename(
+        &backend,
+        &uri,
+        use_position.line,
+        use_position.character + 2,
+        "operation",
+    )
+    .await
+    .expect("selector variable can be renamed from its use");
+    let file_edits = edits_for_uri(&edit, &uri);
+    assert_eq!(file_edits.len(), 2, "selector {selector}");
+    let expected = text
+        .replace(
+            &format!("$name = {initial};"),
+            &format!("$operation = {initial};"),
+        )
+        .replace(selector, &selector.replace("$name", "$operation"));
+    assert_eq!(apply_edits(&text, &file_edits), expected);
+}
+
+macro_rules! selector_case {
+    ($name:ident, $selector:literal, $initial:literal) => {
+        #[tokio::test]
+        async fn $name() {
+            assert_selector_variable($selector, $initial).await;
+        }
+    };
+}
+
+selector_case!(method_direct_variable, "$object->$name();", "'request'");
+selector_case!(method_braced_variable, "$object->{$name}();", "'request'");
+selector_case!(
+    method_nested_variable,
+    "$object->$$name();",
+    "'methodVariable'"
+);
+selector_case!(
+    method_array_expression,
+    "$object->{$name['method']}();",
+    "['method' => 'request']"
+);
+selector_case!(
+    method_nested_call_expression,
+    "$object->{strtolower($name)}();",
+    "'REQUEST'"
+);
+selector_case!(
+    method_array_index_expression,
+    "$object->{['request'][$name]}();",
+    "0"
+);
+selector_case!(
+    method_conditional_expression,
+    "$object->{true ? $name : 'request'}();",
+    "'request'"
+);
+selector_case!(
+    nullsafe_direct_variable,
+    "$nullable?->$name();",
+    "'request'"
+);
+selector_case!(
+    nullsafe_array_expression,
+    "$nullable?->{$name[0]}();",
+    "['request']"
+);
+selector_case!(
+    static_method_direct_variable,
+    "SelectorTarget::$name();",
+    "'request'"
+);
+selector_case!(
+    static_method_array_expression,
+    "SelectorTarget::{$name[0]}();",
+    "['request']"
+);
+selector_case!(
+    method_first_class_callable,
+    "$callable = $object->$name(...);",
+    "'request'"
+);
+selector_case!(
+    method_first_class_expression,
+    "$callable = $object->{$name[0]}(...);",
+    "['request']"
+);
+selector_case!(
+    static_first_class_callable,
+    "$callable = SelectorTarget::$name(...);",
+    "'request'"
+);
+selector_case!(
+    static_first_class_expression,
+    "$callable = SelectorTarget::{$name[0]}(...);",
+    "['request']"
+);
+selector_case!(
+    static_property_indirect_variable,
+    "echo SelectorTarget::${$name};",
+    "'name'"
+);
+selector_case!(
+    static_property_nested_variable,
+    "echo SelectorTarget::$$name;",
+    "'fieldVariable'"
+);
+selector_case!(
+    constant_dynamic_expression,
+    "echo SelectorTarget::{$name};",
+    "'VALUE'"
+);
+selector_case!(
+    constant_array_expression,
+    "echo SelectorTarget::{$name[0]};",
+    "['VALUE']"
+);
+selector_case!(
+    receiver_chain_keeps_selector_scope,
+    "$object->next()->$name();",
+    "'request'"
+);
+
+#[tokio::test]
+async fn rename_dispatch_includes_the_dynamic_call_use() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///dispatch.php").unwrap();
+    let text = "<?php\nfunction dispatch(object $client): mixed {\n    $method = 'request';\n    return $client->$method();\n}\n";
+    open_php(&backend, &uri, text).await;
+    let declaration = position_of(text, "$method =");
+    let edit = rename(
+        &backend,
+        &uri,
+        declaration.line,
+        declaration.character + 2,
+        "operation",
+    )
+    .await
+    .expect("local declaration rename");
+    let edits = edits_for_uri(&edit, &uri);
+    assert_eq!(
+        edits.len(),
+        2,
+        "declaration and dynamic call must change together"
+    );
+    assert_eq!(
+        apply_edits(text, &edits),
+        "<?php\nfunction dispatch(object $client): mixed {\n    $operation = 'request';\n    return $client->$operation();\n}\n"
+    );
+}
+
+#[tokio::test]
+async fn unknown_selector_parameter_has_a_variable_definition_and_references() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///unknown-selector.php").unwrap();
+    let text = "<?php\nfunction dispatch(object $client, string $unknown): void {\n    $client->$unknown();\n    $client->{$unknown}();\n}\n";
+    open_php(&backend, &uri, text).await;
+    let declaration = position_of(text, "$unknown");
+    let use_position = in_context(text, "$client->{$unknown}();", "$unknown");
+    let locations = definition_locations(
+        goto_definition_at(
+            &backend,
+            &uri,
+            use_position.line,
+            use_position.character + 2,
+        )
+        .await,
+    );
+    assert_eq!(locations.len(), 1);
+    assert_eq!(locations[0].range.start, declaration);
+    let references = find_references(&backend, &uri, declaration, true).await;
+    assert_eq!(references.len(), 3);
+    let edit = rename(
+        &backend,
+        &uri,
+        declaration.line,
+        declaration.character + 2,
+        "operation",
+    )
+    .await
+    .unwrap();
+    assert_eq!(
+        apply_edits(text, &edits_for_uri(&edit, &uri)),
+        text.replace("$unknown", "$operation")
+    );
+}
+
+#[tokio::test]
+async fn nested_selector_keeps_each_repeated_variable_reference() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///repeated-selector.php").unwrap();
+    let text = "<?php\nfunction demo(object $object): void {\n    $name = 'request';\n    $object->{$name . $name}();\n}\n";
+    open_php(&backend, &uri, text).await;
+    let declaration = position_of(text, "$name =");
+    let references = find_references(&backend, &uri, declaration, true).await;
+    assert_eq!(references.len(), 3);
+    let edit = rename(
+        &backend,
+        &uri,
+        declaration.line,
+        declaration.character + 2,
+        "operation",
+    )
+    .await
+    .unwrap();
+    assert_eq!(
+        apply_edits(text, &edits_for_uri(&edit, &uri)),
+        text.replace("$name", "$operation")
+    );
+}
+
+#[tokio::test]
+async fn closure_capture_and_shadowed_selector_variables_keep_their_scopes() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///selector-scopes.php").unwrap();
+    let text = concat!(
+        "<?php\n",
+        "function demo(object $object, string $name): void {\n",
+        "    $shadow = function (string $name) use ($object) { $object->$name(); };\n",
+        "    $captured = function () use ($object, $name) { $object->{$name}(); };\n",
+        "    $arrow = fn(string $name) => $object->$name();\n",
+        "    $object->$name();\n",
+        "}\n",
+    );
+    open_php(&backend, &uri, text).await;
+    let declaration = position_of(text, "$name");
+    let edit = rename(
+        &backend,
+        &uri,
+        declaration.line,
+        declaration.character + 2,
+        "operation",
+    )
+    .await
+    .unwrap();
+    let edits = edits_for_uri(&edit, &uri);
+    assert_eq!(edits.len(), 4);
+    assert_eq!(
+        apply_edits(text, &edits),
+        concat!(
+            "<?php\n",
+            "function demo(object $object, string $operation): void {\n",
+            "    $shadow = function (string $name) use ($object) { $object->$name(); };\n",
+            "    $captured = function () use ($object, $operation) { $object->{$operation}(); };\n",
+            "    $arrow = fn(string $name) => $object->$name();\n",
+            "    $object->$operation();\n",
+            "}\n",
+        )
+    );
+}

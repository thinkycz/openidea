+fn assert_selector_read_diagnostics(selector: &str, initial: &str) {
+    let php = format!(
+        "<?php\nclass SelectorTarget {{ public static string $name = 'field'; public const VALUE = 'value'; }}\nfunction demo(object $object, ?object $nullable): void {{\n    $name = {initial};\n    {selector}\n}}\n"
+    );
+    let diagnostics = crate::common::collect_diagnostics_with(
+        &phpantom_lsp::Backend::new_test(),
+        &php,
+        phpantom_lsp::Backend::collect_unused_variable_diagnostics,
+    );
+    assert!(
+        diagnostics.is_empty(),
+        "selector {selector} reads its local variable: {diagnostics:?}"
+    );
+}
+
+macro_rules! selector_diagnostic_case {
+    ($name:ident, $selector:literal, $initial:literal) => {
+        #[test]
+        fn $name() {
+            assert_selector_read_diagnostics($selector, $initial);
+        }
+    };
+}

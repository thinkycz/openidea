+#[tokio::test]
+async fn eloquent_scope_builder_live_alias_is_offered_without_query_argument() {
+    let model = r"<?php namespace App\Models; use Illuminate\Database\Eloquent\Model; use Illuminate\Database\Eloquent\Builder; use Illuminate\Database\Eloquent\Attributes\Scope as QueryScope; class ScopeUser extends Model { #[QueryScope] protected function billable(Builder $query, string $tenant): void {} }";
+    let items = scope_attribute_builder_items(model).await;
+    let methods = method_names(&items);
+    assert!(
+        methods.contains(&"billable"),
+        "alias scope must reach the live Builder: {methods:?}"
+    );
+    let item = items
+        .iter()
+        .find(|item| item.filter_text.as_deref() == Some("billable"))
+        .expect("one billable completion");
+    assert!(
+        item.detail
+            .as_deref()
+            .is_some_and(|detail| detail.contains("Builder<ScopeUser>")),
+        "scope must retain model receiver: {item:?}"
+    );
+    assert!(
+        !item
+            .insert_text
+            .as_deref()
+            .unwrap_or_default()
+            .contains("query"),
+        "framework-injected query must not be a user argument: {item:?}"
+    );
+}

+#[tokio::test]
+async fn test_scope_body_cached_diagnostics_namespace_identity_isolation() {
+    let content = r#"<?php
+namespace App\Models\First {
+    use Illuminate\Database\Eloquent\Model;
+    use Illuminate\Database\Eloquent\Builder;
+    use Illuminate\Database\Eloquent\Attributes\Scope as Q;
+    class User extends Model {
+        public function scopeVerified(Builder $query): void {}
+        #[Q]
+        protected function active(Builder $query): void {
+            $query->where('active', true);
+            $query->verified(); // canonical
+            $query->deliberatelyMissing(); // canonical control
+        }
+    }
+}
+namespace App\Models\Second {
+    use Illuminate\Database\Eloquent\Model;
+    use Illuminate\Database\Eloquent\Builder;
+    #[\Attribute] class Scope {}
+    class User extends Model {
+        public function scopeVerified(Builder $query): void {}
+        #[Scope]
+        protected function active(Builder $query): void {
+            $query->where('active', true);
+            $query->verified(); // foreign
+            $query->deliberatelyMissing(); // foreign control
+        }
+    }
+}
+"#;
+    let path = "src/Models/NamespaceIdentity.php";
+    let (backend, dir) = make_workspace(&[(path, content)]);
+    let uri = crate::common::open_php_at(&backend, &dir, path, content).await;
+    let diagnostics =
+        crate::common::unknown_member_diagnostics_with_scope_cache(&backend, uri.as_str(), content);
+    for (needle, expected) in [
+        ("$query->verified(); // canonical", false),
+        ("$query->verified(); // foreign", true),
+        ("$query->deliberatelyMissing(); // canonical control", true),
+        ("$query->deliberatelyMissing(); // foreign control", true),
+    ] {
+        let line = content
+            .lines()
+            .position(|line| line.contains(needle))
+            .unwrap() as u32;
+        assert_eq!(
+            diagnostics
+                .iter()
+                .any(|diagnostic| diagnostic.range.start.line == line),
+            expected,
+            "the exact declaration's namespace must determine `{needle}`: {diagnostics:?}"
+        );
+    }
+    assert_eq!(
+        diagnostics.len(),
+        3,
+        "where() must remain valid in both namespaces: {diagnostics:?}"
+    );
+}

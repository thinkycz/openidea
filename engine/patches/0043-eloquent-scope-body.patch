+fn scope_body_identity_fixture(import: &str, methods: &str) -> String {
+    format!(
+        "<?php\nnamespace App\\Models;\nuse Illuminate\\Database\\Eloquent\\Model;\nuse Illuminate\\Database\\Eloquent\\Builder;\n{import}\nclass User extends Model {{\n    public function scopeVerified(Builder $query): void {{}}\n{methods}\n}}\n"
+    )
+}
+
+async fn assert_scope_body_cached_diagnostics(import: &str, methods: &str, is_scope: bool) {
+    let content = scope_body_identity_fixture(import, methods);
+    let path = "src/Models/User.php";
+    let (backend, dir) = make_workspace(&[(path, &content)]);
+    let uri = crate::common::open_php_at(&backend, &dir, path, &content).await;
+    // The slow pass builds and consumes diagnostic scope snapshots; an
+    // ordinary completion alone does not exercise this parameter seed.
+    let mut diagnostics = Vec::new();
+    backend.collect_slow_diagnostics(uri.as_str(), &content, &mut diagnostics);
+    let unknown_members: Vec<_> = diagnostics
+        .iter()
+        .filter(|diagnostic| {
+            matches!(
+                &diagnostic.code,
+                Some(NumberOrString::String(code)) if code == "unknown_member"
+            )
+        })
+        .collect();
+    let probe_line = content
+        .lines()
+        .position(|line| line.contains("$query->verified();"))
+        .unwrap() as u32;
+    let missing_line = content
+        .lines()
+        .position(|line| line.contains("$query->deliberatelyMissing();"))
+        .unwrap() as u32;
+    assert!(
+        unknown_members
+            .iter()
+            .any(|diagnostic| diagnostic.range.start.line == missing_line),
+        "unknown-member diagnostics must remain active on the Builder: {diagnostics:?}"
+    );
+    assert_eq!(
+        unknown_members
+            .iter()
+            .any(|diagnostic| diagnostic.range.start.line == probe_line),
+        !is_scope,
+        "only the actual attributed method should receive Builder<User> in its cached body: {diagnostics:?}"
+    );
+    assert_eq!(
+        unknown_members.len(),
+        if is_scope { 1 } else { 2 },
+        "where() remains valid and unrelated methods must not inherit a neighboring scope: {diagnostics:?}"
+    );
+}
+
+async fn assert_scope_body_completion_identity(import: &str, attribute: &str, is_scope: bool) {
+    let methods = format!(
+        "    {attribute}\n    protected function active(Builder $query): void {{\n        $query->verified();\n    }}"
+    );
+    let content = scope_body_identity_fixture(import, &methods);
+    let path = "src/Models/User.php";
+    let (backend, dir) = make_workspace(&[(path, &content)]);
+    let line = content
+        .lines()
+        .position(|line| line.contains("$query->verified();"))
+        .unwrap() as u32;
+    let items = complete_at(&backend, &dir, path, &content, line, 16).await;
+    let methods = method_names(&items);
+    assert!(
+        methods.contains(&"where"),
+        "Builder methods must remain available: {methods:?}"
+    );
+    assert_eq!(
+        methods.contains(&"verified"),
+        is_scope,
+        "only canonical Scope identity supplies the model's scope inside the body: {methods:?}"
+    );
+}

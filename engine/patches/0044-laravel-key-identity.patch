+#[test]
+fn recovered_context_uses_position_after_crlf_normalization() {
+    let backend = Backend::new_test();
+    let source = format!(
+        "<?php\r\n{}namespace First {{ use Wrong\\Schema as Schema; }}\r\nnamespace Second {{ use Right\\Schema as Schema;\r\n/** @var array{{ok: string}} $data */\r\n$data['\r\n}}\r\n",
+        "\r\n".repeat(256)
+    );
+    let line = source.lines().position(|line| line == "$data['").unwrap() as u32;
+    let position = Position::new(line, 7);
+    let patched = patch_array_access_at_cursor(&source, position);
+    assert_ne!(
+        position_to_offset(&source, position),
+        position_to_offset(&patched, position)
+    );
+    let ctx = backend.array_key_recovery_context(&patched, position);
+    assert_eq!(ctx.namespace.as_deref(), Some("Second"));
+    assert_eq!(
+        ctx.use_map.get("Schema").map(String::as_str),
+        Some("Right\\Schema")
+    );
+}
diff --git a/src/completion/laravel_key_calls.rs b/src/completion/laravel_key_calls.rs
new file mode 100644
--- /dev/null
+++ b/src/completion/laravel_key_calls.rs
@@ -0,0 +1,90 @@
+//! Semantic callable identity for config and translation key completion.
+
+use super::laravel_string_keys::receiver_chain_start;
+use super::source::helpers::{split_trailing_ident, trailing_class_name};
+use crate::symbol_map::laravel_key_calls::{self, KeyCall};
+use crate::{Backend, types::FileContext};
+
+pub(crate) type KeyCallRole<'a> = dyn Fn(&str) -> Option<KeyCall> + 'a;
+
+impl Backend {
+    pub(crate) fn laravel_key_call_role(
+        &self,
+        content: &str,
+        callable: &str,
+        ctx: &FileContext,
+    ) -> Option<KeyCall> {
+        let (method, before) = split_trailing_ident(callable);
+        let before = before.trim_end();
+        if !before.ends_with("::") && !before.ends_with("->") {
+            let helper = self.global_laravel_helper(
+                content,
+                callable,
+                ctx,
+                &["config", "__", "trans", "trans_choice"],
+            )?;
+            return laravel_key_calls::function_call(helper);
+        }
+        if laravel_key_calls::config_method_call(method).is_none()
+            && laravel_key_calls::translation_method_call(method).is_none()
+        {
+            return None;
+        }
+        if let Some(class_prefix) = before.strip_suffix("::") {
+            let written = trailing_class_name(class_prefix);
+            let offset = (class_prefix.trim_end().len() - written.len()) as u32;
+            let resolved = ctx.resolve_name_at(written, offset);
+            let receiver = resolved.trim_start_matches('\\');
+            if !receiver.contains('\\') && self.has_indexed_class(receiver) {
+                return None;
+            }
+            return laravel_key_calls::static_call(receiver, method);
+        }
+        let receiver = before
+            .strip_suffix("->")?
+            .trim_end()
+            .trim_end_matches('?')
+            .trim_end();
+        if let Some(call) = receiver.strip_suffix(')')
+            && let Some(open) = call.rfind('(')
+            && call[open + 1..].trim().is_empty()
+            && self
+                .global_laravel_helper(content, call[..open].trim_end(), ctx, &["config"])
+                .is_some()
+        {
+            return laravel_key_calls::config_method_call(method);
+        }
+        // Resolve typed repositories through the existing callable target path.
+        // The method's actual owner can be an interface or an inherited base.
+        let start = receiver_chain_start(receiver);
+        let target = self.resolve_callable_target_at_offset(
+            &callable[start..],
+            content,
+            callable.len() as u32,
+            ctx,
+        )?;
+        let owner = target.owner_class?;
+        let loader = self.class_loader(ctx);
+        for class in [
+            "Illuminate\\Config\\Repository",
+            "Illuminate\\Contracts\\Config\\Repository",
+        ] {
+            if owner.as_str().eq_ignore_ascii_case(class)
+                || crate::class_lookup::is_subclass_of(owner.as_str(), class, &loader)
+            {
+                return laravel_key_calls::config_method_call(method);
+            }
+        }
+        for class in [
+            "Illuminate\\Translation\\Translator",
+            "Illuminate\\Contracts\\Translation\\Translator",
+        ] {
+            if owner.as_str().eq_ignore_ascii_case(class)
+                || crate::class_lookup::is_subclass_of(owner.as_str(), class, &loader)
+            {
+                return laravel_key_calls::translation_method_call(method);
+            }
+        }
+        None
+    }
+}

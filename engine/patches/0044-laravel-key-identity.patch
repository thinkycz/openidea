+//! Recovered array access uses the repaired source's callable identity.
+use crate::common::{
+    complete_labels_at_opened, create_initialized_psr4_workspace, open_php_file, split_cursor,
+};
+
+async fn assert_recovered_keys(prefix: &str, expression: &str, helper: &str, expected: &str) {
+    let marked = format!(
+        "<?php\n{prefix}\nfunction probe(): void {{\n$value = {expression};\n$value['§\n}}\n"
+    );
+    let (content, position) = split_cursor(&marked);
+    let composer = r#"{"require":{"laravel/framework":"^13.0"},"autoload":{"psr-4":{"App\\":"app/"},"files":["app/helpers.php"]}}"#;
+    let (backend, _dir, _) = create_initialized_psr4_workspace(
+        composer,
+        &[
+            ("app/helpers.php", helper),
+            (
+                "config/workbench.php",
+                "<?php return ['theme' => ['label' => 'Bright']];",
+            ),
+            ("app/Consumer.php", &content),
+        ],
+        "app/helpers.php",
+    )
+    .await;
+    let uri = open_php_file(&backend, "app/Consumer.php").await;
+    let labels = complete_labels_at_opened(&backend, &uri, position.line, position.character).await;
+    assert!(
+        labels.iter().any(|label| label == expected),
+        "{expression}: recovered access should offer {expected}: {labels:?}"
+    );
+    let excluded = if expected == "label" {
+        "local"
+    } else {
+        "label"
+    };
+    assert!(
+        !labels.iter().any(|label| label == excluded),
+        "{expression}: unrelated array keys must be absent: {labels:?}"
+    );
+}
+
+#[tokio::test]
+async fn config_array_identity_recovered_global_helper() {
+    assert_recovered_keys(
+        "namespace App;",
+        "config('workbench.theme')",
+        "<?php",
+        "label",
+    )
+    .await;
+}
+
+#[tokio::test]
+async fn config_array_identity_recovered_alias_named_key() {
+    assert_recovered_keys(
+        "namespace App; use function config as setting;",
+        "setting(default: [], key: 'workbench.theme')",
+        "<?php",
+        "label",
+    )
+    .await;
+}
+
+#[tokio::test]
+async fn config_array_identity_recovered_local_helper() {
+    assert_recovered_keys("namespace App;", "config('workbench.theme')", "<?php namespace App; /** @return array{local: string} */ function config($key): array { return ['local' => 'custom']; }", "local").await;
+}
+
+#[tokio::test]
+async fn config_array_identity_recovered_foreign_import() {
+    assert_recovered_keys("namespace App; use function Vendor\\config as setting;", "setting('workbench.theme')", "<?php namespace Vendor; /** @return array{local: string} */ function config($key): array { return ['local' => 'custom']; }", "local").await;
+}
+
+#[tokio::test]
+async fn config_array_identity_recovered_same_file_local_helper() {
+    assert_recovered_keys("namespace App; /** @return array{local: string} */ function config($key): array { return ['local' => 'custom']; }", "config('workbench.theme')", "<?php", "local").await;
+}
+
+#[tokio::test]
+async fn config_array_identity_recovered_namespace_imports_stay_separate() {
+    assert_recovered_keys("namespace Prior; use function config as setting;\nnamespace App;", "setting('workbench.theme')", "<?php namespace App; /** @return array{local: string} */ function setting($key): array { return ['local' => 'custom']; }", "local").await;
+}

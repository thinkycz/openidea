+    /// Identify a global framework helper using existing per-offset names.
+    /// Namespace-local functions win; an explicit foreign import never falls
+    /// back to a same-spelled global helper when its declaration is absent.
+    pub(crate) fn global_laravel_function_name(
+        &self,
+        name: &str,
+        offset: u32,
+        resolved_names: Option<&crate::names::OwnedResolvedNames>,
+        namespace: Option<&str>,
+        helpers: &[&'static str],
+    ) -> Option<&'static str> {
+        let canonical = |name: &str| {
+            helpers
+                .iter()
+                .copied()
+                .find(|helper| name.trim_start_matches('\\').eq_ignore_ascii_case(helper))
+        };
+        if name.starts_with('\\') {
+            return canonical(name);
+        }
+        let names = resolved_names?;
+        let resolved = names.get(offset)?;
+        if let Some(helper) = canonical(resolved) {
+            return Some(helper);
+        }
+        if names.is_imported(offset) || name.contains('\\') {
+            return None;
+        }
+        let helper = canonical(name)?;
+        // Mago has already qualified an unimported function with its block's
+        // namespace. Consult that exact local FQN before PHP's global fallback.
+        if resolved.contains('\\') {
+            return (!self.has_indexed_function(resolved)).then_some(helper);
+        }
+        if let Some(namespace) = namespace.filter(|namespace| !namespace.is_empty()) {
+            return (!self.has_indexed_function(&format!("{namespace}\\{name}"))).then_some(helper);
+        }
+        Some(helper)
+    }
+

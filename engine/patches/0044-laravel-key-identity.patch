+//! Literal config and translation completion follows callable identity and
+//! the key parameter, rather than a written short name or argument position.
+
+use crate::common::{
+    LARAVEL_APP_COMPOSER, complete_labels_at_opened, create_initialized_psr4_workspace,
+    split_cursor,
+};
+
+async fn assert_key_completion(
+    imports: &str,
+    declarations: &str,
+    expression: &str,
+    expected: Option<&str>,
+) {
+    let marked = format!("<?php\nnamespace App;\n{imports}\n{declarations}\n{expression}\n");
+    let (content, position) = split_cursor(&marked);
+    let (backend, _dir, uri) = create_initialized_psr4_workspace(
+        LARAVEL_APP_COMPOSER,
+        &[
+            (
+                "config/workbench.php",
+                "<?php return ['enabled' => true];\n",
+            ),
+            (
+                "lang/en/workbench.php",
+                "<?php return ['welcome' => 'Welcome'];\n",
+            ),
+            ("app/Consumer.php", &content),
+        ],
+        "app/Consumer.php",
+    )
+    .await;
+    let labels = complete_labels_at_opened(&backend, &uri, position.line, position.character).await;
+    if let Some(key) = expected {
+        assert!(
+            labels.iter().any(|label| label == key),
+            "`{expression}` should offer {key}: {labels:?}"
+        );
+    } else {
+        for key in ["workbench.enabled", "workbench.welcome"] {
+            assert!(
+                !labels.iter().any(|label| label == key),
+                "`{expression}` is not a framework key argument and must not offer {key}: {labels:?}"
+            );
+        }
+    }
+}
+
+#[tokio::test]
+async fn config_completion_identity_canonical_controls() {
+    for expression in [
+        "config('workbench.§');",
+        "\\config('workbench.§');",
+        "Config::get('workbench.§');",
+    ] {
+        assert_key_completion(
+            "use Illuminate\\Support\\Facades\\Config;",
+            "",
+            expression,
+            Some("workbench.enabled"),
+        )
+        .await;
+    }
+}
+
+#[tokio::test]
+async fn config_completion_identity_translation_canonical_controls() {
+    for expression in [
+        "__('workbench.§');",
+        "trans('workbench.§');",
+        "\\__('workbench.§');",
+        "Lang::get('workbench.§');",
+    ] {
+        assert_key_completion(
+            "use Illuminate\\Support\\Facades\\Lang;",
+            "",
+            expression,
+            Some("workbench.welcome"),
+        )
+        .await;
+    }
+}
+
+#[tokio::test]
+async fn config_completion_identity_imported_config_function_alias() {
+    assert_key_completion(
+        "use function config as setting;",
+        "",
+        "setting('workbench.§');",
+        Some("workbench.enabled"),
+    )
+    .await;
+}
+
+#[tokio::test]
+async fn config_completion_identity_imported_translation_function_aliases() {
+    for (import, expression) in [
+        ("use function __ as tr;", "tr('workbench.§');"),
+        (
+            "use function trans as translate;",
+            "translate('workbench.§');",
+        ),
+    ] {
+        assert_key_completion(import, "", expression, Some("workbench.welcome")).await;
+    }
+}
+
+#[tokio::test]
+async fn config_completion_identity_imported_config_facade_alias() {
+    assert_key_completion(
+        "use Illuminate\\Support\\Facades\\Config as Settings;",
+        "",
+        "Settings::get('workbench.§');",
+        Some("workbench.enabled"),
+    )
+    .await;
+}
+
+#[tokio::test]
+async fn config_completion_identity_imported_translation_facade_alias() {
+    assert_key_completion(
+        "use Illuminate\\Support\\Facades\\Lang as Messages;",
+        "",
+        "Messages::get('workbench.§');",
+        Some("workbench.welcome"),
+    )
+    .await;
+}
+
+#[tokio::test]
+async fn config_completion_identity_local_functions_are_not_framework_helpers() {
+    let declarations = "function config(string $key, mixed $default = null): mixed { return $default; }\nfunction __(string $key, array $replace = [], ?string $locale = null): string { return $key; }";
+    for expression in ["config('workbench.§');", "__('workbench.§');"] {
+        assert_key_completion("", declarations, expression, None).await;
+    }
+}
+
+#[tokio::test]
+async fn config_completion_identity_foreign_facades_are_not_framework_facades() {
+    let declarations = "class Config { public static function get(string $key): mixed { return null; } }\nclass Lang { public static function get(string $key): string { return $key; } }";
+    for expression in ["Config::get('workbench.§');", "Lang::get('workbench.§');"] {

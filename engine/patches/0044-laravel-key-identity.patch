diff --git a/tests/integration/laravel_config_reference_identity.rs b/tests/integration/laravel_config_reference_identity.rs
new file mode 100644
--- /dev/null
+++ b/tests/integration/laravel_config_reference_identity.rs
@@ -0,0 +1,134 @@
+//! Config/translation navigation shares callable and named-key ownership.
+use crate::common::{
+    LARAVEL_APP_COMPOSER, create_initialized_psr4_workspace, definition_locations,
+    goto_definition_at, split_cursor,
+};
+use tower_lsp::lsp_types::{Position, Range};
+
+async fn assert_reference(
+    imports: &str,
+    declarations: &str,
+    expression: &str,
+    target: Option<&str>,
+) {
+    let marked = format!("<?php\nnamespace App;\n{imports}\n{declarations}\n{expression}\n");
+    let (content, position) = split_cursor(&marked);
+    let (backend, dir, uri) = create_initialized_psr4_workspace(
+        LARAVEL_APP_COMPOSER,
+        &[
+            (
+                "config/workbench.php",
+                "<?php\nreturn ['enabled' => true];\n",
+            ),
+            (
+                "lang/en/workbench.php",
+                "<?php\nreturn ['welcome' => 'Welcome'];\n",
+            ),
+            ("app/Consumer.php", &content),
+        ],
+        "app/Consumer.php",
+    )
+    .await;
+    let targets = definition_locations(
+        goto_definition_at(&backend, &uri, position.line, position.character).await,
+    );
+    if let Some(path) = target {
+        assert_eq!(targets.len(), 1, "{expression}: {targets:?}");
+        assert_eq!(
+            targets[0].uri.to_file_path().unwrap(),
+            dir.path().join(path)
+        );
+        assert_eq!(
+            targets[0].range,
+            Range::new(Position::new(1, 9), Position::new(1, 16)),
+            "the exact key content owns navigation"
+        );
+    } else {
+        assert!(
+            targets.is_empty(),
+            "unrelated call/default/replacement must not navigate to a framework key: {expression}: {targets:?}"
+        );
+    }
+}
+
+#[tokio::test]
+async fn config_reference_identity_aliases_and_named_keys() {
+    for (imports, expression, target) in [
+        ("", "config('workbench.en§abled');", "config/workbench.php"),
+        (
+            "use function config as setting;",
+            "setting('workbench.en§abled');",
+            "config/workbench.php",
+        ),
+        (
+            "use function config as setting;",
+            "setting()->get(key: 'workbench.en§abled');",
+            "config/workbench.php",
+        ),
+        (
+            "use function config as setting;",
+            "setting(default: false, key: 'workbench.en§abled');",
+            "config/workbench.php",
+        ),
+        (
+            "use Illuminate\\Support\\Facades\\Config as Settings;",
+            "Settings::get(default: false, key: 'workbench.en§abled');",
+            "config/workbench.php",
+        ),
+        (
+            "use function __ as tr;",
+            "tr('workbench.wel§come');",
+            "lang/en/workbench.php",
+        ),
+        (
+            "use function trans as tr;",
+            "tr(locale: 'en', key: 'workbench.wel§come');",
+            "lang/en/workbench.php",
+        ),
+        (
+            "use Illuminate\\Support\\Facades\\Lang as Messages;",
+            "Messages::get(locale: 'en', key: 'workbench.wel§come');",
+            "lang/en/workbench.php",
+        ),
+    ] {
+        assert_reference(imports, "", expression, Some(target)).await;
+    }
+}
+
+#[tokio::test]
+async fn config_reference_identity_rejects_local_names_and_nonkey_arguments() {
+    for (declarations, expression) in [
+        (
+            "function config($key) { return $key; }",
+            "config('workbench.en§abled');",
+        ),
+        (
+            "function config() { return new \\stdClass(); }",
+            "config()->get('workbench.en§abled');",
+        ),
+        ("", "config('app.name')->get('workbench.en§abled');"),
+        (
+            "function __($key) { return $key; }",
+            "__('workbench.wel§come');",
+        ),
+        ("class Config {}", "Config::get('workbench.en§abled');"),
+        ("class Lang {}", "Lang::get('workbench.wel§come');"),
+        ("", "config(default: 'workbench.en§abled', key: 'missing');"),
+        (
+            "",
+            "__(replace: ['name' => 'workbench.wel§come'], key: 'missing');",
+        ),
+    ] {
+        assert_reference("", declarations, expression, None).await;
+    }
+}
+
+#[tokio::test]
+async fn config_reference_identity_classes_have_no_namespace_global_fallback() {
+    for expression in [
+        "Config::get('workbench.en§abled');",
+        "Lang::get('workbench.wel§come');",
+    ] {
+        assert_reference("", "", expression, None).await;
+    }
+}

+//! Canonical Laravel config and translation call identities and key roles.
+
+use super::LaravelStringKind;
+
+#[derive(Clone, Copy)]
+pub(crate) struct KeyCall {
+    pub kind: LaravelStringKind,
+    pub parameter: &'static str,
+    pub accepts_array: bool,
+}
+
+pub(crate) fn function_call(name: &str) -> Option<KeyCall> {
+    let name = name.trim_start_matches('\\');
+    if name.eq_ignore_ascii_case("config") {
+        config_method_call("get")
+    } else if ["__", "trans", "trans_choice"]
+        .iter()
+        .any(|helper| name.eq_ignore_ascii_case(helper))
+    {
+        translation_method_call("get")
+    } else {
+        None
+    }
+}
+
+pub(crate) fn static_call(receiver: &str, method: &str) -> Option<KeyCall> {
+    let receiver = receiver.trim_start_matches('\\');
+    if receiver.eq_ignore_ascii_case("Illuminate\\Support\\Facades\\Config")
+        || receiver.eq_ignore_ascii_case("Config")
+    {
+        config_method_call(method)
+    } else if receiver.eq_ignore_ascii_case("Illuminate\\Support\\Facades\\Lang")
+        || receiver.eq_ignore_ascii_case("Lang")
+    {
+        translation_method_call(method)
+    } else {
+        None
+    }
+}
+
+pub(crate) fn config_method_call(method: &str) -> Option<KeyCall> {
+    let method = method.to_ascii_lowercase();
+    match method.as_str() {
+        "getmany" => Some(KeyCall {
+            kind: LaravelStringKind::Config,
+            parameter: "keys",
+            accepts_array: true,
+        }),
+        "get" | "string" | "integer" | "float" | "boolean" | "array" | "collection" | "set"
+        | "prepend" | "push" | "has" => Some(KeyCall {
+            kind: LaravelStringKind::Config,
+            parameter: "key",
+            accepts_array: false,
+        }),
+        _ => None,
+    }
+}
+
+pub(crate) fn translation_method_call(method: &str) -> Option<KeyCall> {
+    ["get", "has", "hasForLocale", "choice"]
+        .iter()
+        .any(|candidate| method.eq_ignore_ascii_case(candidate))
+        .then_some(KeyCall {
+            kind: LaravelStringKind::Trans,
+            parameter: "key",
+            accepts_array: false,
+        })
+}

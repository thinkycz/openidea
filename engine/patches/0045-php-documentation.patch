+/// Plain declaration generation shares enrichment and rendering with the typing
+/// paths, while its caller supplies exact AST-bound analysis and valid names.
+pub(super) fn build_declaration_docblock(request: &super::DeclarationDocblock<'_>) -> String {
+    let sym = request.symbol;
+    let display_type = |ty: &PhpType| ty.resolve_names(request.display_name);
+    match request.context {
+        DocblockContext::FunctionOrMethod => {
+            let params: Vec<(String, String)> = sym
+                .params
+                .iter()
+                .filter_map(|(hint, name)| {
+                    let ty = declaration_enrichment(hint.as_ref(), request.class_loader)?;
+                    Some((enrichment_type_to_plain(&display_type(&ty)), name.clone()))
+                })
+                .collect();
+            let no_return = sym
+                .method_name
+                .as_ref()
+                .is_some_and(|name| name.eq_ignore_ascii_case("__construct"))
+                || sym.return_type.as_ref().is_some_and(PhpType::is_void);
+            let return_type = if no_return {
+                None
+            } else {
+                request
+                    .inferred_return
+                    .as_ref()
+                    .filter(|ty| {
+                        !ty.is_void()
+                            && !ty.is_mixed()
+                            && sym
+                                .return_type
+                                .as_ref()
+                                .is_none_or(|native| !ty.equivalent(native))
+                    })
+                    .cloned()
+                    .or_else(|| {
+                        declaration_enrichment(sym.return_type.as_ref(), request.class_loader)
+                    })
+            };
+            let return_tag = return_type
+                .as_ref()
+                .map(|ty| enrichment_type_to_plain(&display_type(ty)));
+            render_function_plain(
+                request.indent,
+                &params,
+                request.throws,
+                return_tag.as_deref(),
+                request.display_name,
+            )
+        }
+        DocblockContext::ClassLike => {
+            build_class_plain(sym, request.indent, request.class_loader, true)
+        }
+        DocblockContext::Property | DocblockContext::Constant => {
+            let hint = sym.type_hint.as_ref();
+            let ty = hint.cloned().unwrap_or_else(PhpType::mixed);
+            let enriched = declaration_enrichment(hint, request.class_loader).unwrap_or(ty);
+            let text = enrichment_type_to_plain(&display_type(&enriched));
+            format!("{}/** @var {} */\n", request.indent, text)
+        }
+        DocblockContext::Inline | DocblockContext::Unknown => String::new(),
+    }
+}
+
+fn declaration_enrichment(
+    hint: Option<&PhpType>,
+    class_loader: &dyn Fn(&str) -> Option<Arc<ClassInfo>>,
+) -> Option<PhpType> {
+    let enriched = enrichment_plain_typed_fqn(hint, class_loader)?;
+    if let Some(name) = hint.and_then(PhpType::base_name)
+        && let Some(class) = class_loader(name)
+        && !class.template_params.is_empty()
+    {
+        return Some(PhpType::generic(
+            name,
+            vec![PhpType::mixed(); class.template_params.len()],
+        ));
+    }
+    Some(enriched)
+}

diff --git a/tests/integration/code_action_generate_docblock.rs b/tests/integration/code_action_generate_docblock.rs
new file mode 100644
--- /dev/null
+++ b/tests/integration/code_action_generate_docblock.rs
@@ -0,0 +1,298 @@
+//! Explicit, reviewed documentation proposals retain declaration identity.
+use crate::common::{
+    apply_workspace_edit, create_test_backend, find_action_titled, get_code_actions_at,
+};
+use tower_lsp::lsp_types::*;
+
+fn at_marker(source: &str) -> (String, Position) {
+    let offset = source.find('|').expect("caret marker");
+    let before = &source[..offset];
+    let line = before.bytes().filter(|byte| *byte == b'\n').count() as u32;
+    let column = before.rsplit('\n').next().unwrap().encode_utf16().count() as u32;
+    (source.replacen('|', "", 1), Position::new(line, column))
+}
+
+fn generated(source: &str) -> String {
+    generated_with_backend(source, &create_test_backend())
+}
+
+fn generated_with_backend(source: &str, backend: &phpantom_lsp::Backend) -> String {
+    let (source, position) = at_marker(source);
+    backend.update_ast("file:///test.php", &source);
+    let actions = get_code_actions_at(
+        backend,
+        "file:///test.php",
+        &source,
+        position.line,
+        position.character,
+    );
+    let action =
+        find_action_titled(&actions, "Generate PHPDoc block").expect("documentation action");
+    assert_eq!(action.kind, Some(CodeActionKind::REFACTOR_REWRITE));
+    assert!(action.command.is_none() && action.data.is_none() && action.disabled.is_none());
+    let edit = action.edit.as_ref().unwrap();
+    assert_eq!(edit.changes.as_ref().unwrap().len(), 1);
+    let edits = &edit.changes.as_ref().unwrap()[&Url::parse("file:///test.php").unwrap()];
+    assert_eq!(edits.len(), 1);
+    assert_eq!(edits[0].range.start, edits[0].range.end);
+    apply_workspace_edit(&source, edit)
+}
+
+fn refuses(source: &str) {
+    let (source, position) = at_marker(source);
+    let backend = create_test_backend();
+    backend.update_ast("file:///test.php", &source);
+    let actions = get_code_actions_at(
+        &backend,
+        "file:///test.php",
+        &source,
+        position.line,
+        position.character,
+    );
+    assert!(
+        find_action_titled(&actions, "Generate PHPDoc block").is_none(),
+        "unexpected documentation action for {source}"
+    );
+}
+
+#[test]
+fn documentation_generates_function_summary_without_redundant_native_tags() {
+    let result = generated("<?php\nfunction |greet(string $name): string { return $name; }\n");
+    assert!(result.contains("/**\n * \n */\nfunction greet"));
+    assert!(
+        !result.contains("@param") && !result.contains("@return"),
+        "{result}"
+    );
+}
+
+#[test]
+fn documentation_uses_ast_parameters_with_compact_attributes_and_references() {
+    let result = generated("<?php\nfunction |map(#[Meta(']')] array&$items, &...$rest): void {}\n");
+    assert!(result.contains("@param array<mixed> $items"), "{result}");
+    assert!(result.contains("...$rest"), "{result}");
+    assert!(!result.contains("Meta<mixed>") && !result.contains("@return"));
+}
+
+#[test]
+fn documentation_generates_qualifying_methods_and_constructor_without_return() {
+    let result =
+        generated("<?php\nclass Example {\n    public function |__construct($name) {}\n}\n");
+    assert!(
+        result.contains("    /**\n     * @param mixed $name\n     */\n    public function"),
+        "{result}"
+    );
+    assert!(!result.contains("@return"));
+}
+
+#[test]
+fn documentation_supports_named_classlikes_and_abstract_method_signatures() {
+    for kind in ["class", "interface", "trait", "enum"] {
+        let result = generated(&format!("<?php\n{kind} |Example {{}}\n"));
+        assert!(result.contains("/**\n * \n */\n"), "{result}");
+    }
+    let result = generated(
+        "<?php\ninterface Example {\n    public function |map($items): array;\n    /** @return string */\n    public function other(): string;\n}\n",
+    );
+    assert!(
+        result.contains("@param mixed $items") && result.contains("@return array<mixed>"),
+        "{result}"
+    );
+    assert!(!result.contains("@throws"));
+}
+
+#[test]
+fn documentation_preserves_property_aliases_and_fully_qualified_types() {
+    let result = generated(
+        "<?php\nnamespace App;\nuse Vendor\\Clock as Timepiece;\nclass Example {\n    public Timepiece |$clock;\n}\n",
+    );
+    assert!(result.contains("/** @var Timepiece */"), "{result}");
+    let result = generated(
+        "<?php\nnamespace App;\nclass Example {\n    public \\Vendor\\Clock $|clock;\n}\n",
+    );
+    assert!(result.contains("\\Vendor\\Clock"), "{result}");
+}
+
+#[test]
+fn documentation_inserts_before_complete_attributes_and_retains_crlf_unicode() {
+    let result = generated(
+        "<?php\r\n#[Meta(\r\n    text: ']function fake(){',\r\n)]\r\nfunction |žluťoučký($jméno): void {}\r\n",
+    );
+    assert!(result.contains("*/\r\n#[Meta("), "{result}");
+    assert!(result.contains("$jméno"));
+    assert!(!result.replace("\r\n", "").contains('\n'));
+}
+
+#[test]
+fn documentation_respects_attached_docblocks_through_attributes_and_comments() {
+    for source in [
+        "<?php\n/** Kept */\nfunction |run($item) {}\n",
+        "<?php\n/** Kept */\n#[Meta(']')]\nfunction |run($item) {}\n",
+        "<?php\nclass Example {\n    /** Kept */\n    #[Meta]\n    public |$name;\n}\n",
+        "<?php\n/** Kept */\n// kept as well\nclass |Example {}\n",
+    ] {
+        refuses(source);
+    }
+}
+
+#[test]
+fn documentation_refuses_bodies_locals_closures_anonymous_classes_html_and_broken_source() {
+    for source in [
+        "<?php\nfunction run() { |$item = 1; }\n",
+        "<?php\nclass Example {\n    function run() { |$item = 1; }\n}\n",
+        "<?php\n$closure = function |($item) {};\n",
+        "<?php\n$instance = new class |{};\n",
+        "<h1>|class Example</h1>\n<?php\nclass Existing {}\n",
+        "<?php\nfunction |broken( {}\n",
+        "<?php function |sameLine() {}\n",
+        "<?php\nclass Example { public |$item; }\n",
+        "<?php\nclass Example {\n    public $item = |new Value();\n}\n",
+    ] {
+        refuses(source);
+    }
+}
+
+#[test]
+fn documentation_uses_exact_function_body_before_neighboring_documented_methods() {
+    let result = generated(
+        "<?php\nclass Example {\n    public function |items(): array { /* do not skip this comment */ return [1, 2]; }\n    /** Other */\n    public function other(): void { throw new \\LogicException(); }\n}\n",
+    );
+    assert!(result.contains("@return"), "{result}");
+    assert!(!result.contains("@throws"), "{result}");
+    assert!(result.contains("/* do not skip this comment */"));
+}
+
+#[test]
+fn documentation_throws_keep_import_aliases_and_absolute_identity() {
+    let result = generated(
+        "<?php\nnamespace App;\nuse RuntimeException as Failure;\nfunction |fail(): void { throw new Failure(); }\n",
+    );
+    assert!(result.contains("@throws Failure"), "{result}");
+    let result = generated(
+        "<?php\nnamespace App;\nclass RuntimeException extends \\Exception {}\nfunction |fail(): void { throw new \\RuntimeException(); }\n",
+    );
+    assert!(result.contains("@throws \\RuntimeException"), "{result}");
+    let result = generated(
+        "<?php\nnamespace App;\nfunction |fail(): void { throw new \\ForeignVendor\\MissingFault(); }\n",
+    );
+    assert!(
+        result.contains("@throws \\ForeignVendor\\MissingFault"),
+        "{result}"
+    );
+}
+
+#[test]
+fn documentation_refuses_type_text_that_would_close_the_comment() {
+    refuses("<?php\nfunction |items(): array { return ['*/' => true]; }\n");
+}
+
+#[test]
+fn documentation_does_not_duplicate_an_applied_unsaved_docblock() {
+    let result = generated("<?php\nfunction |run($item): void {}\n");
+    let offset = result.find("run(").unwrap();
+    let mut marked = result;
+    marked.insert(offset, '|');
+    refuses(&marked);
+}
+
+#[test]
+fn documentation_body_analysis_handles_unicode_identifiers() {
+    let result = generated(
+        "<?php\nfunction |run($café): void { $café = 1; throw new \\RuntimeException(); }\n",
+    );
+    assert!(
+        result.contains("@param mixed $café") && result.contains("@throws RuntimeException"),
+        "{result}"
+    );
+}
+
+#[test]
+fn documentation_constants_retain_typed_hints() {
+    let result = generated("<?php\nclass Example {\n    public const string |NAME = 'name';\n}\n");
+    assert!(result.contains("/** @var string */"), "{result}");
+}
+
+#[test]
+fn documentation_uses_mixed_for_unspecified_generic_arguments() {
+    let result =
+        generated("<?php\n/** @template T */\nclass Box {}\nclass |Child extends Box {}\n");
+    assert!(result.contains("@extends Box<mixed>"), "{result}");
+    let result = generated(
+        "<?php\n/** @template T */\nclass Box {}\nclass Example {\n    public Box |$box;\n}\n",
+    );
+    assert!(result.contains("@var Box<mixed>"), "{result}");
+}
+
+#[test]
+fn documentation_absolute_throw_does_not_follow_a_conflicting_import() {
+    let result = generated(
+        "<?php\nnamespace Vendor { class RuntimeException extends \\Exception {} }\nnamespace App {\nuse Vendor\\RuntimeException;\nfunction |fail(): void { throw new \\RuntimeException(); }\n}\n",
+    );
+    assert!(result.contains("@throws \\RuntimeException"), "{result}");
+    assert!(
+        !result.contains("@throws \\Vendor\\RuntimeException"),
+        "{result}"
+    );
+}
+
+#[test]
+fn documentation_unknown_absolute_throw_does_not_fall_back_to_global_namesake() {
+    let result = generated(
+        "<?php\nnamespace App;\nfunction |fail(): void { throw new \\UnknownVendor\\RuntimeException(); }\n",
+    );
+    assert!(
+        result.contains("@throws \\UnknownVendor\\RuntimeException"),
+        "{result}"
+    );
+}
+
+#[test]
+fn documentation_relative_throw_does_not_fall_back_to_global_namesake() {
+    let result = generated(
+        "<?php\nnamespace App;\nfunction |fail(): void { throw new RelativeVendor\\RuntimeException(); }\n",
+    );
+    assert!(
+        result.contains("@throws \\App\\RelativeVendor\\RuntimeException"),
+        "{result}"
+    );
+}
+
+#[test]
+fn documentation_catches_use_lexical_import_and_absolute_identity() {
+    let result = generated(
+        "<?php\nnamespace App;\nuse Vendor\\RuntimeException;\nfunction |fail(): void { try { throw new \\RuntimeException(); } catch (RuntimeException $failure) {} }\n",
+    );
+    assert!(result.contains("@throws \\RuntimeException"), "{result}");
+    let result = generated(
+        "<?php\nnamespace App;\nfunction |fail(): void { try { throw new \\RuntimeException(); } catch (RelativeVendor\\RuntimeException $failure) {} }\n",
+    );
+    assert!(result.contains("@throws \\RuntimeException"), "{result}");
+}
+
+#[test]
+fn documentation_catch_hierarchy_uses_shared_subtyping() {
+    let backend = crate::common::create_test_backend_with_full_stubs();
+    let result = generated_with_backend(
+        "<?php\nnamespace App;\nfunction |fail(): void { try { throw new \\TypeError(); } catch (\\Exception $failure) {} }\n",
+        &backend,
+    );
+    assert!(result.contains("@throws \\TypeError"), "{result}");
+    let result = generated_with_backend(
+        "<?php\nnamespace App;\nfunction |fail(): void { try { throw new \\TypeError(); } catch (\\Throwable $failure) {} }\n",
+        &backend,
+    );
+    assert!(!result.contains("@throws"), "{result}");
+    let result = generated_with_backend(
+        "<?php\nnamespace App;\nfunction |fail(): void { try { throw new \\RuntimeException(); } catch (\\Exception $failure) {} }\n",
+        &backend,
+    );
+    assert!(!result.contains("@throws"), "{result}");
+}
+
+#[test]
+fn documentation_cross_file_throws_keep_the_declaration_namespace() {
+    let result = generated(
+        "<?php\nnamespace Vendor {\nclass Failure extends \\Exception {}\n/** @throws Failure */\nfunction perform(): void {}\n}\nnamespace App {\nfunction |run(): void { \\Vendor\\perform(); }\n}\n",
+    );
+    assert!(result.contains("@throws \\Vendor\\Failure"), "{result}");
+    assert!(!result.contains("@throws \\App\\Vendor"), "{result}");
+}

@@ -0,0 +1,460 @@
+//! Explicit PHPDoc generation at an AST declaration header.
+
+use mago_span::{HasSpan, Span};
+use mago_syntax::cst::class_like::member::ClassLikeMember;
+use mago_syntax::cst::class_like::method::MethodBody;
+use mago_syntax::cst::class_like::property::{Property, PropertyItem};
+use mago_syntax::cst::function_like::parameter::FunctionLikeParameterList;
+use mago_syntax::cst::function_like::r#return::FunctionLikeReturnTypeHint;
+use mago_syntax::cst::*;
+use tower_lsp::lsp_types::*;
+
+use crate::Backend;
+use crate::atom::bytes_to_str;
+use crate::completion::phpdoc::generation::{DeclarationDocblock, generate_declaration_docblock};
+use crate::completion::phpdoc::{DocblockContext, SymbolInfo};
+use crate::completion::source::throws_analysis::{self, ThrowsContext};
+use crate::parser::extract_hint_type;
+use crate::symbol_map::docblock::get_docblock_text_with_offset;
+use crate::text_position::{offset_to_position, position_to_offset};
+
+struct Declaration {
+    span: Span,
+    context: DocblockContext,
+    symbol: SymbolInfo,
+    function: Option<FunctionRegion>,
+}
+
+struct FunctionRegion {
+    name: u32,
+    signature: std::ops::Range<usize>,
+    body: std::ops::Range<usize>,
+}
+
+impl Backend {
+    pub(crate) fn collect_generate_docblock_actions(
+        &self,
+        uri: &str,
+        content: &str,
+        params: &CodeActionParams,
+        out: &mut Vec<CodeActionOrCommand>,
+    ) {
+        if params.range.start != params.range.end {
+            return;
+        }
+        let cursor = position_to_offset(content, params.range.start);
+        if offset_to_position(content, cursor as usize) != params.range.start {
+            return;
+        }
+        let declaration =
+            crate::parser::with_parsed_program(content, "generate_docblock", |program, _| {
+                if !program.errors.is_empty() {
+                    return None;
+                }
+                let declaration = find_declaration(program.statements.iter(), cursor)?;
+                if get_docblock_text_with_offset(
+                    program.trivia.as_slice(),
+                    content,
+                    &declaration.span,
+                )
+                .is_some()
+                {
+                    return None;
+                }
+                Some(declaration)
+            });
+        let Some(mut declaration) = declaration else {
+            return;
+        };
+        let start = declaration.span.start.offset as usize;
+        let line_start = content[..start].rfind('\n').map_or(0, |offset| offset + 1);
+        let indent = &content[line_start..start];
+        // Do not split a PHP opening tag, another statement, or a declaration
+        // sharing this line. An insertion must preserve all existing bytes.
+        if !indent.bytes().all(|byte| matches!(byte, b' ' | b'\t')) {
+            return;
+        }
+        let ctx = self.file_context_at(uri, declaration.span.start.offset);
+        let class_loader = self.class_loader(&ctx);
+        let function_loader = self.function_loader(&ctx);
+        let canonical =
+            |name: &str| crate::util::resolve_to_fqn(name, &ctx.use_map, &ctx.namespace);
+        for (hint, _) in &mut declaration.symbol.params {
+            *hint = hint.as_ref().map(|hint| hint.resolve_names(&canonical));
+        }
+        declaration.symbol.return_type = declaration
+            .symbol
+            .return_type
+            .as_ref()
+            .map(|hint| hint.resolve_names(&canonical));
+        declaration.symbol.type_hint = declaration
+            .symbol
+            .type_hint
+            .as_ref()
+            .map(|hint| hint.resolve_names(&canonical));
+        if declaration.context == DocblockContext::Property
+            && declaration.symbol.type_hint.is_none()
+            && let Some(name) = declaration
+                .symbol
+                .variable_name
+                .as_ref()
+                .and_then(|name| name.strip_prefix('$'))
+            && let Some(class) = ctx.classes.iter().find(|class| {
+                declaration.span.start.offset >= class.start_offset
+                    && declaration.span.start.offset <= class.end_offset
+            })
+            && let Some(property) = class
+                .properties
+                .iter()
+                .find(|property| property.name == name && property.native_type_hint.is_none())
+        {
+            declaration.symbol.type_hint = property.type_hint.clone();
+        }
+        let display_name = |name: &str| {
+            let fqn = name.trim_start_matches('\\');
+            let shortened = crate::util::shorten_from_fqn(fqn, &ctx.use_map, &ctx.namespace);
+            if crate::util::resolve_to_fqn(&shortened, &ctx.use_map, &ctx.namespace)
+                .eq_ignore_ascii_case(fqn)
+            {
+                shortened
+            } else {
+                format!("\\{fqn}")
+            }
+        };
+        for name in declaration
+            .symbol
+            .extends_names
+            .iter_mut()
+            .chain(&mut declaration.symbol.implements_names)
+        {
+            *name = display_name(&canonical(name));
+        }
+        let mut throws = Vec::new();
+        let mut inferred_return = None;
+        if let Some(function) = declaration.function {
+            let throws_ctx = ThrowsContext {
+                class_loader: &class_loader,
+                function_loader: Some(&function_loader),
+                use_map: &ctx.use_map,
+                file_namespace: &ctx.namespace,
+            };
+            throws = throws_analysis::find_uncaught_throw_types_in_body(
+                content,
+                &content[function.body],
+                &content[function.signature],
+                Some(&throws_ctx),
+            );
+            inferred_return = self
+                .infer_return_type_at(uri, content, function.name, false)
+                .map(|inferred| inferred.effective.unwrap_or(inferred.native));
+        }
+        let text = generate_declaration_docblock(&DeclarationDocblock {
+            context: declaration.context,
+            symbol: &declaration.symbol,
+            indent,
+            class_loader: &class_loader,
+            display_name: &display_name,
+            inferred_return,
+            throws: &throws,
+        });
+        if text.is_empty() || text.matches("*/").count() != 1 || text.contains('\0') {
+            return;
+        }
+        let newline = if content[line_start..].find('\n').is_some_and(|offset| {
+            offset > 0 && content.as_bytes()[line_start + offset - 1] == b'\r'
+        }) {
+            "\r\n"
+        } else {
+            "\n"
+        };
+        let text = if newline == "\r\n" {
+            text.replace('\n', "\r\n")
+        } else {
+            text
+        };
+        let Ok(uri) = uri.parse() else {
+            return;
+        };
+        let position = offset_to_position(content, line_start);
+        out.push(CodeActionOrCommand::CodeAction(CodeAction {
+            title: "Generate PHPDoc block".into(),
+            kind: Some(CodeActionKind::REFACTOR_REWRITE),
+            edit: Some(super::single_edit(
+                uri,
+                Range::new(position, position),
+                text,
+            )),
+            ..CodeAction::default()
+        }));
+    }
+}
+
+fn symbol_for_function(
+    name: &[u8],
+    parameters: &FunctionLikeParameterList<'_>,
+    return_type: Option<&FunctionLikeReturnTypeHint<'_>>,
+) -> SymbolInfo {
+    SymbolInfo {
+        params: parameters
+            .parameters
+            .iter()
+            .map(|parameter| {
+                let name = bytes_to_str(parameter.variable.name);
+                let name = if parameter.ellipsis.is_some() {
+                    format!("...{name}")
+                } else {
+                    name.to_string()
+                };
+                (parameter.hint.as_ref().map(extract_hint_type), name)
+            })
+            .collect(),
+        return_type: return_type.map(|hint| extract_hint_type(&hint.hint)),
+        method_name: Some(bytes_to_str(name).to_string()),
+        ..SymbolInfo::default()
+    }
+}
+
+fn function_region(name: u32, keyword: u32, body: &Block<'_>) -> FunctionRegion {
+    FunctionRegion {
+        name,
+        signature: keyword as usize..body.left_brace.start.offset as usize,
+        body: body.left_brace.end.offset as usize..body.right_brace.start.offset as usize,
+    }
+}
+
+fn header(
+    span: Span,
+    end: u32,
+    cursor: u32,
+    context: DocblockContext,
+    symbol: SymbolInfo,
+) -> Option<Declaration> {
+    (cursor >= span.start.offset && cursor < end).then_some(Declaration {
+        span,
+        context,
+        symbol,
+        function: None,
+    })
+}
+
+fn find_declaration<'a>(
+    statements: impl Iterator<Item = &'a Statement<'a>>,
+    cursor: u32,
+) -> Option<Declaration> {
+    for statement in statements {
+        let declaration = match statement {
+            Statement::Namespace(namespace) => {
+                find_declaration(namespace.statements().iter(), cursor)
+            }
+            Statement::Function(function) => {
+                let mut declaration = header(
+                    function.span(),
+                    function.body.left_brace.start.offset,
+                    cursor,
+                    DocblockContext::FunctionOrMethod,
+                    symbol_for_function(
+                        function.name.value,
+                        &function.parameter_list,
+                        function.return_type_hint.as_ref(),
+                    ),
+                );
+                if let Some(declaration) = &mut declaration {
+                    declaration.function = Some(function_region(
+                        function.name.span.start.offset,
+                        function.function.span.start.offset,
+                        &function.body,
+                    ));
+                }
+                declaration
+            }
+            Statement::Class(class) => class_declaration(
+                class.span(),
+                class.left_brace.start.offset,
+                &class.members,
+                cursor,
+                SymbolInfo {
+                    extends_names: class
+                        .extends
+                        .as_ref()
+                        .map(|extends| {
+                            extends
+                                .types
+                                .iter()
+                                .map(|name| bytes_to_str(name.value()).to_string())
+                                .collect()
+                        })
+                        .unwrap_or_default(),
+                    implements_names: class
+                        .implements
+                        .as_ref()
+                        .map(|implements| {
+                            implements
+                                .types
+                                .iter()
+                                .map(|name| bytes_to_str(name.value()).to_string())
+                                .collect()
+                        })
+                        .unwrap_or_default(),
+                    ..SymbolInfo::default()
+                },
+            ),
+            Statement::Interface(interface) => class_declaration(
+                interface.span(),
+                interface.left_brace.start.offset,
+                &interface.members,
+                cursor,
+                SymbolInfo {
+                    extends_names: interface
+                        .extends
+                        .as_ref()
+                        .map(|extends| {
+                            extends
+                                .types
+                                .iter()
+                                .map(|name| bytes_to_str(name.value()).to_string())
+                                .collect()
+                        })
+                        .unwrap_or_default(),
+                    ..SymbolInfo::default()
+                },
+            ),
+            Statement::Trait(trait_) => class_declaration(
+                trait_.span(),
+                trait_.left_brace.start.offset,
+                &trait_.members,
+                cursor,
+                SymbolInfo::default(),
+            ),
+            Statement::Enum(enum_) => class_declaration(
+                enum_.span(),
+                enum_.left_brace.start.offset,
+                &enum_.members,
+                cursor,
+                SymbolInfo {
+                    implements_names: enum_
+                        .implements
+                        .as_ref()
+                        .map(|implements| {
+                            implements
+                                .types
+                                .iter()
+                                .map(|name| bytes_to_str(name.value()).to_string())
+                                .collect()
+                        })
+                        .unwrap_or_default(),
+                    ..SymbolInfo::default()
+                },
+            ),
+            _ => None,
+        };
+        if declaration.is_some() {
+            return declaration;
+        }
+    }
+    None
+}
+
+fn class_declaration<'a>(
+    span: Span,
+    body_start: u32,
+    members: &'a Sequence<'a, ClassLikeMember<'a>>,
+    cursor: u32,
+    symbol: SymbolInfo,
+) -> Option<Declaration> {
+    if let Some(declaration) = header(span, body_start, cursor, DocblockContext::ClassLike, symbol)
+    {
+        return Some(declaration);
+    }
+    for member in members.iter() {
+        match member {
+            ClassLikeMember::Method(method) => {
+                let mut declaration = header(
+                    method.span(),
+                    method.body.span().start.offset,
+                    cursor,
+                    DocblockContext::FunctionOrMethod,
+                    symbol_for_function(
+                        method.name.value,
+                        &method.parameter_list,
+                        method.return_type_hint.as_ref(),
+                    ),
+                );
+                if let Some(declaration) = &mut declaration
+                    && let MethodBody::Concrete(body) = &method.body
+                {
+                    declaration.function = Some(function_region(
+                        method.name.span.start.offset,
+                        method.function.span.start.offset,
+                        body,
+                    ));
+                }
+                if declaration.is_some() {
+                    return declaration;
+                }
+            }
+            ClassLikeMember::Property(property) => {
+                let (hint, end) = match property {
+                    Property::Plain(property) => {
+                        if property.items.iter().any(|item| matches!(item, PropertyItem::Concrete(item) if cursor >= item.value.span().start.offset && cursor < item.value.span().end.offset)) { continue; }
+                        (
+                            property.hint.as_ref(),
+                            property.terminator.span().end.offset,
+                        )
+                    }
+                    Property::Hooked(property) => (
+                        property.hint.as_ref(),
+                        property.hook_list.left_brace.start.offset,
+                    ),
+                };
+                if let Some(declaration) = header(
+                    property.span(),
+                    end,
+                    cursor,
+                    DocblockContext::Property,
+                    SymbolInfo {
+                        type_hint: hint.map(extract_hint_type),
+                        variable_name: match property {
+                            Property::Plain(property) if property.items.len() == 1 => property
+                                .items
+                                .first()
+                                .map(|item| bytes_to_str(item.variable().name).to_string()),
+                            Property::Hooked(property) => {
+                                Some(bytes_to_str(property.item.variable().name).to_string())
+                            }
+                            _ => None,
+                        },
+                        ..SymbolInfo::default()
+                    },
+                ) {
+                    return Some(declaration);
+                }
+            }
+            ClassLikeMember::Constant(constant) => {
+                if constant.items.iter().any(|item| {
+                    cursor >= item.value.span().start.offset
+                        && cursor < item.value.span().end.offset
+                }) {
+                    continue;
+                }
+                let span = constant.attribute_lists.first().map_or_else(
+                    || constant.span(),
+                    |attribute| attribute.span().join(constant.span()),
+                );
+                if let Some(declaration) = header(
+                    span,
+                    constant.terminator.span().end.offset,
+                    cursor,
+                    DocblockContext::Constant,
+                    SymbolInfo {
+                        type_hint: constant.hint.as_ref().map(extract_hint_type),
+                        ..SymbolInfo::default()
+                    },
+                ) {
+                    return Some(declaration);
+                }
+            }
+            _ => {}
+        }
+    }
+    None
+}

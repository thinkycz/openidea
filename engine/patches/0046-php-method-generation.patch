+#[test]
+fn method_generation_abstract_interface_and_trait_only_paths_throw_explicitly() {
+    for source in [
+        "<?php\nabstract class ParentClass { abstract public function render(): string; }\nclass <caret>Child extends ParentClass {}\n",
+        "<?php\ninterface Contract { public function render(): string; }\nclass <caret>Child implements Contract {}\n",
+        "<?php\ntrait Shared { public function render(): string { return 'trait'; } }\nclass <caret>Child { use Shared; }\n",
+    ] {
+        let result = generated(source, "render");
+        assert!(
+            result.contains("throw new \\LogicException('Method is not implemented.');"),
+            "{result}"
+        );
+        assert!(!result.contains("parent::render"));
+    }
+}

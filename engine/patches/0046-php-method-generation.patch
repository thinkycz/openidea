+#[test]
+fn method_generation_from_members_and_comments_inserts_at_class_close() {
+    for member in [
+        "public function other() { <caret>$x = 1; }",
+        "public <caret>$value = 1;",
+        "// <caret>comment\n",
+        "public function other() { /* <caret>comment */ }",
+    ] {
+        let marked = format!(
+            "<?php\ninterface Contract {{ public function required(): void; }}\nclass Base {{ public function render() {{}} }}\nclass Child extends Base implements Contract {{\n    {member}\n}}\n"
+        );
+        let (source, found) = actions(&marked, PhpVersion::new(8, 4));
+        let close = source.rfind('}').unwrap();
+        let prefix = &source[..close];
+        let expected = Position::new(
+            prefix.bytes().filter(|byte| *byte == b'\n').count() as u32,
+            0,
+        );
+        for title in ["Override render (", "Implement `required`"] {
+            let action = find_action(&found, title).expect("class-level generation from member");
+            let edit = action.edit.as_ref().unwrap();
+            let edits = edit
+                .changes
+                .as_ref()
+                .unwrap()
+                .values()
+                .flatten()
+                .collect::<Vec<_>>();
+            assert_eq!(edits.len(), 1);
+            assert_eq!(edits[0].range, Range::new(expected, expected));
+            let result = apply_workspace_edit(&source, edit);
+            assert!(
+                result.starts_with(prefix),
+                "existing members must remain exact: {result}"
+            );
+            assert!(result.ends_with("}\n"));
+        }
+    }
+}

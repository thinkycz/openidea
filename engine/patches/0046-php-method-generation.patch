+#[test]
+fn method_generation_gates_union_literal_and_nullable_syntax_by_target() {
+    let nullable = "<?php\nclass Base { public function copy(?string $value): ?string { return $value; } }\nclass <caret>Child extends Base {}\n";
+    let (_, found) = actions(nullable, PhpVersion::new(7, 1));
+    let edit = find_action(&found, "Override copy (")
+        .unwrap()
+        .edit
+        .as_ref()
+        .unwrap();
+    let text = edit
+        .changes
+        .as_ref()
+        .unwrap()
+        .values()
+        .flatten()
+        .map(|edit| edit.new_text.as_str())
+        .collect::<String>();
+    assert!(text.contains("?string $value): ?string"), "{text}");
+    assert!(!text.contains("#[\\Override]"));
+    let union = "<?php\nclass Base { public function copy(int|false|null $value): int|false|null { return $value; } }\nclass <caret>Child extends Base {}\n";
+    assert!(find_action(&actions(union, PhpVersion::new(8, 0)).1, "Override copy (").is_some());
+    assert!(find_action(&actions(union, PhpVersion::new(7, 4)).1, "Override copy (").is_none());
+    for spelling in ["false|null|int", "int|null|false", "null|int|false"] {
+        let marked = format!(
+            "<?php\nclass Base {{ public function copy({spelling} $value): {spelling} {{ return $value; }} }}\nclass <caret>Child extends Base {{}}\n"
+        );
+        assert!(
+            find_action(
+                &actions(&marked, PhpVersion::new(8, 0)).1,
+                "Override copy ("
+            )
+            .is_some(),
+            "legal union {spelling}"
+        );
+    }
+    let literals_only = "<?php\nclass Base { public function copy(false|null $value): false|null { return $value; } }\nclass <caret>Child extends Base {}\n";
+    assert!(
+        find_action(
+            &actions(literals_only, PhpVersion::new(8, 0)).1,
+            "Override copy ("
+        )
+        .is_none()
+    );
+    assert!(
+        find_action(
+            &actions(literals_only, PhpVersion::new(8, 2)).1,
+            "Override copy ("
+        )
+        .is_some()
+    );
+    let never = "<?php\nclass Base { public function stop(): never { throw new \\Exception(); } }\nclass <caret>Child extends Base {}\n";
+    assert!(find_action(&actions(never, PhpVersion::new(8, 0)).1, "Override stop (").is_none());
+    let literal = "<?php\nclass Base { public function yes(): true { return true; } }\nclass <caret>Child extends Base {}\n";
+    assert!(find_action(&actions(literal, PhpVersion::new(8, 1)).1, "Override yes (").is_none());
+}

+#[test]
+fn method_generation_keeps_multiline_defaults_without_doubled_crlf() {
+    let result = generated(
+        "<?php\r\nclass Base { public function render(array $values = [\r\n    'nested' => [1, 2],\r\n]): array { return $values; } }\r\nclass <caret>Child extends Base {}\r\n",
+        "render",
+    );
+    assert!(!result.contains("\r\r\n"), "{result}");

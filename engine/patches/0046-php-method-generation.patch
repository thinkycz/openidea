+#[test]
+fn method_generation_encodes_multiline_string_bytes_before_line_ending_conversion() {
+    let result = generated(
+        "<?php\r\nclass Base { public function render(string $value = 'a\nb'): string { return $value; } }\r\nclass <caret>Child extends Base {}\r\n",
+        "render",
+    );
+    let inserted = result.rsplit("#[\\Override]").next().unwrap();
+    assert!(
+        inserted.contains("$value = \"\\x61\\x0A\\x62\""),
+        "{result}"
+    );
+    assert!(!inserted.replace("\r\n", "").contains('\n'));
+}

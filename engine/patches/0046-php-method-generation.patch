+#[test]
+fn method_generation_transports_lexical_aliases_self_parent_and_defaults() {
+    let result = generated(
+        "<?php\nnamespace Library {\nclass Payload {}\nclass Root {}\nclass Base extends Root { public const LABEL = 'base'; public function copy(self $other, parent $root, Payload $payload = new Payload(), string $label = self::LABEL): self { return $other; } }\n}\nnamespace Consumer {\nuse Library\\Base as Ancestor;\nuse Library\\Payload as Value;\nclass <caret>Child extends Ancestor {}\n}\n",
+        "copy",
+    );
+    let inserted = result.rsplit("#[\\Override]").next().unwrap();
+    assert!(inserted.contains("copy(Ancestor $other, \\Library\\Root $root, Value $payload = new Value(), string $label = Ancestor::LABEL): Ancestor"), "{result}");
+}

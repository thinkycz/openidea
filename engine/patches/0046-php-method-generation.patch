@@ -0,0 +1,1023 @@
+//! Reviewed method insertion using inherited symbols and declaration syntax.
+
+use std::collections::HashMap;
+use std::sync::Arc;
+
+use mago_span::HasSpan;
+use mago_syntax::cst::class_like::member::{ClassLikeConstantSelector, ClassLikeMember};
+use mago_syntax::cst::class_like::method::Method;
+use mago_syntax::cst::expression::Expression;
+use mago_syntax::cst::type_hint::Hint;
+use mago_syntax::cst::*;
+use tower_lsp::lsp_types::*;
+
+use super::implement_methods::{format_params, format_return_type};
+use crate::Backend;
+use crate::atom::{atom, bytes_to_str};
+use crate::completion::context::override_completion::collect_overridable_methods;
+use crate::inheritance::{ancestors, find_declaring_ancestor, find_declaring_trait};
+use crate::php_type::PhpType;
+use crate::text_position::{offset_to_position, position_to_offset};
+use crate::types::{ClassInfo, ClassLikeKind, FileContext, MethodInfo, PhpVersion, Visibility};
+
+pub(super) struct MethodInsertion {
+    pub keyword: u32,
+    pub open: u32,
+    pub close: u32,
+    pub end: u32,
+    pub offset: usize,
+    pub indent: String,
+    pub class_indent: String,
+    pub newline: &'static str,
+}
+
+pub(super) struct PreparedMethod {
+    pub method: MethodInfo,
+    pub returns_reference: bool,
+}
+
+impl Backend {
+    pub(super) fn method_insertion_at(
+        &self,
+        uri: &str,
+        content: &str,
+        params: &CodeActionParams,
+    ) -> Option<MethodInsertion> {
+        let cursor = position_to_offset(content, params.range.start);
+        let context = self.file_context_at(uri, cursor);
+        let class = crate::class_lookup::find_class_at_offset(&context.classes, cursor)?;
+        if class.kind != ClassLikeKind::Class {
+            return None;
+        }
+        // Resolve the smallest semantic class first. An anonymous class nested
+        // in a method must never select its containing named class instead.
+        method_insertion(content, params, class.keyword_offset)
+    }
+
+    pub(crate) fn collect_override_method_actions(
+        &self,
+        uri: &str,
+        content: &str,
+        params: &CodeActionParams,
+        out: &mut Vec<CodeActionOrCommand>,
+    ) {
+        let Some(target) = self.method_insertion_at(uri, content, params) else {
+            return;
+        };
+        let ctx = self.file_context_at(uri, target.keyword);
+        let Some(class) = matching_class(&ctx, &target) else {
+            return;
+        };
+        let class_loader = canonical_loader(self, &ctx);
+        let Ok(doc_uri) = uri.parse::<Url>() else {
+            return;
+        };
+        for (candidate, _, _) in collect_overridable_methods(class, "", &class_loader) {
+            let Some((_, declaring)) = find_declaring_ancestor(class, &class_loader, &|owner| {
+                owner.get_method_ci(&candidate.name).is_some()
+            }) else {
+                continue;
+            };
+            let Some(method) = declaring.get_method_ci(&candidate.name) else {
+                continue;
+            };
+            let direct_trait = declaring.kind == ClassLikeKind::Trait
+                && find_declaring_trait(&class.used_traits, &class_loader, &|owner| {
+                    owner.fqn() == declaring.fqn()
+                })
+                .is_some();
+            if method.is_virtual
+                || method.visibility == Visibility::Private
+                || method.name.starts_with("__")
+                || (method.is_final && !direct_trait)
+            {
+                continue;
+            }
+            let Some(prepared) =
+                self.prepare_generated_method(uri, content, class, &declaring, method, &ctx)
+            else {
+                continue;
+            };
+            if !self.generated_method_satisfies_contracts(uri, content, class, &prepared, &ctx) {
+                continue;
+            }
+            let delegates = !method.is_abstract
+                && !direct_trait
+                && class.parent_class.is_some()
+                && matches!(declaring.kind, ClassLikeKind::Class | ClassLikeKind::Trait);
+            let method_text = render_method(
+                &prepared,
+                &ctx.use_map,
+                &ctx.namespace,
+                &target,
+                delegates,
+                self.php_version() >= PhpVersion::new(8, 3) && !direct_trait,
+            );
+            let text = insertion_text(&target, &method_text, content);
+            let position = offset_to_position(content, target.offset);
+            out.push(CodeActionOrCommand::CodeAction(CodeAction {
+                title: format!("Override {} ({})", method.name, declaring.fqn()),
+                kind: Some(CodeActionKind::new("refactor.rewrite.overrideMethod")),
+                edit: Some(super::single_edit(
+                    doc_uri.clone(),
+                    Range::new(position, position),
+                    text,
+                )),
+                ..CodeAction::default()
+            }));
+        }
+    }
+
+    pub(super) fn generated_method_satisfies_contracts(
+        &self,
+        uri: &str,
+        content: &str,
+        target: &ClassInfo,
+        generated: &PreparedMethod,
+        context: &FileContext,
+    ) -> bool {
+        let loader = canonical_loader(self, context);
+        let mut pending: Vec<_> = target
+            .parent_class
+            .iter()
+            .chain(&target.interfaces)
+            .chain(&target.used_traits)
+            .copied()
+            .collect();
+        let mut seen = std::collections::HashSet::new();
+        while let Some(name) = pending.pop() {
+            if !seen.insert(name) {
+                continue;
+            }
+            if seen.len() > 1000 {
+                return false;
+            }
+            let Some(owner) = loader(&format!("\\{name}")) else {
+                return false;
+            };
+            if let Some(method) = owner.get_method_ci(&generated.method.name)
+                && !method.is_virtual
+                && method.visibility != Visibility::Private
+            {
+                let Some(contract) =
+                    self.prepare_generated_method(uri, content, target, &owner, method, context)
+                else {
+                    return false;
+                };
+                if !native_contract_satisfied(generated, &contract, &loader) {
+                    return false;
+                }
+            }
+            pending.extend(
+                owner
+                    .parent_class
+                    .iter()
+                    .chain(&owner.interfaces)
+                    .chain(&owner.used_traits)
+                    .copied(),
+            );
+        }
+        true
+    }
+
+    pub(super) fn prepare_generated_method(
+        &self,
+        uri: &str,
+        content: &str,
+        target: &ClassInfo,
+        declaring: &ClassInfo,
+        method: &MethodInfo,
+        target_context: &FileContext,
+    ) -> Option<PreparedMethod> {
+        let owner_uri = self
+            .symbols
+            .fqn_uri_index
+            .read()
+            .get(declaring.fqn().as_str())
+            .cloned();
+        let (source_uri, source) = if let Some(owner_uri) = owner_uri {
+            let source = if owner_uri == uri {
+                content.to_owned()
+            } else {
+                self.get_file_content(&owner_uri)?
+            };
+            (owner_uri, source)
+        } else {
+            self.find_class_file_content(&declaring.fqn(), uri, content)?
+        };
+        if declaring.kind == ClassLikeKind::Trait
+            && (!target.trait_aliases.is_empty()
+                || !target.trait_precedences.is_empty()
+                || ancestors(target, &canonical_loader(self, target_context)).any(|(_, parent)| {
+                    !parent.trait_aliases.is_empty() || !parent.trait_precedences.is_empty()
+                }))
+        {
+            return None;
+        }
+        let source_context = self.file_context_at(&source_uri, method.name_offset);
+        if !source_context.classes.iter().any(|class| {
+            class.fqn() == declaring.fqn() && class.keyword_offset == declaring.keyword_offset
+        }) {
+            return None;
+        }
+        let source_loader = canonical_loader(self, &source_context);
+        let lexical = if declaring.kind == ClassLikeKind::Trait {
+            if find_declaring_trait(&target.used_traits, &source_loader, &|owner| {
+                owner.fqn() == declaring.fqn()
+            })
+            .is_some()
+            {
+                Arc::new(target.clone())
+            } else {
+                ancestors(target, &source_loader).find_map(|(_, owner)| {
+                    find_declaring_trait(&owner.used_traits, &source_loader, &|tr| {
+                        tr.fqn() == declaring.fqn()
+                    })
+                    .map(|_| owner)
+                })?
+            }
+        } else {
+            Arc::new(declaring.clone())
+        };
+        crate::parser::with_parsed_program(&source, "generation_signature", |program, source| {
+            if !program.errors.is_empty() {
+                return None;
+            }
+            let syntax = find_method(
+                program.statements.iter(),
+                declaring.keyword_offset,
+                method.name_offset,
+                &method.name,
+            )?;
+            if syntax.parameter_list.parameters.len() != method.parameters.len() {
+                return None;
+            }
+            let mut prepared = method.clone();
+            for (parameter, syntax) in prepared
+                .parameters
+                .make_mut()
+                .iter_mut()
+                .zip(syntax.parameter_list.parameters.iter())
+            {
+                parameter.native_type_hint = match syntax.hint.as_ref() {
+                    Some(hint) => Some(portable_hint(
+                        hint,
+                        &lexical,
+                        &source_context,
+                        self.php_version(),
+                        false,
+                    )?),
+                    None => None,
+                };
+                parameter.name = atom(bytes_to_str(syntax.variable.name));
+                parameter.is_reference = syntax.ampersand.is_some();
+                parameter.is_variadic = syntax.ellipsis.is_some();
+                if parameter.is_variadic && self.php_version() < PhpVersion::new(5, 6) {
+                    return None;
+                }
+                parameter.default_value = match syntax.default_value.as_ref() {
+                    Some(default) => Some(
+                        portable_default(
+                            self,
+                            default.value,
+                            source,
+                            &source_context,
+                            &lexical,
+                            target,
+                            target_context,
+                        )?
+                        .replace("\r\n", "\n")
+                        .replace(
+                            '\n',
+                            source_newline(content, target.keyword_offset as usize),
+                        ),
+                    ),
+                    None => None,
+                };
+            }
+            prepared.native_return_type = match syntax.return_type_hint.as_ref() {
+                Some(return_type) => Some(portable_hint(
+                    &return_type.hint,
+                    &lexical,
+                    &source_context,
+                    self.php_version(),
+                    true,
+                )?),
+                None => None,
+            };
+            // An inherited PHPDoc return is not an added native contract.
+            prepared.return_type = prepared.native_return_type.clone();
+            Some(PreparedMethod {
+                method: prepared,
+                returns_reference: syntax.ampersand.is_some(),
+            })
+        })
+    }
+}
+
+pub(super) fn matching_class<'a>(
+    ctx: &'a FileContext,
+    target: &MethodInsertion,
+) -> Option<&'a ClassInfo> {
+    ctx.classes
+        .iter()
+        .find(|class| {
+            class.kind == ClassLikeKind::Class
+                && class.keyword_offset == target.keyword
+                && class.start_offset == target.open
+                && class.end_offset == target.end
+        })
+        .map(AsRef::as_ref)
+}
+
+fn method_insertion(
+    content: &str,
+    params: &CodeActionParams,
+    class_keyword: u32,
+) -> Option<MethodInsertion> {
+    if params.range.start != params.range.end {
+        return None;
+    }
+    let cursor = position_to_offset(content, params.range.start);
+    if offset_to_position(content, cursor as usize) != params.range.start {
+        return None;
+    }
+    crate::parser::with_parsed_program(content, "method_insertion", |program, content| {
+        if !program.errors.is_empty()
+            || program
+                .statements
+                .iter()
+                .any(|statement| cursor_in_inline(Node::Statement(statement), cursor))
+        {
+            return None;
+        }
+        insertion_in_statements(program.statements.iter(), cursor, class_keyword, content)
+    })
+}
+
+fn cursor_in_inline(node: Node<'_, '_>, cursor: u32) -> bool {
+    if let Node::Statement(Statement::Inline(inline)) = node {
+        return cursor >= inline.span().start.offset && cursor < inline.span().end.offset;
+    }
+    let mut found = false;
+    node.visit_children(|child| {
+        found |= cursor_in_inline(child, cursor);
+    });
+    found
+}
+
+fn insertion_in_statements<'a>(
+    statements: impl Iterator<Item = &'a Statement<'a>>,
+    cursor: u32,
+    class_keyword: u32,
+    content: &str,
+) -> Option<MethodInsertion> {
+    for statement in statements {
+        match statement {
+            Statement::Namespace(namespace) => {
+                if let Some(target) = insertion_in_statements(
+                    namespace.statements().iter(),
+                    cursor,
+                    class_keyword,
+                    content,
+                ) {
+                    return Some(target);
+                }
+            }
+            Statement::Class(class)
+                if class.class.span.start.offset == class_keyword
+                    && cursor >= class.span().start.offset
+                    && cursor <= class.right_brace.start.offset =>
+            {
+                let close = class.right_brace.start.offset as usize;
+                if content.get(close..class.right_brace.end.offset as usize) != Some("}") {
+                    return None;
+                }
+                let close_line = content[..close].rfind('\n').map_or(0, |offset| offset + 1);
+                let offset = if content[close_line..close]
+                    .bytes()
+                    .all(|byte| matches!(byte, b' ' | b'\t'))
+                {
+                    close_line
+                } else {
+                    close
+                };
+                let keyword = class.class.span.start.offset as usize;
+                let class_line = content[..keyword]
+                    .rfind('\n')
+                    .map_or(0, |offset| offset + 1);
+                let declaration_start = class.span().start.offset as usize;
+                let declaration_line = content[..declaration_start]
+                    .rfind('\n')
+                    .map_or(0, |offset| offset + 1);
+                let class_prefix = &content[declaration_line..declaration_start];
+                let class_indent = if class_prefix
+                    .bytes()
+                    .all(|byte| matches!(byte, b' ' | b'\t'))
+                {
+                    class_prefix
+                } else {
+                    ""
+                };
+                let indent = class
+                    .members
+                    .first()
+                    .and_then(|member| {
+                        let start = member.span().start.offset as usize;
+                        let line = content[..start].rfind('\n').map_or(0, |offset| offset + 1);
+                        let prefix = &content[line..start];
+                        (prefix.len() > class_indent.len()
+                            && prefix.bytes().all(|byte| matches!(byte, b' ' | b'\t')))
+                        .then(|| prefix.to_owned())
+                    })
+                    .unwrap_or_else(|| format!("{class_indent}    "));
+                let newline = if content[class_line..].find('\n').is_some_and(|offset| {
+                    offset > 0 && content.as_bytes()[class_line + offset - 1] == b'\r'
+                }) {
+                    "\r\n"
+                } else {
+                    "\n"
+                };
+                return Some(MethodInsertion {
+                    keyword: keyword as u32,
+                    open: class.left_brace.start.offset,
+                    close: close as u32,
+                    end: class.right_brace.end.offset,
+                    offset,
+                    indent,
+                    class_indent: class_indent.to_owned(),
+                    newline,
+                });
+            }
+            _ => {}
+        }
+    }
+    None
+}
+
+fn find_method<'a>(
+    statements: impl Iterator<Item = &'a Statement<'a>>,
+    class_keyword: u32,
+    offset: u32,
+    name: &str,
+) -> Option<&'a Method<'a>> {
+    for statement in statements {
+        let (keyword, members) = match statement {
+            Statement::Namespace(namespace) => {
+                if let Some(method) =
+                    find_method(namespace.statements().iter(), class_keyword, offset, name)
+                {
+                    return Some(method);
+                }
+                continue;
+            }
+            Statement::Class(class) => (class.class.span.start.offset, &class.members),
+            Statement::Interface(interface) => {
+                (interface.interface.span.start.offset, &interface.members)
+            }
+            Statement::Trait(trait_) => (trait_.r#trait.span.start.offset, &trait_.members),
+            Statement::Enum(enum_) => (enum_.r#enum.span.start.offset, &enum_.members),
+            _ => continue,
+        };
+        if keyword != class_keyword {
+            continue;
+        }
+        for member in members.iter() {
+            if let ClassLikeMember::Method(method) = member
+                && method.name.span.start.offset == offset
+                && bytes_to_str(method.name.value).eq_ignore_ascii_case(name)
+            {
+                return Some(method);
+            }
+        }
+    }
+    None
+}
+
+fn portable_hint(
+    hint: &Hint<'_>,
+    lexical: &ClassInfo,
+    context: &FileContext,
+    version: PhpVersion,
+    is_return: bool,
+) -> Option<PhpType> {
+    portable_hint_member(hint, lexical, context, version, is_return, false)
+}
+
+fn portable_hint_member(
+    hint: &Hint<'_>,
+    lexical: &ClassInfo,
+    context: &FileContext,
+    version: PhpVersion,
+    is_return: bool,
+    in_union: bool,
+) -> Option<PhpType> {
+    if is_return && version < PhpVersion::new(7, 0) {
+        return None;
+    }
+    let minimum = match hint {
+        Hint::Nullable(_) | Hint::Void(_) | Hint::Iterable(_) => PhpVersion::new(7, 1),
+        Hint::Union(_) | Hint::Mixed(_) | Hint::Static(_) => PhpVersion::new(8, 0),
+        Hint::Intersection(_) | Hint::Never(_) => PhpVersion::new(8, 1),
+        Hint::Parenthesized(_) | Hint::True(_) => PhpVersion::new(8, 2),
+        Hint::Object(_) => PhpVersion::new(7, 2),
+        Hint::Integer(_) | Hint::Float(_) | Hint::String(_) | Hint::Bool(_) => {
+            PhpVersion::new(7, 0)
+        }
+        Hint::Callable(_) => PhpVersion::new(5, 4),
+        _ => PhpVersion::new(5, 0),
+    };
+    if version < minimum {
+        return None;
+    }
+    if let Hint::Union(union) = hint
+        && version < PhpVersion::new(8, 2)
+        && (hint_has_intersection(union.left)
+            || hint_has_intersection(union.right)
+            || !in_union && !hint_has_non_literal(union.left) && !hint_has_non_literal(union.right))
+    {
+        return None;
+    }
+    match hint {
+        Hint::Identifier(identifier) => {
+            let raw = bytes_to_str(identifier.value());
+            let name = context
+                .resolved_names
+                .as_ref()
+                .and_then(|names| names.get(identifier.span().start.offset))
+                .map(str::to_owned)
+                .unwrap_or_else(|| {
+                    crate::util::resolve_to_fqn(raw, &context.use_map, &context.namespace)
+                });
+            Some(PhpType::named(atom(&name)))
+        }
+        Hint::Self_(_) => Some(PhpType::named(lexical.fqn())),
+        Hint::Parent(_) => Some(PhpType::named(lexical.parent_class?)),
+        Hint::Nullable(nullable) => Some(PhpType::nullable(portable_hint_member(
+            nullable.hint,
+            lexical,
+            context,
+            version,
+            is_return,
+            false,
+        )?)),
+        Hint::Parenthesized(parenthesized) => portable_hint_member(
+            parenthesized.hint,
+            lexical,
+            context,
+            version,
+            is_return,
+            in_union,
+        ),
+        Hint::Union(union) => Some(PhpType::union(vec![
+            portable_hint_member(union.left, lexical, context, version, is_return, true)?,
+            portable_hint_member(union.right, lexical, context, version, is_return, true)?,
+        ])),
+        Hint::Intersection(intersection) => Some(PhpType::intersection(vec![
+            portable_hint(intersection.left, lexical, context, version, is_return)?,
+            portable_hint(intersection.right, lexical, context, version, is_return)?,
+        ])),
+        Hint::False(_) | Hint::Null(_)
+            if version < PhpVersion::new(8, 2)
+                && !(in_union && version >= PhpVersion::new(8, 0)) =>
+        {
+            None
+        }
+        Hint::Void(_) | Hint::Never(_) | Hint::Static(_) if !is_return => None,
+        _ => Some(crate::parser::extract_hint_type(hint)),
+    }
+}
+
+fn portable_default(
+    backend: &Backend,
+    expression: &Expression<'_>,
+    source: &str,
+    context: &FileContext,
+    lexical: &ClassInfo,
+    target: &ClassInfo,
+    target_context: &FileContext,
+) -> Option<String> {
+    let version = backend.php_version();
+    if !expression.is_constant(
+        &mago_php_version::PHPVersion::new(version.major as u32, version.minor as u32, 0),
+        true,
+    ) {
+        return None;
+    }
+    let mut replacements = Vec::new();
+    if !default_names(
+        Node::Expression(expression),
+        backend,
+        context,
+        lexical,
+        target,
+        target_context,
+        &mut replacements,
+    ) {
+        return None;
+    }
+    let span = expression.span();
+    let mut text = source
+        .get(span.start.offset as usize..span.end.offset as usize)?
+        .to_owned();
+    replacements.sort_by_key(|(start, _, _)| *start);
+    for (start, end, value) in replacements.into_iter().rev() {
+        text.replace_range(
+            (start - span.start.offset) as usize..(end - span.start.offset) as usize,
+            &value,
+        );
+    }
+    Some(text)
+}
+
+fn default_names(
+    node: Node<'_, '_>,
+    backend: &Backend,
+    context: &FileContext,
+    lexical: &ClassInfo,
+    target: &ClassInfo,
+    target_context: &FileContext,
+    replacements: &mut Vec<(u32, u32, String)>,
+) -> bool {
+    if let Node::Expression(expression) = node {
+        match expression {
+            Expression::MagicConstant(_) | Expression::CompositeString(_) => return false,
+            Expression::Literal(literal::Literal::String(value))
+                if value.raw.contains(&b'\n') || value.raw.contains(&b'\r') =>
+            {
+                let Some(value_bytes) = value.value else {
+                    return false;
+                };
+                let encoded = value_bytes
+                    .iter()
+                    .map(|byte| format!("\\x{byte:02X}"))
+                    .collect::<String>();
+                replacements.push((
+                    value.span.start.offset,
+                    value.span.end.offset,
+                    format!("\"{encoded}\""),
+                ));
+                return true;
+            }
+            Expression::Identifier(identifier)
+            | Expression::ConstantAccess(access::ConstantAccess { name: identifier }) => {
+                let raw = bytes_to_str(identifier.value());
+                let resolved = context
+                    .resolved_names
+                    .as_ref()
+                    .and_then(|names| names.get(identifier.span().start.offset))
+                    .map(str::to_owned)
+                    .unwrap_or_else(|| {
+                        crate::util::resolve_to_fqn(raw, &context.use_map, &context.namespace)
+                    });
+                let canonical = if backend
+                    .lookup_global_constant_candidates(&[&resolved])
+                    .is_some()
+                {
+                    resolved
+                } else if !raw.contains('\\')
+                    && backend.lookup_global_constant_candidates(&[raw]).is_some()
+                {
+                    raw.to_owned()
+                } else {
+                    return false;
+                };
+                replacements.push((
+                    identifier.span().start.offset,
+                    identifier.span().end.offset,
+                    format!("\\{}", canonical.trim_start_matches('\\')),
+                ));
+                return true;
+            }
+            Expression::Access(access::Access::ClassConstant(access)) => {
+                let Some(name) = default_class(access.class, context, lexical) else {
+                    return false;
+                };
+                if let ClassLikeConstantSelector::Identifier(constant) = &access.constant
+                    && !bytes_to_str(constant.value).eq_ignore_ascii_case("class")
+                {
+                    let loader = canonical_loader(backend, context);
+                    if let Some(owner) = loader(&format!("\\{name}"))
+                        && owner.constants.iter().any(|candidate| {
+                            candidate
+                                .name
+                                .eq_ignore_ascii_case(bytes_to_str(constant.value))
+                                && candidate.visibility == Visibility::Private
+                        })
+                        && owner.fqn() != target.fqn()
+                    {
+                        return false;
+                    }
+                }
+                let display =
+                    display_name(&name, &target_context.use_map, &target_context.namespace);
+                replacements.push((
+                    access.class.span().start.offset,
+                    access.class.span().end.offset,
+                    display,
+                ));
+                return true;
+            }
+            Expression::Instantiation(instantiation) => {
+                let Some(name) = default_class(instantiation.class, context, lexical) else {
+                    return false;
+                };
+                let loader = canonical_loader(backend, context);
+                if let Some(owner) = loader(&format!("\\{name}"))
+                    && owner
+                        .get_method_ci("__construct")
+                        .is_some_and(|constructor| constructor.visibility == Visibility::Private)
+                    && owner.fqn() != target.fqn()
+                {
+                    return false;
+                }
+                let display =
+                    display_name(&name, &target_context.use_map, &target_context.namespace);
+                replacements.push((
+                    instantiation.class.span().start.offset,
+                    instantiation.class.span().end.offset,
+                    display,
+                ));
+                if let Some(arguments) = &instantiation.argument_list {
+                    let mut valid = true;
+                    Node::ArgumentList(arguments).visit_children(|child| {
+                        valid &= default_names(
+                            child,
+                            backend,
+                            context,
+                            lexical,
+                            target,
+                            target_context,
+                            replacements,
+                        )
+                    });
+                    return valid;
+                }
+                return true;
+            }
+            _ => {}
+        }
+    }
+    let mut valid = true;
+    node.visit_children(|child| {
+        valid &= default_names(
+            child,
+            backend,
+            context,
+            lexical,
+            target,
+            target_context,
+            replacements,
+        )
+    });
+    valid
+}
+
+fn default_class(
+    expression: &Expression<'_>,
+    context: &FileContext,
+    lexical: &ClassInfo,
+) -> Option<String> {
+    match expression {
+        Expression::Self_(_) => Some(lexical.fqn().to_string()),
+        Expression::Parent(_) => Some(lexical.parent_class?.to_string()),
+        Expression::Identifier(identifier) => Some(
+            context
+                .resolved_names
+                .as_ref()
+                .and_then(|names| names.get(identifier.span().start.offset))
+                .map(str::to_owned)
+                .unwrap_or_else(|| {
+                    crate::util::resolve_to_fqn(
+                        bytes_to_str(identifier.value()),
+                        &context.use_map,
+                        &context.namespace,
+                    )
+                }),
+        ),
+        _ => None,
+    }
+}
+
+pub(super) fn display_name(
+    name: &str,
+    use_map: &HashMap<String, String>,
+    namespace: &Option<String>,
+) -> String {
+    let name = name.trim_start_matches('\\');
+    let shortened = crate::util::shorten_from_fqn(name, use_map, namespace);
+    if crate::util::resolve_to_fqn(&shortened, use_map, namespace).eq_ignore_ascii_case(name) {
+        shortened
+    } else {
+        format!("\\{name}")
+    }
+}
+
+pub(super) fn render_method(
+    prepared: &PreparedMethod,
+    use_map: &HashMap<String, String>,
+    namespace: &Option<String>,
+    target: &MethodInsertion,
+    delegate: bool,
+    override_attribute: bool,
+) -> String {
+    let method = &prepared.method;
+    let nl = target.newline;
+    let indent = &target.indent;
+    let body_indent = format!("{indent}    ");
+    let visibility = if method.visibility == Visibility::Protected {
+        "protected"
+    } else {
+        "public"
+    };
+    let static_kw = if method.is_static { "static " } else { "" };
+    let reference = if prepared.returns_reference { "&" } else { "" };
+    let params = format_params(method, use_map, namespace);
+    let return_type = format_return_type(method, use_map, namespace);
+    let mut text = String::new();
+    if override_attribute {
+        text.push_str(&format!("{indent}#[\\Override]{nl}"));
+    }
+    text.push_str(&format!("{indent}{visibility} {static_kw}function {reference}{}({params}){return_type}{nl}{indent}{{{nl}", method.name));
+    if delegate {
+        let arguments = method
+            .parameters
+            .iter()
+            .map(|parameter| {
+                format!(
+                    "{}${}",
+                    if parameter.is_variadic { "..." } else { "" },
+                    parameter.name.trim_start_matches('$')
+                )
+            })
+            .collect::<Vec<_>>()
+            .join(", ");
+        let call = format!("parent::{}({arguments})", method.name);
+        if method
+            .native_return_type
+            .as_ref()
+            .is_some_and(|hint| hint.is_void() || hint.to_string() == "never")
+        {
+            text.push_str(&format!("{body_indent}{call};{nl}"));
+            if method
+                .native_return_type
+                .as_ref()
+                .is_some_and(|hint| hint.to_string() == "never")
+            {
+                text.push_str(&format!("{body_indent}throw new \\LogicException('A never-returning parent method returned.');{nl}"));
+            }
+        } else if prepared.returns_reference {
+            let mut local = "parentResult".to_owned();
+            while method
+                .parameters
+                .iter()
+                .any(|parameter| parameter.name.trim_start_matches('$') == local)
+            {
+                local.push('_');
+            }
+            text.push_str(&format!(
+                "{body_indent}${local} = &{call};{nl}{body_indent}return ${local};{nl}"
+            ));
+        } else {
+            text.push_str(&format!("{body_indent}return {call};{nl}"));
+        }
+    } else {
+        text.push_str(&format!(
+            "{body_indent}throw new \\LogicException('Method is not implemented.');{nl}"
+        ));
+    }
+    text.push_str(&format!("{indent}}}{nl}"));
+    text
+}
+
+pub(super) fn insertion_text(target: &MethodInsertion, methods: &str, content: &str) -> String {
+    let nl = target.newline;
+    let leading = if target.offset > 0 && content.as_bytes()[target.offset - 1] == b'\n' {
+        nl.to_owned()
+    } else {
+        format!("{nl}{nl}")
+    };
+    let suffix = if target.offset == target.close as usize {
+        target.class_indent.as_str()
+    } else {
+        ""
+    };
+    format!("{leading}{methods}{suffix}")
+}
+
+fn native_contract_satisfied(
+    generated: &PreparedMethod,
+    contract: &PreparedMethod,
+    loader: &dyn Fn(&str) -> Option<Arc<ClassInfo>>,
+) -> bool {
+    let child = &generated.method;
+    let parent = &contract.method;
+    if child.is_static != parent.is_static
+        || generated.returns_reference != contract.returns_reference
+        || (parent.visibility == Visibility::Public && child.visibility != Visibility::Public)
+    {
+        return false;
+    }
+    let required = |method: &MethodInfo| {
+        method
+            .parameters
+            .iter()
+            .filter(|parameter| !parameter.is_variadic && parameter.default_value.is_none())
+            .count()
+    };
+    let variadic = |method: &MethodInfo| {
+        method
+            .parameters
+            .last()
+            .is_some_and(|parameter| parameter.is_variadic)
+    };
+    if required(child) > required(parent)
+        || (!variadic(child)
+            && (variadic(parent) || child.parameters.len() < parent.parameters.len()))
+    {
+        return false;
+    }
+    let strict_loader = |name: &str| {
+        let name = name
+            .strip_prefix("__fqn__\\")
+            .unwrap_or(name)
+            .trim_start_matches('\\');
+        loader(&format!("\\{name}")).filter(|class| class.fqn().eq_ignore_ascii_case(name))
+    };
+    for (index, parent_parameter) in parent.parameters.iter().enumerate() {
+        let Some(child_parameter) = child.parameters.get(index).or_else(|| {
+            child
+                .parameters
+                .last()
+                .filter(|parameter| parameter.is_variadic)
+        }) else {
+            return false;
+        };
+        if child_parameter.is_reference != parent_parameter.is_reference
+            || child_parameter.name.trim_start_matches('$')
+                != parent_parameter.name.trim_start_matches('$')
+        {
+            return false;
+        }
+        let parent_type = super::implement_methods::native_param_hint(parent_parameter)
+            .unwrap_or_else(PhpType::mixed);
+        let child_type = super::implement_methods::native_param_hint(child_parameter)
+            .unwrap_or_else(PhpType::mixed);
+        if !crate::class_lookup::is_subtype_of_typed(&parent_type, &child_type, &strict_loader) {
+            return false;
+        }
+    }
+    match (&child.native_return_type, &parent.native_return_type) {
+        (_, None) => true,
+        (None, Some(_)) => false,
+        (Some(child), Some(parent)) => {
+            crate::class_lookup::is_subtype_of_typed(child, parent, &strict_loader)
+        }
+    }
+}
+
+fn hint_has_intersection(hint: &Hint<'_>) -> bool {
+    match hint {
+        Hint::Intersection(_) => true,
+        Hint::Union(union) => {
+            hint_has_intersection(union.left) || hint_has_intersection(union.right)
+        }
+        Hint::Parenthesized(inner) => hint_has_intersection(inner.hint),
+        _ => false,
+    }
+}
+
+fn hint_has_non_literal(hint: &Hint<'_>) -> bool {
+    match hint {
+        Hint::False(_) | Hint::True(_) | Hint::Null(_) => false,
+        Hint::Union(union) => hint_has_non_literal(union.left) || hint_has_non_literal(union.right),
+        Hint::Parenthesized(inner) => hint_has_non_literal(inner.hint),
+        _ => true,
+    }
+}
+
+pub(super) fn canonical_loader<'a>(
+    backend: &'a Backend,
+    context: &'a FileContext,
+) -> impl Fn(&str) -> Option<Arc<ClassInfo>> + 'a {
+    let loader = backend.class_loader(context);
+    move |name| {
+        let name = name
+            .strip_prefix("__fqn__\\")
+            .unwrap_or(name)
+            .trim_start_matches('\\');
+        loader(&format!("\\{name}")).filter(|class| class.fqn().eq_ignore_ascii_case(name))
+    }
+}
+
+fn source_newline(content: &str, anchor: usize) -> &'static str {
+    let start = content[..anchor].rfind('\n').map_or(0, |offset| offset + 1);
+    if content[start..]
+        .find('\n')
+        .is_some_and(|offset| offset > 0 && content.as_bytes()[start + offset - 1] == b'\r')
+    {
+        "\r\n"
+    } else {
+        "\n"
+    }
+}

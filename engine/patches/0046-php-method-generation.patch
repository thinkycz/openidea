+#[test]
+fn method_generation_refuses_html_anonymous_and_unclosed_class_contexts() {
+    for source in [
+        "<h1><caret>Child</h1>\n<?php\nclass Base { public function render() {} }\nclass Child extends Base {}\n",
+        "<?php\nclass Base { public function render() {} }\nclass <caret>Child extends Base {\n",
+        "<?php\ninterface Contract { public function required(): void; }\nclass Base { public function render() {} }\nclass Outer extends Base implements Contract { public function make() { return new class extends Base implements Contract { public function other() { <caret>$x = 1; } }; } }\n",
+        "<?php\nclass Base { public function render() {} }\n$value = new class extends Base { // <caret>comment\n};\n",
+        "<?php\nclass Base { public function render() {} }\nclass Child extends Base { public function other() { ?><p><caret>HTML</p><?php } }\n",
+    ] {
+        let (_, found) = actions(source, PhpVersion::new(8, 4));

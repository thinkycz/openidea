+#[test]
+fn method_generation_uses_concrete_grandparent_before_parent_interface_contract() {
+    let result = generated(
+        "<?php\ninterface Contract { public function render(): string; }\nclass Grand { public function render(): string { return 'grand'; } }\nclass ParentClass extends Grand implements Contract {}\nclass <caret>Child extends ParentClass {}\n",
+        "render",

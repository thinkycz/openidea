+    #[tokio::test]
+    async fn method_generation_prepares_pending_parent_change_and_undo_on_first_query() {
+        let backend = Backend::new_test();
+        let directory = tempfile::tempdir().unwrap();
+        let parent_path = directory.path().join("unsaved-parent.php");
+        let child_path = directory.path().join("unsaved-child.php");
+        let parent = Url::from_file_path(&parent_path).unwrap();
+        let child = Url::from_file_path(&child_path).unwrap();
+        let original =
+            "<?php\nclass PendingParent { public function oldMethod(): int { return 1; } }\n";
+        let changed = "<?php\nclass PendingParent { public function newMethod(string $value): string { return $value; } }\n";
+        let consumer = "<?php\nclass PendingChild extends PendingParent {}\n";
+        std::fs::write(&parent_path, original).unwrap();
+        std::fs::write(&child_path, consumer).unwrap();
+        for (uri, source) in [(&parent, original), (&child, consumer)] {
+            let text = Arc::new(source.to_owned());
+            backend.diag.documents.lock().open(uri.as_str(), 1, &text);
+            backend
+                .open_files
+                .write()
+                .insert(uri.to_string(), Arc::clone(&text));
+            assert!(backend.parse_diagnostic_snapshot(uri.as_str(), &text));
+        }
+        assert_eq!(
+            overrides(&backend, &child).await[0].title,
+            "Override oldMethod (PendingParent)"
+        );
+
+        for (version, source, expected, absent) in [
+            (2, changed, "newMethod", "oldMethod"),
+            (3, original, "oldMethod", "newMethod"),
+        ] {
+            let text = Arc::new(source.to_owned());
+            // Model the real did_change boundary after accepting the overlay,
+            // before the background parse runs. No task timing or sleeps.
+            assert!(
+                backend
+                    .diag
+                    .documents
+                    .lock()
+                    .change(parent.as_str(), version, &text)
+            );
+            backend
+                .open_files
+                .write()
+                .insert(parent.to_string(), Arc::clone(&text));
+            let revision = backend
+                .diag
+                .documents
+                .lock()
+                .capture(parent.as_str(), &text)
+                .unwrap();
+            assert!(
+                !backend
+                    .diag
+                    .documents
+                    .lock()
+                    .parsed(parent.as_str(), revision.as_ref())
+            );
+            let actions = overrides(&backend, &child).await;
+            assert_eq!(
+                actions.len(),
+                1,
+                "first query must prepare revision {version}"
+            );
+            assert_eq!(
+                actions[0].title,
+                format!("Override {expected} (PendingParent)")
+            );
+            let inserted = actions[0]
+                .edit
+                .as_ref()
+                .unwrap()
+                .changes
+                .as_ref()
+                .unwrap()
+                .values()
+                .flatten()
+                .map(|edit| edit.new_text.as_str())
+                .collect::<String>();
+            assert!(
+                inserted.contains(&format!("parent::{expected}(")),
+                "{inserted}"
+            );
+            assert!(!inserted.contains(absent), "{inserted}");
+            if version == 2 {
+                assert!(inserted.contains("string $value): string"), "{inserted}");
+            }
+        }
+        assert_eq!(std::fs::read_to_string(parent_path).unwrap(), original);
+        assert_eq!(std::fs::read_to_string(child_path).unwrap(), consumer);
+    }
+}

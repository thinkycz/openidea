+#[test]
+fn method_generation_does_not_follow_imports_for_canonical_parent_names() {
+    let result = generated(
+        "<?php\nnamespace { class Base { public function render(): string { return 'global'; } } }\nnamespace Vendor { class Base { public function wrong(): int { return 1; } } }\nnamespace App {\nuse Vendor\\Base;\nclass <caret>Child extends \\Base {}\n}\n",
+        "render",
+    );
+    assert!(result.contains("return parent::render();"), "{result}");
+    let source = "<?php\nnamespace { abstract class Base { abstract public function render(): string; } }\nnamespace Vendor { abstract class Base { abstract public function wrong(): int; } }\nnamespace App {\nuse Vendor\\Base;\nclass <caret>Child extends \\Base {}\n}\n";
+    let (_, found) = actions(source, PhpVersion::new(8, 4));
+    assert!(find_action(&found, "Implement `render`").is_some());
+    assert!(find_action(&found, "Implement `wrong`").is_none());
+}

+#[tokio::test]
+async fn method_generation_observes_unsaved_inherited_signatures_on_first_query() {
+    use crate::common::{code_actions_via_server, create_psr4_workspace, open_php, workspace_uri};
+    use tower_lsp::LanguageServer;
+    let (backend, _directory) = create_psr4_workspace(
+        r#"{"autoload":{"psr-4":{"App\\":"src/"}}}"#,
+        &[
+            (
+                "src/Base.php",
+                "<?php\nnamespace App;\nclass Base { public function oldMethod(): int { return 1; } }\n",
+            ),
+            (
+                "src/Child.php",
+                "<?php\nnamespace App;\nclass Child extends Base {}\n",
+            ),
+        ],
+    );
+    let parent = workspace_uri(&backend, "src/Base.php");
+    let child = workspace_uri(&backend, "src/Child.php");
+    open_php(
+        &backend,
+        &parent,
+        "<?php\nnamespace App;\nclass Base { public function oldMethod(): int { return 1; } }\n",
+    )
+    .await;
+    open_php(
+        &backend,
+        &child,
+        "<?php\nnamespace App;\nclass Child extends Base {}\n",
+    )
+    .await;
+    let point = Range::new(Position::new(2, 6), Position::new(2, 6));
+    let before = code_actions_via_server(&backend, &child, point)
+        .await
+        .unwrap_or_default();
+    assert!(find_action(&before, "Override oldMethod (").is_some());
+    backend.did_change(DidChangeTextDocumentParams {
+        text_document: VersionedTextDocumentIdentifier { uri: parent, version: 2 },
+        content_changes: vec![TextDocumentContentChangeEvent { range: None, range_length: None,
+            text: "<?php\nnamespace App;\nclass Base { public function newMethod(string $value): string { return $value; } }\n".into() }],
+    }).await;
+    let after = code_actions_via_server(&backend, &child, point)
+        .await
+        .unwrap_or_default();
+    assert!(find_action(&after, "Override oldMethod (").is_none());
+    let action =
+        find_action(&after, "Override newMethod (").expect("first query after unsaved change");
+    let text = action
+        .edit
+        .as_ref()
+        .unwrap()
+        .changes
+        .as_ref()
+        .unwrap()
+        .values()
+        .flatten()
+        .map(|edit| edit.new_text.as_str())
+        .collect::<String>();
+    assert!(text.contains("newMethod(string $value): string"), "{text}");
+}

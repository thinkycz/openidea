+//! Explicit method generation uses actual inherited declarations and safe edits.
+use crate::common::{apply_workspace_edit, create_test_backend, find_action, get_code_actions_at};
+use phpantom_lsp::types::PhpVersion;
+use tower_lsp::lsp_types::*;
+
+fn actions(marked: &str, version: PhpVersion) -> (String, Vec<CodeActionOrCommand>) {
+    let offset = marked.find("<caret>").unwrap();
+    let prefix = &marked[..offset];
+    let line = prefix.bytes().filter(|byte| *byte == b'\n').count() as u32;
+    let column = prefix.rsplit('\n').next().unwrap().encode_utf16().count() as u32;
+    let source = marked.replacen("<caret>", "", 1);
+    let backend = create_test_backend();
+    backend.set_php_version(version);
+    backend.update_ast("file:///methods.php", &source);
+    let actions = get_code_actions_at(&backend, "file:///methods.php", &source, line, column);
+    (source, actions)
+}
+
+fn generated(marked: &str, method: &str) -> String {
+    let (source, actions) = actions(marked, PhpVersion::new(8, 4));
+    let action = find_action(&actions, &format!("Override {method} (")).expect("override action");
+    assert_eq!(
+        action.kind,
+        Some(CodeActionKind::new("refactor.rewrite.overrideMethod"))
+    );
+    assert!(action.command.is_none() && action.data.is_none());
+    let edit = action.edit.as_ref().unwrap();
+    assert_eq!(edit.changes.as_ref().unwrap().len(), 1);
+    let edits = &edit.changes.as_ref().unwrap()[&Url::parse("file:///methods.php").unwrap()];
+    assert_eq!(edits.len(), 1);
+    assert_eq!(edits[0].range.start, edits[0].range.end);
+    apply_workspace_edit(&source, edit)
+}
+
+#[test]
+fn method_generation_delegates_actual_parent_signature() {
+    let result = generated(
+        "<?php\nclass ParentClass { public function render(string $name): string { return $name; } }\nclass <caret>Child extends ParentClass\n{\n}\n",
+        "render",
+    );
+    assert!(
+        result.contains("#[\\Override]\n    public function render(string $name): string"),
+        "{result}"
+    );
+    assert!(result.contains("return parent::render($name);"), "{result}");
+}
+
+#[test]
+fn method_generation_preserves_reference_and_variadic_forwarding() {
+    let result = generated(
+        "<?php\nclass ParentClass { public function &combine(int &$base, string ...$parts): int { return $base; } }\nclass <caret>Child extends ParentClass {}\n",
+        "combine",
+    );
+    assert!(
+        result.contains("function &combine(int &$base, string ...$parts): int"),
+        "{result}"
+    );
+    assert!(
+        result.contains("$parentResult = &parent::combine($base, ...$parts);"),
+        "{result}"
+    );
+    assert!(result.contains("return $parentResult;"), "{result}");
+    assert!(!result.contains("parent::combine(&$base"));
+}
+
+#[test]
+fn method_generation_reference_temporary_does_not_overwrite_a_parameter() {
+    let result = generated(
+        "<?php\nclass ParentClass { public function &copy(&$parentResult) { return $parentResult; } }\nclass <caret>Child extends ParentClass {}\n",
+        "copy",
+    );
+    assert!(
+        result.contains("$parentResult_ = &parent::copy($parentResult);"),
+        "{result}"
+    );
+}
+
+#[test]
+fn method_generation_void_never_and_static_bodies_are_valid() {
+    let source = "<?php\nclass ParentClass { public function stop(): never { throw new \\Exception(); } public function clear(): void {} public static function size(): int { return 1; } }\nclass <caret>Child extends ParentClass {}\n";
+    let stop = generated(source, "stop");
+    assert!(
+        stop.contains("parent::stop();") && !stop.contains("return parent::stop"),
+        "{stop}"
+    );
+    assert!(stop.contains("A never-returning parent method returned."));
+    let clear = generated(source, "clear");
+    assert!(clear.contains("parent::clear();") && !clear.contains("return parent::clear"));
+    let size = generated(source, "size");
+    assert!(
+        size.contains("public static function size(): int")
+            && size.contains("return parent::size();")
+    );
+}

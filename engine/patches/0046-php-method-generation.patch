+#[test]
+fn method_generation_excludes_existing_private_final_magic_and_final_shadowing() {
+    let (_, found) = actions(
+        "<?php\nclass Grand { public function hidden(): int { return 1; } }\nclass ParentClass extends Grand { final public function hidden(): int { return 2; } private function secret() {} public function __clone() {} public function Existing() {} public function allowed() {} }\nclass <caret>Child extends ParentClass { public function existing() {} }\n",
+        PhpVersion::new(8, 4),

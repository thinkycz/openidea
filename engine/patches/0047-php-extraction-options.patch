+fn literal_ranges(body: &str) -> Option<Vec<(usize, usize)>> {
+    let prefix = "<?php function __extraction_body__() {\n";
+    let wrapper = format!("{prefix}{body}\n}}");
+    crate::parser::with_parsed_program(&wrapper, "extraction_literal_layout", |program, _| {
+        if !program.errors.is_empty() {
+            return None;
+        }
+        let mut ranges = Vec::new();
+        for statement in program.statements.iter() {
+            collect_literal_ranges(Node::Statement(statement), prefix.len(), &mut ranges);
+        }
+        ranges.sort_unstable_by_key(|(start, _)| *start);
+        Some(ranges)
+    })
+}
+
+fn collect_literal_ranges(node: Node<'_, '_>, prefix: usize, ranges: &mut Vec<(usize, usize)>) {
+    if let Node::Expression(expression) = node
+        && matches!(
+            expression,
+            Expression::Literal(literal::Literal::String(_)) | Expression::CompositeString(_)
+        )
+    {
+        let span = expression.span();
+        ranges.push((
+            (span.start.offset as usize).saturating_sub(prefix),
+            (span.end.offset as usize).saturating_sub(prefix),
+        ));
+        return;
+    }
+    node.visit_children(|child| collect_literal_ranges(child, prefix, ranges));
+}
+
+fn in_literal(literals: &[(usize, usize)], offset: usize, include_start: bool) -> bool {
+    let index = literals.partition_point(|(start, _)| {
+        if include_start {
+            *start <= offset
+        } else {
+            *start < offset
+        }
+    });
+    index
+        .checked_sub(1)
+        .and_then(|index| literals.get(index))
+        .is_some_and(|(_, end)| offset < *end)
+}
+
+fn append_body(
+    out: &mut String,
+    body: &str,
+    indent: &str,
+    newline: &str,
+    literals: &[(usize, usize)],
+) {
+    let protected_start = |offset: usize| in_literal(literals, offset, false);
+    let mut offset = 0;
+    let mut min_indent = None;
+    for piece in body.split_inclusive('\n') {
+        let without_lf = piece.strip_suffix('\n').unwrap_or(piece);
+        let line = without_lf.strip_suffix('\r').unwrap_or(without_lf);
+        if !protected_start(offset) && !line.trim().is_empty() {
+            let width = line.len() - line.trim_start_matches([' ', '\t']).len();
+            min_indent = Some(min_indent.map_or(width, |current: usize| current.min(width)));
+        }
+        offset += piece.len();
+    }
+    let min_indent = min_indent.unwrap_or(0);
+    offset = 0;
+    for piece in body.split_inclusive('\n') {
+        let without_lf = piece.strip_suffix('\n').unwrap_or(piece);
+        let line = without_lf.strip_suffix('\r').unwrap_or(without_lf);
+        if protected_start(offset) {
+            out.push_str(line);
+        } else if !line.trim().is_empty() {
+            out.push_str(indent);
+            out.push_str(&line[min_indent.min(line.len())..]);
+        }
+        let break_start = offset + line.len();
+        if piece.len() > line.len() && in_literal(literals, break_start, true) {
+            out.push_str(&piece[line.len()..]);
+        } else {
+            out.push_str(newline);
+        }
+        offset += piece.len();
+    }
+}

+        refused(CONSTANT, "'hello'", "refactor.extractConstant", json!(name));
+    }
+}
+
+#[test]
+fn requested_extraction_name_limit_is_utf8_bytes_not_character_count() {
+    refused(
+        VARIABLE,
+        "1 + 2",
+        "refactor.extractVariable",
+        json!("a".repeat(257)),
+    );
+    refused(
+        CONSTANT,

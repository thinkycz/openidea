+/// The shared inheritance merge supplies class/trait constants. Interface
+/// constants are checked through the same resolved class graph, including
+/// interfaces inherited through a parent, without performing type inference.
+fn interface_constant_collision(
+    class: &crate::types::ClassInfo,
+    name: &str,
+    loader: &dyn Fn(&str) -> Option<std::sync::Arc<crate::types::ClassInfo>>,
+    visited: &mut std::collections::HashSet<String>,
+) -> bool {
+    let fqn = class.fqn();
+    if !visited.insert(fqn.to_ascii_lowercase()) {
+        return false;
+    }
+    for interface in &class.interfaces {
+        if let Some(interface) = crate::class_lookup::load_ancestor(&fqn, interface, loader)
+            && (interface
+                .constants
+                .iter()
+                .any(|constant| constant.name == name)
+                || interface_constant_collision(&interface, name, loader, visited))
+        {
+            return true;
+        }
+    }
+    class
+        .parent_class
+        .as_ref()
+        .and_then(|parent| crate::class_lookup::load_ancestor(&fqn, parent, loader))
+        .is_some_and(|parent| interface_constant_collision(&parent, name, loader, visited))
 }
 

+        refused(VARIABLE, "1 + 2", "refactor.extractVariable", json!(name));
+    }
+}
+
+#[test]
+fn requested_extraction_variable_names_can_use_keywords_and_distinct_case() {
+    let (_, result) = accepted(VARIABLE, "1 + 2", "refactor.extractVariable", "class");
+    assert!(result.contains("$class = 1 + 2;"));

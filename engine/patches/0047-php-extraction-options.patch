+//! Requested expression-extraction names are validated before any edit is proposed.
+use crate::common::{
+    apply_workspace_edit, create_test_backend, extract_edits, get_code_actions_in_range,
+    position_after, position_of,
+};
+use serde_json::{Value, json};
+use std::sync::Arc;
+use tower_lsp::lsp_types::{CodeAction, CodeActionOrCommand, Range};
+
+fn resolve(content: &str, selected: &str, kind: &str, requested: Option<Value>) -> CodeAction {
+    let backend = create_test_backend();
+    let uri = "file:///requested-expression.php";
+    backend.update_ast(uri, content);
+    backend
+        .open_files()
+        .write()
+        .insert(uri.into(), Arc::new(content.into()));
+    let actions = get_code_actions_in_range(
+        &backend,
+        uri,
+        content,
+        Range::new(
+            position_of(content, selected),
+            position_after(content, selected),
+        ),
+    );
+    let mut action = actions
+        .into_iter()
+        .find_map(|action| match action {
+            CodeActionOrCommand::CodeAction(action)
+                if action
+                    .data
+                    .as_ref()
+                    .and_then(|data| data.get("action_kind"))
+                    .and_then(Value::as_str)
+                    == Some(kind) =>
+            {
+                Some(action)
+            }
+            _ => None,
+        })
+        .unwrap_or_else(|| panic!("missing fixture action {kind}: {content}"));
+    if let Some(requested) = requested {
+        action.data.as_mut().unwrap().get_mut("extra").unwrap()["requested_name"] = requested;
+    }
+    backend.resolve_code_action(action).0
+}
+
+fn accepted(content: &str, selected: &str, kind: &str, name: &str) -> (CodeAction, String) {
+    let action = resolve(content, selected, kind, Some(json!(name)));
+    assert!(
+        action.disabled.is_none(),
+        "requested name {name} unexpectedly refused: {:?}",
+        action.disabled
+    );
+    let result = apply_workspace_edit(
+        content,
+        action
+            .edit
+            .as_ref()
+            .expect("custom name must produce an edit"),
+    );
+    (action, result)
+}
+
+fn refused(content: &str, selected: &str, kind: &str, name: Value) {
+    let action = resolve(content, selected, kind, Some(name.clone()));
+    assert!(
+        action.edit.is_none(),
+        "invalid/colliding name {name} must not propose edits"
+    );
+    assert!(
+        action
+            .disabled
+            .as_ref()
+            .is_some_and(|disabled| !disabled.reason.trim().is_empty()),
+        "refusal for {name} must explain why the action is unavailable"
+    );
+}
+
+const VARIABLE: &str = "<?php\nfunction calculate()\n{\n    return 1 + 2;\n}\n";
+const VARIABLE_ALL: &str =
+    "<?php\nfunction calculate()\n{\n    echo 1 + 2;\n    return 1 + 2;\n}\n";
+const CONSTANT: &str = "<?php\nclass Example\n{\n    public function run(): string\n    {\n        return 'hello';\n    }\n}\n";
+const CONSTANT_ALL: &str = "<?php\nclass Example\n{\n    public function run(): string\n    {\n        echo 'hello';\n        return 'hello';\n    }\n}\n";
+
+#[test]
+fn requested_extraction_variable_single_uses_exact_custom_name() {
+    let (_, result) = accepted(VARIABLE, "1 + 2", "refactor.extractVariable", "total");
+    assert!(result.contains("$total = 1 + 2;"));
+    assert!(result.contains("return $total;"));
+    assert!(!result.contains("$variable"));
+}
+
+#[test]
+fn requested_extraction_variable_all_uses_one_custom_declaration_and_every_replacement() {
+    let (_, result) = accepted(
+        VARIABLE_ALL,
+        "1 + 2",
+        "refactor.extractVariableAll",
+        "total",
+    );
+    assert_eq!(result.matches("$total = 1 + 2;").count(), 1);
+    assert_eq!(result.matches("$total").count(), 3);
+    assert!(result.contains("echo $total;") && result.contains("return $total;"));
+}
+
+#[test]
+fn requested_extraction_constant_single_uses_exact_custom_name() {
+    let (_, result) = accepted(CONSTANT, "'hello'", "refactor.extractConstant", "GREETING");
+    assert!(result.contains("GREETING = 'hello';"));
+    assert!(result.contains("return self::GREETING;"));
+    assert!(!result.contains("const string HELLO") && !result.contains("const HELLO"));
+}
+
+#[test]
+fn requested_extraction_constant_all_uses_one_custom_declaration_and_every_replacement() {
+    let (_, result) = accepted(
+        CONSTANT_ALL,
+        "'hello'",
+        "refactor.extractConstantAll",
+        "GREETING",
+    );
+    assert_eq!(result.matches("GREETING = 'hello';").count(), 1);
+    assert_eq!(result.matches("self::GREETING").count(), 2);
+    assert!(result.contains("echo self::GREETING;") && result.contains("return self::GREETING;"));
+}
+
+#[test]
+fn requested_extraction_omitted_name_retains_variable_and_constant_auto_names() {
+    let variable = resolve(VARIABLE, "1 + 2", "refactor.extractVariable", None);
+    let result = apply_workspace_edit(VARIABLE, variable.edit.as_ref().unwrap());
+    assert!(result.contains("$variable = 1 + 2;") && result.contains("return $variable;"));
+    let constant = resolve(CONSTANT, "'hello'", "refactor.extractConstant", None);
+    let result = apply_workspace_edit(CONSTANT, constant.edit.as_ref().unwrap());
+    assert!(result.contains("HELLO = 'hello';") && result.contains("return self::HELLO;"));
+}
+
+#[test]
+fn requested_extraction_invalid_json_types_never_fall_back_to_auto_names() {
+    for name in [
+        Value::Null,
+        json!(true),
+        json!(42),
+        json!([]),
+        json!({"name":"total"}),
+    ] {
+        refused(VARIABLE, "1 + 2", "refactor.extractVariable", name.clone());
+        refused(CONSTANT, "'hello'", "refactor.extractConstant", name);
+    }
+}
+
+#[test]
+fn requested_extraction_invalid_identifiers_and_injection_never_produce_edits() {
+    for name in [
+        "",

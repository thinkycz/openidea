diff --git a/src/code_actions/requested_name.rs b/src/code_actions/requested_name.rs
new file mode 100644
--- /dev/null
+++ b/src/code_actions/requested_name.rs
@@ -0,0 +1,27 @@
+//! Syntax shared by explicit extraction names; scope and declaration rules stay
+//! with the individual planners.
+
+pub(super) fn requested_name(extra: &serde_json::Value) -> Result<Option<&str>, &'static str> {
+    let Some(value) = extra.get("requested_name") else {
+        return Ok(None);
+    };
+    let Some(name) = value.as_str() else {
+        return Err("Use a PHP identifier for the extracted name.");
+    };
+    if name.is_empty() {
+        return Err("Enter a name for the extracted declaration.");
+    }
+    if name.len() > 256 {
+        return Err("Use at most 256 UTF-8 bytes for the extracted name.");
+    }
+    let mut chars = name.chars();
+    let start = chars.next().unwrap();
+    let first = start == '_' || start.is_ascii_alphabetic() || !start.is_ascii();
+    let rest = chars.all(|ch| ch == '_' || ch.is_ascii_alphanumeric() || !ch.is_ascii());
+    if !first || !rest {
+        return Err(
+            "Use one PHP identifier without a dollar sign, spaces, or namespace separators.",
+        );
+    }
+    Ok(Some(name))
+}

+        let output = extract(FUNCTION, Some(json!(name)));
+        assert!(
+            output.contains(&format!("function {name}(")),
+            "legal function {name} refused: {output}"
+        );
+        let call = if name == "readonly" {
+            "namespace\\readonly"
+        } else {
+            name
+        };
+        assert!(
+            output.contains(&format!("$result = {call}($value);")),
+            "{output}"
+        );
+    }
+    for name in [
+        "class",
+        "list",
+        "die",
+        "exit",
+        "callable",
+        "static",
+        "__CLASS__",
+        "__FUNCTION__",
+        "__halt_compiler",
+    ] {
+        refuse(FUNCTION, json!(name));
+    }
+}
+
+#[test]
+fn requested_extraction_autoload_function_restriction_is_namespace_and_target_aware() {
+    refuse(FUNCTION, json!("__autoload"));
+    let namespaced = FUNCTION.replacen("<?php\n", "<?php\nnamespace App;\n", 1);
+    let output = extract(&namespaced, Some(json!("__autoload")));
+    assert!(output.contains("function __autoload("));
+    assert!(output.contains("$result = __autoload($value);"));
+    let (source, action) = resolved(FUNCTION, Some(json!("__autoload")), PhpVersion::new(7, 4));
+    let output = apply_workspace_edit(
+        &source,
+        action
+            .edit
+            .as_ref()
+            .expect("global __autoload is supported before PHP8"),
+    );
+    assert!(output.contains("function __autoload("));
+}
+
+#[test]
+fn requested_extraction_magic_constant_function_names_follow_introduction_version() {
+    let (source, action) = resolved(FUNCTION, Some(json!("__PROPERTY__")), PhpVersion::new(8, 3));
+    assert!(
+        apply_workspace_edit(
+            &source,
+            action
+                .edit
+                .as_ref()
+                .expect("not a magic constant before PHP8.4")
+        )
+        .contains("function __PROPERTY__(")
+    );
+    refuse(FUNCTION, json!("__PROPERTY__"));
+}
+
+#[test]
+fn requested_extraction_readonly_function_calls_are_explicitly_namespace_relative() {
+    for marked in [
+        FUNCTION.to_owned(),
+        FUNCTION.replacen("<?php\n", "<?php\nnamespace App;\n", 1),
+    ] {
+        let output = extract(&marked, Some(json!("readonly")));
+        assert!(
+            output.contains("function readonly("),
+            "declaration name changed: {output}"
+        );
+        assert!(
+            output.contains("$result = namespace\\readonly($value);"),
+            "readonly call may bypass its declaration: {output}"
+        );
+        assert!(!output.contains("$result = readonly($value);"));
+    }
+    let method = extract(METHOD, Some(json!("readonly")));
+    assert!(method.contains("$this->readonly()"));
+    assert!(!method.contains("namespace\\readonly"));
+}
diff --git a/tests/integration/code_action_requested_expression_names.rs b/tests/integration/code_action_requested_expression_names.rs

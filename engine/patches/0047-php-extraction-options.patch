+++ b/src/code_actions/extract_function/requested.rs
@@ -0,0 +1,221 @@
+use super::*;
+use crate::types::PhpVersion;
+
+/// Admit an explicit name in its declaration context, without suffixing it.
+pub(super) fn requested_callable_name(
+    backend: &Backend,
+    content: &str,
+    uri: &str,
+    offset: u32,
+    enclosing: &EnclosingContext,
+    name: &str,
+) -> bool {
+    if !keyword_allowed(name, enclosing.target, backend.php_version()) {
+        return false;
+    }
+    let context = backend.file_context_at(uri, offset);
+    match enclosing.target {
+        ExtractionTarget::Method => {
+            // Refuse actual magic contracts, while preserving legal ordinary
+            // double-underscore names and magic-constant-token method names.
+            if magic_method(name) {
+                return false;
+            }
+            let Some(class) = find_class_at_offset(&context.classes, offset) else {
+                return false;
+            };
+            let loader = crate::code_actions::override_methods::canonical_loader(backend, &context);
+            let resolved = crate::inheritance::resolve_class_with_inheritance(class, &loader);
+            if resolved.get_method_ci(name).is_some() {
+                return false;
+            }
+            // Interfaces and unresolved ancestry must also be considered: a
+            // private extracted helper cannot satisfy an existing public contract.
+            let mut pending = class
+                .parent_class
+                .iter()
+                .chain(&class.interfaces)
+                .chain(&class.used_traits)
+                .copied()
+                .collect::<Vec<_>>();
+            let mut seen = std::collections::HashSet::new();
+            while let Some(ancestor) = pending.pop() {
+                if !seen.insert(ancestor) {
+                    continue;
+                }
+                if seen.len() > 1000 {
+                    return false;
+                }
+                let Some(owner) = loader(ancestor.as_str()) else {
+                    return false;
+                };
+                if owner.get_method_ci(name).is_some() {
+                    return false;
+                }
+                pending.extend(
+                    owner
+                        .parent_class
+                        .iter()
+                        .chain(&owner.interfaces)
+                        .chain(&owner.used_traits)
+                        .copied(),
+                );
+            }
+            true
+        }
+        ExtractionTarget::Function => {
+            if name.eq_ignore_ascii_case("__autoload")
+                && backend.php_version() >= PhpVersion::new(8, 0)
+                && context
+                    .namespace
+                    .as_ref()
+                    .is_none_or(|namespace| namespace.is_empty())
+            {
+                return false;
+            }
+            if imported_function_collision(content, offset, name) {
+                return false;
+            }
+            let qualified = context
+                .namespace
+                .as_ref()
+                .filter(|namespace| !namespace.is_empty())
+                .map_or_else(
+                    || name.to_owned(),
+                    |namespace| format!("{namespace}\\{name}"),
+                );
+            // A new namespaced declaration also wins over an existing global
+            // fallback. Refuse that shadowing rather than changing old calls
+            // (or making an extracted call to the builtin recurse).
+            if name.eq_ignore_ascii_case("__autoload")
+                && backend.php_version() >= PhpVersion::new(8, 0)
+            {
+                // The removed global autoloader is not a visible fallback on
+                // PHP8; a namespaced ordinary function of this name is legal.
+                backend.find_or_load_function(&[&qualified]).is_none()
+            } else {
+                backend.find_or_load_function(&[&qualified, name]).is_none()
+            }
+        }
+    }
+}
+
+fn magic_method(name: &str) -> bool {
+    matches!(
+        name.to_ascii_lowercase().as_str(),
+        "__construct"
+            | "__destruct"
+            | "__call"
+            | "__callstatic"
+            | "__get"
+            | "__set"
+            | "__isset"
+            | "__unset"
+            | "__sleep"
+            | "__wakeup"
+            | "__serialize"
+            | "__unserialize"
+            | "__tostring"
+            | "__invoke"
+            | "__set_state"
+            | "__clone"
+            | "__debuginfo"
+    )
+}
+
+fn keyword_allowed(name: &str, target: ExtractionTarget, version: PhpVersion) -> bool {
+    let lower = name.to_ascii_lowercase();
+    if target == ExtractionTarget::Method && version >= PhpVersion::new(7, 0) {
+        return lower != "__halt_compiler";
+    }
+    // Contextual names are legal function identifiers, even though the lexer
+    // recognizes them as keywords or literal tokens in other contexts.
+    if matches!(
+        lower.as_str(),
+        "enum" | "readonly" | "from" | "true" | "false" | "null" | "self" | "parent"
+    ) {
+        return true;
+    }
+    // The parser uses the latest grammar. These names were ordinary function
+    // identifiers before their token was introduced in the project target.
+    let introduced = match lower.as_str() {
+        "__property__" => Some(PhpVersion::new(8, 4)),
+        "match" => Some(PhpVersion::new(8, 0)),
+        "fn" => Some(PhpVersion::new(7, 4)),
+        "yield" | "finally" => Some(PhpVersion::new(5, 5)),
+        "trait" | "insteadof" | "callable" | "__trait__" => Some(PhpVersion::new(5, 4)),
+        "namespace" | "goto" | "__dir__" | "__namespace__" => Some(PhpVersion::new(5, 3)),
+        _ => None,
+    };
+    if let Some(introduced) = introduced {
+        return version < introduced;
+    }
+    // The expression grammar permits list as a soft identifier, but PHP
+    // forbids it as a function declaration in every supported target.
+    if lower == "list" {
+        return false;
+    }
+    // Declaration parsing deliberately accepts reserved local identifiers for
+    // both methods and functions. Inspect the expression grammar instead:
+    // ordinary names remain Identifier; magic constants, language constructs
+    // and statements do not. This avoids accepting `function class(...)` merely
+    // because the permissive declaration parser reports no error.
+    let wrapper = format!("<?php {name};");
+    crate::parser::with_parsed_program(&wrapper, "requested_callable_keyword", |program, _| {
+        if !program.errors.is_empty() {
+            return false;
+        }
+        let mut statements = program
+            .statements
+            .iter()
+            .filter(|statement| !matches!(statement, Statement::OpeningTag(_)));
+        matches!(statements.next(), Some(Statement::Expression(statement))
+            if matches!(statement.expression, Expression::Identifier(_) | Expression::ConstantAccess(_)))
+            && statements.next().is_none()
+    })
+}
+
+fn imported_function_collision(content: &str, offset: u32, name: &str) -> bool {
+    crate::parser::with_parsed_program(content, "requested_function_import", |program, _| {
+        let namespace = program
+            .statements
+            .iter()
+            .find_map(|statement| match statement {
+                Statement::Namespace(namespace)
+                    if offset >= namespace.span().start.offset
+                        && offset <= namespace.span().end.offset =>
+                {
+                    Some(namespace)
+                }
+                _ => None,
+            });
+        let statements = namespace.map_or(&program.statements, |namespace| namespace.statements());
+        let collides = |item: &UseItem<'_>| {
+            let imported = bytes_to_str(item.name.value());
+            let alias = item
+                .alias
+                .as_ref()
+                .map(|alias| bytes_to_str(alias.identifier.value))
+                .unwrap_or_else(|| imported.rsplit('\\').next().unwrap_or(imported));
+            alias.eq_ignore_ascii_case(name)
+        };
+        statements.iter().any(|statement| {
+            let Statement::Use(statement) = statement else {
+                return false;
+            };
+            match &statement.items {
+                UseItems::TypedSequence(sequence) if sequence.r#type.is_function() => {
+                    sequence.items.iter().any(&collides)
+                }
+                UseItems::TypedList(list) if list.r#type.is_function() => {
+                    list.items.iter().any(&collides)
+                }
+                UseItems::MixedList(list) => list.items.iter().any(|item| {
+                    item.r#type.as_ref().is_some_and(|kind| kind.is_function())
+                        && collides(&item.item)
+                }),
+                _ => false,
+            }
+        })
+    })
+}

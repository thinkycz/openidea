+            "textDocument":{"uri":MAIN}, "range":selection,
+            "context":{"diagnostics":[],"only":["refactor.extract"]}
+        }))
+        .unwrap();
+        let offered = LanguageServer::code_action(&backend, params)
+            .await
+            .unwrap()
+            .unwrap();
+        let action = offered
+            .into_iter()
+            .find_map(|action| match action {
+                CodeActionOrCommand::CodeAction(action)
+                    if action
+                        .data
+                        .as_ref()
+                        .and_then(|data| data.get("action_kind"))
+                        .and_then(|kind| kind.as_str())
+                        == Some("refactor.extractFunction") =>
+                {
+                    Some(action)
+                }
+                _ => None,
+            })
+            .expect("complete statement extraction must be offered");
+        let text = |action: &CodeAction| {
+            action
+                .edit
+                .as_ref()
+                .expect("resolved extraction edit")
+                .changes
+                .as_ref()
+                .expect("source changes")
+                .values()
+                .flatten()
+                .map(|edit| edit.new_text.as_str())
+                .collect::<String>()
+        };
+        let before = LanguageServer::code_action_resolve(&backend, action.clone())
+            .await
+            .unwrap();
+        assert!(
+            text(&before).contains("): int"),
+            "baseline must infer int: {}",
+            text(&before)
+        );
+        pending(&backend, DEP, new);
+        let after = LanguageServer::code_action_resolve(&backend, action.clone())
+            .await
+            .unwrap();
+        assert!(
+            text(&after).contains("): string"),
+            "resolve must prepare the accepted pending dependency: {}",
+            text(&after)
+        );
+        let original = Arc::new(old.to_owned());
+        assert!(backend.diag.documents.lock().change(DEP, 3, &original));
+        backend.open_files.write().insert(DEP.to_owned(), original);
+        let undo = LanguageServer::code_action_resolve(&backend, action)
+            .await
+            .unwrap();
+        assert!(
+            text(&undo).contains("): int"),
+            "resolve after Undo must use restored signature: {}",
+            text(&undo)
+        );
+    }
 }

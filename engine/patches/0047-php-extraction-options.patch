+    let constant = "<?php\r\nclass Example\r\n{\r\n    public function run()\r\n    {\r\n        return 'a\nb';\r\n    }\r\n}\r\n";
+    let (action, result) = accepted(constant, "'a\nb'", "refactor.extractConstant", "TEXT");

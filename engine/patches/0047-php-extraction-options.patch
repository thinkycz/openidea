+//! Requested extraction names must be semantic inputs, never edit-text rewrites.
+use crate::common::{apply_workspace_edit, create_test_backend, get_code_actions_in_range};
+use phpantom_lsp::{Backend, types::PhpVersion};
+use serde_json::{Value, json};
+use std::sync::Arc;
+use tower_lsp::lsp_types::*;
+
+const URI: &str = "file:///requested-callable.php";
+
+fn position(source: &str, offset: usize) -> Position {
+    let prefix = &source[..offset];
+    Position::new(
+        prefix.bytes().filter(|byte| *byte == b'\n').count() as u32,
+        prefix.rsplit('\n').next().unwrap().encode_utf16().count() as u32,
+    )
+}
+
+fn proposal(
+    marked: &str,
+    requested: Option<Value>,
+    version: PhpVersion,
+) -> (Backend, String, CodeAction) {
+    let start = marked.find("<start>").unwrap();
+    let end = marked.find("<end>").unwrap() - "<start>".len();
+    let source = marked.replace("<start>", "").replace("<end>", "");
+    let backend = create_test_backend();
+    backend.set_php_version(version);
+    backend
+        .open_files()
+        .write()
+        .insert(URI.into(), Arc::new(source.clone()));
+    backend.update_ast(URI, &source);
+    let actions = get_code_actions_in_range(
+        &backend,
+        URI,
+        &source,
+        Range::new(position(&source, start), position(&source, end)),
+    );
+    let mut action = actions
+        .into_iter()
+        .find_map(|item| match item {
+            CodeActionOrCommand::CodeAction(action)
+                if action
+                    .data
+                    .as_ref()
+                    .and_then(|data| data.get("action_kind"))
+                    .and_then(Value::as_str)
+                    == Some("refactor.extractFunction") =>
+            {
+                Some(action)
+            }
+            _ => None,
+        })
+        .expect("callable extraction candidate");
+    if let Some(name) = requested {
+        action.data.as_mut().unwrap()["extra"]["requested_name"] = name;
+    }
+    (backend, source, action)
+}
+
+fn resolved(marked: &str, requested: Option<Value>, version: PhpVersion) -> (String, CodeAction) {
+    let (backend, source, action) = proposal(marked, requested, version);
+    (source, backend.resolve_code_action(action).0)
+}
+
+fn extract(marked: &str, requested: Option<Value>) -> String {
+    let (source, action) = resolved(marked, requested, PhpVersion::new(8, 4));
+    apply_workspace_edit(
+        &source,
+        action.edit.as_ref().expect("named extraction edit"),
+    )
+}
+
+fn refuse(marked: &str, requested: Value) {
+    let (_, action) = resolved(marked, Some(requested), PhpVersion::new(8, 4));
+    assert!(
+        action.edit.is_none(),
+        "unsafe name must not fall back to automatic extraction: {action:?}"
+    );
+}
+
+const FUNCTION: &str = "<?php\nfunction run(int $value): int {\n    <start>$result = $value + 1;<end>\n    return $result;\n}\n";
+const METHOD: &str = "<?php\nclass Worker {\n    public int $value = 3;\n    public function run(): int {\n        <start>$result = $this->value + 1;<end>\n        return $result;\n    }\n}\n";
+
+#[test]
+fn requested_extraction_function_name_controls_declaration_and_call() {
+    let output = extract(FUNCTION, Some(json!("calculate")));
+    assert!(output.contains("function calculate("), "{output}");
+    assert!(output.contains("$result = calculate($value);"), "{output}");
+    assert!(!output.contains("function computeResult("), "{output}");
+}
+
+#[test]
+fn requested_extraction_instance_method_name_controls_declaration_and_call() {
+    let output = extract(METHOD, Some(json!("calculate")));
+    assert!(output.contains("private function calculate("), "{output}");
+    assert!(output.contains("$result = $this->calculate();"), "{output}");
+}
+
+#[test]
+fn requested_extraction_static_method_name_preserves_static_target() {
+    let marked = "<?php\nclass Worker {\n    public const VALUE = 3;\n    public static function run(): int {\n        <start>$result = self::VALUE + 1;<end>\n        return $result;\n    }\n}\n";
+    let output = extract(marked, Some(json!("calculate")));
+    assert!(
+        output.contains("private static function calculate("),
+        "{output}"
+    );
+    assert!(output.contains("$result = self::calculate();"), "{output}");
+}

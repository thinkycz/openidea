+}
+
+#[test]
+fn requested_extraction_special_variables_are_not_writable_extraction_targets() {
+    for name in [
+        "this", "GLOBALS", "_SERVER", "_GET", "_POST", "_FILES", "_COOKIE", "_SESSION", "_REQUEST",
+        "_ENV",

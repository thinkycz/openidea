+#[tokio::test]
+async fn signature_utf16_unicode_native_class_type_does_not_shift_ascii_parameters() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///signature_utf16_class.php").unwrap();
+    let call = "carry(new Žluťoučký🐘(), ";
+    let text = format!(
+        "<?php\nclass Žluťoučký🐘 {{}}\nfunction carry(Žluťoučký🐘 $first, int $second): Žluťoučký🐘 {{ return $first; }}\n{call}"
+    );
+    let help = sig_help_at(&backend, &uri, &text, 3, call.encode_utf16().count() as u32)
+        .await
+        .unwrap();
+    assert_eq!(active_param(&help), 1);
+    assert_eq!(
+        param_labels(&help),
+        vec!["Žluťoučký🐘 $first", "int $second"]
+    );
+    assert_eq!(
+        sig_label(&help),
+        "(Žluťoučký🐘 $first, int $second): Žluťoučký🐘"

+#[tokio::test]
+async fn signature_utf16_non_bmp_parameter_names_decode_exactly() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///signature_utf16_non_bmp.php").unwrap();
+    let call = "blend(🐘: 'first', druhý: ";
+    let text = format!(
+        "<?php\nfunction blend(string $🐘, string $druhý): string {{ return $🐘.$druhý; }}\n{call}"
+    );
+    let help = sig_help_at(&backend, &uri, &text, 2, call.encode_utf16().count() as u32)
+        .await
+        .unwrap();
+    assert_eq!(active_param(&help), 1);
+    assert_eq!(param_labels(&help), vec!["string $🐘", "string $druhý"]);
+    assert_eq!(sig_label(&help), "(string $🐘, string $druhý): string");
+}

+// ── Unicode Parameter Labels ────────────────────────────────────────────────
+
+class UnicodeSignatureHelpDemo
+{
+    /**
+     * @param string $první First label segment.
+     * @param string $druhý Second label segment.
+     */
+    public function label(string $první, string $druhý = '🐘'): string
+    {
+        return $první . $druhý;
+    }
+
+    public function demo(): void
+    {
+        // Try: trigger parameter hints in either argument. The highlight stays
+        // on the whole parameter, including Unicode names and default values.
+        $this->label('A', 'B');
+        // Named arguments highlight their declaration position, not call order.
+        $this->label(druhý: 'B', první: 'A');
+    }
+}

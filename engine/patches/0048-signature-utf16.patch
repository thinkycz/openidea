+#[tokio::test]
+async fn signature_utf16_unicode_parameter_labels_preserve_documentation_and_named_active() {
+    let declaration = concat!(
+        "<?php\n",
+        "/**\n",
+        " * @param string $první First Unicode label segment.\n",
+        " * @param string $druhý Second Unicode label segment.\n",
+        " */\n",
+        "function label(string $první, string $druhý): string { return $první.$druhý; }\n",
+    );
+    for (index, call, expected_active) in [
+        (0, "label('A', ", 1),
+        (1, "label(druhý: ", 1),
+        (2, "label(druhý: 'B', první: ", 0),
+    ] {
+        let backend = create_test_backend();
+        let uri = Url::parse(&format!("file:///signature_utf16_unicode_{index}.php")).unwrap();
+        let text = format!("{declaration}{call}");
+        let help = sig_help_at(&backend, &uri, &text, 6, call.encode_utf16().count() as u32)
+            .await
+            .unwrap();
+        assert_eq!(active_param(&help), expected_active);
+        assert_eq!(sig_label(&help), "(string $první, string $druhý): string");
+        assert_eq!(param_labels(&help), vec!["string $první", "string $druhý"]);
+        assert_eq!(
+            param_docs(&help),
+            vec![
+                Some("First Unicode label segment.".into()),
+                Some("Second Unicode label segment.".into())
+            ]
+        );
+    }
+}

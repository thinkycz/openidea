+    assert_eq!(help.active_signature, Some(2));
+    let labels = overload_parameter_labels(&help);
+    assert!(labels[1][2].contains("$end"), "{labels:?}");
+    assert!(labels[2][0].contains("$start"), "{labels:?}");
+    assert!(labels[2][1].contains("$interval"), "{labels:?}");
+    for call in [
+        "new \\DatePeriod(isostr: <caret>);",
+        "new \\DatePeriod(recurrences: <caret>);",
+    ] {
+        assert!(
+            overload_help(&backend, "native_period_invalid", call)
+                .await
+                .is_none()
+        );
+    }
+}
+
+#[test]
+fn signature_overload_comment_commas_preserve_whole_argument_roles() {
+    for call in [
+        "commentfit(/* note, extra */ count: 1, label: 'x');",
+        "commentfit(count /* note, extra */: 1, label: 'x');",
+        "commentfit(count: 1 /* note, extra */, label: 'x');",
+    ] {
+        let backend = overload_backend(
+            "commentfit",
+            r#"<?php
+function commentfit(int $label, string $count): int {}
+function commentfit(string $label, int $count): string {}
+"#,
+        );
+        let diagnostics = crate::common::collect_diagnostics_with(
+            &backend,
+            &format!("<?php declare(strict_types=1); {call}"),
+            phpantom_lsp::Backend::collect_argument_type_diagnostics,
+        );
+        assert!(
+            crate::common::messages_with_code(&diagnostics, "type_mismatch_argument").is_empty(),
+            "comment commas must not split argument roles: {call}: {diagnostics:?}"
+        );
+    }
+}

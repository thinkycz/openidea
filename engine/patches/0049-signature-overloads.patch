+#[test]
+fn overload_signature_changes_invalidate_at_constant_variant_count() {
+    let alternate = Arc::new(CallableOverload {
+        templates: None,
+        self_bound_params: Default::default(),
+        parameters: vec![param("$value", "string")].into(),
+        return_type: Some(PhpType::parse("string")),
+    });
+    let mut original = func("pick");
+    original.overloads.push(alternate.clone());
+    assert!(original.signature_eq(&original.clone()));
+    for change_return in [false, true] {
+        let mut changed = original.clone();
+        let changed_alternate = Arc::make_mut(&mut changed.overloads[0]);
+        if change_return {
+            changed_alternate.return_type = Some(PhpType::parse("int"));
+        } else {
+            changed_alternate.parameters.make_mut()[0].type_hint = Some(PhpType::parse("int"));
+        }
+        assert_eq!(original.overloads.len(), changed.overloads.len());
+        assert!(!original.signature_eq(&changed));
+        let mut original_method = method("__construct");
+        original_method.overloads = original.overloads.clone();
+        let mut changed_method = original_method.clone();
+        changed_method.overloads = changed.overloads;
+        assert!(!original_method.signature_eq(&changed_method));
+    }
+    assert_eq!(
+        alternate.parameters[0].type_hint,
+        Some(PhpType::parse("string"))
+    );
+}

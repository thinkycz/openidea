+/// Substitute applicable alternatives without copying unchanged shared records.
+pub(crate) fn apply_substitution_to_overloads(
+    overloads: &mut [std::sync::Arc<crate::types::CallableOverload>],
+    subs: &HashMap<String, PhpType>,
+) {
+    if overloads.is_empty() || subs.is_empty() {
+        return;
+    }
+    let keys: Vec<String> = subs.keys().cloned().collect();
+    for overload in overloads {
+        let template_references = overload.templates.as_ref().is_some_and(|templates| {
+            templates
+                .template_param_bounds
+                .values()
+                .any(|ty| ty.references_any_template_param(&keys))
+                || templates
+                    .template_param_defaults
+                    .iter()
+                    .any(|(_, ty)| ty.references_any_template_param(&keys))
+        });
+        let references = overload
+            .return_type
+            .as_ref()
+            .is_some_and(|hint| hint.references_any_template_param(&keys))
+            || overload.parameters.iter().any(|param| {
+                param
+                    .type_hint
+                    .as_ref()
+                    .is_some_and(|hint| hint.references_any_template_param(&keys))
+            })
+            || template_references;
+        if references {
+            let overload = std::sync::Arc::make_mut(overload);
+            if let Some(return_type) = &mut overload.return_type {
+                *return_type = return_type.substitute(subs);
+            }
+            let parameter_references = overload.parameters.iter().any(|param| {
+                param
+                    .type_hint
+                    .as_ref()
+                    .is_some_and(|hint| hint.references_any_template_param(&keys))
+            });
+            if parameter_references {
+                for param in overload.parameters.make_mut() {
+                    if let Some(hint) = &mut param.type_hint {
+                        *hint = hint.substitute(subs);
+                    }
+                }
+            }
+            if template_references && let Some(templates) = &mut overload.templates {
+                let templates = std::sync::Arc::make_mut(templates);
+                for bound in templates.template_param_bounds.values_mut() {
+                    *bound = bound.substitute(subs);
+                }
+                for (_, default) in templates.template_param_defaults.iter_mut() {
+                    *default = default.substitute(subs);
+                }
             }
         }
     }

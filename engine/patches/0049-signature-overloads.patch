+/// Remove whitespace and PHP comments before an argument without copying it.
+pub(crate) fn trim_argument_trivia(mut text: &str) -> &str {
+    loop {
+        text = text.trim_start();
+        match crate::text_scan::skip_php_comment(text.as_bytes(), 0) {
+            Some(end) => text = &text[end..],
+            None => return text,
+        }
+    }
+}
+
+/// Check PHP argument roles without copying or resolving expression values.
+/// A named argument cannot fill a non-variadic parameter already supplied by
+/// position, and a positional argument cannot follow a named one.
+pub(crate) fn text_args_have_compatible_roles(
+    params: &[ParameterInfo],
+    text_args: &[&str],
+) -> bool {
+    let mut occupied = vec![false; params.len()];
+    let variadic = params.iter().position(|parameter| parameter.is_variadic);
+    let mut next_positional = 0;
+    let mut saw_named = false;
+    for argument in text_args {
+        let argument = trim_argument_trivia(argument);
+        if argument.is_empty() {
+            continue;
+        }
+        let (name, _) = split_named_text_arg(argument);
+        let target = if let Some(name) = name {
+            saw_named = true;
+            params
+                .iter()
+                .position(|parameter| param_name_bare(parameter) == name)
+                .or(variadic)
+        } else {
+            if saw_named {
+                return false;
+            }
+            let target = (next_positional < params.len())
+                .then_some(next_positional)
+                .or(variadic);
+            next_positional += 1;
+            target
+        };
+        let Some(index) = target else {
+            return false;
+        };
+        if occupied[index] && !params[index].is_variadic {
+            return false;
+        }
+        occupied[index] = true;
+    }
+    true
 }
 

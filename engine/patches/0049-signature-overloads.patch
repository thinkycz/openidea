+/// Resolve a parameter independently for each applicable declaration.
+fn signature_active_parameter(
+    params: &[ParameterInfo],
+    name: Option<&str>,
+    ordinal: u32,
+) -> Option<u32> {
+    if let Some(name) = name {
+        params
+            .iter()
+            .position(|parameter| parameter.name.trim_start_matches('$') == name)
+            .or_else(|| params.iter().position(|parameter| parameter.is_variadic))
+            .map(|index| index as u32)
+    } else {
+        (!params.is_empty()).then(|| clamp_active_param(ordinal, params))
+    }
+}

+fn rewrite_overload_types(
+    method: &mut MethodInfo,
+    matches: impl Fn(&PhpType) -> bool,
+    rewrite: impl Fn(&PhpType) -> PhpType,
+) {
+    for overload in &mut method.overloads {
+        let return_matches = overload.return_type.as_ref().is_some_and(&matches);
+        let params_match = overload
+            .parameters
+            .iter()
+            .any(|param| param.type_hint.as_ref().is_some_and(&matches));
+        if !return_matches && !params_match {
+            continue;
+        }
+        let overload = std::sync::Arc::make_mut(overload);
+        if return_matches && let Some(ty) = &mut overload.return_type {
+            *ty = rewrite(ty);
+        }
+        if params_match {
+            for param in overload.parameters.make_mut() {
+                for ty in [&mut param.type_hint, &mut param.native_type_hint] {
+                    if let Some(ty) = ty
+                        && matches(ty)
+                    {
+                        *ty = rewrite(ty);
+                    }
+                }
+            }
         }
     }
 }

+/// Match the current argument count without resolving argument expression types.
+fn signature_accepts_count(params: &[ParameterInfo], count: usize) -> bool {
+    let required = params
+        .iter()
+        .rposition(|parameter| parameter.is_required && !parameter.is_variadic)
+        .map_or(0, |index| index + 1);
+    count >= required
+        && (count <= params.len() || params.last().is_some_and(|parameter| parameter.is_variadic))

+async fn configured_vendor_members(vendor_setting: &str, expression: &str) -> Vec<String> {
+    let composer = serde_json::json!({
+        "config": {"vendor-dir": vendor_setting, "bin-dir": "tools with spaces"},
+        "autoload": {"psr-4": {"App\\": "src/"}}
+    })
+    .to_string();
+    let content = format!("<?php\n$x = {expression};\n$x->\n");
+    let (backend, dir) = create_psr4_workspace(
+        &composer,
+        &[
+            (".phpantom.toml", "[indexing]\nstrategy = \"none\"\n"),
+            (".gitignore", "/tools with spaces/packages/\n"),
+            (
+                "tools with spaces/packages/acme/pkg/src/Service.php",
+                r#"<?php
+namespace Vendor\Package;
+class Service { public function vendorAction(): string { return 'ok'; } }
+"#,
+            ),
+            (
+                "tools with spaces/packages/acme/pkg/helpers.php",
+                r#"<?php
+namespace Vendor\Package;
+file_put_contents(__DIR__ . '/executed', 'never');
+function vendor_helper(): Service { return new Service(); }
+"#,
+            ),
+            (
+                "tools with spaces/packages/composer/autoload_classmap.php",
+                r#"<?php
+$vendorDir = dirname(__DIR__);
+return array(
+    'Vendor\\Package\\Service' => $vendorDir . '/acme/pkg/src/Service.php',
+);
+"#,
+            ),
+            (
+                "tools with spaces/packages/composer/autoload_files.php",
+                r#"<?php
+$vendorDir = dirname(__DIR__);
+return array(
+    'helper' => $vendorDir . '/acme/pkg/helpers.php',
+);
+"#,
+            ),
+            ("caller.php", &content),
+        ],
+    );
+    let uri = open_initialized_php(&backend, "caller.php").await;
+    let position = position_after(&content, "$x->");
+    let labels = complete_labels_at_opened(&backend, &uri, position.line, position.character).await;
+    assert!(
+        !dir.path()
+            .join("tools with spaces/packages/acme/pkg/executed")
+            .exists(),
+        "metadata discovery must not execute helper PHP"
+    );
+    labels
+}
+

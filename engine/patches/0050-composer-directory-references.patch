+// This is deliberately local Composer configuration expansion, not Composer's
+// environment/home/global-configuration machinery. Bound substitutions and
+// output independently; on failure this String API retains the original value.
+const COMPOSER_DIR_SUBSTITUTIONS: usize = 64;
+const COMPOSER_DIR_BYTES: usize = 64 * 1024;
+
+fn composer_directory(package: &ComposerPackage, key: usize) -> String {
+    let config = package.config.as_ref();
+    let values = [
+        config
+            .and_then(|config| config.vendor_dir.as_deref())
+            .unwrap_or("vendor"),
+        config
+            .and_then(|config| config.bin_dir.as_deref())
+            .unwrap_or("{$vendor-dir}/bin"),
+    ];
+    let mut substitutions = COMPOSER_DIR_SUBSTITUTIONS;
+    expand_composer_directory(&values, key, 0, &mut substitutions)
+        .unwrap_or_else(|| values[key].trim_end_matches('/').to_owned())
+}
+
+fn expand_composer_directory(
+    values: &[&str; 2],
+    key: usize,
+    visiting: u8,
+    substitutions: &mut usize,
+) -> Option<String> {
+    let bit = 1 << key;
+    if visiting & bit != 0 {
+        return None;
+    }
+    let visiting = visiting | bit;
+    let mut remaining = values[key].trim_end_matches('/');
+    if remaining.len() > COMPOSER_DIR_BYTES {
+        return None;
+    }
+    let mut expanded = String::new();
+    while let Some(start) = remaining.find("{$") {
+        push_composer_directory(&mut expanded, &remaining[..start])?;
+        let reference = &remaining[start + 2..];
+        let end = reference.find('}')?;
+        let target = match &reference[..end] {
+            "vendor-dir" => 0,
+            "bin-dir" => 1,
+            _ => return None,
+        };
+        if *substitutions == 0 {
+            return None;
+        }
+        *substitutions -= 1;
+        let replacement = expand_composer_directory(values, target, visiting, substitutions)?;
+        push_composer_directory(&mut expanded, &replacement)?;
+        remaining = &reference[end + 1..];
+    }
+    push_composer_directory(&mut expanded, remaining)?;
+    expanded.truncate(expanded.trim_end_matches('/').len());
+    Some(expanded)
+}
+
+fn push_composer_directory(output: &mut String, text: &str) -> Option<()> {
+    if output.len().checked_add(text.len())? > COMPOSER_DIR_BYTES {
+        return None;
+    }
+    output.push_str(text);
+    Some(())
 }
 

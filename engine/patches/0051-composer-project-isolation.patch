+            .filter_map(|f| f.uri.to_file_path().ok())
+            .collect();
+        if let Some(root) = params.root_uri.as_ref().and_then(|u| u.to_file_path().ok()) {
+            folders.insert(0, root);
+        }
+        let mut seen = HashSet::new();
+        folders.retain(|p| seen.insert(normalized(p)));
+        let mut roots = folders.clone();
+        for folder in &folders {
+            if !folder.join("composer.json").is_file() {
+                roots.extend(
+                    composer::discover_subproject_roots(folder)
+                        .into_iter()
+                        .map(|(path, _)| path),
+                );
+            }
+        }
+        let mut seen = HashSet::new();
+        roots.retain(|p| seen.insert(normalized(p)));
+        let mut contexts = Vec::new();
+        for root in &roots {
+            let excluded: Vec<_> = roots
+                .iter()
+                .filter(|other| *other != root && contains(root, other))
+                .cloned()
+                .collect();
+            let mut backend = Self::backend(self.client.clone(), self.full_stubs);
+            backend.symbols.source_authority = Arc::clone(&self.sources);
+            backend.diag.transport_clock = Some(Arc::clone(&self.diagnostic_clock));
+            backend.diag.publication_sequence = Arc::clone(&self.diagnostic_clock.sequence);
+            backend.project_scope = Arc::new(ProjectScope::new(
+                root.clone(),
+                Arc::clone(&self.owners),
+                excluded,
+            ));
+            let mut dependencies = Vec::new();
+            let mut dependency_files = HashSet::new();
+            if let Some(package) = composer::read_composer_package(root) {
+                let vendor = composer::get_vendor_dir(&package);
+                dependencies.push(root.join(&vendor));
+                let mappings = composer::extract_psr4_mappings_from_package(&package);
+                dependencies.extend(
+                    mappings
+                        .into_iter()

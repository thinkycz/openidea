+use std::sync::Arc;
+use std::sync::atomic::{AtomicU64, Ordering};
+use tokio::sync::{OnceCell, OwnedRwLockReadGuard};
+use tower_lsp::jsonrpc::{Error, Result};
+use tower_lsp::lsp_types::*;
+use tower_lsp::{Client, LanguageServer};
+
+pub(crate) struct ProjectContext {
+    pub(crate) id: u64,
+    pub(crate) root: Option<PathBuf>,
+    pub(crate) backend: Arc<Backend>,
+    dependencies: Vec<PathBuf>,
+    dependency_files: HashSet<PathBuf>,
+    ready: OnceCell<()>,
+}
+
+#[derive(Clone)]
+struct DocumentRouting {
+    physical: Option<PathBuf>,
+    consumers: HashSet<u64>,
+}
+
+/// One transport with independent semantic states for Composer projects.
+pub struct ProjectRouter {
+    client: Option<Client>,
+    full_stubs: bool,
+    sources: Arc<crate::source_authority::SourceAuthority>,
+    diagnostic_clock: Arc<crate::diagnostics::transport_clock::TransportClock>,
+    navigation_sequence: AtomicU64,
+    navigation_versions: RwLock<HashMap<String, u64>>,
+    contexts: RwLock<Vec<Arc<ProjectContext>>>,
+    owners: Arc<RwLock<HashMap<String, u64>>>,
+    documents: RwLock<HashMap<String, TextDocumentItem>>,
+    document_routing: RwLock<HashMap<String, DocumentRouting>>,
+    params: RwLock<Option<InitializeParams>>,
+    gate: Arc<tokio::sync::RwLock<()>>,
+}
+
+#[derive(Deserialize)]
+pub struct ProjectRouteQuery {
+    /// Document selecting the consuming Composer project.
+    pub uri: Option<Url>,
+    #[serde(flatten)]
+    pub query: crate::workbench_routes::RouteQuery,
+}
+#[derive(Deserialize)]
+pub struct ProjectViewQuery {
+    /// Document selecting the consuming Composer project.
+    pub uri: Option<Url>,
+    #[serde(flatten)]
+    pub query: crate::workbench_views::ViewQuery,
+}
+#[derive(Deserialize)]
+pub struct ProjectTargetQuery {
+    /// Document selecting the consuming Composer project.
+    pub uri: Option<Url>,
+}
+
+fn normalized(path: &Path) -> PathBuf {
+    path.canonicalize().unwrap_or_else(|_| path.to_path_buf())
+}
+fn contains(root: &Path, path: &Path) -> bool {
+    path.starts_with(root) || normalized(path).starts_with(normalized(root))
+}
+
+impl ProjectContext {
+    fn consumes(&self, uri: &Url) -> bool {
+        let Ok(path) = uri.to_file_path() else {
+            return false;
+        };
+        if self.dependencies.iter().any(|root| contains(root, &path))
+            || self.dependency_files.contains(&normalized(&path))
+        {
+            return true;
+        }
+        if self
+            .backend
+            .project_scope
+            .excluded_roots()
+            .iter()
+            .any(|root| contains(root, &path))
+        {
+            return false;
+        }
+        self.root.as_ref().is_some_and(|root| contains(root, &path))
+    }
+}
+
+impl ProjectRouter {
+    /// Create a synchronous, isolated router without external tools or stubs.
+    pub fn new_test() -> Self {
+        Self::create(None, false)
+    }
+    /// Test router using the real bundled PHP declaration corpus.
+    pub fn new_test_with_full_stubs() -> Self {
+        Self::create(None, true)
+    }
+
+    /// Create a router connected to one LSP client.
+    pub fn new(client: Client) -> Self {
+        Self::create(Some(client), false)
+    }
+
+    fn create(client: Option<Client>, full_stubs: bool) -> Self {
+        let sources = Arc::new(crate::source_authority::SourceAuthority::default());
+        let diagnostic_clock =
+            Arc::new(crate::diagnostics::transport_clock::TransportClock::default());
+        let mut backend = Self::backend(client.clone(), full_stubs);
+        backend.symbols.source_authority = Arc::clone(&sources);
+        backend.diag.transport_clock = Some(Arc::clone(&diagnostic_clock));
+        backend.diag.publication_sequence = Arc::clone(&diagnostic_clock.sequence);
+        let context = Arc::new(ProjectContext {
+            id: 0,
+            root: None,
+            backend: Arc::new(backend),
+            dependencies: Vec::new(),
+            dependency_files: HashSet::new(),
+            ready: OnceCell::new(),
+        });
+        Self {
+            client,
+            full_stubs,
+            sources,
+            diagnostic_clock,
+            navigation_sequence: AtomicU64::new(0),
+            navigation_versions: RwLock::new(HashMap::new()),
+            contexts: RwLock::new(vec![context]),
+            owners: Arc::new(RwLock::new(HashMap::new())),
+            documents: RwLock::new(HashMap::new()),
+            document_routing: RwLock::new(HashMap::new()),
+            params: RwLock::new(None),
+            gate: Arc::new(tokio::sync::RwLock::new(())),
+        }
+    }
+
+    fn backend(client: Option<Client>, full_stubs: bool) -> Backend {
+        match client {
+            Some(client) => Backend::new(client),
+            None if full_stubs => Backend::new_test_with_full_stubs(),
+            None => Backend::new_test(),
+        }
+    }
+
+    pub(crate) async fn request_guard(&self) -> OwnedRwLockReadGuard<()> {
+        Arc::clone(&self.gate).read_owned().await
+    }
+    pub(crate) fn fallback_context(&self) -> Arc<ProjectContext> {
+        Arc::clone(&self.contexts.read()[0])
+    }
+
+    pub(crate) async fn initialize_projects(
+        &self,
+        params: InitializeParams,
+    ) -> Result<InitializeResult> {
+        let _gate = self.gate.write().await;
+        self.configure_projects(params).await
+    }
+
+    async fn configure_projects(&self, params: InitializeParams) -> Result<InitializeResult> {
+        *self.params.write() = Some(params.clone());

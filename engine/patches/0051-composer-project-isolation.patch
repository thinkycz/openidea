+pub(super) async fn assert_helper_symbols(
+    router: &ProjectRouter,
+    callers: &[(PathBuf, String); 2],
+    source: &Path,
+    changed: bool,
+) {
+    assert_both(router, callers, changed).await;
+    for (path, _) in callers {
+        assert_helper_definition(router, path, "make_service", Some(source)).await;
+        for (old, new) in [
+            ("removed_helper", "added_helper"),
+            ("REMOVED_CONSTANT", "ADDED_CONSTANT"),
+            ("RemovedHelperClass", "AddedHelperClass"),
+        ] {
+            assert_helper_definition(router, path, old, (!changed).then_some(source)).await;
+            assert_helper_definition(router, path, new, changed.then_some(source)).await;
+        }
+    }
+}

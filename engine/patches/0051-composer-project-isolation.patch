+//! A single shared editor overlay reaches every consuming vendor-path alias.
+#![cfg(unix)]
+
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use phpantom_lsp::ProjectRouter;
+use tower_lsp::LanguageServer;
+use tower_lsp::lsp_types::*;
+
+use crate::common::{definition_locations, position_of};
+
+pub(super) fn write(root: &Path, relative: &str, text: &str) {
+    let path = root.join(relative);
+    fs::create_dir_all(path.parent().unwrap()).unwrap();
+    fs::write(path, text).unwrap();
+}
+
+pub(super) async fn open(router: &ProjectRouter, path: &Path) -> String {
+    let text = fs::read_to_string(path).unwrap();
+    router
+        .did_open(DidOpenTextDocumentParams {
+            text_document: TextDocumentItem {
+                uri: Url::from_file_path(path).unwrap(),
+                language_id: "php".into(),
+                version: 1,
+                text: text.clone(),
+            },
+        })
+        .await;
+    text
+}
+
+pub(super) async fn replace(router: &ProjectRouter, path: &Path, version: i32, text: &str) {
+    router
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: Url::from_file_path(path).unwrap(),
+                version,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: text.into(),
+            }],
+        })
+        .await;
+}
+
+pub(super) async fn assert_members(
+    router: &ProjectRouter,
+    path: &Path,
+    source: &str,
+    expected: &str,
+    absent: &[&str],
+) {
+    let offset = source.rfind("$value->").unwrap() + "$value->".len();
+    let prefix = &source[..offset];
+    let response = router
+        .completion(CompletionParams {
+            text_document_position: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier {
+                    uri: Url::from_file_path(path).unwrap(),
+                },
+                position: Position::new(
+                    prefix.matches('\n').count() as u32,
+                    prefix.rsplit('\n').next().unwrap().encode_utf16().count() as u32,
+                ),
+            },
+            context: None,
+            work_done_progress_params: WorkDoneProgressParams::default(),
+            partial_result_params: PartialResultParams::default(),
+        })
+        .await
+        .unwrap();
+    let items = match response {
+        Some(CompletionResponse::Array(items)) => items,
+        Some(CompletionResponse::List(list)) => list.items,
+        None => Vec::new(),
+    };
+    let labels: Vec<_> = items.iter().map(|item| item.label.as_str()).collect();
+    let has = |name: &str| {
+        labels
+            .iter()
+            .any(|label| label.split('(').next() == Some(name))
+    };
+    assert!(
+        has(expected),
+        "{} missing {expected}: {labels:?}",
+        path.display()
+    );
+    for name in absent {
+        assert!(
+            !has(name),
+            "{} includes foreign/stale {name}: {labels:?}",
+            path.display()
+        );
+    }
+}
+
+pub(super) async fn assert_both(
+    router: &ProjectRouter,
+    callers: &[(PathBuf, String); 2],
+    replacement: bool,
+) {
+    for (index, own) in ["A", "B"].into_iter().enumerate() {
+        let sibling = if own == "A" { "B" } else { "A" };
+        let expected = format!("from{own}{}", if replacement { "Replacement" } else { "" });
+        let stale = format!("from{own}{}", if replacement { "" } else { "Replacement" });
+        let sibling_original = format!("from{sibling}");
+        let sibling_replacement = format!("from{sibling}Replacement");
+        assert_members(
+            router,
+            &callers[index].0,
+            &callers[index].1,
+            &expected,
+            &[&stale, &sibling_original, &sibling_replacement],
+        )
+        .await;
+    }
+}

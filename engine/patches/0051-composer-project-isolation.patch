+//! Public LSP requests keep independent Composer graphs isolated.
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use phpantom_lsp::workbench_builtins::BuiltinQuery;
+use phpantom_lsp::{ProjectRouter, ProjectTargetQuery};
+use tempfile::TempDir;
+use tower_lsp::LanguageServer;
+use tower_lsp::lsp_types::*;
+
+use crate::common::{definition_locations, position_after, position_of};
+
+struct Projects {
+    _directory: TempDir,
+    root: PathBuf,
+}
+
+impl Projects {
+    fn new() -> Self {
+        let directory = tempfile::tempdir().unwrap();
+        let root = directory.path().canonicalize().unwrap();
+        let fixture = Self {
+            _directory: directory,
+            root,
+        };
+        for project in ["a", "b"] {
+            fixture.write(
+                &format!("apps/{project}/composer.json"),
+                &serde_json::json!({
+                    "name": format!("fixture/{project}"),
+                    "autoload": {"psr-4": {"App\\": "src/"}, "files": ["src/Helpers.php"]}
+                })
+                .to_string(),
+            );
+            let upper = project.to_uppercase();
+            fixture.write(&format!("apps/{project}/src/Service.php"), &format!(
+                "<?php\nnamespace App;\nclass Service {{\n    /** café 🐘 Project {upper} member documentation. */ public function from{upper}(): string {{ return '{upper}'; }}\n}}\n"));
+            fixture.write(&format!("apps/{project}/src/Helpers.php"), &format!(
+                "<?php\nnamespace App;\nconst OWNER = '{upper}';\nfunction make_service(): Service {{ return new Service(); }}\n"));
+            fixture.write(&format!("apps/{project}/index.php"), &format!(
+                "<?php\n$service = new \\App\\Service();\n$service->from{upper}();\n$service->\n"));
+            fixture.write(&format!("apps/{project}/symbols.php"), &format!(
+                "<?php\n$service = \\App\\make_service();\n$service->from{upper}();\n$owner = \\App\\OWNER;\n$service->\n"));
+        }
+        fixture
+    }
+
+    fn write(&self, relative: &str, text: &str) {
+        let path = self.root.join(relative);
+        fs::create_dir_all(path.parent().unwrap()).unwrap();
+        fs::write(path, text).unwrap();
+    }
+
+    fn path(&self, project: &str, relative: &str) -> PathBuf {
+        self.root.join("apps").join(project).join(relative)
+    }
+
+    async fn router(&self) -> ProjectRouter {
+        let router = ProjectRouter::new_test();
+        router
+            .initialize(InitializeParams {
+                root_uri: Some(Url::from_directory_path(&self.root).unwrap()),
+                workspace_folders: Some(vec![WorkspaceFolder {
+                    uri: Url::from_directory_path(&self.root).unwrap(),
+                    name: "independent-projects".into(),
+                }]),
+                ..InitializeParams::default()
+            })
+            .await
+            .unwrap();
+        router.initialized(InitializedParams {}).await;
+        router
+    }
+}
+
+async fn open(router: &ProjectRouter, path: &Path) -> String {
+    let text = fs::read_to_string(path).unwrap();
+    router
+        .did_open(DidOpenTextDocumentParams {
+            text_document: TextDocumentItem {
+                uri: Url::from_file_path(path).unwrap(),
+                language_id: "php".into(),
+                version: 1,
+                text: text.clone(),
+            },
+        })
+        .await;
+    text
+}
+
+async fn replace(router: &ProjectRouter, path: &Path, version: i32, text: &str) {
+    router
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: Url::from_file_path(path).unwrap(),
+                version,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: text.into(),
+            }],
+        })
+        .await;
+}
+
+async fn close(router: &ProjectRouter, path: &Path) {
+    router
+        .did_close(DidCloseTextDocumentParams {
+            text_document: TextDocumentIdentifier {
+                uri: Url::from_file_path(path).unwrap(),
+            },
+        })
+        .await;
+}
+
+async fn items(router: &ProjectRouter, path: &Path, text: &str) -> Vec<CompletionItem> {
+    let offset = text.rfind("$service->").unwrap() + "$service->".len();
+    let before = &text[..offset];
+    let position = Position::new(
+        before.matches('\n').count() as u32,
+        before.rsplit('\n').next().unwrap().encode_utf16().count() as u32,
+    );
+    let result = router
+        .completion(CompletionParams {
+            text_document_position: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier {
+                    uri: Url::from_file_path(path).unwrap(),
+                },
+                position,
+            },
+            context: None,
+            work_done_progress_params: WorkDoneProgressParams::default(),
+            partial_result_params: PartialResultParams::default(),
+        })
+        .await
+        .unwrap();
+    match result {
+        Some(CompletionResponse::Array(items)) => items,
+        Some(CompletionResponse::List(list)) => list.items,
+        None => Vec::new(),
+    }
+}
+
+fn has(items: &[CompletionItem], name: &str) -> bool {
+    items
+        .iter()
+        .any(|item| item.label.split('(').next() == Some(name))
+}
+
+async fn assert_members(
+    router: &ProjectRouter,
+    path: &Path,
+    text: &str,
+    own: &str,
+    absent: &[&str],
+) {
+    let result = items(router, path, text).await;
+    let labels: Vec<_> = result.iter().map(|item| &item.label).collect();
+    assert!(has(&result, own), "missing own {own}: {labels:?}");
+    for name in absent {
+        assert!(!has(&result, name), "foreign/stale {name}: {labels:?}");
+    }
+}

+                dependency_files,
+                ready: OnceCell::new(),
+            }));
+        }
+        if contexts.is_empty() {
+            let mut backend = Self::backend(self.client.clone(), self.full_stubs);
+            backend.symbols.source_authority = Arc::clone(&self.sources);
+            backend.diag.transport_clock = Some(Arc::clone(&self.diagnostic_clock));
+            backend.diag.publication_sequence = Arc::clone(&self.diagnostic_clock.sequence);
+            backend.project_scope =
+                Arc::new(ProjectScope::virtual_context(Arc::clone(&self.owners)));
+            backend.on_initialize(params.clone()).await?;
+            contexts.push(Arc::new(ProjectContext {
+                id: backend.project_scope.id(),
+                root: None,
+                backend: Arc::new(backend),
+                dependencies: Vec::new(),
+                dependency_files: HashSet::new(),
+                ready: OnceCell::new(),

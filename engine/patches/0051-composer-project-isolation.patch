+async fn composer_passive_vendor_alias_direct_request_rejects_mismatched_buffer_coordinates() {
+    let (_directory, root) = alias_projects();
+    let router = alias_router(&root).await;
+    let a_alias = root.join("apps/a/vendor/acme/shared/src/Gateway.php");
+    let b_alias = root.join("apps/b/vendor/acme/shared/src/Gateway.php");
+    assert_eq!(open(&router, &a_alias).await, GATEWAY_SOURCE);
+    assert_eq!(open(&router, &b_alias).await, GATEWAY_SOURCE);
+    let b_text = GATEWAY_SOURCE.replace("function service(", "function serviceFromB(");
+    replace(&router, &b_alias, 2, &b_text).await;
+    assert_direct_alias_symbol(&router, &b_alias, "serviceFromB", "serviceFromA").await;
+    let stale_a = document_symbols(&router, &a_alias).await.unwrap_err();
+    assert_eq!(
+        stale_a.code,
+        tower_lsp::jsonrpc::ErrorCode::ServerError(-32801),
+        "passive A coordinates cannot be evaluated against active B bytes"
+    );
+
+    // A's own next version becomes authority without copying those bytes into
+    // B's independent editor buffer or changing the shared file on disk.
+    let a_text = GATEWAY_SOURCE.replace("function service(", "function serviceFromA(");
+    replace(&router, &a_alias, 2, &a_text).await;
+    assert_direct_alias_symbol(&router, &a_alias, "serviceFromA", "serviceFromB").await;
+    let stale_b = document_symbols(&router, &b_alias).await.unwrap_err();
+    assert_eq!(
+        stale_b.code,
+        tower_lsp::jsonrpc::ErrorCode::ServerError(-32801),
+        "passive B retains its actual differing buffer, rather than silently overwritten bytes"
+    );
+    close_alias(&router, &a_alias).await;
+    assert_direct_alias_symbol(&router, &b_alias, "serviceFromB", "serviceFromA").await;
+    close_alias(&router, &b_alias).await;
+    assert_eq!(fs::read_to_string(&a_alias).unwrap(), GATEWAY_SOURCE);
+    assert_eq!(fs::read_to_string(&b_alias).unwrap(), GATEWAY_SOURCE);
+    router.shutdown().await.unwrap();
+}

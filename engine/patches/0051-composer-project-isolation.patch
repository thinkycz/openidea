+async fn ordered_projects(order: [&str; 2]) {
+    let fixture = Projects::new();
+    let router = fixture.router().await;
+    for project in order {
+        let own = format!("from{}", project.to_uppercase());
+        let other = if project == "a" { "fromB" } else { "fromA" };
+        let path = fixture.path(project, "index.php");
+        let text = open(&router, &path).await;
+        assert_members(&router, &path, &text, &own, &[other]).await;
+        assert_definition(
+            &router,
+            &path,
+            &text,
+            "Service",
+            &fixture.path(project, "src/Service.php"),
+        )
+        .await;
+        assert_definition(
+            &router,
+            &path,
+            &text,
+            &own,
+            &fixture.path(project, "src/Service.php"),
+        )
+        .await;
+        let symbols = fixture.path(project, "symbols.php");
+        let source = open(&router, &symbols).await;
+        assert_members(&router, &symbols, &source, &own, &[other]).await;
+        assert_definition(
+            &router,
+            &symbols,
+            &source,
+            "make_service",
+            &fixture.path(project, "src/Helpers.php"),
+        )
+        .await;
+        assert_definition(
+            &router,
+            &symbols,
+            &source,
+            "OWNER",
+            &fixture.path(project, "src/Helpers.php"),
+        )
+        .await;
+    }
+    // Revisit the first graph after the second graph has resolved the same names.
+    let first = fixture.path(order[0], "index.php");
+    let source = fs::read_to_string(&first).unwrap();
+    let own = format!("from{}", order[0].to_uppercase());
+    let foreign = format!("from{}", order[1].to_uppercase());
+    assert_members(&router, &first, &source, &own, &[&foreign]).await;
+    router.shutdown().await.unwrap();
+}

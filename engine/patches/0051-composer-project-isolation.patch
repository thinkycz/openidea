+    ) -> Result<Option<Vec<TypeHierarchyItem>>> {
+        let _request = self.request_guard().await;
+        let project = self
+            .project_for(&params.text_document_position_params.text_document.uri)
+            .await?;
+        let mut result = project.backend.prepare_type_hierarchy(params).await?;

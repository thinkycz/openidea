+#[tokio::test]
+async fn composer_project_contexts_active_php_target_requires_unambiguous_owner() {
+    let fixture = projects_with_distinct_php_targets();
+    let router = full_stub_router(&fixture).await;
+    let a = fixture.path("a", "builtin.php");
+    let b = fixture.path("b", "builtin.php");
+    open(&router, &a).await;
+    open(&router, &b).await;
+    // Read in reverse order, then revisit A: querying one target must never
+    // relabel another project's already initialized builtin declarations.
+    for (path, expected) in [(&b, "8.4"), (&a, "8.2"), (&b, "8.4")] {
+        let target = router
+            .workbench_active_target(ProjectTargetQuery {
+                uri: Some(Url::from_file_path(path).unwrap()),
+            })
+            .await
+            .unwrap();
+        assert_eq!(
+            target.php_version,
+            expected,
+            "wrong target for {}",
+            path.display()
+        );
+        assert!(!target.stubs_version.is_empty());
+    }
+    assert!(
+        router
+            .workbench_active_target(ProjectTargetQuery { uri: None })
+            .await
+            .is_err(),
+        "mixed open Composer projects must require an explicit target document"
+    );
+    router.shutdown().await.unwrap();
+}

+        let context = self.selected_document(uri)?;
+        self.ready(&context).await;
+        Ok(context)
+    }
+    fn consumers(&self, uri: &Url) -> Vec<Arc<ProjectContext>> {
+        let Ok(selected) = self.selected_document(uri) else {
+            return Vec::new();
+        };
+        self.contexts
+            .read()
+            .iter()
+            .filter(|c| c.id == selected.id || c.consumes(uri))
+            .cloned()
+            .collect()
+    }
+    fn record_routing(&self, uri: &Url, consumers: &[Arc<ProjectContext>]) {
+        self.document_routing.write().insert(
+            uri.to_string(),
+            DocumentRouting {
+                physical: uri.to_file_path().ok().map(|path| normalized(&path)),
+                consumers: consumers.iter().map(|context| context.id).collect(),
+            },
+        );
+    }
+    fn source_group(&self, uri: &Url) -> HashSet<String> {
+        let mut aliases = self.sources.aliases(uri.as_str());
+        aliases.insert(uri.to_string());
+        aliases
+    }
+    async fn refresh_source_group(&self, aliases: &HashSet<String>, closing: bool) {
+        if aliases.len() < 2 {
+            return;
+        }
+        for context in self.contexts.read().clone() {
+            if context.ready.get().is_none() {
+                continue;
+            }
+            let backend = &context.backend;
+            let _merge = backend.index_merge_gate.lock();
+            let _publication = backend.begin_semantic_publication();
+            if closing {
+                for uri in aliases {
+                    if !context.consumes(&Url::parse(uri).expect("recorded source URI"))
+                        && !backend.parsed_uris.read().contains(uri)
+                    {
+                        continue;
+                    }
+                    // Re-select actual remaining client bytes, or restore the physical disk.
+                    let text = backend
+                        .open_files
+                        .read()
+                        .get(uri)
+                        .cloned()
+                        .map(|s| s.to_string())
+                        .or_else(|| {
+                            Url::parse(uri)
+                                .ok()?
+                                .to_file_path()
+                                .ok()
+                                .and_then(|p| std::fs::read_to_string(p).ok())
+                        });
+                    if let Some(text) = text {
+                        backend.update_ast(uri, &text);
+                    } else if let Some(path) =
+                        Url::parse(uri).ok().and_then(|uri| uri.to_file_path().ok())
+                    {
+                        backend.reindex_files_batch(&[(
+                            uri.clone(),
+                            path,
+                            FileChangeType::DELETED,
+                        )]);
+                    }
+                }
+            }
+            let changed = backend.refresh_source_authority_for_uris(aliases);
+            backend.evict_methods_for_fqns(&changed.classes);
+            backend.evict_gti_for_fqns(&changed.classes);
+            let winners: Vec<_> = {
+                let index = backend.symbols.fqn_class_index.read();
+                changed
+                    .classes
+                    .iter()
+                    .filter_map(|fqn| index.get(fqn).cloned())
+                    .collect()
+            };
+            backend.populate_method_store(&winners);
+            backend.populate_gti_index(&winners);
+            backend.symbols.class_not_found_cache.write().clear();
+            backend.symbols.note_class_lookup_change();
+            if !changed.functions.is_empty() {
+                backend.symbols.retire_function_misses();
+            }
+            if !changed.classes.is_empty()
+                || !changed.functions.is_empty()
+                || !changed.constants.is_empty()
+            {
+                backend.clear_resolved_class_cache();
+                backend.clear_completion_cache();
+                backend.member_ref_counts.invalidate_locations_all();
+                backend.typed_receiver_view_spans_cache.write().clear();
+            }
+        }
+        if let Some(client) = &self.client {
+            let passive: Vec<_> = self
+                .documents
+                .read()
+                .values()
+                .filter(|doc| {
+                    aliases.contains(doc.uri.as_str())
+                        && !self.sources.is_preferred(doc.uri.as_str())
+                })
+                .cloned()
+                .collect();
+            for doc in passive {
+                let Some(open) = self.diagnostic_clock.opening(doc.uri.as_str()) else {
+                    continue;
+                };
+                client
+                    .send_notification::<crate::diagnostics::revision::Publish>(
+                        crate::diagnostics::revision::Publication {
+                            params: PublishDiagnosticsParams {
+                                uri: doc.uri,
+                                diagnostics: Vec::new(),
+                                version: Some(doc.version),
+                            },
+                            open: Some(open),
+                            complete: Some(true),
+                            sequence: Some(
+                                self.diagnostic_clock
+                                    .sequence
+                                    .fetch_add(1, Ordering::Relaxed)
+                                    + 1,
+                            ),
+                        },
+                    )
+                    .await;
+            }
+        }
+    }
+    pub(crate) async fn open_document(&self, params: DidOpenTextDocumentParams) {
+        let _gate = self.gate.write().await;
+        let uri = &params.text_document.uri;
+        let Ok(owner) = self.selected_document(uri) else {
+            return;
+        };
+        self.owners.write().insert(uri.to_string(), owner.id);
+        let mut old_aliases = self.source_group(uri);
+        self.diagnostic_clock.open(uri.as_str());
+        let retargeted = self.sources.open(uri.as_str());
+        let mut aliases = self.source_group(uri);
+        if retargeted {
+            self.owners.write().remove(uri.as_str());
+            let owner = self.selected(uri);
+            self.owners.write().insert(uri.to_string(), owner.id);
+        } else {
+            aliases.extend(old_aliases.iter().cloned());
+        }
+        self.documents
+            .write()
+            .insert(uri.to_string(), params.text_document.clone());
+        let consumers = self.consumers(uri);
+        if retargeted {
+            let previous: Vec<_> = self
+                .contexts
+                .read()
+                .iter()
+                .filter(|context| {
+                    context.ready.get().is_some()
+                        && !consumers.iter().any(|current| current.id == context.id)
+                        && context.backend.parsed_uris.read().contains(uri.as_str())
+                })
+                .cloned()
+                .collect();
+            for context in previous {
+                context.backend.forget_consumed_document(uri).await;
+            }
+        }
+        self.record_routing(uri, &consumers);
+        for context in consumers {
+            if context.ready.get().is_some() {
+                context.backend.on_did_open(params.clone()).await;
+            } else {
+                self.ready(&context).await;
+            }
+        }
+        if retargeted {
+            old_aliases.remove(uri.as_str());
+            self.refresh_source_group(&old_aliases, true).await;
+        }
+        self.refresh_source_group(&aliases, false).await;
+    }
+
+    pub(crate) async fn change_document(&self, params: DidChangeTextDocumentParams) {
+        let _gate = self.gate.write().await;
+        let uri = &params.text_document.uri;
+        if params.content_changes.is_empty() {
+            return;
+        }
+        {
+            let mut documents = self.documents.write();
+            let Some(document) = documents.get_mut(uri.as_str()) else {
+                return;
+            };
+            if params.text_document.version <= document.version {
+                return;
+            }
+            for change in &params.content_changes {
+                if let Some(range) = change.range {
+                    let start =
+                        crate::text_position::position_to_byte_offset(&document.text, range.start);
+                    let end =
+                        crate::text_position::position_to_byte_offset(&document.text, range.end);
+                    document
+                        .text
+                        .replace_range(start.min(end)..start.max(end), &change.text);
+                } else {
+                    document.text = change.text.clone();
+                }
+            }
+            document.version = params.text_document.version;
+        }
+        let previous = self.document_routing.read().get(uri.as_str()).cloned();
+        let physical = uri.to_file_path().ok().map(|path| normalized(&path));
+        let retargeted = previous
+            .as_ref()
+            .is_some_and(|prior| prior.physical != physical);
+        let mut old_aliases = self.source_group(uri);
+        if retargeted {
+            self.owners.write().remove(uri.as_str());
+            let owner = self.selected(uri);
+            self.owners.write().insert(uri.to_string(), owner.id);
+        }
+        self.sources.change(uri.as_str());
+        let mut aliases = self.source_group(uri);
+        if !retargeted {
+            aliases.extend(old_aliases.iter().cloned());
+        }
+        let consumers = self.consumers(uri);
+        if let Some(previous) = &previous {
+            let old_only: Vec<_> = self
+                .contexts
+                .read()
+                .iter()
+                .filter(|context| {
+                    previous.consumers.contains(&context.id)
+                        && !consumers.iter().any(|current| current.id == context.id)
+                })
+                .cloned()
+                .collect();
+            for context in old_only {
+                context.backend.forget_consumed_document(uri).await;
+            }
+        }
+        let accepted = self
+            .documents
+            .read()
+            .get(uri.as_str())
+            .cloned()
+            .expect("accepted document");
+        for context in &consumers {
+            if context.ready.get().is_none() {
+                self.ready(context).await;
+            } else if previous
+                .as_ref()
+                .is_some_and(|prior| prior.consumers.contains(&context.id))
+            {
+                context.backend.on_did_change(params.clone()).await;
+            } else {
+                context
+                    .backend
+                    .on_did_open(DidOpenTextDocumentParams {
+                        text_document: accepted.clone(),
+                    })
+                    .await;
+            }
+        }
+        self.record_routing(uri, &consumers);
+        if retargeted {
+            old_aliases.remove(uri.as_str());
+            self.refresh_source_group(&old_aliases, true).await;
+        }
+        self.refresh_source_group(&aliases, false).await;
+    }
+
+    pub(crate) async fn close_document(&self, params: DidCloseTextDocumentParams) {
+        let _gate = self.gate.write().await;
+        let uri = &params.text_document.uri;
+        let mut aliases = self.source_group(uri);
+        let previous = self.document_routing.write().remove(uri.as_str());
+        let physical = uri.to_file_path().ok().map(|path| normalized(&path));
+        let retargeted = previous
+            .as_ref()
+            .is_some_and(|prior| prior.physical != physical);
+        self.sources.close(uri.as_str());
+        self.documents.write().remove(uri.as_str());
+        let contexts: Vec<_> = self
+            .contexts
+            .read()
+            .iter()
+            .filter(|context| {
+                previous.as_ref().map_or_else(
+                    || context.consumes(uri),
+                    |prior| prior.consumers.contains(&context.id),
+                )
+            })
+            .cloned()
+            .collect();
+        for context in contexts {
+            if context.ready.get().is_none() {
+                continue;
+            }
+            if retargeted {
+                context.backend.forget_consumed_document(uri).await;
+            } else {
+                context.backend.on_did_close(params.clone()).await;
+            }
+        }
+        if retargeted {
+            aliases.remove(uri.as_str());
+        }
+        self.refresh_source_group(&aliases, true).await;
+        self.owners
+            .write()
+            .remove(params.text_document.uri.as_str());
+        self.navigation_versions
+            .write()
+            .remove(params.text_document.uri.as_str());
+        self.document_routing
+            .write()
+            .remove(params.text_document.uri.as_str());
+    }
+    pub(crate) async fn save_document(&self, params: DidSaveTextDocumentParams) {
+        let _gate = self.gate.write().await;
+        for context in self.consumers(&params.text_document.uri) {
+            self.ready(&context).await;
+            context.backend.on_did_save(params.clone()).await;
+        }
+    }
+    pub(crate) async fn change_configuration(&self, params: DidChangeConfigurationParams) {
+        let _gate = self.gate.write().await;
+        for context in self.projects().await {
+            context
+                .backend
+                .did_change_configuration(params.clone())
+                .await;
+        }
+    }
+    pub(crate) async fn watched_files(&self, params: DidChangeWatchedFilesParams) {
+        let _gate = self.gate.write().await;
+        let contexts = self.contexts.read().clone();
+        let topology_changed = params.changes.iter().any(|event| {
+            let name = event
+                .uri
+                .to_file_path()
+                .ok()
+                .and_then(|path| path.file_name().map(|n| n.to_os_string()));
+            name.is_some_and(|name| name == "composer.json" || name == "composer.lock")
+                && contexts.iter().any(|c| c.consumes(&event.uri))
+        });
+        if topology_changed {
+            let params = self.params.read().clone();
+            if let Some(params) = params {
+                let _ = self.rebuild(params).await;
+            }
+            return;
+        }
+        let mut expanded: HashMap<String, FileEvent> = HashMap::new();
+        let mut refresh = HashSet::new();
+        for event in &params.changes {
+            let mut previous = self.source_group(&event.uri);
+            let retargeted = self.sources.revalidate_closed(event.uri.as_str());
+            let mut aliases = self.source_group(&event.uri);
+            if let Some(canonical) = event
+                .uri
+                .to_file_path()
+                .ok()
+                .and_then(|path| path.canonicalize().ok())
+                .and_then(|path| Url::from_file_path(path).ok())
+            {
+                aliases.extend(self.source_group(&canonical));
+            }
+            if retargeted {
+                let old: Vec<_> = contexts
+                    .iter()
+                    .filter(|context| {
+                        context.ready.get().is_some()
+                            && !context.consumes(&event.uri)
+                            && context
+                                .backend
+                                .parsed_uris
+                                .read()
+                                .contains(event.uri.as_str())
+                    })
+                    .cloned()
+                    .collect();
+                for context in old {
+                    context.backend.forget_consumed_document(&event.uri).await;
+                }
+                previous.remove(event.uri.as_str());
+                self.refresh_source_group(&previous, true).await;
+            } else {
+                aliases.extend(previous);
+            }
+            refresh.extend(aliases.iter().cloned());
+            for alias in aliases {
+                if let Ok(uri) = Url::parse(&alias) {
+                    expanded.insert(
+                        alias,
+                        FileEvent {
+                            uri,
+                            typ: event.typ,
+                        },
+                    );
+                }
+            }
+        }
+        let mut expanded: Vec<_> = expanded.into_values().collect();
+        expanded.sort_by(|a, b| a.uri.as_str().cmp(b.uri.as_str()));
+        for context in contexts {
+            let changes: Vec<_> = expanded
+                .iter()
+                .filter(|event| {
+                    context.consumes(&event.uri)
+                        || context
+                            .backend
+                            .parsed_uris
+                            .read()
+                            .contains(event.uri.as_str())
+                })
+                .cloned()
+                .collect();
+            if !changes.is_empty() {
+                self.ready(&context).await;
+                context
+                    .backend
+                    .on_did_change_watched_files(DidChangeWatchedFilesParams { changes })
+                    .await;
+            }
+        }
+        self.refresh_source_group(&refresh, false).await;
+    }
+    async fn retire(&self, contexts: &[Arc<ProjectContext>]) {
+        let mut unregister = Vec::new();
+        for context in contexts {
+            let _ = context.backend.shutdown().await;
+            context.backend.diag.refresh_notify.notify_one();
+            if context.ready.get().is_some() {
+                for method in [
+                    "workspace/didChangeWatchedFiles",
+                    "textDocument/prepareTypeHierarchy",
+                ] {
+                    let base = if method == "textDocument/prepareTypeHierarchy" {
+                        "type-hierarchy"
+                    } else {
+                        method
+                    };
+                    unregister.push(Unregistration {
+                        id: context.backend.project_scope.namespace(base),
+                        method: method.into(),
+                    });
+                }
+            }
+        }
+        if let Some(client) = &self.client
+            && !unregister.is_empty()
+        {
+            let _ = client.unregister_capability(unregister).await;
+        }
+    }
+    fn revoke_builtin_documents(&self) {
+        let retired: Vec<_> = self
+            .documents
+            .read()
+            .values()
+            .filter(|doc| matches!(doc.uri.scheme(), "phpantom-stub" | "phpantom-stub-fn"))
+            .map(|doc| doc.uri.clone())
+            .collect();
+        for uri in retired {
+            self.sources.close(uri.as_str());
+            self.documents.write().remove(uri.as_str());
+        }
+    }
+    async fn rebuild(&self, params: InitializeParams) -> Result<()> {
+        let old = self.contexts.read().clone();
+        let prior: Vec<_> = self
+            .owners
+            .read()
+            .iter()
+            .filter_map(|(uri, id)| {
+                old.iter()
+                    .find(|c| c.id == *id)
+                    .map(|c| (uri.clone(), c.root.clone()))
+            })
+            .collect();
+        self.retire(&old).await;
+        self.owners.write().clear();
+        self.navigation_versions.write().clear();
+        self.configure_projects(params).await?;
+        let contexts = self.contexts.read().clone();
+        self.revoke_builtin_documents();
+        for (uri, root) in prior {
+            if Url::parse(&uri)
+                .is_ok_and(|uri| matches!(uri.scheme(), "phpantom-stub" | "phpantom-stub-fn"))
+            {
+                continue;
+            }
+            if let Some(context) = contexts.iter().find(|c| c.root == root) {
+                self.owners.write().insert(uri, context.id);
+            }
+        }
+        for context in contexts {
+            self.ready(&context).await;
+        }
+        let open_uris: Vec<_> = self
+            .documents
+            .read()
+            .values()
+            .map(|doc| doc.uri.clone())
+            .collect();
+        self.document_routing.write().clear();
+        for uri in open_uris {
+            self.record_routing(&uri, &self.consumers(&uri));
+        }
+        Ok(())
+    }
+    pub(crate) async fn change_workspace_folders(&self, params: DidChangeWorkspaceFoldersParams) {
+        let _gate = self.gate.write().await;
+        let mut initialize = match self.params.read().clone() {
+            Some(params) => params,
+            None => return,
+        };
+        let folders = initialize.workspace_folders.get_or_insert_with(Vec::new);
+        folders.retain(|folder| {
+            !params
+                .event
+                .removed
+                .iter()
+                .any(|removed| removed.uri == folder.uri)
+        });
+        for added in params.event.added {
+            if !folders.iter().any(|f| f.uri == added.uri) {
+                folders.push(added);
+            }
+        }
+        initialize.root_uri = folders.first().map(|folder| folder.uri.clone());
+        let _ = self.rebuild(initialize).await;
+    }
+    pub(crate) async fn shutdown_projects(&self) -> Result<()> {
+        let _gate = self.gate.write().await;
+        let contexts = self.contexts.read().clone();
+        for context in contexts {
+            context.backend.shutdown().await?;
+            context.backend.diag.refresh_notify.notify_one();
+        }
+        Ok(())
+    }
+    pub(crate) fn tag_data(&self, project: &ProjectContext, data: &mut Option<Value>) {
+        *data = Some(serde_json::json!({"_phpWorkbenchProject":project.id,"payload":data.take()}));

+#[tokio::test]
+async fn composer_project_contexts_builtin_documents_retain_target_and_reject_retired_identity() {
+    let fixture = projects_with_distinct_php_targets();
+    let router = full_stub_router(&fixture).await;
+    let a = fixture.path("a", "builtin.php");
+    let b = fixture.path("b", "builtin.php");
+    let a_source = open(&router, &a).await;
+    let b_source = open(&router, &b).await;
+    let b_uri = datetime_definition(&router, &b, &b_source).await;
+    let a_uri = datetime_definition(&router, &a, &a_source).await;
+    assert_eq!(a_uri.scheme(), "phpantom-stub");
+    assert_eq!(b_uri.scheme(), "phpantom-stub");
+    assert_ne!(
+        a_uri, b_uri,
+        "same embedded class must retain its consuming graph identity"
+    );
+    for uri in [&a_uri, &b_uri] {
+        let query: Vec<_> = uri.query_pairs().collect();
+        assert_eq!(query.len(), 1, "unexpected builtin identity shape: {uri}");
+        assert_eq!(query[0].0, "project_context");
+        assert!(
+            query[0].1.parse::<u64>().is_ok_and(|id| id > 0),
+            "invalid graph identity: {uri}"
+        );
+    }
+    let mut a_raw = a_uri.clone();
+    let mut b_raw = b_uri.clone();
+    a_raw.set_query(None);
+    b_raw.set_query(None);
+    assert_eq!(
+        a_raw, b_raw,
+        "the underlying DateTime declaration may be shared, not its graph identity"
+    );
+    let a_document = router
+        .workbench_builtin(BuiltinQuery {
+            uri: a_uri.to_string(),
+        })
+        .await
+        .unwrap();
+    let b_document = router
+        .workbench_builtin(BuiltinQuery {
+            uri: b_uri.to_string(),
+        })
+        .await
+        .unwrap();
+    assert_eq!(a_document.uri, a_uri.as_str());
+    assert_eq!(b_document.uri, b_uri.as_str());
+    assert!(a_document.content.contains("class DateTime"));
+    assert_eq!(
+        a_document.content, b_document.content,
+        "return raw embedded source without rewriting declaration coordinates"
+    );
+    let folders = project_folders(&fixture);
+    router
+        .did_change_workspace_folders(DidChangeWorkspaceFoldersParams {
+            event: WorkspaceFoldersChangeEvent {
+                added: Vec::new(),
+                removed: vec![folders[1].clone()],
+            },
+        })
+        .await;
+    for uri in [&a_uri, &b_uri] {
+        assert!(
+            router
+                .workbench_builtin(BuiltinQuery {
+                    uri: uri.to_string()
+                })
+                .await
+                .is_err(),
+            "retired builtin custom query must not fall back: {uri}"
+        );
+        assert!(
+            router
+                .hover(HoverParams {
+                    text_document_position_params: TextDocumentPositionParams {
+                        text_document: TextDocumentIdentifier { uri: uri.clone() },
+                        position: Position::new(0, 0),
+                    },
+                    work_done_progress_params: WorkDoneProgressParams::default(),
+                })
+                .await
+                .is_err(),
+            "retired builtin direct request must not fall back: {uri}"
+        );
+    }
+    let fresh = datetime_definition(&router, &a, &a_source).await;
+    assert_ne!(
+        fresh, a_uri,
+        "fresh graph must issue a fresh builtin identity"
+    );
+    let fresh_document = router
+        .workbench_builtin(BuiltinQuery {
+            uri: fresh.to_string(),
+        })
+        .await
+        .unwrap();
+    assert_eq!(fresh_document.uri, fresh.as_str());
+    assert_eq!(fresh_document.content, a_document.content);
+    router.shutdown().await.unwrap();
+}
diff --git a/tests/integration/composer_project_diagnostics.rs b/tests/integration/composer_project_diagnostics.rs
new file mode 100644
--- /dev/null
+++ b/tests/integration/composer_project_diagnostics.rs
@@ -0,0 +1,328 @@
+//! Real transport notifications retain host diagnostic ownership across replay.
+use std::fs;
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant};
+
+use phpantom_lsp::ProjectRouter;
+use serde_json::{Value, json};
+use tower_lsp::lsp_types::Url;
+
+use crate::common::lsp_transport::{TransportClient, serve};
+
+const SOURCE: &str = "<?php\nfunction diagnostic_fixture(): void {}\n";
+const CONFIG: &str = "[indexing]\nstrategy = \"none\"\n[diagnostics]\nworkspace = false\n[phpstan]\ncommand = \"\"\n[phpcs]\ncommand = \"\"\n[phpmd]\ncommand = \"\"\n[mago]\ncommand = \"\"\n";
+
+fn write(root: &Path, relative: &str, content: &str) {
+    let path = root.join(relative);
+    fs::create_dir_all(path.parent().unwrap()).unwrap();
+    fs::write(path, content).unwrap();
+}
+
+fn projects() -> (tempfile::TempDir, PathBuf) {
+    let directory = tempfile::tempdir().unwrap();
+    let root = directory.path().canonicalize().unwrap();
+    for project in ["a", "b"] {
+        write(
+            &root,
+            &format!("apps/{project}/composer.json"),
+            &json!({"name":format!("fixture/{project}"),"autoload":{"psr-4":{"App\\":"src/"}}})
+                .to_string(),
+        );
+        write(&root, &format!("apps/{project}/.phpantom.toml"), CONFIG);
+        write(&root, &format!("apps/{project}/index.php"), SOURCE);
+    }
+    (directory, root)
+}
+
+struct Wire {
+    client: TransportClient,
+    seen: Vec<Value>,
+    serial: u64,
+}
+
+impl Wire {
+    async fn start(root: &Path) -> Self {
+        let mut wire = Self {
+            client: serve(ProjectRouter::new),
+            seen: Vec::new(),
+            serial: 0,
+        };
+        let folders: Vec<_> = ["a", "b"].into_iter().map(|name| json!({
+            "uri":Url::from_directory_path(root.join("apps").join(name)).unwrap(),"name":name
+        })).collect();
+        wire.request(
+            "initialize",
+            json!({"capabilities":{},"workspaceFolders":folders}),
+        )
+        .await;
+        wire.notify("initialized", json!({})).await;
+        wire
+    }
+
+    async fn notify(&mut self, method: &str, params: Value) {
+        let mut message = json!({"jsonrpc":"2.0","method":method});
+        if method != "exit" {
+            message["params"] = params;
+        }
+        self.client.send(method, message).await;
+    }
+
+    async fn next(&mut self) -> Value {
+        let message = tokio::time::timeout(
+            Duration::from_secs(30),
+            self.client
+                .read_until("router diagnostic traffic", |_| true),
+        )
+        .await
+        .expect("real project router stopped producing protocol traffic");
+        self.seen.push(message.clone());
+        // Real Backend startup/rebuild can request dynamic registration and
+        // refresh. Answer them rather than wedging its client request channel.
+        if let (Some(method), Some(id)) = (
+            message.get("method").and_then(Value::as_str),
+            message.get("id"),
+        ) {
+            let result = if method == "workspace/configuration" {
+                let count = message["params"]["items"].as_array().map_or(0, Vec::len);
+                Value::Array(vec![Value::Null; count])
+            } else {
+                Value::Null
+            };
+            self.client
+                .send(
+                    "server-to-client response",
+                    json!({"jsonrpc":"2.0","id":id,"result":result}),
+                )
+                .await;
+        }
+        message
+    }
+
+    async fn request(&mut self, method: &str, params: Value) -> Value {
+        self.serial += 1;
+        let id = self.serial;
+        let mut message = json!({"jsonrpc":"2.0","id":id,"method":method});
+        if method != "shutdown" {
+            message["params"] = params;
+        }
+        self.client.send(method, message).await;
+        let deadline = Instant::now() + Duration::from_secs(30);
+        loop {
+            assert!(
+                Instant::now() < deadline,
+                "timed out awaiting {method}; traffic: {:?}",
+                self.seen
+            );
+            let message = self.next().await;
+            if message.get("method").is_none()
+                && message.get("id").and_then(Value::as_u64) == Some(id)
+            {
+                assert!(message.get("error").is_none(), "{method} failed: {message}");
+                return message["result"].clone();
+            }
+        }
+    }
+
+    async fn open(&mut self, uri: &Url, version: i32, text: &str) {
+        self.notify(
+            "textDocument/didOpen",
+            json!({"textDocument":{
+                "uri":uri,"languageId":"php","version":version,"text":text
+            }}),
+        )
+        .await;
+    }
+
+    async fn change(&mut self, uri: &Url, version: i32, text: &str) {
+        self.notify(
+            "textDocument/didChange",
+            json!({"textDocument":{"uri":uri,"version":version},
+            "contentChanges":[{"text":text}]}),
+        )
+        .await;
+    }
+
+    async fn barrier(&mut self, uri: &Url) {
+        self.request(
+            "textDocument/documentSymbol",
+            json!({"textDocument":{"uri":uri}}),
+        )
+        .await;
+    }
+
+    async fn publication(
+        &mut self,
+        uri: &Url,
+        version: i32,
+        complete: Option<bool>,
+        since: usize,
+    ) -> Value {
+        let deadline = Instant::now() + Duration::from_secs(30);
+        loop {
+            if let Some(message) = self.seen[since..].iter().find(|message| {
+                message["method"] == "textDocument/publishDiagnostics"
+                    && message["params"]["uri"].as_str() == Some(uri.as_str())
+                    && message["params"]["version"].as_i64() == Some(i64::from(version))
+                    && complete.is_none_or(|expected| {
+                        message["params"]["phpantomDiagnosticComplete"].as_bool() == Some(expected)
+                    })
+            }) {
+                return message["params"].clone();
+            }
+            assert!(
+                Instant::now() < deadline,
+                "missing publication for {uri} version {version}: {:?}",
+                self.seen
+            );
+            self.next().await;
+        }
+    }
+
+    async fn finish(&mut self) {
+        self.request("shutdown", json!(null)).await;
+        self.notify("exit", json!(null)).await;
+    }
+}
+
+fn envelope(publication: &Value, version: i32, opening: u64) -> u64 {
+    assert_eq!(
+        publication["version"].as_i64(),
+        Some(i64::from(version)),
+        "wrong client version: {publication}"
+    );
+    assert_eq!(
+        publication["phpantomDocumentOpen"].as_u64(),
+        Some(opening),
+        "wrong client opening: {publication}"
+    );
+    assert!(
+        publication["phpantomDiagnosticComplete"].is_boolean(),
+        "missing complete stamp: {publication}"
+    );
+    let sequence = publication["phpantomDiagnosticSequence"]
+        .as_u64()
+        .expect("host rejects notifications without publication sequence");
+    assert!(sequence > 0, "host rejects sequence zero: {publication}");
+    sequence
+}
+
+async fn replay_preserves_envelope(kind: &str) {
+    let (_directory, root) = projects();
+    let uri = Url::from_file_path(root.join("apps/a/index.php")).unwrap();
+    let mut wire = Wire::start(&root).await;
+    wire.open(&uri, 1, SOURCE).await;
+    let first = wire.publication(&uri, 1, Some(true), 0).await;
+    let mut last_sequence = envelope(&first, 1, 1);
+    wire.notify("textDocument/didClose", json!({"textDocument":{"uri":uri}}))
+        .await;
+    wire.barrier(&uri).await;
+    let since = wire.seen.len();
+    wire.open(&uri, 1, SOURCE).await;
+    let reopened = wire.publication(&uri, 1, Some(true), since).await;
+    let sequence = envelope(&reopened, 1, 2);
+    assert!(
+        sequence > last_sequence,
+        "reopen must advance publication order"
+    );
+    last_sequence = sequence;
+    // Raise the old publication floor before replacing its semantic graph.
+    // Waiting for each real completed native pass avoids timing assumptions.
+    for version in 2..=4 {
+        let since = wire.seen.len();
+        wire.change(&uri, version, &format!("{SOURCE}// edit {version}\n"))
+            .await;
+        let current = wire.publication(&uri, version, Some(true), since).await;
+        let sequence = envelope(&current, version, 2);
+        assert!(sequence > last_sequence);
+        last_sequence = sequence;
+    }
+    match kind {
+        "folders" => wire.notify("workspace/didChangeWorkspaceFolders", json!({"event":{
+            "added":[],"removed":[{"uri":Url::from_directory_path(root.join("apps/b")).unwrap(),"name":"b"}]
+        }})).await,
+        "composer" => wire.notify("workspace/didChangeWatchedFiles", json!({"changes":[{
+            "uri":Url::from_file_path(root.join("apps/a/composer.json")).unwrap(),"type":2
+        }]})).await,
+        "settings" => wire.notify("workspace/didChangeConfiguration", json!({"settings":{}})).await,
+        _ => unreachable!(),
+    }
+    wire.barrier(&uri).await;
+    let since = wire.seen.len();
+    // Only the replayed/current child can publish this new version, so an
+    // earlier in-flight old-child notification cannot make the test pass.
+    wire.change(&uri, 5, &format!("{SOURCE}// after {kind} replay\n"))
+        .await;
+    let replayed = wire.publication(&uri, 5, Some(true), since).await;
+    let sequence = envelope(&replayed, 5, 2);
+    assert!(
+        sequence > last_sequence,
+        "replay reset publication order: before={last_sequence}, after={replayed}"
+    );
+    wire.finish().await;
+    assert_eq!(
+        fs::read_to_string(uri.to_file_path().unwrap()).unwrap(),
+        SOURCE
+    );
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn composer_project_diagnostics_folder_replay_preserves_opening_and_sequence() {
+    replay_preserves_envelope("folders").await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn composer_project_diagnostics_composer_replay_preserves_opening_and_sequence() {
+    replay_preserves_envelope("composer").await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn composer_project_diagnostics_settings_control_preserves_opening_and_sequence() {
+    replay_preserves_envelope("settings").await;
+}
+
+#[cfg(unix)]
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn composer_project_diagnostics_passive_alias_clear_carries_client_envelope() {
+    let (_directory, root) = projects();
+    let original =
+        "<?php\nnamespace Shared;\nclass Gateway { public function original(): void {} }\n";
+    write(&root, "packages/shared/src/Gateway.php", original);
+    for project in ["a", "b"] {
+        write(
+            &root,
+            &format!("apps/{project}/vendor/composer/autoload_classmap.php"),
+            "<?php\n$vendorDir = dirname(__DIR__);\nreturn array(\n    'Shared\\\\Gateway' => $vendorDir . '/acme/shared/src/Gateway.php',\n);\n",
+        );
+        let alias = root.join(format!("apps/{project}/vendor/acme/shared"));
+        fs::create_dir_all(alias.parent().unwrap()).unwrap();
+        std::os::unix::fs::symlink(root.join("packages/shared"), alias).unwrap();
+    }
+    let a = Url::from_file_path(root.join("apps/a/vendor/acme/shared/src/Gateway.php")).unwrap();
+    let b = Url::from_file_path(root.join("apps/b/vendor/acme/shared/src/Gateway.php")).unwrap();
+    let mut wire = Wire::start(&root).await;
+    wire.open(&a, 1, original).await;
+    let a_initial = wire.publication(&a, 1, Some(true), 0).await;
+    let a_sequence = envelope(&a_initial, 1, 1);
+    let since = wire.seen.len();
+    wire.open(&b, 1, original).await;
+    let passive_b = wire.publication(&b, 1, None, since).await;
+    envelope(&passive_b, 1, 1);
+    assert_eq!(passive_b["diagnostics"], json!([]));
+    let since = wire.seen.len();
+    wire.change(&b, 2, &original.replace("original", "changed"))
+        .await;
+    let passive_a = wire.publication(&a, 1, None, since).await;
+    let clear_sequence = envelope(&passive_a, 1, 1);
+    assert!(
+        clear_sequence > a_sequence,
+        "passive clear must advance A's publication floor"
+    );
+    assert_eq!(passive_a["diagnostics"], json!([]));
+    let active_b = wire.publication(&b, 2, Some(true), since).await;
+    envelope(&active_b, 2, 1);
+    wire.finish().await;
+    assert_eq!(
+        fs::read_to_string(root.join("packages/shared/src/Gateway.php")).unwrap(),
+        original
+    );
+}
diff --git a/tests/integration/composer_project_retarget.rs b/tests/integration/composer_project_retarget.rs
new file mode 100644
--- /dev/null
+++ b/tests/integration/composer_project_retarget.rs
@@ -0,0 +1,298 @@
+//! Retargeting one editor URI transfers its full overlay between consumers.
+#![cfg(unix)]
+
+use std::fs;
+use std::path::Path;
+
+use phpantom_lsp::ProjectRouter;
+use tower_lsp::LanguageServer;
+use tower_lsp::lsp_types::*;
+
+use crate::common::{position_after, position_of};
+
+fn write(root: &Path, relative: &str, text: &str) {
+    let path = root.join(relative);
+    fs::create_dir_all(path.parent().unwrap()).unwrap();
+    fs::write(path, text).unwrap();
+}
+
+async fn open(router: &ProjectRouter, path: &Path) -> String {
+    let text = fs::read_to_string(path).unwrap();
+    router
+        .did_open(DidOpenTextDocumentParams {
+            text_document: TextDocumentItem {
+                uri: Url::from_file_path(path).unwrap(),
+                language_id: "php".into(),
+                version: 1,
+                text: text.clone(),
+            },
+        })
+        .await;
+    text
+}
+
+async fn change(
+    router: &ProjectRouter,
+    path: &Path,
+    version: i32,
+    range: Option<Range>,
+    text: &str,
+) {
+    router
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: Url::from_file_path(path).unwrap(),
+                version,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range,
+                range_length: None,
+                text: text.into(),
+            }],
+        })
+        .await;
+}
+
+async fn close(router: &ProjectRouter, path: &Path) {
+    router
+        .did_close(DidCloseTextDocumentParams {
+            text_document: TextDocumentIdentifier {
+                uri: Url::from_file_path(path).unwrap(),
+            },
+        })
+        .await;
+}
+
+async fn assert_members(
+    router: &ProjectRouter,
+    path: &Path,
+    source: &str,
+    own: &str,
+    absent: &[&str],
+) {
+    let response = router
+        .completion(CompletionParams {
+            text_document_position: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier {
+                    uri: Url::from_file_path(path).unwrap(),
+                },
+                position: position_after(source, "$value->"),
+            },
+            context: None,
+            work_done_progress_params: WorkDoneProgressParams::default(),
+            partial_result_params: PartialResultParams::default(),
+        })
+        .await
+        .unwrap();
+    let items = match response {
+        Some(CompletionResponse::Array(items)) => items,
+        Some(CompletionResponse::List(list)) => list.items,
+        None => Vec::new(),
+    };
+    let labels: Vec<_> = items
+        .iter()
+        .map(|item| item.label.split('(').next().unwrap())
+        .collect();
+    assert!(
+        labels.contains(&own),
+        "{} missing {own}: {labels:?}",
+        path.display()
+    );
+    for name in absent {
+        assert!(
+            !labels.contains(name),
+            "{} retained foreign/stale {name}: {labels:?}",
+            path.display()
+        );
+    }
+}
+
+#[tokio::test]
+async fn composer_project_retarget_retires_old_consumer_and_opens_new_with_current_version() {
+    let directory = tempfile::tempdir().unwrap();
+    let root = directory.path().canonicalize().unwrap();
+    let old_source = "<?php\nnamespace Shared;\nclass Gateway {\n    public function service(): \\App\\Service { return new \\App\\Service(); }\n    public function originOld(): void {}\n}\n";
+    let new_source = old_source.replace("originOld", "originNew");
+    write(&root, "packages/old/src/Gateway.php", old_source);
+    write(&root, "packages/new/src/Gateway.php", &new_source);
+    let caller = "<?php\n$value = (new \\Shared\\Gateway())->service();\n$value->\n";
+    for (project, upper, package) in [("a", "A", "old"), ("b", "B", "new")] {
+        write(
+            &root,
+            &format!("apps/{project}/composer.json"),
+            &serde_json::json!({"name":format!("fixture/{project}"),
+                "autoload":{"psr-4":{"App\\":"src/"}}})
+            .to_string(),
+        );
+        write(
+            &root,
+            &format!("apps/{project}/.phpantom.toml"),
+            "[indexing]\nstrategy = \"none\"\n",
+        );
+        for (class, suffix) in [
+            ("Service", ""),
+            ("Replacement", "Replacement"),
+            ("Latest", "Latest"),
+        ] {
+            write(
+                &root,
+                &format!("apps/{project}/src/{class}.php"),
+                &format!(
+                    "<?php\nnamespace App;\nclass {class} {{ public function from{upper}{suffix}(): void {{}} }}\n"
+                ),
+            );
+        }
+        write(&root, &format!("apps/{project}/index.php"), caller);
+        write(
+            &root,
+            &format!("apps/{project}/vendor/composer/autoload_classmap.php"),
+            "<?php\n$vendorDir = dirname(__DIR__);\nreturn array(\n    'Shared\\\\Gateway' => $vendorDir . '/acme/shared/src/Gateway.php',\n);\n",
+        );
+        let alias = root.join(format!("apps/{project}/vendor/acme/shared"));
+        fs::create_dir_all(alias.parent().unwrap()).unwrap();
+        std::os::unix::fs::symlink(root.join("packages").join(package), alias).unwrap();
+    }
+    let editor_alias = root.join("editor/current.php");
+    fs::create_dir_all(editor_alias.parent().unwrap()).unwrap();
+    let old_physical = root.join("packages/old/src/Gateway.php");
+    let new_physical = root.join("packages/new/src/Gateway.php");
+    std::os::unix::fs::symlink(&old_physical, &editor_alias).unwrap();
+    let router = ProjectRouter::new_test();
+    router
+        .initialize(InitializeParams {
+            workspace_folders: Some(
+                ["a", "b"]
+                    .into_iter()
+                    .map(|project| WorkspaceFolder {
+                        uri: Url::from_directory_path(root.join("apps").join(project)).unwrap(),
+                        name: project.into(),
+                    })
+                    .collect(),
+            ),
+            ..InitializeParams::default()
+        })
+        .await
+        .unwrap();
+    router.initialized(InitializedParams {}).await;
+    let a = root.join("apps/a/index.php");
+    let b = root.join("apps/b/index.php");
+    let a_caller = open(&router, &a).await;
+    let b_caller = open(&router, &b).await;
+    assert_members(
+        &router,
+        &a,
+        &a_caller,
+        "fromA",
+        &["fromB", "fromAReplacement"],
+    )
+    .await;
+    assert_members(
+        &router,
+        &b,
+        &b_caller,
+        "fromB",
+        &["fromA", "fromBReplacement"],
+    )
+    .await;
+    // Keep a passive document for the old physical target. Its actual original
+    // text must become authority after the active editor URI moves elsewhere.
+    let old_passive = root.join("apps/a/vendor/acme/shared/src/Gateway.php");
+    assert_eq!(open(&router, &old_passive).await, old_source);
+    assert_eq!(open(&router, &editor_alias).await, old_source);
+    let old_dirty = old_source.replace("App\\Service", "App\\Replacement");
+    change(&router, &editor_alias, 2, None, &old_dirty).await;
+    assert_members(
+        &router,
+        &a,
+        &a_caller,
+        "fromAReplacement",
+        &["fromA", "fromBReplacement"],
+    )
+    .await;
+    assert_members(
+        &router,
+        &b,
+        &b_caller,
+        "fromB",
+        &["fromBReplacement", "fromAReplacement"],
+    )
+    .await;
+
+    // Retarget only our temporary symlink; the client's URI is unchanged.
+    fs::remove_file(&editor_alias).unwrap();
+    std::os::unix::fs::symlink(&new_physical, &editor_alias).unwrap();
+    assert_eq!(editor_alias.canonicalize().unwrap(), new_physical);
+    let new_dirty = new_source.replace("App\\Service", "App\\Replacement");
+    change(&router, &editor_alias, 3, None, &new_dirty).await;
+    assert_members(
+        &router,
+        &a,
+        &a_caller,
+        "fromA",
+        &["fromAReplacement", "fromBReplacement"],
+    )
+    .await;
+    assert_members(
+        &router,
+        &b,
+        &b_caller,
+        "fromBReplacement",
+        &["fromB", "fromAReplacement"],
+    )
+    .await;
+    // New consumer B must have the real version-3 whole document, not an
+    // ignored change to a never-opened buffer or an invented local version.
+    change(&router, &editor_alias, 2, None, &new_source).await;
+    assert_members(&router, &b, &b_caller, "fromBReplacement", &["fromB"]).await;
+    let before =
+        "public function service(): \\App\\Replacement { return new \\App\\Replacement(); }";
+    let after = "public function service(): \\App\\Latest { return new \\App\\Latest(); }";
+    change(
+        &router,
+        &editor_alias,
+        4,
+        Some(Range::new(
+            position_of(&new_dirty, before),
+            position_after(&new_dirty, before),
+        )),
+        after,
+    )
+    .await;
+    assert_members(
+        &router,
+        &b,
+        &b_caller,
+        "fromBLatest",
+        &["fromB", "fromBReplacement", "fromALatest"],
+    )
+    .await;
+    assert_members(
+        &router,
+        &a,
+        &a_caller,
+        "fromA",
+        &["fromAReplacement", "fromALatest"],
+    )
+    .await;
+    close(&router, &editor_alias).await;
+    assert_members(
+        &router,
+        &b,
+        &b_caller,
+        "fromB",
+        &["fromBReplacement", "fromBLatest"],
+    )
+    .await;
+    assert_members(
+        &router,
+        &a,
+        &a_caller,
+        "fromA",
+        &["fromAReplacement", "fromALatest"],
+    )
+    .await;
+    close(&router, &old_passive).await;
+    assert_eq!(fs::read_to_string(&old_physical).unwrap(), old_source);
+    assert_eq!(fs::read_to_string(&new_physical).unwrap(), new_source);
+    router.shutdown().await.unwrap();
+}

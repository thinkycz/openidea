+//! Watched physical changes reconcile every previously cached source spelling.
+#![cfg(unix)]
+
+use std::fs;
+use std::path::Path;
+
+use phpantom_lsp::ProjectRouter;
+use tower_lsp::LanguageServer;
+use tower_lsp::lsp_types::*;
+
+use super::composer_project_aliases::{
+    GATEWAY_SOURCE, HELPER_CALLER, HELPERS_SOURCE, alias_router, assert_both,
+    assert_helper_definition, assert_helper_symbols, assert_members,
+    assert_no_helper_return_members, close_alias, helper_alias_projects, open, replace, write,
+};
+use crate::common::{definition_locations, position_of};
+
+fn changed(source: &str) -> String {
+    source
+        .replace("App\\Service", "App\\Replacement")
+        .replace("removed_helper", "added_helper")
+        .replace("REMOVED_CONSTANT", "ADDED_CONSTANT")
+        .replace("RemovedHelperClass", "AddedHelperClass")
+}
+
+async fn watch(router: &ProjectRouter, path: &Path, typ: FileChangeType) {
+    router
+        .did_change_watched_files(DidChangeWatchedFilesParams {
+            changes: vec![FileEvent {
+                uri: Url::from_file_path(path).unwrap(),
+                typ,
+            }],
+        })
+        .await;
+}
+
+#[tokio::test]
+async fn composer_watched_closed_vendor_alias_change_replaces_every_cached_symbol_spelling() {
+    let (_directory, root) = helper_alias_projects();
+    let router = alias_router(&root).await;
+    let a = root.join("apps/a/helper.php");
+    let b = root.join("apps/b/helper.php");
+    let callers = [
+        (a.clone(), open(&router, &a).await),
+        (b.clone(), open(&router, &b).await),
+    ];
+    let a_alias = root.join("apps/a/vendor/acme/shared/src/Helpers.php");
+    let b_alias = root.join("apps/b/vendor/acme/shared/src/Helpers.php");
+    let physical = a_alias.canonicalize().unwrap();
+    assert_eq!(physical, b_alias.canonicalize().unwrap());
+    // Warm both saved aliases, without ever opening either declaration URI.
+    assert_helper_symbols(&router, &callers, &physical, false).await;
+    let updated = changed(HELPERS_SOURCE);
+    fs::write(&physical, &updated).unwrap();
+    watch(&router, &b_alias, FileChangeType::CHANGED).await;
+    assert_helper_symbols(&router, &callers, &physical, true).await;
+    fs::write(&physical, HELPERS_SOURCE).unwrap();
+    watch(&router, &a_alias, FileChangeType::CHANGED).await;
+    assert_helper_symbols(&router, &callers, &physical, false).await;
+    assert_eq!(fs::read_to_string(&a_alias).unwrap(), HELPERS_SOURCE);
+    assert_eq!(fs::read_to_string(&b_alias).unwrap(), HELPERS_SOURCE);
+    router.shutdown().await.unwrap();
+}
+
+#[tokio::test]
+async fn composer_watched_closed_external_alias_retarget_preserves_both_definition_identities() {
+    let (_directory, root) = helper_alias_projects();
+    let old_physical = root.join("packages/shared/src/Helpers.php");
+    let new_physical = root.join("packages/alternate/src/Helpers.php");
+    write(&root, "packages/alternate/src/Helpers.php", HELPERS_SOURCE);
+    write(&root, "packages/alternate/src/Gateway.php", GATEWAY_SOURCE);
+    let b_vendor = root.join("apps/b/vendor/acme/shared");
+    fs::remove_file(&b_vendor).unwrap();
+    std::os::unix::fs::symlink(root.join("packages/alternate"), &b_vendor).unwrap();
+    let external = root.join("watch/source.php");
+    fs::create_dir_all(external.parent().unwrap()).unwrap();
+    std::os::unix::fs::symlink(&old_physical, &external).unwrap();
+    let router = alias_router(&root).await;
+    let a = root.join("apps/a/helper.php");
+    let b = root.join("apps/b/helper.php");
+    let callers = [
+        (a.clone(), open(&router, &a).await),
+        (b.clone(), open(&router, &b).await),
+    ];
+    assert_both(&router, &callers, false).await;
+    for (path, physical) in [(&a, &old_physical), (&b, &new_physical)] {
+        for needle in [
+            "make_service",
+            "removed_helper",
+            "REMOVED_CONSTANT",
+            "RemovedHelperClass",
+        ] {
+            assert_helper_definition(&router, path, needle, Some(physical)).await;
+        }
+    }
+    // The external spelling is observed only as a saved watcher source.
+    // It never receives didOpen, didChange, or an editor overlay.
+    let old_saved = format!("{HELPERS_SOURCE}// watched old physical source\n");
+    fs::write(&old_physical, &old_saved).unwrap();
+    watch(&router, &external, FileChangeType::CHANGED).await;
+    assert_members(
+        &router,
+        &a,
+        HELPER_CALLER,
+        "fromA",
+        &["fromAReplacement", "fromB"],
+    )
+    .await;
+    fs::remove_file(&external).unwrap();
+    std::os::unix::fs::symlink(&new_physical, &external).unwrap();
+    let new_saved = changed(HELPERS_SOURCE);
+    fs::write(&new_physical, &new_saved).unwrap();
+    watch(&router, &external, FileChangeType::CHANGED).await;
+    assert_members(
+        &router,
+        &a,
+        HELPER_CALLER,
+        "fromA",
+        &["fromAReplacement", "fromBReplacement"],
+    )
+    .await;
+    assert_members(
+        &router,
+        &b,
+        HELPER_CALLER,
+        "fromBReplacement",
+        &["fromB", "fromAReplacement"],
+    )
+    .await;
+    for (old, new) in [
+        ("removed_helper", "added_helper"),
+        ("REMOVED_CONSTANT", "ADDED_CONSTANT"),
+        ("RemovedHelperClass", "AddedHelperClass"),
+    ] {
+        assert_helper_definition(&router, &a, old, Some(&old_physical)).await;
+        assert_helper_definition(&router, &a, new, None).await;
+        assert_helper_definition(&router, &b, old, None).await;
+        assert_helper_definition(&router, &b, new, Some(&new_physical)).await;
+    }
+    assert_helper_definition(&router, &a, "make_service", Some(&old_physical)).await;
+    assert_helper_definition(&router, &b, "make_service", Some(&new_physical)).await;
+    assert_ne!(
+        old_physical.canonicalize().unwrap(),
+        external.canonicalize().unwrap()
+    );
+    assert_eq!(
+        external.canonicalize().unwrap(),
+        new_physical.canonicalize().unwrap()
+    );
+    assert_eq!(fs::read_to_string(&old_physical).unwrap(), old_saved);
+    assert_eq!(fs::read_to_string(&new_physical).unwrap(), new_saved);
+    router.shutdown().await.unwrap();
+}
+
+#[tokio::test]
+async fn composer_watched_delete_preserves_other_alias_dirty_overlay_until_final_close() {
+    let (_directory, root) = helper_alias_projects();
+    let router = alias_router(&root).await;
+    let a = root.join("apps/a/helper.php");
+    let b = root.join("apps/b/helper.php");
+    let callers = [
+        (a.clone(), open(&router, &a).await),
+        (b.clone(), open(&router, &b).await),
+    ];
+    let a_alias = root.join("apps/a/vendor/acme/shared/src/Helpers.php");
+    let b_alias = root.join("apps/b/vendor/acme/shared/src/Helpers.php");
+    let physical = a_alias.canonicalize().unwrap();
+    assert_helper_symbols(&router, &callers, &physical, false).await;
+    open(&router, &a_alias).await;
+    replace(&router, &a_alias, 2, &changed(HELPERS_SOURCE)).await;
+    assert_helper_symbols(&router, &callers, &physical, true).await;
+    fs::remove_file(&physical).unwrap();
+    watch(&router, &b_alias, FileChangeType::DELETED).await;
+    assert_both(&router, &callers, true).await;
+    for (path, _) in &callers {
+        for needle in [
+            "make_service",
+            "added_helper",
+            "ADDED_CONSTANT",
+            "AddedHelperClass",
+        ] {
+            let result = router
+                .goto_definition(GotoDefinitionParams {
+                    text_document_position_params: TextDocumentPositionParams {
+                        text_document: TextDocumentIdentifier {
+                            uri: Url::from_file_path(path).unwrap(),
+                        },
+                        position: position_of(HELPER_CALLER, needle),
+                    },
+                    work_done_progress_params: WorkDoneProgressParams::default(),
+                    partial_result_params: PartialResultParams::default(),
+                })
+                .await
+                .unwrap();
+            let locations = definition_locations(result);
+            assert_eq!(locations.len(), 1, "dirty live {needle}: {locations:?}");
+            assert_eq!(
+                locations[0].uri,
+                Url::from_file_path(&a_alias).unwrap(),
+                "deleted disk alias must not replace actual live editor coordinates"
+            );
+        }
+    }
+    close_alias(&router, &a_alias).await;
+    for (path, _) in &callers {
+        for needle in [
+            "make_service",
+            "removed_helper",
+            "added_helper",
+            "REMOVED_CONSTANT",
+            "ADDED_CONSTANT",
+            "RemovedHelperClass",
+            "AddedHelperClass",
+        ] {
+            assert_helper_definition(&router, path, needle, None).await;
+        }
+        assert_no_helper_return_members(&router, path).await;
+    }
+    assert!(!physical.exists());
+    assert!(!a_alias.exists());
+    assert!(!b_alias.exists());
+    router.shutdown().await.unwrap();
+}

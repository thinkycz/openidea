+        if let Some(items) = &mut result {
+            for item in items {
+                self.tag_data(&project, &mut item.data);
+            }
+        }
+        self.qualify_locations(&project, &mut result)?;
+        Ok(result)
+    }
+
+    async fn incoming_calls(
+        &self,
+        mut params: CallHierarchyIncomingCallsParams,
+    ) -> Result<Option<Vec<CallHierarchyIncomingCall>>> {
+        let _request = self.request_guard().await;
+        let project = self.project_from_data(&mut params.item.data).await?;
+        let mut result = project.backend.incoming_calls(params).await?;
+        if let Some(calls) = &mut result {
+            for call in calls {
+                self.tag_data(&project, &mut call.from.data);
+            }
+        }
+        self.qualify_locations(&project, &mut result)?;
+        Ok(result)
+    }
+
+    async fn outgoing_calls(

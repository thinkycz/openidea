+pub(super) const HELPERS_SOURCE: &str = "<?php\nnamespace Shared;\nconst REMOVED_CONSTANT = 'original';\nfunction make_service(): \\App\\Service { return new \\App\\Service(); }\nfunction removed_helper(): \\App\\Service { return new \\App\\Service(); }\nclass RemovedHelperClass {}\n";
+pub(super) const HELPER_CALLER: &str = "<?php\n$value = \\Shared\\make_service();\n$old = \\Shared\\removed_helper();\n$new = \\Shared\\added_helper();\n$oldConstant = \\Shared\\REMOVED_CONSTANT;\n$newConstant = \\Shared\\ADDED_CONSTANT;\n$oldClass = new \\Shared\\RemovedHelperClass();\n$newClass = new \\Shared\\AddedHelperClass();\n$value->\n";
+
+pub(super) fn helper_alias_projects() -> (tempfile::TempDir, PathBuf) {
+    let (directory, root) = alias_projects();
+    write(&root, "packages/shared/src/Helpers.php", HELPERS_SOURCE);
+    write(
+        &root,
+        "packages/shared/composer.json",
+        r#"{"name":"fixture/shared","autoload":{"psr-4":{"Shared\\":"src/"},"files":["src/Helpers.php"]}}"#,
+    );
+    for project in ["a", "b"] {
+        write(
+            &root,
+            &format!("apps/{project}/vendor/composer/autoload_files.php"),
+            "<?php\n$vendorDir = dirname(__DIR__);\nreturn array(\n    'fixture_shared_helpers' => $vendorDir . '/acme/shared/src/Helpers.php',\n);\n",
+        );
+        write(
+            &root,
+            &format!("apps/{project}/vendor/composer/autoload_classmap.php"),
+            "<?php\n$vendorDir = dirname(__DIR__);\nreturn array(\n    'Shared\\\\Gateway' => $vendorDir . '/acme/shared/src/Gateway.php',\n    'Shared\\\\RemovedHelperClass' => $vendorDir . '/acme/shared/src/Helpers.php',\n);\n",
+        );
+        write(&root, &format!("apps/{project}/helper.php"), HELPER_CALLER);
+    }
+    (directory, root)
+}

+    async fn ready(&self, context: &Arc<ProjectContext>) {
+        context
+            .ready
+            .get_or_init(|| async {
+                let documents: Vec<_> = self
+                    .documents
+                    .read()
+                    .values()
+                    .filter(|doc| {
+                        context.consumes(&doc.uri)
+                            || self.owners.read().get(doc.uri.as_str()) == Some(&context.id)
+                    })
+                    .cloned()
+                    .collect();
+                for document in documents {
+                    context
+                        .backend
+                        .on_did_open(DidOpenTextDocumentParams {
+                            text_document: document,
+                        })

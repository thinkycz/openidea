+        docs.contains("Project A member documentation"),
+        "wrong resolved documentation: {docs}; tagged_data={tagged_data:?}; resolved={resolved:?}"
+    );
+    assert!(
+        !docs.contains("Project B member documentation"),
+        "foreign resolved documentation: {docs}; tagged_data={tagged_data:?}; resolved={resolved:?}"
+    );

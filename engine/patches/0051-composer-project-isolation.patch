+#[tokio::test]
+async fn composer_shared_vendor_alias_overlay_updates_both_consuming_graphs() {
+    let (_directory, root) = alias_projects();
+    let gateway_source = GATEWAY_SOURCE;
+
+    let a_alias = root.join("apps/a/vendor/acme/shared/src/Gateway.php");
+    let b_alias = root.join("apps/b/vendor/acme/shared/src/Gateway.php");
+    assert_ne!(a_alias, b_alias);
+    assert_eq!(
+        a_alias.canonicalize().unwrap(),
+        b_alias.canonicalize().unwrap()
+    );
+
+    let router = ProjectRouter::new_test();
+    router
+        .initialize(InitializeParams {
+            workspace_folders: Some(
+                ["a", "b"]
+                    .into_iter()
+                    .map(|project| WorkspaceFolder {
+                        uri: Url::from_directory_path(root.join("apps").join(project)).unwrap(),
+                        name: project.into(),
+                    })
+                    .collect(),
+            ),
+            ..InitializeParams::default()
+        })
+        .await
+        .unwrap();
+    router.initialized(InitializedParams {}).await;
+
+    for (project, own, foreign) in [("a", "fromA", "fromB"), ("b", "fromB", "fromA")] {
+        let path = root.join(format!("apps/{project}/direct.php"));
+        let source = open(&router, &path).await;
+        assert_members(&router, &path, &source, own, &[foreign]).await;
+    }
+    let a = root.join("apps/a/shared.php");
+    let b = root.join("apps/b/shared.php");
+    let callers = [
+        (a.clone(), open(&router, &a).await),
+        (b.clone(), open(&router, &b).await),
+    ];
+    assert_both(&router, &callers, false).await;
+
+    // Only A's alias is ever opened as an editor document. B reads the same
+    // physical overlay through its own classmap alias and dependency graph.
+    assert_eq!(open(&router, &a_alias).await, gateway_source);
+    let changed = gateway_source.replace("App\\Service", "App\\Replacement");
+    replace(&router, &a_alias, 2, &changed).await;
+    assert_both(&router, &callers, true).await;
+    assert_eq!(fs::read_to_string(&b_alias).unwrap(), gateway_source);
+
+    // Editor Undo republishes the old text; it must retire both consumers'
+    // replacement-method caches without touching the shared file on disk.
+    replace(&router, &a_alias, 3, gateway_source).await;
+    assert_both(&router, &callers, false).await;
+    replace(&router, &a_alias, 4, &changed).await;
+    assert_both(&router, &callers, true).await;
+    router
+        .did_close(DidCloseTextDocumentParams {
+            text_document: TextDocumentIdentifier {
+                uri: Url::from_file_path(&a_alias).unwrap(),
+            },
+        })
+        .await;
+    assert_both(&router, &callers, false).await;
+    assert_eq!(fs::read_to_string(&a_alias).unwrap(), gateway_source);
+    assert_eq!(fs::read_to_string(&b_alias).unwrap(), gateway_source);
+    router.shutdown().await.unwrap();
+}

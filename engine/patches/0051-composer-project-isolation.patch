+pub(super) async fn assert_helper_definition(
+    router: &ProjectRouter,
+    path: &Path,
+    needle: &str,
+    expected: Option<&Path>,
+) {
+    let response = router
+        .goto_definition(GotoDefinitionParams {
+            text_document_position_params: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier {
+                    uri: Url::from_file_path(path).unwrap(),
+                },
+                position: position_of(HELPER_CALLER, needle),
+            },
+            work_done_progress_params: WorkDoneProgressParams::default(),
+            partial_result_params: PartialResultParams::default(),
+        })
+        .await
+        .unwrap();
+    let locations = definition_locations(response);
+    if let Some(expected) = expected {
+        assert_eq!(
+            locations.len(),
+            1,
+            "missing/ambiguous {needle}: {locations:?}"
+        );
+        let actual = locations[0]
+            .uri
+            .to_file_path()
+            .unwrap()
+            .canonicalize()
+            .unwrap();
+        assert_eq!(
+            actual,
+            expected.canonicalize().unwrap(),
+            "wrong physical helper definition of {needle}"
+        );
+    } else {
+        assert!(
+            locations.is_empty(),
+            "removed/missing {needle} resurrected through disk alias: {locations:?}"
+        );
+    }
+}

+    if decls.is_empty() || (decls.len() == 1 && authority.winner(decls).is_some()) {
+        dupes.remove(name);
+    }
+}
+
+fn declare_define(
+    map: &mut HashMap<String, DefineInfo>,
+    dupes: &mut HashMap<String, BTreeMap<String, DefineInfo>>,
+    name: String,
+    info: DefineInfo,
+    authority: &crate::source_authority::SourceAuthority,
+) {
+    if let Some(decls) = dupes.get_mut(&name) {
+        decls.insert(info.file_uri.clone(), info);
+    } else if let Some(old) = map.get(&name).filter(|old| old.file_uri != info.file_uri) {
+        dupes.insert(
+            name.clone(),
+            BTreeMap::from([
+                (old.file_uri.clone(), old.clone()),
+                (info.file_uri.clone(), info),
+            ]),
+        );
+    } else if authority.is_preferred(&info.file_uri) {
+        map.insert(name, info);
+        return;
+    } else {
+        dupes.insert(
+            name.clone(),
+            BTreeMap::from([(info.file_uri.clone(), info)]),
+        );
+    }
+    publish_winning_define(map, dupes, &name, authority);
+}
+
+fn withdraw_define(
+    map: &mut HashMap<String, DefineInfo>,
+    dupes: &mut HashMap<String, BTreeMap<String, DefineInfo>>,
+    name: &str,
+    uri: &str,
+    authority: &crate::source_authority::SourceAuthority,
+) {
+    if let Some(decls) = dupes.get_mut(name) {
+        decls.remove(uri);
+        publish_winning_define(map, dupes, name, authority);
+    } else if map.get(name).is_some_and(|info| info.file_uri == uri) {
+        map.remove(name);
+    }
+}

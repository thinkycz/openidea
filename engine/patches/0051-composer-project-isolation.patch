+    pub(crate) async fn project_from_data(
+        &self,
+        data: &mut Option<Value>,
+    ) -> Result<Arc<ProjectContext>> {
+        let id = data
+            .as_ref()
+            .and_then(|v| v.get("_phpWorkbenchProject"))
+            .and_then(Value::as_u64)
+            .ok_or_else(|| Error::invalid_params("Missing project context"))?;
+        let context = self
+            .contexts
+            .read()
+            .iter()
+            .find(|c| c.id == id)
+            .cloned()
+            .ok_or_else(|| Error::new(tower_lsp::jsonrpc::ErrorCode::ServerError(-32801)))?;
+        *data = data
+            .take()
+            .and_then(|v| v.get("payload").cloned())
+            .filter(|v| !v.is_null());
+        self.ready(&context).await;
+        Ok(context)
+    }
+    pub(crate) fn qualify_locations<T: Serialize + DeserializeOwned>(
+        &self,
+        project: &ProjectContext,
+        value: &mut T,
+    ) -> Result<()> {
+        fn visit(value: &mut Value, id: u64) {
+            match value {
+                Value::Object(map) => {
+                    for (key, value) in map {
+                        if matches!(key.as_str(), "uri" | "targetUri") {
+                            if let Some(uri) = value.as_str()
+                                && (uri.starts_with("phpantom-stub://")
+                                    || uri.starts_with("phpantom-stub-fn://"))
+                                && !uri.contains('?')
+                            {
+                                *value = Value::String(format!("{uri}?project_context={id}"));
+                            }
+                        } else if key != "data" {
+                            visit(value, id)
+                        }
+                    }
+                }
+                Value::Array(items) => {
+                    for item in items {
+                        visit(item, id)
+                    }
+                }
+                _ => {}
+            }
+        }
+        let mut json = serde_json::to_value(&*value).map_err(|_| Error::internal_error())?;
+        visit(&mut json, project.id);
+        *value = serde_json::from_value(json).map_err(|_| Error::internal_error())?;
+        Ok(())
+    }
+    pub(crate) fn navigation_ticket(&self) -> u64 {
+        self.navigation_sequence.fetch_add(1, Ordering::Relaxed) + 1
+    }
+    pub(crate) fn remember_locations<T: Serialize>(
+        &self,
+        project: &ProjectContext,
+        value: &T,
+        ticket: u64,
+    ) {
+        fn visit(value: &Value, result: &mut Vec<Url>) {
+            match value {
+                Value::Object(map) => {
+                    for (key, value) in map {
+                        if matches!(key.as_str(), "uri" | "targetUri") {
+                            if let Some(uri) = value.as_str().and_then(|v| Url::parse(v).ok()) {
+                                result.push(uri);
+                            }
+                        } else {
+                            visit(value, result);
+                        }
+                    }
+                }
+                Value::Array(items) => {
+                    for item in items {
+                        visit(item, result)
+                    }
+                }
+                _ => {}
+            }
+        }
+        if let Ok(value) = serde_json::to_value(value) {
+            let mut uris = Vec::new();
+            visit(&value, &mut uris);
+            let mut versions = self.navigation_versions.write();
+            for uri in uris {
+                if !self.documents.read().contains_key(uri.as_str())
+                    && (project.consumes(&uri)
+                        || matches!(uri.scheme(), "phpantom-stub" | "phpantom-stub-fn"))
+                    && versions
+                        .get(uri.as_str())
+                        .is_none_or(|previous| ticket > *previous)
+                {
+                    versions.insert(uri.to_string(), ticket);
+                    self.owners.write().insert(uri.to_string(), project.id);
+                }
+            }
+        }
+    }
+    fn diagnostic_prefix(project: &ProjectContext) -> String {
+        format!("project-{}:", project.id)
+    }
+    pub(crate) fn strip_diagnostic_id(&self, project: &ProjectContext, id: &mut Option<String>) {
+        if project.id == 0 {
+            return;
+        }
+        *id = id.take().and_then(|id| {
+            id.strip_prefix(&Self::diagnostic_prefix(project))
+                .map(str::to_owned)
+        });
+    }
+    pub(crate) fn decorate_diagnostic<T: Serialize + DeserializeOwned>(
+        &self,
+        project: &ProjectContext,
+        value: &mut T,
+    ) -> Result<()> {
+        if project.id == 0 {
+            return Ok(());
+        }
+        fn visit(value: &mut Value, prefix: &str) {
+            match value {
+                Value::Object(map) => {
+                    for (key, value) in map {
+                        if key == "resultId" {
+                            if let Some(id) = value.as_str() {
+                                *value = Value::String(format!("{prefix}{id}"));
+                            }
+                        } else {
+                            visit(value, prefix)
+                        }
+                    }
+                }
+                Value::Array(items) => {
+                    for item in items {
+                        visit(item, prefix)
+                    }
+                }
+                _ => {}
+            }
+        }
+        let mut json = serde_json::to_value(&*value).map_err(|_| Error::internal_error())?;
+        visit(&mut json, &Self::diagnostic_prefix(project));
+        *value = serde_json::from_value(json).map_err(|_| Error::internal_error())?;
+        Ok(())
+    }
+    pub(crate) async fn project_for_command(
+        &self,
+        params: &ExecuteCommandParams,
+    ) -> Result<Arc<ProjectContext>> {
+        if let Some(uri) = params
+            .arguments
+            .first()
+            .and_then(Value::as_str)
+            .and_then(|v| Url::parse(v).ok())
+        {
+            return self.project_for(&uri).await;
+        }
+        let context = self.fallback_context();
+        self.ready(&context).await;
+        Ok(context)
+    }
+    async fn query_project(&self, uri: Option<Url>) -> Result<Arc<ProjectContext>> {
+        if let Some(uri) = uri {
+            return self.project_for(&uri).await;
+        }
+        let contexts = self.contexts.read().clone();
+        let project = if contexts.len() == 1 {
+            Arc::clone(&contexts[0])
+        } else {
+            let documents = self.documents.read();
+            let mut ids: HashSet<u64> = documents
+                .keys()
+                .filter_map(|uri| self.owners.read().get(uri).copied())
+                .collect();
+            if ids.len() != 1 {
+                return Err(Error::invalid_params("Select a Composer project document"));
+            }
+            let id = ids.drain().next().unwrap();
+            contexts
+                .into_iter()
+                .find(|c| c.id == id)
+                .ok_or_else(Error::internal_error)?
+        };
+        self.ready(&project).await;
+        Ok(project)
+    }
+    /// List or locate routes within the selected Composer graph.
+    pub async fn workbench_routes(
+        &self,
+        query: ProjectRouteQuery,
+    ) -> Result<crate::workbench_routes::RouteReply> {
+        let _gate = self.request_guard().await;
+        self.query_project(query.uri)
+            .await?
+            .backend
+            .workbench_routes(query.query)
+            .await
+    }
+    /// List or locate views within the selected Composer graph.
+    pub async fn workbench_views(
+        &self,
+        query: ProjectViewQuery,
+    ) -> Result<crate::workbench_views::ViewReply> {
+        let _gate = self.request_guard().await;
+        self.query_project(query.uri)
+            .await?
+            .backend
+            .workbench_views(query.query)
+            .await
+    }
+    /// Read an already bundled declaration in its selected language target.
+    pub async fn workbench_builtin(
+        &self,
+        mut query: crate::workbench_builtins::BuiltinQuery,
+    ) -> Result<crate::workbench_builtins::BuiltinDocument> {
+        let _gate = self.request_guard().await;
+        let original = query.uri.clone();
+        let mut uri =
+            Url::parse(&query.uri).map_err(|_| Error::invalid_params("Invalid builtin URI"))?;
+        let project = if let Some(query_string) = uri.query() {
+            let raw_id = query_string
+                .strip_prefix("project_context=")
+                .ok_or_else(|| Error::invalid_params("Invalid builtin project context"))?;
+            let id = raw_id
+                .parse::<u64>()
+                .ok()
+                .filter(|id| *id > 0 && id.to_string() == raw_id)
+                .ok_or_else(|| Error::invalid_params("Invalid builtin project context"))?;
+            if uri.fragment().is_some() {
+                return Err(Error::invalid_params("Invalid builtin project context"));
+            }
+            let context = self
+                .contexts
+                .read()
+                .iter()
+                .find(|context| context.id == id)
+                .cloned()
+                .ok_or_else(|| Error::new(tower_lsp::jsonrpc::ErrorCode::ServerError(-32801)))?;
+            uri.set_query(None);
+            query.uri = uri.to_string();
+            self.ready(&context).await;
+            context
+        } else {
+            self.project_for(&uri).await?
+        };
+        let mut document = project.backend.workbench_builtin(query).await?;
+        document.uri = original;
+        Ok(document)
+    }
+    /// Return the target applied to the selected project, never a merged target.
+    pub async fn workbench_active_target(
+        &self,
+        query: ProjectTargetQuery,
+    ) -> Result<crate::workbench_active_target::ActiveTarget> {
+        let _gate = self.request_guard().await;
+        self.query_project(query.uri)
+            .await?
+            .backend
+            .workbench_active_target(crate::workbench_active_target::TargetQuery {})
+            .await
+    }
+}
+
+fn params_for_root(params: &InitializeParams, root: Option<&Path>) -> InitializeParams {
+    let mut params = params.clone();
+    if let Some(root) = root {
+        params.root_uri = Url::from_directory_path(root).ok();
+    }
+    params
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn retiring_builtin_documents_releases_only_virtual_source_ownership() {
+        let router = ProjectRouter::new_test();
+        let builtin = Url::parse("phpantom-stub://DateTime?project_context=7").unwrap();
+        let file = Url::parse("file:///fixture/source.php").unwrap();
+        for uri in [&builtin, &file] {
+            router.sources.open(uri.as_str());
+            router.diagnostic_clock.open(uri.as_str());
+            router.documents.write().insert(
+                uri.to_string(),
+                TextDocumentItem {
+                    uri: uri.clone(),
+                    language_id: "php".into(),
+                    version: 1,
+                    text: "<?php".into(),
+                },
+            );
+        }
+        router.revoke_builtin_documents();
+        assert!(
+            router.sources.preferred(builtin.as_str()).is_none(),
+            "retired virtual source must release its opening"
+        );
+        assert!(!router.documents.read().contains_key(builtin.as_str()));
+        assert_eq!(
+            router.sources.preferred(file.as_str()).as_deref(),
+            Some(file.as_str())
+        );
+        assert!(router.documents.read().contains_key(file.as_str()));
+        assert_eq!(
+            router.diagnostic_clock.opening(builtin.as_str()),
+            Some(1),
+            "client incarnation history must survive cleanup"
+        );
+    }
+
+    #[test]
+    fn newer_navigation_intent_survives_an_older_response() {
+        let directory = tempfile::tempdir().unwrap();
+        let shared = directory.path().join("shared.php");
+        std::fs::write(&shared, "<?php").unwrap();
+        let router = ProjectRouter::new_test();
+        let mut contexts = Vec::new();
+        for root in [directory.path().join("a"), directory.path().join("b")] {
+            std::fs::create_dir_all(&root).unwrap();
+            let mut backend = Backend::new_test();
+            backend.project_scope = Arc::new(ProjectScope::new(
+                root.clone(),
+                Arc::clone(&router.owners),
+                Vec::new(),
+            ));
+            contexts.push(Arc::new(ProjectContext {
+                id: backend.project_scope.id(),
+                root: Some(root),
+                backend: Arc::new(backend),
+                dependencies: Vec::new(),
+                dependency_files: HashSet::from([normalized(&shared)]),
+                ready: OnceCell::new(),
+            }));
+        }
+        *router.contexts.write() = contexts.clone();
+        let first = router.navigation_ticket();
+        let second = router.navigation_ticket();
+        let uri = Url::from_file_path(&shared).unwrap();
+        let locations = vec![Location {
+            uri: uri.clone(),
+            range: Range::default(),
+        }];
+        router.remember_locations(&contexts[1], &locations, second);
+        router.remember_locations(&contexts[0], &locations, first);
+        assert_eq!(router.selected(&uri).id, contexts[1].id);
+        router.documents.write().insert(
+            uri.to_string(),
+            TextDocumentItem {
+                uri: uri.clone(),
+                language_id: "php".into(),
+                version: 1,
+                text: "<?php".into(),
+            },
+        );
+        let third = router.navigation_ticket();
+        router.remember_locations(&contexts[0], &locations, third);
+        assert_eq!(
+            router.selected(&uri).id,
+            contexts[1].id,
+            "an open document retains its chosen dependency graph"
+        );
+    }
+}

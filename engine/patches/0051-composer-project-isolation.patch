+    async fn supertypes(
+        &self,
+        mut params: TypeHierarchySupertypesParams,
+    ) -> Result<Option<Vec<TypeHierarchyItem>>> {
+        let _request = self.request_guard().await;
+        let project = self.project_from_data(&mut params.item.data).await?;
+        let mut result = project.backend.supertypes(params).await?;
+        if let Some(items) = &mut result {
+            for item in items {
+                self.tag_data(&project, &mut item.data);
+            }
+        }
+        self.qualify_locations(&project, &mut result)?;
+        Ok(result)
+    }
+
+    async fn subtypes(
+        &self,
+        mut params: TypeHierarchySubtypesParams,
+    ) -> Result<Option<Vec<TypeHierarchyItem>>> {
+        let _request = self.request_guard().await;
+        let project = self.project_from_data(&mut params.item.data).await?;
+        let mut result = project.backend.subtypes(params).await?;
+        if let Some(items) = &mut result {
+            for item in items {
+                self.tag_data(&project, &mut item.data);
+            }
+        }
+        self.qualify_locations(&project, &mut result)?;
+        Ok(result)
+    }
+
+    async fn diagnostic(
+        &self,
+        mut params: DocumentDiagnosticParams,
+    ) -> Result<DocumentDiagnosticReportResult> {
+        let _request = self.request_guard().await;
+        let project = self.project_for(&params.text_document.uri).await?;
+        self.strip_diagnostic_id(&project, &mut params.previous_result_id);
+        let mut result = project.backend.diagnostic(params).await?;
+        self.decorate_diagnostic(&project, &mut result)?;
+        Ok(result)
+    }
+
+    async fn workspace_diagnostic(
+        &self,
+        params: WorkspaceDiagnosticParams,
+    ) -> Result<WorkspaceDiagnosticReportResult> {
+        let _request = self.request_guard().await;
+        let mut reports = Vec::new();
+        for project in self.projects().await {
+            let mut request = params.clone();
+            request.previous_result_ids.retain_mut(|previous| {
+                if !(project
+                    .backend
+                    .project_scope
+                    .allows_diagnostics(previous.uri.as_str())
+                    && project
+                        .backend
+                        .symbols
+                        .source_authority
+                        .is_preferred(previous.uri.as_str()))
+                {
+                    return false;
+                }
+                let mut id = Some(std::mem::take(&mut previous.value));
+                self.strip_diagnostic_id(&project, &mut id);
+                match id {
+                    Some(id) => {
+                        previous.value = id;
+                        true
+                    }
+                    None => false,
+                }
+            });
+            let mut result = project.backend.workspace_diagnostic(request).await?;
+            self.decorate_diagnostic(&project, &mut result)?;
+            // Both full and partial report variants have the same item shape.
+            // Keep each report intact, including versions and unchanged IDs.
+            let value = serde_json::to_value(result).map_err(|_| Error::internal_error())?;
+            let items = value
+                .get("items")
+                .and_then(serde_json::Value::as_array)
+                .ok_or_else(Error::internal_error)?;
+            for item in items {
+                if item
+                    .get("uri")
+                    .and_then(serde_json::Value::as_str)
+                    .is_some_and(|uri| {
+                        project.backend.project_scope.allows_diagnostics(uri)
+                            && project.backend.symbols.source_authority.is_preferred(uri)
+                    })
+                {
+                    reports.push(item.clone());
+                }
+            }
+        }
+        serde_json::from_value(serde_json::json!({ "items": reports }))
+            .map_err(|_| Error::internal_error())
+    }
+}

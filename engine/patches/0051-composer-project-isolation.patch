+    let declaration = fixture.path("b", "src/Service.php");
+    let original = open(&router, &declaration).await;
+    let start = position_of(&original, "fromB");
+    let end = position_after(&original, "fromB");
+    let changed = original.replace("fromB", "fromBÉléphant");
+    router
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: Url::from_file_path(&declaration).unwrap(),
+                version: 2,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: Some(Range::new(start, end)),
+                range_length: Some(5),
+                text: "fromBÉléphant".into(),
+            }],
+        })
+        .await;
+    assert_members(&router, &b, &b_source, "fromBÉléphant", &["fromB", "fromA"]).await;
+    assert_members(&router, &a, &a_source, "fromA", &["fromBÉléphant", "fromB"]).await;
+    router
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: Url::from_file_path(&declaration).unwrap(),
+                version: 3,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: Some(Range::new(
+                    position_of(&changed, "fromBÉléphant"),
+                    position_after(&changed, "fromBÉléphant"),
+                )),
+                range_length: Some("fromBÉléphant".encode_utf16().count() as u32),
+                text: "fromB".into(),
+            }],
+        })
+        .await;
+    assert_members(&router, &b, &b_source, "fromB", &["fromBÉléphant", "fromA"]).await;
+    close(&router, &declaration).await;
+    assert_eq!(fs::read_to_string(&declaration).unwrap(), original);
+    router.shutdown().await.unwrap();
+}

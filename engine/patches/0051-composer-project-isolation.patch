--- /dev/null
+++ b/src/source_authority.rs
@@ -0,0 +1,520 @@
+//! Shared physical-source ownership, independent of project semantic indexes.
+use std::collections::{BTreeMap, HashMap, HashSet};
+use std::path::PathBuf;
+
+use parking_lot::RwLock;
+use tower_lsp::lsp_types::Url;
+
+#[derive(Clone, Debug, Hash, PartialEq, Eq)]
+enum SourceKey {
+    File(PathBuf),
+    Uri(String),
+}
+
+fn physical_key(uri: &str) -> SourceKey {
+    let Some(path) = Url::parse(uri).ok().and_then(|uri| uri.to_file_path().ok()) else {
+        return SourceKey::Uri(uri.to_owned());
+    };
+    let canonical = path
+        .canonicalize()
+        .ok()
+        .or_else(|| Some(path.parent()?.canonicalize().ok()?.join(path.file_name()?)));
+    SourceKey::File(canonical.unwrap_or(path))
+}
+
+#[derive(Default)]
+struct State {
+    sequence: u64,
+    groups: HashMap<SourceKey, BTreeMap<String, u64>>,
+    open_keys: HashMap<String, SourceKey>,
+    // Query aliases are memoized only until the next source lifecycle event.
+    // In particular, open/change resolve fresh before invalidating this map.
+    query_keys: HashMap<String, SourceKey>,
+    // One membership per observed spelling, retained after its editor closes.
+    observed_keys: HashMap<String, SourceKey>,
+    observed_aliases: HashMap<SourceKey, HashSet<String>>,
+}
+
+impl State {
+    fn observe(&mut self, uri: &str, key: SourceKey) {
+        if self.observed_keys.get(uri) == Some(&key) {
+            return;
+        }
+        if let Some(previous) = self.observed_keys.insert(uri.to_owned(), key.clone())
+            && let Some(aliases) = self.observed_aliases.get_mut(&previous)
+        {
+            aliases.remove(uri);
+            if aliases.is_empty() {
+                self.observed_aliases.remove(&previous);
+            }
+        }
+        self.observed_aliases
+            .entry(key)
+            .or_default()
+            .insert(uri.to_owned());
+    }
+
+    fn observe_if_absent(&mut self, uri: &str) {
+        if !self.observed_keys.contains_key(uri) {
+            self.observe(uri, physical_key(uri));
+        }
+    }
+
+    fn next_sequence(&mut self) -> u64 {
+        self.sequence = self
+            .sequence
+            .checked_add(1)
+            .expect("source activity sequence exhausted");
+        self.sequence
+    }
+
+    fn remove(&mut self, uri: &str) {
+        let Some(key) = self.open_keys.remove(uri) else {
+            return;
+        };
+        if let Some(aliases) = self.groups.get_mut(&key) {
+            aliases.remove(uri);
+            if aliases.is_empty() {
+                self.groups.remove(&key);
+            }
+        }
+    }
+
+    fn preferred(&self, key: &SourceKey) -> Option<&String> {
+        self.groups
+            .get(key)?
+            .iter()
+            .max_by_key(|(_, priority)| **priority)
+            .map(|(uri, _)| uri)
+    }
+
+    fn remember_key(&mut self, uri: &str) {
+        if !self.query_keys.contains_key(uri) {
+            let key = self
+                .open_keys
+                .get(uri)
+                .cloned()
+                .unwrap_or_else(|| physical_key(uri));
+            self.observe(uri, key.clone());
+            self.query_keys.insert(uri.to_owned(), key);
+        }
+    }
+
+    fn winner<'a, V>(&self, declarations: &'a BTreeMap<String, V>) -> Option<(&'a String, &'a V)> {
+        for (uri, declaration) in declarations {
+            let preferred = self.query_keys.get(uri).and_then(|key| self.preferred(key));
+            match preferred {
+                None => return Some((uri, declaration)),
+                Some(preferred) => {
+                    if let Some(winner) = declarations.get_key_value(preferred) {
+                        return Some(winner);
+                    }
+                    // The active source no longer declares this symbol.
+                    // Every dormant alias of that physical file must lose.
+                }
+            }
+        }
+        None
+    }
+}
+
+/// One physical source's active aliases, shared without sharing semantic facts.
+/// Symlinks are canonicalized; distinct hard links are not unified.
+#[derive(Default)]
+pub(crate) struct SourceAuthority {
+    state: RwLock<State>,
+}
+
+impl SourceAuthority {
+    /// Revalidate a closed spelling after a filesystem event. An open editor's
+    /// accepted source ownership changes only through open/change lifecycle events.
+    pub(crate) fn revalidate_closed(&self, uri: &str) -> bool {
+        if self.state.read().open_keys.contains_key(uri) {
+            return false;
+        }
+        let key = physical_key(uri);
+        let mut state = self.state.write();
+        if state.open_keys.contains_key(uri) {
+            return false;
+        }
+        let retargeted = state
+            .observed_keys
+            .get(uri)
+            .is_some_and(|previous| previous != &key);
+        state.observe(uri, key);
+        if retargeted {
+            state.query_keys.clear();
+        }
+        retargeted
+    }
+
+    /// Open an alias without replacing an already-active source owner.
+    /// Reopening a retargeted symlink starts ownership of its new target.
+    pub(crate) fn open(&self, uri: &str) -> bool {
+        let key = physical_key(uri);
+        let mut state = self.state.write();
+        let retargeted = state
+            .observed_keys
+            .get(uri)
+            .is_some_and(|previous| previous != &key);
+        state.query_keys.clear();
+        state.observe(uri, key.clone());
+        if state.open_keys.get(uri) == Some(&key) {
+            return retargeted;
+        }
+        state.remove(uri);
+        let priority = if state.groups.contains_key(&key) {
+            0
+        } else {
+            state.next_sequence()
+        };
+        state
+            .groups
+            .entry(key.clone())
+            .or_default()
+            .insert(uri.to_owned(), priority);
+        state.open_keys.insert(uri.to_owned(), key);
+        retargeted
+    }
+
+    /// An accepted edit selects its alias as the latest physical-source owner.
+    /// This records ownership only; it never rewrites client document bytes.
+    pub(crate) fn change(&self, uri: &str) {
+        let key = physical_key(uri);
+        let mut state = self.state.write();
+        state.query_keys.clear();
+        state.observe(uri, key.clone());
+        if state
+            .open_keys
+            .get(uri)
+            .is_some_and(|previous| previous != &key)
+        {
+            state.remove(uri);
+        }
+        let priority = state.next_sequence();
+        state
+            .groups
+            .entry(key.clone())
+            .or_default()
+            .insert(uri.to_owned(), priority);
+        state.open_keys.insert(uri.to_owned(), key);
+    }
+
+    /// Close only this alias; another still-open alias retains its priority.
+    pub(crate) fn close(&self, uri: &str) {
+        let mut state = self.state.write();
+        state.remove(uri);
+        state.query_keys.clear();
+    }
+
+    /// Return the preferred open alias of this physical source, if any.
+    /// A previously observed source needs no filesystem lookup without opens.
+    pub(crate) fn preferred(&self, uri: &str) -> Option<String> {
+        {
+            let state = self.state.read();
+            if state.groups.is_empty() && state.observed_keys.contains_key(uri) {
+                return None;
+            }
+            if let Some(key) = state.query_keys.get(uri) {
+                return state.preferred(key).cloned();
+            }
+        }
+        let mut state = self.state.write();
+        if state.groups.is_empty() {
+            state.observe_if_absent(uri);
+            return None;
+        }
+        state.remember_key(uri);
+        state
+            .query_keys
+            .get(uri)
+            .and_then(|key| state.preferred(key))
+            .cloned()
+    }
+
+    /// Whether this alias may publish semantic declarations for its source.
+    /// A passive alias stays dormant even before the preferred one is parsed.
+    pub(crate) fn is_preferred(&self, uri: &str) -> bool {
+        {
+            let state = self.state.read();
+            if state.groups.is_empty() && state.observed_keys.contains_key(uri) {
+                return true;
+            }
+            if let Some(key) = state.query_keys.get(uri) {
+                return state
+                    .preferred(key)
+                    .is_none_or(|preferred| preferred == uri);
+            }
+        }
+        self.preferred(uri).is_none_or(|preferred| preferred == uri)
+    }
+
+    /// Observed spellings of this physical source, including unopened parsed
+    /// aliases. Explicit open/change moves a retargeted spelling to its new group.
+    /// Lookup visits only this source's aliases, not the workspace's sources.
+    pub(crate) fn aliases(&self, uri: &str) -> HashSet<String> {
+        {
+            let state = self.state.read();
+            if let Some(key) = state.observed_keys.get(uri) {
+                return state.observed_aliases.get(key).cloned().unwrap_or_default();
+            }
+        }
+        let mut state = self.state.write();
+        state.observe_if_absent(uri);
+        state
+            .observed_keys
+            .get(uri)
+            .and_then(|key| state.observed_aliases.get(key))
+            .cloned()
+            .unwrap_or_default()
+    }
+
+    /// Keep lexical duplicate precedence between physical files, selecting
+    /// only the current declaring alias within each physical-source group.
+    pub(crate) fn winner<'a, V>(
+        &self,
+        declarations: &'a BTreeMap<String, V>,
+    ) -> Option<(&'a String, &'a V)> {
+        {
+            let state = self.state.read();
+            if state.groups.is_empty()
+                && declarations
+                    .keys()
+                    .all(|uri| state.observed_keys.contains_key(uri))
+            {
+                return declarations.first_key_value();
+            }
+            if declarations
+                .keys()
+                .all(|uri| state.query_keys.contains_key(uri))
+            {
+                return state.winner(declarations);
+            }
+        }
+        let mut state = self.state.write();
+        if state.groups.is_empty() {
+            for uri in declarations.keys() {
+                state.observe_if_absent(uri);
+            }
+            return declarations.first_key_value();
+        }
+        for uri in declarations.keys() {
+            state.remember_key(uri);
+        }
+        state.winner(declarations)
+    }
+}
+
+#[cfg(all(test, unix))]
+mod tests {
+    use super::*;
+
+    fn aliases() -> (tempfile::TempDir, String, String) {
+        let directory = tempfile::tempdir().unwrap();

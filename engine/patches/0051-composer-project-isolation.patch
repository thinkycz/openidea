+    /// Reselect all parsed names contributed by these aliases, including names
+    /// absent from the newly preferred source. The caller retires derived caches.
+    /// Returned names include unchanged owners to permit conservative invalidation.
+    pub(crate) fn refresh_source_authority_for_uris(
+        &self,
+        uris: &HashSet<String>,
+    ) -> crate::symbol_index::SourceAuthorityChanges {
+        let _merge = self.index_merge_gate.lock();
+        let mut changed = crate::symbol_index::SourceAuthorityChanges::default();
+        {
+            let classes = self.symbols.uri_classes_index.read();
+            for uri in uris {
+                if let Some(classes) = classes.get(uri) {
+                    changed
+                        .classes
+                        .extend(classes.iter().map(|class| class_info_fqn(class)));
+                }
+            }
+        }
+        {
+            let globals = self.symbols.uri_globals_index.read();
+            for uri in uris {
+                if let Some((functions, constants)) = globals.get(uri) {
+                    changed.functions.extend(functions.iter().cloned());
+                    changed.constants.extend(constants.iter().cloned());
+                }
+            }
+        }
+        changed.classes.sort_unstable();
+        changed.classes.dedup();
+        changed.functions.sort_unstable();
+        changed.functions.dedup();
+        changed.constants.sort_unstable();
+        changed.constants.dedup();
+        self.symbols.with_class_declarations(|declarations| {
+            for name in &changed.classes {
+                declarations.refresh(name);
+            }
+        });
+        let authority = &self.symbols.source_authority;
+        {
+            let mut map = self.symbols.global_functions.write();
+            let mut dupes = self.symbols.duplicate_functions.write();
+            for name in &changed.functions {
+                if !dupes.contains_key(name)
+                    && let Some((uri, info)) = map.get(name)
+                    && !authority.is_preferred(uri)
+                {
+                    dupes.insert(name.clone(), BTreeMap::from([(uri.clone(), info.clone())]));
+                }
+                publish_winning_function(&mut map, &mut dupes, name, authority);
+            }
+        }
+        {
+            let mut map = self.symbols.global_defines.write();
+            let mut dupes = self.symbols.duplicate_defines.write();
+            for name in &changed.constants {
+                if !dupes.contains_key(name)
+                    && let Some(info) = map.get(name)
+                    && !authority.is_preferred(&info.file_uri)
+                {
+                    dupes.insert(
+                        name.clone(),
+                        BTreeMap::from([(info.file_uri.clone(), info.clone())]),
+                    );
+                }
+                publish_winning_define(&mut map, &mut dupes, name, authority);
+            }
+        }
+        changed
+    }
+
+    /// Remove constant candidates from purged sources without losing backups.
+    pub(crate) fn withdraw_defines_for_uris(&self, uris: &HashSet<String>) {
+        let mut map = self.symbols.global_defines.write();
+        let mut dupes = self.symbols.duplicate_defines.write();
+        let affected: Vec<String> = dupes
+            .iter()
+            .filter(|(_, decls)| decls.keys().any(|uri| uris.contains(uri)))
+            .map(|(name, _)| name.clone())
+            .collect();
+        for name in affected {
+            if let Some(decls) = dupes.get_mut(&name) {
+                decls.retain(|uri, _| !uris.contains(uri));
+            }
+            publish_winning_define(&mut map, &mut dupes, &name, &self.symbols.source_authority);
+        }
+        map.retain(|_, info| !uris.contains(&info.file_uri));
+    }

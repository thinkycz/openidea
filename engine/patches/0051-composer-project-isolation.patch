+
+    async fn symbol(
+        &self,
+        params: WorkspaceSymbolParams,
+    ) -> Result<Option<Vec<SymbolInformation>>> {
+        let _request = self.request_guard().await;
+        let mut symbols = Vec::new();
+        for project in self.projects().await {
+            if let Some(items) = project.backend.symbol(params.clone()).await? {
+                symbols.extend(items);
+            }
+        }
+        Ok((!symbols.is_empty()).then_some(symbols))
+    }
+
+    async fn prepare_call_hierarchy(

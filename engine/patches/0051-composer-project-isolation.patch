+pub(super) const GATEWAY_SOURCE: &str = "<?php\nnamespace Shared;\nclass Gateway {\n    public function service(): \\App\\Service { return new \\App\\Service(); }\n}\n";
+
+fn alias_projects() -> (tempfile::TempDir, PathBuf) {
+    let directory = tempfile::tempdir().unwrap();
+    let root = directory.path().canonicalize().unwrap();
+    write(&root, "packages/shared/src/Gateway.php", GATEWAY_SOURCE);
+    write(
+        &root,
+        "packages/shared/composer.json",
+        r#"{"name":"fixture/shared","autoload":{"psr-4":{"Shared\\":"src/"}}}"#,
+    );
+
+    for (project, own) in [("a", "A"), ("b", "B")] {
+        write(
+            &root,
+            &format!("apps/{project}/composer.json"),
+            &serde_json::json!({"name":format!("fixture/{project}"),
+                "autoload":{"psr-4":{"App\\":"src/"}}})
+            .to_string(),
+        );
+        write(
+            &root,
+            &format!("apps/{project}/.phpantom.toml"),
+            "[indexing]\nstrategy = \"none\"\n",
+        );
+        write(&root, &format!("apps/{project}/.gitignore"), "/vendor/\n");
+        write(
+            &root,
+            &format!("apps/{project}/src/Service.php"),
+            &format!(
+                "<?php\nnamespace App;\nclass Service {{ public function from{own}(): void {{}} }}\n"
+            ),
+        );
+        write(
+            &root,
+            &format!("apps/{project}/src/Replacement.php"),
+            &format!(
+                "<?php\nnamespace App;\nclass Replacement {{ public function from{own}Replacement(): void {{}} }}\n"
+            ),
+        );
+        write(
+            &root,
+            &format!("apps/{project}/direct.php"),
+            "<?php\n$value = new \\App\\Service();\n$value->\n",
+        );
+        write(
+            &root,
+            &format!("apps/{project}/shared.php"),
+            "<?php\n$value = (new \\Shared\\Gateway())->service();\n$value->\n",
+        );
+        // Keep the Composer map's raw vendor alias distinct in each app.
+        // Canonicalizing it here would erase the source-identity regression.
+        write(
+            &root,
+            &format!("apps/{project}/vendor/composer/autoload_classmap.php"),
+            "<?php\n$vendorDir = dirname(__DIR__);\nreturn array(\n    'Shared\\\\Gateway' => $vendorDir . '/acme/shared/src/Gateway.php',\n);\n",
+        );
+        let link = root.join(format!("apps/{project}/vendor/acme/shared"));
+        fs::create_dir_all(link.parent().unwrap()).unwrap();
+        std::os::unix::fs::symlink(root.join("packages/shared"), link).unwrap();
+    }
+    (directory, root)
+}

diff --git a/src/diagnostics/transport_clock.rs b/src/diagnostics/transport_clock.rs
new file mode 100644
--- /dev/null
+++ b/src/diagnostics/transport_clock.rs
@@ -0,0 +1,60 @@
+//! Diagnostic ordering owned by one client transport, across project contexts.
+use std::collections::HashMap;
+use std::sync::Arc;
+use std::sync::atomic::AtomicU64;
+
+use parking_lot::Mutex;
+
+/// Context replay reads an existing opening; only client didOpen advances it.
+#[derive(Default)]
+pub(crate) struct TransportClock {
+    /// Shared publication order for every child of this transport.
+    pub(crate) sequence: Arc<AtomicU64>,
+    // None permanently retires a URI whose incarnation counter overflowed.
+    openings: Mutex<HashMap<String, Option<u64>>>,
+}
+
+impl TransportClock {
+    /// Record one actual client opening. Closing never erases its incarnation.
+    pub(crate) fn open(&self, uri: &str) -> Option<u64> {
+        let mut openings = self.openings.lock();
+        let opening = openings.entry(uri.to_owned()).or_insert(Some(0));
+        *opening = opening.and_then(|previous| previous.checked_add(1));
+        *opening
+    }
+
+    /// The latest client opening, suitable for seeding a newly created child.
+    pub(crate) fn opening(&self, uri: &str) -> Option<u64> {
+        self.openings.lock().get(uri).copied().flatten()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::atomic::Ordering;
+
+    #[test]
+    fn replay_and_child_replacement_share_transport_order_without_reopening() {
+        let transport = Arc::new(TransportClock::default());
+        assert_eq!(transport.opening("u"), None);
+        assert_eq!(transport.open("u"), Some(1));
+        let child_sequence = Arc::clone(&transport.sequence);
+        assert_eq!(child_sequence.fetch_add(1, Ordering::Relaxed), 0);
+        assert_eq!(transport.opening("u"), Some(1));
+        assert_eq!(transport.sequence.fetch_add(1, Ordering::Relaxed), 1);
+        assert_eq!(transport.open("v"), Some(1));
+        assert_eq!(transport.open("u"), Some(2));
+        assert_eq!(transport.opening("v"), Some(1));
+    }
+
+    #[test]
+    fn opening_overflow_cannot_reuse_an_old_incarnation() {
+        let transport = TransportClock::default();
+        transport.openings.lock().insert("u".into(), Some(u64::MAX));
+        assert_eq!(transport.open("u"), None);
+        assert_eq!(transport.opening("u"), None);
+        assert_eq!(transport.open("u"), None);
+        assert_eq!(transport.open("v"), Some(1));
+    }
+}

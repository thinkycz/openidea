+            .await?;
+        project.backend.on_type_formatting(params).await
+    }
+
+    async fn formatting(&self, params: DocumentFormattingParams) -> Result<Option<Vec<TextEdit>>> {
+        let _request = self.request_guard().await;
+        let project = self.project_for(&params.text_document.uri).await?;
+        project.backend.formatting(params).await
+    }
+
+    async fn completion(&self, params: CompletionParams) -> Result<Option<CompletionResponse>> {
+        let _request = self.request_guard().await;
+        let project = self
+            .project_for(&params.text_document_position.text_document.uri)
+            .await?;
+        let mut result = project.backend.completion(params).await?;
+        if let Some(response) = &mut result {
+            let items = match response {
+                CompletionResponse::Array(items) => items,
+                CompletionResponse::List(list) => &mut list.items,
+            };
+            for item in items {
+                self.tag_data(&project, &mut item.data);
+            }
+        }
+        Ok(result)
+    }
+
+    async fn completion_resolve(&self, mut item: CompletionItem) -> Result<CompletionItem> {
+        let _request = self.request_guard().await;
+        let project = self.project_from_data(&mut item.data).await?;
+        let mut result = project.backend.completion_resolve(item).await?;
+        self.tag_data(&project, &mut result.data);
+        Ok(result)
+    }
+
+    async fn code_action(&self, params: CodeActionParams) -> Result<Option<CodeActionResponse>> {
+        let _request = self.request_guard().await;
+        let project = self.project_for(&params.text_document.uri).await?;
+        let mut result = project.backend.code_action(params).await?;
+        if let Some(actions) = &mut result {
+            for action in actions {
+                if let CodeActionOrCommand::CodeAction(action) = action {
+                    self.tag_data(&project, &mut action.data);
+                }
+            }
+        }
+        Ok(result)
+    }
+
+    async fn code_action_resolve(&self, mut action: CodeAction) -> Result<CodeAction> {
+        let _request = self.request_guard().await;
+        let project = self.project_from_data(&mut action.data).await?;
+        let mut result = project.backend.code_action_resolve(action).await?;
+        self.tag_data(&project, &mut result.data);
+        Ok(result)
+    }
+
+    async fn code_lens(&self, params: CodeLensParams) -> Result<Option<Vec<CodeLens>>> {
+        let _request = self.request_guard().await;
+        let project = self.project_for(&params.text_document.uri).await?;
+        let mut result = project.backend.code_lens(params).await?;
+        if let Some(lenses) = &mut result {
+            for lens in lenses {
+                self.tag_data(&project, &mut lens.data);
+            }
+        }
+        Ok(result)
+    }
+
+    async fn code_lens_resolve(&self, mut lens: CodeLens) -> Result<CodeLens> {
+        let _request = self.request_guard().await;
+        let project = self.project_from_data(&mut lens.data).await?;
+        let mut result = project.backend.code_lens_resolve(lens).await?;
+        self.tag_data(&project, &mut result.data);
+        Ok(result)

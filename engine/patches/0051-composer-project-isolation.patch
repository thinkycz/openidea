+async fn assert_direct_alias_symbol(router: &ProjectRouter, path: &Path, own: &str, absent: &str) {
+    let symbols = document_symbols(router, path).await.unwrap();
+    assert!(
+        symbols.is_some(),
+        "active alias must retain document symbols: {}",
+        path.display()
+    );
+    let json = serde_json::to_string(&symbols).unwrap();
+    assert!(
+        json.contains(&format!("\"name\":\"{own}\"")),
+        "missing actual active-buffer method {own}: {json}"
+    );
+    assert!(
+        !json.contains(&format!("\"name\":\"{absent}\"")),
+        "foreign buffer method leaked into document coordinates: {json}"
+    );

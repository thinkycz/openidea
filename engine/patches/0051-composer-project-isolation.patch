+    pub(crate) async fn initialize_all(&self) {
+        let _gate = self.request_guard().await;
+        self.projects().await;
+    }
+    pub(crate) async fn projects(&self) -> Vec<Arc<ProjectContext>> {
+        let contexts = self.contexts.read().clone();
+        for context in &contexts {
+            self.ready(context).await;
+        }
+        contexts
+    }
+    fn selected(&self, uri: &Url) -> Arc<ProjectContext> {
+        let contexts = self.contexts.read();
+        if let Some(owner) = self.owners.read().get(uri.as_str()).copied()
+            && let Some(context) = contexts.iter().find(|c| c.id == owner)
+        {
+            return Arc::clone(context);
+        }
+        if let Ok(path) = uri.to_file_path() {
+            if let Some(context) = contexts
+                .iter()
+                .filter(|c| c.root.as_ref().is_some_and(|r| contains(r, &path)))
+                .max_by_key(|c| c.root.as_ref().map(|r| r.components().count()).unwrap_or(0))
+            {
+                if !context.backend.project_scope.excluded_roots().is_empty()
+                    && let Some(consumer) = contexts.iter().find(|c| {
+                        c.id != context.id
+                            && (c.dependencies.iter().any(|root| contains(root, &path))
+                                || c.dependency_files.contains(&normalized(&path)))
+                    })
+                {
+                    return Arc::clone(consumer);
+                }
+                return Arc::clone(context);
+            }
+            if let Some(context) = contexts.iter().find(|c| c.consumes(uri)) {
+                return Arc::clone(context);
+            }
+        }
+        Arc::clone(&contexts[0])
+    }

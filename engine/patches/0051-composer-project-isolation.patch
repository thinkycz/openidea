@@ -0,0 +1,186 @@
+//! Client-visible ownership for independent Composer semantic contexts.
+use std::collections::HashMap;
+use std::path::{Component, Path, PathBuf};
+use std::sync::Arc;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+use parking_lot::RwLock;
+use tower_lsp::lsp_types::Url;
+
+#[derive(Default)]
+pub(crate) struct ProjectScope {
+    id: u64,
+    root: Option<PathBuf>,
+    canonical_root: Option<PathBuf>,
+    shared_owners: Arc<RwLock<HashMap<String, u64>>>,
+    excluded_roots: Vec<PathBuf>,
+    canonical_excluded_roots: Vec<PathBuf>,
+}
+
+impl ProjectScope {
+    pub(crate) fn new(
+        root: PathBuf,
+        shared_owners: Arc<RwLock<HashMap<String, u64>>>,
+        excluded_roots: Vec<PathBuf>,
+    ) -> Self {
+        let root = lexical_path(&root);
+        let excluded_roots: Vec<_> = excluded_roots
+            .iter()
+            .map(|path| lexical_path(path))
+            .collect();
+        Self {
+            id: next_id(),
+            canonical_root: root.canonicalize().ok(),
+            canonical_excluded_roots: excluded_roots
+                .iter()
+                .filter_map(|path| path.canonicalize().ok())
+                .collect(),
+            root: Some(root),
+            shared_owners,
+            excluded_roots,
+        }
+    }
+
+    pub(crate) fn virtual_context(shared_owners: Arc<RwLock<HashMap<String, u64>>>) -> Self {
+        Self {
+            id: next_id(),
+            shared_owners,
+            ..Self::default()
+        }
+    }
+
+    pub(crate) fn id(&self) -> u64 {
+        self.id
+    }
+
+    pub(crate) fn namespace(&self, base: &str) -> String {
+        if self.id == 0 {
+            base.to_owned()
+        } else {
+            format!("{base}:project-{}", self.id)
+        }
+    }
+
+    pub(crate) fn excluded_roots(&self) -> &[PathBuf] {
+        &self.excluded_roots
+    }
+
+    pub(crate) fn allows_diagnostics(&self, uri: &str) -> bool {
+        if let Some(owner) = self.shared_owners.read().get(uri) {
+            return *owner == self.id;
+        }
+        let Some(root) = &self.root else {
+            return true;
+        };
+        let Some(path) = Url::parse(uri).ok().and_then(|uri| uri.to_file_path().ok()) else {
+            return false;
+        };
+        let path = lexical_path(&path);
+        let canonical = path.canonicalize().ok();
+        let excluded = self
+            .excluded_roots
+            .iter()
+            .any(|root| path.starts_with(root))
+            || canonical.as_ref().is_some_and(|path| {
+                self.canonical_excluded_roots
+                    .iter()
+                    .any(|root| path.starts_with(root))
+            });
+        !excluded
+            && (path.starts_with(root)
+                || canonical.as_ref().is_some_and(|path| {
+                    self.canonical_root
+                        .as_ref()
+                        .is_some_and(|root| path.starts_with(root))
+                }))
+    }
+}
+
+fn lexical_path(path: &Path) -> PathBuf {
+    let mut result = PathBuf::new();
+    for component in path.components() {
+        match component {
+            Component::CurDir => {}
+            Component::ParentDir => {
+                result.pop();
+            }
+            component => result.push(component.as_os_str()),
+        }
+    }
+    result
+}
+
+fn next_id() -> u64 {
+    static NEXT_ID: AtomicU64 = AtomicU64::new(1);
+    NEXT_ID.fetch_add(1, Ordering::Relaxed)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn uri(path: &Path) -> String {
+        Url::from_file_path(path).unwrap().to_string()
+    }
+
+    #[test]
+    fn default_keeps_single_project_publication_and_names() {
+        let scope = ProjectScope::default();
+        assert!(scope.allows_diagnostics("phpantom-stub://DateTime"));
+        assert!(scope.allows_diagnostics("file:///outside/project.php"));
+        assert_eq!(scope.namespace("index"), "index");
+    }
+
+    #[test]
+    fn own_root_excludes_siblings_nested_projects_and_parent_traversal() {
+        let directory = tempfile::tempdir().unwrap();
+        let root = directory.path().join("a");
+        let nested = root.join("child");
+        let scope = ProjectScope::new(root.clone(), Arc::default(), vec![nested.clone()]);
+        assert!(scope.allows_diagnostics(&uri(&root.join("src/File.php"))));
+        assert!(!scope.allows_diagnostics(&uri(&directory.path().join("ab/File.php"))));
+        assert!(!scope.allows_diagnostics(&uri(&nested.join("File.php"))));
+        assert!(!scope.allows_diagnostics(&uri(&root.join("../b/File.php"))));
+        assert!(!scope.allows_diagnostics("phpantom-stub://DateTime"));
+        assert_ne!(scope.namespace("index"), "index");
+    }
+
+    #[test]
+    fn explicit_shared_owner_overrides_root_and_changes_live() {
+        let directory = tempfile::tempdir().unwrap();
+        let owners = Arc::new(RwLock::new(HashMap::new()));
+        let a = ProjectScope::new(directory.path().join("a"), Arc::clone(&owners), vec![]);
+        let b = ProjectScope::new(directory.path().join("b"), Arc::clone(&owners), vec![]);
+        let shared = uri(&directory.path().join("packages/Shared.php"));
+        assert_ne!(a.id(), b.id());
+        assert_ne!(a.namespace("index"), b.namespace("index"));
+        assert!(!a.allows_diagnostics(&shared));
+        owners.write().insert(shared.clone(), a.id());
+        assert!(a.allows_diagnostics(&shared));
+        assert!(!b.allows_diagnostics(&shared));
+        owners.write().insert(shared.clone(), b.id());
+        assert!(!a.allows_diagnostics(&shared));
+        assert!(b.allows_diagnostics(&shared));
+        let own_a = uri(&directory.path().join("a/File.php"));
+        owners.write().insert(own_a.clone(), b.id());
+        assert!(!a.allows_diagnostics(&own_a));
+        assert!(b.allows_diagnostics(&own_a));
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn canonical_spelling_obeys_nested_project_exclusion() {
+        let directory = tempfile::tempdir().unwrap();
+        let root = directory.path().join("project");
+        let nested = root.join("nested");
+        std::fs::create_dir_all(&nested).unwrap();
+        let file = nested.join("File.php");
+        std::fs::write(&file, "<?php").unwrap();
+        let alias = directory.path().join("alias");
+        std::os::unix::fs::symlink(&root, &alias).unwrap();
+        std::fs::write(root.join("Own.php"), "<?php").unwrap();
+        let scope = ProjectScope::new(root, Arc::default(), vec![nested]);
+        assert!(scope.allows_diagnostics(&uri(&alias.join("Own.php"))));
+        assert!(!scope.allows_diagnostics(&uri(&alias.join("nested/File.php"))));
+    }
+}

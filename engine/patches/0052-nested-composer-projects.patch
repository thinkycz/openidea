+#[cfg(unix)]
+#[tokio::test]
+async fn composer_nested_installed_symlink_package_outside_consumer_keeps_consumer_context() {
+    let fixture = Workspace::new(false);
+    fs::remove_file(fixture.root.join("composer.json")).unwrap();
+    fixture.write("apps/z-app/composer.json", r#"{"name":"fixture/consumer","require":{"php":"^8.2","acme/pkg":"@dev"},"autoload":{"psr-4":{"App\\":"src/"}},"repositories":[{"type":"path","url":"../../packages/shared","options":{"symlink":true}}]}"#);
+    fixture.write(
+        "apps/z-app/.phpantom.toml",
+        "[indexing]\nstrategy = \"none\"\n",
+    );
+    fixture.write(
+        "apps/z-app/src/Service.php",
+        "<?php\nnamespace App;\nclass Service { public function fromConsumer(): void {} }\n",
+    );
+    fixture.write(
+        "packages/shared/composer.json",
+        r#"{"name":"acme/pkg","require":{"php":"^7.4"},"autoload":{"psr-4":{"Library\\":"src/"}}}"#,
+    );
+    fixture.write(
+        "packages/shared/.phpantom.toml",
+        "[php]\nversion = \"7.4\"\n[indexing]\nstrategy = \"none\"\n",
+    );
+    let tool_source = "<?php\nnamespace Library;\nclass Tool { public function service(): \\App\\Service { return new \\App\\Service(); } }\n";
+    fixture.write("packages/shared/src/Tool.php", tool_source);
+    fixture.write("apps/z-app/vendor/composer/installed.json", r#"{"packages":[{"name":"acme/pkg","version":"dev-main","install-path":"../acme/pkg","dist":{"type":"path","url":"../../packages/shared"},"transport-options":{"symlink":true},"autoload":{"psr-4":{"Library\\":"src/"}}}]}"#);
+    fixture.write("apps/z-app/vendor/composer/autoload_classmap.php", "<?php\n$vendorDir = dirname(__DIR__);\nreturn array(\n    'Library\\\\Tool' => $vendorDir . '/acme/pkg/src/Tool.php',\n);\n");
+    let link = fixture.root.join("apps/z-app/vendor/acme/pkg");
+    fs::create_dir_all(link.parent().unwrap()).unwrap();
+    std::os::unix::fs::symlink(fixture.root.join("packages/shared"), &link).unwrap();
+    let tool = fixture.root.join("packages/shared/src/Tool.php");
+    assert_eq!(
+        link.join("src/Tool.php").canonicalize().unwrap(),
+        tool.canonicalize().unwrap()
+    );
+    assert!(
+        !tool.starts_with(fixture.root.join("apps/z-app")),
+        "control must live outside consuming project"
+    );
+    let caller_source = "<?php\n$value = (new \\Library\\Tool())->service();\n$value->\n";
+    fixture.write("apps/z-app/index.php", caller_source);
+    let router = fixture.router().await;
+    let caller = fixture.root.join("apps/z-app/index.php");
+    open(&router, &caller).await;
+    assert_members(
+        &router,
+        &caller,
+        caller_source,
+        "fromConsumer",
+        &["fromRoot", "fromChild"],
+    )
+    .await;
+    assert_definition(
+        &router,
+        &caller,
+        caller_source,
+        "Tool",
+        &link.join("src/Tool.php"),
+    )
+    .await;
+    // Query the real physical source, not only the consumer's vendor spelling.
+    // Installed path eligibility is relative to the containing workspace;
+    // being outside this consumer must not create a standalone package target.
+    open(&router, &tool).await;
+    assert_target(&router, &tool, "8.2").await;
+    assert_definition(
+        &router,
+        &tool,
+        tool_source,
+        "Service",
+        &fixture.root.join("apps/z-app/src/Service.php"),
+    )
+    .await;
+    assert_members(
+        &router,
+        &caller,
+        caller_source,
+        "fromConsumer",
+        &["fromRoot", "fromChild"],
+    )
+    .await;
+    assert_eq!(fs::read_to_string(&tool).unwrap(), tool_source);
+    router.shutdown().await.unwrap();
+}

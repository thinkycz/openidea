+/// Discover independent Composer contexts beneath an opened workspace folder.
+///
+/// Unlike the legacy merged-backend discovery, accepted manifests do not stop
+/// discovery. Installed vendor and path-package sources retain the consuming
+/// project's context instead of acquiring standalone configuration.
+pub(crate) fn discover_project_context_roots(workspace_root: &Path) -> Vec<(PathBuf, String)> {
+    use std::sync::Arc;
+
+    use ignore::WalkBuilder;
+    use parking_lot::RwLock;
+
+    let canonical_workspace = workspace_root
+        .canonicalize()
+        .unwrap_or_else(|_| workspace_root.into());
+    let excluded = Arc::new(RwLock::new(Vec::<PathBuf>::new()));
+    let dependency_paths = |root: &Path, package: &ComposerPackage| {
+        let vendor = get_vendor_dir(package);
+        std::iter::once(root.join(&vendor))
+            .chain(installed_path_package_roots(root, &vendor))
+            .map(|path| {
+                let path = path.canonicalize().unwrap_or(path);
+                path.strip_prefix(&canonical_workspace)
+                    .map(|relative| workspace_root.join(relative))
+                    .unwrap_or(path)
+            })
+            .collect::<Vec<_>>()
+    };
+    if let Some(package) = read_composer_package(workspace_root) {
+        excluded
+            .write()
+            .extend(dependency_paths(workspace_root, &package));
+    }
+    let filtered = Arc::clone(&excluded);
+    let walker = WalkBuilder::new(workspace_root)
+        .git_ignore(true)
+        .git_global(true)
+        .git_exclude(true)
+        .require_git(false)
+        .hidden(true)
+        .parents(true)
+        .ignore(true)
+        .sort_by_file_name(|a, b| {
+            // Register each project's dependencies before walking its source
+            // directories, regardless of their alphabetic names.
+            (a != "composer.json")
+                .cmp(&(b != "composer.json"))
+                .then_with(|| a.cmp(b))
+        })
+        .filter_entry(move |entry| {
+            if entry.file_type().is_some_and(|kind| kind.is_dir()) {
+                entry.file_name() != "vendor"
+                    && !filtered
+                        .read()
+                        .iter()
+                        .any(|path| entry.path().starts_with(path))
+            } else {
+                entry.file_name() == "composer.json"
+            }
+        })
+        .build();
+    let mut projects = Vec::new();
+    for entry in walker.flatten() {
+        if !entry.file_type().is_some_and(|kind| kind.is_file()) {
+            continue;
+        }
+        let Some(root) = entry.path().parent() else {
+            continue;
+        };
+        if root == workspace_root {
+            continue;
+        }
+        if let Some(package) = read_composer_package(root) {
+            let vendor_dir = get_vendor_dir(&package);
+            let dependencies = dependency_paths(root, &package);
+            // Descendant dependencies can be pruned immediately. Cross-project
+            // dependencies are classified after all sibling manifests are read.
+            excluded.write().extend(
+                dependencies
+                    .iter()
+                    .filter(|path| path.starts_with(root))
+                    .cloned(),
+            );
+            projects.push(DiscoveredProject {
+                root: root.to_path_buf(),
+                vendor_dir,
+                dependencies,
+            });
+        }
+    }
+    let accepted = independent_projects(&projects);
+    projects
+        .into_iter()
+        .zip(accepted)
+        .filter_map(|(project, accepted)| accepted.then_some((project.root, project.vendor_dir)))
+        .collect()
+}

+#[tokio::test]
+async fn composer_nested_adding_then_removing_parent_folder_preserves_dirty_child_document() {
+    let fixture = Workspace::new(true);
+    let child_root = fixture.root.join("tools/child");
+    let child_folder = WorkspaceFolder {
+        uri: Url::from_directory_path(&child_root).unwrap(),
+        name: "child".into(),
+    };
+    let parent_folder = WorkspaceFolder {
+        uri: Url::from_directory_path(&fixture.root).unwrap(),
+        name: "parent".into(),
+    };
+    let router = ProjectRouter::new_test();
+    router
+        .initialize(InitializeParams {
+            root_uri: Some(child_folder.uri.clone()),
+            workspace_folders: Some(vec![child_folder.clone()]),
+            ..InitializeParams::default()
+        })
+        .await
+        .unwrap();
+    router.initialized(InitializedParams {}).await;
+    let child = child_root.join("index.php");
+    let original = open(&router, &child).await;
+    let dirty = "<?php\n/* café 🐘 */ $value = new \\App\\AfterChange();\n$value->\n";
+    change(&router, &child, 5, None, dirty).await;
+    assert_members(
+        &router,
+        &child,
+        dirty,
+        "fromChildDirty",
+        &["fromRootDirty", "fromChild"],
+    )
+    .await;
+    assert_target(&router, &child, "8.4").await;
+    router
+        .did_change_workspace_folders(DidChangeWorkspaceFoldersParams {
+            event: WorkspaceFoldersChangeEvent {
+                added: vec![parent_folder.clone()],
+                removed: Vec::new(),
+            },
+        })
+        .await;
+    assert_members(
+        &router,
+        &child,
+        dirty,
+        "fromChildDirty",
+        &["fromRootDirty", "fromChild"],
+    )
+    .await;
+    assert_target(&router, &child, "8.4").await;
+    let parent = fixture.root.join("index.php");
+    let parent_source = open(&router, &parent).await;
+    assert_members(
+        &router,
+        &parent,
+        &parent_source,
+        "fromRoot",
+        &["fromChild", "fromChildDirty"],
+    )
+    .await;
+    assert_target(&router, &parent, "8.2").await;
+    assert_definition(
+        &router,
+        &parent,
+        &parent_source,
+        "Service",
+        &fixture.root.join("src/Service.php"),
+    )
+    .await;
+    change(&router, &child, 4, None, CALLER).await;
+    assert_members(&router, &child, dirty, "fromChildDirty", &["fromChild"]).await;
+    let undone = dirty.replace("AfterChange", "AfterUndo");
+    change(
+        &router,
+        &child,
+        6,
+        Some(Range::new(
+            position_of(dirty, "AfterChange"),
+            position_after(dirty, "AfterChange"),
+        )),
+        "AfterUndo",
+    )
+    .await;
+    assert_members(
+        &router,
+        &child,
+        &undone,
+        "fromChildUndo",
+        &["fromRootUndo", "fromChildDirty"],
+    )
+    .await;
+    router
+        .did_close(DidCloseTextDocumentParams {
+            text_document: TextDocumentIdentifier {
+                uri: Url::from_file_path(&parent).unwrap(),
+            },
+        })
+        .await;
+    router
+        .did_change_workspace_folders(DidChangeWorkspaceFoldersParams {
+            event: WorkspaceFoldersChangeEvent {
+                added: Vec::new(),
+                removed: vec![parent_folder],
+            },
+        })
+        .await;
+    assert_members(
+        &router,
+        &child,
+        &undone,
+        "fromChildUndo",
+        &["fromRootUndo", "fromChildDirty"],
+    )
+    .await;
+    assert_target(&router, &child, "8.4").await;
+    assert_definition(
+        &router,
+        &child,
+        &undone,
+        "AfterUndo",
+        &child_root.join("src/AfterUndo.php"),
+    )
+    .await;
+    change(&router, &child, 5, None, CALLER).await;
+    assert_members(&router, &child, &undone, "fromChildUndo", &["fromChild"]).await;
+    change(
+        &router,
+        &child,
+        7,
+        Some(Range::new(
+            position_of(&undone, "AfterUndo"),
+            position_after(&undone, "AfterUndo"),
+        )),
+        "AfterChange",
+    )
+    .await;
+    assert_members(
+        &router,
+        &child,
+        dirty,
+        "fromChildDirty",
+        &["fromRootDirty", "fromChildUndo"],
+    )
+    .await;
+    assert_eq!(fs::read_to_string(&child).unwrap(), original);
+    assert_eq!(fs::read_to_string(&parent).unwrap(), parent_source);
+    router.shutdown().await.unwrap();
+}

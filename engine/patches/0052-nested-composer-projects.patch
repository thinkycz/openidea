diff --git a/tests/integration/composer_project_nested.rs b/tests/integration/composer_project_nested.rs
new file mode 100644
--- /dev/null
+++ b/tests/integration/composer_project_nested.rs
@@ -0,0 +1,1006 @@
+//! Independent nested Composer projects retain their own semantic graphs.
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use phpantom_lsp::{ProjectRouter, ProjectTargetQuery};
+use tempfile::TempDir;
+use tower_lsp::LanguageServer;
+use tower_lsp::lsp_types::*;
+
+use crate::common::{definition_locations, position_after, position_of};
+
+const CALLER: &str = "<?php\n$value = new \\App\\Service();\n$value->\n";
+
+struct Workspace {
+    _directory: TempDir,
+    root: PathBuf,
+}
+
+impl Workspace {
+    fn new(child_manifest: bool) -> Self {
+        let directory = tempfile::tempdir().unwrap();
+        let root = directory.path().canonicalize().unwrap();
+        let fixture = Self {
+            _directory: directory,
+            root,
+        };
+        fixture.manifest("", "8.2");
+        fixture.write(".phpantom.toml", "[indexing]\nstrategy = \"none\"\n");
+        fixture.write("index.php", CALLER);
+        fixture.write("tools/child/index.php", CALLER);
+        fixture.write(
+            "tools/child/.phpantom.toml",
+            "[indexing]\nstrategy = \"none\"\n",
+        );
+        if child_manifest {
+            fixture.manifest("tools/child", "8.4");
+        }
+        for (directory, owner) in [("src", "Root"), ("tools/child/src", "Child")] {
+            for (class, suffix) in [
+                ("Service", ""),
+                ("AfterChange", "Dirty"),
+                ("AfterUndo", "Undo"),
+            ] {
+                fixture.write(&format!("{directory}/{class}.php"), &format!(
+                    "<?php\nnamespace App;\nclass {class} {{ public function from{owner}{suffix}(): void {{}} }}\n"));
+            }
+        }
+        fixture
+    }
+
+    fn write(&self, relative: &str, text: &str) {
+        let path = self.root.join(relative);
+        fs::create_dir_all(path.parent().unwrap()).unwrap();
+        fs::write(path, text).unwrap();
+    }
+
+    fn manifest(&self, directory: &str, php: &str) {
+        let relative = Path::new(directory).join("composer.json");
+        self.write(
+            relative.to_str().unwrap(),
+            &serde_json::json!({
+                "name":if directory.is_empty() {"fixture/root"} else {"fixture/child"},
+                "require":{"php":format!("^{php}")},"autoload":{"psr-4":{"App\\":"src/"}}
+            })
+            .to_string(),
+        );
+    }
+
+    async fn router(&self) -> ProjectRouter {
+        let router = ProjectRouter::new_test();
+        router
+            .initialize(InitializeParams {
+                root_uri: Some(Url::from_directory_path(&self.root).unwrap()),
+                workspace_folders: Some(vec![WorkspaceFolder {
+                    uri: Url::from_directory_path(&self.root).unwrap(),
+                    name: "composer-root".into(),
+                }]),
+                ..InitializeParams::default()
+            })
+            .await
+            .unwrap();
+        router.initialized(InitializedParams {}).await;
+        router
+    }
+}
+
+async fn open(router: &ProjectRouter, path: &Path) -> String {
+    let source = fs::read_to_string(path).unwrap();
+    router
+        .did_open(DidOpenTextDocumentParams {
+            text_document: TextDocumentItem {
+                uri: Url::from_file_path(path).unwrap(),
+                language_id: "php".into(),
+                version: 1,
+                text: source.clone(),
+            },
+        })
+        .await;
+    source
+}
+
+async fn change(
+    router: &ProjectRouter,
+    path: &Path,
+    version: i32,
+    range: Option<Range>,
+    text: &str,
+) {
+    router
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: Url::from_file_path(path).unwrap(),
+                version,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range,
+                range_length: None,
+                text: text.into(),
+            }],
+        })
+        .await;
+}
+
+async fn watch(router: &ProjectRouter, path: &Path, typ: FileChangeType) {
+    router
+        .did_change_watched_files(DidChangeWatchedFilesParams {
+            changes: vec![FileEvent {
+                uri: Url::from_file_path(path).unwrap(),
+                typ,
+            }],
+        })
+        .await;
+}
+
+async fn assert_members(
+    router: &ProjectRouter,
+    path: &Path,
+    source: &str,
+    own: &str,
+    absent: &[&str],
+) {
+    let response = router
+        .completion(CompletionParams {
+            text_document_position: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier {
+                    uri: Url::from_file_path(path).unwrap(),
+                },
+                position: position_after(source, "$value->"),
+            },
+            context: None,
+            work_done_progress_params: WorkDoneProgressParams::default(),
+            partial_result_params: PartialResultParams::default(),
+        })
+        .await
+        .unwrap();
+    let items = match response {
+        Some(CompletionResponse::Array(items)) => items,
+        Some(CompletionResponse::List(list)) => list.items,
+        None => Vec::new(),
+    };
+    let labels: Vec<_> = items
+        .iter()
+        .map(|item| item.label.split('(').next().unwrap())
+        .collect();
+    assert!(
+        labels.contains(&own),
+        "{} missing {own}: {labels:?}",
+        path.display()
+    );
+    for name in absent {
+        assert!(
+            !labels.contains(name),
+            "{} includes foreign/stale {name}: {labels:?}",
+            path.display()
+        );
+    }
+}
+
+async fn assert_definition(
+    router: &ProjectRouter,
+    path: &Path,
+    source: &str,
+    needle: &str,
+    expected: &Path,
+) {
+    let response = router
+        .goto_definition(GotoDefinitionParams {
+            text_document_position_params: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier {
+                    uri: Url::from_file_path(path).unwrap(),
+                },
+                position: position_of(source, needle),
+            },
+            work_done_progress_params: WorkDoneProgressParams::default(),
+            partial_result_params: PartialResultParams::default(),
+        })
+        .await
+        .unwrap();
+    let locations = definition_locations(response);
+    assert_eq!(
+        locations.len(),
+        1,
+        "one exact {needle} definition required: {locations:?}"
+    );
+    assert_eq!(locations[0].uri, Url::from_file_path(expected).unwrap());
+}
+
+async fn assert_target(router: &ProjectRouter, path: &Path, expected: &str) {
+    let target = router
+        .workbench_active_target(ProjectTargetQuery {
+            uri: Some(Url::from_file_path(path).unwrap()),
+        })
+        .await
+        .unwrap();
+    assert_eq!(
+        target.php_version,
+        expected,
+        "wrong project/config owner for {}",
+        path.display()
+    );
+}
+
+async fn nested_order(child_first: bool) {
+    let fixture = Workspace::new(true);
+    let router = fixture.router().await;
+    let order = if child_first {
+        ["tools/child", ""]
+    } else {
+        ["", "tools/child"]
+    };
+    for directory in order {
+        let path = fixture.root.join(directory).join("index.php");
+        let source = open(&router, &path).await;
+        let own = if directory.is_empty() {
+            "fromRoot"
+        } else {
+            "fromChild"
+        };
+        let other = if directory.is_empty() {
+            "fromChild"
+        } else {
+            "fromRoot"
+        };
+        assert_members(&router, &path, &source, own, &[other]).await;
+        assert_definition(
+            &router,
+            &path,
+            &source,
+            "Service",
+            &fixture.root.join(directory).join("src/Service.php"),
+        )
+        .await;
+        let with_call = source.replace("$value->\n", &format!("$value->{own}();\n$value->\n"));
+        change(&router, &path, 2, None, &with_call).await;
+        assert_definition(
+            &router,
+            &path,
+            &with_call,
+            own,
+            &fixture.root.join(directory).join("src/Service.php"),
+        )
+        .await;
+    }
+    for (directory, own, other) in [
+        ("", "fromRoot", "fromChild"),
+        ("tools/child", "fromChild", "fromRoot"),
+    ] {
+        let source = CALLER.replace("$value->\n", &format!("$value->{own}();\n$value->\n"));
+        assert_members(
+            &router,
+            &fixture.root.join(directory).join("index.php"),
+            &source,
+            own,
+            &[other],
+        )
+        .await;
+    }
+    router.shutdown().await.unwrap();
+}
+
+#[tokio::test]
+async fn composer_nested_root_then_child_keeps_same_fqn_independent() {
+    nested_order(false).await;
+}
+
+#[tokio::test]
+async fn composer_nested_child_then_root_keeps_same_fqn_independent() {
+    nested_order(true).await;
+}
+
+#[tokio::test]
+async fn composer_nested_projects_apply_distinct_composer_php_targets() {
+    let fixture = Workspace::new(true);
+    let router = fixture.router().await;
+    for (directory, target) in [("tools/child", "8.4"), ("", "8.2"), ("tools/child", "8.4")] {
+        let path = fixture.root.join(directory).join("index.php");
+        open(&router, &path).await;
+        assert_target(&router, &path, target).await;
+    }
+    router.shutdown().await.unwrap();
+}
+
+#[tokio::test]
+async fn composer_nested_manifest_create_remove_replays_actual_unsaved_text_and_version() {
+    let fixture = Workspace::new(false);
+    let router = fixture.router().await;
+    let root_caller = fixture.root.join("index.php");
+    let child_caller = fixture.root.join("tools/child/index.php");
+    open(&router, &root_caller).await;
+    let original = open(&router, &child_caller).await;
+    assert_members(
+        &router,
+        &child_caller,
+        &original,
+        "fromRoot",
+        &["fromChild"],
+    )
+    .await;
+    let dirty = "<?php\n/* café 🐘 */ $value = new \\App\\AfterChange();\n$value->\n";
+    change(&router, &child_caller, 5, None, dirty).await;
+    assert_members(
+        &router,
+        &child_caller,
+        dirty,
+        "fromRootDirty",
+        &["fromChildDirty"],
+    )
+    .await;
+    fixture.manifest("tools/child", "8.4");
+    let manifest = fixture.root.join("tools/child/composer.json");
+    watch(&router, &manifest, FileChangeType::CREATED).await;
+    assert_members(
+        &router,
+        &child_caller,
+        dirty,
+        "fromChildDirty",
+        &["fromRootDirty", "fromChild"],
+    )
+    .await;
+    assert_target(&router, &child_caller, "8.4").await;
+    assert_members(
+        &router,
+        &root_caller,
+        CALLER,
+        "fromRoot",
+        &["fromChild", "fromChildDirty"],
+    )
+    .await;
+    // Replayed document version is 5, not a fabricated new opening at 1.
+    change(&router, &child_caller, 4, None, CALLER).await;
+    assert_members(
+        &router,
+        &child_caller,
+        dirty,
+        "fromChildDirty",
+        &["fromChild"],
+    )
+    .await;
+    let undone = dirty.replace("AfterChange", "AfterUndo");
+    change(
+        &router,
+        &child_caller,
+        6,
+        Some(Range::new(
+            position_of(dirty, "AfterChange"),
+            position_after(dirty, "AfterChange"),
+        )),
+        "AfterUndo",
+    )
+    .await;
+    assert_members(
+        &router,
+        &child_caller,
+        &undone,
+        "fromChildUndo",
+        &["fromChildDirty", "fromRootUndo"],
+    )
+    .await;
+    fs::remove_file(&manifest).unwrap();
+    watch(&router, &manifest, FileChangeType::DELETED).await;
+    assert_members(
+        &router,
+        &child_caller,
+        &undone,
+        "fromRootUndo",
+        &["fromChildUndo", "fromRoot"],
+    )
+    .await;
+    assert_target(&router, &child_caller, "8.2").await;
+    change(
+        &router,
+        &child_caller,
+        7,
+        Some(Range::new(
+            position_of(&undone, "AfterUndo"),
+            position_after(&undone, "AfterUndo"),
+        )),
+        "AfterChange",
+    )
+    .await;
+    assert_members(
+        &router,
+        &child_caller,
+        dirty,
+        "fromRootDirty",
+        &["fromChildDirty", "fromRootUndo"],
+    )
+    .await;
+    router
+        .did_close(DidCloseTextDocumentParams {
+            text_document: TextDocumentIdentifier {
+                uri: Url::from_file_path(&child_caller).unwrap(),
+            },
+        })
+        .await;
+    assert_eq!(fs::read_to_string(&child_caller).unwrap(), original);
+    assert_members(
+        &router,
+        &root_caller,
+        CALLER,
+        "fromRoot",
+        &["fromChild", "fromChildUndo"],
+    )
+    .await;
+    router.shutdown().await.unwrap();
+}

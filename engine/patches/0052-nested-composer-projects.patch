+async fn installed_dependency_control(kind: &str) {
+    let fixture = Workspace::new(false);
+    let (vendor, package) = match kind {
+        "custom" => (
+            "packages/deps with spaces",
+            "packages/deps with spaces/acme/library",
+        ),
+        "path" => ("vendor", "packages/module"),
+        _ => ("vendor", "vendor/acme/library"),
+    };
+    let mut manifest: serde_json::Value =
+        serde_json::from_slice(&fs::read(fixture.root.join("composer.json")).unwrap()).unwrap();
+    manifest["require"]["acme/library"] = serde_json::json!("@dev");
+    manifest["config"] = serde_json::json!({"vendor-dir":vendor});
+    if kind == "path" {
+        manifest["repositories"] =
+            serde_json::json!([{"type":"path","url":package,"options":{"symlink":true}}]);
+    }
+    fixture.write("composer.json", &manifest.to_string());
+    fixture.write(&format!("{package}/composer.json"), r#"{"name":"acme/library","require":{"php":"^7.4"},"autoload":{"psr-4":{"Library\\":"src/"}}}"#);
+    fixture.write(
+        &format!("{package}/.phpantom.toml"),
+        "[php]\nversion = \"7.4\"\n[indexing]\nstrategy = \"none\"\n",
+    );
+    fixture.write(&format!("{package}/src/Tool.php"), "<?php\nnamespace Library;\nclass Tool { public function fromInstalledLibrary(): void {} }\n");
+    let probe = "<?php\nnamespace Library;\nfunction probe(\\App\\Service $value): void {\n    $value->\n}\n";
+    fixture.write(&format!("{package}/src/probe.php"), probe);
+    let tool_caller = "<?php\n$value = new \\Library\\Tool();\n$value->\n";
+    fixture.write("library.php", tool_caller);
+    let install_path = if kind == "path" {
+        "../../packages/module"
+    } else {
+        "../acme/library"
+    };
+    fixture.write(
+        &format!("{vendor}/composer/installed.json"),
+        &serde_json::json!({"packages":[{
+            "name":"acme/library","version":"dev-main","install-path":install_path,
+            "dist":{"type":if kind == "path" {"path"} else {"zip"}},
+            "transport-options":{"symlink":kind == "path"},"autoload":{"psr-4":{"Library\\":"src/"}}
+        }]})
+        .to_string(),
+    );
+    fixture.write(&format!("{vendor}/composer/autoload_classmap.php"), &format!(
+        "<?php\n$vendorDir = dirname(__DIR__);\n$baseDir = dirname($vendorDir);\nreturn array(\n    'Library\\\\Tool' => $baseDir . '/{package}/src/Tool.php',\n);\n"));
+    // The actual Composer baseDir is the project root even for custom vendors;
+    // use a vendor-relative spelling there, as generated Composer maps do.
+    if kind != "path" {
+        fixture.write(&format!("{vendor}/composer/autoload_classmap.php"),
+            "<?php\n$vendorDir = dirname(__DIR__);\nreturn array(\n    'Library\\\\Tool' => $vendorDir . '/acme/library/src/Tool.php',\n);\n");
+    }
+    let router = fixture.router().await;
+    let caller = fixture.root.join("library.php");
+    open(&router, &caller).await;
+    assert_members(
+        &router,
+        &caller,
+        tool_caller,
+        "fromInstalledLibrary",
+        &["fromChild"],
+    )
+    .await;
+    assert_definition(
+        &router,
+        &caller,
+        tool_caller,
+        "Tool",
+        &fixture.root.join(package).join("src/Tool.php"),
+    )
+    .await;
+    let library_probe = fixture.root.join(package).join("src/probe.php");
+    open(&router, &library_probe).await;
+    assert_target(&router, &library_probe, "8.2").await;
+    assert_members(&router, &library_probe, probe, "fromRoot", &["fromChild"]).await;
+    assert_definition(
+        &router,
+        &library_probe,
+        probe,
+        "Service",
+        &fixture.root.join("src/Service.php"),
+    )
+    .await;
+    router.shutdown().await.unwrap();
+}

+#[tokio::test]
+async fn composer_nested_three_levels_revisit_each_own_members_targets_and_definitions() {
+    let fixture = Workspace::new(true);
+    fixture.manifest("tools/child", "8.3");
+    fixture.manifest("tools/child/apps/grandchild", "8.4");
+    fixture.write(
+        "tools/child/apps/grandchild/.phpantom.toml",
+        "[indexing]\nstrategy = \"none\"\n",
+    );
+    fixture.write(
+        "tools/child/apps/grandchild/src/Service.php",
+        "<?php\nnamespace App;\nclass Service { public function fromGrandchild(): void {} }\n",
+    );
+    let cases = [
+        ("", "fromRoot", "8.2"),
+        ("tools/child", "fromChild", "8.3"),
+        ("tools/child/apps/grandchild", "fromGrandchild", "8.4"),
+    ];
+    for (directory, member, _) in cases {
+        let source = CALLER.replace("$value->\n", &format!("$value->{member}();\n$value->\n"));
+        fixture.write(
+            Path::new(directory).join("index.php").to_str().unwrap(),
+            &source,
+        );
+    }
+    let router = fixture.router().await;
+    for (directory, _, _) in cases {
+        open(&router, &fixture.root.join(directory).join("index.php")).await;
+    }
+    for index in [0, 1, 2, 0, 1, 2] {
+        let (directory, own, target) = cases[index];
+        let path = fixture.root.join(directory).join("index.php");
+        let source = fs::read_to_string(&path).unwrap();
+        let absent: Vec<_> = cases
+            .iter()
+            .filter_map(|(_, member, _)| (*member != own).then_some(*member))
+            .collect();
+        assert_members(&router, &path, &source, own, &absent).await;
+        assert_target(&router, &path, target).await;
+        let expected = fixture.root.join(directory).join("src/Service.php");
+        assert_definition(&router, &path, &source, "Service", &expected).await;
+        assert_definition(&router, &path, &source, own, &expected).await;
+    }
+    router.shutdown().await.unwrap();
+}

+#[tokio::test]
+async fn composer_nested_later_consumer_reclaims_earlier_external_custom_vendor_package() {
+    let fixture = Workspace::new(false);
+    fs::remove_file(fixture.root.join("composer.json")).unwrap();
+    fixture.write("z-app/composer.json", r#"{"name":"fixture/consumer","require":{"php":"^8.2","acme/pkg":"^1.0"},"config":{"vendor-dir":"../a-deps"},"autoload":{"psr-4":{"App\\":"src/"}}}"#);
+    fixture.write("z-app/.phpantom.toml", "[indexing]\nstrategy = \"none\"\n");
+    fixture.write(
+        "z-app/src/Service.php",
+        "<?php\nnamespace App;\nclass Service { public function fromConsumer(): void {} }\n",
+    );
+    fixture.write(
+        "a-deps/acme/pkg/composer.json",
+        r#"{"name":"acme/pkg","require":{"php":"^7.4"},"autoload":{"psr-4":{"Library\\":"src/"}}}"#,
+    );
+    fixture.write(
+        "a-deps/acme/pkg/.phpantom.toml",
+        "[php]\nversion = \"7.4\"\n[indexing]\nstrategy = \"none\"\n",
+    );
+    fixture.write("a-deps/acme/pkg/src/Tool.php", "<?php\nnamespace Library;\nclass Tool { public function fromInstalledPackage(): void {} }\n");
+    fixture.write("a-deps/composer/installed.json", r#"{"packages":[{"name":"acme/pkg","version":"1.0.0","install-path":"../acme/pkg","autoload":{"psr-4":{"Library\\":"src/"}}}]}"#);
+    fixture.write("a-deps/composer/autoload_classmap.php", "<?php\n$vendorDir = dirname(__DIR__);\nreturn array(\n    'Library\\\\Tool' => $vendorDir . '/acme/pkg/src/Tool.php',\n);\n");
+    let caller_source =
+        "<?php\n$value = new \\Library\\Tool();\n$value->fromInstalledPackage();\n$value->\n";
+    fixture.write("z-app/index.php", caller_source);
+    let probe_source = "<?php\nnamespace Library;\nfunction probe(\\App\\Service $value): void {\n    $value->\n}\n";
+    fixture.write("a-deps/acme/pkg/src/probe.php", probe_source);
+    let router = fixture.router().await;
+    let caller = fixture.root.join("z-app/index.php");
+    open(&router, &caller).await;
+    assert_target(&router, &caller, "8.2").await;
+    assert_members(
+        &router,
+        &caller,
+        caller_source,
+        "fromInstalledPackage",
+        &["fromRoot", "fromChild"],
+    )
+    .await;
+    let tool = fixture.root.join("a-deps/acme/pkg/src/Tool.php");
+    assert_definition(&router, &caller, caller_source, "Tool", &tool).await;
+    assert_definition(
+        &router,
+        &caller,
+        caller_source,
+        "fromInstalledPackage",
+        &tool,
+    )
+    .await;
+    let probe = fixture.root.join("a-deps/acme/pkg/src/probe.php");
+    open(&router, &probe).await;
+    // a-deps is visited before z-app: later discovery of the consumer must
+    // retract the package's earlier candidate context, not leave it at 7.4.
+    assert_target(&router, &probe, "8.2").await;
+    assert_members(
+        &router,
+        &probe,
+        probe_source,
+        "fromConsumer",
+        &["fromRoot", "fromChild"],
+    )
+    .await;
+    assert_definition(
+        &router,
+        &probe,
+        probe_source,
+        "Service",
+        &fixture.root.join("z-app/src/Service.php"),
+    )
+    .await;
+    router.shutdown().await.unwrap();
+}

+        std::fs::write(child.join("composer.json"), r#"{"name":"fixture/child"}"#).unwrap();
+        assert_eq!(
+            super::discover_project_context_roots(&root),
+            vec![(child, "vendor".into())]
+        );
+    }
+
+    #[test]
+    fn discarded_dependency_metadata_cannot_hide_an_independent_application() {
+        let roots = [
+            project("/workspace/a-deps/library", &["/workspace/other"]),
+            project("/workspace/other", &[]),
+            project("/workspace/z-app", &["/workspace/a-deps"]),
+        ];
+        assert_eq!(independent_projects(&roots), vec![false, true, true]);
+    }
+
+    #[test]
+    fn mutually_consuming_roots_keep_contexts_but_their_libraries_do_not() {
+        let roots = [
+            project("/workspace/alpha", &["/workspace/beta"]),
+            project(
+                "/workspace/beta",
+                &["/workspace/alpha", "/workspace/library"],
+            ),
+            project("/workspace/library", &["/workspace/other"]),
+            project("/workspace/other", &[]),
+        ];
+        assert_eq!(independent_projects(&roots), vec![true, true, false, true]);
+    }
+
+    #[test]
+    fn shared_package_metadata_does_not_override_either_consuming_application() {
+        let roots = [
+            project("/workspace/packages/shared", &[]),
+            project("/workspace/apps/a", &["/workspace/packages/shared"]),
+            project("/workspace/apps/b", &["/workspace/packages/shared"]),
+        ];
+        assert_eq!(independent_projects(&roots), vec![false, true, true]);
+    }
+}

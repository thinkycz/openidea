+/// Physical installed path-package roots, including sources outside the consumer.
+pub(crate) fn installed_path_package_roots(root: &Path, vendor: &str) -> Vec<PathBuf> {
+    installed_path_packages(root, vendor)
+        .into_iter()
+        .map(|(_, path)| path)

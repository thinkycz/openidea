+#[tokio::test]
+async fn composer_nested_manifest_lifecycle_replays_current_dirty_declaration() {
+    let fixture = Workspace::new(false);
+    let declaration_source = "<?php\nnamespace Feature;\nclass Recovered { public function value(): \\App\\Service { return new \\App\\Service(); } }\n";
+    fixture.write("tools/child/src/Recovered.php", declaration_source);
+    let router = fixture.router().await;
+    let declaration = fixture.root.join("tools/child/src/Recovered.php");
+    open(&router, &declaration).await;
+    let dirty = declaration_source.replace("App\\Service", "App\\AfterChange");
+    change(&router, &declaration, 8, None, &dirty).await;
+    let caller = fixture.root.join("tools/child/index.php");
+    let saved = open(&router, &caller).await;
+    let current_caller = "<?php\n$value = (new \\Feature\\Recovered())->value();\n$value->\n";
+    change(&router, &caller, 2, None, current_caller).await;
+    assert_members(
+        &router,
+        &caller,
+        current_caller,
+        "fromRootDirty",
+        &["fromChildDirty"],
+    )
+    .await;
+    fixture.manifest("tools/child", "8.4");
+    let manifest = fixture.root.join("tools/child/composer.json");
+    watch(&router, &manifest, FileChangeType::CREATED).await;
+    assert_members(
+        &router,
+        &caller,
+        current_caller,
+        "fromChildDirty",
+        &["fromRootDirty", "fromChild"],
+    )
+    .await;
+    assert_target(&router, &declaration, "8.4").await;
+    assert_definition(&router, &caller, current_caller, "Recovered", &declaration).await;
+    change(&router, &declaration, 7, None, declaration_source).await;
+    assert_members(
+        &router,
+        &caller,
+        current_caller,
+        "fromChildDirty",
+        &["fromChild"],
+    )
+    .await;
+    let undone = dirty.replace("App\\AfterChange", "App\\AfterUndo");
+    change(&router, &declaration, 9, None, &undone).await;
+    assert_members(
+        &router,
+        &caller,
+        current_caller,
+        "fromChildUndo",
+        &["fromChildDirty", "fromRootUndo"],
+    )
+    .await;
+    fs::remove_file(&manifest).unwrap();
+    watch(&router, &manifest, FileChangeType::DELETED).await;
+    assert_members(
+        &router,
+        &caller,
+        current_caller,
+        "fromRootUndo",
+        &["fromChildUndo", "fromRoot"],
+    )
+    .await;
+    assert_target(&router, &declaration, "8.2").await;
+    router
+        .did_close(DidCloseTextDocumentParams {
+            text_document: TextDocumentIdentifier {
+                uri: Url::from_file_path(&declaration).unwrap(),
+            },
+        })
+        .await;
+    assert_members(
+        &router,
+        &caller,
+        current_caller,
+        "fromRoot",
+        &["fromRootUndo", "fromChild"],
+    )
+    .await;
+    assert_eq!(
+        fs::read_to_string(&declaration).unwrap(),
+        declaration_source
+    );
+    assert_eq!(fs::read_to_string(&caller).unwrap(), saved);
+    router.shutdown().await.unwrap();
+}

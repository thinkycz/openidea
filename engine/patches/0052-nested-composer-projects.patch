+
+struct DiscoveredProject {
+    root: PathBuf,
+    vendor_dir: String,
+    dependencies: Vec<PathBuf>,
+}
+
+fn project_reaches(edges: &[Vec<usize>], pending: &[bool], from: usize, target: usize) -> bool {
+    let mut visited = vec![false; edges.len()];
+    let mut stack = vec![from];
+    visited[from] = true;
+    while let Some(node) = stack.pop() {
+        if node == target {
+            return true;
+        }
+        for &next in &edges[node] {
+            if pending[next] && !visited[next] {
+                visited[next] = true;
+                stack.push(next);
+            }
+        }
+    }
+    false
+}
+
+fn independent_projects(projects: &[DiscoveredProject]) -> Vec<bool> {
+    let edges: Vec<Vec<usize>> = projects
+        .iter()
+        .enumerate()
+        .map(|(owner, project)| {
+            projects
+                .iter()
+                .enumerate()
+                .filter_map(|(index, candidate)| {
+                    (index != owner
+                        && project
+                            .dependencies
+                            .iter()
+                            .any(|path| candidate.root.starts_with(path)))
+                    .then_some(index)
+                })
+                .collect()
+        })
+        .collect();
+    let mut pending = vec![true; projects.len()];
+    let mut accepted = vec![false; projects.len()];
+    while let Some(first) = pending.iter().position(|pending| *pending) {
+        let independent = (0..projects.len()).find(|&index| {
+            pending[index]
+                && !edges
+                    .iter()
+                    .enumerate()
+                    .any(|(owner, dependencies)| pending[owner] && dependencies.contains(&index))
+        });
+        let group = if let Some(index) = independent {
+            vec![index]
+        } else {
+            // Mutually consuming development roots retain their own contexts.
+            // Move to a source component before excluding its libraries, so a
+            // discarded library's configuration cannot hide another project.
+            let mut current = first;
+            loop {
+                let group: Vec<_> = (0..projects.len())
+                    .filter(|&index| {
+                        pending[index]
+                            && project_reaches(&edges, &pending, current, index)
+                            && project_reaches(&edges, &pending, index, current)
+                    })
+                    .collect();
+                if let Some(owner) = (0..projects.len()).find(|&owner| {
+                    pending[owner]
+                        && !group.contains(&owner)
+                        && edges[owner].iter().any(|index| group.contains(index))
+                }) {
+                    current = owner;
+                } else {
+                    break group;
+                }
+            }
+        };
+        for &index in &group {
+            accepted[index] = true;
+            pending[index] = false;
+        }
+        for index in group {
+            for &dependency in &edges[index] {
+                pending[dependency] = false;
+            }
+        }
+    }
+    accepted
+}

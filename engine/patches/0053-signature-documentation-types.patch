+/// Use the same Markdown summary/return vocabulary as hover, without repeating
+/// parameter descriptions already attached to their individual LSP entries.
+fn build_callable_documentation(
+    description: Option<&str>,
+    return_description: Option<&str>,
+    return_type: Option<&PhpType>,
+) -> Option<Documentation> {
+    let mut sections = Vec::new();
+    if let Some(description) = description.map(str::trim).filter(|value| !value.is_empty()) {
+        sections.push(description.to_owned());
+    }
+    if let Some(description) = return_description
+        .map(str::trim)
+        .filter(|value| !value.is_empty())
+    {
+        let mut returned = String::from("**return**");
+        if let Some(ty) = return_type.filter(|ty| !ty.is_mixed()) {
+            returned.push_str(&format!(" `{}`", crate::hover::shorten_php_type(ty)));
+        }
+        returned.push(' ');
+        returned.push_str(description);
+        sections.push(returned);
+    }
+    if sections.is_empty() {
+        return None;
+    }
+    Some(Documentation::MarkupContent(MarkupContent {
+        kind: MarkupKind::Markdown,
+        value: sections.join("\n\n"),
+    }))
+}

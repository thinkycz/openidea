+     * @return string Work result.
+     */
+    public function run(int $count): string {{ return 'ok'; }}
+    /**
+     * Fetch static work.
+     * @return string Static result.
+     */
+    public static function fetch(int $count): string {{ return 'ok'; }}
+}}
+class ChildDoc extends ParentDoc {{}}
+$child = new ChildDoc();
+{call}
+"#
+        );
+        let help = callable_doc_help(&backend, name, &source).await;

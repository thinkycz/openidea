+#[tokio::test]
+async fn signature_type_selection_full_route_resolves_current_namespace_and_imported_class() {
+    let source = "<?php\nfunction classfit(\\Vendor\\First $value): int {}\nfunction classfit(\\Vendor\\Second $value): string {}";
+    let result = help("classfit", source, "namespace Vendor; class First {} class Second {} namespace App; use Vendor\\Second as Picked; classfit(new Picked()<caret>);").await;

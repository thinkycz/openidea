+/**
+ * Text declaration summary.
+ * @param string $value Text input.
+ * @return string Text result.
+ */
+function docvariant(string $value): string {}
+/**
+ * Array declaration summary.
+ * @param array $value Array input.
+ * @return array Array result.
+ */
+function docvariant(array $value): array {}
+/** @param int $value Integer input. */
+function docvariant(int $value): int {}
+"#,
+    );
+    let help = overload_help(&backend, "docvariant", "docvariant([]<caret>);")
+        .await
+        .unwrap();
+    assert_eq!(help.signatures.len(), 3);
+    for (index, own, other, returned) in [
+        (
+            0,
+            "Text declaration summary.",
+            "Array declaration summary.",
+            "Text result.",
+        ),
+        (
+            1,
+            "Array declaration summary.",

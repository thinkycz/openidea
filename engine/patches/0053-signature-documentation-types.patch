+            vec![make_param("$x", Some("array"), true)],
+            vec![vec![make_param("$x", Some("int"), true)]],
+        );
+        assert_eq!(
+            preference(
+                &alternatives,
+                &["$value"],
+                "<?php declare(strict_types=1); $value = 17;"
+            ),
+            Some(1)
+        );
+        let alternatives = target(
+            vec![make_param("$x", Some("int"), true)],
+            vec![vec![make_param("$x", Some("?int"), true)]],
+        );
+        assert_eq!(preference(&alternatives, &["null"], "<?php"), Some(1));
+        let alternatives = target(
+            vec![make_param("$x", Some("array"), true)],
+            vec![vec![make_param("$x", Some("int|string"), true)]],
+        );
+        assert_eq!(
+            preference(&alternatives, &["'name'"], "<?php declare(strict_types=1);"),
+            Some(1)
+        );
+    }
+
+    #[test]
+    fn signature_type_preference_unknown_ambiguous_unpack_and_limits_keep_fallback() {
+        let alternatives = target(
+            vec![make_param("$x", Some("array"), true)],
+            vec![vec![make_param("$x", Some("int"), true)]],
+        );
+        for args in [
+            vec!["$unresolved"],
+            vec![""],
+            vec!["...$values"],
+            vec!["value: ...$values"],
+            vec!["42"; 65],
+        ] {
+            assert_eq!(preference(&alternatives, &args, "<?php"), None);
+        }
+        let ambiguous = target(
+            vec![make_param("$x", Some("int"), true)],
+            vec![vec![make_param("$x", Some("mixed"), true)]],
+        );
+        assert_eq!(
+            preference(&ambiguous, &["1"], "<?php declare(strict_types=1);"),
+            None
+        );
+        assert_eq!(
+            preference(&alternatives, &[&" ".repeat(16 * 1024 + 1)], "<?php"),
+            None
+        );
+        let many = target(
+            vec![make_param("$x", Some("array"), true)],
+            vec![vec![make_param("$x", Some("int"), true)]; 64],
+        );
+        assert_eq!(preference(&many, &["1"], "<?php"), None);
+    }

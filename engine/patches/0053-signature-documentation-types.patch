 use tower_lsp::LanguageServer;
 use tower_lsp::lsp_types::*;
 
+async fn callable_doc_help(
+    backend: &phpantom_lsp::Backend,
+    name: &str,
+    marked: &str,
+) -> SignatureHelp {
+    let prefix = marked.split_once("<caret>").unwrap().0;
+    let line = prefix.bytes().filter(|byte| *byte == b'\n').count() as u32;
+    let character = prefix.rsplit('\n').next().unwrap().encode_utf16().count() as u32;
+    let uri = Url::parse(&format!(
+        "file:///signature_callable_documentation_{name}.php"
+    ))
+    .unwrap();
+    sig_help_at(
+        backend,
+        &uri,
+        &marked.replace("<caret>", ""),
+        line,
+        character,
+    )
+    .await
+    .unwrap()
+}
+
+fn callable_markdown(signature: &SignatureInformation) -> &str {
+    match signature
+        .documentation
+        .as_ref()
+        .expect("callable description must survive signature projection")
+    {
+        Documentation::MarkupContent(content) => {
+            assert_eq!(content.kind, MarkupKind::Markdown);
+            &content.value
+        }
+        other => panic!("expected Markdown signature docs, got {other:?}"),
+    }
+}
+
+#[tokio::test]
+async fn signature_callable_documentation_function_retains_parameter_docs_and_utf16_ranges() {
+    let backend = create_test_backend();
+    let help = callable_doc_help(
+        &backend,
+        "function",
+        r#"<?php
+/**
+ * Build **records**.
+ *
+ * Details with žluť.
+ * @param string $první Record label.
+ * @return string Saved identifier.
+ */
+function docfit(string $první = '🐘'): string { return $první; }
+docfit(<caret>);
+"#,
+    )
+    .await;
+    let docs = callable_markdown(&help.signatures[0]);
+    assert!(docs.contains("Build **records**."));
+    assert!(docs.contains("Details with žluť."));
+    assert!(docs.contains("**return**") && docs.contains("Saved identifier."));
+    assert_eq!(param_labels(&help), vec!["string $první = '🐘'"]);
+    assert_eq!(param_docs(&help)[0].as_deref(), Some("Record label."));
+    assert_eq!(help.active_parameter, Some(0));
+}
+
+#[tokio::test]

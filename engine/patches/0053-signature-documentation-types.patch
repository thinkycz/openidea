@@ -0,0 +1,610 @@
+//! Conservative type preference for otherwise applicable signature alternatives.
+use crate::php_type::{PhpType, TypeKind};
+use crate::type_engine::resolver::CtxLoaders;
+use crate::{
+    Backend,
+    types::{FileContext, ResolvedCallableTarget},
+};
+use std::cell::Cell;
+
+const MAX_ARGS: usize = 64;
+const MAX_ALTERNATIVES: usize = 64;
+const MAX_TEXT: usize = 16 * 1024;
+
+/// Shared admission before either argument-aware binding or extra inference.
+/// The standalone ranking API also checks aggregate slices when no raw span is
+/// supplied; the production adapter supplies the complete argument span.
+pub(crate) fn arguments_admit_type_preference(args_text: &str, args: &[&str]) -> bool {
+    args.len() <= MAX_ARGS
+        && args_text.len() <= MAX_TEXT
+        && args
+            .iter()
+            .try_fold(0usize, |n, arg| n.checked_add(arg.len()))
+            .is_some_and(|n| n <= MAX_TEXT)
+        && !args.iter().any(|argument| {
+            let argument = crate::call_args::trim_argument_trivia(argument);
+            let value = crate::call_args::text_arg_value(argument);
+            crate::call_args::trim_argument_trivia(value).starts_with("...")
+        })
+}
+
+/// Bound argument-aware substitution across the whole target before it runs.
+pub(crate) fn target_admits_type_preference(target: &ResolvedCallableTarget) -> bool {
+    !target.overloads.is_empty()
+        && target.overloads.len() < MAX_ALTERNATIVES
+        && target.parameters.len() <= MAX_ARGS
+        && target
+            .overloads
+            .iter()
+            .all(|variant| variant.parameters.len() <= MAX_ARGS)
+}
+
+thread_local! { static RESOLVING: Cell<bool> = const { Cell::new(false) }; }
+struct Resolving;
+impl Drop for Resolving {
+    fn drop(&mut self) {
+        RESOLVING.with(|value| value.set(false));
+    }
+}
+
+fn informative(ty: &PhpType) -> bool {
+    !ty.is_mixed()
+        && !ty.is_untyped()
+        && !ty.is_empty()
+        && !ty.is_never()
+        && !matches!(ty.kind(), TypeKind::Raw(value) if value.is_empty())
+}
+
+impl Backend {
+    #[allow(clippy::too_many_arguments)]
+    pub(crate) fn signature_type_preference(
+        &self,
+        target: &ResolvedCallableTarget,
+        args: &[&str],
+        eligible: &[usize],
+        content: &str,
+        offset: u32,
+        ctx: &FileContext,
+    ) -> Option<usize> {
+        if !arguments_admit_type_preference("", args)
+            || eligible.len() < 2
+            || eligible.len() > MAX_ALTERNATIVES
+            || offset as usize > content.len()
+            || !content.is_char_boundary(offset as usize)
+        {
+            return None;
+        }
+        let mut indices = eligible.to_vec();
+        indices.sort_unstable();
+        indices.dedup();
+        if indices.len() < 2 || indices.iter().any(|index| *index > target.overloads.len()) {
+            return None;
+        }
+        let values = args
+            .iter()
+            .map(|argument| {
+                let (name, value) = crate::call_args::split_named_text_arg(
+                    crate::call_args::trim_argument_trivia(argument),
+                );
+                (name, crate::call_args::trim_argument_trivia(value))
+            })
+            .collect::<Vec<_>>();
+        // An unpack can change cardinality and named roles. Do not guess which
+        // parameter receives it or any subsequent argument.
+        if values.iter().any(|(_, value)| value.starts_with("...")) {
+            return None;
+        }
+        if RESOLVING.with(|value| value.replace(true)) {
+            return None;
+        }
+        let _resolving = Resolving;
+        let namespace = ctx.namespace_at(offset);
+        let imports = ctx.use_map_at(offset);
+        let class_loader = self.class_loader_with(&ctx.classes, imports, namespace);
+        let function_loader =
+            self.function_loader_with(ctx.resolved_names.as_deref(), imports, namespace);
+        let macro_resolver = self.laravel_macro_this_resolver(&class_loader);
+        let current_class = crate::class_lookup::find_class_at_offset(&ctx.classes, offset);
+        let rctx = self.resolution_ctx_at(
+            current_class,
+            &ctx.classes,
+            content,
+            offset,
+            CtxLoaders::new(&class_loader, &function_loader, &macro_resolver),
+        );
+        let types = values
+            .iter()
+            .map(|(_, value)| {
+                if value.is_empty() {
+                    None
+                } else {
+                    Self::resolve_arg_text_to_type(value, &rctx).filter(informative)
+                }
+            })
+            .collect::<Vec<_>>();
+        if types.iter().all(Option::is_none) {
+            return None;
+        }
+        let strict = crate::parser::with_parsed_program(
+            content,
+            "signature_type_preference",
+            |program, _| crate::diagnostics::has_strict_types(program),
+        );
+        let parent = target
+            .owner_class
+            .as_ref()
+            .and_then(|owner| class_loader(owner))
+            .and_then(|owner| owner.parent_class.as_ref().map(|parent| parent.to_string()));
+        let mut survivor = None;
+        let mut surviving_count = 0;
+        let mut type_rejected = false;
+        for index in indices {
+            let (parameters, constraints) = if index == 0 {
+                (&target.parameters, &target.self_bound_params)
+            } else {
+                let variant = &target.overloads[index - 1];
+                (&variant.parameters, &variant.self_bound_params)
+            };
+            if parameters.len() > MAX_ARGS {
+                return None;
+            }
+            if !crate::call_args::text_args_have_compatible_roles(parameters, args) {
+                return None;
+            }
+            let variadic = parameters
+                .iter()
+                .position(|parameter| parameter.is_variadic);
+            let mut positional = 0;
+            let mut rejected = false;
+            for ((name, value), argument_type) in values.iter().zip(&types) {
+                if value.is_empty() {
+                    continue;
+                }
+                let parameter = if let Some(name) = name {
+                    parameters
+                        .iter()
+                        .position(|parameter| parameter.name.trim_start_matches('$') == *name)
+                        .or(variadic)
+                } else {
+                    let result = (positional < parameters.len())
+                        .then_some(positional)
+                        .or(variadic);
+                    positional += 1;
+                    result
+                }
+                .and_then(|index| parameters.get(index));
+                let parameter = parameter?;
+                let Some(argument_type) = argument_type else {
+                    continue;
+                };
+                let parameter_type = match constraints.get(&parameter.name) {
+                    Some(None) => continue,
+                    Some(Some(bound)) => bound,
+                    None => match parameter.type_hint.as_ref() {
+                        Some(ty) => ty,
+                        None => continue,
+                    },
+                };
+                if !informative(parameter_type)
+                    || (parameter.is_reference && parameter.defaults_to_null())
+                {
+                    continue;
+                }
+                let relative;
+                let effective = if parameter_type.contains_relative_class_ref() {
+                    let Some(owner) = &target.owner_class else {
+                        continue;
+                    };
+                    relative = parameter_type.resolve_self_refs_bounded(owner, parent.as_deref());
+                    &relative
+                } else {
+                    parameter_type
+                };
+                if !crate::diagnostics::is_type_compatible(
+                    argument_type,
+                    effective,
+                    &class_loader,
+                    strict,
+                ) {
+                    rejected = true;
+                    type_rejected = true;
+                    break;
+                }
+            }
+            if !rejected {
+                survivor = Some(index);
+                surviving_count += 1;
+            }
+        }
+        if surviving_count == 1 && type_rejected {
+            survivor
+        } else {
+            None
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{
+        php_type::PhpType,
+        test_fixtures::{make_backend, make_param},
+        types::{CallableOverload, ParameterInfo},
+    };
+    use std::sync::Arc;
+
+    fn target(
+        primary: Vec<ParameterInfo>,
+        alternatives: Vec<Vec<ParameterInfo>>,
+    ) -> ResolvedCallableTarget {
+        ResolvedCallableTarget {
+            parameters: primary.into(),
+            overloads: alternatives
+                .into_iter()
+                .map(|parameters| {
+                    Arc::new(CallableOverload {
+                        parameters: parameters.into(),
+                        return_type: None,
+                        templates: None,
+                        description: None,
+                        return_description: None,
+                        self_bound_params: Default::default(),
+                    })
+                })
+                .collect(),
+            ..Default::default()
+        }
+    }
+
+    fn context(backend: &Backend, content: &str) -> FileContext {
+        FileContext {
+            classes: backend
+                .parse_and_cache_content(content, "file:///signature-overloads-unit.php")
+                .expect("prepared file context"),
+            use_map: backend.parse_use_statements(content),
+            namespace: backend.parse_namespace(content),
+            namespace_spans: None,
+            resolved_names: None,
+        }
+    }
+
+    fn preference(target: &ResolvedCallableTarget, args: &[&str], prefix: &str) -> Option<usize> {
+        let backend = make_backend();
+        let content = format!("{prefix}\npick({});", args.join(", "));
+        let ctx = context(&backend, &content);
+        let eligible = (0..=target.overloads.len()).collect::<Vec<_>>();
+        backend.signature_type_preference(
+            target,
+            args,
+            &eligible,
+            &content,
+            content.len() as u32,
+            &ctx,
+        )
+    }
+
+    #[test]
+    fn signature_type_preference_known_types_override_both_declaration_orders() {
+        for (first, second, expected) in [("array", "int", 1), ("int", "array", 0)] {
+            let target = target(
+                vec![make_param("$x", Some(first), true)],
+                vec![vec![make_param("$x", Some(second), true)]],
+            );
+            assert_eq!(
+                preference(&target, &["42"], "<?php declare(strict_types=1);"),
+                Some(expected)
+            );
+        }
+    }
+
+    #[test]
+    fn signature_type_preference_named_roles_and_every_variadic_value_matter() {
+        let mut ints = make_param("$values", Some("int"), false);
+        ints.is_variadic = true;
+        let mut strings = make_param("$values", Some("string"), false);
+        strings.is_variadic = true;
+        let alternatives = target(vec![ints], vec![vec![strings]]);
+        assert_eq!(
+            preference(
+                &alternatives,
+                &["'one'", "'two'"],
+                "<?php declare(strict_types=1);"
+            ),
+            Some(1)
+        );
+        assert_eq!(
+            preference(
+                &alternatives,
+                &["label: 'one'", "other: 'two'"],
+                "<?php declare(strict_types=1);"
+            ),
+            Some(1)
+        );
+        assert_eq!(
+            preference(
+                &alternatives,
+                &["1", "'two'"],
+                "<?php declare(strict_types=1);"
+            ),
+            None,
+            "no whole alternative admits both values"
+        );
+        let alternatives = target(
+            vec![
+                make_param("$a", Some("array"), true),
+                make_param("$b", Some("int"), true),
+            ],
+            vec![vec![
+                make_param("$a", Some("int"), true),
+                make_param("$b", Some("array"), true),
+            ]],
+        );
+        assert_eq!(
+            preference(&alternatives, &["b /* trivia */: []", "a: 3"], "<?php"),
+            Some(1)
+        );

+    fn signature_type_preference_target_admission_bounds_binding_before_ranking() {
+        let params = vec![make_param("$value", Some("int"), true)];
+        let mut admitted = target(params.clone(), vec![params.clone(); 63]);
+        assert!(target_admits_type_preference(&admitted));
+        admitted.overloads.push(admitted.overloads[0].clone());
+        assert!(!target_admits_type_preference(&admitted));
+        let mut admitted = target(vec![params[0].clone(); 64], vec![params.clone()]);
+        assert!(target_admits_type_preference(&admitted));
+        admitted.parameters.make_mut().push(params[0].clone());
+        assert!(!target_admits_type_preference(&admitted));
+        let rejected = target(params.clone(), vec![vec![params[0].clone(); 65]]);
+        assert!(!target_admits_type_preference(&rejected));
+    }
+}

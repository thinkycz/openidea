diff --git a/tests/integration/signature_type_selection.rs b/tests/integration/signature_type_selection.rs
new file mode 100644
index 0000000..d5b0285
--- /dev/null
+++ b/tests/integration/signature_type_selection.rs
@@ -0,0 +1,192 @@
+use crate::common::create_test_backend_with_function_stubs;
+use tower_lsp::{LanguageServer, lsp_types::*};
+
+async fn help(name: &'static str, stubs: &'static str, call: &str) -> SignatureHelp {
+    let backend = create_test_backend_with_function_stubs();
+    backend.stub_function_index_mut().insert(name, stubs);
+    let marked = format!("<?php\ndeclare(strict_types=1);\n{call}\n");
+    let prefix = marked.split_once("<caret>").unwrap().0;
+    let uri = Url::parse("file:///signature_type_selection.php").unwrap();
+    backend
+        .did_open(DidOpenTextDocumentParams {
+            text_document: TextDocumentItem::new(
+                uri.clone(),
+                "php".into(),
+                1,
+                marked.replace("<caret>", ""),
+            ),
+        })
+        .await;
+    backend
+        .signature_help(SignatureHelpParams {
+            text_document_position_params: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier::new(uri),
+                position: Position::new(
+                    prefix.bytes().filter(|byte| *byte == b'\n').count() as u32,
+                    prefix.rsplit('\n').next().unwrap().encode_utf16().count() as u32,
+                ),
+            },
+            work_done_progress_params: Default::default(),
+            context: None,
+        })
+        .await
+        .unwrap()
+        .expect("signature help")
+}
+
+fn selected(help: &SignatureHelp) -> &SignatureInformation {
+    &help.signatures[help.active_signature.unwrap_or(0) as usize]
+}
+
+fn docs(signature: &SignatureInformation) -> &str {
+    match signature
+        .documentation
+        .as_ref()
+        .expect("selected declaration docs")
+    {
+        Documentation::MarkupContent(content) => &content.value,
+        Documentation::String(content) => content,
+    }
+}
+
+#[tokio::test]
+async fn signature_type_selection_full_route_uses_types_and_keeps_own_docs_in_both_orders() {
+    for (source, expected) in [
+        (
+            "<?php\n/** Array declaration. */ function typedfit(array $value): array {}\n/** Integer declaration. */ function typedfit(int $value): int {}",
+            1,
+        ),
+        (
+            "<?php\n/** Integer declaration. */ function typedfit(int $value): int {}\n/** Array declaration. */ function typedfit(array $value): array {}",
+            0,
+        ),
+    ] {
+        let result = help("typedfit", source, "typedfit(3<caret>);").await;
+        assert_eq!(result.active_signature, Some(expected));
+        assert!(selected(&result).label.ends_with(": int"));
+        assert!(docs(selected(&result)).contains("Integer declaration."));
+        assert!(!docs(selected(&result)).contains("Array declaration."));
+        assert_eq!(result.active_parameter, Some(0));
+    }
+}
+
+#[tokio::test]
+async fn signature_type_selection_full_route_maps_reordered_unicode_named_arguments() {
+    let source = "<?php\nfunction namefit(array $první, int $second): array {}\nfunction namefit(int $první, array $second): int {}";
+    let result = help(
+        "namefit",
+        source,
+        "namefit(second /* label */: [], první: 3<caret>);",
+    )
+    .await;
+    assert_eq!(result.active_signature, Some(1));
+    assert_eq!(result.active_parameter, Some(0));
+    assert_eq!(selected(&result).active_parameter, Some(0));
+}
+
+#[tokio::test]
+async fn signature_type_selection_full_route_checks_every_variadic_argument_and_named_key() {
+    let source = "<?php\nfunction varfit(int ...$values): int {}\nfunction varfit(array ...$values): array {}";
+    for call in [
+        "varfit([], ['x']<caret>);",
+        "varfit(label: [], other: ['x']<caret>);",
+    ] {
+        let result = help("varfit", source, call).await;
+        assert_eq!(result.active_signature, Some(1));
+        assert_eq!(result.active_parameter, Some(0));
+    }
+    let result = help("varfit", source, "varfit(1, []<caret>);").await;
+    assert_eq!(
+        result.active_signature,
+        Some(0),
+        "incompatible whole variants retain stable fallback"
+    );
+}
+
+#[tokio::test]
+async fn signature_type_selection_full_route_preserves_unknown_ambiguous_and_unpack_fallback() {
+    let source = "<?php\nfunction unknownfit(array $value): array {}\nfunction unknownfit(int $value): int {}";
+    for call in [
+        "unknownfit($unknown<caret>);",
+        "unknownfit(<caret>);",
+        "unknownfit(...$values<caret>);",
+    ] {
+        let result = help("unknownfit", source, call).await;
+        assert_eq!(result.active_signature, Some(0));
+    }
+    let result = help("ambiguousfit", "<?php\nfunction ambiguousfit(int $value): int {}\nfunction ambiguousfit(mixed $value): mixed {}", "ambiguousfit(3<caret>);").await;
+    assert_eq!(result.active_signature, Some(0));
+}
+
+#[tokio::test]
+async fn signature_type_selection_full_route_retains_each_variants_generic_constraints() {
+    let source = r#"<?php
+/** Array generic.
+ * @template T of array
+ * @param T $value
+ * @return T
+ */
+function generictyped($value) {}
+/** Integer generic.
+ * @template U of int
+ * @param U $value
+ * @return U
+ */
+function generictyped($value) {}
+"#;
+    let result = help("generictyped", source, "generictyped(9<caret>);").await;
+    assert_eq!(result.active_signature, Some(1));
+    assert!(docs(selected(&result)).contains("Integer generic."));
+    // The shared generic binder preserves the integer literal as its exact
+    // return type rather than widening it to the native scalar category.
+    assert_eq!(selected(&result).label, "($value): 9");
+    for call in ["generictyped(<caret>);", "generictyped($unknown<caret>);"] {
+        let result = help("generictyped", source, call).await;
+        assert_eq!(result.active_signature, Some(0));
+        assert_eq!(selected(&result).label, "($value): T");
+    }
+}
+
+#[tokio::test]
+async fn signature_type_selection_documentation_follows_current_unsaved_source() {
+    let backend = create_test_backend_with_function_stubs();
+    let uri = Url::parse("file:///signature_current_documentation.php").unwrap();
+    let first = "<?php\n/** First callable summary. */\nfunction currentdoc(string $value): string { return $value; }\ncurrentdoc(";
+    backend
+        .did_open(DidOpenTextDocumentParams {
+            text_document: TextDocumentItem::new(uri.clone(), "php".into(), 1, first.into()),
+        })
+        .await;
+    let request = || SignatureHelpParams {
+        text_document_position_params: TextDocumentPositionParams {
+            text_document: TextDocumentIdentifier::new(uri.clone()),
+            position: Position::new(3, "currentdoc(".len() as u32),
+        },
+        work_done_progress_params: Default::default(),
+        context: None,
+    };
+    let result = backend.signature_help(request()).await.unwrap().unwrap();
+    assert!(docs(selected(&result)).contains("First callable summary."));
+    backend
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier::new(uri.clone(), 2),
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: first.replace("First callable summary.", "Current unsaved summary."),
+            }],
+        })
+        .await;
+    let result = backend.signature_help(request()).await.unwrap().unwrap();
+    let current = docs(selected(&result));
+    assert!(current.contains("Current unsaved summary."));
+    assert!(!current.contains("First callable summary."));
+}

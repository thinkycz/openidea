+
+    #[test]
+    fn completion_target_utf16_member_after_astral_and_suffix() {
+        for marked in [
+            "<?php\n$note = 'ž🐘'; $child->formatL<caret>;\n",
+            "<?php\n$note = '🐘🐘'; $child->formatL<caret>('x');\n",
+            "<?php\n$note = '🐘'; $child->formatL<caret>abel;\n",
+            "<?php\r\n$note = 'ž🐘'; $child->formatL<caret>;\r\n",
+        ] {
+            let target = target_at(marked).unwrap_or_else(|| panic!("no target: {marked:?}"));
+            assert_eq!(target.subject, "$child", "{marked:?}");
+            assert!(matches!(target.access_kind, AccessKind::Arrow));
+        }
+    }
+
+    #[test]
+    fn completion_target_utf16_nullsafe_static_and_unicode_variable() {
+        for (marked, subject, is_static) in [

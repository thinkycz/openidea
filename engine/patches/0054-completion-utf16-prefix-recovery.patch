+fn extract_partial_at_utf16_marker(marked: &str) -> Option<String> {
+    let (before, _) = marked.split_once("<caret>").expect("one caret marker");
+    let position = Position::new(
+        before.bytes().filter(|byte| *byte == b'\n').count() as u32,
+        before.rsplit('\n').next().unwrap().encode_utf16().count() as u32,
+    );
+    Backend::extract_partial_class_name(&marked.replace("<caret>", ""), position)
+}
+
+#[test]
+fn test_extract_partial_utf16_after_astral_before_semicolon() {
+    for marked in [
+        "<?php\nnamespace Demo;\n$note = 'ž🐘'; renderL<caret>;\n",
+        "<?php\nnamespace Demo;\n$note = '🐘🐘'; renderL<caret>;\n",
+        "<?php\r\nnamespace Demo;\r\n$note = 'ž🐘'; renderL<caret>;\r\n",
+    ] {
+        assert_eq!(
+            extract_partial_at_utf16_marker(marked),
+            Some("renderL".into()),
+            "{marked:?}"
+        );
+    }
+}
+
+#[test]
+fn test_extract_partial_utf16_after_astral_before_parenthesis() {
+    assert_eq!(
+        extract_partial_at_utf16_marker("<?php\n$note = 'ž🐘'; renderL<caret>('x');\n"),
+        Some("renderL".into()),
+    );
+}
+
+#[test]
+fn test_extract_partial_utf16_does_not_consume_right_identifier_suffix() {
+    for marked in [
+        "<?php\n$note = 'ž🐘'; renderL<caret>abel;\n",
+        "<?php\n$note = '🐘🐘'; renderL<caret>abel('x');\n",
+    ] {
+        assert_eq!(
+            extract_partial_at_utf16_marker(marked),
+            Some("renderL".into()),
+            "{marked:?}"
+        );
+    }
+}
+
+#[test]
+fn test_extract_partial_utf16_ascii_bmp_previous_line_and_eof_controls() {
+    for marked in [
+        "<?php\n$note = 'plain'; renderL<caret>;\n",
+        "<?php\n$note = 'ž'; renderL<caret>;\n",
+        "<?php\n$note = 'ž🐘';\nrenderL<caret>;\n",
+        "<?php\n$note = 'ž🐘'; renderL<caret>",
+    ] {
+        assert_eq!(
+            extract_partial_at_utf16_marker(marked),
+            Some("renderL".into()),
+            "{marked:?}"
+        );
+    }
+}
+
+#[test]
+fn test_extract_partial_utf16_unicode_identifier_and_fqn() {
+    for (marked, expected) in [
+        ("<?php\n$note = '🐘'; Žluť<caret>;\n", "Žluť"),
+        (
+            "<?php\n$note = '🐘'; \\Demo\\Žluť<caret>;\n",
+            "\\Demo\\Žluť",
+        ),
+        (
+            "<?php\n$note = '🐘'; Demo\\Žluť<caret>oučký;\n",
+            "Demo\\Žluť",
+        ),
+    ] {
+        assert_eq!(
+            extract_partial_at_utf16_marker(marked),
+            Some(expected.into()),
+            "{marked:?}"
+        );
+    }
+}
+
+#[test]
+fn test_extract_partial_utf16_preserves_variable_member_static_and_tag_exclusions() {
+    for marked in [
+        "<?php\n$note = '🐘'; $renderL<caret>;\n",
+        "<?php\n$note = '🐘'; $child->renderL<caret>;\n",
+        "<?php\n$note = '🐘'; Demo::renderL<caret>;\n",
+        "🐘<?ph<caret>p",
+    ] {
+        assert_eq!(extract_partial_at_utf16_marker(marked), None, "{marked:?}");
+    }
+}

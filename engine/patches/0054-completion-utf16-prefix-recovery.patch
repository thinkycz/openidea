+#[cfg(test)]
+mod utf16_tests {
+    use super::*;
+
+    fn target_at(marked: &str) -> Option<CompletionTarget> {
+        let before = marked.split_once("<caret>").unwrap().0;
+        let position = Position::new(
+            before.bytes().filter(|byte| *byte == b'\n').count() as u32,
+            before.rsplit('\n').next().unwrap().encode_utf16().count() as u32,
+        );
+        extract_completion_target(&marked.replace("<caret>", ""), position)

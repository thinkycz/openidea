+#[tokio::test]
+async fn known_missing_member_rename_never_changes_unique_foreign_macro_registration() {
+    let (backend, _, caller_uri) =
+        registration_chain_identity_fixture(KNOWN_MISSING_MEMBER_CALLER).await;
+    let before = known_missing_member_open_bytes(&backend);
+    let range =
+        registration_chain_exact_token(KNOWN_MISSING_MEMBER_CALLER, "$other->shine", "shine");
+    let result = backend
+        .rename(RenameParams {
+            text_document_position: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier {
+                    uri: caller_uri.clone(),
+                },
+                position: Position::new(range.start.line, range.start.character + 1),
+            },
+            new_name: "glow".into(),
+            work_done_progress_params: WorkDoneProgressParams::default(),
+        })
+        .await;
+    // A refusal is safe; every proposed edit must stay on the queried receiver.
+    if let Ok(Some(edit)) = result {
+        known_missing_member_assert_self_only_edit(&edit, &caller_uri, range);
+    }
+    assert_eq!(
+        known_missing_member_open_bytes(&backend),
+        before,
+        "rename requests propose changes; all open source bytes remain exact"
+    );
+}

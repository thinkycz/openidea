+fn known_missing_member_assert_self_only_edit(
+    edit: &WorkspaceEdit,
+    caller_uri: &Url,
+    range: Range,
+) {
+    let mut count = 0;
+    let mut check = |uri: &Url, text_edit: &TextEdit| {
+        assert_eq!(
+            uri, caller_uri,
+            "missing member cannot rename a foreign macro registration"
+        );
+        assert_eq!(
+            text_edit.range, range,
+            "only the exact queried member token may change"
+        );
+        assert_eq!(text_edit.new_text, "glow");
+        count += 1;
+    };
+    if let Some(changes) = &edit.changes {
+        for (uri, edits) in changes {
+            for text_edit in edits {
+                check(uri, text_edit);
+            }
+        }
+    }
+    if let Some(changes) = &edit.document_changes {
+        let mut check_document = |document: &TextDocumentEdit| {
+            for text_edit in &document.edits {
+                match text_edit {
+                    OneOf::Left(text_edit) => check(&document.text_document.uri, text_edit),
+                    OneOf::Right(text_edit) => {
+                        check(&document.text_document.uri, &text_edit.text_edit)
+                    }
+                }
+            }
+        };
+        match changes {
+            DocumentChanges::Edits(edits) => {
+                for document in edits {
+                    check_document(document);
+                }
+            }
+            DocumentChanges::Operations(operations) => {
+                for operation in operations {
+                    match operation {
+                        DocumentChangeOperation::Edit(document) => check_document(document),
+                        DocumentChangeOperation::Op(operation) => panic!(
+                            "a missing method rename cannot propose a resource mutation: {operation:?}"
+                        ),
+                    }
+                }
+            }
+        }
+    }
+    assert!(
+        count <= 1,
+        "do not duplicate the exact self-call replacement"
+    );
+}

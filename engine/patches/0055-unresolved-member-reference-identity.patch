+
+const UNRESOLVED_MEMBER_IDENTITY_SOURCE: &str = concat!(
+    "<?php\n",
+    "// ž🐘: strings and unrelated receivers are not symbol identity.\n",
+    "class Alpha { public string $label = \"\"; public function save(): void {} }\n",
+    "class Beta { public string $label = \"\"; public function save(): void {} }\n",
+    "class StaticAlpha { public static function save(): void {} }\n",
+    "class StaticBeta { public static function save(): void {} }\n",
+    "function known(Alpha $alpha, Beta $beta): void {\n",
+    "    $alpha->save(); // first\n",
+    "    $alpha->save(); // second\n",
+    "    $beta->save(); echo $alpha->label; echo $beta->label;\n",
+    "}\n",
+    "function untyped($untyped): void { $untyped->save(); echo $untyped->label; }\n",
+    "function explicitMixed(mixed $mixed): void { $mixed->save(); }\n",
+    "function undefinedReceiver(): void { $missing->save(); }\n",
+    "function statics(): void {\n",
+    "    $class::save();\n",
+    "    StaticAlpha::save();\n",
+    "    StaticBeta::save();\n",
+    "    MissingClass::save();\n",
+    "}\n",
+    "$literal = '$alpha->save(); StaticAlpha::save(); save';\n",
+    "// $alpha->save(); StaticAlpha::save(); save\n",
+);
+
+fn unresolved_member_identity_position(needle: &str) -> Position {
+    let byte =
+        UNRESOLVED_MEMBER_IDENTITY_SOURCE.find(needle).unwrap() + needle.find("save").unwrap();
+    let prefix = &UNRESOLVED_MEMBER_IDENTITY_SOURCE[..byte];
+    Position::new(
+        prefix.bytes().filter(|byte| *byte == b'\n').count() as u32,
+        prefix.rsplit('\n').next().unwrap().encode_utf16().count() as u32,
+    )
+}

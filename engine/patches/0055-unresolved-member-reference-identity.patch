+fn registration_chain_exact_token(text: &str, occurrence: &str, token: &str) -> Range {
+    let start = text.find(occurrence).unwrap() + occurrence.rfind(token).unwrap();
+    let position = |offset| {
+        let before = &text[..offset];
+        Position::new(
+            before.bytes().filter(|byte| *byte == b'\n').count() as u32,
+            before.rsplit('\n').next().unwrap().encode_utf16().count() as u32,
+        )
+    };
+    Range::new(position(start), position(start + token.len()))
+}

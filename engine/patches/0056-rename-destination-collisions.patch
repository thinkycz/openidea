+#[test]
+fn inherited_private_trait_parent_own_private_override_blocks_public_trait_method() {
+    let models = inherited_private_trait_models(concat!(
+        "<?php\n",
+        "trait PublicSource {\n",
+        "    public function target(): string { return 'trait'; }\n",
+        "    public function visible(): string { return 'visible'; }\n",
+        "}\n",
+        "class Consumer {\n",
+        "    use PublicSource;\n",
+        "    private function target(): string { return 'consumer'; }\n",
+        "}\n",
+        "class Child extends Consumer {}\n",
+        "class Grandchild extends Child {}\n",
+    ));
+    let own = models.get("Consumer").unwrap();
+    let consumer = inherited_private_trait_resolved(&models, "Consumer");
+    let target = consumer
+        .methods
+        .iter()
+        .find(|method| method.name == "target")
+        .unwrap();
+    assert_eq!(target.visibility, Visibility::Private);
+    assert_eq!(
+        target.name_offset,
+        own.methods
+            .iter()
+            .find(|method| method.name == "target")
+            .unwrap()
+            .name_offset
+    );
+    for name in ["Child", "Grandchild"] {
+        let inherited = inherited_private_trait_resolved(&models, name);
+        assert!(
+            !inherited
+                .methods
+                .iter()
+                .any(|method| method.name == "target"),
+            "{name} cannot resurrect the public trait method shadowed by Consumer's own private method"
+        );
+        assert_eq!(
+            inherited
+                .methods
+                .iter()
+                .find(|method| method.name == "visible")
+                .unwrap()
+                .visibility,
+            Visibility::Public
+        );
+    }
+}
+
+fn inherited_private_trait_models(source: &str) -> HashMap<String, Arc<ClassInfo>> {
+    crate::Backend::parse_php_versioned(source, None)
+        .into_iter()
+        .map(|class| (class.fqn().to_string(), Arc::new(class)))
+        .collect()
+}
+
+fn inherited_private_trait_resolved(
+    models: &HashMap<String, Arc<ClassInfo>>,
+    name: &str,
+) -> ClassInfo {
+    let loader = |fqn: &str| models.get(fqn).cloned();
+    resolve_class_with_inheritance(models.get(name).expect("parsed class"), &loader)
+}
+
+#[test]
+fn inherited_private_trait_members_stop_at_consumer_boundary() {
+    let models = inherited_private_trait_models(concat!(
+        "<?php\n",
+        "trait MemberSource {\n",
+        "    private function hidden(): string { return ''; }\n",
+        "    protected function guarded(): string { return ''; }\n",
+        "    public function visible(): string { return ''; }\n",
+        "    private string $hiddenField = '';\n",
+        "    protected string $guardedField = '';\n",
+        "    public string $visibleField = '';\n",
+        "    private const HIDDEN_MARKER = 1;\n",
+        "    protected const GUARDED_MARKER = 2;\n",
+        "    public const VISIBLE_MARKER = 3;\n",
+        "}\n",
+        "class Consumer { use MemberSource; }\n",
+        "class Child extends Consumer {}\n",
+        "class Grandchild extends Child {}\n",
+    ));
+    let consumer = inherited_private_trait_resolved(&models, "Consumer");
+    assert_eq!(
+        consumer
+            .methods
+            .iter()
+            .find(|m| m.name == "hidden")
+            .unwrap()
+            .visibility,
+        Visibility::Private
+    );
+    assert_eq!(
+        consumer
+            .properties
+            .iter()
+            .find(|p| p.name == "hiddenField")
+            .unwrap()
+            .visibility,
+        Visibility::Private
+    );
+    assert_eq!(
+        consumer
+            .constants
+            .iter()
+            .find(|c| c.name == "HIDDEN_MARKER")
+            .unwrap()
+            .visibility,
+        Visibility::Private
+    );
+    for name in ["Child", "Grandchild"] {
+        let inherited = inherited_private_trait_resolved(&models, name);
+        assert!(
+            !inherited.methods.iter().any(|m| m.name == "hidden"),
+            "{name} cannot inherit a private trait method from Consumer"
+        );
+        assert!(
+            !inherited.properties.iter().any(|p| p.name == "hiddenField"),
+            "{name} cannot inherit a private trait property from Consumer"
+        );
+        assert!(
+            !inherited
+                .constants
+                .iter()
+                .any(|c| c.name == "HIDDEN_MARKER"),
+            "{name} cannot inherit a private trait constant from Consumer"
+        );
+        for (method, property, constant, visibility) in [
+            (
+                "guarded",
+                "guardedField",
+                "GUARDED_MARKER",
+                Visibility::Protected,
+            ),
+            (
+                "visible",
+                "visibleField",
+                "VISIBLE_MARKER",
+                Visibility::Public,
+            ),
+        ] {
+            assert_eq!(
+                inherited
+                    .methods
+                    .iter()
+                    .find(|m| m.name == method)
+                    .unwrap()
+                    .visibility,
+                visibility
+            );
+            assert_eq!(
+                inherited
+                    .properties
+                    .iter()
+                    .find(|p| p.name == property)
+                    .unwrap()
+                    .visibility,
+                visibility
+            );
+            assert_eq!(
+                inherited
+                    .constants
+                    .iter()
+                    .find(|c| c.name == constant)
+                    .unwrap()
+                    .visibility,
+                visibility
+            );
+        }
+    }
+}

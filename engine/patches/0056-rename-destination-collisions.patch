+//! Destination identity checks before emitting member rename edits.
+use std::collections::{HashMap, HashSet};
+
+use tower_lsp::lsp_types::Location;
+
+use crate::{
+    Backend,
+    inheritance::resolve_class_with_inheritance,
+    text_position::position_to_byte_offset,
+    types::{ClassLikeKind, Visibility},
+};
+
+#[derive(Clone, Copy, PartialEq, Eq, Hash)]
+enum MemberKind {
+    Method,
+    Property,
+    Constant,
+}
+
+impl Backend {
+    pub(super) fn rename_member_conflict(
+        &self,
+        locations: &[Location],
+        new_name: &str,
+    ) -> Option<String> {
+        let mut checked = HashSet::new();
+        let mut files = HashMap::new();
+        let loader = |name: &str| self.find_or_load_class(name);
+        for location in locations {
+            let uri = location.uri.as_str();
+            let Some((content, classes)) = files
+                .entry(uri)
+                .or_insert_with(|| {
+                    Some((
+                        self.reference_file_content(uri)?,
+                        self.shared_classes_for_uri(uri)?,
+                    ))
+                })
+                .as_ref()
+            else {
+                continue;
+            };
+            let offset = position_to_byte_offset(content, location.range.start) as u32;
+            for owner in classes {
+                // Only declarations identify an owner. A call written inside an
+                // unrelated class must not make that caller a rename target.
+                let declaration = if let Some(method) = owner
+                    .methods
+                    .iter()
+                    .find(|m| m.name_offset != 0 && m.name_offset == offset)
+                {
+                    Some((MemberKind::Method, method.name.as_str(), method.visibility))
+                } else if let Some(property) = owner
+                    .properties
+                    .iter()
+                    .find(|p| p.name_offset != 0 && p.name_offset == offset)
+                {
+                    Some((
+                        MemberKind::Property,
+                        property.name.as_str(),
+                        property.visibility,
+                    ))
+                } else {
+                    owner
+                        .constants
+                        .iter()
+                        .find(|c| c.name_offset != 0 && c.name_offset == offset)
+                        .map(|c| (MemberKind::Constant, c.name.as_str(), c.visibility))
+                };
+                let Some((kind, old_name, visibility)) = declaration else {
+                    continue;
+                };
+                let destination = if kind == MemberKind::Property {
+                    new_name.strip_prefix('$').unwrap_or(new_name)
+                } else {
+                    new_name
+                };
+                if kind != MemberKind::Property && new_name.starts_with('$') {
+                    return Some(format!("`{new_name}` is not a valid PHP member name"));
+                }
+                if if kind == MemberKind::Method {
+                    old_name.eq_ignore_ascii_case(destination)
+                } else {
+                    old_name == destination
+                } {
+                    continue;
+                }
+                let fqn = owner.fqn().to_string();
+                if !checked.insert((fqn.clone(), kind)) {
+                    continue;
+                }
+                let mut receivers: Vec<_> =
+                    if visibility == Visibility::Private && owner.kind != ClassLikeKind::Trait {
+                        vec![fqn]
+                    } else {
+                        self.descendants_closure([fqn]).into_iter().collect()
+                    };
+                receivers.sort();
+                for receiver in receivers {
+                    let Some(class) = loader(&receiver) else {
+                        continue;
+                    };
+                    let effective = resolve_class_with_inheritance(&class, &loader);
+                    // Private trait members stop at their consuming class; an
+                    // indexed descendant that does not inherit the old member
+                    // cannot capture this rename.
+                    let carries_source = match kind {
+                        MemberKind::Method => effective.has_method(old_name),
+                        MemberKind::Property => effective.has_property(old_name),
+                        MemberKind::Constant => effective.get_constant(old_name).is_some(),
+                    };
+                    if !carries_source {
+                        continue;
+                    }
+                    let exists = match kind {
+                        MemberKind::Method => effective.has_method(destination),
+                        MemberKind::Property => effective.has_property(destination),
+                        MemberKind::Constant => effective.get_constant(destination).is_some(),
+                    };
+                    if exists {
+                        return Some(format!(
+                            "Cannot rename to `{destination}`: class `{receiver}` already has a member with that name."
+                        ));
+                    }
+                }
+            }
+        }
+        None
+    }
+}

+#[test]
+fn inherited_private_trait_filter_preserves_child_own_private_members() {
+    let models = inherited_private_trait_models(concat!(
+        "<?php\n",
+        "trait PrivateSource {\n",
+        "    private function localName(): string { return ''; }\n",
+        "    private string $localField = '';\n",
+        "    private const LOCAL_MARKER = 1;\n",
+        "}\n",
+        "class Consumer { use PrivateSource; }\n",
+        "class Child extends Consumer {\n",
+        "    private function localName(): int { return 2; }\n",
+        "    private int $localField = 2;\n",
+        "    private const LOCAL_MARKER = 2;\n",
+        "}\n",
+    ));
+    let own = models.get("Child").unwrap();
+    let resolved = inherited_private_trait_resolved(&models, "Child");
+    let method = resolved
+        .methods
+        .iter()
+        .find(|m| m.name == "localName")
+        .unwrap();
+    assert_eq!(method.visibility, Visibility::Private);
+    assert_eq!(
+        method.name_offset,
+        own.methods
+            .iter()
+            .find(|m| m.name == "localName")
+            .unwrap()
+            .name_offset
+    );
+    assert_eq!(method.return_type.as_ref().unwrap().to_string(), "int");
+    assert_eq!(
+        resolved
+            .methods
+            .iter()
+            .filter(|m| m.name == "localName")
+            .count(),
+        1
+    );
+    let property = resolved
+        .properties
+        .iter()
+        .find(|p| p.name == "localField")
+        .unwrap();
+    assert_eq!(property.visibility, Visibility::Private);
+    assert_eq!(
+        property.name_offset,
+        own.properties
+            .iter()
+            .find(|p| p.name == "localField")

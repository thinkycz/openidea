+    assert!(
+        current.has_method("fromAUnsaved"),
+        "fresh scope must not reuse the old nested computation"
+    );
+    assert!(!current.has_method("fromA"));
+    if switch_cache {
+        let _other = with_active_resolved_class_cache(&other_cache);
+        let current = resolve_class_base_cached(&updated, &missing_loader);
+        assert!(current.has_method("fromAUnsaved"));
+        assert!(!current.has_method("fromA"));
+    }
+}
+
+#[test]
+fn evict_fqn_during_inflight_generic_resolution_cannot_republish_old_members() {
+    assert_invalidation_fences_inflight_resolution(false, true);
+}
+
+fn assert_invalidation_fences_inflight_resolution(clear: bool, generic: bool) {
+    use std::sync::{
+        RwLock,
+        atomic::{AtomicBool, Ordering},
+        mpsc,
+    };
+    use std::time::Duration;
+
+    let mut original = make_class("Service");
+    original.parent_class = Some(atom("Parent"));
+    if generic {
+        original.template_params.push(atom("T"));
+    }
+    original
+        .methods
+        .push(Arc::new(make_method("fromA", Some("void"))));
+    let original = Arc::new(original);
+    let mut updated = (*original).clone();
+    updated.methods = vec![Arc::new(make_method("fromAUnsaved", Some("void")))].into();
+    updated.rebuild_method_index();
+    let updated = Arc::new(updated);
+    let current = Arc::new(RwLock::new(Arc::clone(&original)));
+    let parent = Arc::new(make_class("Parent"));
+    let cache = new_resolved_class_cache();
+    let (entered_tx, entered_rx) = mpsc::channel();
+    let (release_tx, release_rx) = mpsc::channel();
+    let worker_cache = Arc::clone(&cache);
+    let worker_current = Arc::clone(&current);
+    let worker_parent = Arc::clone(&parent);
+    let worker = std::thread::spawn(move || {
+        let paused = AtomicBool::new(false);
+        let loader = |name: &str| match name {
+            "Service" => Some(Arc::clone(&worker_current.read().unwrap())),
+            "Parent" => {
+                // This lookup occurs after the resolver has captured Service's
+                // raw declaration and claimed the missing cache entry.
+                if !paused.swap(true, Ordering::SeqCst) {
+                    entered_tx.send(()).unwrap();
+                    release_rx.recv_timeout(Duration::from_secs(10)).unwrap();
+                }
+                Some(Arc::clone(&worker_parent))
+            }
+            _ => None,
+        };
+        if generic {
+            resolve_class_fully_with_generics(
+                &original,
+                &loader,
+                Some(&worker_cache),
+                &["string".to_owned()],
+                &[PhpType::parse("string")],
+            )
+        } else {
+            resolve_class_fully_cached(&original, &loader, &worker_cache)
+        }
+    });
+
+    let entered = entered_rx.recv_timeout(Duration::from_secs(10));
+    if entered.is_ok() {
+        *current.write().unwrap() = Arc::clone(&updated);
+        // The actual production edit invalidation API must fence results
+        // already being computed, even when no completed entry exists yet.
+        if clear {
+            cache.write().clear();
+        } else {
+            evict_fqn(&mut cache.write(), "Service");
+        }
+    }
+    let _ = release_tx.send(());
+    let _old_inflight_result = worker.join().expect("resolver worker must finish");
+    entered.expect("old resolution must reach the controlled parent lookup");
+
+    let loader = |name: &str| match name {
+        "Service" => Some(Arc::clone(&current.read().unwrap())),
+        "Parent" => Some(Arc::clone(&parent)),
+        _ => None,
+    };
+    let fresh = if generic {
+        resolve_class_fully_with_generics(
+            &updated,
+            &loader,
+            Some(&cache),
+            &["string".to_owned()],
+            &[PhpType::parse("string")],
+        )
+    } else {
+        resolve_class_fully_cached(&updated, &loader, &cache)
+    };
+    assert!(
+        fresh.has_method("fromAUnsaved"),
+        "fresh request must resolve the current declaration"
+    );
+    assert!(
+        !fresh.has_method("fromA"),
+        "an invalidated in-flight result must not poison the current cache"
+    );
+}

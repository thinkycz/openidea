+#[test]
+fn inherited_private_trait_aliases_use_effective_consumer_visibility() {
+    let models = inherited_private_trait_models(concat!(
+        "<?php\n",
+        "trait AliasSource {\n",
+        "    private function hiddenPublic(): string { return ''; }\n",
+        "    private function hiddenProtected(): string { return ''; }\n",
+        "    public function publicBeforeAlias(): string { return ''; }\n",
+        "}\n",
+        "class AliasConsumer {\n",
+        "    use AliasSource {\n",
+        "        hiddenPublic as public exposed;\n",
+        "        hiddenProtected as protected guarded;\n",
+        "        publicBeforeAlias as private;\n",
+        "    }\n",
+        "}\n",
+        "class AliasChild extends AliasConsumer {}\n",
+    ));
+    let consumer = inherited_private_trait_resolved(&models, "AliasConsumer");
+    for (name, visibility) in [
+        ("hiddenPublic", Visibility::Private),
+        ("hiddenProtected", Visibility::Private),
+        ("exposed", Visibility::Public),
+        ("guarded", Visibility::Protected),
+        ("publicBeforeAlias", Visibility::Private),
+    ] {
+        assert_eq!(
+            consumer
+                .methods
+                .iter()
+                .find(|m| m.name == name)
+                .unwrap()
+                .visibility,
+            visibility
+        );
+    }
+    let child = inherited_private_trait_resolved(&models, "AliasChild");
+    for name in ["hiddenPublic", "hiddenProtected", "publicBeforeAlias"] {
+        assert!(
+            !child.methods.iter().any(|m| m.name == name),
+            "private effective method {name} must not leak into child"
+        );
+    }
+    assert_eq!(
+        child
+            .methods
+            .iter()
+            .find(|m| m.name == "exposed")
+            .unwrap()
+            .visibility,
+        Visibility::Public
+    );
+    assert_eq!(
+        child
+            .methods
+            .iter()
+            .find(|m| m.name == "guarded")
+            .unwrap()
+            .visibility,
+        Visibility::Protected
+    );
+}

+/// Shared readiness state. Keeping source and publication epochs separate means
+/// an invalidation arriving during a build can never be cleared by that build.
+pub(crate) struct LaravelPivotState {
+    /// Latest accepted source invalidation.
+    pub(crate) source: std::sync::atomic::AtomicU64,
+    /// Source generation represented by the completed map.
+    pub(crate) published: std::sync::atomic::AtomicU64,
+    /// Serializes completed-map publication without holding a loader lock.
+    pub(crate) build: parking_lot::Mutex<()>,
+    /// Test witness for a completed build reaching publication.
+    #[cfg(test)]
+    pub(crate) waiting: parking_lot::Mutex<Option<std::sync::mpsc::Sender<()>>>,
+}
+
+impl Default for LaravelPivotState {
+    fn default() -> Self {
+        Self {
+            source: std::sync::atomic::AtomicU64::new(1),
+            published: std::sync::atomic::AtomicU64::new(0),
+            build: parking_lot::Mutex::new(()),
+            #[cfg(test)]
+            waiting: parking_lot::Mutex::new(None),
+        }
+    }
+}
+
+thread_local! {
+    static BUILDING_PIVOTS: std::cell::RefCell<Vec<usize>> = const { std::cell::RefCell::new(Vec::new()) };
+}
+
+/// Marks only this thread as a recursive pivot builder until dropped.
+pub(crate) struct PivotBuildMarker(usize);
+
+impl LaravelPivotState {
+    /// Whether accepted source changes still need a completed index.
+    pub(crate) fn is_dirty(&self) -> bool {
+        use std::sync::atomic::Ordering;
+        self.source.load(Ordering::Acquire) != self.published.load(Ordering::Acquire)
+    }
+
+    /// Whether this thread is already constructing this particular index.
+    pub(crate) fn is_building(&self) -> bool {
+        let identity = self as *const Self as usize;
+        BUILDING_PIVOTS.with(|slots| slots.borrow().contains(&identity))
+    }
+
+    /// Permit recursive lookups to use the previous map on this thread only.
+    pub(crate) fn enter(&self) -> PivotBuildMarker {
+        let identity = self as *const Self as usize;
+        BUILDING_PIVOTS.with(|slots| slots.borrow_mut().push(identity));
+        PivotBuildMarker(identity)
+    }
+}
+
+impl Drop for PivotBuildMarker {
+    fn drop(&mut self) {
+        BUILDING_PIVOTS.with(|slots| {
+            let mut slots = slots.borrow_mut();
+            let position = slots
+                .iter()
+                .rposition(|slot| *slot == self.0)
+                .expect("active pivot build");
+            slots.remove(position);
+        });
+    }
+}

+
+fn private_trait_capture_range(source: &str, occurrence: &str) -> Range {
+    private_identity_token_range(source, occurrence, "source")
+}
+
+fn private_identity_token_range(source: &str, occurrence: &str, token: &str) -> Range {
+    let start = source.find(occurrence).unwrap() + occurrence.rfind(token).unwrap();
+    let position = |offset| {
+        let before = &source[..offset];
+        Position::new(
+            before.bytes().filter(|byte| *byte == b'\n').count() as u32,
+            before.rsplit('\n').next().unwrap().encode_utf16().count() as u32,
+        )
+    };
+    Range::new(position(start), position(start + token.len()))
+}

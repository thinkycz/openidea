+#[tokio::test]
+async fn rename_collision_private_trait_capture_child_reference_lens_excludes_parent_private_calls()
+{
+    for nested in [false, true] {
+        let source = private_trait_capture_source(nested, true).replacen(
+            "<?php\n",
+            "<?php\nnamespace App;\n",
+            1,
+        );
+        let (backend, directory) = create_psr4_workspace(
+            r#"{"autoload":{"psr-4":{"App\\":"src/"}}}"#,
+            &[("src/ConsumerChild.php", &source)],
+        );
+        let uri = Url::from_file_path(directory.path().join("src/ConsumerChild.php")).unwrap();
+        open_php(&backend, &uri, &source).await;
+        let declaration = private_trait_capture_range(&source, "public function source");
+        let expected = vec![
+            Location::new(
+                uri.clone(),
+                private_trait_capture_range(&source, "function childScope(): void { $this->source"),
+            ),
+            Location::new(
+                uri.clone(),
+                private_trait_capture_range(
+                    &source,
+                    "function demo(ConsumerChild $child): void { $child->source",
+                ),
+            ),
+        ];
+        let references =
+            crate::common::find_references(&backend, &uri, declaration.start, false).await;
+        assert_eq!(
+            references, expected,
+            "the lens must agree with exact references"
+        );
+        let lenses = backend
+            .code_lens(CodeLensParams {
+                text_document: TextDocumentIdentifier { uri: uri.clone() },
+                work_done_progress_params: WorkDoneProgressParams::default(),
+                partial_result_params: PartialResultParams::default(),
+            })
+            .await
+            .unwrap()
+            .expect("expected public declaration reference lenses");
+        let lens = lenses
+            .iter()
+            .find(|lens| {
+                lens.range.start.line == declaration.start.line
+                    && (lens
+                        .data
+                        .as_ref()
+                        .is_some_and(|data| data["kind"] == "phpMemberReferences")
+                        || lens
+                            .command
+                            .as_ref()
+                            .is_some_and(|command| command.title.ends_with("references")))
+            })
+            .unwrap_or_else(|| panic!("expected a public child reference lens, got {lenses:#?}"))
+            .clone();
+        let resolved = backend.code_lens_resolve(lens).await.unwrap();
+        let command = resolved
+            .command
+            .expect("resolved reference lens has a command");
+        assert_eq!(command.title, "2 references");
+        let locations: Vec<Location> = serde_json::from_value(
+            command
+                .arguments
+                .unwrap()
+                .get(2)
+                .cloned()
+                .expect("reference locations"),
+        )
+        .unwrap();
+        assert_eq!(
+            locations, expected,
+            "private parent lexical calls do not inflate the child badge"
+        );
+    }
+}

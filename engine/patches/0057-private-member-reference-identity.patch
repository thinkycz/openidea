+const PRIVATE_IDENTITY_STATIC_SOURCE: &str = concat!(
+    "<?php\n",
+    "class ParentScope {\n",
+    "    private static function source(): void {}\n",
+    "    private static string $source = 'parent';\n",
+    "    private const TOKEN = 'parent';\n",
+    "    public function read(ChildScope $child): void {\n",
+    "        $note = 'ž🐘'; $child->source();\n",
+    "        ChildScope::source();\n",
+    "        $child::source();\n",
+    "        echo self::$source;\n",
+    "        echo ChildScope::$source;\n",
+    "        echo $child::$source;\n",
+    "        echo self::TOKEN;\n",
+    "        echo ChildScope::TOKEN;\n",
+    "        echo $child::TOKEN;\n",
+    "    }\n",
+    "}\n",
+    "class ChildScope extends ParentScope {\n",
+    "    public static function source(): void {}\n",
+    "    public static string $source = 'child';\n",
+    "    public const TOKEN = 'child';\n",
+    "}\n",
+);
+
+async fn private_identity_assert_static_kind(
+    token: &str,
+    parent_declaration: &str,
+    child_declaration: &str,
+    parent_call: &str,
+    child_calls: &[&str],
+) {
+    let source = PRIVATE_IDENTITY_STATIC_SOURCE;
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///private-static-binding.php").unwrap();
+    open_php(&backend, &uri, source).await;
+    let location = |needle| {
+        Location::new(
+            uri.clone(),
+            private_identity_token_range(source, needle, token),
+        )
+    };
+    let parent_declaration = location(parent_declaration);
+    let child_declaration = location(child_declaration);
+    let parent_call = location(parent_call);
+    let child_calls: Vec<_> = child_calls.iter().map(|needle| location(needle)).collect();
+    private_identity_assert_exact_references(
+        &backend,
+        &[parent_declaration.clone(), parent_call.clone()],
+        &[parent_declaration],
+        &[parent_call],
+    )
+    .await;
+    let queries: Vec<_> = std::iter::once(child_declaration.clone())
+        .chain(child_calls.iter().cloned())
+        .collect();
+    private_identity_assert_exact_references(
+        &backend,
+        &queries,
+        &[child_declaration],
+        &child_calls,
+    )
+    .await;
+}

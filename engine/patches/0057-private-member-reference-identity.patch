+            let mut expected = vec![Location::new(uri.clone(), call)];
+            if let Some(parent_call) = parent_call {
+                expected.push(Location::new(uri.clone(), parent_call));
+            }
+            if include_declaration {
+                expected.push(Location::new(uri.clone(), declaration));
+            }
+            let key = |location: &Location| {

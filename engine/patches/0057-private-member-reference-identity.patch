+    ]
+    .iter()
+    .map(|needle| Location::new(uri.clone(), private_trait_capture_range(source, needle)))
+    .collect();
+    let origin_queries = [declarations[0].clone(), calls[0].clone(), calls[1].clone()];
+    private_identity_assert_exact_references(&backend, &origin_queries, &declarations, &calls)
+        .await;
+    let child_queries = [declarations[1].clone(), calls[2].clone(), calls[3].clone()];
+    private_identity_assert_exact_references(
+        &backend,
+        &child_queries,
+        &declarations[1..],
+        &calls[2..],
+    )
+    .await;
+    let edit = rename_result(
+        &backend,
+        &uri,
+        declarations[0].range.start.line,
+        declarations[0].range.start.character + 1,
+        "promoted",
+    )
+    .await
+    .expect("effective public visibility retains the override family")
+    .expect("promoted trait method needs edits");
+    let edits = edits_for_uri(&edit, &uri);
+    assert_eq!(edits.len(), declarations.len() + calls.len());
+    assert_eq!(
+        apply_edits(source, &edits),
+        source.replace("source", "promoted")
+    );
+    for query in child_queries {
+        let edit = rename_result(
+            &backend,
+            &uri,
+            query.range.start.line,
+            query.range.start.character + 1,
+            "childBranch",
+        )
+        .await
+        .expect("the child override can be renamed independently of its ancestors")
+        .expect("the child declaration and its descendant calls need edits");
+        let edits = edits_for_uri(&edit, &uri);
+        assert_eq!(edits.len(), 3);
+        let expected = source
+            .replace("public function source(", "public function childBranch(")
+            .replace(
+                "function childScope(): void { $this->source()",
+                "function childScope(): void { $this->childBranch()",
+            )
+            .replace("$child->source()", "$child->childBranch()");
+        assert_eq!(
+            apply_edits(source, &edits),
+            expected,
+            "a child query preserves the promoted ancestor declaration, adaptation and parent call"
+        );
+    }
+}

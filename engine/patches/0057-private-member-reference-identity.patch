+
+fn private_trait_capture_source(nested: bool, parent_receiver: bool) -> String {
+    let composition = if nested {
+        "trait OuterSource { use PrivateSource; }\nclass Consumer { use OuterSource;\n"
+    } else {
+        "class Consumer { use PrivateSource;\n"
+    };
+    let parent_call = if parent_receiver {
+        "    public function read(ConsumerChild $child): void { $note = 'ž🐘'; $child->source(); }\n"
+    } else {
+        ""
+    };
+    format!(
+        concat!(
+            "<?php\n",
+            "trait PrivateSource {{ private function source(): void {{}} }}\n",
+            "{}",
+            "    public function invoke(): void {{ $note = 'ž🐘'; $this->source(); }}\n",
+            "{}",
+            "}}\n",
+            "class ConsumerChild extends Consumer {{\n",
+            "    public function source(): void {{}}\n",
+            "    public function target(): void {{}}\n",
+            "    public function childScope(): void {{ $this->source(); }}\n",
+            "}}\n",
+            "function demo(ConsumerChild $child): void {{ $child->source(); $child->target(); }}\n",
+        ),
+        composition, parent_call,
+    )

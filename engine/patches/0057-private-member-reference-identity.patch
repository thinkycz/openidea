@@ -0,0 +1,341 @@
+//! Exact declaration identity at PHP private-member boundaries.
+//!
+//! Hierarchy membership alone cannot distinguish a parent's private method
+//! from a child's independent namesake. Lexical parent scope may nevertheless
+//! access its own private member through a child-typed receiver.
+use super::*;
+use crate::class_lookup::{find_class_at_offset, is_subtype_of};
+use crate::inheritance::{ancestors, find_declaring_member_ancestor};
+use crate::symbol_map::{SymbolKind, SymbolSpan};
+use crate::types::{ClassInfo, FileContext, Visibility};
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+/// PHP namespaces that distinguish same-spelled class members.
+pub(crate) enum ReferenceMemberKind {
+    /// Case-insensitive method names.
+    Method,
+    /// Case-sensitive instance or static properties.
+    Property,
+    /// Case-sensitive class constants.
+    Constant,
+}
+
+/// A concrete declaration, with the effective access visibility at its receiver.
+#[derive(Clone)]
+pub(crate) struct MemberBinding {
+    /// Raw class or trait containing the source declaration.
+    pub(crate) declaration: Arc<ClassInfo>,
+    /// Original token offset within that declaration's file.
+    pub(crate) offset: u32,
+    /// The PHP member namespace selected by the access syntax.
+    pub(crate) kind: ReferenceMemberKind,
+    /// Whether this receiver's effective member is private.
+    pub(crate) private: bool,
+    /// A trait-private source imported with public visibility needs its own query.
+    pub(super) expand: bool,
+    name: crate::atom::Atom,
+    receiver: Arc<ClassInfo>,
+}
+
+impl MemberBinding {
+    /// Compare exact source identity rather than hierarchy or spelling.
+    pub(crate) fn same_declaration(&self, other: &Self) -> bool {
+        self.kind == other.kind
+            && self.offset == other.offset
+            && self
+                .declaration
+                .fqn()
+                .eq_ignore_ascii_case(&other.declaration.fqn())
+    }
+}
+
+fn member_info(
+    class: &ClassInfo,
+    name: &str,
+    kind: ReferenceMemberKind,
+) -> Option<(Visibility, u32)> {
+    match kind {
+        ReferenceMemberKind::Method => class
+            .get_method(name)
+            .map(|m| (m.visibility, m.name_offset)),
+        ReferenceMemberKind::Property => class
+            .properties
+            .iter()
+            .find(|p| p.name.trim_start_matches('$') == name.trim_start_matches('$'))
+            .map(|p| (p.visibility, p.name_offset)),
+        ReferenceMemberKind::Constant => class
+            .constants
+            .iter()
+            .find(|c| c.name == name)
+            .map(|c| (c.visibility, c.name_offset)),
+    }
+}
+
+impl Backend {
+    /// Resolve the concrete source behind a class's effective member. The
+    /// canonical inherited surface determines visibility; the shared ancestry
+    /// walk recovers the declaration that owns its source token.
+    pub(crate) fn reference_member_binding(
+        &self,
+        class: &Arc<ClassInfo>,
+        name: &str,
+        kind: ReferenceMemberKind,
+    ) -> Option<MemberBinding> {
+        let loader = |name: &str| self.find_or_load_class(name);
+        let effective = crate::virtual_members::resolve_class_fully_cached(
+            class,
+            &loader,
+            &self.resolved_class_cache,
+        );
+        let (visibility, effective_offset) = member_info(&effective, name, kind)?;
+        let declares = |candidate: &ClassInfo| {
+            member_info(candidate, name, kind).is_some_and(|(_, offset)| offset == effective_offset)
+        };
+        let declaring = if member_info(class, name, kind).is_some() {
+            Arc::clone(class)
+        } else {
+            find_declaring_member_ancestor(
+                class,
+                (kind == ReferenceMemberKind::Method).then_some(name),
+                &loader,
+                &declares,
+            )?
+            .1
+        };
+        let (source_visibility, offset) = member_info(&declaring, name, kind)?;
+        (offset != 0).then(|| MemberBinding {
+            declaration: declaring,
+            offset,
+            kind,
+            private: visibility == Visibility::Private,
+            expand: source_visibility == Visibility::Private && visibility != Visibility::Private,
+            name: crate::atom::atom(name),
+            receiver: Arc::clone(class),
+        })
+    }
+
+    /// A private source can become a public override family through a trait
+    /// visibility adaptation. Such descendants participate only across public
+    /// ancestry; a private parent declaration still breaks that family.
+    pub(crate) fn reference_binding_matches(
+        &self,
+        target: &MemberBinding,
+        candidate: &MemberBinding,
+    ) -> bool {
+        if target.same_declaration(candidate) {
+            return true;
+        }
+        if candidate.private {
+            return false;
+        }
+        let loader = |name: &str| self.find_or_load_class(name);
+        for (_, parent) in ancestors(&candidate.receiver, &loader) {
+            if let Some(binding) =
+                self.reference_member_binding(&parent, &candidate.name, candidate.kind)
+            {
+                if binding.private {
+                    return false;
+                }
+                if target.same_declaration(&binding) {
+                    return true;
+                }
+            }
+        }
+        false
+    }
+
+    fn reference_binding_file(&self, uri: &str, name: &str) -> Option<BindingFile> {
+        let file = CandidateFile::new(self, uri);
+        let content = self.reference_file_content_arc(uri)?;
+        let map = self.symbol_maps.read().get(uri).cloned()?;
+        let receivers = self.member_receivers_for(&file, &map, &[crate::atom::atom(name)]);
+        Some(BindingFile {
+            content,
+            map,
+            receivers,
+            context: self.file_context(uri),
+        })
+    }
+
+    fn reference_bindings_at(&self, file: &BindingFile, span: &SymbolSpan) -> Vec<MemberBinding> {
+        match &span.kind {
+            SymbolKind::MemberDeclaration { name, .. } | SymbolKind::Variable { name } => {
+                let Some(class) = binding_lexical_class(file, span.start) else {
+                    return Vec::new();
+                };
+                for kind in [
+                    ReferenceMemberKind::Method,
+                    ReferenceMemberKind::Property,
+                    ReferenceMemberKind::Constant,
+                ] {
+                    if let Some((visibility, offset)) = member_info(&class, name, kind)
+                        && offset == span.start
+                    {
+                        return vec![MemberBinding {
+                            declaration: Arc::clone(&class),
+                            offset,
+                            kind,
+                            private: visibility == Visibility::Private,
+                            expand: false,
+                            name: *name,
+                            receiver: Arc::clone(&class),
+                        }];
+                    }
+                }
+                Vec::new()
+            }
+            SymbolKind::MemberAccess {
+                member_name,
+                is_static,
+                is_method_call,
+                ..
+            } => {
+                let targets = file
+                    .map
+                    .member_access_indices(member_name)
+                    .iter()
+                    .find(|&&i| file.map.spans[i].start == span.start)
+                    .and_then(|&i| file.receivers.as_ref()?.resolved_access(i))
+                    .map(|(_, targets)| targets)
+                    .unwrap_or_default();
+                let lexical = binding_lexical_class(file, span.start);
+                let loader = |name: &str| self.find_or_load_class(name);
+                targets
+                    .iter()
+                    .filter_map(|fqn| {
+                        let receiver = loader(fqn)?;
+                        let kind = if *is_method_call {
+                            ReferenceMemberKind::Method
+                        } else if *is_static
+                            && !member_name.starts_with('$')
+                            && crate::virtual_members::resolve_class_fully_cached(
+                                &receiver,
+                                &loader,
+                                &self.resolved_class_cache,
+                            )
+                            .get_constant(member_name)
+                            .is_some()
+                        {
+                            ReferenceMemberKind::Constant
+                        } else {
+                            ReferenceMemberKind::Property
+                        };
+                        // PHP binds a parent's private access to lexical scope,
+                        // even when the receiver's class declares a public namesake.
+                        if !*is_static
+                            && let Some(lexical) = lexical.as_ref()
+                            && (receiver.fqn().eq_ignore_ascii_case(&lexical.fqn())
+                                || is_subtype_of(&receiver, lexical.fqn().as_str(), &loader))
+                            && let Some(binding) =
+                                self.reference_member_binding(lexical, member_name, kind)
+                            && binding.private
+                        {
+                            return Some(binding);
+                        }
+                        self.reference_member_binding(&receiver, member_name, kind)
+                    })
+                    .collect()
+            }
+            _ => Vec::new(),
+        }
+    }
+
+    /// Attribute results by source identity wherever a private declaration
+    /// breaks the ordinary public override family. Return extra source queries
+    /// for lexical private bindings that the receiver-only search could miss.
+    pub(super) fn private_reference_queries(
+        &self,
+        uri: &str,
+        span: &SymbolSpan,
+    ) -> Vec<MemberBinding> {
+        let Some(name) = member_name(span) else {
+            return Vec::new();
+        };
+        // Constructor queries use instantiation spans, not member accesses.
+        if name.eq_ignore_ascii_case("__construct") {
+            return Vec::new();
+        }
+        if matches!(span.kind, SymbolKind::Variable { .. }) {
+            let context = self.file_context(uri);
+            if !find_class_at_offset(&context.classes, span.start)
+                .is_some_and(|class| class.properties.iter().any(|p| p.name_offset == span.start))
+            {
+                return Vec::new();
+            }
+        }
+        self.reference_binding_file(uri, name)
+            .map(|file| self.reference_bindings_at(&file, span))
+            .unwrap_or_default()
+    }
+
+    /// Keep inherited public families while separating concrete private
+    /// declarations and the independent namesakes below them.
+    pub(super) fn filter_private_reference_locations(
+        &self,
+        selected: &[MemberBinding],
+        locations: &mut Vec<Location>,
+    ) {
+        if selected.is_empty() {
+            return;
+        }
+        let only_private = selected.iter().all(|b| b.private);
+        let mut files = std::collections::HashMap::new();
+        locations.retain(|location| {
+            let uri = location.uri.as_str();
+            let file = files
+                .entry(uri.to_owned())
+                .or_insert_with(|| self.reference_binding_file(uri, &selected[0].name));
+            let Some(file) = file else {
+                return !only_private;
+            };
+            let offset =
+                crate::text_position::position_to_offset(&file.content, location.range.start);
+            let Some(span) = file.map.lookup(offset) else {
+                return !only_private;
+            };
+            let candidates = self.reference_bindings_at(file, span);
+            if only_private {
+                return candidates.iter().any(|candidate| {
+                    selected
+                        .iter()
+                        .any(|target| self.reference_binding_matches(target, candidate))
+                });
+            }
+            // Public override families retain their existing hierarchy rules.
+            // A positively identified private binding belongs only to its own
+            // declaration, rather than to a same-named descendant declaration.
+            candidates.is_empty()
+                || candidates.iter().any(|candidate| {
+                    selected.iter().any(|target| target.kind == candidate.kind)
+                        && (!candidate.private
+                            || selected
+                                .iter()
+                                .any(|target| self.reference_binding_matches(target, candidate)))
+                })
+        });
+    }
+}
+
+struct BindingFile {
+    content: Arc<String>,
+    map: Arc<SymbolMap>,
+    receivers: Option<Arc<crate::reference_index::ResolvedMemberFile>>,
+    context: FileContext,
+}
+
+fn binding_lexical_class(file: &BindingFile, offset: u32) -> Option<Arc<ClassInfo>> {
+    let class = find_class_at_offset(&file.context.classes, offset)?;
+    file.context
+        .classes
+        .iter()
+        .find(|candidate| std::ptr::eq(candidate.as_ref(), class))
+        .cloned()
+}
+
+fn member_name(span: &SymbolSpan) -> Option<&str> {
+    match &span.kind {
+        SymbolKind::MemberDeclaration { name, .. } | SymbolKind::Variable { name } => Some(name),
+        SymbolKind::MemberAccess { member_name, .. } => Some(member_name),
+        _ => None,
+    }
+}

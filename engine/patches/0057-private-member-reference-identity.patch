+fn nested_trait_outer_precedence_preserves_other_members_and_named_alias() {
+    let models = inherited_private_trait_models(concat!(
+        "<?php\n",
+        "trait NestedB { private function source(): string { return 'B'; } }\n",
+        "trait Wrapper {\n",
+        "    use NestedB { source as public retained; }\n",
+        "    public function other(): string { return 'other'; }\n",
+        "    public string $extra = 'extra';\n",
+        "    public const EXTRA = 'extra';\n",
+        "}\n",
+        "trait SelectedA { private function source(): string { return 'A'; } }\n",
+        "class Consumer { use Wrapper, SelectedA { SelectedA::source insteadof Wrapper; } }\n",
+    ));
+    let consumer = inherited_private_trait_resolved(&models, "Consumer");
+    let a = models
+        .get("SelectedA")
+        .unwrap()
+        .get_method("source")
+        .unwrap();
+    let b = models.get("NestedB").unwrap().get_method("source").unwrap();
+    let selected = consumer
+        .get_method("source")
+        .expect("selected method survives");
+    assert_eq!(
+        selected.name_offset, a.name_offset,
+        "outer precedence excludes nested B"
+    );
+    assert_ne!(selected.name_offset, b.name_offset);
+    let alias = consumer
+        .get_method("retained")
+        .expect("a distinct named alias survives");
+    assert_eq!(alias.visibility, Visibility::Public);
+    assert_eq!(alias.name_offset, b.name_offset);
+    assert!(consumer.has_method("other"));
+    assert!(consumer.has_property("extra"));
+    assert!(consumer.get_constant("EXTRA").is_some());
+}

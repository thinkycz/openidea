+
+/// Exercise the real reference discovery and class rewrite pipeline, preserving
+/// exact unrelated caller text while applying the returned edit once.
+async fn renamed_alias_policy_caller(caller: &str, new_name: &str) -> String {
+    let dir = tempfile::tempdir().expect("alias policy workspace");
+    let backend = Backend::new_test_with_workspace(dir.path().to_path_buf(), Vec::new());
+    let source_uri = Url::from_file_path(dir.path().join("User.php")).unwrap();
+    let caller_uri = Url::from_file_path(dir.path().join("caller.php")).unwrap();
+    let source = "<?php\nnamespace App;\nclass User {}\n";
+    std::fs::write(dir.path().join("User.php"), source).unwrap();
+    std::fs::write(dir.path().join("caller.php"), caller).unwrap();
+    open_file(&backend, &source_uri, source).await;
+    open_file(&backend, &caller_uri, caller).await;
+    let (line, character) = line_char_of(source, "User {}");
+    let edit = rename(&backend, &source_uri, line, character, new_name)
+        .await
+        .expect("class rename proposal");
+    let edits = edits_for_uri(&edit, &caller_uri);
+    assert!(!edits.is_empty(), "caller must participate in class rename");
+    apply_edits(caller, &edits)
+}
+
+#[tokio::test]
+async fn rename_class_alias_policy_keeps_explicit_alias_despite_new_short_import() {
+    let caller = "<?php\nnamespace Client;\nuse App\\User as Actor;\nuse Other\\Person;\nfunction make(): Actor { return new Actor(); }\n";
+    let actual = renamed_alias_policy_caller(caller, "Person").await;
+    assert_eq!(actual, caller.replace("App\\User", "App\\Person"));
+}
+
+#[tokio::test]
+async fn rename_class_alias_policy_move_preserves_group_alias_despite_collision() {
+    let caller = "<?php\nnamespace Client;\nuse App\\{User as Actor, Other};\nuse Other\\Person;\nfunction make(): Actor { return new Actor(); }\n";
+    let actual = renamed_alias_policy_caller(caller, "Domain\\Person").await;
+    assert!(actual.contains("use Domain\\Person as Actor;"), "{actual}");
+    assert!(actual.contains("use Other\\Person;"), "{actual}");
+    assert!(
+        actual.contains("function make(): Actor { return new Actor(); }"),
+        "{actual}"
+    );
+    assert!(!actual.contains("PersonAlias"), "{actual}");
+    assert!(!actual.contains("User as Actor"), "{actual}");
+}
+
+#[tokio::test]
+async fn rename_class_alias_policy_avoids_local_class_and_trait_alias_names() {
+    let caller = "<?php\nnamespace Client;\nuse App\\User;\nclass Person {}\ntrait PersonAlias {}\nfunction make(): User { return new User(); }\n";
+    let actual = renamed_alias_policy_caller(caller, "Person").await;
+    let expected = caller
+        .replace("use App\\User;", "use App\\Person as PersonAlias2;")
+        .replace(
+            "make(): User { return new User(); }",
+            "make(): PersonAlias2 { return new PersonAlias2(); }",
+        );
+    assert_eq!(actual, expected);
+}
+
+#[tokio::test]
+async fn rename_class_alias_policy_local_collision_is_case_insensitive() {
+    let caller = "<?php\nnamespace Client;\nuse App\\User;\nclass pErSoN {}\ninterface PERSONALIAS {}\nfunction make(): User { return new User(); }\n";
+    let actual = renamed_alias_policy_caller(caller, "Person").await;
+    let expected = caller
+        .replace("use App\\User;", "use App\\Person as PersonAlias2;")
+        .replace(
+            "make(): User { return new User(); }",
+            "make(): PersonAlias2 { return new PersonAlias2(); }",
+        );
+    assert_eq!(actual, expected);
+}
+
+#[tokio::test]
+async fn rename_class_alias_policy_other_namespace_declaration_does_not_collide() {
+    let caller = "<?php\nnamespace Client {\nuse App\\User;\nfunction make(): User { return new User(); }\n}\nnamespace Elsewhere { class Person {} }\n";
+    let actual = renamed_alias_policy_caller(caller, "Person").await;
+    let expected = caller.replace("App\\User", "App\\Person").replace(
+        "make(): User { return new User(); }",
+        "make(): Person { return new Person(); }",
+    );
+    assert_eq!(actual, expected);
+}
+
+#[tokio::test]
+async fn rename_class_alias_policy_import_only_collision_still_picks_free_alias() {
+    let caller = "<?php\nnamespace Client;\nuse App\\User;\nuse Other\\Person;\nuse Third\\PersonAlias;\nfunction make(): User { return new User(); }\n";
+    let actual = renamed_alias_policy_caller(caller, "Person").await;
+    let expected = caller
+        .replace("use App\\User;", "use App\\Person as PersonAlias2;")
+        .replace(
+            "make(): User { return new User(); }",
+            "make(): PersonAlias2 { return new PersonAlias2(); }",
+        );
+    assert_eq!(actual, expected);
+}
+
+#[tokio::test]
+async fn rename_class_alias_policy_move_adds_import_without_shadowing_local_class() {
+    let caller =
+        "<?php\nnamespace App;\nclass Person {}\nfunction make(): User { return new User(); }\n";
+    let actual = renamed_alias_policy_caller(caller, "Domain\\Person").await;
+    assert!(
+        actual.contains("use Domain\\Person as PersonAlias;"),
+        "{actual}"
+    );
+    assert!(actual.contains("class Person {}"), "{actual}");
+    assert!(
+        actual.contains("function make(): PersonAlias { return new PersonAlias(); }"),
+        "{actual}"
+    );
+}

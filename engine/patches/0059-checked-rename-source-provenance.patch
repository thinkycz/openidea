+            rename: RenameParams {
+                text_document_position: TextDocumentPositionParams {
+                    text_document: TextDocumentIdentifier {
+                        uri: source_uri.clone(),
+                    },
+                    position,
+                },
+                new_name: "Person".into(),
+                work_done_progress_params: WorkDoneProgressParams::default(),
+            },
+            expected_sources: vec![ExpectedSource {
+                uri: source_uri.clone(),
+                version: 2,
+                sha256_utf8: format!("{:x}", Sha256::digest(current.as_bytes())),
+            }],
+        };
+        let edit = backend
+            .workbench_rename_checked(request)
+            .await
+            .unwrap()
+            .expect("actual class rename proposal");
+        let changes = edit
+            .changes
+            .as_ref()
+            .expect("resource rename capability is disabled in this backend fixture");
+        let consumer_edits = changes.get(&consumer_uri).expect(
+            "a current class rename must refresh and include the real consumer created without a watcher event");
+        assert_eq!(
+            consumer_edits.len(),
+            2,
+            "both real type and constructor uses must be renamed"
+        );
+        let after = crate::text_position::apply_text_edits(consumer, consumer_edits);
+        assert_eq!(
+            after,
+            "<?php\nfunction make(): Person { return new Person(); }\n"
+        );
+        let source_edits = changes
+            .get(&source_uri)
+            .expect("current source declaration edit");
+        assert_eq!(
+            crate::text_position::apply_text_edits(current, source_edits),
+            "<?php\nclass Person {}\n"
+        );
+        assert!(
+            backend
+                .symbol_maps
+                .read()
+                .contains_key(consumer_uri.as_str())
+        );
+        assert!(backend.parsed_uris.read().contains(consumer_uri.as_str()));
+        assert_eq!(
+            std::fs::read_to_string(source_path).unwrap(),
+            before,
+            "engine only proposes edits"
+        );
+        assert_eq!(std::fs::read_to_string(consumer_path).unwrap(), consumer);
+    }
+}

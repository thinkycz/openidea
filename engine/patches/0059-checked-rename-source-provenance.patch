+#[tokio::test]
+async fn checked_rename_project_compat_explicit_external_php_keeps_active_workspace_separate() {
+    let directory = tempfile::tempdir().unwrap();
+    let root = directory.path().canonicalize().unwrap();
+    let workspace = root.join("active-app");
+    write(
+        &root,
+        "active-app/composer.json",
+        r#"{"name":"fixture/active","require":{"php":"^8.2"},"autoload":{"psr-4":{"App\\":"src/"}}}"#,
+    );
+    write(
+        &root,
+        "active-app/.phpantom.toml",
+        "[indexing]\nstrategy = \"none\"\n",
+    );
+    let app_source = "<?php\nclass User {}\n";
+    write(&root, "active-app/src/User.php", app_source);
+    let disk_external = "<?php\nclass User {}\nfunction make(): User { return new User(); }\n";
+    write(&root, "outside/User.php", disk_external);
+    let source = root.join("outside/User.php");
+    assert!(!source.starts_with(&workspace));
+    let dirty = "<?php\r\n/* external café 🐘 */ class User {}\r\nfunction make(): User { return new User(); }\r\n";
+    let router = router(&workspace).await;
+    let active = workspace.join("src/User.php");
+    open(&router, &active).await;
+    open(&router, &source).await;
+    replace(&router, &source, 2, dirty).await;
+    let response = router
+        .workbench_rename_checked(params(
+            &source,
+            dirty,
+            "User {}",
+            vec![expected(&source, dirty)],
+        ))
+        .await;
+    // Explicitly shut down even if the actual checked call refused. Do not turn
+    // refusal into a successful compatibility result or call a standard fallback.
+    router.shutdown().await.unwrap();
+    let edit = response
+        .expect("checked external source must retain its real open authority")
+        .expect("external class rename edit");
+    let new_uri = assert_move(&edit, &source);
+    assert_eq!(edit_uris(&edit), HashSet::from([new_uri.clone()]));
+    assert_eq!(
+        apply_edits(dirty, &edits_for_uri(&edit, &new_uri)),
+        dirty.replace("User", "Person")
+    );
+    assert!(
+        edits_for_uri(&edit, &Url::from_file_path(&active).unwrap()).is_empty(),
+        "active workspace's same-name class must not enter standalone source authority"
+    );
+    assert_eq!(fs::read(&source).unwrap(), disk_external.as_bytes());
+    assert_eq!(fs::read(&active).unwrap(), app_source.as_bytes());
+    assert!(!source.with_file_name("Person.php").exists());
+}

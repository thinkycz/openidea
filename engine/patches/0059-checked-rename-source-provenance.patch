+#[tokio::test]
+async fn checked_rename_external_authority_dirty_source_survives_topology_rebuild_and_close_reopen()
+{
+    let directory = tempfile::tempdir().unwrap();
+    let root = directory.path().canonicalize().unwrap();
+    let (workspace, source) = setup(&root);
+    let disk = fs::read_to_string(&source).unwrap();
+    let active = workspace.join("src/User.php");
+    let active_disk = fs::read(&active).unwrap();
+    // Obtain the existing no-workspace policy's target instead of hard-coding
+    // whichever default PHP version the declaration corpus currently supports.
+    let unscoped = router(None).await;
+    let default_target = target(&unscoped, None).await;
+    unscoped.shutdown().await.unwrap();
+    assert_ne!(
+        default_target, "7.4",
+        "fixture must distinguish root and virtual settings"
+    );
+    let router = router(Some(&workspace)).await;
+    open(&router, &active).await;
+    open(&router, &source).await;
+    let dirty = "<?php\r\n/* external café 🐘 */ class User {}\r\nfunction make(): User { return new User(); }\r\n";
+    replace(&router, &source, 2, dirty).await;
+    assert_eq!(target(&router, Some(&active)).await, "7.4");
+    assert_eq!(
+        target(&router, Some(&source)).await,
+        default_target,
+        "external source must not inherit active workspace config"
+    );
+    assert_external_rename(&router, &source, dirty, 2).await;
+    // Real folder add/remove invokes router retirement/reconfiguration. The
+    // second root intentionally owns another same-name class as well.
+    write(
+        &root,
+        "second/composer.json",
+        r#"{"name":"fixture/second","autoload":{"psr-4":{"Second\\":"src/"}}}"#,
+    );
+    write(
+        &root,
+        "second/.phpantom.toml",
+        "[indexing]\nstrategy = \"none\"\n",
+    );
+    write(&root, "second/src/User.php", "<?php\nclass User {}\n");
+    let folder = WorkspaceFolder {
+        uri: Url::from_directory_path(root.join("second")).unwrap(),
+        name: "second".into(),
+    };
+    router
+        .did_change_workspace_folders(DidChangeWorkspaceFoldersParams {
+            event: WorkspaceFoldersChangeEvent {
+                added: vec![folder.clone()],
+                removed: vec![],
+            },
+        })
+        .await;
+    assert_external_rename(&router, &source, dirty, 2).await;
+    assert_eq!(target(&router, Some(&source)).await, default_target);
+    assert_eq!(target(&router, Some(&active)).await, "7.4");
+    router
+        .did_change_workspace_folders(DidChangeWorkspaceFoldersParams {
+            event: WorkspaceFoldersChangeEvent {
+                added: vec![],
+                removed: vec![folder],
+            },
+        })
+        .await;
+    assert_external_rename(&router, &source, dirty, 2).await;
+    close_alias(&router, &source).await;
+    assert_eq!(
+        target(&router, None).await,
+        "7.4",
+        "closed external owner must not crowd root defaults"
+    );
+    assert_eq!(open(&router, &source).await, disk);
+    assert_external_rename(&router, &source, &disk, 1).await;
+    assert_eq!(target(&router, Some(&source)).await, default_target);
+    assert_eq!(fs::read(&source).unwrap(), disk.as_bytes());
+    assert_eq!(fs::read(&active).unwrap(), active_disk);
+    assert!(!source.with_file_name("Person.php").exists());
+    router.shutdown().await.unwrap();
+}

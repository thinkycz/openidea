+    let valid = params(&uri, TEXT, 1);
+    let mut cases = Vec::new();
+    let mut empty = valid.clone();
+    empty.expected_sources.clear();
+    cases.push(empty);
+    let mut duplicate = valid.clone();
+    duplicate
+        .expected_sources
+        .push(duplicate.expected_sources[0].clone());
+    cases.push(duplicate);
+    let mut bad_hash = valid.clone();
+    bad_hash.expected_sources[0].sha256_utf8 = "z".repeat(64);
+    cases.push(bad_hash);
+    let mut short_hash = valid.clone();
+    short_hash.expected_sources[0].sha256_utf8.pop();
+    cases.push(short_hash);
+    let mut oversized = valid.clone();
+    oversized.expected_sources = vec![valid.expected_sources[0].clone(); 1025];
+    cases.push(oversized);
+    let mut missing_source = valid.clone();
+    missing_source.expected_sources[0].uri =
+        Url::from_file_path(dir.path().join("other.php")).unwrap();
+    cases.push(missing_source);
+    for invalid in cases {
+        assert_eq!(
+            backend
+                .workbench_rename_checked(invalid)

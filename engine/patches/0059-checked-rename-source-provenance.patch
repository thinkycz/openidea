+#[tokio::test]
+async fn checked_rename_project_compat_installed_path_package_replays_both_open_sources_into_consumer()
+ {
+    let directory = tempfile::tempdir().unwrap();
+    let root = directory.path().canonicalize().unwrap();
+    // Match composer_project_nested's real installed symlink path fixture. The
+    // package's own PHP target differs, and physical source lies outside app.
+    write(
+        &root,
+        "apps/z-app/composer.json",
+        r#"{"name":"fixture/consumer","require":{"php":"^8.2","acme/pkg":"@dev"},"autoload":{"psr-4":{"App\\":"src/"}},"repositories":[{"type":"path","url":"../../packages/shared","options":{"symlink":true}}]}"#,
+    );
+    write(
+        &root,
+        "apps/z-app/.phpantom.toml",
+        "[indexing]\nstrategy = \"none\"\n",
+    );
+    write(
+        &root,
+        "packages/shared/composer.json",
+        r#"{"name":"acme/pkg","require":{"php":"^7.4"},"autoload":{"psr-4":{"Library\\":"src/"}}}"#,
+    );
+    write(
+        &root,
+        "packages/shared/.phpantom.toml",
+        "[php]\nversion = \"7.4\"\n[indexing]\nstrategy = \"none\"\n",
+    );
+    let package_disk = "<?php\nnamespace Library;\nclass User {}\n";
+    let caller_disk = "<?php\nuse Library\\User as Account;\nfunction make(): Account { return new Account(); }\n";
+    write(&root, "packages/shared/src/User.php", package_disk);
+    write(&root, "apps/z-app/index.php", caller_disk);
+    write(
+        &root,
+        "apps/z-app/vendor/composer/installed.json",
+        r#"{"packages":[{"name":"acme/pkg","version":"dev-main","install-path":"../acme/pkg","dist":{"type":"path","url":"../../packages/shared"},"transport-options":{"symlink":true},"autoload":{"psr-4":{"Library\\":"src/"}}}]}"#,
+    );
+    write(
+        &root,
+        "apps/z-app/vendor/composer/autoload_classmap.php",
+        "<?php\n$vendorDir = dirname(__DIR__);\nreturn array(\n    'Library\\\\User' => $vendorDir . '/acme/pkg/src/User.php',\n);\n",
+    );
+    let vendor = root.join("apps/z-app/vendor/acme/pkg");
+    fs::create_dir_all(vendor.parent().unwrap()).unwrap();
+    std::os::unix::fs::symlink(root.join("packages/shared"), &vendor).unwrap();
+    let package = root.join("packages/shared/src/User.php");
+    let caller = root.join("apps/z-app/index.php");
+    assert_eq!(
+        vendor.join("src/User.php").canonicalize().unwrap(),
+        package.canonicalize().unwrap()
+    );
+    assert!(!package.starts_with(root.join("apps/z-app")));
+    let package_dirty =
+        "<?php\r\nnamespace Library;\r\n/* package žluťoučký 🐘 */ class User {}\r\n";
+    let caller_dirty = "<?php\r\n/* caller café 🐘 */ use Library\\User as Account;\r\nfunction make(): Account { return new Account(); }\r\n";
+    let router = router(&root).await;
+    // Real physical source is opened first; the consuming app is subsequently
+    // opened. The checked endpoint must work through actual project ownership
+    // and overlay replay, not direct Backend::open_files injection.
+    open(&router, &package).await;
+    replace(&router, &package, 2, package_dirty).await;
+    open(&router, &caller).await;
+    replace(&router, &caller, 2, caller_dirty).await;
+    let request = params(
+        &caller,
+        caller_dirty,
+        "User as Account",
+        vec![
+            expected(&package, package_dirty),
+            expected(&caller, caller_dirty),
+        ],
+    );
+    let response = router.workbench_rename_checked(request).await;
+    let package_target = router
+        .workbench_active_target(ProjectTargetQuery {
+            uri: Some(Url::from_file_path(&package).unwrap()),
+        })
+        .await;
+    let caller_target = router
+        .workbench_active_target(ProjectTargetQuery {
+            uri: Some(Url::from_file_path(&caller).unwrap()),
+        })
+        .await;
+    router.shutdown().await.unwrap();
+    let edit = response.expect("checked package rename must verify both real open inputs in the selected consuming context")
+        .expect("installed path package class rename edit");
+    assert_eq!(
+        package_target.unwrap().php_version,
+        "8.2",
+        "physical installed package retains consuming config, not its own 7.4 context"
+    );
+    assert_eq!(caller_target.unwrap().php_version, "8.2");
+    let new_uri = assert_move(&edit, &package);
+    let caller_uri = Url::from_file_path(&caller).unwrap();
+    assert_eq!(
+        edit_uris(&edit),
+        HashSet::from([new_uri.clone(), caller_uri.clone()])
+    );
+    assert_eq!(
+        apply_edits(package_dirty, &edits_for_uri(&edit, &new_uri)),
+        package_dirty.replace("class User", "class Person")
+    );
+    assert_eq!(
+        apply_edits(caller_dirty, &edits_for_uri(&edit, &caller_uri)),
+        caller_dirty.replace("Library\\User", "Library\\Person"),
+        "explicit Account import alias and call sites remain stable"
+    );
+    assert_eq!(fs::read(&package).unwrap(), package_disk.as_bytes());
+    assert_eq!(fs::read(&caller).unwrap(), caller_disk.as_bytes());
+    assert_eq!(
+        fs::read(vendor.join("src/User.php")).unwrap(),
+        package_disk.as_bytes()
+    );
+    assert!(!package.with_file_name("Person.php").exists());
+    assert!(!vendor.join("src/Person.php").exists());
+}

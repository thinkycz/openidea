+//! Real router ownership and overlay replay for non-project PHP documents.
+#![cfg(unix)]
+
+use std::{collections::HashSet, fs, path::Path};
+
+use phpantom_lsp::{
+    ProjectRouter, ProjectTargetQuery,
+    workbench_rename::{ExpectedSource, RenameCheckedParams},
+};
+use sha2::{Digest, Sha256};
+use tower_lsp::{LanguageServer, lsp_types::*};
+
+use super::composer_project_aliases::{close_alias, open, replace, write};
+use crate::common::{apply_edits, edits_for_uri, position_of};
+
+async fn router(root: Option<&Path>) -> ProjectRouter {
+    let router = ProjectRouter::new_test();
+    let uri = root.map(|root| Url::from_directory_path(root).unwrap());
+    router
+        .initialize(InitializeParams {
+            root_uri: uri.clone(),
+            workspace_folders: uri.map(|uri| {
+                vec![WorkspaceFolder {
+                    uri,
+                    name: "external-authority".into(),
+                }]
+            }),
+            capabilities: ClientCapabilities {
+                workspace: Some(WorkspaceClientCapabilities {
+                    workspace_edit: Some(WorkspaceEditClientCapabilities {
+                        document_changes: Some(true),
+                        resource_operations: Some(vec![ResourceOperationKind::Rename]),
+                        ..Default::default()
+                    }),
+                    ..Default::default()
+                }),
+                ..Default::default()
+            },
+            ..Default::default()
+        })
+        .await
+        .unwrap();
+    router.initialized(InitializedParams {}).await;
+    router
+}
+
+async fn target(router: &ProjectRouter, path: Option<&Path>) -> String {
+    router
+        .workbench_active_target(ProjectTargetQuery {
+            uri: path.map(|path| Url::from_file_path(path).unwrap()),
+        })
+        .await
+        .unwrap()
+        .php_version
+}
+
+fn setup(root: &Path) -> (std::path::PathBuf, std::path::PathBuf) {
+    write(
+        root,
+        "active-app/composer.json",
+        r#"{"name":"fixture/active","require":{"php":"^7.4"},"autoload":{"psr-4":{"App\\":"src/"}}}"#,
+    );
+    write(
+        root,
+        "active-app/.phpantom.toml",
+        "[php]\nversion = \"7.4\"\n[indexing]\nstrategy = \"none\"\n",
+    );
+    write(root, "active-app/src/User.php", "<?php\nclass User {}\n");
+    write(
+        root,
+        "outside/User.php",
+        "<?php\nclass User {}\nfunction make(): User { return new User(); }\n",
+    );
+    (root.join("active-app"), root.join("outside/User.php"))
+}
+
+async fn assert_external_rename(router: &ProjectRouter, source: &Path, text: &str, version: i32) {
+    let old_uri = Url::from_file_path(source).unwrap();
+    let new_uri = Url::from_file_path(source.with_file_name("Person.php")).unwrap();
+    let edit = router
+        .workbench_rename_checked(RenameCheckedParams {
+            rename: RenameParams {
+                text_document_position: TextDocumentPositionParams {
+                    text_document: TextDocumentIdentifier {
+                        uri: old_uri.clone(),
+                    },
+                    position: position_of(text, "User {}"),
+                },
+                new_name: "Person".into(),
+                work_done_progress_params: Default::default(),
+            },
+            expected_sources: vec![ExpectedSource {
+                uri: old_uri.clone(),
+                version,
+                sha256_utf8: format!("{:x}", Sha256::digest(text.as_bytes())),
+            }],
+        })
+        .await
+        .expect("actual checked endpoint must retain current external authority")
+        .expect("external class proposal");
+    let Some(DocumentChanges::Operations(operations)) = &edit.document_changes else {
+        panic!("real resource proposal")
+    };
+    let Some(DocumentChangeOperation::Op(ResourceOp::Rename(rename))) = operations.first() else {
+        panic!("leading RenameFile")
+    };
+    assert_eq!(rename.old_uri, old_uri);
+    assert_eq!(rename.new_uri, new_uri);
+    assert!(rename.options.is_none());
+    let uris: HashSet<_> = operations
+        .iter()
+        .filter_map(|operation| match operation {
+            DocumentChangeOperation::Edit(document) => {
+                assert!(document.text_document.version.is_none());
+                Some(document.text_document.uri.clone())
+            }
+            _ => None,
+        })
+        .collect();
+    assert_eq!(
+        uris,
+        HashSet::from([new_uri.clone()]),
+        "workspace same-name class must remain outside this proposal"
+    );
+    assert!(edits_for_uri(&edit, &old_uri).is_empty());
+    assert_eq!(
+        apply_edits(text, &edits_for_uri(&edit, &new_uri)),
+        text.replace("User", "Person")
+    );
+}

+//! Actual router ownership for checked rename across external and installed sources.
+#![cfg(unix)]
+
+use super::composer_project_aliases::{open, replace, write};
+use crate::common::{apply_edits, edits_for_uri, position_of};
+use phpantom_lsp::{
+    ProjectRouter, ProjectTargetQuery,
+    workbench_rename::{ExpectedSource, RenameCheckedParams},
+};
+use sha2::{Digest, Sha256};
+use std::{collections::HashSet, fs, path::Path};
+use tower_lsp::{LanguageServer, lsp_types::*};
+
+async fn router(root: &Path) -> ProjectRouter {
+    let router = ProjectRouter::new_test();
+    router
+        .initialize(InitializeParams {
+            root_uri: Some(Url::from_directory_path(root).unwrap()),
+            workspace_folders: Some(vec![WorkspaceFolder {
+                uri: Url::from_directory_path(root).unwrap(),
+                name: "checked-project-compat".into(),
+            }]),
+            capabilities: ClientCapabilities {
+                workspace: Some(WorkspaceClientCapabilities {
+                    workspace_edit: Some(WorkspaceEditClientCapabilities {
+                        document_changes: Some(true),
+                        resource_operations: Some(vec![ResourceOperationKind::Rename]),
+                        ..Default::default()
+                    }),
+                    ..Default::default()
+                }),
+                ..Default::default()
+            },
+            ..InitializeParams::default()
+        })
+        .await
+        .unwrap();
+    router.initialized(InitializedParams {}).await;
+    router
+}
+
+fn expected(path: &Path, text: &str) -> ExpectedSource {
+    ExpectedSource {
+        uri: Url::from_file_path(path).unwrap(),
+        version: 2,
+        sha256_utf8: format!("{:x}", Sha256::digest(text.as_bytes())),
+    }
+}
+
+fn params(
+    path: &Path,
+    text: &str,
+    needle: &str,
+    sources: Vec<ExpectedSource>,
+) -> RenameCheckedParams {
+    RenameCheckedParams {
+        rename: RenameParams {
+            text_document_position: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier {
+                    uri: Url::from_file_path(path).unwrap(),
+                },
+                position: position_of(text, needle),
+            },
+            new_name: "Person".into(),
+            work_done_progress_params: WorkDoneProgressParams::default(),
+        },
+        expected_sources: sources,
+    }
+}
+
+fn edit_uris(edit: &WorkspaceEdit) -> HashSet<Url> {
+    let Some(DocumentChanges::Operations(operations)) = &edit.document_changes else {
+        panic!("Rename capability must produce a real resource proposal: {edit:?}");
+    };
+    assert!(edit.changes.is_none());
+    operations
+        .iter()
+        .filter_map(|operation| match operation {
+            DocumentChangeOperation::Edit(document) => {
+                assert!(
+                    document.text_document.version.is_none(),
+                    "real engine uses null versions"
+                );
+                Some(document.text_document.uri.clone())
+            }
+            _ => None,
+        })
+        .collect()
+}
+
+fn assert_move(edit: &WorkspaceEdit, source: &Path) -> Url {
+    let Some(DocumentChanges::Operations(operations)) = &edit.document_changes else {
+        panic!("resource proposal")
+    };
+    let Some(DocumentChangeOperation::Op(ResourceOp::Rename(rename))) = operations.first() else {
+        panic!("a real leading RenameFile is required: {edit:?}");
+    };
+    let old = Url::from_file_path(source).unwrap();
+    let new = Url::from_file_path(source.with_file_name("Person.php")).unwrap();
+    assert_eq!(
+        rename.old_uri, old,
+        "active physical source spelling owns the declaration"
+    );
+    assert_eq!(rename.new_uri, new);
+    assert!(rename.options.is_none());
+    assert!(
+        operations[1..]
+            .iter()
+            .all(|operation| matches!(operation, DocumentChangeOperation::Edit(_)))
+    );
+    assert!(
+        edits_for_uri(edit, &old).is_empty(),
+        "source edits must use the new URI after the leading move"
+    );
+    new
+}

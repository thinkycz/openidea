diff --git a/src/workbench_rename.rs b/src/workbench_rename.rs
new file mode 100644
index 0000000..7c0420e
--- /dev/null
+++ b/src/workbench_rename.rs
@@ -0,0 +1,428 @@
+//! Rename against explicit editor-owned source versions, without trusting disk hydration.
+use std::collections::HashSet;
+use std::path::PathBuf;
+use std::sync::Arc;
+
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use tower_lsp::jsonrpc::{Error, ErrorCode, Result};
+use tower_lsp::lsp_types::{MessageType, RenameParams, Url, WorkspaceEdit};
+
+use crate::{Backend, project_router::ProjectRouter};
+
+const MAX_SOURCES: usize = 1024;
+const MAX_URI_BYTES: usize = 1024 * 1024;
+
+/// An exact UTF-8 source the editor owns at request start.
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ExpectedSource {
+    /// Open document URI, using its active source-authority spelling.
+    pub uri: Url,
+    /// The exact version sent in didOpen or didChange, including version zero.
+    pub version: i32,
+    /// SHA-256 of the complete UTF-8 text; no newline or Unicode normalization.
+    pub sha256_utf8: String,
+}
+
+/// Standard rename fields plus the immutable sources captured by the caller.
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct RenameCheckedParams {
+    /// Standard textDocument, position, newName and optional progress token.
+    #[serde(flatten)]
+    pub rename: RenameParams,
+    /// Nonempty, physically distinct open sources; must include textDocument.
+    pub expected_sources: Vec<ExpectedSource>,
+}
+
+fn modified() -> Error {
+    Error {
+        code: ErrorCode::ServerError(-32801),
+        message: "PHP rename source changed or is not open".into(),
+        data: None,
+    }
+}
+
+fn authority_path(uri: &Url) -> Result<PathBuf> {
+    if uri.scheme() != "file" || uri.query().is_some() || uri.fragment().is_some() {
+        return Err(Error::invalid_params("Expected a local file URI"));
+    }
+    let path = uri
+        .to_file_path()
+        .map_err(|_| Error::invalid_params("Expected a local file URI"))?;
+    if !path.is_absolute() {
+        return Err(Error::invalid_params("Expected an absolute source path"));
+    }
+    path.canonicalize()
+        .or_else(|_| -> std::io::Result<PathBuf> {
+            let parent = path
+                .parent()
+                .ok_or_else(|| std::io::Error::from(std::io::ErrorKind::InvalidInput))?;
+            let leaf = path
+                .file_name()
+                .ok_or_else(|| std::io::Error::from(std::io::ErrorKind::InvalidInput))?;
+            Ok(parent.canonicalize()?.join(leaf))
+        })
+        .map_err(|_| modified())
+}
+
+impl RenameCheckedParams {
+    fn validate(&self) -> Result<()> {
+        if self.expected_sources.is_empty() || self.expected_sources.len() > MAX_SOURCES {
+            return Err(Error::invalid_params("Expected between 1 and 1024 sources"));
+        }
+        let source = authority_path(&self.rename.text_document_position.text_document.uri)?;
+        let mut paths = HashSet::with_capacity(self.expected_sources.len());
+        let mut bytes = 0usize;
+        for expected in &self.expected_sources {
+            bytes = bytes
+                .checked_add(expected.uri.as_str().len())
+                .ok_or_else(|| Error::invalid_params("Source URI budget exceeded"))?;
+            if bytes > MAX_URI_BYTES {
+                return Err(Error::invalid_params("Source URI budget exceeded"));
+            }
+            if expected.sha256_utf8.len() != 64
+                || !expected.sha256_utf8.bytes().all(|b| b.is_ascii_hexdigit())
+            {
+                return Err(Error::invalid_params(
+                    "sha256Utf8 must contain exactly 64 hexadecimal digits",
+                ));
+            }
+            if !paths.insert(authority_path(&expected.uri)?) {
+                return Err(Error::invalid_params(
+                    "Duplicate canonical source authority",
+                ));
+            }
+        }
+        if !paths.contains(&source)
+            || !self.expected_sources.iter().any(|expected| {
+                expected.uri == self.rename.text_document_position.text_document.uri
+            })
+        {
+            return Err(Error::invalid_params(
+                "Expected sources must include the exact textDocument URI",
+            ));
+        }
+        Ok(())
+    }
+}
+
+impl ProjectRouter {
+    /// Route checked rename to the same document authority as ordinary rename.
+    pub async fn workbench_rename_checked(
+        &self,
+        params: RenameCheckedParams,
+    ) -> Result<Option<WorkspaceEdit>> {
+        let _request = self.request_guard().await;
+        let project = self
+            .project_for(&params.rename.text_document_position.text_document.uri)
+            .await?;
+        project.backend.workbench_rename_checked(params).await
+    }
+}
+
+impl Backend {
+    fn verify_rename_sources(&self, expected_sources: &[ExpectedSource]) -> Result<()> {
+        for expected in expected_sources {
+            let uri = expected.uri.as_str();
+            if self
+                .symbols
+                .source_authority
+                .preferred(uri)
+                .is_some_and(|active| active != uri)
+            {
+                return Err(modified());
+            }
+            // Keep the established documents -> open_files lock order, and
+            // retain the exact Arc while hashing outside these locks.
+            let text = {
+                let documents = self.diag.documents.lock();
+                let open_files = self.open_files.read();
+                let text = open_files.get(uri).ok_or_else(modified)?;
+                let revision = documents
+                    .capture_source(uri, text)
+                    .map_err(|_| modified())?
+                    .ok_or_else(modified)?;
+                if revision.version != expected.version {
+                    return Err(modified());
+                }
+                Arc::clone(text)
+            };
+            let actual = format!("{:x}", Sha256::digest(text.as_bytes()));
+            if !actual.eq_ignore_ascii_case(&expected.sha256_utf8) {
+                return Err(modified());
+            }
+        }
+        Ok(())
+    }
+
+    /// Rename only while all supplied open versions and UTF-8 hashes agree.
+    /// Additional edited targets still require caller-side discovery and a new
+    /// checked request: this method does not attest unseen project files.
+    pub async fn workbench_rename_checked(
+        &self,
+        params: RenameCheckedParams,
+    ) -> Result<Option<WorkspaceEdit>> {
+        let backend = self.clone_for_blocking();
+        let outcome = crate::server::run_blocking_cancel_safe("rename_checked", move || {
+            params.validate()?;
+            let uri = params
+                .rename
+                .text_document_position
+                .text_document
+                .uri
+                .to_string();
+            let position = params.rename.text_document_position.position;
+            backend.ensure_workspace_index_ready_for_request();
+            // Refresh classification itself reads symbol kinds. Reconcile pending
+            // open parses before deciding whether this rename can cross files;
+            // an old local-variable map must not suppress the filesystem refresh.
+            let needs_refresh = backend.with_current_semantics(|| {
+                backend
+                    .handle_with_position("rename_checked", &uri, position, |content, pos| {
+                        Some(backend.rename_needs_workspace_refresh(&uri, content, pos))
+                    })
+                    .map(|needs| needs.unwrap_or(false))
+            })?;
+            if needs_refresh {
+                backend.ensure_workspace_indexed_for_request();
+            }
+            // No await, second request, or semantic-guard reacquisition may
+            // separate source verification from the actual rename computation.
+            backend.with_current_semantics(|| {
+                backend.verify_rename_sources(&params.expected_sources)?;
+                let result = backend.handle_with_position(
+                    "rename_checked",
+                    &uri,
+                    position,
+                    |content, pos| {
+                        Some(backend.handle_rename(&uri, content, pos, &params.rename.new_name))
+                    },
+                )?;
+                // Source authority can be shared across project contexts. Check
+                // it again before delivery as well as the semantic epoch fence.
+                backend.verify_rename_sources(&params.expected_sources)?;
+                Ok(result)
+            })
+        })
+        .await
+        .ok_or_else(Error::internal_error)??;
+        match outcome {
+            Some(Err(message)) => {
+                self.log(MessageType::WARNING, message.clone()).await;
+                Err(Error {
+                    code: ErrorCode::InvalidRequest,
+                    message: message.into(),
+                    data: None,
+                })
+            }
+            Some(Ok(edit)) => Ok(edit),
+            None => Ok(None),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use tower_lsp::{LanguageServer, lsp_types::*};
+
+    #[tokio::test]
+    async fn checked_rename_reconciles_exact_pending_open_parse_before_computing() {

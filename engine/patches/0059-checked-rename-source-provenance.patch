+//! Behavioral acceptance of the actual checked-rename method, not fabricated edits.
+use crate::common::{apply_edits, create_test_backend, edits_for_uri};
+use phpantom_lsp::{
+    ProjectRouter,
+    workbench_rename::{ExpectedSource, RenameCheckedParams},
+};
+use sha2::{Digest, Sha256};
+use tower_lsp::{LanguageServer, jsonrpc::ErrorCode, lsp_types::*};
+
+const TEXT: &str = "<?php\nfunction demo() { $user = 1; echo $user; }\n";
+
+fn params(uri: &Url, text: &str, version: i32) -> RenameCheckedParams {
+    RenameCheckedParams {
+        rename: RenameParams {
+            text_document_position: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier { uri: uri.clone() },
+                position: Position::new(1, 20),
+            },
+            new_name: "$person".into(),
+            work_done_progress_params: WorkDoneProgressParams::default(),
+        },
+        expected_sources: vec![ExpectedSource {
+            uri: uri.clone(),
+            version,
+            sha256_utf8: format!("{:x}", Sha256::digest(text.as_bytes())),
+        }],
+    }
+}
+fn fixture() -> (tempfile::TempDir, Url) {
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("source.php");
+    std::fs::write(&path, TEXT).unwrap();
+    let uri = Url::from_file_path(path).unwrap();
+    (dir, uri)
+}
+async fn open(backend: &impl LanguageServer, uri: &Url, text: &str, version: i32) {
+    backend

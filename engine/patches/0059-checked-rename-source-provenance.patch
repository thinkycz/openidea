+// Real PSR-4 cross-file controls exercise the checked semantic computation,
+// explicit import aliases and actual resource-capability negotiation.
+async fn checked_cross_file_class_control(resource_support: bool) {
+    use crate::common::{create_psr4_workspace, extract_rename_file, lsp_pos_to_offset};
+    let source_disk = "<?php\r\nnamespace App;\r\nclass User {}\r\n";
+    let caller_disk = "<?php\nnamespace App;\nuse App\\User as Account;\nfunction make(): Account { return new Account(); }\n";
+    let source_dirty =
+        "<?php\r\nnamespace App;\r\n/* 😀 */ class User { public string $tag = 'dirty'; }\r\n";
+    let caller_dirty = "<?php\r\nnamespace App;\r\nuse App\\User as Account;\r\nfunction make(): Account { $label = '😀'; $direct = new \\App\\User(); return new Account(); }\r\n";
+    let (backend, dir) = create_psr4_workspace(
+        r#"{"autoload":{"psr-4":{"App\\":"src/"}}}"#,
+        &[
+            ("src/User.php", source_disk),
+            ("src/Caller.php", caller_disk),
+        ],
+    );
+    backend
+        .initialize(InitializeParams {
+            capabilities: ClientCapabilities {
+                workspace: Some(WorkspaceClientCapabilities {
+                    workspace_edit: Some(WorkspaceEditClientCapabilities {
+                        document_changes: Some(resource_support),
+                        resource_operations: Some(if resource_support {
+                            vec![ResourceOperationKind::Rename, ResourceOperationKind::Create]
+                        } else {
+                            Vec::new()
+                        }),
+                        ..Default::default()
+                    }),
+                    ..Default::default()
+                }),
+                ..Default::default()
+            },
+            ..Default::default()
+        })
+        .await
+        .unwrap();
+    let source_uri = Url::from_file_path(dir.path().join("src/User.php")).unwrap();
+    let caller_uri = Url::from_file_path(dir.path().join("src/Caller.php")).unwrap();
+    let destination = dir.path().join("src/Customer.php");
+    let destination_uri = Url::from_file_path(&destination).unwrap();
+    open(&backend, &source_uri, source_dirty, 3).await;
+    open(&backend, &caller_uri, caller_dirty, 7).await;
+    let mut request = params(&source_uri, source_dirty, 3);
+    let source_line = source_dirty.lines().nth(2).unwrap();
+    let declaration_byte = source_line.find("User").unwrap();
+    let declaration_utf16 = source_line[..declaration_byte].encode_utf16().count() as u32;
+    request.rename.text_document_position.position = Position::new(2, declaration_utf16 + 1);
+    request.rename.new_name = "Customer".into();
+    request.expected_sources.push(
+        params(&caller_uri, caller_dirty, 7)
+            .expected_sources
+            .remove(0),
+    );
+    // Checked request runs before ordinary rename so this is a fresh class
+    // computation, rather than a control warmed by the ordinary method.
+    let checked = backend
+        .workbench_rename_checked(request.clone())
+        .await
+        .unwrap()
+        .unwrap();
+    let source_target = if resource_support {
+        &destination_uri
+    } else {
+        &source_uri
+    };
+    if resource_support {
+        let Some(DocumentChanges::Operations(operations)) = &checked.document_changes else {
+            panic!("resource-capable client must receive ordered operations");
+        };
+        let Some(DocumentChangeOperation::Op(ResourceOp::Rename(first))) = operations.first()
+        else {
+            panic!("the real file rename must precede all text edits");
+        };
+        assert_eq!(first.old_uri, source_uri);
+        assert_eq!(first.new_uri, destination_uri);
+        assert!(checked.changes.is_none());
+        assert!(edits_for_uri(&checked, &source_uri).is_empty());
+    } else {
+        assert!(extract_rename_file(&checked).is_none());
+        assert!(checked.document_changes.is_none());
+        assert!(checked.changes.is_some());
+    }
+    let source_edits = edits_for_uri(&checked, source_target);
+    let caller_edits = edits_for_uri(&checked, &caller_uri);
+    assert!(!source_edits.is_empty());
+    assert!(!caller_edits.is_empty());
+    assert_eq!(
+        apply_edits(source_dirty, &source_edits),
+        source_dirty.replace("class User", "class Customer")
+    );
+    assert_eq!(
+        apply_edits(caller_dirty, &caller_edits),
+        caller_dirty.replace("App\\User", "App\\Customer")
+    );
+    // Declaration lies after a non-BMP scalar on the same CRLF line.
+    // Confirm actual edit coordinates bind to the intended original token.
+    assert!(source_edits.iter().any(|edit| {
+        edit.range.start == Position::new(2, declaration_utf16)
+            && &source_dirty[lsp_pos_to_offset(source_dirty, edit.range.start)
+                ..lsp_pos_to_offset(source_dirty, edit.range.end)]
+                == "User"
+    }));
+    let caller_line = caller_dirty.lines().nth(3).unwrap();
+    let direct_byte = caller_line.find("\\App\\User").unwrap();
+    let direct_utf16 = caller_line[..direct_byte].encode_utf16().count() as u32;
+    assert!(
+        caller_edits
+            .iter()
+            .any(|edit| edit.range.start.line == 3 && edit.range.start.character >= direct_utf16)
+    );
+    // Method parity is secondary to the complete expected strings above.
+    let ordinary = backend.rename(request.rename).await.unwrap().unwrap();
+    assert_eq!(
+        extract_rename_file(&ordinary).map(|rename| (&rename.old_uri, &rename.new_uri)),
+        extract_rename_file(&checked).map(|rename| (&rename.old_uri, &rename.new_uri))
+    );
+    assert_eq!(
+        apply_edits(source_dirty, &edits_for_uri(&ordinary, source_target)),
+        source_dirty.replace("class User", "class Customer")
+    );
+    assert_eq!(
+        apply_edits(caller_dirty, &edits_for_uri(&ordinary, &caller_uri)),
+        caller_dirty.replace("App\\User", "App\\Customer")
+    );
+    // Computing/applying an in-memory result must never mutate fixture disk.
+    assert_eq!(
+        std::fs::read_to_string(dir.path().join("src/User.php")).unwrap(),
+        source_disk
+    );
+    assert_eq!(
+        std::fs::read_to_string(dir.path().join("src/Caller.php")).unwrap(),
+        caller_disk
+    );
+    assert!(!destination.exists());
+}
+
+#[tokio::test]
+async fn checked_cross_file_dirty_class_rename_with_resources() {
+    checked_cross_file_class_control(true).await;
+}
+
+#[tokio::test]
+async fn checked_cross_file_dirty_class_rename_without_resources() {
+    checked_cross_file_class_control(false).await;
+}

+            statements.len(),
+            3,
+            "closure capture is not a namespace or trait import"
+        );
+        assert!(statements[0].top_level);
+        assert!(!statements[1].top_level);
+        assert!(statements[2].top_level);
+    }
+
+    #[test]
+    fn use_statement_relative_namespace_call_does_not_open_a_namespace_block() {
+        let content = concat!(
+            "<?php\nnamespace\\factory(new class {\n",
+            "use MissingTrait;\n",
+            "});\nuse Demo\\User;\n",
+        );
+        let statements = super::scan_use_statements(content);
+        assert_eq!(statements.len(), 2);
+        assert!(
+            !statements[0].top_level,
+            "anonymous-class trait use stays deeper"
+        );
+        assert!(
+            statements[1].top_level,
+            "following real import remains global"
+        );
+        let ranges = compute_use_line_ranges(content);
+        assert_eq!(
+            ranges
+                .iter()
+                .map(|&(start, end)| &content[start..end])
+                .collect::<Vec<_>>(),
+            vec!["use Demo\\User;"]
+        );
+    }
 }

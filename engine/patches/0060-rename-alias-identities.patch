+    let backend = create_test_backend();
+    let source_uri = Url::parse("file:///group-move/User.php").unwrap();
+    let caller_uri = Url::parse("file:///group-move/caller.php").unwrap();
+    let source = "<?php\nnamespace Demo;\nclass User {}\n";
+    open_php(&backend, &source_uri, source).await;
+    open_php(&backend, &caller_uri, caller).await;

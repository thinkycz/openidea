+async fn definition_composed_trait_alias_keeps_vendor_uri_and_original_offset() {
+    let backend = create_test_backend();
+    // Different file lengths make cross-file offset confusion observable.
+    let vendor = "<?php\nnamespace VendorDefinition;\n// padding intentionally differs\ntrait Implementation { public function run(): void {} }\n";
+    let source = concat!(
+        "<?php\nnamespace App;\nuse VendorDefinition\\Implementation;\n",
+        "trait DefWrapper { use Implementation { Implementation::run as innerRun; } }\n",
+        "class DefConsumer { use DefWrapper { DefWrapper::innerRun as outerRun; DefWrapper::run as plainRun; } }\n",
+        "function defDemo(DefConsumer $value): void { $value->innerRun(); $value->outerRun(); $value->plainRun(); }\n",
+    );
+    let vendor_uri = Url::parse("file:///vendor/definition-implementation.php").unwrap();
+    let uri = Url::parse("file:///consumer-definition.php").unwrap();
+    open_php(&backend, &vendor_uri, vendor).await;
+    open_php(&backend, &uri, source).await;
+    for name in ["innerRun", "outerRun", "plainRun"] {
+        composed_alias_definition_is_original(
+            &backend,
+            &uri,
+            source,
+            &format!("$value->{name}"),
+            &vendor_uri,
+            vendor,
+        )
+        .await;
+    }
+}

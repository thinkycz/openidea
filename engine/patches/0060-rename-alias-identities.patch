+async fn rename_import_aliases_actual_caller(caller: &str) -> String {
+    let backend = create_test_backend();
+    let source_uri = Url::parse("file:///same-target/User.php").unwrap();
+    let caller_uri = Url::parse("file:///same-target/caller.php").unwrap();
+    let vendor_uri = Url::parse("file:///same-target/Vendor.php").unwrap();
+    let source = "<?php\nnamespace Demo;\nclass User {}\n";
+    let vendor = "<?php\nnamespace Vendor;\nclass Person {}\nclass Occupied {}\n";
+    open_php(&backend, &source_uri, source).await;
+    open_php(&backend, &vendor_uri, vendor).await;
+    open_php(&backend, &caller_uri, caller).await;
+    let edit = rename(&backend, &source_uri, 2, 7, "Person")
+        .await
+        .expect("actual public rename must propose changes");
+    assert_eq!(
+        apply_edits(source, &edits_for_uri(&edit, &source_uri)),
+        "<?php\nnamespace Demo;\nclass Person {}\n"
+    );
+    assert!(
+        edits_for_uri(&edit, &vendor_uri).is_empty(),
+        "unrelated declarations must not change"
+    );
+    apply_edits(caller, &edits_for_uri(&edit, &caller_uri))
+}

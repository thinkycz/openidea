+    let missing =
+        || "An import changed while rename was being prepared. No edits were applied.".to_owned();
+    let mut spans = crate::diagnostics::use_statements::compute_use_statement_spans(content);
+    if let Some((start, end)) = block {
+        spans.retain(|&(offset, _)| offset >= start && offset <= end);
+    }
+    let mut groups: std::collections::BTreeMap<(usize, usize), Vec<&ImportInfo>> =
+        std::collections::BTreeMap::new();
+    for info in infos {
+        let source = use_map
+            .get(&info.alias)
+            .map(String::as_str)
+            .unwrap_or(old_fqn);
+        let location = crate::diagnostics::use_statements::find_use_statement(
+            content,
+            &spans,
+            source,
+            &info.alias,
+        )
+        .ok_or_else(missing)?;
+        groups.entry(location.statement).or_default().push(info);
+    }
+    let mut result = Vec::new();
+    for ((start, end), mut group) in groups {
+        group.sort_unstable_by(|a, b| a.alias.cmp(&b.alias));
+        let first = group.first().ok_or_else(missing)?;
+        let source = use_map
+            .get(&first.alias)
+            .map(String::as_str)
+            .unwrap_or(old_fqn);
+        let location = crate::diagnostics::use_statements::find_use_statement(
+            content,
+            &[(start, end)],
+            source,
+            &first.alias,
+        )
+        .ok_or_else(missing)?;
+        if strip_matching_prefix(target.new_fqn, location.prefix).is_some() {
+            for info in group {
+                result.push(
+                    build_use_statement_edit(
+                        content,
+                        block,
+                        old_fqn,
+                        target,
+                        info,
+                        use_map,
+                        file_namespace,
+                    )
+                    .ok_or_else(missing)?,
+                );
+            }
+            continue;
+        }
+        // The scanner's statement span extends to the line end. Keep any
+        // trailing comment or same-line code outside this coordinated edit.
+        let end = start
+            + content
+                .get(start..end)
+                .ok_or_else(missing)?
+                .find(';')
+                .ok_or_else(missing)?
+            + 1;
+        let mut retained = content.get(start..end).ok_or_else(missing)?.to_owned();
+        for info in &group {
+            let source = use_map
+                .get(&info.alias)
+                .map(String::as_str)
+                .unwrap_or(old_fqn);
+            let current = crate::diagnostics::use_statements::find_use_statement(
+                &retained,
+                &[(0, retained.len())],
+                source,
+                &info.alias,
+            )
+            .ok_or_else(missing)?;
+            if current.member_count == 1 {
+                retained.clear();
+            } else {
+                let (from, to) =
+                    list_item_delete_range(&retained, current.member.0, current.member.1);
+                retained.replace_range(from..to, "");
+            }
+        }
+        let indentation = content[..start].rsplit('\n').next().unwrap_or("");
+        let indentation = if indentation.chars().all(|c| c == ' ' || c == '\t') {
+            indentation
+        } else {
+            ""
+        };
+        let newline = if content.contains("\r\n") {
+            "\r\n"
+        } else {
+            "\n"
+        };
+        let separator = format!("{newline}{indentation}");
+        let mut statements = Vec::new();
+        if !retained.trim().is_empty() {
+            statements.push(retained);
+        }
+        for info in group {
+            statements.push(format!(
+                "use {};",
+                build_member_text(
+                    target.new_fqn,
+                    info,
+                    target.has_collision,
+                    target.new_short_name,
+                    target.collision_map,
+                )
+            ));
+        }
+        let range = Range {
+            start: offset_to_position(content, start),
+            end: offset_to_position(content, end),
+        };
+        result.push((
+            range,
+            vec![TextEdit {
+                range,
+                new_text: statements.join(&separator),
+            }],
+        ));
+    }
+    Ok(result)
+}

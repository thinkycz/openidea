+            ("src/Consumer.php", source),
+        ],
+    );
+    backend.initialized(InitializedParams {}).await;
+    let vendor_uri =
+        Url::from_file_path(dir.path().join("vendor/acme/pkg/Implementation.php")).unwrap();
+    let uri = Url::from_file_path(dir.path().join("src/Consumer.php")).unwrap();
+    open_php(&backend, &vendor_uri, vendor).await;
+    open_php(&backend, &uri, source).await;
+    let (line, character) = line_char_of(source, "$value->localRun");
+    assert!(
+        prepare_rename(&backend, &uri, line, character + 9)
+            .await
+            .is_some(),
+        "local alias owns a local rename declaration"
+    );
+    let edit = rename_result(&backend, &uri, line, character + 9, "localWork")
+        .await
+        .expect("local alias must not be rejected as vendor")
+        .expect("alias edits");
+    let edits = edits_for_uri(&edit, &uri);
+    assert_eq!(edits.len(), 2);
+    assert_eq!(
+        apply_edits(source, &edits),
+        source
+            .replace("as localRun", "as localWork")
+            .replace("$value->localRun()", "$value->localWork()")
+    );
+    assert!(edits_for_uri(&edit, &vendor_uri).is_empty());
+    let (line, character) = line_char_of(source, "$value->run");
+    assert!(
+        prepare_rename(&backend, &uri, line, character + 9)
+            .await
+            .is_none(),
+        "positive vendor-policy control: original implementation is protected"
+    );
+    assert_eq!(
+        std::fs::read_to_string(dir.path().join("src/Consumer.php")).unwrap(),
+        source
+    );
+    assert_eq!(
+        std::fs::read_to_string(dir.path().join("vendor/acme/pkg/Implementation.php")).unwrap(),
+        vendor
+    );
+}

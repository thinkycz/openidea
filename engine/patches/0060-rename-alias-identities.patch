+async fn composed_alias_definition_is_original(
+    backend: &phpantom_lsp::Backend,
+    uri: &Url,
+    source: &str,
+    needle: &str,
+    target_uri: &Url,
+    target_source: &str,
+) {
+    let (line, character) = line_char_of(source, needle);
+    let name_start = needle.rfind("->").unwrap() + 2;
+    let response =
+        crate::common::goto_definition_at(backend, uri, line, character + name_start as u32 + 1)
+            .await
+            .expect("alias definition must resolve");
+    let locations: Vec<Location> = match response {
+        GotoDefinitionResponse::Scalar(location) => vec![location],
+        GotoDefinitionResponse::Array(locations) => locations,
+        GotoDefinitionResponse::Link(links) => links
+            .into_iter()
+            .map(|link| Location {
+                uri: link.target_uri,
+                range: link.target_selection_range,
+            })
+            .collect(),
+    };
+    let (target_line, target_character) = line_char_of(target_source, "function run");
+    assert_eq!(
+        locations.len(),
+        1,
+        "one original implementation, not an alias declaration"
+    );
+    assert_eq!(&locations[0].uri, target_uri);
+    assert_eq!(
+        locations[0].range.start,
+        Position::new(target_line, target_character + 9),
+        "offset must identify original run, not receiver alias offset"
+    );
+}

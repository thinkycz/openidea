+    let (line, character) = line_char_of(COMPOSED_ALIAS_OWN_OVERRIDE, "function dispatch");
+    assert_eq!(
+        positions,
+        vec![(uri, Position::new(line, character + 9))],
+        "own implementation wins over dormant adaptation metadata"

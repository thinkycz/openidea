+    fn use_statement_namespace_trait_and_closure_contexts_remain_distinct() {
+        let content = concat!(
+            "<?php\nnamespace A {\nuse Demo\\User;\n",
+            "class C {\nuse TraitOne;\nfunction f() { $g = function () use ($captured) {}; }\n}\n}\n",
+            "namespace B {\nuse Demo\\Other;\n}\n",
+        );
+        let statements = super::scan_use_statements(content);

+            adjacent[1].range.start.character,
+        );
+        assert!(
+            end <= start,
+            "coordinated group edits must not overlap: {edits:?}"
+        );
+        assert!(
+            adjacent[0].range != adjacent[1].range,
+            "independent insertions at the same range must be coalesced: {edits:?}"
+        );
+    }
+    apply_edits(caller, &edits)

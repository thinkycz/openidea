+/// Every union alternative must bound its possible objects before a class
+/// inclusion can discard needle classes. An intersection keeps the constraint
+/// of any known component even when another component is unavailable.
+fn element_class_bounds_resolve(element: &PhpType, ctx: &VarResolutionCtx<'_>) -> bool {
+    if element.contains_mixed() || element.is_untyped() {
+        return false;
+    }
+    match element.kind() {
+        TypeKind::Union(members) => members
+            .iter()
+            .all(|member| element_class_bounds_resolve(member, ctx)),
+        TypeKind::Intersection(members) => members
+            .iter()
+            .any(|member| element_class_bounds_resolve(member, ctx)),
+        TypeKind::Nullable(inner) => element_class_bounds_resolve(inner, ctx),
+        TypeKind::Named(name) => {
+            if matches!(
+                name.as_str(),
+                "object" | "callable" | "callable-object" | "iterable"
+            ) {
+                return false;
+            }
+            (element.is_scalar()
+                && !matches!(name.as_str(), "self" | "static" | "parent" | "$this"))
+                || !narrowing::resolve_narrowing_target(element, ctx).is_empty()
+        }
+        TypeKind::Generic(generic) => {
+            if matches!(
+                generic.name.as_str(),
+                "object" | "callable" | "callable-object" | "iterable"
+            ) {
+                return false;
+            }
+            (element.is_scalar()
+                && !matches!(
+                    generic.name.as_str(),
+                    "self" | "static" | "parent" | "$this"
+                ))
+                || !narrowing::resolve_narrowing_target(element, ctx).is_empty()
+        }
+        TypeKind::StaticType(_) | TypeKind::ThisType(_) => {
+            !narrowing::resolve_narrowing_target(element, ctx).is_empty()
+        }
+        // Shapes and callable signatures describe objects without naming
+        // their runtime classes. Other unevaluated types may do so too.
+        TypeKind::ObjectShape(_)
+        | TypeKind::Callable(_)
+        | TypeKind::ValueOf(_)
+        | TypeKind::Conditional(_)
+        | TypeKind::IndexAccess(_, _)
+        | TypeKind::Raw(_) => false,
+        _ => element.is_scalar(),
+    }
+}

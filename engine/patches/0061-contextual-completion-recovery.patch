+#[tokio::test]
+async fn completion_member_eof_recovers_self_static_and_parent_visibility() {
+    for subject in ["self", "static", "parent"] {
+        for suffix in ["", "\n"] {
+            let backend = create_test_backend();
+            let uri = Url::parse("file:///eof-static-visibility.php").unwrap();
+            let declarations = concat!(
+                "<?php\nnamespace EofStaticVisibility;\n",
+                "class BaseBox {\n",
+                "public static string $shared='';\n",
+                "protected static string $protectedStatic='';\n",
+                "private static string $parentPrivate='';\n",
+                "public static function visibleAction(): void {}\n",
+                "protected static function protectedAction(): void {}\n",
+                "private static function parentPrivateAction(): void {}\n",
+                "}\n",
+            );
+            // Box is intentionally nonfinal: existing final-class static::
+            // suppression remains a separate established policy.
+            let incomplete = format!(
+                "{declarations}class Box extends BaseBox {{\nprivate static string $ownSecret='';\nprivate static function ownHidden(): void {{}}\npublic static function run(): void {{ $note='café 🐘'; {subject}::<caret>{suffix}"
+            );
+            let labels = eof_member_labels(&backend, &uri, &incomplete, 1).await;
+            for expected in [
+                "shared",
+                "protectedStatic",
+                "visibleAction",
+                "protectedAction",
+            ] {
+                assert!(
+                    labels.iter().any(|l| l == expected),
+                    "{subject} {suffix:?} missing {expected}: {labels:?}"
+                );
+            }
+            if subject != "parent" {
+                for expected in ["ownSecret", "ownHidden"] {
+                    assert!(
+                        labels.iter().any(|l| l == expected),
+                        "{subject} missing own private {expected}: {labels:?}"
+                    );
+                }
+            } else {
+                for excluded in ["ownSecret", "ownHidden"] {
+                    assert!(
+                        !labels.iter().any(|l| l == excluded),
+                        "parent:: cannot select child member {excluded}: {labels:?}"
+                    );
+                }
+            }
+            for excluded in ["parentPrivate", "parentPrivateAction"] {
+                assert!(
+                    !labels.iter().any(|l| l == excluded),
+                    "{subject} leaked ancestor private {excluded}: {labels:?}"
+                );
+            }
+            // Same document after update: a repaired lexical scope must not
+            // grant its private/protected access to external class completion.
+            let external = format!(
+                "{declarations}class Box extends BaseBox {{ private static string $ownSecret=''; private static function ownHidden(): void {{}} }}\nBox::<caret>;"
+            );
+            let labels = eof_member_labels(&backend, &uri, &external, 2).await;
+            for expected in ["shared", "visibleAction"] {
+                assert!(
+                    labels.iter().any(|l| l == expected),
+                    "external lost {expected}: {labels:?}"
+                );
+            }
+            for excluded in [
+                "ownSecret",
+                "ownHidden",
+                "protectedStatic",
+                "protectedAction",
+                "parentPrivate",
+                "parentPrivateAction",
+            ] {
+                assert!(
+                    !labels.iter().any(|l| l == excluded),
+                    "external leaked {excluded}: {labels:?}"
+                );
+            }
+        }
+    }
+}

+async fn completion_member_eof_final_static_suppression_control() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///eof-final-static.php").unwrap();
+    // Complete source proves the established final-class policy independently
+    // of whether an unfinished class was recovered.
+    let complete = "<?php\nnamespace EofFinal;\nfinal class Box { public static function visibleAction(): void {} public static function run(): void {static::<caret>;} }";
+    let labels = eof_member_labels(&backend, &uri, complete, 1).await;
+    assert!(
+        !labels.iter().any(|l| l == "visibleAction"),
+        "final static:: suppression changed: {labels:?}"

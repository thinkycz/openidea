+    let incomplete = "<?php\nnamespace EofFinal;\nfinal class Box { public static function visibleAction(): void {} public static function run(): void {static::<caret>";
+    let labels = eof_member_labels(&backend, &uri, incomplete, 2).await;
+    assert!(
+        !labels.iter().any(|l| l == "visibleAction"),
+        "recovery bypassed final static:: suppression: {labels:?}"
+    );
+}

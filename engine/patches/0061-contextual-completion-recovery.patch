+    /// Repair missing enclosing bodies for a member query at EOF. Original
+    /// bytes and declaration offsets before the caret remain unchanged.
+    pub(super) fn patch_member_scope_at_eof(content: &str, position: Position) -> Option<String> {
+        use mago_syntax::{lexer::Lexer, settings::LexerSettings, token::TokenKind};
+        use mago_syntax_core::input::Input;
+
+        if content.len() > u32::MAX as usize {
+            return None;
+        }
+        let offset = crate::text_position::position_to_offset(content, position) as usize;
+        let suffix = content.get(offset..)?;
+        let has_semicolon = suffix.trim() == ";";
+        if !suffix.trim().is_empty() && !has_semicolon {
+            return None;
+        }
+        let bytes = content.as_bytes();
+        let member_start = crate::text_scan::scan_ident_backward(bytes, offset);
+        if member_start < 2
+            || !matches!(
+                bytes.get(member_start - 2..member_start),
+                Some(b"->" | b"::")
+            )
+        {
+            return None;
+        }
+
+        #[derive(Clone, Copy)]
+        enum Frame {
+            Delimiter(TokenKind),
+            Quote(TokenKind),
+            Document,
+        }
+        let input = Input::new(
+            mago_database::file::FileId::new(b"completion-eof.php"),
+            bytes,
+        );
+        let mut lexer = if content.contains("<?") {
+            Lexer::new(input, LexerSettings::default())
+        } else {
+            Lexer::scripting(input, LexerSettings::default())
+        };
+        let mut frames = Vec::new();
+        while let Some(token) = lexer.advance() {
+            let kind = token.ok()?.kind;
+            if kind == TokenKind::PartialLiteralString {
+                return None;
+            }
+            if matches!(frames.last(), Some(Frame::Document)) {
+                match kind {
+                    TokenKind::DocumentStart(_) => {
+                        if frames.len() >= 512 {
+                            return None;
+                        }
+                        frames.push(Frame::Document);
+                    }
+                    TokenKind::DocumentEnd => {
+                        frames.pop();
+                    }
+                    _ => {}
+                }
+                continue;
+            }
+            if let Some(Frame::Quote(delimiter)) = frames.last().copied() {
+                match kind {
+                    TokenKind::LeftBrace | TokenKind::DollarLeftBrace => {
+                        frames.push(Frame::Delimiter(TokenKind::RightBrace));
+                    }
+                    _ if kind == delimiter => {
+                        frames.pop();
+                    }
+                    _ => {}
+                }
+            } else {
+                match kind {
+                    TokenKind::DocumentStart(_) => frames.push(Frame::Document),
+                    TokenKind::DoubleQuote | TokenKind::Backtick => frames.push(Frame::Quote(kind)),
+                    TokenKind::LeftBrace | TokenKind::DollarLeftBrace => {
+                        frames.push(Frame::Delimiter(TokenKind::RightBrace));
+                    }
+                    TokenKind::LeftParenthesis => {
+                        frames.push(Frame::Delimiter(TokenKind::RightParenthesis))
+                    }
+                    TokenKind::LeftBracket | TokenKind::HashLeftBracket => {
+                        frames.push(Frame::Delimiter(TokenKind::RightBracket));
+                    }
+                    TokenKind::RightBrace
+                    | TokenKind::RightParenthesis
+                    | TokenKind::RightBracket
+                        if !matches!(frames.pop(), Some(Frame::Delimiter(close)) if close == kind) =>
+                    {
+                        return None;
+                    }
+                    _ => {}
+                }
+            }
+            if frames.len() > 512 {
+                return None;
+            }
+        }
+        // Do not manufacture quotes, document labels, argument lists or indexes.
+        if frames.is_empty()
+            || frames
+                .iter()
+                .any(|frame| !matches!(frame, Frame::Delimiter(TokenKind::RightBrace)))
+        {
+            return None;
+        }
+        let mut patched = String::with_capacity(content.len() + frames.len() + 7);
+        patched.push_str(&content[..offset]);
+        if member_start == offset {
+            patched.push_str("_x");
+        }
+        patched.push_str(suffix);
+        patched.push('\n');
+        if !has_semicolon {
+            patched.push(';');
+        }
+        for _ in frames {
+            patched.push('}');
+        }
+        Some(patched)
+    }

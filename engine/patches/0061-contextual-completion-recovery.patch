+        "if (!in_array($value, $items, true)) { return; }\n        $value->"
+    } else {
+        "if (in_array($value, $items, true)) {\n            $value->\n        }"
+    };
+    let source = format!(
+        "<?php\nclass BoundFirst {{ public string $firstProperty; public function firstMethod(): void {{}} }}\nclass BoundSecond {{ public string $secondProperty; public function secondMethod(): void {{}} }}\nclass BoundService {{\n    /**\n     * @param BoundFirst|BoundSecond|string $value\n     * @param list<{element}> $items\n     */\n    public function inspect($value, array $items): void {{\n        {branch}\n    }}\n}}\n"
+    );
+    crate::common::open_php(&backend, &uri, &source).await;
+    let (line, character) = crate::common::line_char_of(&source, "$value->");
+    crate::common::complete_at_opened(&backend, &uri, line, character + 8)
+        .await
+        .into_iter()
+        .map(|item| item.filter_text.unwrap_or(item.label))
+        .collect()

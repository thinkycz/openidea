+
+const CAPTURED_FORMAT_SOURCE: &str = "<?php\nfunction changed() { $text = \"hello\"; return (new Example())->run(); }\n\n// unchanged café 🐘\nfunction untouched(): string\n{\n    return 'keep';\n}\n";
+const CAPTURED_FORMAT_PHP83: &str = "<?php\n\nfunction changed()\n{\n    $text = 'hello';\n    return ( new Example() )->run();\n}\n\n// unchanged café 🐘\nfunction untouched(): string\n{\n    return 'keep';\n}\n";
+const CAPTURED_FORMAT_PHP84: &str = "<?php\n\nfunction changed()\n{\n    $text = 'hello';\n    return new Example()->run();\n}\n\n// unchanged café 🐘\nfunction untouched(): string\n{\n    return 'keep';\n}\n";
+
+fn apply_computed_format_edits(original: &str, edits: &[tower_lsp::lsp_types::TextEdit]) -> String {
+    let mut result = original.to_string();
+    for edit in edits.iter().rev() {
+        let start = crate::text_position::position_to_byte_offset(original, edit.range.start);
+        let end = crate::text_position::position_to_byte_offset(original, edit.range.end);
+        result.replace_range(start..end, &edit.new_text);
+    }
+    result
+}
+
+#[test]
+fn compute_edits_captured_mago_output_excludes_unchanged_function() {
+    use tower_lsp::lsp_types::{Position, Range};
+    // Actual captured PHP 8.3/8.4 Mago output; CRLF variants test edit
+    // encoding without asserting that Mago itself preserves line endings.
+    for output in [CAPTURED_FORMAT_PHP83, CAPTURED_FORMAT_PHP84] {
+        for crlf in [false, true] {
+            let original = if crlf {
+                CAPTURED_FORMAT_SOURCE.replace('\n', "\r\n")
+            } else {
+                CAPTURED_FORMAT_SOURCE.to_string()
+            };
+            let formatted = if crlf {
+                output.replace('\n', "\r\n")
+            } else {
+                output.to_string()
+            };
+            let edits = compute_edits(&original, &formatted);
+            assert_eq!(edits.len(), 1);
+            assert_eq!(
+                edits[0].range,
+                Range::new(Position::new(1, 0), Position::new(1, 69))
+            );
+            assert!(!edits[0].new_text.contains("untouched"));
+            assert!(!edits[0].new_text.contains("unchanged café 🐘"));
+            assert_eq!(apply_computed_format_edits(&original, &edits), formatted);
+        }
+    }
+}
+
+#[test]
+fn compute_edits_unicode_boundaries_have_exact_utf16_columns() {
+    use tower_lsp::lsp_types::{Position, Range};
+    let original = "<?php\r\n$text = 'café 🐘'; $count=1;\r\n\r\nfunction untouched(): string { return 'keep'; }\r\n";
+    let cases = [
+        (original.replace("$count=1", "$count = 1"), 25, 26, " = "),
+        (original.replace("café", "cafè"), 12, 13, "è"),
+        (original.replace('🐘', "🐈"), 14, 16, "🐈"),
+    ];
+    for (formatted, start, end, replacement) in cases {
+        let edits = compute_edits(original, &formatted);
+        assert_eq!(edits.len(), 1);
+        assert_eq!(
+            edits[0].range,
+            Range::new(Position::new(1, start), Position::new(1, end))
+        );
+        assert_eq!(edits[0].new_text, replacement);
+        assert_eq!(apply_computed_format_edits(original, &edits), formatted);
+    }
+}
+
+#[test]
+fn compute_edits_does_not_split_crlf_when_line_ending_changes() {
+    use tower_lsp::lsp_types::{Position, Range};
+    let original = "A\r\nB";
+    let formatted = "A\nB";
+    let edits = compute_edits(original, formatted);
+    assert_eq!(edits.len(), 1);
+    assert_eq!(
+        edits[0].range,
+        Range::new(Position::new(0, 1), Position::new(1, 0))
+    );
+    assert_eq!(edits[0].new_text, "\n");
+    assert_eq!(apply_computed_format_edits(original, &edits), formatted);
+}

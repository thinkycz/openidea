+/// computed. Edges are Unicode scalar boundaries and never split CRLF pairs.
 pub(crate) fn compute_edits(original: &str, formatted: &str) -> Vec<TextEdit> {
     if original == formatted {
         return Vec::new();
     }
 
+    let mut prefix: usize = original
+        .chars()
+        .zip(formatted.chars())
+        .take_while(|(a, b)| a == b)
+        .map(|(ch, _)| ch.len_utf8())
+        .sum();
+    let suffix: usize = original[prefix..]
+        .chars()
+        .rev()
+        .zip(formatted[prefix..].chars().rev())
+        .take_while(|(a, b)| a == b)
+        .map(|(ch, _)| ch.len_utf8())
+        .sum();
+    let mut original_end = original.len() - suffix;
+    let mut formatted_end = formatted.len() - suffix;
+    let splits_crlf = |text: &str, offset: usize| {
+        offset > 0
+            && text.as_bytes()[offset - 1] == b'\r'
+            && text.as_bytes().get(offset) == Some(&b'\n')
+    };
+    if splits_crlf(original, prefix) || splits_crlf(formatted, prefix) {
+        prefix -= 1;
+    }
+    if splits_crlf(original, original_end) || splits_crlf(formatted, formatted_end) {
+        original_end += 1;
+        formatted_end += 1;
+    }

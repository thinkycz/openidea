@@ -0,0 +1,149 @@
+use super::compute_edits;
+use std::ops::Range;
+use tower_lsp::lsp_types::TextEdit;
+
+fn checked_edits(before: &str, after: &str) -> Vec<TextEdit> {
+    let edits = compute_edits(before, after).unwrap();
+    let mut previous_end = 0;
+    for edit in &edits {
+        let start = crate::text_position::position_to_byte_offset(before, edit.range.start);
+        let end = crate::text_position::position_to_byte_offset(before, edit.range.end);
+        assert!(start >= previous_end && start <= end && end <= before.len());
+        assert!(before.is_char_boundary(start) && before.is_char_boundary(end));
+        assert_eq!(
+            crate::text_position::offset_to_position(before, start),
+            edit.range.start
+        );
+        assert_eq!(
+            crate::text_position::offset_to_position(before, end),
+            edit.range.end
+        );
+        for boundary in [start, end] {
+            assert!(
+                !(boundary > 0
+                    && before.as_bytes()[boundary - 1] == b'\r'
+                    && before.as_bytes().get(boundary) == Some(&b'\n')),
+                "LSP endpoint splits CRLF"
+            );
+        }
+        previous_end = end;
+    }
+    assert_eq!(
+        crate::text_position::apply_text_edits(before, &edits),
+        after
+    );
+    edits
+}
+
+fn assert_island_untouched(before: &str, edits: &[TextEdit], island: Range<usize>) {
+    for edit in edits {
+        let start = crate::text_position::position_to_byte_offset(before, edit.range.start);
+        let end = crate::text_position::position_to_byte_offset(before, edit.range.end);
+        assert!(
+            !(start < island.end && end > island.start)
+                && !(start == end && start > island.start && start < island.end),
+            "unchanged island {island:?} was replaced/inserted into: {edit:?}"
+        );
+    }
+}
+
+fn island(before: &str, text: &str) -> Range<usize> {
+    let start = before.find(text).expect("fixture island exists");
+    start..start + text.len()
+}
+
+// Exact source and actual Mago PHP8.3 output retained in .66
+// work/php-format-acceptance/middle-island-report.json.
+const CAPTURED_BEFORE: &str = "<?php\nfunction changed() { $text = \"hello\"; return (new Example())->run(); }\n\n// unchanged café 🐘\nfunction untouched(): string\n{\n    return 'keep';\n}\n\nfunction changedAfter() { return \"later\"; }\n";
+const CAPTURED_AFTER: &str = "<?php\n\nfunction changed()\n{\n    $text = 'hello';\n    return ( new Example() )->run();\n}\n\n// unchanged café 🐘\nfunction untouched(): string\n{\n    return 'keep';\n}\n\nfunction changedAfter()\n{\n    return 'later';\n}\n";
+const MIDDLE: &str =
+    "// unchanged café 🐘\nfunction untouched(): string\n{\n    return 'keep';\n}\n";
+
+#[test]
+fn format_hunks_actual_mago_keeps_unchanged_middle_function() {
+    for crlf in [false, true] {
+        let (before, after, middle) = if crlf {
+            (
+                CAPTURED_BEFORE.replace('\n', "\r\n"),
+                CAPTURED_AFTER.replace('\n', "\r\n"),
+                MIDDLE.replace('\n', "\r\n"),
+            )
+        } else {
+            (CAPTURED_BEFORE.into(), CAPTURED_AFTER.into(), MIDDLE.into())
+        };
+        let edits = checked_edits(&before, &after);
+        assert!(
+            edits.len() >= 2,
+            "separate changed regions need separate edits"
+        );
+        assert_island_untouched(&before, &edits, island(&before, &middle));
+    }
+}
+
+#[test]
+fn format_hunks_duplicate_lines_do_not_swallow_middle_run() {
+    for ending in ["\n", "\r\n"] {
+        let before = "<?php\n$a=\"a\";\necho 'same';\necho 'same';\necho 'same';\n$b=\"b\";\n"
+            .replace('\n', ending);
+        let after = "<?php\n$a = 'a';\necho 'same';\necho 'same';\necho 'same';\n$b = 'b';\n"
+            .replace('\n', ending);
+        let middle = "echo 'same';\necho 'same';\necho 'same';\n".replace('\n', ending);
+        let edits = checked_edits(&before, &after);
+        assert_island_untouched(&before, &edits, island(&before, &middle));
+    }
+}
+
+#[test]
+fn format_hunks_same_line_unicode_island_has_live_original_anchors() {
+    let before = "<?php\r\n$a=\"a\"; /* stable café 🐘 e\u{301} */ $b=\"b\";\r\n";
+    let after = "<?php\r\n$a = 'a'; /* stable café 🐘 e\u{301} */ $b = 'b';\r\n";
+    let edits = checked_edits(before, after);
+    assert_island_untouched(
+        before,
+        &edits,
+        island(before, "/* stable café 🐘 e\u{301} */"),
+    );
+}
+
+#[test]
+fn format_hunks_separate_insert_delete_preserve_internal_island() {
+    for (before, after, stable) in [
+        (
+            "A\nKEEP café 🐘\nB\n",
+            "A\ninserted\nKEEP café 🐘\nB\ninserted-end\n",
+            "KEEP café 🐘\n",
+        ),
+        (
+            "remove\nA\nKEEP café 🐘\nB\nremove-end\n",
+            "A\nKEEP café 🐘\nB\n",
+            "KEEP café 🐘\n",
+        ),
+        (
+            "remove\r\nKEEP café 🐘\r\nB",
+            "KEEP café 🐘\r\nB\r\ninsert",
+            "KEEP café 🐘\r\n",
+        ),
+    ] {
+        let edits = checked_edits(before, after);
+        assert_island_untouched(before, &edits, island(before, stable));
+    }
+}
+
+#[test]
+fn format_hunks_empty_identity_eof_and_line_ending_controls() {
+    for (before, after) in [
+        ("", ""),
+        ("", "🐘\r\n"),
+        ("café 🐘\r\n", ""),
+        ("same", "same"),
+        ("same", "same\n"),
+        ("same\r\n", "same"),
+        ("A\r\nB", "A\nB"),
+        ("A\nB", "A\r\nB"),
+    ] {
+        let edits = checked_edits(before, after);
+        if before == after {
+            assert!(edits.is_empty());
+        }
+    }
+}

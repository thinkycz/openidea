+//! Bounded scalar alignment for formatting, retaining equal source islands.
+use similar::algorithms::{Algorithm, DiffHook, Replace, diff_slices_deadline};
+use std::time::{Duration, Instant};
+use tower_lsp::lsp_types::{Range, TextEdit};
+
+const BUDGET_ERROR: &str = "Formatting could not produce edits within the document work limit. Your source was not changed. Retry or use Save Without Formatting.";
+const CRLF: u32 = 0x11_0000;
+
+#[derive(Clone, Copy)]
+struct Limits {
+    original_bytes: usize,
+    formatted_bytes: usize,
+    tokens: usize,
+    edits: usize,
+    deadline: Instant,
+}
+impl Limits {
+    fn standard() -> Self {
+        Self {
+            original_bytes: 8 * 1024 * 1024,
+            formatted_bytes: 16 * 1024 * 1024,
+            tokens: 2_000_000,
+            edits: 10_000,
+            deadline: Instant::now() + Duration::from_secs(1),
+        }
+    }
+    fn check(self) -> Result<(), String> {
+        if Instant::now() >= self.deadline {
+            Err(BUDGET_ERROR.into())
+        } else {
+            Ok(())
+        }
+    }
+}
+
+struct Tokens {
+    values: Vec<u32>,
+    offsets: Vec<usize>,
+}
+fn tokenize(
+    source: &str,
+    base: usize,
+    remaining: &mut usize,
+    limits: Limits,
+) -> Result<Tokens, String> {
+    let mut values = Vec::new();
+    let mut offsets = Vec::new();
+    let mut chars = source.char_indices().peekable();
+    while let Some((offset, ch)) = chars.next() {
+        if *remaining == 0 {
+            return Err(BUDGET_ERROR.into());
+        }
+        *remaining -= 1;
+        if values.len() % 1024 == 0 {
+            limits.check()?;
+        }
+        offsets.push(base + offset);
+        let value = if ch == '\r' && chars.peek().is_some_and(|(_, ch)| *ch == '\n') {
+            chars.next();
+            CRLF
+        } else {
+            ch as u32
+        };
+        values.push(value);
+    }
+    offsets.push(base + source.len());
+    Ok(Tokens { values, offsets })
+}
+
+#[derive(Debug)]
+struct ByteEdit {
+    old_start: usize,
+    old_end: usize,
+    new_start: usize,
+    new_end: usize,
+}
+struct Edits<'a> {
+    old: &'a [usize],
+    new: &'a [usize],
+    spans: Vec<ByteEdit>,
+    limits: Limits,
+}
+impl Edits<'_> {
+    fn change(
+        &mut self,
+        old: usize,
+        old_len: usize,
+        new: usize,
+        new_len: usize,
+    ) -> Result<(), String> {
+        self.limits.check()?;
+        if self.spans.len() == self.limits.edits {
+            return Err(BUDGET_ERROR.into());
+        }
+        self.spans.push(ByteEdit {
+            old_start: self.old[old],
+            old_end: self.old[old + old_len],
+            new_start: self.new[new],
+            new_end: self.new[new + new_len],
+        });
+        Ok(())
+    }
+}
+impl DiffHook for Edits<'_> {
+    type Error = String;
+    fn equal(&mut self, _: usize, _: usize, _: usize) -> Result<(), String> {
+        self.limits.check()
+    }
+    fn delete(&mut self, old: usize, len: usize, new: usize) -> Result<(), String> {
+        self.change(old, len, new, 0)
+    }
+    fn insert(&mut self, old: usize, new: usize, len: usize) -> Result<(), String> {
+        self.change(old, 0, new, len)
+    }
+    fn replace(
+        &mut self,
+        old: usize,
+        old_len: usize,
+        new: usize,
+        new_len: usize,
+    ) -> Result<(), String> {
+        self.change(old, old_len, new, new_len)
+    }
+}
+
+fn splits_crlf(text: &str, offset: usize) -> bool {
+    offset > 0
+        && text.as_bytes()[offset - 1] == b'\r'
+        && text.as_bytes().get(offset) == Some(&b'\n')
+}
+fn changed_window(old: &str, new: &str) -> (usize, usize, usize) {
+    let mut start: usize = old
+        .chars()
+        .zip(new.chars())
+        .take_while(|(a, b)| a == b)
+        .map(|(ch, _)| ch.len_utf8())
+        .sum();
+    let suffix: usize = old[start..]
+        .chars()
+        .rev()
+        .zip(new[start..].chars().rev())
+        .take_while(|(a, b)| a == b)
+        .map(|(ch, _)| ch.len_utf8())
+        .sum();
+    let (mut old_end, mut new_end) = (old.len() - suffix, new.len() - suffix);
+    if splits_crlf(old, start) || splits_crlf(new, start) {
+        start -= 1;
+    }
+    if splits_crlf(old, old_end) || splits_crlf(new, new_end) {
+        old_end += 1;
+        new_end += 1;
+    }
+    (start, old_end, new_end)
+}
+
+pub(super) fn compute(original: &str, formatted: &str) -> Result<Vec<TextEdit>, String> {
+    compute_bounded(original, formatted, Limits::standard())
+}
+fn compute_bounded(
+    original: &str,
+    formatted: &str,
+    limits: Limits,
+) -> Result<Vec<TextEdit>, String> {
+    limits.check()?;
+    if original.len() > limits.original_bytes || formatted.len() > limits.formatted_bytes {
+        return Err(BUDGET_ERROR.into());
+    }
+    if original == formatted {
+        return Ok(Vec::new());
+    }
+    let (start, old_end, new_end) = changed_window(original, formatted);
+    let mut remaining = limits.tokens;
+    let old = tokenize(&original[start..old_end], start, &mut remaining, limits)?;
+    let new = tokenize(&formatted[start..new_end], start, &mut remaining, limits)?;
+    let mut collected = Edits {
+        old: &old.offsets,
+        new: &new.offsets,
+        spans: Vec::new(),
+        limits,
+    };
+    // RawMyers does not use readability heuristics that can discard equal
+    // islands. The library's deadline fallback is NEVER published: our hook
+    // and final admission both reject any result after that deadline.
+    diff_slices_deadline(
+        Algorithm::RawMyers,
+        &mut Replace::new(&mut collected),
+        &old.values,
+        &new.values,
+        Some(limits.deadline),
+    )?;
+    limits.check()?;
+    let index = crate::text_position::LineIndex::new(original);
+    let mut result = Vec::with_capacity(collected.spans.len());
+    let (mut old_cursor, mut new_cursor) = (0, 0);
+    for span in collected.spans {
+        limits.check()?;
+        if span.old_start < old_cursor
+            || span.new_start < new_cursor
+            || original[old_cursor..span.old_start] != formatted[new_cursor..span.new_start]
+        {
+            return Err(
+                "Formatting produced inconsistent edit coordinates. Your source was not changed."
+                    .into(),
+            );
+        }
+        result.push(TextEdit {
+            range: Range::new(index.position(span.old_start), index.position(span.old_end)),
+            new_text: formatted[span.new_start..span.new_end].to_owned(),
+        });
+        old_cursor = span.old_end;
+        new_cursor = span.new_end;
+    }
+    if original[old_cursor..] != formatted[new_cursor..] {
+        return Err("Formatting omitted a source change. Your source was not changed.".into());
+    }
+    limits.check()?;
+    Ok(result)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn limits() -> Limits {
+        Limits {
+            deadline: Instant::now() + Duration::from_secs(5),
+            ..Limits::standard()
+        }
+    }
+    #[test]
+    fn budget_refusals_never_publish_a_partial_or_hull_edit() {
+        let cases = [
+            Limits {
+                original_bytes: 1,
+                ..limits()
+            },
+            Limits {
+                formatted_bytes: 1,
+                ..limits()
+            },
+            Limits {
+                tokens: 1,
+                ..limits()
+            },
+            Limits {
+                edits: 1,
+                ..limits()
+            },
+            Limits {
+                deadline: Instant::now() - Duration::from_secs(1),
+                ..limits()
+            },
+        ];
+        for limit in cases {
+            assert!(compute_bounded("aXbYc", "aZbWc", limit).is_err());
+        }
+        assert!(compute_bounded("aXbYc", "aZbWc", limits()).is_ok());
+    }
+    #[test]
+    fn raw_diff_matches_small_lcs_oracle_and_reconstructs_all_inputs() {
+        let alphabet = ['a', 'b', '🐘', '\r', '\n'];
+        let mut strings = vec![String::new()];
+        for a in alphabet {
+            strings.push(a.to_string());
+            for b in alphabet {
+                strings.push(format!("{a}{b}"));
+            }
+        }
+        fn token_values(s: &str) -> Vec<u32> {
+            tokenize(s, 0, &mut 100, limits()).unwrap().values
+        }
+        for old in &strings {
+            for new in &strings {
+                let edits = compute_bounded(old, new, limits()).unwrap();
+                assert_eq!(crate::text_position::apply_text_edits(old, &edits), *new);
+                let a = token_values(old);
+                let b = token_values(new);
+                let mut table = vec![vec![0; b.len() + 1]; a.len() + 1];
+                for i in 0..a.len() {
+                    for j in 0..b.len() {
+                        table[i + 1][j + 1] = if a[i] == b[j] {
+                            table[i][j] + 1
+                        } else {
+                            table[i][j + 1].max(table[i + 1][j])
+                        };
+                    }
+                }
+                let expected = a.len() + b.len() - 2 * table[a.len()][b.len()];
+                let actual: usize = edits
+                    .iter()
+                    .map(|e| {
+                        let start =
+                            crate::text_position::position_to_byte_offset(old, e.range.start);
+                        let end = crate::text_position::position_to_byte_offset(old, e.range.end);
+                        token_values(&old[start..end]).len() + token_values(&e.new_text).len()
+                    })
+                    .sum();
+                assert_eq!(actual, expected, "{old:?} → {new:?}");
+            }
+        }
+    }
+    #[test]
+    fn expired_raw_myers_fallback_is_refused_by_actual_edit_collector() {
+        use similar::{DiffOp, algorithms::Capture};
+        let original = vec![b'a' as u32; 128];
+        let formatted = vec![b'b' as u32; 128];
+        let expired = Instant::now() - Duration::from_secs(1);
+
+        // Control: the actual library does NOT signal deadline exhaustion as an
+        // error. With nonempty/dissimilar inputs and this expired deadline its
+        // raw search emits a delete/insert approximation, merged into Replace.
+        let mut capture = Capture::new();
+        diff_slices_deadline(
+            Algorithm::RawMyers,
+            &mut Replace::new(&mut capture),
+            &original,
+            &formatted,
+            Some(expired),
+        )
+        .expect("library fallback itself is successful");
+        let operations = capture.into_ops();
+        assert!(
+            matches!(
+                operations.as_slice(),
+                [DiffOp::Replace {
+                    old_index: 0,
+                    old_len: 128,
+                    new_index: 0,
+                    new_len: 128,
+                }]
+            ),
+            "control must actually exercise fallback replacement: {operations:?}"
+        );
+
+        // Production collector: skip compute_bounded's entry check so this test
+        // reaches precisely the library fallback -> hook admission boundary.
+        let offsets: Vec<usize> = (0..=128).collect();
+        let mut collected = Edits {
+            old: &offsets,
+            new: &offsets,
+            spans: Vec::new(),
+            limits: Limits {
+                deadline: expired,
+                ..limits()
+            },
+        };
+        let result = diff_slices_deadline(
+            Algorithm::RawMyers,
+            &mut Replace::new(&mut collected),
+            &original,
+            &formatted,
+            Some(expired),
+        );
+        assert_eq!(result, Err(BUDGET_ERROR.to_owned()));
+        assert!(
+            collected.spans.is_empty(),
+            "expired fallback must not record a publishable hull"
+        );
+
+        // Live-deadline control proves the actual collector is usable for the
+        // same inputs; refusal is specifically the expired ownership budget.
+        let live = limits();
+        let mut allowed = Edits {
+            old: &offsets,
+            new: &offsets,
+            spans: Vec::new(),
+            limits: live,
+        };
+        diff_slices_deadline(
+            Algorithm::RawMyers,
+            &mut Replace::new(&mut allowed),
+            &original,
+            &formatted,
+            Some(live.deadline),
+        )
+        .expect("same bounded input is admitted with a live deadline");
+        assert_eq!(allowed.spans.len(), 1);
+        let edit = &allowed.spans[0];
+        assert_eq!(
+            (edit.old_start, edit.old_end, edit.new_start, edit.new_end),
+            (0, 128, 0, 128)
+        );
+    }
+}

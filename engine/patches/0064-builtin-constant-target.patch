+    crate::common::open_php(backend, &canonical, VIEWER_OVERRIDE_CLIENT).await;
+}
+
+fn viewer_override_position(source: &str, marker: &str) -> tower_lsp::lsp_types::Position {
+    let prefix = &source[..source.find(marker).expect("fixture declaration marker")];
+    tower_lsp::lsp_types::Position::new(
+        prefix.bytes().filter(|byte| *byte == b'\n').count() as u32,
+        prefix.rsplit('\n').next().unwrap().encode_utf16().count() as u32,
+    )
+}
+
+async fn viewer_override_query(
+    backend: &Backend,
+    source: &str,
+    character: u32,
+) -> Vec<tower_lsp::lsp_types::Location> {
+    let query = Url::parse("file:///viewer-override-definition-query.php").unwrap();
+    crate::common::open_php(backend, &query, source).await;
+    match crate::common::goto_definition_at(backend, &query, 1, character).await {
+        None => vec![],
+        Some(tower_lsp::lsp_types::GotoDefinitionResponse::Scalar(location)) => vec![location],
+        Some(tower_lsp::lsp_types::GotoDefinitionResponse::Array(locations)) => locations,
+        Some(tower_lsp::lsp_types::GotoDefinitionResponse::Link(links)) => links
+            .into_iter()
+            .map(|link| {
+                tower_lsp::lsp_types::Location::new(link.target_uri, link.target_selection_range)
+            })
+            .collect(),
+    }
+}

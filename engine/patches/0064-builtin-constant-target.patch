+//! A global builtin constant must not publish unavailable sibling declarations.
+use crate::common::{complete_at, goto_definition_at, hover_text_at, open_php};
+use phpantom_lsp::{Backend, types::PhpVersion};
+use std::collections::HashMap;
+use tower_lsp::LanguageServer;
+use tower_lsp::lsp_types::*;
+
+const SIBLING_STUB: &str = r#"<?php
+const GLOBAL_SIBLING_SENTINEL = 37;
+function siblingLegacyFunction(): string { return 'legacy'; }
+/** @since 8.2 */
+function siblingFutureFunction(): string { return 'future'; }
+class SiblingLegacyClass {}
+/** @since 8.2 */
+class SiblingFutureClass {}
+interface SiblingLegacyInterface {}
+/** @since 8.2 */ interface SiblingFutureInterface {}
+trait SiblingLegacyTrait {}
+/** @since 8.2 */ trait SiblingFutureTrait {}
+enum SiblingLegacyEnum { case One; }
+/** @since 8.2 */ enum SiblingFutureEnum { case One; }
+"#;
+
+fn sibling_backend(minor: u8) -> Backend {
+    let backend = Backend::new_test_with_all_stubs(
+        HashMap::from([
+            ("SiblingLegacyClass", SIBLING_STUB),
+            ("SiblingFutureClass", SIBLING_STUB),
+            ("SiblingLegacyInterface", SIBLING_STUB),
+            ("SiblingFutureInterface", SIBLING_STUB),
+            ("SiblingLegacyTrait", SIBLING_STUB),
+            ("SiblingFutureTrait", SIBLING_STUB),
+            ("SiblingLegacyEnum", SIBLING_STUB),
+            ("SiblingFutureEnum", SIBLING_STUB),
+        ]),
+        HashMap::from([
+            ("siblingLegacyFunction", SIBLING_STUB),
+            ("siblingFutureFunction", SIBLING_STUB),
+        ]),
+        HashMap::from([("GLOBAL_SIBLING_SENTINEL", SIBLING_STUB)]),
+    );
+    backend.set_php_version(PhpVersion::new(8, minor));
+    backend
+}
+
+async fn load_sibling_global_first(backend: &Backend) {
+    let uri = Url::parse("file:///global-sibling-sentinel.php").unwrap();
+    open_php(backend, &uri, "<?php\nGLOBAL_SIBLING_SENTINEL;\n").await;
+    let hover = hover_text_at(backend, &uri, 1, 1)
+        .await
+        .expect("global sentinel must resolve through its stub index");
+    assert!(hover.contains("37"), "{hover}");
+}
+
+async fn sibling_items(backend: &Backend, source: &str) -> Vec<CompletionItem> {
+    complete_at(
+        backend,
+        &Url::parse("file:///sibling-completion.php").unwrap(),
+        source,
+        1,
+        source.lines().last().unwrap().len() as u32,
+    )
+    .await
+}
+
+fn sibling_named<'a>(items: &'a [CompletionItem], name: &str) -> Option<&'a CompletionItem> {
+    items.iter().find(|item| {
+        item.filter_text
+            .as_deref()
+            .unwrap_or(item.label.split('(').next().unwrap())
+            == name
+    })
+}
+
+#[tokio::test]
+async fn stub_global_first_function_completion_respects_numeric_introduction() {
+    for minor in [1, 2] {
+        let backend = sibling_backend(minor);
+        // Startup index filtering is a control: only the global-constant load
+        // below should be able to reveal the bypass under investigation.
+        let index_control = sibling_backend(minor);
+        let before = sibling_items(&index_control, "<?php\nsibling").await;
+        assert!(sibling_named(&before, "siblingLegacyFunction").is_some());
+        assert_eq!(
+            sibling_named(&before, "siblingFutureFunction").is_some(),
+            minor >= 2
+        );
+        load_sibling_global_first(&backend).await;
+        let after = sibling_items(&backend, "<?php\nsibling").await;
+        assert!(sibling_named(&after, "siblingLegacyFunction").is_some());
+        assert_eq!(
+            sibling_named(&after, "siblingFutureFunction").is_some(),
+            minor >= 2,
+            "global-first function cache on 8.{minor}"
+        );
+    }
+}
+
+#[tokio::test]
+async fn stub_global_first_class_completion_respects_numeric_introduction() {
+    for minor in [1, 2] {
+        let backend = sibling_backend(minor);
+        let index_control = sibling_backend(minor);
+        let before = sibling_items(&index_control, "<?php\nnew Sibling").await;
+        assert!(sibling_named(&before, "SiblingLegacyClass").is_some());
+        assert_eq!(
+            sibling_named(&before, "SiblingFutureClass").is_some(),
+            minor >= 2
+        );
+        load_sibling_global_first(&backend).await;
+        let after = sibling_items(&backend, "<?php\nnew Sibling").await;
+        assert!(sibling_named(&after, "SiblingLegacyClass").is_some());
+        assert_eq!(
+            sibling_named(&after, "SiblingFutureClass").is_some(),
+            minor >= 2,
+            "global-first class cache on 8.{minor}"
+        );
+    }
+}
+
+#[tokio::test]
+async fn stub_global_first_future_siblings_cannot_resolve_under_older_target() {
+    let newer = sibling_backend(2);
+    let older = sibling_backend(1);
+    load_sibling_global_first(&newer).await;
+    load_sibling_global_first(&older).await;
+    for (source, name) in [
+        ("<?php\nsibling", "siblingFutureFunction"),
+        ("<?php\nnew Sibling", "SiblingFutureClass"),
+    ] {
+        let items = sibling_items(&newer, source).await;
+        let mut donor = sibling_named(&items, name)
+            .expect("8.2 provider positive control")
+            .clone();
+        donor.documentation = None;
+        donor.detail = None;
+        assert!(
+            newer
+                .completion_resolve(donor.clone())
+                .await
+                .unwrap()
+                .documentation
+                .is_some(),
+            "available sibling {name} must resolve"
+        );
+        assert!(
+            older
+                .completion_resolve(donor)
+                .await
+                .unwrap()
+                .documentation
+                .is_none(),
+            "global-first 8.1 must not resolve future sibling {name}"
+        );
+    }
+}
+
+fn navigation_count(response: Option<GotoDefinitionResponse>) -> usize {
+    match response {
+        None => 0,
+        Some(GotoDefinitionResponse::Scalar(_)) => 1,
+        Some(GotoDefinitionResponse::Array(items)) => items.len(),
+        Some(GotoDefinitionResponse::Link(items)) => items.len(),
+    }
+}
+
+#[tokio::test]
+async fn stub_global_first_sibling_navigation_respects_target() {
+    for minor in [1, 2] {
+        let backend = sibling_backend(minor);
+        load_sibling_global_first(&backend).await;
+        let uri = Url::parse("file:///sibling-navigation.php").unwrap();
+        for (source, character, future) in [
+            ("<?php\nsiblingLegacyFunction();\n", 1, false),
+            ("<?php\nsiblingFutureFunction();\n", 1, true),
+            ("<?php\nnew SiblingLegacyClass();\n", 5, false),
+            ("<?php\nnew SiblingFutureClass();\n", 5, true),
+        ] {
+            open_php(&backend, &uri, source).await;
+            let response = goto_definition_at(&backend, &uri, 1, character).await;
+            assert_eq!(
+                navigation_count(response) > 0,
+                !future || minor >= 2,
+                "{source} at 8.{minor}"
+            );
+        }
+    }
+}
+
+#[tokio::test]
+async fn stub_global_first_preserves_project_since_release_notes() {
+    let backend = sibling_backend(1);
+    let uri = Url::parse("file:///project-sibling-notes.php").unwrap();
+    open_php(&backend, &uri, "<?php\n/** @since 99.0 */\nfunction projectFutureFunction(): string { return 'project'; }\n/** @since 99.0 */\nclass ProjectFutureClass {}\n").await;
+    load_sibling_global_first(&backend).await;
+    for (source, name) in [
+        ("<?php\nprojectFuture", "projectFutureFunction"),
+        ("<?php\nnew ProjectFuture", "ProjectFutureClass"),
+    ] {
+        let items = sibling_items(&backend, source).await;
+        let mut item = sibling_named(&items, name)
+            .expect("project release note must not hide a declaration")
+            .clone();
+        item.documentation = None;
+        assert!(
+            backend
+                .completion_resolve(item)
+                .await
+                .unwrap()
+                .documentation
+                .is_some()
+        );
+    }
+    let query_uri = Url::parse("file:///project-sibling-navigation.php").unwrap();
+    for (source, character) in [
+        ("<?php\nprojectFutureFunction();\n", 1),
+        ("<?php\nnew ProjectFutureClass();\n", 5),
+    ] {
+        open_php(&backend, &query_uri, source).await;
+        assert!(navigation_count(goto_definition_at(&backend, &query_uri, 1, character).await) > 0);
+    }
+}
+
+#[tokio::test]
+async fn stub_global_first_classlike_imports_respect_numeric_introduction() {
+    for minor in [1, 2] {
+        let backend = sibling_backend(minor);
+        load_sibling_global_first(&backend).await;
+        let items = sibling_items(&backend, "<?php\nuse Sibling").await;
+        for kind in ["Class", "Interface", "Trait", "Enum"] {
+            let stable = format!("SiblingLegacy{kind}");
+            let future = format!("SiblingFuture{kind}");
+            assert!(
+                sibling_named(&items, &stable).is_some(),
+                "stable {kind} import missing on8.{minor}"
+            );
+            assert_eq!(
+                sibling_named(&items, &future).is_some(),
+                minor >= 2,
+                "future {kind} import on8.{minor}"
+            );
+        }
+    }
+}
+
+const FUNCTION_NAV_SHARED: &str = r#"<?php
+namespace { const FUNCTION_NAV_SENTINEL = 64023; }
+namespace FunctionBuiltin {
+    // café 🐘: preserve original declaration offsets in the immutable viewer.
+    function stable(): string { return 'canonical'; }
+    /** @since 8.2 */
+    function future(): string { return 'future'; }
+}
+"#;
+const FUNCTION_NAV_DIFFERENT: &str = r#"<?php
+namespace FunctionBuiltin;
+// Different actual source, deliberately different declaration coordinates.
+function stable(): string { return 'different'; }
+"#;
+
+fn function_nav_backend(minor: u8, stable_source: &'static str) -> Backend {
+    let backend = Backend::new_test_with_all_stubs(
+        HashMap::new(),
+        HashMap::from([
+            ("FunctionBuiltin\\stable", stable_source),
+            ("FunctionBuiltin\\future", FUNCTION_NAV_SHARED),
+        ]),
+        HashMap::from([("FUNCTION_NAV_SENTINEL", FUNCTION_NAV_SHARED)]),
+    );
+    backend.set_php_version(PhpVersion::new(8, minor));
+    backend
+}
+
+async fn function_nav_global_first(backend: &Backend) {
+    let uri = Url::parse("file:///function-navigation-sentinel.php").unwrap();
+    open_php(backend, &uri, "<?php\nFUNCTION_NAV_SENTINEL;\n").await;
+    let hover = hover_text_at(backend, &uri, 1, 2)
+        .await
+        .expect("trusted global loader control");
+    assert!(hover.contains("64023"), "{hover}");
+}
+
+async fn function_nav_locations(backend: &Backend, name: &str) -> Vec<Location> {
+    let uri = Url::parse("file:///function-navigation-query.php").unwrap();
+    let source = format!("<?php\n\\FunctionBuiltin\\{name}();\n");
+    open_php(backend, &uri, &source).await;
+    match goto_definition_at(backend, &uri, 1, 3).await {
+        None => vec![],
+        Some(GotoDefinitionResponse::Scalar(location)) => vec![location],
+        Some(GotoDefinitionResponse::Array(locations)) => locations,
+        Some(GotoDefinitionResponse::Link(links)) => links
+            .into_iter()
+            .map(|link| Location::new(link.target_uri, link.target_selection_range))
+            .collect(),
+    }
+}
+
+fn function_nav_expected_position(source: &str, name: &str) -> Position {
+    let marker = format!("function {name}");
+    let offset = source.find(&marker).unwrap() + "function ".len();
+    let prefix = &source[..offset];
+    Position::new(
+        prefix.bytes().filter(|byte| *byte == b'\n').count() as u32,
+        prefix.rsplit('\n').next().unwrap().encode_utf16().count() as u32,
+    )
+}
+
+#[tokio::test]
+async fn stub_global_first_namespaced_function_navigation_reads_identical_embedded_source() {
+    for minor in [1, 2] {
+        let backend = function_nav_backend(minor, FUNCTION_NAV_SHARED);
+        function_nav_global_first(&backend).await;
+        for name in ["stable", "future"] {
+            let locations = function_nav_locations(&backend, name).await;
+            if name == "future" && minor < 2 {
+                assert!(
+                    locations.is_empty(),
+                    "unavailable namespaced function must not navigate"
+                );
+                continue;
+            }
+            assert_eq!(locations.len(), 1, "available {name} on 8.{minor}");
+            let location = &locations[0];
+            assert_eq!(
+                location.uri.as_str(),
+                format!("phpantom-stub-fn://FunctionBuiltin%5C{name}")
+            );
+            let document = backend
+                .workbench_builtin(phpantom_lsp::workbench_builtins::BuiltinQuery {
+                    uri: location.uri.to_string(),
+                })
+                .await
+                .expect("semantic navigation must return an existing readable builtin identity");
+            assert_eq!(document.content, FUNCTION_NAV_SHARED);
+            assert_eq!(
+                location.range.start,
+                function_nav_expected_position(FUNCTION_NAV_SHARED, name)
+            );
+        }
+    }
+}
+
+#[tokio::test]
+async fn stub_global_first_namespaced_function_different_source_cannot_borrow_coordinates() {
+    let backend = function_nav_backend(1, FUNCTION_NAV_DIFFERENT);
+    function_nav_global_first(&backend).await;
+    for location in function_nav_locations(&backend, "stable").await {
+        assert_ne!(
+            location.uri.as_str(),
+            "phpantom-stub-fn://FunctionBuiltin%5Cstable"
+        );
+        assert!(
+            backend
+                .workbench_builtin(phpantom_lsp::workbench_builtins::BuiltinQuery {
+                    uri: location.uri.to_string(),
+                })
+                .await
+                .is_err(),
+            "unmapped source may refuse, never open different embedded bytes at its offset"
+        );
+    }
+    let canonical = backend
+        .workbench_builtin(phpantom_lsp::workbench_builtins::BuiltinQuery {
+            uri: "phpantom-stub-fn://FunctionBuiltin%5Cstable".into(),
+        })
+        .await
+        .unwrap();
+    assert_eq!(canonical.content, FUNCTION_NAV_DIFFERENT);
+    assert_ne!(canonical.content, FUNCTION_NAV_SHARED);
+}
+
+#[tokio::test]
+async fn stub_global_first_namespaced_function_client_replacement_has_no_embedded_provenance() {
+    let backend = function_nav_backend(1, FUNCTION_NAV_SHARED);
+    function_nav_global_first(&backend).await;
+    let publisher = Url::parse("phpantom-stub://const/FUNCTION_NAV_SENTINEL").unwrap();
+    open_php(&backend, &publisher, FUNCTION_NAV_DIFFERENT).await;
+    for location in function_nav_locations(&backend, "stable").await {
+        assert_ne!(
+            location.uri.as_str(),
+            "phpantom-stub-fn://FunctionBuiltin%5Cstable",
+            "client-selected AST cannot borrow trusted embedded coordinates from an equal URI spelling"
+        );
+    }
+    let canonical = backend
+        .workbench_builtin(phpantom_lsp::workbench_builtins::BuiltinQuery {
+            uri: "phpantom-stub-fn://FunctionBuiltin%5Cstable".into(),
+        })
+        .await
+        .unwrap();
+    assert_eq!(canonical.content, FUNCTION_NAV_SHARED);
+}
+
+#[tokio::test]
+async fn stub_global_first_namespaced_function_project_notes_keep_file_navigation() {
+    let backend = function_nav_backend(1, FUNCTION_NAV_SHARED);
+    let uri = Url::parse("file:///project-function-notes.php").unwrap();
+    let source = "<?php\nnamespace FunctionBuiltin;\n/** @since 99.0 */\nfunction projectFunction(): string { return 'project'; }\n";
+    open_php(&backend, &uri, source).await;
+    function_nav_global_first(&backend).await;
+    let locations = function_nav_locations(&backend, "projectFunction").await;
+    assert_eq!(locations.len(), 1);
+    assert_eq!(locations[0].uri, uri);
+    assert_eq!(
+        locations[0].range.start,
+        function_nav_expected_position(source, "projectFunction")
+    );
+}

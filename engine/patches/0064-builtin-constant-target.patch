+async fn viewer_override_load_and_open_client(backend: &Backend) {
+    let query = Url::parse("file:///viewer-override-sentinel.php").unwrap();
+    crate::common::open_php(backend, &query, "<?php\nVIEWER_OVERRIDE_SENTINEL;\n").await;
+    let hover = crate::common::hover_text_at(backend, &query, 1, 2)
+        .await

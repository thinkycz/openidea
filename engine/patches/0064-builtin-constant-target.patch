+async fn constant_items(
+    backend: &Backend,
+    receiver: &str,
+) -> Vec<tower_lsp::lsp_types::CompletionItem> {
+    let source = format!("<?php\n{receiver}::");
+    complete_at(
+        backend,
+        &Url::parse("file:///constant-target.php").unwrap(),
+        &source,
+        1,
+        receiver.len() as u32 + 2,
+    )
+    .await

+    /// Classify each embedded source once; an admitted alternative preserves
+    /// the exact constant name even when another declaration is unavailable.
+    pub(crate) fn unavailable_builtin_constant_names(
+        content: &str,
+        version: PhpVersion,
+    ) -> HashSet<String> {
+        with_parsed_program(
+            content,
+            "parse_builtin_constant_versions",
+            |program, content| {
+                let ctx = DocblockCtx {
+                    trivias: program.trivia.as_slice(),
+                    content,
+                    php_version: Some(version),
+                    stub_introductions: true,
+                    defer_inferred_name_resolution: false,
+                    use_map: HashMap::new(),
+                    namespace: None,
+                    scope_attribute_offsets: None,
+                };
+                let mut declarations = Vec::new();
+                Self::extract_defines_from_statements(
+                    program.statements.iter(),
+                    &mut declarations,
+                    content,
+                    None,
+                    Some(&ctx),
+                );
+                let mut available: HashMap<String, bool> = HashMap::new();
+                for declaration in declarations {
+                    available
+                        .entry(declaration.name)
+                        .and_modify(|admitted| *admitted |= declaration.available)
+                        .or_insert(declaration.available);
+                }
+                available
+                    .into_iter()
+                    .filter_map(|(name, admitted)| (!admitted).then_some(name))
+                    .collect()
+            },
+        )
+    }

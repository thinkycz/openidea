@@ -0,0 +1,514 @@
+//! Built-in global constants follow their target without changing package metadata.
+use crate::common::{complete_at, create_psr4_workspace, hover_text_at, open_php};
+use phpantom_lsp::{Backend, types::PhpVersion};
+use std::collections::HashMap;
+use tower_lsp::lsp_types::{CompletionItemKind, Url};
+
+const GLOBAL_TARGET_SOURCE: &str = r#"<?php
+namespace {
+    const GLOBAL_TARGET_STABLE = 73031;
+    /** @since 8.2 */
+    const GLOBAL_TARGET_FUTURE = 73032, GLOBAL_TARGET_FUTURE_SECOND = 73033;
+    const GLOBAL_TARGET_ADJACENT = 73034;
+    /** @since 8.2 */
+    define('GLOBAL_TARGET_FUTURE_DEFINE', 73035);
+    define('GLOBAL_TARGET_ADJACENT_DEFINE', 73036);
+    /** @removed 8.2 */
+    const GLOBAL_TARGET_REMOVED = 73040;
+    /** @removed 8.2 */
+    define('GLOBAL_TARGET_REMOVED_DEFINE', 73041);
+    /** @since PECL 9.0 */
+    const GLOBAL_TARGET_EXTENSION_RELEASE = 73037;
+    class GlobalTargetCarrier { public const STABLE = 73038; }
+    function global_target_trigger(): int { return 73039; }
+}
+namespace GlobalTargetNs {
+    /** @since 8.2 */
+    const FUTURE = 73100;
+    const STABLE = 73101;
+    /** @since 8.2 */
+    define('GlobalTargetExplicit\FUTURE_DEFINE', 73102);
+    define('GLOBAL_TARGET_EXACT_GLOBAL', 73103);
+}
+"#;
+
+fn global_target_backend(minor: u8) -> Backend {
+    let constants: HashMap<_, _> = [
+        "GLOBAL_TARGET_STABLE",
+        "GLOBAL_TARGET_FUTURE",
+        "GLOBAL_TARGET_FUTURE_SECOND",
+        "GLOBAL_TARGET_ADJACENT",
+        "GLOBAL_TARGET_FUTURE_DEFINE",
+        "GLOBAL_TARGET_ADJACENT_DEFINE",
+        "GLOBAL_TARGET_EXTENSION_RELEASE",
+        "GlobalTargetNs\\FUTURE",
+        "GlobalTargetNs\\STABLE",
+        "GLOBAL_TARGET_REMOVED",
+        "GLOBAL_TARGET_REMOVED_DEFINE",
+        "GlobalTargetExplicit\\FUTURE_DEFINE",
+        "GLOBAL_TARGET_EXACT_GLOBAL",
+    ]
+    .into_iter()
+    .map(|name| (name, GLOBAL_TARGET_SOURCE))
+    .collect();
+    let backend = Backend::new_test_with_all_stubs(
+        HashMap::from([("GlobalTargetCarrier", GLOBAL_TARGET_SOURCE)]),
+        HashMap::from([("global_target_trigger", GLOBAL_TARGET_SOURCE)]),
+        HashMap::new(),
+    );
+    // Seed the target snapshot before any query. The constructor has already
+    // filtered its default target; these tests do not promote a filtered cache.
+    backend.stub_constant_index_mut().extend(constants);
+    backend.set_php_version(PhpVersion::new(8, minor));
+    backend
+}
+
+async fn global_completion_names(backend: &Backend, prefix: &str) -> Vec<String> {
+    let source = format!("<?php\necho {prefix}");
+    complete_at(
+        backend,
+        &Url::parse("file:///global-target-completion.php").unwrap(),
+        &source,
+        1,
+        ("echo ".len() + prefix.encode_utf16().count()) as u32,
+    )
+    .await
+    .into_iter()
+    .filter(|item| item.kind == Some(CompletionItemKind::CONSTANT))
+    .map(|item| item.filter_text.unwrap_or(item.label))
+    .collect()
+}
+
+async fn global_target_hover(backend: &Backend, name: &str) -> Option<String> {
+    let uri = Url::parse("file:///global-target-hover.php").unwrap();
+    let source = format!("<?php\necho \\{name};\n");
+    open_php(backend, &uri, &source).await;
+    // Enter the actual identifier after `echo \`; all fixture names ASCII.
+    hover_text_at(backend, &uri, 1, 8).await
+}
+
+async fn assert_global_target_matrix(backend: &Backend, minor: u8) {
+    let names = global_completion_names(backend, "GLOBAL_TARGET_").await;
+    for name in [
+        "GLOBAL_TARGET_STABLE",
+        "GLOBAL_TARGET_ADJACENT",
+        "GLOBAL_TARGET_ADJACENT_DEFINE",
+        "GLOBAL_TARGET_EXTENSION_RELEASE",
+        "GLOBAL_TARGET_EXACT_GLOBAL",
+    ] {
+        assert!(
+            names.iter().any(|got| got == name),
+            "missing stable {name}: {names:?}"
+        );
+        assert!(
+            global_target_hover(backend, name).await.is_some(),
+            "missing stable hover {name}"
+        );
+    }
+    for (name, value) in [
+        ("GLOBAL_TARGET_FUTURE", "73032"),
+        ("GLOBAL_TARGET_FUTURE_SECOND", "73033"),
+        ("GLOBAL_TARGET_FUTURE_DEFINE", "73035"),
+    ] {
+        assert_eq!(
+            names.iter().any(|got| got == name),
+            minor >= 2,
+            "completion {name} 8.{minor}"
+        );
+        let hover = global_target_hover(backend, name).await;
+        assert_eq!(
+            hover.is_some(),
+            minor >= 2,
+            "hover {name} 8.{minor}: {hover:?}"
+        );
+        if let Some(hover) = hover {
+            assert!(hover.contains(value), "wrong constant identity: {hover}");
+        }
+    }
+    for name in ["GLOBAL_TARGET_REMOVED", "GLOBAL_TARGET_REMOVED_DEFINE"] {
+        assert_eq!(
+            names.iter().any(|got| got == name),
+            minor < 2,
+            "removed completion {name} 8.{minor}"
+        );
+        assert_eq!(
+            global_target_hover(backend, name).await.is_some(),
+            minor < 2,
+            "removed hover {name} 8.{minor}"
+        );
+    }
+}
+
+#[tokio::test]
+async fn global_constant_target_cold_completion_and_hover_use_numeric_introductions() {
+    for minor in [1, 2] {
+        let backend = global_target_backend(minor);
+        assert!(
+            !backend
+                .global_defines()
+                .read()
+                .contains_key("GLOBAL_TARGET_STABLE")
+        );
+        // First query is completion: a lazy hover must not be necessary to
+        // filter the cold embedded constant index.
+        assert_global_target_matrix(&backend, minor).await;
+    }
+}
+
+#[tokio::test]
+async fn global_constant_target_stable_global_first_cannot_publish_future_siblings() {
+    for minor in [1, 2] {
+        let backend = global_target_backend(minor);
+        let hover = global_target_hover(&backend, "GLOBAL_TARGET_STABLE")
+            .await
+            .unwrap();
+        assert!(hover.contains("73031"));
+        assert!(
+            backend
+                .global_defines()
+                .read()
+                .contains_key("GLOBAL_TARGET_STABLE"),
+            "actual trusted global publisher must run"
+        );
+        assert_global_target_matrix(&backend, minor).await;
+    }
+}
+
+#[tokio::test]
+async fn global_constant_target_future_first_hover_cannot_bypass_cold_admission() {
+    for minor in [1, 2] {
+        for name in ["GLOBAL_TARGET_FUTURE", "GLOBAL_TARGET_FUTURE_DEFINE"] {
+            let backend = global_target_backend(minor);
+            assert!(
+                !backend
+                    .global_defines()
+                    .read()
+                    .contains_key("GLOBAL_TARGET_STABLE")
+            );
+            assert_eq!(
+                global_target_hover(&backend, name).await.is_some(),
+                minor >= 2,
+                "first lookup of {name} bypassed target8.{minor}"
+            );
+            assert!(
+                global_target_hover(&backend, "GLOBAL_TARGET_STABLE")
+                    .await
+                    .is_some()
+            );
+        }
+    }
+}
+
+#[tokio::test]
+async fn global_constant_target_function_and_class_first_keep_global_admission() {
+    for minor in [1, 2] {
+        for function_first in [false, true] {
+            let backend = global_target_backend(minor);
+            if function_first {
+                assert!(
+                    backend
+                        .find_or_load_function(&["global_target_trigger"])
+                        .is_some()
+                );
+            } else {
+                let source = "<?php\nGlobalTargetCarrier::";
+                let items = complete_at(
+                    &backend,
+                    &Url::parse("file:///global-target-class-query.php").unwrap(),
+                    source,
+                    1,
+                    "GlobalTargetCarrier::".len() as u32,
+                )
+                .await;
+                assert!(items.iter().any(|item| item.label == "STABLE"));
+            }
+            assert_global_target_matrix(&backend, minor).await;
+        }
+    }
+}
+
+#[tokio::test]
+async fn global_constant_target_namespace_and_explicit_define_names_are_exact() {
+    for minor in [1, 2] {
+        let backend = global_target_backend(minor);
+        assert!(
+            global_target_hover(&backend, "GLOBAL_TARGET_STABLE")
+                .await
+                .is_some()
+        );
+        for (name, available, value) in [
+            ("GlobalTargetNs\\STABLE", true, "73101"),
+            ("GlobalTargetNs\\FUTURE", minor >= 2, "73100"),
+            ("GlobalTargetExplicit\\FUTURE_DEFINE", minor >= 2, "73102"),
+            ("GLOBAL_TARGET_EXACT_GLOBAL", true, "73103"),
+        ] {
+            let hover = global_target_hover(&backend, name).await;
+            assert_eq!(
+                hover.is_some(),
+                available,
+                "exact global name {name} 8.{minor}: {hover:?}"
+            );
+            if let Some(hover) = hover {
+                assert!(hover.contains(value));
+            }
+        }
+        for wrong in [
+            "FUTURE",
+            "GlobalTargetNs\\GLOBAL_TARGET_EXACT_GLOBAL",
+            "GlobalTargetNs\\GlobalTargetExplicit\\FUTURE_DEFINE",
+        ] {
+            assert!(
+                global_target_hover(&backend, wrong).await.is_none(),
+                "namespace leaked into explicit define identity: {wrong}"
+            );
+        }
+    }
+}
+
+const PROJECT_GLOBAL_RELEASE_NOTES: &str = r#"<?php
+namespace {
+/** @since 99.0 */
+const PROJECT_GLOBAL_SINCE_NOTE = 73201;
+/** @since 99.0 */
+define('PROJECT_GLOBAL_DEFINE_NOTE', 73202);
+}
+namespace ProjectGlobalNotes {
+    /** @since 99.0 */
+    const NAMESPACE_NOTE = 73203;
+}
+"#;
+
+async fn assert_project_global_notes(backend: &Backend) {
+    for (name, value) in [
+        ("PROJECT_GLOBAL_SINCE_NOTE", "73201"),
+        ("PROJECT_GLOBAL_DEFINE_NOTE", "73202"),
+        ("ProjectGlobalNotes\\NAMESPACE_NOTE", "73203"),
+    ] {
+        let hover = global_target_hover(backend, name)
+            .await
+            .expect("package release note is not PHP builtin authority");
+        assert!(hover.contains(value));
+    }
+    let names = global_completion_names(backend, "PROJECT_GLOBAL_").await;
+    for name in ["PROJECT_GLOBAL_SINCE_NOTE", "PROJECT_GLOBAL_DEFINE_NOTE"] {
+        assert!(names.iter().any(|got| got == name));
+    }
+}
+
+#[tokio::test]
+async fn global_constant_target_ordinary_project_release_notes_are_not_builtin_metadata() {
+    let backend = global_target_backend(1);
+    open_php(
+        &backend,
+        &Url::parse("file:///project-global-release-notes.php").unwrap(),
+        PROJECT_GLOBAL_RELEASE_NOTES,
+    )
+    .await;
+    assert_project_global_notes(&backend).await;
+}
+
+#[tokio::test]
+async fn global_constant_target_composer_autoload_files_keep_package_release_notes() {
+    let (backend, dir) = create_psr4_workspace(
+        r#"{"autoload":{"files":["package/notes.php"]}}"#,
+        &[("package/notes.php", PROJECT_GLOBAL_RELEASE_NOTES)],
+    );
+    backend.set_php_version(PhpVersion::new(8, 1));
+    // Use the production constant autoload fallback's declared file list,
+    // without didOpening package source or pretending it is an embedded stub.
+    backend
+        .autoload_file_paths()
+        .write()
+        .push(dir.path().join("package/notes.php"));
+    assert_project_global_notes(&backend).await;
+    assert_eq!(
+        std::fs::read_to_string(dir.path().join("package/notes.php")).unwrap(),
+        PROJECT_GLOBAL_RELEASE_NOTES
+    );
+}
+
+#[tokio::test]
+async fn global_constant_target_alternative_declarations_keep_an_available_identity() {
+    const SOURCE: &str = r#"<?php
+const ALTERNATIVE_STABLE = 73900;
+if (PHP_VERSION_ID >= 80200) {
+    /** @since 8.2 */
+    define('ALTERNATIVE_SHARED', 73901);
+} else {
+    /** @removed 8.2 */
+    define('ALTERNATIVE_SHARED', 73902);
+}
+"#;
+    for minor in [1, 2] {
+        let backend = Backend::new_test_with_all_stubs(
+            HashMap::new(),
+            HashMap::new(),
+            HashMap::from([
+                ("ALTERNATIVE_STABLE", SOURCE),
+                ("ALTERNATIVE_SHARED", SOURCE),
+            ]),
+        );
+        backend.set_php_version(PhpVersion::new(8, minor));
+        let names = global_completion_names(&backend, "ALTERNATIVE_").await;
+        assert!(names.iter().any(|name| name == "ALTERNATIVE_SHARED"));
+        assert!(
+            global_target_hover(&backend, "ALTERNATIVE_STABLE")
+                .await
+                .unwrap()
+                .contains("73900")
+        );
+        let value = if minor == 1 { "73902" } else { "73901" };
+        assert!(
+            global_target_hover(&backend, "ALTERNATIVE_SHARED")
+                .await
+                .unwrap()
+                .contains(value)
+        );
+    }
+}

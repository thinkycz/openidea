+#[tokio::test]
+async fn global_constant_target_fully_qualified_define_matches_only_builtin_identity() {
+    const QUALIFIED: &str = r#"<?php
+namespace GlobalQualified {
+    /** @since 8.2 */
+    \define('GLOBAL_QUALIFIED_FUTURE', 73931);
+    \define('GlobalQualifiedExplicit\STABLE', 73932);
+    Different\define('GLOBAL_QUALIFIED_NOT_BUILTIN', 73933);
+}
+"#;
+    for minor in [1, 2] {
+        let backend = Backend::new_test_with_all_stubs(
+            HashMap::new(),
+            HashMap::new(),
+            HashMap::from([
+                ("GLOBAL_QUALIFIED_FUTURE", QUALIFIED),
+                ("GlobalQualifiedExplicit\\STABLE", QUALIFIED),
+            ]),
+        );
+        backend.set_php_version(PhpVersion::new(8, minor));
+        let stable = global_target_hover(&backend, "GlobalQualifiedExplicit\\STABLE")
+            .await
+            .unwrap();
+        assert!(
+            stable.contains("73932"),
+            "qualified builtin define must retain exact literal name/value"
+        );
+        let future = global_target_hover(&backend, "GLOBAL_QUALIFIED_FUTURE").await;
+        assert_eq!(future.is_some(), minor >= 2);
+        if let Some(future) = future {
+            assert!(future.contains("73931"));
+        }
+        assert!(
+            global_target_hover(&backend, "GLOBAL_QUALIFIED_NOT_BUILTIN")
+                .await
+                .is_none(),
+            "qualified nonbuiltin call must not register a global define"
+        );
+    }

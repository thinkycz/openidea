+#[tokio::test]
+async fn global_constant_target_client_stub_uri_does_not_authorize_global_release_notes() {
+    let backend = global_target_backend(1);
+    // This is a legitimate-looking identity, delivered only via ordinary
+    // didOpen. The trusted index loader is never invoked with these bytes.
+    let uri = Url::parse("phpantom-stub://const/CLIENT_GLOBAL_TARGET_NOTES").unwrap();
+    let source = r#"<?php
+/** @since 99.0 */
+const CLIENT_GLOBAL_SINCE_NOTE = 73911;
+/** @removed 8.1 */
+define('CLIENT_GLOBAL_REMOVED_NOTE', 73912);
+"#;
+    open_php(&backend, &uri, source).await;
+    for (name, value) in [
+        ("CLIENT_GLOBAL_SINCE_NOTE", "73911"),
+        ("CLIENT_GLOBAL_REMOVED_NOTE", "73912"),
+    ] {
+        let hover = global_target_hover(&backend, name)
+            .await
+            .expect("URI spelling must not grant metadata authority");
+        assert!(hover.contains(value));
+    }
+    let names = global_completion_names(&backend, "CLIENT_GLOBAL_").await;
+    for name in ["CLIENT_GLOBAL_SINCE_NOTE", "CLIENT_GLOBAL_REMOVED_NOTE"] {
+        assert!(names.iter().any(|got| got == name));
+    }
+}

+#[tokio::test]
+async fn global_constant_target_older_project_polyfill_keeps_exact_builtin_spelling() {
+    // On 8.1 this name is absent from the real runtime builtin surface, so a
+    // project polyfill with this exact spelling is a valid authority control.
+    let backend = global_target_backend(1);
+    let uri = Url::parse("file:///global-target-polyfill.php").unwrap();
+    let source = r#"<?php
+/** @since 99.0
+ * @removed 8.1
+ */
+const GLOBAL_TARGET_FUTURE = 73901;
+/** @removed 8.1 */
+const PROJECT_GLOBAL_REMOVED_PACKAGE_NOTE = 73902;
+"#;
+    open_php(&backend, &uri, source).await;
+    let before = global_target_hover(&backend, "GLOBAL_TARGET_FUTURE")
+        .await
+        .unwrap();
+    assert!(before.contains("73901"));
+    assert!(
+        global_target_hover(&backend, "GLOBAL_TARGET_STABLE")
+            .await
+            .unwrap()
+            .contains("73031")
+    );
+    // Warm publication of the whole trusted source cannot overwrite/remove
+    // the project definition merely because a forbidden sibling has its name.
+    let after = global_target_hover(&backend, "GLOBAL_TARGET_FUTURE")
+        .await
+        .unwrap();
+    assert!(
+        after.contains("73901"),
+        "polyfill lost project identity: {after}"
+    );
+    assert!(!after.contains("73032"));
+    assert!(
+        global_target_hover(&backend, "PROJECT_GLOBAL_REMOVED_PACKAGE_NOTE")
+            .await
+            .unwrap()
+            .contains("73902")
+    );
+    let names = global_completion_names(&backend, "GLOBAL_TARGET_FUTURE").await;
+    assert!(names.iter().any(|name| name == "GLOBAL_TARGET_FUTURE"));
+}

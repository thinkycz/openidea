+#[tokio::test]
+async fn global_constant_target_composer_removed_tag_is_package_metadata() {
+    const PACKAGE_NOTES: &str = r#"<?php
+/** @since 99.0 */
+const COMPOSER_GLOBAL_SINCE_NOTE = 73921;
+/** @removed 8.1 */
+define('COMPOSER_GLOBAL_REMOVED_NOTE', 73922);
+"#;
+    let (backend, dir) = create_psr4_workspace(
+        r#"{"autoload":{"files":["package/notes.php"]}}"#,
+        &[("package/notes.php", PACKAGE_NOTES)],
+    );
+    backend.set_php_version(PhpVersion::new(8, 1));
+    backend
+        .autoload_file_paths()
+        .write()
+        .push(dir.path().join("package/notes.php"));
+    for (name, value) in [
+        ("COMPOSER_GLOBAL_SINCE_NOTE", "73921"),
+        ("COMPOSER_GLOBAL_REMOVED_NOTE", "73922"),
+    ] {
+        let hover = global_target_hover(&backend, name)
+            .await
+            .expect("package versions do not govern PHP builtin admission");
+        assert!(hover.contains(value));
+    }
+    assert_eq!(
+        std::fs::read_to_string(dir.path().join("package/notes.php")).unwrap(),
+        PACKAGE_NOTES
+    );
+}

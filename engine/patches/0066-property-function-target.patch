+#[tokio::test]
+async fn stub_property_grouped_declaration_own_metadata_alias_ranges_and_adjacency() {
+    for minor in [1, 2, 3, 4] {
+        for inherited in [false, true] {
+            let backend = synthetic_property_backend(minor);
+            let items = property_items(&backend, "PropertyTarget\\Carrier", inherited).await;
+            for name in [
+                "stable",
+                "afterFuture",
+                "typeOnly",
+                "extensionRelease",
+                "afterConstant",
+                "afterMethod",
+            ] {
+                assert!(property_named(&items, name).is_some(), "{name} on8.{minor}");
+            }
+            for name in ["futureFirst", "futureSecond"] {
+                assert_eq!(
+                    property_named(&items, name).is_some(),
+                    minor >= 2,
+                    "group {name} on8.{minor}"
+                );
+            }
+            assert_eq!(property_named(&items, "removed").is_some(), minor < 2);
+            assert_eq!(
+                property_named(&items, "ranged").is_some(),
+                (2..=3).contains(&minor)
+            );
+        }
+    }
+}

+const PROPERTY_STUB: &str = r#"<?php
+namespace { const PROPERTY_TARGET_SENTINEL = 74001; function property_target_trigger(): int { return 74002; } }
+namespace PropertyTarget {
+use JetBrains\PhpStorm\Internal\PhpStormStubsElementAvailable as Available;
+use JetBrains\PhpStorm\Internal\LanguageLevelTypeAware as TypeAware;
+class Carrier {
+    public $stable;
+    /** @since 8.2 */
+    public int $futureFirst, $futureSecond;
+    public $afterFuture;
+    /** @removed 8.2 */
+    public $removed;
+    #[Available(from: '8.2', to: '8.3')]
+    public $ranged;
+    /** @var bool */
+    #[TypeAware(['8.2' => 'bool'], default: '')]
+    public $typeOnly;
+    /** @since PECL 9.0 */
+    public $extensionRelease;
+    /** @since 8.2 */
+    public const FUTURE_CONSTANT = 1;
+    public $afterConstant;
+    /** @since 8.2 */
+    public function futureMethod() {}
+    public $afterMethod;
+}
+}
+"#;
+
+fn synthetic_property_backend(minor: u8) -> Backend {
+    let backend = Backend::new_test_with_all_stubs(
+        HashMap::from([("PropertyTarget\\Carrier", PROPERTY_STUB)]),
+        HashMap::from([("property_target_trigger", PROPERTY_STUB)]),
+        HashMap::new(),
+    );
+    // Constructor already filtered its default target; seed the stable global
+    // entry before applying the one target snapshot used by this fixture.
+    backend
+        .stub_constant_index_mut()
+        .insert("PROPERTY_TARGET_SENTINEL", PROPERTY_STUB);
+    backend.set_php_version(PhpVersion::new(8, minor));
+    backend
+}

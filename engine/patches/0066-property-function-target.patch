@@ -0,0 +1,599 @@
+//! PHP-release filtering has authority only in embedded or explicitly versioned parsing.
+use crate::common::{complete_at, create_psr4_workspace, hover_text_at, open_php};
+use phpantom_lsp::{Backend, types::PhpVersion};
+use std::collections::HashMap;
+use tower_lsp::{LanguageServer, lsp_types::*};
+
+const SOURCE: &str = r#"<?php
+namespace ReleaseNotes;
+use JetBrains\PhpStorm\Internal\PhpStormStubsElementAvailable as Available;
+class Carrier {
+    public function stableMethod(): string { return 'stable'; }
+    /** @removed 8.1 */ public function removedMethod(): string { return 'package'; }
+    #[Available(from: '99.0')] public function rangedMethod(): string { return 'package'; }
+    /** @since 99.0 */ public function sinceMethod(): string { return 'package'; }
+    public function parameterMethod(string $before, #[Available(from: '8.2')] int $packageParam, bool $after): string { return 'params'; }
+}
+function authorityStable(): string { return 'stable'; }
+/** @removed 8.1 */ function authorityRemoved(): string { return 'package'; }
+#[Available(from: '99.0')] function authorityRanged(): string { return 'package'; }
+/** @since 99.0 */ function authoritySince(): string { return 'package'; }
+function authorityParameters(string $before, #[Available(from: '8.2')] int $packageParam, bool $after): string { return 'params'; }
+/** @removed 8.1 */ class RemovedClass { public function retained(): string { return 'class'; } }
+/** @removed 8.1 */ interface RemovedInterface { public function retained(): string; }
+/** @removed 8.1 */ trait RemovedTrait { public function retained(): string { return 'trait'; } }
+class UsesTrait { use RemovedTrait; }
+/** @removed 8.1 */ enum RemovedEnum { case One; public function retained(): string { return 'enum'; } }
+/** @since 99.0 */ class SinceClass { public function retained(): string { return 'since'; } }
+"#;

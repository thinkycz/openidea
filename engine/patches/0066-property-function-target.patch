diff --git a/src/parser/function_availability.rs b/src/parser/function_availability.rs
new file mode 100644
index 0000000..48e826c
--- /dev/null
+++ b/src/parser/function_availability.rs
@@ -0,0 +1,152 @@
+//! Declaration-only availability for embedded function indexes.
+use std::collections::{HashMap, HashSet};
+
+use mago_syntax::cst::*;
+
+use super::{
+    DocblockCtx, is_available_for_version, is_future_builtin_declaration, is_removed_for_version,
+    with_parsed_program,
+};
+use crate::{Backend, atom::bytes_to_str, types::PhpVersion};
+
+// Canonical function identity is ASCII-case-insensitive and namespace-qualified.
+fn key(namespace: Option<&str>, name: &str) -> String {
+    match namespace.filter(|namespace| !namespace.is_empty()) {
+        Some(namespace) => format!("{namespace}\\{name}"),
+        None => name.to_owned(),
+    }
+    .to_ascii_lowercase()
+}
+
+// Namespace imports apply throughout their declaration scope. Collect only its
+// own direct `use` statements, never aliases from a sibling namespace. Block/if
+// recursion below preserves that scope, matching extract_functions' traversal.
+fn scope<'a>(
+    statements: impl Iterator<Item = &'a Statement<'a>> + std::clone::Clone,
+    parent: &DocblockCtx<'a>,
+    namespace: Option<String>,
+    states: &mut HashMap<String, bool>,
+) {
+    let mut use_map = HashMap::new();
+    for statement in statements.clone() {
+        if let Statement::Use(import) = statement {
+            Backend::extract_use_items(&import.items, &mut use_map);
+        }
+    }
+    let ctx = DocblockCtx {
+        trivias: parent.trivias,
+        content: parent.content,
+        php_version: parent.php_version,
+        explicit_version_filtering: false,
+        stub_introductions: true,
+        defer_inferred_name_resolution: false,
+        use_map,
+        namespace,
+        scope_attribute_offsets: None,
+    };
+    for statement in statements {
+        visit(statement, &ctx, states);
+    }
+}
+
+fn visit<'a>(
+    statement: &'a Statement<'a>,
+    ctx: &DocblockCtx<'a>,
+    states: &mut HashMap<String, bool>,
+) {
+    match statement {
+        Statement::Function(function) => {
+            let version = ctx
+                .php_version
+                .expect("classifier always supplies a target");
+            let admitted = !is_future_builtin_declaration(function, Some(ctx))
+                && is_available_for_version(&function.attribute_lists, ctx, version)
+                && !is_removed_for_version(function, ctx, version);
+            // No body/parameter/type/doc expansion. Header identity and own
+            // metadata are sufficient for startup index admission.
+            let name = key(ctx.namespace.as_deref(), bytes_to_str(function.name.value));
+            states
+                .entry(name)
+                .and_modify(|any| *any |= admitted)
+                .or_insert(admitted);
+        }
+        Statement::Namespace(namespace) => {
+            // An anonymous namespace resets to global, not the parent scope.
+            let name = namespace
+                .name
+                .as_ref()
+                .map(|name| bytes_to_str(name.value()).to_owned())
+                .filter(|name| !name.is_empty());
+            scope(namespace.statements().iter(), ctx, name, states);
+        }
+        Statement::Block(block) => {
+            for statement in block.statements.iter() {
+                visit(statement, ctx, states);
+            }
+        }
+        Statement::If(statement) => visit_if(&statement.body, ctx, states),
+        // Deliberately match canonical extract_functions traversal. Methods,
+        // closures and classes are not standalone function declarations.
+        _ => {}
+    }
+}
+
+fn visit_if<'a>(body: &'a IfBody<'a>, ctx: &DocblockCtx<'a>, states: &mut HashMap<String, bool>) {
+    match body {
+        IfBody::Statement(body) => {
+            visit(body.statement, ctx, states);
+            for branch in body.else_if_clauses.iter() {
+                visit(branch.statement, ctx, states);
+            }
+            if let Some(branch) = &body.else_clause {
+                visit(branch.statement, ctx, states);
+            }
+        }
+        IfBody::ColonDelimited(body) => {
+            for statement in body.statements.iter() {
+                visit(statement, ctx, states);
+            }
+            for branch in body.else_if_clauses.iter() {
+                for statement in branch.statements.iter() {
+                    visit(statement, ctx, states);
+                }
+            }
+            if let Some(branch) = &body.else_clause {
+                for statement in branch.statements.iter() {
+                    visit(statement, ctx, states);
+                }
+            }
+        }
+    }
+}
+
+impl Backend {
+    /// Names positively classified unavailable in one immutable embedded source.
+    /// Any admitted alternative preserves its exact namespace-qualified key.
+    /// Names not found in the parsed declaration set remain UNKNOWN, so callers
+    /// must retain them rather than treating this as an exhaustive allowlist.
+    pub(crate) fn unavailable_builtin_function_names(
+        content: &str,
+        version: PhpVersion,
+    ) -> HashSet<String> {
+        with_parsed_program(content, "builtin_function_admission", |program, content| {
+            let ctx = DocblockCtx {
+                trivias: program.trivia.as_slice(),
+                content,
+                php_version: Some(version),
+                explicit_version_filtering: false,
+                stub_introductions: true,
+                defer_inferred_name_resolution: false,
+                use_map: HashMap::new(),
+                namespace: None,
+                scope_attribute_offsets: None,
+            };
+            let mut states = HashMap::new();
+            scope(program.statements.iter(), &ctx, None, &mut states);
+            states
+                .into_iter()
+                .filter_map(|(name, any)| (!any).then_some(name))
+                .collect()
+        })
+    }
+}

+//! Built-in property declarations follow their target without suppressing package metadata.
+use crate::common::{
+    complete_at, create_psr4_workspace, goto_definition_at, hover_text_at, open_php,
+};
+use phpantom_lsp::{Backend, types::PhpVersion};
+use std::collections::HashMap;
+use tower_lsp::{LanguageServer, lsp_types::*};
+
+async fn property_items(backend: &Backend, receiver: &str, inherited: bool) -> Vec<CompletionItem> {
+    let declaration = if inherited {
+        format!("class PropertyQueryChild extends \\{receiver} {{}}\n")
+    } else {
+        String::new()
+    };
+    let ty = if inherited {
+        "PropertyQueryChild"
+    } else {
+        receiver
+    };
+    let source =
+        format!("<?php\n{declaration}function inspect(\\{ty} $value): void {{ $value-> }}\n");
+    let line = if inherited { 2 } else { 1 };
+    let col = format!("function inspect(\\{ty} $value): void {{ $value->")
+        .encode_utf16()
+        .count() as u32;
+    complete_at(
+        backend,
+        &Url::parse("file:///property-target-items.php").unwrap(),
+        &source,
+        line,
+        col,
+    )
+    .await
+}
+
+fn property_named<'a>(items: &'a [CompletionItem], name: &str) -> Option<&'a CompletionItem> {
+    items.iter().find(|item| {
+        item.kind == Some(CompletionItemKind::PROPERTY)
+            && item
+                .filter_text
+                .as_deref()
+                .unwrap_or(&item.label)
+                .trim_start_matches('$')
+                == name
+    })
+}
+
+async fn property_hover(backend: &Backend, receiver: &str, name: &str) -> Option<String> {
+    let uri = Url::parse("file:///property-target-hover.php").unwrap();
+    let prefix = format!("function inspect(\\{receiver} $value): void {{ $value->");
+    let source = format!("<?php\n{prefix}{name}; }}\n");
+    open_php(backend, &uri, &source).await;
+    hover_text_at(backend, &uri, 1, prefix.encode_utf16().count() as u32 + 2).await
+}
+
+async fn property_location(backend: &Backend, receiver: &str, name: &str) -> Option<Url> {
+    let uri = Url::parse("file:///property-target-definition.php").unwrap();
+    let prefix = format!("function inspect(\\{receiver} $value): void {{ $value->");
+    let source = format!("<?php\n{prefix}{name}; }}\n");
+    open_php(backend, &uri, &source).await;
+    match goto_definition_at(backend, &uri, 1, prefix.encode_utf16().count() as u32 + 2).await {
+        None => None,
+        Some(GotoDefinitionResponse::Scalar(location)) => Some(location.uri),
+        Some(GotoDefinitionResponse::Array(locations)) => {
+            assert_eq!(locations.len(), 1);
+            Some(locations[0].uri.clone())
+        }
+        Some(GotoDefinitionResponse::Link(locations)) => {
+            assert_eq!(locations.len(), 1);
+            Some(locations[0].target_uri.clone())
+        }
+    }
+}
+
+fn date_period_backend(minor: u8) -> Backend {
+    let backend = Backend::new_test_with_stubs(phpantom_lsp::stubs::build_stub_class_index());
+    backend.set_php_version(PhpVersion::new(8, minor));
+    backend
+}

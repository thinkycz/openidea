+#[tokio::test]
+async fn stub_property_actual_date_period_cold_warm_and_inherited_target_boundaries() {
+    for minor in [1, 2] {
+        for inherited in [false, true] {
+            let backend = date_period_backend(minor);
+            let cold = property_items(&backend, "DatePeriod", inherited).await;
+            assert!(
+                property_named(&cold, "include_start_date").is_some(),
+                "stable DatePeriod control"
+            );
+            assert_eq!(
+                property_named(&cold, "include_end_date").is_some(),
+                minor >= 2,
+                "cold DatePeriod inherited={inherited} on8.{minor}"
+            );
+            // Stable pre8.2 member has type-changing metadata, not an existence
+            // boundary. Require presence, not an invented pre8.2 native type.
+            assert!(
+                property_hover(&backend, "DatePeriod", "include_start_date")
+                    .await
+                    .is_some()
+            );
+            let warm = property_items(&backend, "DatePeriod", inherited).await;
+            assert!(property_named(&warm, "include_start_date").is_some());
+            assert_eq!(
+                property_named(&warm, "include_end_date").is_some(),
+                minor >= 2
+            );
+            assert_eq!(
+                property_hover(&backend, "DatePeriod", "include_end_date")
+                    .await
+                    .is_some(),
+                minor >= 2
+            );
+            assert_eq!(
+                property_location(&backend, "DatePeriod", "include_end_date")
+                    .await
+                    .is_some(),
+                minor >= 2
+            );
+            if let Some(item) = property_named(&warm, "include_end_date") {
+                let mut item = item.clone();
+                item.documentation = None;
+                assert!(
+                    backend
+                        .completion_resolve(item)
+                        .await
+                        .unwrap()
+                        .documentation
+                        .is_some()
+                );
+            }
+        }
+    }
+}

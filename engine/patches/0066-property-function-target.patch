+async fn methods(backend: &Backend, receiver: &str) -> Vec<CompletionItem> {
+    let prefix = format!(
+        "function authorityMemberQuery(\\ReleaseNotes\\{receiver} $value): void {{ $value->"
+    );
+    let source = format!("<?php\n{prefix} }}\n");
+    complete_at(
+        backend,
+        &Url::parse("file:///authority-member-query.php").unwrap(),
+        &source,
+        1,
+        prefix.encode_utf16().count() as u32,
+    )
+    .await
+}
+
+fn contains(items: &[CompletionItem], name: &str) -> bool {
+    items.iter().any(|item| {
+        item.filter_text
+            .as_deref()
+            .unwrap_or(item.label.split('(').next().unwrap())
+            == name
+    })
+}
+
+async fn functions(backend: &Backend) -> Vec<CompletionItem> {
+    complete_at(
+        backend,
+        &Url::parse("file:///authority-function-query.php").unwrap(),
+        "<?php\nnamespace ReleaseNotes;\nauthority",
+        2,
+        9,
+    )
+    .await
+}
+
+async fn signature(backend: &Backend, method: bool) -> SignatureHelp {
+    let marked = if method {
+        "<?php\nfunction authoritySignatureQuery(\\ReleaseNotes\\Carrier $value): void { $value->parameterMethod(<caret>); }\n"
+    } else {
+        "<?php\n\\ReleaseNotes\\authorityParameters(<caret>);\n"
+    };
+    let (prefix, _) = marked.split_once("<caret>").unwrap();
+    let pos = Position::new(
+        prefix.bytes().filter(|byte| *byte == b'\n').count() as u32,
+        prefix.rsplit('\n').next().unwrap().encode_utf16().count() as u32,
+    );
+    let uri = Url::parse(if method {
+        "file:///authority-method-signature.php"
+    } else {
+        "file:///authority-function-signature.php"
+    })
+    .unwrap();
+    open_php(backend, &uri, &marked.replace("<caret>", "")).await;
+    backend
+        .signature_help(SignatureHelpParams {
+            text_document_position_params: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier { uri },
+                position: pos,
+            },
+            work_done_progress_params: WorkDoneProgressParams::default(),
+            context: None,
+        })
+        .await
+        .unwrap()
+        .expect("callable must have signature")
+}
+
+fn assert_parameter_order(help: &SignatureHelp, middle: bool) {
+    let sig = &help.signatures[0];
+    assert_eq!(
+        sig.parameters.as_ref().unwrap().len(),
+        if middle { 3 } else { 2 }
+    );
+    let before = sig.label.find("$before").unwrap();
+    let after = sig.label.find("$after").unwrap();
+    assert!(before < after);
+    if middle {
+        let parameter = sig
+            .label
+            .find("$packageParam")
+            .expect("ordinary middle parameter cannot be dropped");
+        assert!(before < parameter && parameter < after);
+    } else {
+        assert!(!sig.label.contains("$packageParam"));
+    }
+}
+
+async fn assert_parameter_hover_order(backend: &Backend, method: bool, middle: bool) {
+    let (source, symbol) = if method {
+        (
+            "<?php\nfunction inspectHover(\\ReleaseNotes\\Carrier $value): void { $value->parameterMethod(); }\n",
+            "parameterMethod",
+        )
+    } else {
+        (
+            "<?php\n\\ReleaseNotes\\authorityParameters();\n",
+            "authorityParameters",
+        )
+    };
+    let at = source.find(symbol).unwrap() + 2;
+    let prefix = &source[..at];
+    let uri = Url::parse(if method {
+        "file:///authority-method-param-hover.php"
+    } else {
+        "file:///authority-function-param-hover.php"
+    })
+    .unwrap();
+    open_php(backend, &uri, source).await;
+    let doc = hover_text_at(
+        backend,
+        &uri,
+        prefix.bytes().filter(|byte| *byte == b'\n').count() as u32,
+        prefix.rsplit('\n').next().unwrap().encode_utf16().count() as u32,
+    )
+    .await
+    .expect("parameter callable must hover");
+    let before = doc.find("$before").unwrap();
+    let after = doc.find("$after").unwrap();
+    assert!(before < after);
+    if middle {
+        let package = doc
+            .find("$packageParam")
+            .expect("ordinary middle parameter must remain in hover");
+        assert!(before < package && package < after);
+    } else {
+        assert!(!doc.contains("$packageParam"));
+    }
+}
+
+async fn assert_ordinary(backend: &Backend) {
+    let member_items = methods(backend, "Carrier").await;
+    for name in [
+        "stableMethod",
+        "removedMethod",
+        "rangedMethod",
+        "sinceMethod",
+        "parameterMethod",
+    ] {
+        assert!(
+            contains(&member_items, name),
+            "ordinary method hidden: {name}"
+        );
+    }
+    let function_items = functions(backend).await;
+    for name in [
+        "authorityStable",
+        "authorityRemoved",
+        "authorityRanged",
+        "authoritySince",
+        "authorityParameters",
+    ] {
+        assert!(
+            contains(&function_items, name),
+            "ordinary function hidden: {name}"
+        );
+    }
+    for receiver in [
+        "RemovedClass",
+        "RemovedInterface",
+        "UsesTrait",
+        "RemovedEnum",
+        "SinceClass",
+    ] {
+        assert!(
+            contains(&methods(backend, receiver).await, "retained"),
+            "ordinary classlike hidden: {receiver}"
+        );
+    }
+    for method in [false, true] {
+        assert_parameter_order(&signature(backend, method).await, true);
+        assert_parameter_hover_order(backend, method, true).await;
+    }
+}

--- /dev/null
+++ b/src/structural_search.rs
@@ -0,0 +1,798 @@
+//! Read-only PHP call-pattern matching through the canonical CST.
+
+use std::collections::BTreeMap;
+use std::ops::Range as ByteRange;
+
+use mago_database::file::FileId;
+use mago_span::{HasSpan, Span};
+use mago_syntax::cst::{
+    Argument, Call, ClassLikeMemberSelector, Expression, Program, Statement, Variable,
+};
+use mago_syntax::lexer::Lexer;
+use mago_syntax::settings::LexerSettings;
+use mago_syntax::token::TokenKind;
+use mago_syntax::walker::{MutWalker, walk_expression_mut, walk_statement_mut};
+use mago_syntax_core::input::Input;
+use tower_lsp::lsp_types::Range;
+
+use crate::parser::with_parsed_program;
+use crate::text_position::{PassLineTable, byte_range_to_lsp_range};
+
+const MAX_PATTERN_BYTES: usize = 4096;
+const CAPTURE_PREFIX: &[u8] = b"$__ss_";
+const MAX_CAPTURE_NAMES: usize = 32;
+const MAX_ARGUMENTS: usize = 128;
+
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Limits {
+    pub source_bytes: usize,
+    pub tokens: usize,
+    pub nesting: usize,
+    pub nodes: usize,
+    pub matches: usize,
+    /// Cumulative token comparisons, including failed candidate comparisons.
+    pub comparisons: usize,
+    pub comparison_bytes: usize,
+}
+
+impl Default for Limits {
+    fn default() -> Self {
+        Self {
+            source_bytes: 2 * 1024 * 1024,
+            tokens: 131_072,
+            nesting: 128,
+            nodes: 200_000,
+            matches: 1000,
+            comparisons: 1_000_000,
+            comparison_bytes: 16 * 1024 * 1024,
+        }
+    }
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(crate) enum SearchError {
+    Cancelled,
+    Deadline,
+    PatternTooLarge,
+    PatternSyntax,
+    ExpectedOneCall,
+    UnsupportedPattern(&'static str),
+    InvalidCapture,
+    CaptureRoleConflict,
+    SourceSyntax,
+    ParserFailure,
+    InvalidSpan,
+    Budget(&'static str),
+}
+
+impl std::fmt::Display for SearchError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Cancelled => {
+                f.write_str("Structural search was canceled; no matches were published.")
+            }
+            Self::Deadline => {
+                f.write_str("Structural search deadline reached; no matches were published.")
+            }
+            Self::PatternTooLarge => f.write_str("Pattern exceeds 4096 bytes."),
+            Self::PatternSyntax => f.write_str("Pattern must be valid PHP syntax."),
+            Self::ExpectedOneCall => {
+                f.write_str("Enter exactly one function, instance or static call.")
+            }
+            Self::UnsupportedPattern(reason) => f.write_str(reason),
+            Self::InvalidCapture => {
+                f.write_str("Use a capture named $__ss_name with an ASCII identifier suffix.")
+            }
+            Self::CaptureRoleConflict => {
+                f.write_str("One name cannot capture both an expression and an argument sequence.")
+            }
+            Self::SourceSyntax => {
+                f.write_str("Source has parse or lexer errors; no matches were published.")
+            }
+            Self::ParserFailure => {
+                f.write_str("Parser did not complete; no matches were published.")
+            }
+            Self::InvalidSpan => f.write_str("Parser returned an invalid source span."),
+            Self::Budget(reason) => write!(
+                f,
+                "Structural search limit reached: {reason}. No matches were published."
+            ),
+        }
+    }
+}
+
+impl std::error::Error for SearchError {}
+
+impl From<control::Stop> for SearchError {
+    fn from(stop: control::Stop) -> Self {
+        match stop {
+            control::Stop::Cancelled => Self::Cancelled,
+            control::Stop::Deadline => Self::Deadline,
+        }
+    }
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(crate) struct SourceRange {
+    pub bytes: ByteRange<usize>,
+    pub range: Range,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(crate) enum Capture {
+    /// All occurrences of a repeated expression capture, in source order.
+    Expression(Vec<SourceRange>),
+    /// Individual argument expression spans; excludes separators and ellipsis.
+    /// A zero-argument tail is represented by an empty vector.
+    Arguments(Vec<SourceRange>),
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(crate) struct Match {
+    pub call: SourceRange,
+    /// Keys exclude the `$__ss_` prefix and are deterministically sorted.
+    pub captures: BTreeMap<String, Capture>,
+}
+
+#[derive(Clone, Debug)]
+struct OwnedToken {
+    kind: TokenKind,
+    text: Vec<u8>,
+}
+
+#[derive(Clone, Debug)]
+enum Term {
+    Capture(String),
+    Exact(Vec<OwnedToken>),
+}
+
+#[derive(Clone, Debug)]
+enum Head {
+    Function(Vec<OwnedToken>),
+    Instance {
+        receiver: Term,
+        method: Vec<u8>,
+    },
+    Static {
+        class: Vec<OwnedToken>,
+        method: Vec<u8>,
+    },
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct Pattern {
+    head: Head,
+    arguments: Vec<Term>,
+    tail: Option<String>,
+}
+
+#[derive(Clone, Debug)]
+struct SourceToken {
+    kind: TokenKind,
+    bytes: ByteRange<usize>,
+}
+
+struct Tokens<'s> {
+    source: &'s str,
+    tokens: Vec<SourceToken>,
+}
+
+fn bytes(span: Span) -> ByteRange<usize> {
+    span.start.offset as usize..span.end.offset as usize
+}
+
+impl<'s> Tokens<'s> {
+    /// Full-document lexer: strings/comments are never searched as calls.
+    /// Delimiter admission happens before invoking the recursive CST parser.
+    fn read(source: &'s str, limits: Limits) -> Result<Self, SearchError> {
+        Self::read_with_control(source, limits, &|| Ok(()))
+    }
+
+    fn read_with_control(
+        source: &'s str,
+        limits: Limits,
+        checkpoint: &(dyn Fn() -> Result<(), SearchError> + Sync),
+    ) -> Result<Self, SearchError> {
+        checkpoint()?;
+        if source.len() > limits.source_bytes || source.len() > u32::MAX as usize {
+            return Err(SearchError::Budget("source bytes"));
+        }
+        let input = Input::new(FileId::new(b"structural-search.php"), source.as_bytes());
+        let mut lexer = Lexer::new(input, LexerSettings::default());
+        let mut tokens = Vec::new();
+        let mut depth = 0usize;
+        loop {
+            checkpoint()?;
+            let Some(token) = lexer.advance() else {
+                break;
+            };
+            let token = token.map_err(|_| SearchError::SourceSyntax)?;
+            if token.kind == TokenKind::PartialLiteralString {
+                return Err(SearchError::SourceSyntax);
+            }
+            if token.kind.is_trivia() {
+                continue;
+            }
+            if tokens.len() >= limits.tokens {
+                return Err(SearchError::Budget("syntax tokens"));
+            }
+            match token.kind {
+                TokenKind::LeftParenthesis | TokenKind::LeftBracket | TokenKind::LeftBrace => {
+                    depth += 1;
+                    if depth > limits.nesting {
+                        return Err(SearchError::Budget("delimiter nesting"));
+                    }
+                }
+                TokenKind::RightParenthesis | TokenKind::RightBracket | TokenKind::RightBrace => {
+                    depth = depth.saturating_sub(1);
+                }
+                _ => {}
+            }
+            let start = token.start.offset as usize;
+            let end = start
+                .checked_add(token.value.len())
+                .ok_or(SearchError::InvalidSpan)?;
+            if source.get(start..end).is_none() {
+                return Err(SearchError::InvalidSpan);
+            }
+            tokens.push(SourceToken {
+                kind: token.kind,
+                bytes: start..end,
+            });
+        }
+        Ok(Self { source, tokens })
+    }
+
+    fn within(&self, range: ByteRange<usize>) -> Result<&[SourceToken], SearchError> {
+        if range.start >= range.end || self.source.get(range.clone()).is_none() {
+            return Err(SearchError::InvalidSpan);
+        }
+        let start = self
+            .tokens
+            .partition_point(|token| token.bytes.end <= range.start);
+        let end = self
+            .tokens
+            .partition_point(|token| token.bytes.start < range.end);
+        let result = &self.tokens[start..end];
+        if result.is_empty()
+            || result
+                .iter()
+                .any(|token| token.bytes.start < range.start || token.bytes.end > range.end)
+        {
+            return Err(SearchError::InvalidSpan);
+        }
+        Ok(result)
+    }
+
+    fn exact(&self, range: ByteRange<usize>) -> Result<Vec<OwnedToken>, SearchError> {
+        self.within(range)?
+            .iter()
+            .map(|token| {
+                Ok(OwnedToken {
+                    kind: token.kind,
+                    text: self.source.as_bytes()[token.bytes.clone()].to_vec(),
+                })
+            })
+            .collect()
+    }
+
+    fn owns_reserved_variable(&self, range: ByteRange<usize>) -> Result<bool, SearchError> {
+        Ok(self.within(range)?.iter().any(|token| {
+            token.kind == TokenKind::Variable
+                && self.source.as_bytes()[token.bytes.clone()].starts_with(CAPTURE_PREFIX)
+        }))
+    }
+
+    fn location(&self, range: ByteRange<usize>) -> Result<SourceRange, SearchError> {
+        if self.source.get(range.clone()).is_none() || range.start > range.end {
+            return Err(SearchError::InvalidSpan);
+        }
+        Ok(SourceRange {
+            range: byte_range_to_lsp_range(self.source, range.start, range.end),
+            bytes: range,
+        })
+    }
+}
+
+fn capture_name(expression: &Expression<'_>) -> Result<Option<String>, SearchError> {
+    let Expression::Variable(Variable::Direct(variable)) = expression else {
+        return Ok(None);
+    };
+    let Some(name) = variable.name.strip_prefix(CAPTURE_PREFIX) else {
+        return Ok(None);
+    };
+    if name.is_empty()
+        || !matches!(name[0], b'a'..=b'z' | b'A'..=b'Z' | b'_')
+        || name
+            .iter()
+            .any(|byte| !byte.is_ascii_alphanumeric() && *byte != b'_')
+    {
+        return Err(SearchError::InvalidCapture);
+    }
+    Ok(Some(
+        String::from_utf8(name.to_vec()).map_err(|_| SearchError::InvalidCapture)?,
+    ))
+}
+
+fn literal_name(expression: &Expression<'_>, class: bool) -> bool {
+    matches!(expression, Expression::Identifier(_))
+        || (class
+            && matches!(
+                expression,
+                Expression::Self_(_) | Expression::Parent(_) | Expression::Static(_)
+            ))
+}
+
+fn member_name<'a>(selector: &'a ClassLikeMemberSelector<'_>) -> Result<&'a [u8], SearchError> {
+    match selector {
+        ClassLikeMemberSelector::Identifier(identifier) => Ok(identifier.value),
+        _ => Err(SearchError::UnsupportedPattern(
+            "Dynamic method names are not supported.",
+        )),
+    }
+}
+
+fn term(expression: &Expression<'_>, tokens: &Tokens<'_>) -> Result<Term, SearchError> {
+    if let Some(name) = capture_name(expression)? {
+        return Ok(Term::Capture(name));
+    }
+    let span = bytes(expression.span());
+    if tokens.owns_reserved_variable(span.clone())? {
+        return Err(SearchError::UnsupportedPattern(
+            "A capture must occupy a whole receiver or argument expression.",
+        ));
+    }
+    Ok(Term::Exact(tokens.exact(span)?))
+}
+
+impl Pattern {
+    pub(crate) fn compile(input: &str) -> Result<Self, SearchError> {
+        if input.len() > MAX_PATTERN_BYTES {
+            return Err(SearchError::PatternTooLarge);
+        }
+        let input = input.trim();
+        let mut source = if input.starts_with("<?php") {
+            input.to_owned()
+        } else {
+            format!("<?php {input}")
+        };
+        let limits = Limits {
+            source_bytes: MAX_PATTERN_BYTES + 16,
+            ..Limits::default()
+        };
+        let first_tokens = Tokens::read(&source, limits).map_err(pattern_error)?;
+        if !first_tokens
+            .tokens
+            .last()
+            .is_some_and(|token| token.kind == TokenKind::Semicolon)
+        {
+            // A newline keeps a trailing // comment from swallowing our terminator.
+            source.push_str("\n;");
+        }
+        let tokens = Tokens::read(&source, limits).map_err(pattern_error)?;
+        with_parsed_program(&source, "structural_search.compile", |program, _| {
+            Some(Self::compile_program(program, &tokens))
+        })
+        .ok_or(SearchError::ParserFailure)?
+    }
+
+    fn compile_program(program: &Program<'_>, tokens: &Tokens<'_>) -> Result<Self, SearchError> {
+        if program.has_errors() {
+            return Err(SearchError::PatternSyntax);
+        }
+        let mut expression = None;
+        for statement in program.statements.iter() {
+            match statement {
+                Statement::OpeningTag(_) => {}
+                Statement::Expression(statement) if expression.is_none() => {
+                    expression = Some(statement.expression)
+                }
+                _ => return Err(SearchError::ExpectedOneCall),
+            }
+        }
+        let Some(Expression::Call(call)) = expression else {
+            return Err(SearchError::ExpectedOneCall);
+        };
+        let head = match call {
+            Call::Function(call) if literal_name(call.function, false) => {
+                Head::Function(tokens.exact(bytes(call.function.span()))?)
+            }
+            Call::Method(call) => Head::Instance {
+                receiver: term(call.object, tokens)?,
+                method: member_name(&call.method)?.to_vec(),
+            },
+            Call::StaticMethod(call) if literal_name(call.class, true) => Head::Static {
+                class: tokens.exact(bytes(call.class.span()))?,
+                method: member_name(&call.method)?.to_vec(),
+            },
+            Call::NullSafeMethod(_) => {
+                return Err(SearchError::UnsupportedPattern(
+                    "Nullsafe call patterns are not supported yet.",
+                ));
+            }
+            _ => {
+                return Err(SearchError::UnsupportedPattern(
+                    "Use a literal function or static class name.",
+                ));
+            }
+        };
+        let list = call.get_argument_list();
+        if list.arguments.len() > MAX_ARGUMENTS {
+            return Err(SearchError::Budget("pattern arguments"));
+        }
+        let mut arguments = Vec::new();
+        let mut tail = None;
+        for (index, argument) in list.arguments.iter().enumerate() {
+            let Argument::Positional(argument) = argument else {
+                return Err(SearchError::UnsupportedPattern(
+                    "Named argument patterns are not supported.",
+                ));
+            };
+            if argument.ellipsis.is_some() {
+                if index + 1 != list.arguments.len() {
+                    return Err(SearchError::UnsupportedPattern(
+                        "A variadic capture must be the final argument.",
+                    ));
+                }
+                tail = Some(capture_name(argument.value)?.ok_or(
+                    SearchError::UnsupportedPattern(
+                        "Only ...$__ss_name may unpack a pattern argument.",
+                    ),
+                )?);
+            } else {
+                arguments.push(term(argument.value, tokens)?);
+            }
+        }
+        let mut roles = BTreeMap::new();
+        if let Head::Instance {
+            receiver: Term::Capture(name),
+            ..
+        } = &head
+        {
+            roles.insert(name.clone(), false);
+        }
+        for term in &arguments {
+            if let Term::Capture(name) = term {
+                roles.insert(name.clone(), false);
+            }
+        }
+        if let Some(name) = &tail
+            && roles.insert(name.clone(), true).is_some()
+        {
+            return Err(SearchError::CaptureRoleConflict);
+        }
+        if roles.len() > MAX_CAPTURE_NAMES {
+            return Err(SearchError::Budget("capture names"));
+        }
+        Ok(Self {
+            head,
+            arguments,
+            tail,
+        })
+    }
+
+    /// All-or-error: budget exhaustion never publishes a partial result vector.
+    /// Source must be a complete PHP document (ordinary <?php/inline handling).
+    #[cfg(test)]
+    pub(crate) fn find_in(&self, source: &str, limits: Limits) -> Result<Vec<Match>, SearchError> {
+        self.find_in_with_control(source, limits, &|| Ok(()))
+    }
+
+    /// Cooperative checks surround parsing and run through lexing, walking and
+    /// comparison. The bounded parser call itself cannot be interrupted.
+    pub(crate) fn find_in_with_control(
+        &self,
+        source: &str,
+        limits: Limits,
+        checkpoint: &(dyn Fn() -> Result<(), SearchError> + Sync),
+    ) -> Result<Vec<Match>, SearchError> {
+        let tokens = Tokens::read_with_control(source, limits, checkpoint)?;
+        checkpoint()?;
+        let result = with_parsed_program(source, "structural_search.find", |program, _| {
+            Some(self.find_program(program, &tokens, limits, checkpoint))
+        })
+        .ok_or(SearchError::ParserFailure)?;
+        checkpoint()?;
+        result
+    }
+
+    fn find_program(
+        &self,
+        program: &Program<'_>,
+        tokens: &Tokens<'_>,
+        limits: Limits,
+        checkpoint: &(dyn Fn() -> Result<(), SearchError> + Sync),
+    ) -> Result<Vec<Match>, SearchError> {
+        checkpoint()?;
+        if program.has_errors() {
+            return Err(SearchError::SourceSyntax);
+        }
+        let _lines = PassLineTable::new(tokens.source);
+        let mut visitor = Search {
+            pattern: self,
+            checkpoint,
+            tokens,
+            limits,
+            depth: 0,
+            visited: 0,
+            comparisons: 0,
+            comparison_bytes: 0,
+            result: Vec::new(),
+            error: None,
+        };
+        visitor.walk_program(program, &mut ());
+        if let Some(error) = visitor.error {
+            return Err(error);
+        }
+        visitor
+            .result
+            .sort_by_key(|item| (item.call.bytes.start, item.call.bytes.end));
+        checkpoint()?;
+        Ok(visitor.result)
+    }
+}
+
+fn pattern_error(error: SearchError) -> SearchError {
+    if error == SearchError::SourceSyntax {
+        SearchError::PatternSyntax
+    } else {
+        error
+    }
+}
+
+struct Binding {
+    first: ByteRange<usize>,
+    occurrences: Vec<ByteRange<usize>>,
+}
+
+struct Search<'p, 't, 's> {
+    pattern: &'p Pattern,
+    checkpoint: &'p (dyn Fn() -> Result<(), SearchError> + Sync),
+    tokens: &'t Tokens<'s>,
+    limits: Limits,
+    depth: usize,
+    visited: usize,
+    comparisons: usize,
+    comparison_bytes: usize,
+    result: Vec<Match>,
+    error: Option<SearchError>,
+}
+
+impl Search<'_, '_, '_> {
+    fn enter(&mut self) -> bool {
+        if self.error.is_some() {
+            return false;
+        }
+        if let Err(error) = (self.checkpoint)() {
+            self.error = Some(error);
+            return false;
+        }
+        self.visited += 1;
+        if self.visited > self.limits.nodes {
+            self.error = Some(SearchError::Budget("CST nodes"));
+            return false;
+        }
+        if self.depth >= self.limits.nesting {
+            self.error = Some(SearchError::Budget("CST nesting"));
+            return false;
+        }
+        self.depth += 1;
+        true
+    }
+
+    fn charge(&mut self, count: usize, bytes: usize) -> Result<(), SearchError> {
+        (self.checkpoint)()?;
+        self.comparisons = self
+            .comparisons
+            .checked_add(count)
+            .ok_or(SearchError::Budget("token comparisons"))?;
+        if self.comparisons > self.limits.comparisons {
+            return Err(SearchError::Budget("token comparisons"));
+        }
+        self.comparison_bytes = self
+            .comparison_bytes
+            .checked_add(bytes)
+            .ok_or(SearchError::Budget("compared bytes"))?;
+        if self.comparison_bytes > self.limits.comparison_bytes {
+            return Err(SearchError::Budget("compared bytes"));
+        }
+        Ok(())
+    }
+
+    fn exact_matches(
+        &mut self,
+        expected: &[OwnedToken],
+        range: ByteRange<usize>,
+    ) -> Result<bool, SearchError> {
+        let actual_count = self.tokens.within(range.clone())?.len();
+        let cost = range.len() + expected.iter().map(|token| token.text.len()).sum::<usize>();
+        self.charge(actual_count.max(expected.len()), cost)?;
+        let actual = self.tokens.within(range)?;
+        if actual.len() != expected.len() {
+            return Ok(false);
+        }
+        for (actual, expected) in actual.iter().zip(expected) {
+            (self.checkpoint)()?;
+            if actual.kind != expected.kind
+                || self.tokens.source.as_bytes()[actual.bytes.clone()] != expected.text
+            {
+                return Ok(false);
+            }
+        }
+        Ok(true)
+    }
+
+    fn same_expression(
+        &mut self,
+        left: ByteRange<usize>,
+        right: ByteRange<usize>,
+    ) -> Result<bool, SearchError> {
+        let left_count = self.tokens.within(left.clone())?.len();
+        let right_count = self.tokens.within(right.clone())?.len();
+        self.charge(left_count.max(right_count), left.len() + right.len())?;
+        let left = self.tokens.within(left)?;
+        let right = self.tokens.within(right)?;
+        // Both spans come from complete CST Expression nodes. Compare their
+        // syntax token sequences, not source offsets or trivia. Parentheses,
+        // quote style, name spelling/case and literal spelling remain exact.
+        if left.len() != right.len() {
+            return Ok(false);
+        }
+        for (a, b) in left.iter().zip(right) {
+            (self.checkpoint)()?;
+            if a.kind != b.kind
+                || self.tokens.source.as_bytes()[a.bytes.clone()]
+                    != self.tokens.source.as_bytes()[b.bytes.clone()]
+            {
+                return Ok(false);
+            }
+        }
+        Ok(true)
+    }
+
+    fn match_term(
+        &mut self,
+        expected: &Term,
+        expression: &Expression<'_>,
+        bindings: &mut BTreeMap<String, Binding>,
+    ) -> Result<bool, SearchError> {
+        let range = bytes(expression.span());
+        match expected {
+            Term::Exact(expected) => self.exact_matches(expected, range),
+            Term::Capture(name) => {
+                // Validate even a first occurrence before storing any span.
+                self.tokens.within(range.clone())?;
+                if let Some(previous) = bindings.get_mut(name) {
+                    if !self.same_expression(previous.first.clone(), range.clone())? {
+                        return Ok(false);
+                    }
+                    previous.occurrences.push(range);
+                } else {
+                    bindings.insert(
+                        name.clone(),
+                        Binding {
+                            first: range.clone(),
+                            occurrences: vec![range],
+                        },
+                    );
+                }
+                Ok(true)
+            }
+        }
+    }
+
+    fn match_call(&mut self, call: &Call<'_>) -> Result<Option<Match>, SearchError> {
+        (self.checkpoint)()?;
+        let list = call.get_argument_list();
+        if list.arguments.len() > MAX_ARGUMENTS {
+            return Err(SearchError::Budget("candidate arguments"));
+        }
+        // A candidate sequence has fixed known positional arity only. Do not
+        // reinterpret named keys or runtime unpacking as positional expressions.
+        if list.arguments.iter().any(|argument| !matches!(argument, Argument::Positional(argument) if argument.ellipsis.is_none())) {
+            return Ok(None);
+        }
+        let minimum = self.pattern.arguments.len();
+        if list.arguments.len() < minimum
+            || (self.pattern.tail.is_none() && list.arguments.len() != minimum)
+        {
+            return Ok(None);
+        }
+        let mut bindings = BTreeMap::new();
+        let pattern = self.pattern;
+        let head_matches = match (&pattern.head, call) {
+            (Head::Function(expected), Call::Function(actual))
+                if literal_name(actual.function, false) =>
+            {
+                self.exact_matches(expected, bytes(actual.function.span()))?
+            }
+            (Head::Instance { receiver, method }, Call::Method(actual)) => {
+                matches!(&actual.method, ClassLikeMemberSelector::Identifier(name) if name.value == method.as_slice())
+                    && self.match_term(receiver, actual.object, &mut bindings)?
+            }
+            (Head::Static { class, method }, Call::StaticMethod(actual))
+                if literal_name(actual.class, true) =>
+            {
+                matches!(&actual.method, ClassLikeMemberSelector::Identifier(name) if name.value == method.as_slice())
+                    && self.exact_matches(class, bytes(actual.class.span()))?
+            }
+            _ => false,
+        };
+        if !head_matches {
+            return Ok(None);
+        }
+        for (expected, actual) in pattern.arguments.iter().zip(list.arguments.iter()) {
+            if !self.match_term(expected, actual.value(), &mut bindings)? {
+                return Ok(None);
+            }
+        }
+        let mut captures = BTreeMap::new();
+        for (name, binding) in bindings {
+            let mut occurrences = binding.occurrences;
+            occurrences.sort_by_key(|range| (range.start, range.end));
+            captures.insert(
+                name,
+                Capture::Expression(
+                    occurrences
+                        .into_iter()
+                        .map(|range| self.tokens.location(range))
+                        .collect::<Result<_, _>>()?,
+                ),
+            );
+        }
+        if let Some(name) = &self.pattern.tail {
+            let arguments = list
+                .arguments
+                .iter()
+                .skip(minimum)
+                .map(|argument| self.tokens.location(bytes(argument.value().span())))
+                .collect::<Result<_, _>>()?;
+            captures.insert(name.clone(), Capture::Arguments(arguments));
+        }
+        Ok(Some(Match {
+            call: self.tokens.location(bytes(call.span()))?,
+            captures,
+        }))
+    }
+}
+
+impl<'ast, 'arena> MutWalker<'ast, 'arena, ()> for Search<'_, '_, '_> {
+    fn walk_statement(&mut self, statement: &'ast Statement<'arena>, context: &mut ()) {
+        if self.enter() {
+            walk_statement_mut(self, statement, context);
+            self.depth -= 1;
+        }
+    }
+
+    fn walk_expression(&mut self, expression: &'ast Expression<'arena>, context: &mut ()) {
+        if self.enter() {
+            walk_expression_mut(self, expression, context);
+            self.depth -= 1;
+        }
+    }
+
+    fn walk_in_call(&mut self, call: &'ast Call<'arena>, _: &mut ()) {
+        if self.error.is_some() {
+            return;
+        }
+        match self.match_call(call) {
+            Ok(Some(found)) if self.result.len() < self.limits.matches => self.result.push(found),
+            Ok(Some(_)) => self.error = Some(SearchError::Budget("matches")),
+            Ok(None) => {}
+            Err(error) => self.error = Some(error),
+        }
+    }
+}
+
+#[path = "structural_scan.rs"]
+pub(crate) mod scan;
+
+#[path = "structural_search_wire.rs"]
+pub(crate) mod wire;
+
+#[path = "structural_search_control.rs"]
+pub(crate) mod control;
+
+#[cfg(test)]
+#[path = "structural_search_tests.rs"]
+mod tests;

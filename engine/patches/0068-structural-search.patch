@@ -0,0 +1,126 @@
+//! Per-router test barrier for real asynchronous structural requests.
+//! All Condvar waiting happens on the existing real blocking request worker.
+
+use std::sync::Arc;
+use std::time::Duration;
+
+use parking_lot::{Condvar, Mutex};
+use tokio::sync::oneshot;
+
+use super::ProjectRouter;
+use crate::structural_search::control::{Control, Stop};
+
+const SAFETY_TIMEOUT: Duration = Duration::from_secs(10);
+
+pub(crate) struct WorkerBarrier {
+    reached: Mutex<Option<oneshot::Sender<Paused>>>,
+    finished: Mutex<Option<oneshot::Sender<Finished>>>,
+    release: Arc<(Mutex<bool>, Condvar)>,
+}
+
+pub(super) struct Harness {
+    reached: oneshot::Receiver<Paused>,
+    finished: oneshot::Receiver<Finished>,
+    release: Arc<(Mutex<bool>, Condvar)>,
+}
+
+pub(super) struct Paused {
+    pub control: Control,
+    pub prepared_ok: bool,
+}
+
+pub(super) struct Finished {
+    pub stopped: Option<Stop>,
+}
+
+pub(super) struct WorkerFinished {
+    barrier: Arc<WorkerBarrier>,
+    control: Control,
+}
+
+impl WorkerBarrier {
+    /// Arms exactly the next structurally admitted worker on this router.
+    /// No process-global/TLS hook and no second worker or task is introduced.
+    pub(super) fn arm(router: &ProjectRouter) -> Harness {
+        let (reached_tx, reached_rx) = oneshot::channel();
+        let (finished_tx, finished_rx) = oneshot::channel();
+        let release = Arc::new((Mutex::new(false), Condvar::new()));
+        let barrier = Arc::new(Self {
+            reached: Mutex::new(Some(reached_tx)),
+            finished: Mutex::new(Some(finished_tx)),
+            release: Arc::clone(&release),
+        });
+        let mut slot = router.structural_test_barrier.lock();
+        assert!(slot.is_none(), "one worker barrier per router at a time");
+        *slot = Some(barrier);
+        Harness {
+            reached: reached_rx,
+            finished: finished_rx,
+            release,
+        }
+    }
+
+    pub(super) fn finish_guard(self: &Arc<Self>, control: &Control) -> WorkerFinished {
+        WorkerFinished {
+            barrier: Arc::clone(self),
+            control: control.clone(),
+        }
+    }
+
+    /// Hook location: AFTER prepared-current-semantics returns its result,
+    /// BEFORE the existing blocking closure returns. All semantic locks and
+    /// routing read guards must already have left scope at this boundary.
+    pub(super) fn pause(&self, control: &Control, prepared_ok: bool) {
+        if let Some(sender) = self.reached.lock().take() {
+            let _ = sender.send(Paused {
+                control: control.clone(),
+                prepared_ok,
+            });
+        }
+        let (released, condition) = &*self.release;
+        let mut released = released.lock();
+        while !*released {
+            condition.wait(&mut released);
+        }
+    }
+}
+
+impl Harness {
+    pub(super) async fn paused(&mut self) -> Paused {
+        tokio::time::timeout(SAFETY_TIMEOUT, &mut self.reached)
+            .await
+            .expect("real structural worker did not reach its publication barrier")
+            .expect("real structural worker exited before signaling the barrier")
+    }
+
+    pub(super) async fn finished(&mut self) -> Finished {
+        tokio::time::timeout(SAFETY_TIMEOUT, &mut self.finished)
+            .await
+            .expect("real structural blocking closure did not finish after release")
+            .expect("real structural completion observation was dropped")
+    }
+
+    pub(super) fn release(&self) {
+        let (released, condition) = &*self.release;
+        *released.lock() = true;
+        condition.notify_all();
+    }
+}
+
+impl Drop for Harness {
+    fn drop(&mut self) {
+        // Assertion failure/timeout must never strand a spawn_blocking task
+        // and hang the runtime's own shutdown while unwinding this test.
+        self.release();
+    }
+}
+
+impl Drop for WorkerFinished {
+    fn drop(&mut self) {
+        if let Some(sender) = self.barrier.finished.lock().take() {
+            let _ = sender.send(Finished {
+                stopped: self.control.checkpoint().err(),
+            });
+        }
+    }
+}

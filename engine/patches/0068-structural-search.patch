+impl Fixture {
+    fn new() -> Self {
+        let directory = tempfile::tempdir().unwrap();
+        let root = directory.path().join("project");
+        std::fs::create_dir_all(&root).unwrap();
+        let backend = Backend::new_test();
+        *backend.workspace.workspace_root.write() = Some(root.clone());

+//! Structural scans release the routing gate while doing bounded blocking work.
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use tower_lsp::jsonrpc::{Error, ErrorCode, Result};
+use tower_lsp::lsp_types::Url;
+
+use super::{ProjectRouter, StructuralSearchQuery, StructuralSearchReply};
+use crate::structural_search::{Pattern, SearchError, control, scan, wire};
+
+#[cfg(test)]
+#[path = "project_router_structural_search_async_tests.rs"]
+mod async_tests;
+#[cfg(test)]
+#[path = "project_router_structural_search_test_hook.rs"]
+pub(super) mod test_hook;
+
+#[path = "project_router_structural_expected.rs"]
+mod expected;
+
+#[cfg(test)]
+#[path = "project_router_structural_expected_tests.rs"]
+mod expected_tests;
+
+fn scan_error(error: scan::ScanError) -> Error {
+    match error {
+        scan::ScanError::InvalidInput(message) => Error::invalid_params(message),
+        scan::ScanError::ContentModified => Error {
+            code: ErrorCode::ServerError(-32801),
+            message: "PHP project state changed during structural search".into(),
+            data: None,
+        },
+        scan::ScanError::Cancelled | scan::ScanError::Matcher(SearchError::Cancelled) => Error {
+            code: ErrorCode::ServerError(-32800),
+            message: "Structural search was canceled".into(),
+            data: None,
+        },
+        scan::ScanError::Deadline | scan::ScanError::Matcher(SearchError::Deadline) => Error {
+            code: ErrorCode::ServerError(-32001),
+            message: "Structural search exceeded its time budget".into(),
+            data: None,
+        },
+        scan::ScanError::Budget(reason) | scan::ScanError::Matcher(SearchError::Budget(reason)) => {
+            Error {
+                code: ErrorCode::ServerError(-32001),
+                message: format!("Structural search limit reached: {reason}").into(),
+                data: None,
+            }
+        }
+        scan::ScanError::Matcher(SearchError::ParserFailure | SearchError::InvalidSpan) => {
+            Error::internal_error()
+        }
+        scan::ScanError::Matcher(error) => Error::invalid_params(error.to_string()),
+    }
+}
+
+fn stopped(stop: control::Stop) -> Error {
+    scan_error(match stop {
+        control::Stop::Cancelled => scan::ScanError::Cancelled,
+        control::Stop::Deadline => scan::ScanError::Deadline,
+    })
+}
+
+impl ProjectRouter {
+    /// Search ordinary PHP syntax within one explicitly selected project.
+    pub async fn workbench_structural_search(
+        &self,
+        query: StructuralSearchQuery,
+    ) -> Result<StructuralSearchReply> {
+        let (_lifetime, control) = control::Lifetime::new(Instant::now() + Duration::from_secs(25));
+        let (project, expected) = {
+            let _gate = self.request_guard().await;
+            let expected = expected::Captured::capture(self, &query)?;
+            let project = self.query_project(Some(query.uri.clone())).await?;
+            (project, expected)
+        };
+        control.checkpoint().map_err(stopped)?;
+        let root = project
+            .root
+            .as_ref()
+            .map(Url::from_directory_path)
+            .transpose()
+            .map_err(|_| Error::invalid_params("Invalid structural-search project root"))?;
+        let wire_project = wire::Project {
+            id: project.id,
+            root,
+        };
+        let backend = Arc::clone(&project.backend);
+        let worker_control = control.clone();
+        #[cfg(test)]
+        let worker_barrier = self.structural_test_barrier.lock().take();
+        let (mut prepared, receipt) =
+            crate::server::run_blocking_cancel_safe("structural_search", move || {
+                #[cfg(test)]
+                let _finished = worker_barrier
+                    .as_ref()
+                    .map(|barrier| barrier.finish_guard(&worker_control));
+                worker_control.checkpoint().map_err(stopped)?;
+                let pattern = Pattern::compile(&query.pattern)
+                    .map_err(|error| scan_error(scan::ScanError::Matcher(error)))?;
+                worker_control.checkpoint().map_err(stopped)?;
+                let result: Result<_> = (|| {
+                    let expected =
+                        expected.hash(&backend.symbols.source_authority, &worker_control)?;
+                    let prepared = backend.with_prepared_current_semantics(|| {
+                        worker_control.checkpoint().map_err(stopped)?;
+                        backend
+                            .search_structural_once(
+                                &query,
+                                wire_project.clone(),
+                                &pattern,
+                                &worker_control,
+                            )
+                            .map_err(scan_error)
+                    })?;
+                    let receipt = expected.check_reply(
+                        &prepared.reply,
+                        &backend.symbols.source_authority,
+                        &worker_control,
+                    )?;
+                    Ok((prepared, receipt))
+                })();
+                #[cfg(test)]
+                if let Some(barrier) = &worker_barrier {
+                    barrier.pause(&worker_control, result.is_ok());
+                }
+                result
+            })
+            .await
+            .ok_or_else(Error::internal_error)??;
+        let _gate = self.request_guard().await;
+        control.checkpoint().map_err(stopped)?;
+        if !self
+            .contexts
+            .read()
+            .iter()
+            .any(|current| Arc::ptr_eq(current, &project))
+        {
+            return Err(scan_error(scan::ScanError::ContentModified));
+        }
+        prepared
+            .validate_open_state(&project.backend)
+            .map_err(scan_error)?;
+        control.checkpoint().map_err(stopped)?;
+        receipt.publish(self, &mut prepared.reply)?;
+        control.checkpoint().map_err(stopped)?;
+        Ok(prepared.reply)
+    }
+}

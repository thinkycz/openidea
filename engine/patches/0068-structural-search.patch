+#[cfg(test)]
+mod document_symbol_pending_tests {
+    use super::*;
+    use tower_lsp::{LanguageServer, lsp_types::*};
+
+    #[tokio::test]
+    async fn document_symbols_prepare_pending_change_and_undo_on_first_request() {
+        let backend = Backend::new_test();
+        let directory = tempfile::tempdir().unwrap();
+        let path = directory.path().join("outline.php");
+        let uri = Url::from_file_path(&path).unwrap();
+        let original = "<?php\njson_decode('disk');\n";
+        let changed = "<?php\n/* ž😀 */ function liveMarker() {}\nclass LiveClass {}\nconst LIVE_VALUE = 1;\n";
+        std::fs::write(&path, original).unwrap();
+        let initial = Arc::new(original.to_owned());
+        backend
+            .diag
+            .documents
+            .lock()
+            .open(uri.as_str(), 1, &initial);
+        backend
+            .open_files
+            .write()
+            .insert(uri.to_string(), Arc::clone(&initial));
+        assert!(backend.parse_diagnostic_snapshot(uri.as_str(), &initial));
+        for (version, source, expected) in [
+            (2, changed, vec!["liveMarker", "LiveClass", "LIVE_VALUE"]),
+            (3, original, vec![]),
+        ] {
+            let text = Arc::new(source.to_owned());
+            // Accepted didChange text, before its asynchronous AST publication.
+            assert!(
+                backend
+                    .diag
+                    .documents
+                    .lock()
+                    .change(uri.as_str(), version, &text)
+            );
+            backend
+                .open_files
+                .write()
+                .insert(uri.to_string(), Arc::clone(&text));
+            let revision = backend
+                .diag
+                .documents
+                .lock()
+                .capture(uri.as_str(), &text)
+                .unwrap();
+            assert!(
+                !backend
+                    .diag
+                    .documents
+                    .lock()
+                    .parsed(uri.as_str(), revision.as_ref())
+            );
+            let response = backend
+                .document_symbol(DocumentSymbolParams {
+                    text_document: TextDocumentIdentifier { uri: uri.clone() },
+                    work_done_progress_params: WorkDoneProgressParams::default(),
+                    partial_result_params: PartialResultParams::default(),
+                })
+                .await
+                .unwrap();
+            let symbols = match response {
+                Some(DocumentSymbolResponse::Nested(symbols)) => symbols,
+                None => vec![],
+                _ => panic!("expected nested symbols"),
+            };
+            let names: Vec<_> = symbols.iter().map(|symbol| symbol.name.as_str()).collect();
+            assert_eq!(
+                names, expected,
+                "first request must use accepted revision {version}"
+            );
+            if version == 2 {
+                let start = changed.find("liveMarker").unwrap();
+                let prefix = &changed[..start];
+                assert_eq!(
+                    symbols[0].selection_range.start,
+                    Position::new(
+                        1,
+                        prefix.rsplit('\n').next().unwrap().encode_utf16().count() as u32
+                    )
+                );
+            }
+        }
+        assert_eq!(std::fs::read_to_string(path).unwrap(), original);
+        let _publication = backend.begin_semantic_publication();
+        let response = backend
+            .document_symbol(DocumentSymbolParams {
+                text_document: TextDocumentIdentifier { uri },
+                work_done_progress_params: WorkDoneProgressParams::default(),
+                partial_result_params: PartialResultParams::default(),
+            })
+            .await;
+        assert_eq!(response.unwrap_err().code, ErrorCode::ServerError(-32801));
+    }
+}

+//! Real async request cancellation, concurrent edits and project retirement.
+
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+use std::time::Duration;
+
+use serde_json::json;
+use tower_lsp::LanguageServer;
+use tower_lsp::jsonrpc::ErrorCode;
+use tower_lsp::lsp_types::*;
+
+use super::super::StructuralSearchQuery;
+use super::ProjectRouter;
+use super::test_hook::WorkerBarrier;
+use crate::structural_search::control::Stop;
+
+const SAFETY_TIMEOUT: Duration = Duration::from_secs(10);
+
+struct Fixture {
+    _directory: tempfile::TempDir,
+    root: PathBuf,
+    source: PathBuf,
+    router: Arc<ProjectRouter>,
+}
+
+fn make_project(root: &Path, marker: &str) -> PathBuf {
+    std::fs::create_dir_all(root.join("src")).unwrap();
+    std::fs::write(
+        root.join("composer.json"),
+        r#"{"autoload":{"psr-4":{"App\\":"src/"}}}"#,
+    )
+    .unwrap();
+    let source = root.join("index.php");
+    std::fs::write(&source, format!("<?php foo('{marker}');\r\n")).unwrap();
+    source
+}
+
+impl Fixture {
+    async fn new() -> Self {
+        let directory = tempfile::tempdir().unwrap();
+        let root = directory.path().canonicalize().unwrap().join("a");
+        let source = make_project(&root, "disk");
+        let router = Arc::new(ProjectRouter::new_test());
+        router
+            .initialize(InitializeParams {
+                root_uri: Some(Url::from_directory_path(&root).unwrap()),
+                workspace_folders: Some(vec![WorkspaceFolder {
+                    uri: Url::from_directory_path(&root).unwrap(),
+                    name: "project-a".into(),
+                }]),
+                ..InitializeParams::default()
+            })
+            .await
+            .unwrap();
+        router.initialized(InitializedParams {}).await;
+        let original = std::fs::read_to_string(&source).unwrap();
+        router
+            .did_open(DidOpenTextDocumentParams {
+                text_document: TextDocumentItem {
+                    uri: Url::from_file_path(&source).unwrap(),
+                    language_id: "php".into(),
+                    version: 1,
+                    text: original,
+                },
+            })
+            .await;
+        // Finish actual first-request readiness before arming the narrow
+        // worker barrier. No semantic retry/timing loop is used in this test.
+        let warm = router
+            .workbench_structural_search(query(&source, 1))
+            .await
+            .unwrap();
+        assert_eq!(
+            warm.files
+                .iter()
+                .map(|file| file.matches.len())
+                .sum::<usize>(),
+            1
+        );
+        Self {
+            _directory: directory,
+            root,
+            source,
+            router,
+        }
+    }
+
+    fn spawn_search(
+        &self,
+        generation: u64,
+    ) -> tokio::task::JoinHandle<tower_lsp::jsonrpc::Result<super::super::StructuralSearchReply>>
+    {
+        let router = Arc::clone(&self.router);
+        let query = query(&self.source, generation);
+        tokio::spawn(async move { router.workbench_structural_search(query).await })
+    }
+}
+
+fn query(source: &Path, generation: u64) -> StructuralSearchQuery {
+    serde_json::from_value(json!({
+        "uri": Url::from_file_path(source).unwrap(),
+        "generation": generation,
+        "pattern": "foo($__ss_value)",
+        "scope": "document",
+    }))
+    .unwrap()
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn structural_async_abort_drops_actual_request_owner_worker_observes_cancel_and_finishes() {
+    let fixture = Fixture::new().await;
+    let original = std::fs::read(&fixture.source).unwrap();
+    let mut barrier = WorkerBarrier::arm(&fixture.router);
+    let request = fixture.spawn_search(11);
+    let paused = barrier.paused().await;
+    assert!(
+        paused.prepared_ok,
+        "must pause a real successful prepared scan"
+    );
+    assert_eq!(paused.control.checkpoint(), Ok(()));
+
+    request.abort();
+    let joined = tokio::time::timeout(SAFETY_TIMEOUT, request)
+        .await
+        .expect("aborted request future was not dropped");
+    assert!(joined.unwrap_err().is_cancelled());
+    // Awaiting the aborted JoinHandle establishes that its actual handler
+    // frame (and Lifetime) was dropped. This is not a synthetic flag write.
+    assert_eq!(paused.control.checkpoint(), Err(Stop::Cancelled));
+    barrier.release();
+    assert_eq!(barrier.finished().await.stopped, Some(Stop::Cancelled));
+
+    let independent = tokio::time::timeout(
+        SAFETY_TIMEOUT,
+        fixture
+            .router
+            .workbench_structural_search(query(&fixture.source, 12)),
+    )
+    .await
+    .expect("independent actual request stopped answering after cancellation")
+    .unwrap();
+    assert_eq!(independent.generation, 12);
+    assert_eq!(
+        independent
+            .files
+            .iter()
+            .map(|file| file.matches.len())
+            .sum::<usize>(),
+        1
+    );
+    assert_eq!(std::fs::read(&fixture.source).unwrap(), original);
+    fixture.router.shutdown().await.unwrap();
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn structural_async_did_change_completes_while_worker_paused_then_old_reply_refuses() {
+    let fixture = Fixture::new().await;
+    let original = std::fs::read(&fixture.source).unwrap();
+    let mut barrier = WorkerBarrier::arm(&fixture.router);
+    let request = fixture.spawn_search(21);
+    assert!(barrier.paused().await.prepared_ok);
+    let live = "<?php /* ž🐘 */ foo('changed'); foo('second');\r\n";
+    // Await the actual router notification to completion BEFORE releasing
+    // the worker: retaining the request read gate must fail this test.
+    tokio::time::timeout(
+        SAFETY_TIMEOUT,
+        fixture.router.did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: Url::from_file_path(&fixture.source).unwrap(),
+                version: 2,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: live.into(),
+            }],
+        }),
+    )
+    .await
+    .expect("didChange was queued behind the paused structural worker");
+    barrier.release();
+    assert_eq!(barrier.finished().await.stopped, None);
+    let result = tokio::time::timeout(SAFETY_TIMEOUT, request)
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(result.unwrap_err().code, ErrorCode::ServerError(-32801));
+
+    let fresh = fixture
+        .router
+        .workbench_structural_search(query(&fixture.source, 22))
+        .await
+        .unwrap();
+    assert_eq!(fresh.files.len(), 1);
+    assert_eq!(fresh.files[0].matches.len(), 2);
+    assert_eq!(
+        serde_json::to_value(&fresh.files[0].stamp).unwrap()["source"]["version"],
+        2
+    );
+    assert_eq!(std::fs::read(&fixture.source).unwrap(), original);
+    fixture.router.shutdown().await.unwrap();
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn structural_async_project_rebuild_completes_while_worker_paused_and_retires_old_arc() {
+    let fixture = Fixture::new().await;
+    let old_original = std::fs::read(&fixture.source).unwrap();
+    let old_context = fixture
+        .router
+        .query_project(Some(Url::from_file_path(&fixture.source).unwrap()))
+        .await
+        .unwrap();
+    let other_root = fixture._directory.path().canonicalize().unwrap().join("b");
+    let other_source = make_project(&other_root, "other");
+    let other_original = std::fs::read(&other_source).unwrap();
+    let mut barrier = WorkerBarrier::arm(&fixture.router);
+    let request = fixture.spawn_search(31);
+    assert!(barrier.paused().await.prepared_ok);
+
+    tokio::time::timeout(
+        SAFETY_TIMEOUT,
+        fixture
+            .router
+            .did_change_workspace_folders(DidChangeWorkspaceFoldersParams {
+                event: WorkspaceFoldersChangeEvent {
+                    removed: vec![WorkspaceFolder {
+                        uri: Url::from_directory_path(&fixture.root).unwrap(),
+                        name: "project-a".into(),
+                    }],
+                    added: vec![WorkspaceFolder {
+                        uri: Url::from_directory_path(&other_root).unwrap(),
+                        name: "project-b".into(),
+                    }],
+                },
+            }),
+    )
+    .await
+    .expect("project rebuild was queued behind the paused structural worker");
+    assert!(
+        !fixture
+            .router
+            .contexts
+            .read()
+            .iter()
+            .any(|current| Arc::ptr_eq(current, &old_context)),
+        "this control must actually retire the captured project, not merely edit a setting"
+    );
+    barrier.release();
+    assert_eq!(barrier.finished().await.stopped, None);
+    let result = tokio::time::timeout(SAFETY_TIMEOUT, request)
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(result.unwrap_err().code, ErrorCode::ServerError(-32801));
+
+    let fresh = fixture
+        .router
+        .workbench_structural_search(query(&other_source, 32))
+        .await
+        .unwrap();
+    assert_ne!(fresh.project.id, old_context.id);
+    assert_eq!(fresh.files.len(), 1);
+    assert_eq!(
+        fresh.files[0].stamp.uri.to_file_path().unwrap(),
+        other_source
+    );
+    assert_eq!(std::fs::read(&fixture.source).unwrap(), old_original);
+    assert_eq!(std::fs::read(&other_source).unwrap(), other_original);
+    fixture.router.shutdown().await.unwrap();
+}

+#[test]
+fn structural_cancelled_request_publishes_no_matches() {
+    let pattern = Pattern::compile("foo($__ss_value)").unwrap();
+    let result = pattern.find_in_with_control("<?php foo(1); foo(2);", Limits::default(), &|| {
+        Err(SearchError::Cancelled)
+    });
+    assert_eq!(result, Err(SearchError::Cancelled));
+}
+
+#[test]
+fn structural_expired_request_refuses_before_invalid_source_parsing() {
+    let pattern = Pattern::compile("foo($__ss_value)").unwrap();
+    let result = pattern.find_in_with_control("<?php foo(", Limits::default(), &|| {
+        Err(SearchError::Deadline)
+    });
+    assert_eq!(result, Err(SearchError::Deadline));
+}
+
+#[test]
+fn structural_each_checkpoint_refuses_partial_results_and_preserves_normal_matching() {
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    let pattern = Pattern::compile("foo($__ss_value, $__ss_value)").unwrap();
+    let source = "<?php foo(bar(1) + 2, bar(1) + 2); foo(3, 3);";
+    let count = AtomicUsize::new(0usize);
+    let expected = pattern.find_in(source, Limits::default()).unwrap();
+    let actual = pattern
+        .find_in_with_control(source, Limits::default(), &|| {
+            count.fetch_add(1, Ordering::Relaxed);
+            Ok(())
+        })
+        .unwrap();
+    assert_eq!(actual, expected);
+    assert_eq!(actual.len(), 2);
+    // Exercise lexical, parsed-node, repeated-expression comparison and final
+    // publication boundaries, including after an earlier match was collected.
+    let total = count.load(Ordering::Relaxed);
+    assert!(total > 40);
+    for stop_at in 1..=total {
+        let seen = AtomicUsize::new(0usize);
+        let actual = pattern.find_in_with_control(source, Limits::default(), &|| {
+            seen.fetch_add(1, Ordering::Relaxed);
+            if seen.load(Ordering::Relaxed) == stop_at {
+                Err(SearchError::Cancelled)
+            } else {
+                Ok(())
+            }
+        });
+        assert_eq!(
+            actual,
+            Err(SearchError::Cancelled),
+            "checkpoint {stop_at}/{total}"
+        );
+    }
+}
+
+#[test]
+fn structural_dropped_owner_stops_matching_after_lexing() {
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    use std::time::{Duration, Instant};
+    let source = "<?php foo(1); foo(2);";
+    let pattern = Pattern::compile("foo($__ss_value)").unwrap();
+    let lex_checks = AtomicUsize::new(0usize);
+    super::Tokens::read_with_control(source, Limits::default(), &|| {
+        lex_checks.fetch_add(1, Ordering::Relaxed);
+        Ok(())
+    })
+    .unwrap();
+    let (owner, worker) = super::control::Lifetime::new(Instant::now() + Duration::from_secs(30));
+    let owner = std::sync::Mutex::new(Some(owner));
+    let checks = AtomicUsize::new(0usize);
+    let actual = pattern.find_in_with_control(source, Limits::default(), &|| {
+        checks.fetch_add(1, Ordering::Relaxed);
+        if checks.load(Ordering::Relaxed) == lex_checks.load(Ordering::Relaxed) + 5 {
+            drop(owner.lock().unwrap().take());
+        }
+        worker.checkpoint().map_err(SearchError::from)
+    });
+    assert_eq!(actual, Err(SearchError::Cancelled));
+    assert!(checks.load(Ordering::Relaxed) > lex_checks.load(Ordering::Relaxed));
+    assert_eq!(pattern.find_in(source, Limits::default()).unwrap().len(), 2);
+}

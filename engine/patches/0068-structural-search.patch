+            .did_change(DidChangeTextDocumentParams {
+                text_document: VersionedTextDocumentIdentifier {
+                    uri: uri(&self.b),
+                    version: 2,
+                },
+                content_changes: vec![TextDocumentContentChangeEvent {
+                    range: None,
+                    range_length: None,
+                    text: self.b_text.replace("foo('b')", "foo('c')"),
+                }],
+            })
+            .await;
+    }
+
+    async fn unchanged_disk(&self) {
+        assert_eq!(std::fs::read(&self.a).unwrap(), self.a_text.as_bytes());
+        assert_eq!(std::fs::read(&self.b).unwrap(), self.b_text.as_bytes());
+        assert_eq!(
+            std::fs::read(&self.nested).unwrap(),
+            self.nested_text.as_bytes()
+        );

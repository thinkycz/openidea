+//! Cooperative lifetime shared by the async request and its blocking worker.
+
+use std::sync::{
+    Arc,
+    atomic::{AtomicBool, Ordering},
+};
+use std::time::Instant;
+
+#[derive(Clone)]
+pub(crate) struct Control {
+    cancelled: Arc<AtomicBool>,
+    deadline: Instant,
+}
+
+pub(crate) struct Lifetime {
+    cancelled: Arc<AtomicBool>,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) enum Stop {
+    Cancelled,
+    Deadline,
+}
+
+impl Lifetime {
+    pub(crate) fn new(deadline: Instant) -> (Self, Control) {
+        let cancelled = Arc::new(AtomicBool::new(false));
+        (
+            Self {
+                cancelled: Arc::clone(&cancelled),
+            },
+            Control {
+                cancelled,
+                deadline,
+            },
+        )
+    }
+}
+
+impl Drop for Lifetime {
+    fn drop(&mut self) {
+        self.cancelled.store(true, Ordering::Release);
+    }
+}
+
+impl Control {
+    pub(crate) fn checkpoint(&self) -> Result<(), Stop> {
+        self.checkpoint_at(Instant::now())
+    }
+
+    fn checkpoint_at(&self, now: Instant) -> Result<(), Stop> {
+        if self.cancelled.load(Ordering::Acquire) {
+            return Err(Stop::Cancelled);
+        }
+        if now >= self.deadline {
+            return Err(Stop::Deadline);
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::time::Duration;
+
+    #[test]
+    fn dropped_async_owner_cancels_all_worker_clones() {
+        let now = Instant::now();
+        let (owner, worker) = Lifetime::new(now + Duration::from_secs(1));
+        let nested = worker.clone();
+        assert_eq!(worker.checkpoint_at(now), Ok(()));
+        drop(owner);
+        assert_eq!(worker.checkpoint_at(now), Err(Stop::Cancelled));
+        assert_eq!(nested.checkpoint_at(now), Err(Stop::Cancelled));
+    }
+
+    #[test]
+    fn exact_deadline_refuses_without_sleep_or_clock_mutation() {
+        let now = Instant::now();
+        let deadline = now + Duration::from_secs(1);
+        let (_owner, worker) = Lifetime::new(deadline);
+        assert_eq!(worker.checkpoint_at(now), Ok(()));
+        assert_eq!(worker.checkpoint_at(deadline), Err(Stop::Deadline));
+    }
+
+    #[test]
+    fn independent_requests_do_not_cancel_each_other() {
+        let now = Instant::now();
+        let (old_owner, old) = Lifetime::new(now + Duration::from_secs(1));
+        let (_new_owner, new) = Lifetime::new(now + Duration::from_secs(1));
+        drop(old_owner);
+        assert_eq!(old.checkpoint_at(now), Err(Stop::Cancelled));
+        assert_eq!(new.checkpoint_at(now), Ok(()));
+    }
+}

+//! Read-only structural-search request and stamped result protocol.
+
+use serde::{Deserialize, Serialize};
+use std::collections::BTreeMap;
+use tower_lsp::lsp_types::{Range, Url};
+
+pub const METHOD: &str = "phpWorkbench/structuralSearch";
+pub const EXPERIMENTAL_CAPABILITY: &str = "phpWorkbenchStructuralSearch";
+
+#[derive(Clone, Copy, Debug, Default, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub enum Scope {
+    #[default]
+    Project,
+    Document,
+}
+
+/// Exact editor-owned input; validated against the router's live document set.
+#[derive(Clone, Debug, PartialEq, Eq, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ExpectedSource {
+    pub uri: Url,
+    pub version: i32,
+    pub sha256_utf8: String,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct Query {
+    /// Required consuming document: no ambiguous implicit union of projects.
+    pub uri: Url,
+    /// Host-owned generation, echoed only. Not the LSP request identifier.
+    pub generation: u64,
+    pub pattern: String,
+    #[serde(default)]
+    pub scope: Scope,
+    /// Empty is an unchecked read-only protocol query. The editor requires a
+    /// nonempty manifest including its selected source before dispatch.
+    #[serde(default)]
+    pub expected_sources: Vec<ExpectedSource>,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Project {
+    /// Process-local ProjectContext.id. Combined with host provider identity.
+    pub id: u64,
+    /// None is permitted only for explicit document scope.
+    pub root: Option<Url>,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(tag = "kind", rename_all = "camelCase")]
+pub enum SourceKind {
+    Open { version: i32, opening: u64 },
+    Disk,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct SourceStamp {
+    /// The actual preferred source spelling used to produce all ranges.
+    pub uri: Url,
+    pub source: SourceKind,
+    /// Lowercase 64-digit SHA256 of the exact UTF8 analysis text, not the
+    /// original on-disk encoding for a decoded open UTF16 document.
+    pub sha256_utf8: String,
+    pub utf8_bytes: u64,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct SourceRange {
+    pub start_byte: u32,
+    pub end_byte: u32,
+    pub range: Range,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(tag = "kind", content = "ranges", rename_all = "camelCase")]
+pub enum Capture {
+    Expression(Vec<SourceRange>),
+    Arguments(Vec<SourceRange>),
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Match {
+    /// Bounded display text only; navigation always validates the source stamp.
+    #[serde(default)]
+    pub preview: String,
+    pub call: SourceRange,
+    pub captures: BTreeMap<String, Capture>,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct FileResult {
+    pub stamp: SourceStamp,
+    /// Empty means successfully scanned with no matches, not unreadable.
+    /// Retain these ledger entries too: the source set is part of ownership.
+    pub matches: Vec<Match>,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub enum IssueKind {
+    Syntax,
+    UnsupportedTemplate,
+    UnsupportedEncoding,
+    Unreadable,
+    WalkError,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct FileIssue {
+    pub uri: Option<Url>,
+    pub kind: IssueKind,
+    /// Bounded product text, not arbitrary parser dumps or source contents.
+    pub message: String,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Reply {
+    /// Exact manifest validated before scanning and again at final admission.
+    #[serde(default)]
+    pub expected_sources: Vec<ExpectedSource>,
+    pub generation: u64,
+    pub project: Project,
+    pub files: Vec<FileResult>,
+    pub issues: Vec<FileIssue>,
+    /// True exactly when a source could not be scanned; show explicitly.
+    /// Resource exhaustion/cancellation/staleness returns RPC error instead.
+    pub incomplete: bool,
+}
+
+impl From<super::SourceRange> for SourceRange {
+    fn from(source: super::SourceRange) -> Self {
+        // The matcher admits at most u32::MAX bytes before constructing spans.
+        Self {
+            start_byte: source.bytes.start as u32,
+            end_byte: source.bytes.end as u32,
+            range: source.range,
+        }
+    }
+}
+
+impl From<super::Match> for Match {
+    fn from(found: super::Match) -> Self {
+        Self {
+            preview: String::new(),
+            call: found.call.into(),
+            captures: found
+                .captures
+                .into_iter()
+                .map(|(name, capture)| {
+                    let capture = match capture {
+                        super::Capture::Expression(ranges) => {
+                            Capture::Expression(ranges.into_iter().map(Into::into).collect())
+                        }
+                        super::Capture::Arguments(ranges) => {
+                            Capture::Arguments(ranges.into_iter().map(Into::into).collect())
+                        }
+                    };
+                    (name, capture)
+                })
+                .collect(),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn query_requires_selector_and_rejects_unknown_parameters() {
+        assert!(
+            serde_json::from_value::<Query>(json!({"generation":1,"pattern":"foo()"})).is_err()
+        );
+        assert!(
+            serde_json::from_value::<Query>(
+                json!({"uri":"file:///tmp/a.php","generation":1,"pattern":"foo()","unbounded":true})
+            )
+            .is_err()
+        );
+        let query: Query = serde_json::from_value(
+            json!({"uri":"file:///tmp/a.php","generation":1,"pattern":"foo()"}),
+        )
+        .unwrap();
+        assert!(matches!(query.scope, Scope::Project));
+        assert!(serde_json::from_value::<Query>(json!({"uri":"file:///tmp/a.php","generation":1,"pattern":"foo()","scope":"allProjects"})).is_err());
+    }
+
+    #[test]
+    fn match_wire_conversion_keeps_utf16_and_exact_byte_spans() {
+        let source = "<?php /* ž😀 */ foo('ž😀');";
+        let pattern = super::super::Pattern::compile("foo($__ss_arg)").unwrap();
+        let found = pattern
+            .find_in(source, super::super::Limits::default())
+            .unwrap()
+            .pop()
+            .unwrap();
+        let expected_call = found.call.clone();
+        let wire: Match = found.into();
+        assert_eq!(wire.call.start_byte as usize, expected_call.bytes.start);
+        assert_eq!(wire.call.end_byte as usize, expected_call.bytes.end);
+        assert_eq!(wire.call.range, expected_call.range);
+        assert_ne!(wire.call.start_byte, wire.call.range.start.character);
+        let encoded = serde_json::to_value(&wire).unwrap();
+        assert_eq!(encoded["captures"]["arg"]["kind"], "expression");
+        let decoded: Match = serde_json::from_value(encoded).unwrap();
+        assert_eq!(decoded.call.range, expected_call.range);
+    }
+
+    #[test]
+    fn reply_distinguishes_empty_scan_from_unscanned_file() {
+        let reply = Reply {
+            expected_sources: vec![],
+            generation: 19,
+            project: Project {
+                id: 7,
+                root: Some(Url::parse("file:///tmp/project/").unwrap()),
+            },
+            files: vec![FileResult {
+                stamp: SourceStamp {
+                    uri: Url::parse("file:///tmp/project/a.php").unwrap(),
+                    source: SourceKind::Open {
+                        version: 4,
+                        opening: 12,
+                    },
+                    sha256_utf8: "0".repeat(64),
+                    utf8_bytes: 5,
+                },
+                matches: vec![],
+            }],
+            issues: vec![FileIssue {
+                uri: Some(Url::parse("file:///tmp/project/b.php").unwrap()),
+                kind: IssueKind::Syntax,
+                message: "Cannot scan invalid PHP.".into(),
+            }],
+            incomplete: true,
+        };
+        let value = serde_json::to_value(&reply).unwrap();
+        assert_eq!(value["files"][0]["stamp"]["source"]["kind"], "open");
+        assert_eq!(value["files"][0]["stamp"]["source"]["opening"], 12);
+        let decoded: Reply = serde_json::from_value(value).unwrap();
+        assert_eq!(decoded.generation, 19);
+        assert_eq!(decoded.files.len(), 1);
+        assert!(decoded.files[0].matches.is_empty());
+        assert_eq!(decoded.issues.len(), 1);
+        assert!(decoded.incomplete);
+    }
+    #[test]
+    fn checked_query_and_reply_preserve_exact_editor_manifest() {
+        let expected = ExpectedSource {
+            uri: Url::parse("file:///tmp/%C5%BE%F0%9F%98%80.php").unwrap(),
+            version: 2,
+            sha256_utf8: "a".repeat(64),
+        };
+        let query: Query = serde_json::from_value(serde_json::json!({
+            "uri":expected.uri,"generation":7,"pattern":"foo($__ss_value)",
+            "expectedSources":[{"uri":expected.uri,"version":2,"sha256Utf8":expected.sha256_utf8}],
+        }))
+        .unwrap();
+        assert_eq!(query.expected_sources, vec![expected.clone()]);
+        let encoded = serde_json::to_value(&query).unwrap();
+        assert_eq!(encoded["expectedSources"][0]["version"], 2);
+        assert_eq!(encoded["expectedSources"][0]["sha256Utf8"], "a".repeat(64));
+        let reply: Reply = serde_json::from_value(serde_json::json!({
+            "generation":7,"project":{"id":1,"root":null},
+            "expectedSources":encoded["expectedSources"],
+            "files":[],"issues":[],"incomplete":false,
+        }))
+        .unwrap();
+        assert_eq!(reply.expected_sources, query.expected_sources);
+        assert!(
+            serde_json::from_value::<ExpectedSource>(serde_json::json!({
+                "uri":expected.uri,"sha256Utf8":expected.sha256_utf8,
+            }))
+            .is_err(),
+            "a declared expected source must carry its version"
+        );
+    }
+}

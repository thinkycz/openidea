+use super::*;
+
+fn find(pattern: &str, source: &str) -> Vec<Match> {
+    Pattern::compile(pattern)
+        .expect("valid pattern")
+        .find_in(source, Limits::default())
+        .expect("valid complete PHP source")
+}
+
+fn expression_texts<'a>(found: &Match, name: &str, source: &'a str) -> Vec<&'a str> {
+    let Capture::Expression(occurrences) = &found.captures[name] else {
+        panic!("expected expression capture");
+    };
+    occurrences
+        .iter()
+        .map(|range| &source[range.bytes.clone()])
+        .collect()
+}
+
+#[test]
+fn structural_function_matches_ignore_trivia_not_string_contents_or_other_call_kinds() {
+    let source = r#"<?php
+// json_decode($comment);
+$text = 'json_decode($literal)';
+json_decode /* one */ ( $payload /* two */ );
+json_encode($payload);
+$object->json_decode($payload);
+Decoder::json_decode($payload);
+"#;
+    let matches = find("json_decode($__ss_value)", source);
+    assert_eq!(matches.len(), 1);
+    assert_eq!(
+        &source[matches[0].call.bytes.clone()],
+        "json_decode /* one */ ( $payload /* two */ )"
+    );
+    assert_eq!(
+        expression_texts(&matches[0], "value", source),
+        vec!["$payload"]
+    );
+}
+
+#[test]
+fn structural_calls_keep_literal_name_case_and_qualification() {
+    let source = r"<?php render($x); Render($x); \render($x); Demo\render($x);";
+    for pattern in [
+        "render($__ss_x)",
+        "Render($__ss_x)",
+        r"\render($__ss_x)",
+        r"Demo\render($__ss_x)",
+    ] {
+        assert_eq!(find(pattern, source).len(), 1, "{pattern}");
+    }
+}
+
+#[test]
+fn structural_instance_receiver_is_a_whole_expression_and_static_is_distinct() {
+    let source = r"<?php $a->save($x); factory()->save($x); Store::save($x); $a?->save($x); $a->$method($x);";
+    let matches = find("$__ss_receiver->save($__ss_value)", source);
+    assert_eq!(matches.len(), 2);
+    assert_eq!(
+        expression_texts(&matches[1], "receiver", source),
+        vec!["factory()"]
+    );
+    assert_eq!(find("Store::save($__ss_value)", source).len(), 1);
+    assert_eq!(find("$a->save($__ss_value)", source).len(), 1);
+}
+
+#[test]
+fn structural_relative_static_class_forms_are_lexical_not_inferred() {
+    let source = "<?php class X { function f() { self::put(1); static::put(1); parent::put(1); } }";
+    for pattern in [
+        "self::put($__ss_value)",
+        "static::put($__ss_value)",
+        "parent::put($__ss_value)",
+    ] {
+        assert_eq!(find(pattern, source).len(), 1);
+    }
+}
+
+#[test]
+fn structural_repeated_capture_compares_whole_expression_syntax_without_offsets_or_trivia() {
+    let source = "<?php same($a + 1, $a/* note */+1); same($a+1, $a-1); same($a+1, $b+1); same(($a+1), $a+1);";
+    let matches = find("same($__ss_value, $__ss_value)", source);
+    assert_eq!(matches.len(), 1);
+    assert_eq!(
+        expression_texts(&matches[0], "value", source),
+        vec!["$a + 1", "$a/* note */+1"]
+    );
+}
+
+#[test]
+fn structural_repeated_capture_preserves_literal_spelling_and_string_whitespace() {
+    let source = "<?php same('a b', 'ab'); same('a b', 'a b'); same(1, 1.0); same('x', \"x\");";
+    let matches = find("same($__ss_value, $__ss_value)", source);
+    assert_eq!(matches.len(), 1);
+    assert_eq!(
+        expression_texts(&matches[0], "value", source),
+        vec!["'a b'", "'a b'"]
+    );
+}
+
+#[test]
+fn structural_repeated_receiver_and_argument_capture_share_one_binding() {
+    let source = "<?php $a->replace($a); $a->replace($b); factory()->replace(factory());";
+    let matches = find("$__ss_value->replace($__ss_value)", source);
+    assert_eq!(matches.len(), 2);
+    assert_eq!(
+        expression_texts(&matches[1], "value", source),
+        vec!["factory()", "factory()"]
+    );
+}
+
+#[test]
+fn structural_trailing_variadic_capture_includes_zero_or_many_positional_expressions() {
+    let source = "<?php emit('topic'); emit('topic', $a, fn() => 2, [1, 2]); emit('other', 3);";
+    let matches = find("emit('topic', ...$__ss_arguments)", source);
+    assert_eq!(matches.len(), 2);
+    let Capture::Arguments(empty) = &matches[0].captures["arguments"] else {
+        panic!()
+    };
+    assert!(empty.is_empty());
+    let Capture::Arguments(arguments) = &matches[1].captures["arguments"] else {
+        panic!()
+    };
+    assert_eq!(
+        arguments
+            .iter()
+            .map(|range| &source[range.bytes.clone()])
+            .collect::<Vec<_>>(),
+        vec!["$a", "fn() => 2", "[1, 2]"]
+    );
+}
+
+#[test]
+fn structural_named_and_runtime_unpacked_candidate_arguments_are_not_positional() {
+    let source = "<?php emit(value: 1); emit(...$values); emit(1, ...$values); emit(1, 2);";
+    let matches = find("emit(...$__ss_arguments)", source);
+    assert_eq!(matches.len(), 1);
+    assert_eq!(&source[matches[0].call.bytes.clone()], "emit(1, 2)");
+}
+
+#[test]
+fn structural_exact_argument_expression_ignores_trivia_and_does_not_capture_inside_it() {
+    let source =
+        "<?php send(['key' => 1], $a); send([ 'key' /*x*/ => 1 ], $b); send(['key' => 2], $c);";
+    assert_eq!(find("send(['key' => 1], $__ss_value)", source).len(), 2);
+    assert!(matches!(
+        Pattern::compile("send($__ss_value + 1)"),
+        Err(SearchError::UnsupportedPattern(_))
+    ));
+}
+
+#[test]
+fn structural_nested_real_calls_are_all_returned_in_source_order() {
+    let source = "<?php wrap(wrap($a)); function f() { wrap($b); $x = fn() => wrap($c); }";
+    let matches = find("wrap($__ss_value)", source);
+    assert_eq!(matches.len(), 4);
+    assert_eq!(
+        matches
+            .iter()
+            .map(|found| &source[found.call.bytes.clone()])
+            .collect::<Vec<_>>(),

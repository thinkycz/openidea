index 0000000..3891434
--- /dev/null
+++ b/src/structural_scan.rs
@@ -0,0 +1,695 @@
+//! Bounded single-project syntax search with immutable source ownership.
+
+use std::collections::{HashMap, HashSet};
+use std::fs::File;
+use std::io::Read;
+use std::path::{Component, Path, PathBuf};
+use std::sync::Arc;
+
+use sha2::{Digest, Sha256};
+use tower_lsp::lsp_types::Url;
+
+use crate::Backend;
+use crate::classmap_scanner::{LinkClaims, workspace_walk_builder};
+use crate::diagnostics::revision::Revision;
+use crate::source_authority::SourceIdentity;
+use crate::structural_search::control::{Control, Stop};
+use crate::structural_search::wire;
+use crate::structural_search::{self as matcher, Pattern, SearchError};
+
+#[derive(Debug)]
+pub(crate) enum ScanError {
+    InvalidInput(&'static str),
+    ContentModified,
+    Cancelled,
+    Deadline,
+    Budget(&'static str),
+    Matcher(SearchError),
+}
+
+type Result<T> = std::result::Result<T, ScanError>;
+
+#[derive(Clone, Copy)]
+struct Budget {
+    files: usize,
+    /// Counts directory/non-PHP entries too; a sparse tree is still bounded.
+    walk_entries: usize,
+    open_documents: usize,
+    input_bytes: usize,
+    file_bytes: usize,
+    matches: usize,
+    issues: usize,
+}
+
+impl Default for Budget {
+    fn default() -> Self {
+        Self {
+            files: 512,
+            walk_entries: 50_000,
+            open_documents: 512,
+            input_bytes: 32 * 1024 * 1024,
+            file_bytes: 2 * 1024 * 1024,
+            matches: 1000,
+            issues: 64,
+        }
+    }
+}
+
+struct Epochs {
+    input: Arc<()>,
+    semantic: Arc<()>,
+}
+
+struct Candidate {
+    uri: Url,
+    identity: SourceIdentity,
+}
+
+enum Guard {
+    Open {
+        uri: String,
+        identity: SourceIdentity,
+        text: Arc<String>,
+        revision: Revision,
+    },
+    Disk {
+        uri: String,
+        identity: SourceIdentity,
+        hash: String,
+    },
+}
+
+/// Retain until the router's final admission check. No persistent text cache.
+pub(crate) struct Prepared {
+    pub reply: wire::Reply,
+    epochs: Epochs,
+    guards: Vec<Guard>,
+    file_bytes: usize,
+}
+
+enum Loaded {
+    Open {
+        text: Arc<String>,
+        revision: Revision,
+    },
+    Disk(String),
+}
+
+impl Loaded {
+    fn text(&self) -> &str {
+        match self {
+            Self::Open { text, .. } => text,
+            Self::Disk(text) => text,
+        }
+    }
+}
+
+enum ReadResult {
+    Text(String),
+    Issue(wire::IssueKind),
+}
+
+fn checkpoint(control: &Control) -> Result<()> {
+    control.checkpoint().map_err(|stop| match stop {
+        Stop::Cancelled => ScanError::Cancelled,
+        Stop::Deadline => ScanError::Deadline,
+    })
+}
+
+fn matcher_checkpoint(control: &Control) -> std::result::Result<(), SearchError> {
+    control.checkpoint().map_err(|stop| match stop {
+        Stop::Cancelled => SearchError::Cancelled,
+        Stop::Deadline => SearchError::Deadline,
+    })
+}
+
+fn hash(text: &str) -> String {
+    format!("{:x}", Sha256::digest(text.as_bytes()))
+}
+
+fn issue(uri: Option<Url>, kind: wire::IssueKind) -> wire::FileIssue {
+    let message = match kind {
+        wire::IssueKind::Syntax => "PHP syntax errors prevented this file from being searched.",
+        wire::IssueKind::UnsupportedTemplate => {
+            "Template source is not supported by this PHP-only structural search."
+        }
+        wire::IssueKind::UnsupportedEncoding => {
+            "Closed source is not UTF8; open it in the editor to search its decoded text."
+        }
+        wire::IssueKind::Unreadable => "A source file could not be read.",
+        wire::IssueKind::WalkError => "Part of the project source tree could not be listed.",
+    };
+    wire::FileIssue {
+        uri,
+        kind,
+        message: message.to_owned(),
+    }
+}
+
+fn add_issue(
+    issues: &mut Vec<wire::FileIssue>,
+    value: wire::FileIssue,
+    budget: Budget,
+) -> Result<()> {
+    if issues.len() >= budget.issues {
+        return Err(ScanError::Budget("file issues"));
+    }
+    issues.push(value);
+    Ok(())
+}
+
+/// Bounded real read, including limit+1 detection. No metadata-size-only trust.
+/// Checkpoints surround OS calls; an OS read itself is not forcibly canceled.
+fn read_disk(path: &Path, limit: usize, control: &Control) -> Result<ReadResult> {
+    read_disk_after_preflight(path, limit, control, || {})
+}
+
+fn read_disk_after_preflight(
+    path: &Path,
+    limit: usize,
+    control: &Control,
+    after_preflight: impl FnOnce(),
+) -> Result<ReadResult> {
+    checkpoint(control)?;
+    // Reject special sources before open; Unix O_NONBLOCK below also closes
+    // the regular-file -> FIFO substitution race between stat and open.
+    if !std::fs::metadata(path).is_ok_and(|metadata| metadata.is_file()) {
+        return Ok(ReadResult::Issue(wire::IssueKind::Unreadable));
+    }
+    after_preflight();
+    let Ok(mut file) = open_source(path) else {
+        return Ok(ReadResult::Issue(wire::IssueKind::Unreadable));
+    };
+    if !file.metadata().is_ok_and(|metadata| metadata.is_file()) {
+        return Ok(ReadResult::Issue(wire::IssueKind::Unreadable));
+    }
+    let mut bytes = Vec::new();
+    let mut block = [0u8; 16 * 1024];
+    loop {
+        checkpoint(control)?;
+        let remaining = limit.saturating_sub(bytes.len()).saturating_add(1);
+        let take = remaining.min(block.len());
+        let count = match file.read(&mut block[..take]) {
+            Ok(count) => count,
+            Err(_) => return Ok(ReadResult::Issue(wire::IssueKind::Unreadable)),
+        };
+        if count == 0 {
+            break;
+        }
+        bytes.extend_from_slice(&block[..count]);
+        if bytes.len() > limit {
+            return Err(ScanError::Budget("source file bytes"));
+        }
+    }
+    checkpoint(control)?;
+    Ok(match String::from_utf8(bytes) {
+        Ok(text) => ReadResult::Text(text),
+        Err(_) => ReadResult::Issue(wire::IssueKind::UnsupportedEncoding),
+    })
+}
+
+#[cfg(unix)]
+fn open_source(path: &Path) -> std::io::Result<File> {
+    use rustix::fs::{Mode, OFlags};
+    rustix::fs::open(
+        path,
+        OFlags::RDONLY | OFlags::NONBLOCK | OFlags::CLOEXEC,
+        Mode::empty(),
+    )
+    .map(File::from)
+    .map_err(Into::into)
+}
+
+#[cfg(not(unix))]
+fn open_source(path: &Path) -> std::io::Result<File> {
+    // Regular-file preflight + descriptor metadata still apply. An atomic
+    // nonregular-open refusal is not claimed on these targets in this draft.
+    File::open(path)
+}
+
+fn file_uri(path: &Path) -> Result<Url> {
+    Url::from_file_path(path)
+        .map_err(|_| ScanError::InvalidInput("Source path cannot be represented as a file URI"))
+}
+
+fn file_path(uri: &Url) -> Result<PathBuf> {
+    uri.to_file_path()
+        .map_err(|_| ScanError::InvalidInput("Select a PHP file document"))
+}
+
+impl Backend {
+    /// Called inside with_prepared_current_semantics on the existing blocking
+    /// worker. ProjectRouter supplies the selected project descriptor.
+    pub(crate) fn search_structural_once(
+        &self,
+        query: &wire::Query,
+        project: wire::Project,
+        pattern: &Pattern,
+        control: &Control,
+    ) -> Result<Prepared> {
+        self.search_structural_inner(query, project, pattern, control, Budget::default(), || {})
+    }
+
+    fn search_structural_inner(
+        &self,
+        query: &wire::Query,
+        project: wire::Project,
+        pattern: &Pattern,
+        control: &Control,
+        budget: Budget,
+        before_validate: impl FnOnce(),
+    ) -> Result<Prepared> {
+        checkpoint(control)?;
+        let selector = file_path(&query.uri)?;
+        let filters = self.index_filters();
+        if !filters.is_php_file(&selector) {
+            return Err(ScanError::InvalidInput("Select a PHP source document"));
+        }
+        let epochs = {
+            let documents = self.diag.documents.lock();
+            if documents.configuration_changing() {
+                return Err(ScanError::ContentModified);
+            }
+            Epochs {
+                input: documents.input_epoch(),
+                semantic: documents.semantic_epoch(),
+            }
+        };
+        let mut issues = Vec::new();
+        let candidates = self.structural_candidates(query, budget, control, &mut issues)?;
+        let original_sources: HashSet<_> = candidates
+            .iter()
+            .map(|candidate| candidate.identity.clone())
+            .collect();
+        let mut prepared = Prepared {
+            reply: wire::Reply {
+                expected_sources: query.expected_sources.clone(),
+                generation: query.generation,
+                project,
+                files: Vec::new(),
+                issues,
+                incomplete: false,
+            },
+            epochs,
+            guards: Vec::new(),
+            file_bytes: budget.file_bytes,
+        };
+        let mut total_bytes = 0usize;
+        let mut total_matches = 0usize;
+        for candidate in candidates {
+            checkpoint(control)?;
+            let preferred = self
+                .symbols
+                .source_authority
+                .preferred(candidate.uri.as_str());
+            let uri = preferred.as_deref().unwrap_or(candidate.uri.as_str());
+            let uri = Url::parse(uri).map_err(|_| ScanError::ContentModified)?;
+            let identity = self.symbols.source_authority.fresh_identity(uri.as_str());
+            if identity != candidate.identity {
+                return Err(ScanError::ContentModified);
+            }
+            if self.is_blade_file(uri.as_str()) {
+                add_issue(
+                    &mut prepared.reply.issues,
+                    issue(Some(uri), wire::IssueKind::UnsupportedTemplate),
+                    budget,
+                )?;
+                continue;
+            }
+            let loaded = {
+                // Same lock order as with_current_semantics: revisions then files.
+                let documents = self.diag.documents.lock();
+                let files = self.open_files.read();
+                match files.get(uri.as_str()) {
+                    Some(text) => {
+                        let revision = documents
+                            .capture(uri.as_str(), text)
+                            .map_err(|()| ScanError::ContentModified)?
+                            .ok_or(ScanError::ContentModified)?;
+                        Some(Loaded::Open {
+                            text: Arc::clone(text),
+                            revision,
+                        })
+                    }
+                    None => None,
+                }
+            };
+            let loaded = match loaded {
+                Some(loaded) => loaded,
+                None if preferred.is_some() => return Err(ScanError::ContentModified),
+                None => match read_disk(&file_path(&uri)?, budget.file_bytes, control)? {
+                    ReadResult::Text(text) => Loaded::Disk(text),
+                    ReadResult::Issue(kind) => {
+                        add_issue(&mut prepared.reply.issues, issue(Some(uri), kind), budget)?;
+                        continue;
+                    }
+                },
+            };
+            let text = loaded.text();
+            if text.len() > budget.file_bytes {
+                return Err(ScanError::Budget("source file bytes"));
+            }
+            total_bytes = total_bytes
+                .checked_add(text.len())
+                .ok_or(ScanError::Budget("aggregate input bytes"))?;
+            if total_bytes > budget.input_bytes {
+                return Err(ScanError::Budget("aggregate input bytes"));
+            }
+            let sha256 = hash(text);
+            let source = match &loaded {
+                Loaded::Open { revision, .. } => wire::SourceKind::Open {
+                    version: revision.version,
+                    opening: revision.open,
+                },
+                Loaded::Disk(_) => wire::SourceKind::Disk,
+            };
+            let stamp = wire::SourceStamp {
+                uri: uri.clone(),
+                source,
+                sha256_utf8: sha256.clone(),
+                utf8_bytes: text.len() as u64,
+            };
+            let limits = matcher::Limits {
+                source_bytes: budget.file_bytes,
+                matches: budget.matches.saturating_sub(total_matches),
+                ..matcher::Limits::default()
+            };
+            let matches =
+                pattern.find_in_with_control(text, limits, &|| matcher_checkpoint(control));
+            // Retain ownership also for a syntax-issue source: its text was
+            // observed in this query, even though no ranges can be published.
+            match &loaded {
+                Loaded::Open { text, revision } => prepared.guards.push(Guard::Open {
+                    uri: uri.to_string(),
+                    identity,
+                    text: Arc::clone(text),
+                    revision: revision.clone(),
+                }),
+                Loaded::Disk(_) => prepared.guards.push(Guard::Disk {
+                    uri: uri.to_string(),
+                    identity,
+                    hash: sha256,
+                }),
+            }
+            match matches {
+                Ok(matches) => {
+                    total_matches += matches.len();
+                    prepared.reply.files.push(wire::FileResult {
+                        stamp,
+                        matches: matches
+                            .into_iter()
+                            .map(|found| {
+                                let source = &text[found.call.bytes.clone()];
+                                let mut chars = source.chars();
+                                let mut preview: String = chars
+                                    .by_ref()
+                                    .take(160)
+                                    .map(|ch| {
+                                        if ch == '\r' || ch == '\n' || ch == '\t' {
+                                            ' '
+                                        } else {
+                                            ch
+                                        }
+                                    })
+                                    .collect();
+                                if chars.next().is_some() {
+                                    preview.push('…');
+                                }
+                                let mut result = wire::Match::from(found);
+                                result.preview = preview;
+                                result
+                            })
+                            .collect(),
+                    });
+                }
+                Err(SearchError::SourceSyntax) => add_issue(
+                    &mut prepared.reply.issues,
+                    issue(Some(uri), wire::IssueKind::Syntax),
+                    budget,
+                )?,
+                Err(SearchError::Cancelled) => return Err(ScanError::Cancelled),
+                Err(SearchError::Deadline) => return Err(ScanError::Deadline),
+                Err(SearchError::Budget(reason)) => return Err(ScanError::Budget(reason)),
+                Err(error) => return Err(ScanError::Matcher(error)),
+            }
+        }
+        before_validate();
+        prepared.validate_open_state(self)?;
+        // Detect additions/removals even before a filesystem watcher arrives.
+        // This is a second bounded shared-policy walk, not an atomic filesystem
+        // transaction. Changes after final observation remain possible.
+        let mut repeated_issues = Vec::new();
+        let refreshed = self.structural_candidates(query, budget, control, &mut repeated_issues)?;
+        let refreshed_sources: HashSet<_> = refreshed
+            .into_iter()
+            .map(|candidate| candidate.identity)
+            .collect();
+        if original_sources != refreshed_sources {
+            return Err(ScanError::ContentModified);
+        }
+        if !repeated_issues.is_empty() {
+            // A final discovery failure prevents claiming source-set equality.
+            // Preserve a bounded explicit incomplete reply when discovery is
+            // already incomplete; do not silently flatten the new failure.
+            for repeated in repeated_issues {
+                if !prepared.reply.issues.iter().any(|previous| {
+                    previous.uri == repeated.uri && previous.message == repeated.message
+                }) {
+                    add_issue(&mut prepared.reply.issues, repeated, budget)?;
+                }
+            }
+        }
+        prepared.validate_full(self, control)?;
+        prepared
+            .reply
+            .files
+            .sort_by(|a, b| a.stamp.uri.as_str().cmp(b.stamp.uri.as_str()));
+        prepared.reply.issues.sort_by(|a, b| {
+            a.uri
+                .as_ref()
+                .map(Url::as_str)
+                .cmp(&b.uri.as_ref().map(Url::as_str))
+                .then(a.message.cmp(&b.message))
+        });
+        prepared.reply.incomplete = !prepared.reply.issues.is_empty();
+        Ok(prepared)
+    }
+
+    fn structural_candidates(
+        &self,
+        query: &wire::Query,
+        budget: Budget,
+        control: &Control,
+        issues: &mut Vec<wire::FileIssue>,
+    ) -> Result<Vec<Candidate>> {
+        let authority = &self.symbols.source_authority;
+        let filters = self.index_filters();
+        let mut candidates: HashMap<SourceIdentity, Candidate> = HashMap::new();
+        if matches!(query.scope, wire::Scope::Document) {
+            let identity = authority.fresh_identity(query.uri.as_str());
+            candidates.insert(
+                identity.clone(),
+                Candidate {
+                    uri: query.uri.clone(),
+                    identity,
+                },
+            );
+        } else {
+            let root =
+                self.workspace
+                    .workspace_root
+                    .read()
+                    .clone()
+                    .ok_or(ScanError::InvalidInput(
+                        "Project search requires a selected project root",
+                    ))?;
+            let root_identity = authority.fresh_identity(file_uri(&root)?.as_str());
+            let vendor_dirs = self.workspace.vendor_dir_paths.lock().clone();
+            let vendor_identities: Vec<_> = vendor_dirs
+                .iter()
+                .map(|path| file_uri(path).map(|uri| authority.fresh_identity(uri.as_str())))
+                .collect::<Result<_>>()?;
+            let claims = LinkClaims::new([root.clone()], Some(self.followed_links()));
+            let walker = workspace_walk_builder(
+                &root,
+                Arc::new(vendor_dirs),
+                Arc::clone(&filters),
+                false,
+                claims,
+            )
+            .build();
+            let eligible = |uri: &Url, identity: &SourceIdentity| -> Result<bool> {
+                let path = file_path(uri)?;
+                // Avoid admitting a lexical prefix containing traversal when
+                // the parent cannot be canonicalized by SourceAuthority.
+                if path.components().any(|part| part == Component::ParentDir) {
+                    return Ok(false);
+                }
+                let relative = identity.relative_to(&root_identity);
+                if !path.starts_with(&root) && relative.is_none() {
+                    return Ok(false);
+                }
+                if vendor_identities
+                    .iter()
+                    .any(|vendor| identity.relative_to(vendor).is_some())
+                {
+                    return Ok(false);
+                }
+                // Canonical aliases of a nested/excluded root must be tested
+                // in the selected root's spelling as well as their own.
+                let respelled = relative.map(|relative| root.join(relative));
+                Ok(filters.is_php_file(&path)
+                    && !filters.is_excluded_path(&path, false)
+                    && respelled
+                        .as_ref()
+                        .is_none_or(|path| !filters.is_excluded_path(path, false))
+                    && self.project_scope.allows_diagnostics(uri.as_str()))
+            };
+            let mut entries = 0usize;
+            for entry in walker {
+                checkpoint(control)?;
+                entries += 1;
+                if entries > budget.walk_entries {
+                    return Err(ScanError::Budget("discovery entries"));
+                }
+                let entry = match entry {
+                    Ok(entry) => entry,
+                    Err(_) => {
+                        add_issue(issues, issue(None, wire::IssueKind::WalkError), budget)?;
+                        continue;
+                    }
+                };
+                let path = entry.path();
+                if !path.is_file() || !filters.is_php_file(path) {
+                    continue;
+                }
+                let uri = file_uri(path)?;
+                let identity = authority.fresh_identity(uri.as_str());
+                if eligible(&uri, &identity)? {
+                    insert_candidate(&mut candidates, Candidate { uri, identity }, budget)?;
+                }
+            }
+            // Capture names only under the map lock; no filesystem/filter
+            // operations while holding it. Actual text ownership is captured
+            // when loading each selected preferred source and epoch-checked.
+            let open_uris = {
+                let files = self.open_files.read();
+                if files.len() > budget.open_documents {
+                    return Err(ScanError::Budget("open document candidates"));
+                }
+                files.keys().cloned().collect::<Vec<_>>()
+            };
+            for name in open_uris {
+                checkpoint(control)?;
+                let Ok(uri) = Url::parse(&name) else { continue };
+                if uri.scheme() != "file" {
+                    continue;
+                }
+                let identity = authority.fresh_identity(uri.as_str());
+                if eligible(&uri, &identity)? {
+                    insert_candidate(&mut candidates, Candidate { uri, identity }, budget)?;
+                }
+            }
+        }
+        let mut candidates: Vec<_> = candidates.into_values().collect();
+        candidates.sort_by(|a, b| a.uri.as_str().cmp(b.uri.as_str()));
+        Ok(candidates)
+    }
+}
+
+fn insert_candidate(
+    candidates: &mut HashMap<SourceIdentity, Candidate>,
+    candidate: Candidate,
+    budget: Budget,
+) -> Result<()> {
+    if let Some(previous) = candidates.get_mut(&candidate.identity) {
+        // Final source text still comes from SourceAuthority's preferred open
+        // alias. This only makes the no-open representative deterministic.
+        if candidate.uri.as_str() < previous.uri.as_str() {
+            *previous = candidate;
+        }
+    } else {
+        if candidates.len() >= budget.files {
+            return Err(ScanError::Budget("source files"));
+        }
+        candidates.insert(candidate.identity.clone(), candidate);
+    }
+    Ok(())
+}
+
+impl Prepared {
+    /// Cheap final admission after the router reacquires its read gate.
+    /// ProjectContext Arc/id membership is independently checked by the router.
+    /// No disk reads/canonicalization are performed in this async-side method.
+    pub(crate) fn validate_open_state(&self, backend: &Backend) -> Result<()> {
+        let documents = backend.diag.documents.lock();
+        let files = backend.open_files.read();
+        if documents.configuration_changing()
+            || !documents.input_matches(&self.epochs.input)
+            || !documents.epoch_matches(&self.epochs.semantic)
+        {
+            return Err(ScanError::ContentModified);
+        }
+        for guard in &self.guards {
+            match guard {
+                Guard::Open {
+                    uri,
+                    text,
+                    revision,
+                    ..
+                } => {
+                    if !documents.current(uri, Some(revision))
+                        || !files
+                            .get(uri)
+                            .is_some_and(|current| Arc::ptr_eq(current, text))
+                    {
+                        return Err(ScanError::ContentModified);
+                    }
+                }
+                Guard::Disk { uri, .. } if files.contains_key(uri) => {
+                    return Err(ScanError::ContentModified);
+                }
+                Guard::Disk { .. } => {}
+            }
+        }
+        Ok(())
+    }
+
+    fn validate_full(&self, backend: &Backend, control: &Control) -> Result<()> {
+        self.validate_open_state(backend)?;
+        for guard in &self.guards {
+            checkpoint(control)?;
+            match guard {
+                Guard::Open { uri, identity, .. } => {
+                    if backend.symbols.source_authority.fresh_identity(uri) != *identity
+                        || !backend.symbols.source_authority.is_preferred(uri)
+                    {
+                        return Err(ScanError::ContentModified);
+                    }
+                }
+                Guard::Disk {
+                    uri,
+                    identity,
+                    hash: expected,
+                } => {
+                    if backend.symbols.source_authority.fresh_identity(uri) != *identity
+                        || backend.symbols.source_authority.preferred(uri).is_some()
+                    {
+                        return Err(ScanError::ContentModified);
+                    }
+                    let uri = Url::parse(uri).map_err(|_| ScanError::ContentModified)?;
+                    match read_disk(&file_path(&uri)?, self.file_bytes, control)? {
+                        ReadResult::Text(current) if hash(&current) == *expected => {}
+                        _ => return Err(ScanError::ContentModified),
+                    }
+                }
+            }
+        }
+        checkpoint(control)?;
+        self.validate_open_state(backend)
+    }
+}

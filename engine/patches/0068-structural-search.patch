+#[test]
+fn structural_scan_real_walk_includes_call_only_non_psr_files_and_keeps_zero_match_ledger() {
+    let fixture = Fixture::new();
+    let matched = fixture.write("scripts/Calls.php", "<?php /* ž🐘 */ send(1);\r\n");
+    let empty = fixture.write("other/NoDeclaration.php", "<?php $x = 1;\n");
+    let prepared = fixture.scan();
+    assert_eq!(prepared.reply.generation, 17);
+    assert_eq!(prepared.reply.files.len(), 2);
+    assert!(
+        prepared
+            .reply
+            .files
+            .iter()
+            .find(|file| file.stamp.uri == matched)
+            .unwrap()
+            .matches
+            .len()
+            == 1
+    );
+    assert!(
+        prepared
+            .reply
+            .files
+            .iter()
+            .find(|file| file.stamp.uri == empty)
+            .unwrap()
+            .matches
+            .is_empty()
+    );
+    assert!(!prepared.reply.incomplete);
+    assert!(prepared.reply.issues.is_empty());
+    let found = &prepared
+        .reply
+        .files
+        .iter()
+        .find(|file| file.stamp.uri == matched)
+        .unwrap()
+        .matches[0];
+    assert_eq!(
+        found.call.range.start.character,
+        "<?php /* ž🐘 */ ".encode_utf16().count() as u32
+    );
+    assert_eq!(
+        std::fs::read(matched.to_file_path().unwrap()).unwrap(),
+        "<?php /* ž🐘 */ send(1);\r\n".as_bytes()
+    );
+}

+    assert_eq!(prepared.reply.files.len(), 2);
+    let file = prepared
+        .reply
+        .files
+        .iter()
+        .find(|file| file.stamp.uri == existing)
+        .unwrap();
+    assert!(matches!(
+        file.stamp.source,
+        wire::SourceKind::Open { version: 2, .. }
+    ));
+    assert_eq!(file.stamp.sha256_utf8, hash("<?php send('ž🐘 unsaved');"));
+    assert_eq!(
+        std::fs::read_to_string(existing.to_file_path().unwrap()).unwrap(),
+        "<?php send('disk');"
+    );

diff --git a/src/project_router_structural_expected.rs b/src/project_router_structural_expected.rs
new file mode 100644
index 0000000..db6881a
--- /dev/null
+++ b/src/project_router_structural_expected.rs
@@ -0,0 +1,226 @@
+//! Exact editor input snapshots and publication receipts for structural search.
+use sha2::{Digest, Sha256};
+use std::collections::{HashMap, HashSet};
+use tower_lsp::jsonrpc::{Error, ErrorCode, Result};
+use tower_lsp::lsp_types::{TextDocumentItem, Url};
+
+use super::ProjectRouter;
+use crate::source_authority::{SourceAuthority, SourceIdentity};
+use crate::structural_search::{
+    control::Control,
+    wire::{ExpectedSource, Query, Reply, SourceKind},
+};
+
+const MAX_SOURCES: usize = 512;
+const MAX_URI_BYTES: usize = 1024 * 1024;
+const MAX_FILE_BYTES: usize = 2 * 1024 * 1024;
+const MAX_TEXT_BYTES: usize = 32 * 1024 * 1024;
+
+pub(super) struct Captured {
+    manifest: Vec<ExpectedSource>,
+    documents: Vec<TextDocumentItem>,
+}
+
+pub(super) struct Hashed {
+    captured: Captured,
+    identities: HashSet<SourceIdentity>,
+}
+
+/// Produced only after checking actual reply stamps. The final router gate
+/// must still validate these captured global documents before echoing receipt.
+pub(super) struct Receipt {
+    captured: Captured,
+}
+
+fn modified() -> Error {
+    Error {
+        code: ErrorCode::ServerError(-32801),
+        message: "Structural search editor sources changed or are not open".into(),
+        data: None,
+    }
+}
+
+fn text_budget() -> Error {
+    Error {
+        code: ErrorCode::ServerError(-32001),
+        message: "Structural search expected-source text budget exceeded".into(),
+        data: None,
+    }
+}
+
+fn local_uri(uri: &Url) -> bool {
+    uri.scheme() == "file"
+        && uri.query().is_none()
+        && uri.fragment().is_none()
+        && uri.to_file_path().is_ok_and(|path| path.is_absolute())
+}
+
+impl Captured {
+    /// Invoke under the initial router read gate. No hash, filesystem read,
+    /// selected-backend filtering or await occurs here.
+    pub(super) fn capture(router: &ProjectRouter, query: &Query) -> Result<Self> {
+        if query.expected_sources.is_empty() {
+            return Ok(Self {
+                manifest: Vec::new(),
+                documents: Vec::new(),
+            });
+        }
+        if query.expected_sources.len() > MAX_SOURCES {
+            return Err(Error::invalid_params(
+                "Expected at most 512 structural source snapshots",
+            ));
+        }
+        let mut uris = HashSet::with_capacity(query.expected_sources.len());
+        let mut uri_bytes = 0usize;
+        for source in &query.expected_sources {
+            uri_bytes = uri_bytes
+                .checked_add(source.uri.as_str().len())
+                .filter(|bytes| *bytes <= MAX_URI_BYTES)
+                .ok_or_else(|| Error::invalid_params("Expected-source URI budget exceeded"))?;
+            if !local_uri(&source.uri) || !uris.insert(source.uri.as_str()) {
+                return Err(Error::invalid_params(
+                    "Expected distinct absolute file URIs without query or fragment",
+                ));
+            }
+            if source.sha256_utf8.len() != 64
+                || !source
+                    .sha256_utf8
+                    .bytes()
+                    .all(|byte| byte.is_ascii_hexdigit())
+            {
+                return Err(Error::invalid_params(
+                    "Expected-source hash must contain 64 hexadecimal digits",
+                ));
+            }
+        }
+        if !uris.contains(query.uri.as_str()) {
+            return Err(Error::invalid_params(
+                "Expected sources must include the exact selected document URI",
+            ));
+        }
+        // Validate the whole manifest shape above before reading any source.
+        // Distinct aliases of one physical source are deliberately allowed.
+        let current = router.documents.read();
+        let mut admitted = Vec::with_capacity(query.expected_sources.len());
+        let mut text_bytes = 0usize;
+        for expected in &query.expected_sources {
+            let document = current.get(expected.uri.as_str()).ok_or_else(modified)?;
+            if document.version != expected.version {
+                return Err(modified());
+            }
+            if document.text.len() > MAX_FILE_BYTES {
+                return Err(text_budget());
+            }
+            text_bytes = text_bytes
+                .checked_add(document.text.len())
+                .filter(|bytes| *bytes <= MAX_TEXT_BYTES)
+                .ok_or_else(text_budget)?;
+            admitted.push(document);
+        }
+        // Reject the complete aggregate before allocating any source copies.
+        let documents = admitted.into_iter().cloned().collect();
+        Ok(Self {
+            manifest: query.expected_sources.clone(),
+            documents,
+        })
+    }
+
+    /// Existing bounded blocking worker only, after dropping the routing gate.
+    pub(super) fn hash(self, authority: &SourceAuthority, control: &Control) -> Result<Hashed> {
+        let mut identities = HashSet::with_capacity(self.manifest.len());
+        for (expected, document) in self.manifest.iter().zip(&self.documents) {
+            control.checkpoint().map_err(super::stopped)?;
+            let mut hash = Sha256::new();
+            for chunk in document.text.as_bytes().chunks(64 * 1024) {
+                control.checkpoint().map_err(super::stopped)?;
+                hash.update(chunk);
+            }
+            if !format!("{:x}", hash.finalize()).eq_ignore_ascii_case(&expected.sha256_utf8) {
+                return Err(modified());
+            }
+            identities.insert(authority.fresh_identity(expected.uri.as_str()));
+        }
+        control.checkpoint().map_err(super::stopped)?;
+        Ok(Hashed {
+            captured: self,
+            identities,
+        })
+    }
+}
+
+impl Hashed {
+    /// Validate real emitted stamps, never the scanner's receipt copy.
+    /// This still runs on the existing blocking worker; fresh_identity may
+    /// canonicalize paths. No lexical project membership is inferred here.
+    pub(super) fn check_reply(
+        self,
+        reply: &Reply,
+        authority: &SourceAuthority,
+        control: &Control,
+    ) -> Result<Receipt> {
+        if self.captured.manifest.is_empty() {
+            return Ok(Receipt {
+                captured: self.captured,
+            });
+        }
+        let by_uri: HashMap<_, _> = self
+            .captured
+            .manifest
+            .iter()
+            .zip(&self.captured.documents)
+            .map(|(expected, document)| (expected.uri.as_str(), (expected, document)))
+            .collect();
+        // Retain initial identities and fresh identities, so an expected
+        // spelling retargeted during work cannot authorize Disk substitution.
+        let mut identities = self.identities;
+        for expected in &self.captured.manifest {
+            control.checkpoint().map_err(super::stopped)?;
+            identities.insert(authority.fresh_identity(expected.uri.as_str()));
+        }
+        for file in &reply.files {
+            control.checkpoint().map_err(super::stopped)?;
+            match &file.stamp.source {
+                SourceKind::Open { version, .. } => {
+                    let (expected, document) =
+                        by_uri.get(file.stamp.uri.as_str()).ok_or_else(modified)?;
+                    if *version != expected.version
+                        || !file
+                            .stamp
+                            .sha256_utf8
+                            .eq_ignore_ascii_case(&expected.sha256_utf8)
+                        || file.stamp.utf8_bytes != document.text.len() as u64
+                    {
+                        return Err(modified());
+                    }
+                }
+                SourceKind::Disk => {
+                    if identities.contains(&authority.fresh_identity(file.stamp.uri.as_str())) {
+                        return Err(modified());
+                    }
+                }
+            }
+        }
+        Ok(Receipt {
+            captured: self.captured,
+        })
+    }
+}
+
+impl Receipt {
+    /// Invoke under the final router read gate, after selected ProjectContext
+    /// Arc membership and Prepared.validate_open_state succeed. No await, hash
+    /// or filesystem operation. Compare GLOBAL router sources, not backend A.
+    pub(super) fn publish(self, router: &ProjectRouter, reply: &mut Reply) -> Result<()> {
+        {
+            let current = router.documents.read();
+            for captured in &self.captured.documents {
+                let document = current.get(captured.uri.as_str()).ok_or_else(modified)?;
+                if document.version != captured.version || document.text != captured.text {
+                    return Err(modified());
+                }
+            }
+        }
+        reply.expected_sources = self.captured.manifest;
+        Ok(())
+    }
+}

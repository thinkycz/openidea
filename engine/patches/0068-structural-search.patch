+            b,
+            nested,
+            a_text,
+            b_text,
+            nested_text,
+        }
+    }
+
+    fn manifest(&self) -> Vec<ExpectedSource> {
+        vec![
+            expected(&self.a, 1, &self.a_text),
+            expected(&self.b, 1, &self.b_text),
+            expected(&self.nested, 1, &self.nested_text),
+        ]
+    }

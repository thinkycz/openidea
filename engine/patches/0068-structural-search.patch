+//! Tests-only proposal: actual async router and real didOpen/change/close.
+use super::{ProjectRouter, test_hook::WorkerBarrier};
+use crate::structural_search::wire::{ExpectedSource, Query, Scope};
+use sha2::{Digest, Sha256};
+use std::{
+    path::{Path, PathBuf},
+    sync::Arc,
+    time::Duration,
+};
+use tower_lsp::{LanguageServer, jsonrpc::ErrorCode, lsp_types::*};
+
+const TIMEOUT: Duration = Duration::from_secs(10);
+
+fn sha(text: &str) -> String {
+    format!("{:x}", Sha256::digest(text.as_bytes()))
+}
+fn uri(path: &Path) -> Url {
+    Url::from_file_path(path).unwrap()
+}
+fn expected(path: &Path, version: i32, text: &str) -> ExpectedSource {
+    ExpectedSource {
+        uri: uri(path),
+        version,
+        sha256_utf8: sha(text),
+    }
+}
+
+struct Fixture {
+    _temp: tempfile::TempDir,
+    router: Arc<ProjectRouter>,
+    a: PathBuf,
+    b: PathBuf,
+    nested: PathBuf,
+    a_text: String,
+    b_text: String,
+    nested_text: String,
+}
+
+fn project(root: &Path, marker: &str) -> (PathBuf, String) {
+    std::fs::create_dir_all(root.join("src")).unwrap();
+    std::fs::write(
+        root.join("composer.json"),
+        r#"{"autoload":{"psr-4":{"App\\":"src/"}}}"#,
+    )
+    .unwrap();
+    let path = root.join("index.php");
+    let text = format!("<?php /* ž🐘 */ foo('{marker}');\r\n");
+    std::fs::write(&path, &text).unwrap();
+    (path, text)
+}
+
+impl Fixture {
+    async fn new() -> Self {
+        let temp = tempfile::tempdir().unwrap();
+        let base = temp.path().canonicalize().unwrap();
+        let root_a = base.join("a");
+        let root_b = base.join("b");
+        let (a, a_text) = project(&root_a, "a");
+        let (b, b_text) = project(&root_b, "b");
+        let (nested, nested_text) = project(&root_a.join("nested"), "nested");
+        let router = Arc::new(ProjectRouter::new_test());
+        router
+            .initialize(InitializeParams {
+                root_uri: Some(Url::from_directory_path(&root_a).unwrap()),
+                workspace_folders: Some(vec![
+                    WorkspaceFolder {

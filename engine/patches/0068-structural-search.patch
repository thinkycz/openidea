+    fn write(&self, relative: &str, text: &str) -> Url {
+        let path = self.root.join(relative);
+        std::fs::create_dir_all(path.parent().unwrap()).unwrap();
+        std::fs::write(&path, text).unwrap();
+        file_uri(&path).unwrap()
+    }
+
+    fn open(&self, uri: &Url, version: i32, text: &str) {
+        self.backend.symbols.source_authority.open(uri.as_str());
+        let text = Arc::new(text.to_owned());
+        let mut documents = self.backend.diag.documents.lock();
+        let mut files = self.backend.open_files.write();
+        documents.open(uri.as_str(), version, &text);
+        files.insert(uri.to_string(), text);
+    }
+
+    fn change(&self, uri: &Url, version: i32, text: &str) {
+        self.backend.symbols.source_authority.change(uri.as_str());
+        let text = Arc::new(text.to_owned());
+        let mut documents = self.backend.diag.documents.lock();
+        let mut files = self.backend.open_files.write();
+        assert!(documents.change(uri.as_str(), version, &text));
+        files.insert(uri.to_string(), text);
+    }
+
+    fn query(&self) -> wire::Query {
+        wire::Query {
+            expected_sources: vec![],
+            uri: file_uri(&self.root.join("Selected.php")).unwrap(),
+            generation: 17,
+            pattern: "send($__ss_value)".into(),
+            scope: wire::Scope::Project,
+        }
+    }
+
+    fn project(&self) -> wire::Project {
+        wire::Project {
+            id: 7,
+            root: Some(Url::from_directory_path(&self.root).unwrap()),
+        }
+    }
+
+    fn scan(&self) -> Prepared {
+        self.scan_with(Budget::default(), || {}).unwrap()
+    }
+
+    fn scan_with(&self, budget: Budget, before_validate: impl FnOnce()) -> Result<Prepared> {
+        let query = self.query();
+        let pattern = Pattern::compile(&query.pattern).unwrap();
+        let (_lifetime, control) = Lifetime::new(Instant::now() + Duration::from_secs(30));
+        self.backend.search_structural_inner(
+            &query,
+            self.project(),
+            &pattern,
+            &control,
+            budget,
+            before_validate,
+        )
+    }
+}

@@ -0,0 +1,80 @@
+//! Guard-only tests, included as a child of expected_tests AFTER installing
+//! the expected helper. They are not part of tests-only unguarded-route RED.
+use super::super::expected::Captured;
+use super::{Fixture, uri};
+use crate::structural_search::{control::Lifetime, wire::SourceKind};
+use std::time::{Duration, Instant};
+#[cfg(unix)]
+use tower_lsp::jsonrpc::ErrorCode;
+
+#[cfg(unix)]
+#[tokio::test]
+async fn structural_expected_disk_alias_substitution_refuses_matches_and_zero_matches() {
+    let f = Fixture::new().await;
+    let disk_alias = f.a.parent().unwrap().join("DiskAlias.php");
+    std::os::unix::fs::symlink(&f.a, &disk_alias).unwrap();
+    let original = f
+        .router
+        .workbench_structural_search(f.query())
+        .await
+        .unwrap();
+    assert_eq!(original.files.len(), 1);
+    assert!(!original.files[0].matches.is_empty());
+    let (_lifetime, control) = Lifetime::new(Instant::now() + Duration::from_secs(25));
+    for zero_matches in [false, true] {
+        let query = f.query();
+        let captured = {
+            let _gate = f.router.request_guard().await;
+            Captured::capture(&f.router, &query).unwrap()
+        };
+        let checked = captured.hash(&f.router.sources, &control).unwrap();
+        let mut substituted = original.clone();
+        substituted.files[0].stamp.uri = uri(&disk_alias);
+        substituted.files[0].stamp.source = SourceKind::Disk;
+        if zero_matches {
+            substituted.files[0].matches.clear();
+        }
+        // Preserve valid original hash/length/ranges and exact receipt: the
+        // guard must use physical source identity, not URI/hash shape alone.
+        let result = checked.check_reply(&substituted, &f.router.sources, &control);
+        let error = match result {
+            Ok(_) => panic!("Disk alias replaced an expected open source"),
+            Err(error) => error,
+        };
+        assert_eq!(
+            error.code,
+            ErrorCode::ServerError(-32801),
+            "zero_matches={zero_matches}"
+        );
+    }
+    f.unchanged_disk().await;
+}
+
+#[tokio::test]
+async fn structural_expected_distinct_disk_source_with_same_hash_remains_admitted() {
+    let f = Fixture::new().await;
+    let unrelated = f.a.parent().unwrap().join("Unrelated.php");
+    std::fs::write(&unrelated, &f.a_text).unwrap();
+    let original = f
+        .router
+        .workbench_structural_search(f.query())
+        .await
+        .unwrap();
+    let query = f.query();
+    let captured = {
+        let _gate = f.router.request_guard().await;
+        Captured::capture(&f.router, &query).unwrap()
+    };
+    let (_lifetime, control) = Lifetime::new(Instant::now() + Duration::from_secs(25));
+    let checked = captured.hash(&f.router.sources, &control).unwrap();
+    let mut distinct = original;
+    distinct.files[0].stamp.uri = uri(&unrelated);
+    distinct.files[0].stamp.source = SourceKind::Disk;
+    assert!(
+        checked
+            .check_reply(&distinct, &f.router.sources, &control)
+            .is_ok(),
+        "equal text/hash does not establish physical source identity"
+    );
+    f.unchanged_disk().await;
+}

+    fn query(&self) -> Query {
+        Query {
+            uri: uri(&self.a),
+            generation: 19,
+            pattern: "foo($__ss_value)".into(),
+            scope: Scope::Document,
+            expected_sources: self.manifest(),
+        }
+    }
+
+    async fn change_b(&self) {

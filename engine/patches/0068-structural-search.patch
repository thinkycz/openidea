+//! Structural requests search the selected project's actual source set.
+use std::fs;
+use std::path::Path;
+
+use phpantom_lsp::{ProjectRouter, StructuralSearchQuery};
+use serde_json::json;
+use tempfile::TempDir;
+use tower_lsp::LanguageServer;
+use tower_lsp::lsp_types::*;
+
+async fn router(roots: &[&Path]) -> ProjectRouter {
+    let router = ProjectRouter::new_test();
+    let reply = router
+        .initialize(InitializeParams {
+            workspace_folders: Some(
+                roots
+                    .iter()
+                    .enumerate()
+                    .map(|(index, root)| WorkspaceFolder {
+                        uri: Url::from_directory_path(root).unwrap(),
+                        name: format!("project-{index}"),
+                    })
+                    .collect(),
+            ),
+            root_uri: roots
+                .first()
+                .map(|root| Url::from_directory_path(root).unwrap()),
+            ..InitializeParams::default()
+        })
+        .await
+        .unwrap();
+    assert_eq!(
+        reply.capabilities.experimental.unwrap()["phpWorkbenchStructuralSearch"],
+        true
+    );
+    router.initialized(InitializedParams {}).await;
+    router
+}
+
+fn query(path: &Path, generation: u64, scope: &str) -> StructuralSearchQuery {
+    serde_json::from_value(json!({
+        "uri": Url::from_file_path(path).unwrap(), "generation":generation,
+        "pattern":"foo($__ss_value)", "scope":scope,
+    }))
+    .unwrap()
+}
+
+fn project(root: &Path) {
+    fs::create_dir_all(root.join("src")).unwrap();
+    fs::write(
+        root.join("composer.json"),
+        r#"{"autoload":{"psr-4":{"App\\":"src/"}}}"#,
+    )
+    .unwrap();
+}
+
+#[tokio::test]
+async fn structural_selected_project_includes_call_only_non_psr_files() {
+    let temp = TempDir::new().unwrap();
+    let base = temp.path().canonicalize().unwrap();
+    let a = base.join("a");
+    let b = base.join("b");
+    for root in [&a, &b] {
+        project(root);
+        fs::create_dir_all(root.join("misc")).unwrap();
+        fs::write(root.join("misc/calls.php"), "<?php foo('misc');").unwrap();
+    }
+    fs::write(a.join("index.php"), "<?php foo('a');").unwrap();
+    fs::write(b.join("index.php"), "<?php foo('b');").unwrap();
+    let router = router(&[&a, &b]).await;
+    let first = router
+        .workbench_structural_search(query(&a.join("index.php"), 11, "project"))
+        .await
+        .unwrap();
+    assert_eq!(first.generation, 11);
+    assert!(!first.incomplete);
+    assert_eq!(
+        first
+            .files
+            .iter()
+            .map(|file| file.matches.len())
+            .sum::<usize>(),
+        2
+    );
+    assert!(
+        first
+            .files
+            .iter()
+            .all(|file| file.stamp.uri.to_file_path().unwrap().starts_with(&a))
+    );
+    assert!(
+        first
+            .files
+            .iter()
+            .any(|file| file.stamp.uri.to_file_path().unwrap() == a.join("misc/calls.php"))
+    );
+    let second = router
+        .workbench_structural_search(query(&b.join("index.php"), 12, "project"))
+        .await
+        .unwrap();
+    assert_ne!(first.project.id, second.project.id);
+    assert!(
+        second
+            .files
+            .iter()
+            .all(|file| file.stamp.uri.to_file_path().unwrap().starts_with(&b))
+    );
+    router.shutdown().await.unwrap();
+}
+
+#[tokio::test]
+async fn structural_real_route_reads_latest_unsaved_source_without_writing_disk() {
+    let temp = TempDir::new().unwrap();
+    let root = temp.path().canonicalize().unwrap();
+    project(&root);
+    let path = root.join("index.php");
+    let disk = "<?php foo('disk');";
+    fs::write(&path, disk).unwrap();
+    let router = router(&[&root]).await;
+    let uri = Url::from_file_path(&path).unwrap();
+    router
+        .did_open(DidOpenTextDocumentParams {
+            text_document: TextDocumentItem {
+                uri: uri.clone(),
+                language_id: "php".into(),
+                version: 1,
+                text: disk.into(),
+            },
+        })
+        .await;
+    let live = "<?php /* ž😀 */ foo('live'); foo('two');";
+    router
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier { uri, version: 2 },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: live.into(),
+            }],
+        })
+        .await;
+    let result = router
+        .workbench_structural_search(query(&path, 22, "document"))
+        .await
+        .unwrap();
+    assert_eq!(result.files.len(), 1);
+    let file = &result.files[0];
+    assert_eq!(file.matches.len(), 2);
+    let stamp = serde_json::to_value(&file.stamp).unwrap();
+    assert_eq!(stamp["source"]["kind"], "open");
+    assert_eq!(stamp["source"]["version"], 2);
+    assert_eq!(file.stamp.utf8_bytes, live.len() as u64);
+    let first = &file.matches[0].call;
+    assert_eq!(
+        &live[first.start_byte as usize..first.end_byte as usize],
+        "foo('live')"
+    );
+    assert_ne!(first.start_byte, first.range.start.character);
+    assert_eq!(fs::read_to_string(path).unwrap(), disk);
+    router.shutdown().await.unwrap();
+}
+
+#[tokio::test]
+async fn structural_real_route_reports_syntax_issues_and_retains_zero_match_sources() {
+    let temp = TempDir::new().unwrap();
+    let root = temp.path().canonicalize().unwrap();
+    project(&root);
+    let path = root.join("index.php");
+    fs::write(&path, "<?php foo(1);").unwrap();
+    fs::write(root.join("empty.php"), "<?php bar(1);").unwrap();
+    fs::write(root.join("broken.php"), "<?php foo(").unwrap();
+    let router = router(&[&root]).await;
+    let result = router
+        .workbench_structural_search(query(&path, 31, "project"))
+        .await
+        .unwrap();
+    assert!(result.incomplete);
+    assert_eq!(result.issues.len(), 1);
+    assert_eq!(
+        serde_json::to_value(&result.issues[0]).unwrap()["kind"],
+        "syntax"
+    );
+    assert_eq!(result.files.len(), 2);
+    assert!(result.files.iter().any(|file| file.matches.is_empty()
+        && file.stamp.uri.to_file_path().unwrap() == root.join("empty.php")));
+    router.shutdown().await.unwrap();
+}
+
+#[tokio::test]
+async fn structural_parent_project_excludes_nested_composer_and_custom_vendor_sources() {
+    let temp = TempDir::new().unwrap();
+    let canonical_root = temp.path().canonicalize().unwrap();
+    let root = canonical_root.as_path();
+    project(root);
+    fs::write(
+        root.join("composer.json"),
+        r#"{"config":{"vendor-dir":"deps"},"autoload":{"psr-4":{"App\\":"src/"}}}"#,
+    )
+    .unwrap();
+    fs::write(root.join("index.php"), "<?php foo('parent');").unwrap();
+    let nested = root.join("nested");
+    project(&nested);
+    fs::write(nested.join("index.php"), "<?php foo('nested');").unwrap();
+    fs::create_dir_all(root.join("deps/package")).unwrap();
+    fs::write(root.join("deps/package/vendor.php"), "<?php foo('vendor');").unwrap();
+    let router = router(&[root]).await;
+    let parent = router
+        .workbench_structural_search(query(&root.join("index.php"), 41, "project"))
+        .await
+        .unwrap();
+    assert!(!parent.incomplete);
+    assert_eq!(parent.files.len(), 1);
+    assert_eq!(
+        parent.files[0].stamp.uri.to_file_path().unwrap(),
+        root.join("index.php")
+    );
+    let child = router
+        .workbench_structural_search(query(&nested.join("index.php"), 42, "project"))
+        .await
+        .unwrap();
+    assert_ne!(parent.project.id, child.project.id);
+    assert_eq!(child.files.len(), 1);
+    assert_eq!(
+        child.files[0].stamp.uri.to_file_path().unwrap(),
+        nested.join("index.php")
+    );
+    router.shutdown().await.unwrap();
+}

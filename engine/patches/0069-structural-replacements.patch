+#[test]
+fn replace_every_review_subset_preserves_binary_conditional_and_receiver_contexts() {
+    let source = "<?php $a = old($x) * 2; $b = ok() ? old($y) : 7; $c = old($z)->run();";
+    for mask in 0..8usize {
+        let selected = (0..3)
+            .filter(|index| mask & (1 << index) != 0)
+            .collect::<Vec<_>>();
+        let edits = prepare("old($__ss_x)", "$__ss_x + 1", source, &selected).unwrap();
+        assert_eq!(edits.edits.len(), selected.len());
+        let candidate = apply(source, &edits);
+        let parsed = with_parsed_program(
+            &candidate,
+            "replacement.test.all_review_subsets",
+            |program, _| {
+                assert!(!program.has_errors(), "mask={mask}: {candidate}");
+                let statements = program
+                    .statements
+                    .iter()
+                    .filter_map(|statement| {
+                        let Statement::Expression(statement) = statement else {
+                            return None;
+                        };
+                        let Expression::Assignment(assignment) = statement.expression else {
+                            panic!("assignment outside replacement");
+                        };
+                        Some(assignment.rhs)
+                    })
+                    .collect::<Vec<_>>();
+                assert_eq!(statements.len(), 3);
+                let Expression::Binary(binary) = statements[0] else {
+                    panic!("outer multiplication changed");
+                };
+                assert!(matches!(binary.rhs, Expression::Literal(_)));
+                let Expression::Conditional(conditional) = statements[1] else {
+                    panic!("outer conditional changed");
+                };
+                assert!(matches!(conditional.condition, Expression::Call(_)));
+                assert!(matches!(conditional.r#else, Expression::Literal(_)));
+                let Expression::Call(Call::Method(method)) = statements[2] else {
+                    panic!("outer method call changed");
+                };
+                assert!(
+                    matches!(&method.method, ClassLikeMemberSelector::Identifier(name) if name.value == b"run")
+                );
+                for (index, expression) in [binary.lhs, conditional.then.unwrap(), method.object]
+                    .into_iter()
+                    .enumerate()
+                {
+                    if mask & (1 << index) != 0 {
+                        let Expression::Parenthesized(group) = expression else {
+                            panic!("selected replacement lost outer grouping");
+                        };
+                        assert!(matches!(group.expression, Expression::Binary(_)));
+                    } else {
+                        assert!(
+                            matches!(expression, Expression::Call(Call::Function(_))),
+                            "unselected context changed"
+                        );
+                    }
+                }
+                Some(())
+            },
+        );
+        assert_eq!(parsed, Some(()));
+    }
+}

+#[test]
+fn replace_mid_computation_cancel_and_deadline_never_publish_accumulated_edits() {
+    let source = "<?php old($x); old($y); old($z);";
+    let pattern = Pattern::compile("old($__ss_x)").unwrap();
+    let template = Template::compile(&pattern, "newer($__ss_x, $__ss_x)").unwrap();
+    let selected = pattern
+        .find_in(source, Limits::default())
+        .unwrap()
+        .iter()
+        .map(|found| found.call.bytes.clone())
+        .collect::<Vec<_>>();
+    let counter = AtomicUsize::new(0);
+    let baseline = || {
+        counter.fetch_add(1, Ordering::SeqCst);
+        Ok(())
+    };
+    assert_eq!(
+        template
+            .prepare_selected_with_control(
+                &pattern,
+                source,
+                &selected,
+                ReplaceLimits::default(),
+                &baseline
+            )
+            .unwrap()
+            .edits
+            .len(),
+        3
+    );
+    let total = counter.load(Ordering::SeqCst);
+    assert!(total > 20);
+    for threshold in [2, total / 2, total - 1] {
+        for error in [SearchError::Cancelled, SearchError::Deadline] {
+            counter.store(0, Ordering::SeqCst);
+            let control = || {
+                if counter.fetch_add(1, Ordering::SeqCst) + 1 >= threshold {
+                    Err(error.clone())
+                } else {
+                    Ok(())
+                }
+            };
+            assert_eq!(
+                template.prepare_selected_with_control(
+                    &pattern,
+                    source,
+                    &selected,
+                    ReplaceLimits::default(),
+                    &control
+                ),
+                Err(ReplaceError::Search(error.clone()))
+            );
+            assert!(counter.load(Ordering::SeqCst) > 1);
+        }
+    }
+}

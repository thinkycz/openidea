+//! Checked read-only replacement proposal through authoritative structural snapshots.
+use std::collections::{HashMap, HashSet};
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use tower_lsp::jsonrpc::{Error, Result};
+use tower_lsp::lsp_types::Url;
+
+use super::{expected, scan_error, stopped};
+use crate::project_router::ProjectRouter;
+use crate::structural_search::replacement::{ReplaceError, ReplaceLimits, Template};
+use crate::structural_search::{Pattern, SearchError, control, scan, wire};
+
+const MAX_SELECTED: usize = 1000;
+const MAX_OUTPUT_BYTES: usize = 32 * 1024 * 1024;
+
+fn invalid(message: &'static str) -> Error {
+    Error::invalid_params(message)
+}
+fn changed() -> Error {
+    scan_error(scan::ScanError::ContentModified)
+}
+fn output_budget() -> Error {
+    scan_error(scan::ScanError::Budget(
+        "aggregate replacement output bytes",
+    ))
+}
+fn render_error(error: ReplaceError) -> Error {
+    match error {
+        ReplaceError::Search(error) => scan_error(scan::ScanError::Matcher(error)),
+        ReplaceError::Budget(reason) => scan_error(scan::ScanError::Budget(reason)),
+        error => Error::invalid_params(error.to_string()),
+    }
+}
+fn matcher_check(control: &control::Control) -> std::result::Result<(), SearchError> {
+    control.checkpoint().map_err(SearchError::from)
+}
+
+/// Shape admission only. Match/stamp authority comes from the subsequent scan.
+fn selected_uris(query: &wire::ReplaceQuery) -> Result<HashSet<Url>> {
+    if query.search.expected_sources.is_empty() {
+        return Err(invalid("Replacement requires checked expected sources"));
+    }
+    if query.selections.is_empty() || query.selections.len() > 512 {
+        return Err(invalid(
+            "Select one or more source-stamped matches in at most 512 files",
+        ));
+    }
+    let mut uris = HashSet::new();
+    let mut count = 0usize;
+    let mut uri_bytes = 0usize;
+    for selection in &query.selections {
+        let uri = &selection.stamp.uri;
+        uri_bytes = uri_bytes
+            .checked_add(uri.as_str().len())
+            .filter(|n| *n <= 1024 * 1024)
+            .ok_or_else(|| invalid("Selected source URI budget exceeded"))?;
+        if uri.scheme() != "file"
+            || uri.query().is_some()
+            || uri.fragment().is_some()
+            || uri.to_file_path().is_err()
+            || !uris.insert(uri.clone())
+        {
+            return Err(invalid("Selected sources require distinct local file URIs"));
+        }
+        if selection.stamp.sha256_utf8.len() != 64
+            || !selection
+                .stamp
+                .sha256_utf8
+                .bytes()
+                .all(|byte| byte.is_ascii_hexdigit())
+            || selection.stamp.utf8_bytes > 2 * 1024 * 1024
+        {
+            return Err(invalid("Invalid selected source hash or byte length"));
+        }
+        if selection.calls.is_empty() {
+            return Err(invalid("Each selected source requires at least one call"));
+        }
+        count = count
+            .checked_add(selection.calls.len())
+            .filter(|n| *n <= MAX_SELECTED)
+            .ok_or_else(|| invalid("Too many selected structural replacements"))?;
+        let mut calls: Vec<_> = selection.calls.iter().collect();
+        calls.sort_by_key(|call| (call.start_byte, call.end_byte));
+        if calls
+            .iter()
+            .any(|call| call.start_byte >= call.end_byte || call.range.start > call.range.end)
+            || calls
+                .windows(2)
+                .any(|pair| pair[0].end_byte > pair[1].start_byte)
+        {
+            return Err(invalid(
+                "Selected structural calls must be nonempty, disjoint and nonduplicated",
+            ));
+        }
+    }
+    Ok(uris)
+}
+
+fn render_selected(
+    captured: &scan::CapturedSearch,
+    query: &wire::ReplaceQuery,
+    pattern: &Pattern,
+    template: &Template,
+    control: &control::Control,
+) -> Result<Vec<wire::FileEdits>> {
+    let by_uri: HashMap<_, _> = captured
+        .prepared
+        .reply
+        .files
+        .iter()
+        .map(|file| (&file.stamp.uri, file))
+        .collect();
+    let mut output = Vec::new();
+    let mut inserted_bytes = 0usize;
+    let mut candidate_bytes = captured.input_bytes;
+    for selection in &query.selections {
+        control.checkpoint().map_err(stopped)?;
+        let file = by_uri.get(&selection.stamp.uri).ok_or_else(changed)?;
+        if file.stamp != selection.stamp {
+            return Err(changed());
+        }
+        // Exact byte AND UTF16 membership. Never accept an arbitrary substring
+        // or remap a selection to another preferred alias on behalf of a caller.
+        for selected in &selection.calls {
+            if !file.matches.iter().any(|found| found.call == *selected) {
+                return Err(changed());
+            }
+        }
+        let source = captured.source(&selection.stamp.uri).ok_or_else(changed)?;
+        let ranges: Vec<_> = selection
+            .calls
+            .iter()
+            .map(|call| call.start_byte as usize..call.end_byte as usize)
+            .collect();
+        let prepared = template
+            .prepare_selected_with_control(
+                pattern,
+                source,
+                &ranges,
+                ReplaceLimits::default(),
+                &|| matcher_check(control),
+            )
+            .map_err(render_error)?;
+        // Renderer contract includes no-op edits too; do not silently omit a
+        // user-selected match if an incompatible implementation drops no-ops.
+        if prepared.edits.len() != selection.calls.len() {
+            return Err(Error::internal_error());
+        }
+        let mut file_inserted = 0usize;
+        let mut removed = 0usize;
+        for edit in &prepared.edits {
+            control.checkpoint().map_err(stopped)?;
+            if !selection.calls.iter().any(|call| {
+                call.start_byte as usize == edit.source.bytes.start
+                    && call.end_byte as usize == edit.source.bytes.end
+                    && call.range == edit.source.range
+            }) {
+                return Err(Error::internal_error());
+            }
+            file_inserted = file_inserted
+                .checked_add(edit.new_text.len())
+                .ok_or_else(output_budget)?;
+            removed = removed
+                .checked_add(edit.source.bytes.len())
+                .ok_or_else(output_budget)?;
+        }
+        inserted_bytes = inserted_bytes
+            .checked_add(file_inserted)
+            .filter(|n| *n <= MAX_OUTPUT_BYTES)
+            .ok_or_else(output_budget)?;
+        let candidate = source
+            .len()
+            .checked_sub(removed)
+            .and_then(|n| n.checked_add(file_inserted))
+            .ok_or_else(output_budget)?;
+        candidate_bytes = candidate_bytes
+            .checked_sub(source.len())
+            .and_then(|n| n.checked_add(candidate))
+            .ok_or_else(output_budget)?;
+        // Account before retaining any per-file wire edit collection. The pure
+        // renderer itself bounds its single file/candidate allocation.
+        output.push(wire::FileEdits {
+            uri: selection.stamp.uri.clone(),
+            edits: prepared
+                .edits
+                .into_iter()
+                .map(|edit| wire::ReplacementEdit {
+                    call: edit.source.into(),
+                    new_text: edit.new_text,
+                })
+                .collect(),
+        });
+    }
+    if candidate_bytes > MAX_OUTPUT_BYTES {
+        return Err(output_budget());
+    }
+    control.checkpoint().map_err(stopped)?;
+    output.sort_by(|a, b| a.uri.as_str().cmp(b.uri.as_str()));
+    Ok(output)
+}
+
+impl ProjectRouter {
+    /// Produce edits only. No source writes or resource operations are admitted.
+    pub async fn workbench_structural_replace(
+        &self,
+        query: wire::ReplaceQuery,
+    ) -> Result<wire::ReplaceReply> {
+        let retained = selected_uris(&query)?;
+        let (_lifetime, control) = control::Lifetime::new(Instant::now() + Duration::from_secs(25));
+        let (project, expected) = {
+            let _gate = self.request_guard().await;
+            let expected = expected::Captured::capture(self, &query.search)?;
+            let project = self.query_project(Some(query.search.uri.clone())).await?;
+            (project, expected)
+        };
+        control.checkpoint().map_err(stopped)?;
+        let root = project
+            .root
+            .as_ref()
+            .map(Url::from_directory_path)
+            .transpose()
+            .map_err(|_| invalid("Invalid replacement project root"))?;
+        let wire_project = wire::Project {
+            id: project.id,
+            root,
+        };
+        let backend = Arc::clone(&project.backend);
+        let worker_control = control.clone();
+        #[cfg(test)]
+        let worker_barrier = self.structural_test_barrier.lock().take();
+        let (mut prepared, receipt, edits, replacement) =
+            crate::server::run_blocking_cancel_safe("structural_replace", move || -> Result<_> {
+                #[cfg(test)]
+                let _finished = worker_barrier
+                    .as_ref()
+                    .map(|barrier| barrier.finish_guard(&worker_control));
+                let result: Result<_> = (|| {
+                    worker_control.checkpoint().map_err(stopped)?;
+                    let pattern = Pattern::compile(&query.search.pattern)
+                        .map_err(|error| scan_error(scan::ScanError::Matcher(error)))?;
+                    let template =
+                        Template::compile(&pattern, &query.replacement).map_err(render_error)?;
+                    let expected =
+                        expected.hash(&backend.symbols.source_authority, &worker_control)?;
+                    let captured = backend.with_prepared_current_semantics(|| {
+                        backend
+                            .search_structural_captured_once(
+                                &query.search,
+                                wire_project.clone(),
+                                &pattern,
+                                &worker_control,
+                                &retained,
+                            )
+                            .map_err(scan_error)
+                    })?;
+                    let edits =
+                        render_selected(&captured, &query, &pattern, &template, &worker_control)?;
+                    let receipt = expected.check_reply(
+                        &captured.prepared.reply,
+                        &backend.symbols.source_authority,
+                        &worker_control,
+                    )?;
+                    Ok((captured, receipt, edits))
+                })();
+                // Pause after render+receipt with no routing or semantic locks held.
+                #[cfg(test)]
+                if let Some(barrier) = &worker_barrier {
+                    barrier.pause(&worker_control, result.is_ok());
+                }
+                let (captured, receipt, edits) = result?;
+                // Final full disk/hash/identity/source-set readback is deliberately
+                // after rendering and the test publication barrier, still blocking.
+                captured
+                    .validate_after_replacement(&backend, &query.search, &worker_control)
+                    .map_err(scan_error)?;
+                worker_control.checkpoint().map_err(stopped)?;
+                Ok((captured.prepared, receipt, edits, query.replacement))
+            })
+            .await
+            .ok_or_else(Error::internal_error)??;
+        let _gate = self.request_guard().await;
+        control.checkpoint().map_err(stopped)?;
+        if !self
+            .contexts
+            .read()
+            .iter()
+            .any(|current| Arc::ptr_eq(current, &project))
+        {
+            return Err(changed());
+        }
+        prepared
+            .validate_open_state(&project.backend)
+            .map_err(scan_error)?;
+        receipt.publish(self, &mut prepared.reply)?;
+        control.checkpoint().map_err(stopped)?;
+        Ok(wire::ReplaceReply {
+            kind: wire::ReplacementKind::ParenthesizedExpression,
+            search: prepared.reply,
+            replacement,
+            edits,
+        })
+    }
+}
+

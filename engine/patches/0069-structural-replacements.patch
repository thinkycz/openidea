+#[tokio::test]
+async fn structural_replace_route_current_checked_subset_preserves_unicode_crlf_and_disk() {
+    let f = Fixture::new().await;
+    let q = f.proposal(wire::Scope::Document, "foo($value)").await;
+    let expected = q.search.expected_sources.clone();
+    let reply = f
+        .router
+        .workbench_structural_replace(q.clone())
+        .await
+        .unwrap();
+    assert_eq!(reply.kind, wire::ReplacementKind::ParenthesizedExpression);
+    assert_eq!(reply.search.expected_sources, expected);
+    assert_eq!(reply.replacement, q.replacement);
+    assert_eq!(reply.edits.len(), 1);
+    assert_eq!(reply.edits[0].uri, uri(&f.source));
+    assert_eq!(reply.edits[0].edits.len(), 1);
+    assert_eq!(reply.edits[0].edits[0].call, q.selections[0].calls[0]);
+    assert_eq!(
+        apply(&f.text, &reply.edits[0].edits),
+        f.text.replacen("foo($value)", "(bar(($value)))", 1)
+    );
+    assert_eq!(std::fs::read(&f.closed).unwrap(), f.disk_text.as_bytes());
+    f.finish().await;
+}

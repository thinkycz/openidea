+//! Public exported request/response API. No private hooks, injected models or direct scanner calls.
+use phpantom_lsp::{ProjectRouter, StructuralReplaceQuery, StructuralSearchQuery};
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use std::{
+    path::{Path, PathBuf},
+    sync::Arc,
+};
+use tower_lsp::{LanguageServer, jsonrpc::ErrorCode, lsp_types::*};
+
+fn uri(path: &Path) -> Url {
+    Url::from_file_path(path).unwrap()
+}
+fn sha(text: &str) -> String {
+    format!("{:x}", Sha256::digest(text.as_bytes()))
+}
+struct Fixture {
+    _temp: tempfile::TempDir,
+    router: Arc<ProjectRouter>,
+    root: PathBuf,
+    source: PathBuf,
+    closed: PathBuf,
+    text: String,
+    disk: String,
+}
+impl Fixture {
+    async fn new() -> Self {
+        let temp = tempfile::tempdir().unwrap();
+        let root = temp.path().canonicalize().unwrap();
+        std::fs::write(root.join("composer.json"), "{}").unwrap();
+        let source = root.join("index.php");
+        let closed = root.join("closed.php");
+        let text = "<?php\r\n/* ž🐘 */ foo($value); foo(foo($nested));\r\n".to_owned();
+        assert!(text.contains("\r\n"));
+        let disk = "<?php foo('disk');\r\n".to_owned();
+        std::fs::write(&source, &text).unwrap();
+        std::fs::write(&closed, &disk).unwrap();
+        let router = Arc::new(ProjectRouter::new_test());
+        router
+            .initialize(InitializeParams {
+                root_uri: Some(Url::from_directory_path(&root).unwrap()),
+                workspace_folders: Some(vec![WorkspaceFolder {
+                    uri: Url::from_directory_path(&root).unwrap(),
+                    name: "fixture".into(),
+                }]),
+                ..InitializeParams::default()
+            })
+            .await
+            .unwrap();
+        router.initialized(InitializedParams {}).await;
+        router
+            .did_open(DidOpenTextDocumentParams {
+                text_document: TextDocumentItem {
+                    uri: uri(&source),
+                    version: 1,
+                    language_id: "php".into(),
+                    text: text.clone(),
+                },
+            })
+            .await;
+        Self {
+            _temp: temp,
+            router,
+            root,
+            source,
+            closed,
+            text,
+            disk,
+        }
+    }
+    fn search(&self, scope: &str) -> Value {
+        json!({"uri":uri(&self.source),"generation":81,
+        "scope":scope,"pattern":"foo($__ss_value)","expectedSources":[{"uri":uri(&self.source),"version":1,"sha256Utf8":sha(&self.text)}]})
+    }
+    async fn proposal(&self, scope: &str, needle: &str) -> Value {
+        let query = self.search(scope);
+        let search: StructuralSearchQuery = serde_json::from_value(query.clone()).unwrap();
+        let reply = serde_json::to_value(
+            self.router
+                .workbench_structural_search(search)
+                .await
+                .unwrap(),
+        )
+        .unwrap();
+        let (stamp, call) = reply["files"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .find_map(|file| {
+                let path = Url::parse(file["stamp"]["uri"].as_str().unwrap())
+                    .unwrap()
+                    .to_file_path()
+                    .unwrap();
+                let text = if path == self.source {
+                    &self.text
+                } else if path == self.closed {
+                    &self.disk
+                } else {
+                    return None;
+                };
+                file["matches"]
+                    .as_array()
+                    .unwrap()
+                    .iter()
+                    .find(|m| {
+                        &text[m["call"]["startByte"].as_u64().unwrap() as usize
+                            ..m["call"]["endByte"].as_u64().unwrap() as usize]
+                            == needle
+                    })
+                    .map(|m| (file["stamp"].clone(), m["call"].clone()))
+            })
+            .expect("real public search match");
+        json!({"search":query,"replacement":"bar($__ss_value)","selections":[{"stamp":stamp,"calls":[call]}]})
+    }
+    async fn replace(&self, query: Value) -> Result<Value, tower_lsp::jsonrpc::Error> {
+        let query: StructuralReplaceQuery = serde_json::from_value(query).unwrap();
+        self.router
+            .workbench_structural_replace(query)
+            .await
+            .map(|reply| serde_json::to_value(reply).unwrap())
+    }
+    async fn finish(&self) {
+        assert_eq!(std::fs::read(&self.source).unwrap(), self.text.as_bytes());
+        self.router.shutdown().await.unwrap();
+    }
+}
+fn apply(text: &str, edits: &Value) -> String {
+    let mut text = text.to_owned();
+    for edit in edits.as_array().unwrap().iter().rev() {
+        let call = &edit["call"];
+        text.replace_range(
+            call["startByte"].as_u64().unwrap() as usize
+                ..call["endByte"].as_u64().unwrap() as usize,
+            edit["newText"].as_str().unwrap(),
+        );
+    }
+    text
+}

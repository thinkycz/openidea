+//! Public async handler controls; real router lifecycle and temporary files.
+use super::super::test_hook::WorkerBarrier;
+use super::*;
+use crate::structural_search::control::Stop;
+use sha2::{Digest, Sha256};
+use std::{
+    path::{Path, PathBuf},
+    time::Duration,
+};
+use tower_lsp::{LanguageServer, jsonrpc::ErrorCode, lsp_types::*};
+
+const TIMEOUT: Duration = Duration::from_secs(10);
+fn uri(path: &Path) -> Url {
+    Url::from_file_path(path).unwrap()
+}
+fn sha(text: &str) -> String {
+    format!("{:x}", Sha256::digest(text.as_bytes()))
+}
+fn expected(path: &Path, version: i32, text: &str) -> wire::ExpectedSource {
+    wire::ExpectedSource {
+        uri: uri(path),
+        version,
+        sha256_utf8: sha(text),
+    }
+}
+struct Fixture {
+    _temp: tempfile::TempDir,
+    router: Arc<ProjectRouter>,
+    root: PathBuf,
+    source: PathBuf,
+    peer: PathBuf,
+    closed: PathBuf,
+    text: String,
+    peer_text: String,
+    disk_text: String,
+}
+impl Fixture {
+    async fn new() -> Self {
+        let temp = tempfile::tempdir().unwrap();
+        let base = temp.path().canonicalize().unwrap();
+        let root = base.join("app");
+        let other = base.join("other");
+        for path in [&root, &other] {
+            std::fs::create_dir_all(path.join("src")).unwrap();
+            std::fs::write(path.join("composer.json"), r#"{}"#).unwrap();
+        }
+        let source = root.join("index.php");
+        let peer = other.join("index.php");
+        let closed = root.join("closed.php");
+        let text = "<?php\r\n/* ž🐘 */ foo($value); foo(foo($nested));\r\n".to_owned();
+        assert!(text.contains("\r\n"));
+        let peer_text = "<?php foo('peer');\r\n".to_owned();
+        let disk_text = "<?php /* disk */ foo('disk');\r\n".to_owned();
+        std::fs::write(&source, &text).unwrap();
+        std::fs::write(&peer, &peer_text).unwrap();
+        std::fs::write(&closed, &disk_text).unwrap();
+        let router = Arc::new(ProjectRouter::new_test());
+        router
+            .initialize(InitializeParams {
+                root_uri: Some(Url::from_directory_path(&root).unwrap()),
+                workspace_folders: Some(vec![
+                    WorkspaceFolder {
+                        uri: Url::from_directory_path(&root).unwrap(),
+                        name: "app".into(),
+                    },
+                    WorkspaceFolder {
+                        uri: Url::from_directory_path(&other).unwrap(),
+                        name: "other".into(),
+                    },
+                ]),
+                ..InitializeParams::default()
+            })
+            .await
+            .unwrap();
+        router.initialized(InitializedParams {}).await;
+        for (path, text) in [(&source, &text), (&peer, &peer_text)] {
+            router
+                .did_open(DidOpenTextDocumentParams {
+                    text_document: TextDocumentItem {
+                        uri: uri(path),
+                        version: 1,
+                        language_id: "php".into(),
+                        text: text.clone(),
+                    },
+                })
+                .await;
+        }
+        Self {
+            _temp: temp,
+            router,
+            root,
+            source,
+            peer,
+            closed,
+            text,
+            peer_text,
+            disk_text,
+        }
+    }
+    fn search(&self, scope: wire::Scope) -> wire::Query {
+        wire::Query {
+            uri: uri(&self.source),
+            generation: 73,
+            pattern: "foo($__ss_value)".into(),
+            scope,
+            expected_sources: vec![
+                expected(&self.source, 1, &self.text),
+                expected(&self.peer, 1, &self.peer_text),
+            ],
+        }
+    }
+    async fn proposal(&self, scope: wire::Scope, needle: &str) -> wire::ReplaceQuery {
+        let search = self.search(scope);
+        let found = self
+            .router
+            .workbench_structural_search(search.clone())
+            .await
+            .unwrap();
+        let (file, call) = found
+            .files
+            .iter()
+            .find_map(|file| {
+                let text = if file.stamp.uri == uri(&self.source) {
+                    &self.text
+                } else if file.stamp.uri == uri(&self.closed) {
+                    &self.disk_text
+                } else {
+                    return None;
+                };
+                file.matches
+                    .iter()
+                    .find(|m| &text[m.call.start_byte as usize..m.call.end_byte as usize] == needle)
+                    .map(|m| (file, m.call.clone()))
+            })
+            .expect("selected real search match");
+        wire::ReplaceQuery {
+            search,
+            replacement: "bar($__ss_value)".into(),
+            selections: vec![wire::Selection {
+                stamp: file.stamp.clone(),
+                calls: vec![call],
+            }],
+        }
+    }
+    async fn finish(&self) {
+        assert_eq!(std::fs::read(&self.source).unwrap(), self.text.as_bytes());
+        assert_eq!(
+            std::fs::read(&self.peer).unwrap(),
+            self.peer_text.as_bytes()
+        );
+        self.router.shutdown().await.unwrap();
+    }
+}
+fn apply(text: &str, edits: &[wire::ReplacementEdit]) -> String {
+    let mut out = text.to_owned();
+    for edit in edits.iter().rev() {
+        out.replace_range(
+            edit.call.start_byte as usize..edit.call.end_byte as usize,
+            &edit.new_text,
+        );
+    }
+    out
+}

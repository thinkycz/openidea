+    changed.selections[0].calls[0].range.start.character += 1;
+    cases.push(changed);
+    let mut changed = q.clone();
+    changed.selections[0].stamp.source = wire::SourceKind::Disk;
+    cases.push(changed);
+    let mut changed = q.clone();
+    changed.selections[0].stamp.uri = uri(&f.peer);

+fn prepare(
+    pattern: &str,
+    template: &str,
+    source: &str,
+    indices: &[usize],
+) -> Result<PreparedEdits, ReplaceError> {
+    let pattern = Pattern::compile(pattern).unwrap();
+    let matched = pattern.find_in(source, Limits::default()).unwrap();
+    let selected = indices
+        .iter()
+        .map(|index| matched[*index].call.bytes.clone())
+        .collect::<Vec<_>>();
+    Template::compile(&pattern, template)?.prepare_selected_with_control(
+        &pattern,
+        source,
+        &selected,
+        ReplaceLimits::default(),
+        &|| Ok(()),
+    )
+}
+
+fn apply(source: &str, edits: &PreparedEdits) -> String {
+    let mut result = source.to_owned();
+    for edit in edits.edits.iter().rev() {
+        assert_eq!(
+            edit.source.range,
+            byte_range_to_lsp_range(source, edit.source.bytes.start, edit.source.bytes.end)
+        );
+        result.replace_range(edit.source.bytes.clone(), &edit.new_text);
+    }
+    result
+}

+//! Checked, source-only replacement preparation. No filesystem writes.
+use std::collections::{BTreeMap, BTreeSet};
+
+use super::*;
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(crate) enum ReplaceError {
+    Search(SearchError),
+    Template(&'static str),
+    Selection(&'static str),
+    Budget(&'static str),
+    CandidateSyntax,
+}
+
+impl From<SearchError> for ReplaceError {
+    fn from(error: SearchError) -> Self {
+        Self::Search(error)
+    }
+}
+
+impl std::fmt::Display for ReplaceError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Search(error) => error.fmt(f),
+            Self::Template(message) | Self::Selection(message) | Self::Budget(message) => {
+                f.write_str(message)
+            }
+            Self::CandidateSyntax => {
+                f.write_str("Replacement would produce invalid PHP; no edits were prepared.")
+            }
+        }
+    }
+}
+impl std::error::Error for ReplaceError {}
+
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct ReplaceLimits {
+    pub search: Limits,
+    pub selected: usize,
+    pub replacement_bytes: usize,
+    /// Full resulting document, including unchanged regions and all copies.
+    pub candidate_bytes: usize,
+}
+impl Default for ReplaceLimits {
+    fn default() -> Self {
+        Self {
+            search: Limits::default(),
+            selected: 1000,
+            replacement_bytes: 2 * 1024 * 1024,
+            candidate_bytes: 4 * 1024 * 1024,
+        }
+    }
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(crate) struct Replacement {
+    pub source: SourceRange,
+    pub new_text: String,
+}
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(crate) struct PreparedEdits {
+    pub edits: Vec<Replacement>,
+}
+
+#[derive(Clone, Copy, Debug)]
+enum Requirement {
+    Value,
+    Writable,
+    Reference,
+    Isset,
+}
+#[derive(Clone, Debug)]
+enum SlotKind {
+    Expression(Requirement),
+    Tail {
+        before: String,
+        before_without_commas: String,
+        after: String,
+        fixed_prefix: bool,
+    },
+}
+#[derive(Clone, Debug)]
+struct Slot {
+    range: ByteRange<usize>,
+    name: String,
+    kind: SlotKind,
+}
+#[derive(Clone, Debug)]
+pub(crate) struct Template {
+    source: String,
+    input: ByteRange<usize>,
+    expression: ByteRange<usize>,
+    slots: Vec<Slot>,
+}
+
+fn roles(pattern: &Pattern) -> BTreeMap<String, bool> {
+    let mut result = BTreeMap::new();
+    if let Head::Instance {
+        receiver: Term::Capture(name),
+        ..
+    } = &pattern.head
+    {
+        result.insert(name.clone(), false);
+    }
+    for argument in &pattern.arguments {
+        if let Term::Capture(name) = argument {
+            result.insert(name.clone(), false);
+        }
+    }
+    if let Some(name) = &pattern.tail {
+        result.insert(name.clone(), true);
+    }
+    result
+}
+
+fn remove_commas(text: &str, start: usize, end: usize, tokens: &Tokens<'_>) -> String {
+    // Only punctuation tokens are removed. Commas in comments/strings survive.
+    let mut result = String::new();
+    let mut cursor = start;
+    for token in &tokens.tokens {
+        if token.bytes.start >= start && token.bytes.end <= end && token.kind == TokenKind::Comma {
+            result.push_str(&text[cursor..token.bytes.start]);
+            cursor = token.bytes.end;
+        }
+    }
+    result.push_str(&text[cursor..end]);
+    result
+}
+
+struct Compiler<'a> {
+    tokens: &'a Tokens<'a>,
+    roles: BTreeMap<String, bool>,
+    slots: Vec<Slot>,
+    tails: BTreeSet<(usize, usize)>,
+    error: Option<ReplaceError>,
+    depth: usize,
+    requirement: Requirement,
+}
+impl Compiler<'_> {
+    fn required<'ast, 'arena>(
+        &mut self,
+        expression: &'ast Expression<'arena>,
+        requirement: Requirement,
+    ) {
+        let previous = std::mem::replace(&mut self.requirement, requirement);
+        self.walk_expression(expression, &mut ());
+        self.requirement = previous;
+    }
+}
+impl<'ast, 'arena> MutWalker<'ast, 'arena, ()> for Compiler<'_> {
+    fn walk_statement(&mut self, statement: &'ast Statement<'arena>, context: &mut ()) {
+        if self.error.is_some() {
+            return;
+        }
+        match statement {
+            Statement::Foreach(foreach) => {
+                self.required(foreach.expression, Requirement::Value);
+                if let Some(key) = foreach.target.key() {
+                    self.required(key, Requirement::Writable);
+                }
+                self.required(foreach.target.value(), Requirement::Writable);
+                for statement in foreach.body.statements() {
+                    self.walk_statement(statement, context);
+                }
+            }
+            Statement::Unset(unset) => {
+                for value in unset.values.iter() {
+                    self.required(value, Requirement::Writable);
+                }
+            }
+            _ => walk_statement_mut(self, statement, context),
+        }
+    }
+    fn walk_expression(&mut self, expression: &'ast Expression<'arena>, context: &mut ()) {
+        if self.error.is_some() {
+            return;
+        }
+        if self.depth >= 128 {
+            self.error = Some(ReplaceError::Budget(
+                "Template expression nesting exceeds 128.",
+            ));
+            return;
+        }
+        if matches!(expression, Expression::CompositeString(_)) {
+            match self.tokens.owns_reserved_variable(bytes(expression.span())) {
+                Ok(true) => {
+                    self.error = Some(ReplaceError::Template(
+                        "Captures inside interpolated strings are not supported.",
+                    ));
+                    return;
+                }
+                Err(error) => {
+                    self.error = Some(error.into());
+                    return;
+                }
+                _ => {}
+            }
+        }
+        if matches!(
+            self.requirement,
+            Requirement::Writable | Requirement::Reference
+        ) && matches!(expression, Expression::Parenthesized(_))
+        {
+            self.error = Some(ReplaceError::Template(
+                "Remove parentheses around a writable/reference/isset operand.",
+            ));
+            return;
+        }
+        match capture_name(expression) {
+            Ok(Some(name)) => {
+                let range = bytes(expression.span());
+                if !self.tails.contains(&(range.start, range.end)) {
+                    match self.roles.get(&name) {
+                        Some(false) => self.slots.push(Slot {
+                            range,
+                            name,
+                            kind: SlotKind::Expression(self.requirement),
+                        }),
+                        Some(true) => {
+                            self.error = Some(ReplaceError::Template(
+                                "Argument captures require a final ...$__ss_name slot.",
+                            ))
+                        }
+                        None => {
+                            self.error = Some(ReplaceError::Template(
+                                "Template references an unknown capture.",
+                            ))
+                        }
+                    }
+                }
+            }
+            Err(error) => self.error = Some(error.into()),
+            _ => {}
+        }
+        if self.error.is_none() {
+            self.depth += 1;
+            // Requirements constrain the complete operand, not every descendant:
+            // a writable property may still contain an arbitrary receiver value.
+            let previous = std::mem::replace(&mut self.requirement, Requirement::Value);
+            match expression {
+                Expression::Assignment(assignment) => {
+                    self.required(assignment.lhs, Requirement::Writable);
+                    self.walk_expression(assignment.rhs, context);
+                }
+                Expression::UnaryPrefix(unary) if unary.operator.is_reference() => self.required(
+                    unary.operand,
+                    if matches!(previous, Requirement::Writable) {
+                        Requirement::Writable
+                    } else {
+                        Requirement::Reference
+                    },
+                ),
+                Expression::UnaryPrefix(unary) if unary.operator.is_increment_or_decrement() => {
+                    self.required(unary.operand, Requirement::Writable)
+                }
+                Expression::UnaryPostfix(unary) => {
+                    self.required(unary.operand, Requirement::Writable)
+                }
+                Expression::Construct(mago_syntax::cst::Construct::Isset(isset)) => {
+                    for value in isset.values.iter() {
+                        self.required(value, Requirement::Isset);
+                    }
+                }
+                Expression::Array(array) => {
+                    for element in array.elements.iter() {
+                        if matches!(previous, Requirement::Writable) {
+                            self.writable_element(element);
+                        } else {
+                            self.value_element(element);
+                        }
+                    }
+                }
+                Expression::LegacyArray(array) => {
+                    for element in array.elements.iter() {
+                        if matches!(previous, Requirement::Writable) {
+                            self.writable_element(element);
+                        } else {
+                            self.value_element(element);
+                        }
+                    }
+                }
+                Expression::List(list) if matches!(previous, Requirement::Writable) => {
+                    for element in list.elements.iter() {
+                        self.writable_element(element);
+                    }
+                }
+                _ => walk_expression_mut(self, expression, context),
+            }
+            self.requirement = previous;
+            self.depth -= 1;
+        }
+    }
+
+    fn walk_in_call(&mut self, call: &'ast Call<'arena>, _: &mut ()) {
+        if self.error.is_some() {
+            return;
+        }
+        let list = call.get_argument_list();
+        for (index, argument) in list.arguments.iter().enumerate() {
+            let Argument::Positional(argument) = argument else {
+                continue;
+            };
+            let Some(ellipsis) = argument.ellipsis else {
+                continue;
+            };
+            let Ok(Some(name)) = capture_name(argument.value) else {
+                continue;
+            };
+            if self.roles.get(&name) != Some(&true) || index + 1 != list.arguments.len() {
+                self.error = Some(ReplaceError::Template(
+                    "Only a known argument capture may occupy the final unpacked slot.",
+                ));
+                return;
+            }
+            let value = bytes(argument.value.span());
+            let start = if index == 0 {
+                list.left_parenthesis.end.offset as usize
+            } else {
+                bytes(list.arguments.nodes[index - 1].span()).end
+            };
+            let end = list.right_parenthesis.start.offset as usize;
+            let before = &self.tokens.source[start..ellipsis.start.offset as usize];
+            let before_without_commas = remove_commas(
+                self.tokens.source,
+                start,
+                ellipsis.start.offset as usize,
+                self.tokens,
+            );
+            let after = remove_commas(self.tokens.source, value.end, end, self.tokens);
+            self.tails.insert((value.start, value.end));
+            self.slots.push(Slot {
+                range: start..end,
+                name,
+                kind: SlotKind::Tail {
+                    before: before.to_owned(),
+                    before_without_commas,
+                    after,
+                    fixed_prefix: index != 0,
+                },
+            });
+        }
+    }
+}
+impl Compiler<'_> {
+    fn value_element<'ast, 'arena>(
+        &mut self,
+        element: &'ast mago_syntax::cst::ArrayElement<'arena>,
+    ) {
+        if let Some(key) = element.get_key() {
+            self.required(key, Requirement::Value);
+        }
+        if let Some(value) = element.get_value() {
+            let reference =
+                matches!(value, Expression::UnaryPrefix(unary) if unary.operator.is_reference());
+            self.required(
+                value,
+                if reference {
+                    Requirement::Writable
+                } else {
+                    Requirement::Value
+                },
+            );
+        }
+    }
+    fn writable_element<'ast, 'arena>(
+        &mut self,
+        element: &'ast mago_syntax::cst::ArrayElement<'arena>,
+    ) {
+        use mago_syntax::cst::ArrayElement;
+        match element {
+            ArrayElement::Value(element) => self.required(element.value, Requirement::Writable),
+            ArrayElement::KeyValue(element) => {
+                self.required(element.key, Requirement::Value);
+                self.required(element.value, Requirement::Writable);
+            }
+            ArrayElement::Missing(_) => {}
+            ArrayElement::Variadic(_) => {
+                self.error = Some(ReplaceError::Template(
+                    "A destructuring target cannot unpack an argument capture.",
+                ))
+            }
+        }
+    }
+}
+
+impl Template {
+    pub(crate) fn compile(pattern: &Pattern, input: &str) -> Result<Self, ReplaceError> {
+        if input.len() > MAX_PATTERN_BYTES {
+            return Err(ReplaceError::Budget("Template exceeds 4096 bytes."));
+        }
+        // Always require expression-only input. PHP tags and statement terminators
+        // supplied by the user are not silently trimmed into a different template.
+        let source = format!("<?php {}\n;", input);
+        let tokens = Tokens::read(
+            &source,
+            Limits {
+                source_bytes: MAX_PATTERN_BYTES + 16,
+                ..Limits::default()
+            },
+        )?;
+        with_parsed_program(&source, "structural_replace.compile", |program, _| {
+            Some((|| {
+                if program.has_errors() { return Err(ReplaceError::Template("Enter one valid PHP expression.")); }
+                let mut expression = None;
+                for statement in program.statements.iter() {
+                    match statement {
+                        Statement::OpeningTag(_) => {}
+                        Statement::Expression(statement) if expression.is_none() => expression = Some(statement.expression),
+                        _ => return Err(ReplaceError::Template("Enter exactly one PHP expression, without PHP tags or a semicolon.")),
+                    }
+                }
+                let expression = expression.ok_or(ReplaceError::Template("Enter a PHP expression."))?;
+                let mut compiler = Compiler { tokens: &tokens, roles: roles(pattern), slots: Vec::new(), tails: BTreeSet::new(), error: None, depth: 0, requirement: Requirement::Value };
+                compiler.walk_expression(expression, &mut ());
+                if let Some(error) = compiler.error { return Err(error); }
+                compiler.slots.sort_by_key(|slot| (slot.range.start, slot.range.end));
+                if compiler.slots.windows(2).any(|pair| pair[0].range.end > pair[1].range.start) {
+                    return Err(ReplaceError::Template("Overlapping template capture slots are unsupported."));
+                }
+                // Reserved variables in binding/name-only CST positions are not
+                // expression holes and must not leak into generated PHP as literals.
+                for token in &tokens.tokens {
+                    if token.kind == TokenKind::Variable && source.as_bytes()[token.bytes.clone()].starts_with(CAPTURE_PREFIX)
+                        && !compiler.slots.iter().any(|slot| slot.range.start <= token.bytes.start && token.bytes.end <= slot.range.end) {
+                        return Err(ReplaceError::Template("A capture must occupy an expression or final argument-sequence slot."));
+                    }
+                }
+                let expression = bytes(expression.span());
+                let input_range = "<?php ".len().."<?php ".len() + input.len();
+                if expression.start < input_range.start || expression.end > input_range.end {
+                    return Err(ReplaceError::Template("Template expression lies outside the supplied input."));
+                }
+                Ok(Self { source: source.clone(), input: input_range, expression, slots: compiler.slots })
+            })())
+        }).ok_or(SearchError::ParserFailure)?
+    }
+
+    pub(crate) fn prepare_selected_with_control(
+        &self,
+        pattern: &Pattern,
+        source: &str,
+        selected: &[ByteRange<usize>],
+        limits: ReplaceLimits,
+        checkpoint: &(dyn Fn() -> Result<(), SearchError> + Sync),
+    ) -> Result<PreparedEdits, ReplaceError> {
+        checkpoint()?;
+        if selected.len() > limits.selected {
+            return Err(ReplaceError::Budget("Too many selected replacements."));
+        }
+        let mut selected = selected.to_vec();
+        selected.sort_by_key(|range| (range.start, range.end));
+        if selected
+            .iter()
+            .any(|range| range.start >= range.end || source.get(range.clone()).is_none())
+            || selected.windows(2).any(|pair| pair[0].end > pair[1].start)
+        {
+            return Err(ReplaceError::Selection(
+                "Select distinct, nonoverlapping exact call matches.",
+            ));
+        }
+        let found = pattern.find_in_with_control(source, limits.search, checkpoint)?;
+        let by_span: BTreeMap<_, _> = found
+            .iter()
+            .map(|item| ((item.call.bytes.start, item.call.bytes.end), item))
+            .collect();
+        let mut chosen = Vec::new();
+        for range in selected {
+            chosen.push(
+                *by_span
+                    .get(&(range.start, range.end))
+                    .ok_or(ReplaceError::Selection(
+                        "A selected range is not a current pattern match.",
+                    ))?,
+            );
+        }
+        // Argument regions are derived from the same source's actual CST, not
+        // reconstructed from client captures or an argument-expression join.
+        let tails = tail_regions(pattern, source, &chosen, checkpoint)?;
+        let permissions = capture_permissions(source, &chosen, checkpoint)?;
+        let mut edits = Vec::new();
+        let removed = chosen
+            .iter()
+            .try_fold(0usize, |sum, found| sum.checked_add(found.call.bytes.len()))
+            .ok_or(ReplaceError::Budget("Selected source byte count overflow."))?;
+        let untouched = source
+            .len()
+            .checked_sub(removed)
+            .ok_or(SearchError::InvalidSpan)?;
+        let mut retained_output_bytes = 0usize;
+        if untouched > limits.candidate_bytes {
+            return Err(ReplaceError::Budget(
+                "Full proposed document exceeds the replacement budget.",
+            ));
+        }
+        for found in chosen {
+            checkpoint()?;
+            // Reserve unchanged bytes first. Each render is capped by the final
+            // remaining aggregate budget BEFORE copying, not after retaining it.
+            let remaining = limits.candidate_bytes - untouched - retained_output_bytes;
+            let render_limits = ReplaceLimits {
+                replacement_bytes: limits.replacement_bytes.min(remaining),
+                ..limits
+            };
+            let new_text = self.render(
+                source,
+                found,
+                tails.get(&(found.call.bytes.start, found.call.bytes.end)),
+                &permissions,
+                render_limits,
+                checkpoint,
+            )?;
+            retained_output_bytes =
+                retained_output_bytes
+                    .checked_add(new_text.len())
+                    .ok_or(ReplaceError::Budget(
+                        "Proposed document byte count overflow.",
+                    ))?;
+            edits.push(Replacement {
+                source: found.call.clone(),
+                new_text,
+            });
+        }
+        let candidate_bytes =
+            untouched
+                .checked_add(retained_output_bytes)
+                .ok_or(ReplaceError::Budget(
+                    "Proposed document byte count overflow.",
+                ))?;
+        let mut candidate = String::with_capacity(candidate_bytes);
+        let mut cursor = 0;
+        for edit in &edits {
+            checkpoint()?;
+            candidate.push_str(&source[cursor..edit.source.bytes.start]);
+            candidate.push_str(&edit.new_text);
+            cursor = edit.source.bytes.end;
+        }
+        candidate.push_str(&source[cursor..]);
+        let candidate_limits = Limits {
+            source_bytes: limits.candidate_bytes,
+            ..limits.search
+        };
+        Tokens::read_with_control(&candidate, candidate_limits, checkpoint).map_err(|error| {
+            if error == SearchError::SourceSyntax {
+                ReplaceError::CandidateSyntax
+            } else {
+                error.into()
+            }
+        })?;
+        checkpoint()?;
+        let valid =
+            with_parsed_program(&candidate, "structural_replace.candidate", |program, _| {
+                Some(!program.has_errors())
+            })
+            .ok_or(SearchError::ParserFailure)?;
+        if !valid {
+            return Err(ReplaceError::CandidateSyntax);
+        }
+        validate_candidate_operands(&candidate, candidate_limits, checkpoint)?;
+        checkpoint()?;
+        Ok(PreparedEdits { edits })
+    }
+
+    fn render(
+        &self,
+        source: &str,
+        found: &Match,
+        tail: Option<&TailRegion>,
+        permissions: &BTreeMap<(usize, usize), Permissions>,
+        limits: ReplaceLimits,
+        checkpoint: &(dyn Fn() -> Result<(), SearchError> + Sync),
+    ) -> Result<String, ReplaceError> {
+        let mut output = String::new();
+        let mut cursor = self.expression.start;
+        let mut occurrences: BTreeMap<&str, usize> = BTreeMap::new();
+        append(&mut output, "(", limits.replacement_bytes)?;
+        append(
+            &mut output,
+            &self.source[self.input.start..self.expression.start],
+            limits.replacement_bytes,
+        )?;
+        for slot in &self.slots {
+            checkpoint()?;
+            append(
+                &mut output,
+                &self.source[cursor..slot.range.start],
+                limits.replacement_bytes,
+            )?;
+            match (&slot.kind, found.captures.get(&slot.name)) {
+                (SlotKind::Expression(requirement), Some(Capture::Expression(ranges)))
+                    if !ranges.is_empty() =>
+                {
+                    let index = occurrences.entry(&slot.name).or_default();
+                    let range = &ranges.get(*index).unwrap_or(&ranges[0]).bytes;
+                    *index += 1;
+                    let grouped = matches!(requirement, Requirement::Value | Requirement::Isset);
+                    if !matches!(requirement, Requirement::Value) {
+                        let permitted =
+                            permissions
+                                .get(&(range.start, range.end))
+                                .is_some_and(|permissions| match requirement {
+                                    Requirement::Writable => permissions.writable,
+                                    Requirement::Reference => permissions.reference,
+                                    Requirement::Isset => permissions.isset,
+                                    Requirement::Value => true,
+                                });
+                        if !permitted {
+                            return Err(ReplaceError::Template(
+                                "A captured expression cannot be used in this writable/reference/isset position.",
+                            ));
+                        }
+                    }
+                    if grouped {
+                        append(&mut output, "(", limits.replacement_bytes)?;
+                    }
+                    append(
+                        &mut output,
+                        source.get(range.clone()).ok_or(SearchError::InvalidSpan)?,
+                        limits.replacement_bytes,
+                    )?;
+                    if grouped {
+                        append(&mut output, ")", limits.replacement_bytes)?;
+                    }
+                }
+                (
+                    SlotKind::Tail {
+                        before,
+                        before_without_commas,
+                        after,
+                        fixed_prefix,
+                    },
+                    Some(Capture::Arguments(arguments)),
+                ) => {
+                    let tail = tail.ok_or(SearchError::InvalidSpan)?;
+                    let use_source_comma =
+                        *fixed_prefix && !arguments.is_empty() && tail.comma.is_some();
+                    if arguments.is_empty() || use_source_comma {
+                        // Remove only the actual template comma; preserve comments
+                        // and whitespace, then the empty source sequence's trivia.
+                        append(&mut output, before_without_commas, limits.replacement_bytes)?;
+                    } else {
+                        if *fixed_prefix && !before.as_bytes().contains(&b',') {
+                            return Err(SearchError::InvalidSpan.into());
+                        }
+                        append(&mut output, before, limits.replacement_bytes)?;
+                    }
+                    if use_source_comma || tail.comma.is_none() {
+                        append(
+                            &mut output,
+                            &source[tail.range.clone()],
+                            limits.replacement_bytes,
+                        )?;
+                    } else if let Some(comma) = &tail.comma {
+                        append(
+                            &mut output,
+                            &source[tail.range.start..comma.start],
+                            limits.replacement_bytes,
+                        )?;
+                        append(
+                            &mut output,
+                            &source[comma.end..tail.range.end],
+                            limits.replacement_bytes,
+                        )?;
+                    }
+                    append(&mut output, after, limits.replacement_bytes)?;
+                }
+                _ => {
+                    return Err(ReplaceError::Template(
+                        "Capture role no longer agrees with the compiled pattern.",
+                    ));
+                }
+            }
+            cursor = slot.range.end;
+        }
+        append(
+            &mut output,
+            &self.source[cursor..self.expression.end],
+            limits.replacement_bytes,
+        )?;
+        let suffix = &self.source[self.expression.end..self.input.end];
+        append(&mut output, suffix, limits.replacement_bytes)?;
+        // A trailing // or # comment must not consume the protective closing
+        // parenthesis or the unchanged source suffix. Preserve all input bytes;
+        // a conservative extra newline also handles block-comment trivia.
+        if !suffix.trim().is_empty() {
+            append(&mut output, "\n", limits.replacement_bytes)?;
+        }
+        append(&mut output, ")", limits.replacement_bytes)?;
+        Ok(output)
+    }
+}
+
+fn append(output: &mut String, text: &str, limit: usize) -> Result<(), ReplaceError> {
+    if output
+        .len()
+        .checked_add(text.len())
+        .is_none_or(|size| size > limit)
+    {
+        return Err(ReplaceError::Budget(
+            "Rendered replacement exceeds the byte budget.",
+        ));
+    }
+    output.push_str(text);
+    Ok(())
+}
+
+#[derive(Clone, Copy, Debug)]
+struct Permissions {
+    writable: bool,
+    reference: bool,
+    isset: bool,
+}
+fn isset_operand(expression: &Expression<'_>) -> bool {
+    match expression {
+        Expression::Parenthesized(inner) => isset_operand(inner.expression),
+        Expression::Variable(_) | Expression::ArrayAccess(_) => true,
+        Expression::Access(
+            mago_syntax::cst::Access::Property(_)
+            | mago_syntax::cst::Access::StaticProperty(_)
+            | mago_syntax::cst::Access::NullSafeProperty(_),
+        ) => true,
+        _ => false,
+    }
+}
+
+// These are syntactic operand restrictions, not class/type resolution. Mago's
+// parser accepts expression nodes in write/isset positions that PHP rejects at
+// compile time. Check the WHOLE candidate, including literal template receivers
+// and descendants of constrained property chains, not only substituted holes.
+fn write_chain(expression: &Expression<'_>, depth: usize) -> bool {
+    use mago_syntax::cst::Access;
+    if depth == 0 {
+        return false;
+    }
+    match expression {
+        Expression::Parenthesized(inner) => write_chain(inner.expression, depth - 1),
+        Expression::Variable(_) => true,
+        Expression::ArrayAccess(access) => write_chain(access.array, depth - 1),
+        Expression::ArrayAppend(access) => write_chain(access.array, depth - 1),
+        Expression::Access(Access::Property(access)) => write_chain(access.object, depth - 1),
+        Expression::Access(Access::StaticProperty(_)) => true,
+        Expression::Call(call) => !call.is_null_safe() && !nullsafe_chain(expression, depth - 1),
+        _ => false,
+    }
+}
+
+fn nullsafe_chain(expression: &Expression<'_>, depth: usize) -> bool {
+    use mago_syntax::cst::Access;
+    if depth == 0 {
+        return true;
+    }
+    match expression {
+        Expression::Parenthesized(inner) => nullsafe_chain(inner.expression, depth - 1),
+        Expression::ArrayAccess(access) => nullsafe_chain(access.array, depth - 1),
+        Expression::ArrayAppend(access) => nullsafe_chain(access.array, depth - 1),
+        Expression::Access(Access::NullSafeProperty(_)) => true,
+        Expression::Access(Access::Property(access)) => nullsafe_chain(access.object, depth - 1),
+        Expression::Call(Call::NullSafeMethod(_)) => true,
+        Expression::Call(Call::Method(call)) => nullsafe_chain(call.object, depth - 1),
+        _ => false,
+    }
+}
+
+fn target_operand(
+    expression: &Expression<'_>,
+    reference_call: bool,
+    destructuring: bool,
+    depth: usize,
+) -> bool {
+    use mago_syntax::cst::{Access, ArrayElement};
+    if depth == 0 {
+        return false;
+    }
+    let target = |expression: &Expression<'_>| match expression {
+        Expression::UnaryPrefix(unary) if unary.operator.is_reference() => {
+            target_operand(unary.operand, false, false, depth - 1)
+        }
+        _ => target_operand(expression, false, true, depth - 1),
+    };
+    let element = |element: &ArrayElement<'_>| match element {
+        ArrayElement::Value(element) => target(element.value),
+        ArrayElement::KeyValue(element) => target(element.value),
+        ArrayElement::Missing(_) => true,
+        ArrayElement::Variadic(_) => false,
+    };
+    match expression {
+        Expression::Variable(_) => true,
+        Expression::ArrayAccess(access) => write_chain(access.array, depth - 1),
+        Expression::ArrayAppend(access) => write_chain(access.array, depth - 1),
+        Expression::Access(Access::Property(access)) => write_chain(access.object, depth - 1),
+        Expression::Access(Access::StaticProperty(_)) => true,
+        Expression::Call(call) => {
+            reference_call && !call.is_null_safe() && !nullsafe_chain(expression, depth - 1)
+        }
+        Expression::Array(array) if destructuring => array.elements.iter().all(element),
+        Expression::LegacyArray(array) if destructuring => array.elements.iter().all(element),
+        Expression::List(list) if destructuring => list.elements.iter().all(element),
+        _ => false,
+    }
+}
+
+fn array_references_valid(
+    array: &mago_syntax::cst::TokenSeparatedSequence<'_, mago_syntax::cst::ArrayElement<'_>>,
+    depth: usize,
+) -> bool {
+    array.iter().all(|element| match element.get_value() {
+        Some(Expression::UnaryPrefix(unary)) if unary.operator.is_reference() => {
+            target_operand(unary.operand, false, false, depth)
+        }
+        _ => true,
+    })
+}
+
+fn append_in_chain(expression: &Expression<'_>, depth: usize) -> bool {
+    use mago_syntax::cst::Access;
+    if depth == 0 {
+        return true;
+    }
+    match expression {
+        Expression::ArrayAppend(_) => true,
+        Expression::ArrayAccess(access) => append_in_chain(access.array, depth - 1),
+        Expression::Parenthesized(inner) => append_in_chain(inner.expression, depth - 1),
+        Expression::Access(Access::Property(access)) => append_in_chain(access.object, depth - 1),
+        Expression::Call(Call::Method(call)) => append_in_chain(call.object, depth - 1),
+        _ => false,
+    }
+}
+
+fn validate_candidate_operands(
+    source: &str,
+    limits: Limits,
+    checkpoint: &(dyn Fn() -> Result<(), SearchError> + Sync),
+) -> Result<(), ReplaceError> {
+    struct Grammar<'a> {
+        checkpoint: &'a (dyn Fn() -> Result<(), SearchError> + Sync),
+        error: Option<ReplaceError>,
+        nodes: usize,
+        limits: Limits,
+    }
+    impl<'ast, 'arena> MutWalker<'ast, 'arena, ()> for Grammar<'_> {
+        fn walk_expression(&mut self, expression: &'ast Expression<'arena>, context: &mut ()) {
+            if self.error.is_some() {
+                return;
+            }
+            if let Err(error) = (self.checkpoint)() {
+                self.error = Some(error.into());
+                return;
+            }
+            self.nodes += 1;
+            if self.nodes > self.limits.nodes {
+                self.error = Some(ReplaceError::Budget(
+                    "Candidate operand validation exceeded the node budget.",
+                ));
+                return;
+            }
+            let depth = self.limits.nesting;
+            let allowed = match expression {
+                Expression::Assignment(assignment) => {
+                    target_operand(assignment.lhs, false, true, depth)
+                        && (assignment.operator.is_assign()
+                            || !matches!(
+                                assignment.lhs,
+                                Expression::Array(_)
+                                    | Expression::LegacyArray(_)
+                                    | Expression::List(_)
+                            ))
+                }
+                Expression::Array(array) => array_references_valid(&array.elements, depth),
+                Expression::LegacyArray(array) => array_references_valid(&array.elements, depth),
+                Expression::UnaryPrefix(unary) if unary.operator.is_increment_or_decrement() => {
+                    target_operand(unary.operand, false, false, depth)
+                }
+                Expression::UnaryPostfix(unary) => {
+                    target_operand(unary.operand, false, false, depth)
+                }
+                Expression::UnaryPrefix(unary) if unary.operator.is_reference() => {
+                    target_operand(unary.operand, true, false, depth)
+                }
+                Expression::Construct(mago_syntax::cst::Construct::Isset(isset)) => {
+                    isset.values.iter().all(|value| isset_operand(value))
+                }
+                _ => true,
+            };
+            if !allowed {
+                self.error = Some(ReplaceError::CandidateSyntax);
+                return;
+            }
+            walk_expression_mut(self, expression, context);
+        }
+        fn walk_statement(&mut self, statement: &'ast Statement<'arena>, context: &mut ()) {
+            if self.error.is_some() {
+                return;
+            }
+            if let Err(error) = (self.checkpoint)() {
+                self.error = Some(error.into());
+                return;
+            }
+            let allowed =
+                match statement {
+                    Statement::Foreach(foreach) => {
+                        let value = foreach.target.value();
+                        let value = if let Expression::UnaryPrefix(unary) = value {
+                            if unary.operator.is_reference() {
+                                unary.operand
+                            } else {
+                                value
+                            }
+                        } else {
+                            value
+                        };
+                        foreach.target.key().is_none_or(|key| {
+                            target_operand(key, false, false, self.limits.nesting)
+                        }) && target_operand(value, false, true, self.limits.nesting)
+                    }
+                    Statement::Unset(unset) => unset.values.iter().all(|value| {
+                        target_operand(value, false, false, self.limits.nesting)
+                            && !append_in_chain(value, self.limits.nesting)
+                    }),
+                    _ => true,
+                };
+            if !allowed {
+                self.error = Some(ReplaceError::CandidateSyntax);
+                return;
+            }
+            walk_statement_mut(self, statement, context);
+        }
+    }
+    with_parsed_program(
+        source,
+        "structural_replace.candidate_operands",
+        |program, _| {
+            let mut grammar = Grammar {
+                checkpoint,
+                error: None,
+                nodes: 0,
+                limits,
+            };
+            grammar.walk_program(program, &mut ());
+            Some(grammar.error.map_or(Ok(()), Err))
+        },
+    )
+    .ok_or(SearchError::ParserFailure)?
+}
+fn capture_permissions(
+    source: &str,
+    selected: &[&Match],
+    checkpoint: &(dyn Fn() -> Result<(), SearchError> + Sync),
+) -> Result<BTreeMap<(usize, usize), Permissions>, ReplaceError> {
+    let wanted = selected
+        .iter()
+        .flat_map(|found| found.captures.values())
+        .filter_map(|capture| {
+            if let Capture::Expression(ranges) = capture {
+                Some(ranges)
+            } else {
+                None
+            }
+        })
+        .flatten()
+        .map(|range| (range.bytes.start, range.bytes.end))
+        .collect();
+    struct PermissionsWalker<'a> {
+        wanted: BTreeSet<(usize, usize)>,
+        result: BTreeMap<(usize, usize), Permissions>,
+        checkpoint: &'a (dyn Fn() -> Result<(), SearchError> + Sync),
+        error: Option<SearchError>,
+    }
+    impl<'ast, 'arena> MutWalker<'ast, 'arena, ()> for PermissionsWalker<'_> {
+        fn walk_expression(&mut self, expression: &'ast Expression<'arena>, context: &mut ()) {
+            if self.error.is_some() {
+                return;
+            }
+            if let Err(error) = (self.checkpoint)() {
+                self.error = Some(error);
+                return;
+            }
+            let range = bytes(expression.span());
+            let key = (range.start, range.end);
+            if self.wanted.contains(&key) {
+                let writable = target_operand(expression, false, true, Limits::default().nesting);
+                let reference = target_operand(expression, true, false, Limits::default().nesting);
+                let isset = isset_operand(expression);
+                self.result.insert(
+                    key,
+                    Permissions {
+                        writable,
+                        reference,
+                        isset,
+                    },
+                );
+            }
+            walk_expression_mut(self, expression, context);
+        }
+        fn walk_statement(&mut self, statement: &'ast Statement<'arena>, context: &mut ()) {
+            if self.error.is_some() {
+                return;
+            }
+            if let Err(error) = (self.checkpoint)() {
+                self.error = Some(error);
+                return;
+            }
+            walk_statement_mut(self, statement, context);
+        }
+    }
+    with_parsed_program(
+        source,
+        "structural_replace.capture_permissions",
+        |program, _| {
+            let mut visitor = PermissionsWalker {
+                wanted,
+                result: BTreeMap::new(),
+                checkpoint,
+                error: None,
+            };
+            visitor.walk_program(program, &mut ());
+            Some(match visitor.error {
+                Some(error) => Err(error.into()),
+                None => Ok(visitor.result),
+            })
+        },
+    )
+    .ok_or(SearchError::ParserFailure)?
+}
+
+#[derive(Clone, Debug)]
+struct TailRegion {
+    range: ByteRange<usize>,
+    comma: Option<ByteRange<usize>>,
+}
+fn tail_regions(
+    pattern: &Pattern,
+    source: &str,
+    selected: &[&Match],
+    checkpoint: &(dyn Fn() -> Result<(), SearchError> + Sync),
+) -> Result<BTreeMap<(usize, usize), TailRegion>, ReplaceError> {
+    if pattern.tail.is_none() {
+        return Ok(BTreeMap::new());
+    }
+    struct Regions<'a> {
+        selected: BTreeSet<(usize, usize)>,
+        minimum: usize,
+        result: BTreeMap<(usize, usize), TailRegion>,
+        checkpoint: &'a (dyn Fn() -> Result<(), SearchError> + Sync),
+        error: Option<SearchError>,
+    }
+    impl<'ast, 'arena> MutWalker<'ast, 'arena, ()> for Regions<'_> {
+        fn walk_expression(&mut self, expression: &'ast Expression<'arena>, context: &mut ()) {
+            if self.error.is_some() {
+                return;
+            }
+            if let Err(error) = (self.checkpoint)() {
+                self.error = Some(error);
+                return;
+            }
+            walk_expression_mut(self, expression, context);
+        }
+        fn walk_statement(&mut self, statement: &'ast Statement<'arena>, context: &mut ()) {
+            if self.error.is_some() {
+                return;
+            }
+            if let Err(error) = (self.checkpoint)() {
+                self.error = Some(error);
+                return;
+            }
+            walk_statement_mut(self, statement, context);
+        }
+        fn walk_in_call(&mut self, call: &'ast Call<'arena>, _: &mut ()) {
+            let span = bytes(call.span());
+            let key = (span.start, span.end);
+            if !self.selected.contains(&key) {
+                return;
+            }
+            let list = call.get_argument_list();
+            let mut start = list.left_parenthesis.end.offset as usize;
+            let end = list.right_parenthesis.start.offset as usize;
+            let mut comma = None;
+            if self.minimum > 0 {
+                start = bytes(list.arguments.nodes[self.minimum - 1].span()).end;
+                if let Some(token) = list.arguments.tokens.get(self.minimum - 1) {
+                    let offset = token.start.offset as usize;
+                    comma = Some(offset..offset + token.value.len());
+                }
+            }
+            self.result.insert(
+                key,
+                TailRegion {
+                    range: start..end,
+                    comma,
+                },
+            );
+        }
+    }
+    with_parsed_program(source, "structural_replace.tail_regions", |program, _| {
+        let mut visitor = Regions {
+            selected: selected
+                .iter()
+                .map(|found| (found.call.bytes.start, found.call.bytes.end))
+                .collect(),
+            minimum: pattern.arguments.len(),
+            result: BTreeMap::new(),
+            checkpoint,
+            error: None,
+        };
+        visitor.walk_program(program, &mut ());
+        Some(match visitor.error {
+            Some(error) => Err(error.into()),
+            None => Ok(visitor.result),
+        })
+    })
+    .ok_or(SearchError::ParserFailure)?
+}

+
+#[test]
+fn readonly_class_accessor_implicit_properties_offer_getters_without_setters() {
+    let backend = create_test_backend();
+    let content = "<?php\r\n// ž🐘\r\nreadonly class ImmutableLabel\r\n{\r\n    private string $name;\r\n}\r\n";
+    assert!(content.contains("\r\n"));
+    let actions = actions_at(&backend, content, "private string $name");
+    assert!(find_action_titled(&actions, "Generate setter").is_none());
+    assert!(find_action_titled(&actions, "Generate getter and setter").is_none());
+    let getter =
+        find_action_titled(&actions, "Generate getter").expect("readonly class retains its getter");
+    let edits = extract_edits(getter);
+    assert_eq!(edits.len(), 1);
+    assert_eq!(edits[0].range.start, edits[0].range.end);
+    assert!(
+        edits[0]
+            .new_text
+            .contains("public function getName(): string")
+    );
+    assert!(edits[0].new_text.contains("return $this->name;"));
+    assert!(!edits[0].new_text.contains("$this->name ="));
+}
+
+#[test]
+fn readonly_class_accessor_multi_property_declaration_keeps_both_typed_getters() {
+    let backend = create_test_backend();
+    let content = "<?php\nreadonly class ImmutableFlags\n{\n    private bool $active, $ready;\n}\n";
+    let actions = actions_at(&backend, content, "private bool $active");
+    assert!(find_action_titled(&actions, "Generate setter").is_none());
+    assert!(find_action_titled(&actions, "Generate getter and setter").is_none());
+    let getter = find_action_titled(&actions, "Generate getter")
+        .expect("all implicit readonly properties retain getters");
+    let edits = extract_edits(getter);
+    assert_eq!(edits.len(), 1);
+    assert!(
+        edits[0]
+            .new_text
+            .contains("public function isActive(): bool")
+    );
+    assert!(
+        edits[0]
+            .new_text
+            .contains("public function isReady(): bool")
+    );
+    assert!(edits[0].new_text.contains("return $this->active;"));
+    assert!(edits[0].new_text.contains("return $this->ready;"));
+}
+
+#[test]
+fn readonly_class_accessor_mutable_class_preserves_setter_and_combined_actions() {
+    let backend = create_test_backend();
+    let content = "<?php\nclass MutableLabel\n{\n    private string $name;\n}\n";
+    let actions = actions_at(&backend, content, "private string $name");
+    assert!(find_action_titled(&actions, "Generate getter").is_some());
+    assert!(find_action_titled(&actions, "Generate getter and setter").is_some());
+    let setter =
+        find_action_titled(&actions, "Generate setter").expect("mutable class retains its setter");
+    let edits = extract_edits(setter);
+    assert_eq!(edits.len(), 1);
+    assert!(
+        edits[0]
+            .new_text
+            .contains("public function setName(string $name): self")
+    );
+    assert!(edits[0].new_text.contains("$this->name = $name;"));
+    assert!(edits[0].new_text.contains("return $this;"));
+}
+
+#[test]
+fn readonly_class_accessor_explicit_readonly_property_policy_is_preserved() {
+    let backend = create_test_backend();
+    for keyword in ["class", "readonly class"] {
+        let content =
+            format!("<?php\n{keyword} ExplicitLabel\n{{\n    private readonly string $name;\n}}\n");
+        let actions = actions_at(&backend, &content, "private readonly string $name");
+        assert!(
+            find_action_titled(&actions, "Generate getter").is_some(),
+            "{keyword}"
+        );
+        assert!(
+            find_action_titled(&actions, "Generate setter").is_none(),
+            "{keyword}"
+        );
+        assert!(
+            find_action_titled(&actions, "Generate getter and setter").is_none(),
+            "{keyword}"
+        );
+    }
+}

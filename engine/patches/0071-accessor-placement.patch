+// Accessors must stay in their owning body without separating another member
+// from its documentation, attributes, or trailing comments.
+fn assert_accessor_insertion(content: &str, insertion_anchor: &str, readonly: bool) {
+    let backend = create_test_backend();
+    let actions = actions_at(&backend, content, "private int $value");
+    let expected = content
+        .find(insertion_anchor)
+        .expect("unique insertion anchor")
+        + insertion_anchor.len();
+    let titles: &[&str] = if readonly {
+        &["Generate getter"]
+    } else {
+        &[
+            "Generate getter",
+            "Generate setter",
+            "Generate getter and setter",
+        ]
+    };
+    for title in titles {
+        let action = find_action_titled(&actions, title).expect("accessor action");
+        let edits = extract_edits(action);
+        assert_eq!(edits.len(), 1, "{title}: insertion only");
+        assert_eq!(edits[0].range.start, edits[0].range.end);
+        assert_eq!(
+            lsp_pos_to_offset(content, edits[0].range.start),
+            expected,
+            "{title}: must remain in the owning body and before following member trivia"
+        );
+        let result = apply_edits(content, &edits);
+        assert_eq!(&result[..expected], &content[..expected]);
+        assert_eq!(
+            &result[expected + edits[0].new_text.len()..],
+            &content[expected..]
+        );
+    }
+    if readonly {
+        assert!(find_action_titled(&actions, "Generate setter").is_none());
+        assert!(find_action_titled(&actions, "Generate getter and setter").is_none());
+    }
+}
+
+#[test]
+fn compact_class_accessors_stay_before_closing_body_and_outside_statement() {
+    assert_accessor_insertion(
+        "<?php class Compact { private int $value = 1; } $outside = 42;\n",
+        "private int $value = 1;",
+        false,
+    );
+}
+
+#[test]
+fn compact_trait_accessors_stay_before_following_class() {
+    assert_accessor_insertion(
+        "<?php trait Compact { private int $value = 1; } class UsesCompact { use Compact; }",
+        "private int $value = 1;",
+        false,
+    );
+}
+
+#[test]
+fn compact_readonly_getter_stays_after_constructor_inside_body() {
+    assert_accessor_insertion(
+        "<?php readonly class Compact { private int $value; public function __construct() { $this->value = 7; } } $outside = 42;\n",
+        "$this->value = 7; }",
+        true,
+    );
+}
+
+#[test]
+fn compact_accessors_do_not_cross_following_property() {
+    assert_accessor_insertion(
+        "<?php class Compact { private int $value = 1; public function existing() {} public int $tail = 2; }\n",
+        "public function existing() {}",
+        false,
+    );
+}
+
+#[test]
+fn compact_accessors_preserve_following_multiline_docblock() {
+    assert_accessor_insertion(
+        "<?php class Compact { private int $value = 1; public function existing() {} /** tail }\n * @var int\n */ public int $tail = 2; }\n",
+        "public function existing() {}",
+        false,
+    );
+}
+
+#[test]
+fn compact_accessors_preserve_trailing_multiline_comment() {
+    assert_accessor_insertion(
+        "<?php class Compact { private int $value = 1; /* comment }\n continued */ }\n",
+        "private int $value = 1;",
+        false,
+    );
+}
+
+#[test]
+fn compact_namespaced_accessors_preserve_unicode_crlf_and_following_class() {
+    assert_accessor_insertion(
+        "<?php\r\nnamespace Demo { /* λ😀 } */ class Compact { private int $value = 1; } class After {} }\r\n",
+        "private int $value = 1;",
+        false,
+    );
+}
+
+#[test]
+fn multiline_accessors_keep_existing_after_method_line_placement() {
+    assert_accessor_insertion(
+        "<?php\nclass Compact {\n    private int $value = 1;\n    public function existing() {} // trailing comment\n    /** tail */\n    public int $tail = 2;\n}\n",
+        "public function existing() {} // trailing comment\n",
+        false,
+    );
+}
+
+#[test]
+fn unfinished_class_does_not_offer_outside_body_accessors() {
+    let backend = create_test_backend();
+    for content in [
+        "<?php class Broken { private int $value;",
+        "<?php class Broken { private int $value; public function existing() {",
+    ] {
+        let actions = actions_at(&backend, content, "private int $value");
+        assert!(generate_titles(&actions).is_empty());
+    }
+}
+
+#[test]
+fn compact_accessors_keep_following_attributes_and_docblock_together() {
+    assert_accessor_insertion(
+        "<?php class Compact { private int $value = 1; public function existing() {} /** tail */ #[Example] public int $tail = 2; }\n",
+        "public function existing() {}",
+        false,
+    );
+}

+    let refusal = promoted
+        .disabled
+        .expect("must explain unsafe attribute transfer");
+    assert!(!refusal.reason.is_empty());
+    assert!(
+        promoted.edit.is_none(),
+        "no destructive proposal when metadata cannot be transferred"

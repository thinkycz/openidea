+fn constructor_legality_doc_only_void_never_are_not_parameter_types() {
+    for doc_type in ["void", "never", "VOID", "Never", "?void", "?never"] {
+        let content = format!(
+            "<?php\nclass SpanCase {{\n    /** @var {doc_type} */\n    private $value;\n}}\n"
+        );
+        let action = constructor_span_action(&content, "Generate constructor");
+        let result = apply_workspace_edit(&content, action.edit.as_ref().unwrap());
+        assert!(
+            result.contains("function __construct($value)"),
+            "doc-only {doc_type} cannot be a parameter type: {result}"
+        );
+    }

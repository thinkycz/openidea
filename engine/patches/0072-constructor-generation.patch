+#[test]
+fn constructor_span_attributed_property_keeps_traditional_and_explains_promotion_limit() {
+    let content = "<?php class SpanCase { #[Example] private int $value; }";
+    let traditional = constructor_span_action(content, "Generate constructor");
+    assert!(traditional.disabled.is_none());
+    let result = apply_workspace_edit(content, traditional.edit.as_ref().unwrap());
+    assert!(result.contains("#[Example] private int $value;"));
+    assert_owned_constructor(&result);

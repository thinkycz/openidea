+fn assert_promoted_doc_only_type(doc_type: &str) {
+    let content =
+        format!("<?php\nclass SpanCase {{\n    /** @var {doc_type} */\n    private $value;\n}}\n");
+    let action = constructor_span_action(&content, "Generate promoted constructor");
+    let result = apply_workspace_edit(&content, action.edit.as_ref().unwrap());
+    let backend = create_test_backend();
+    let original = backend.parse_php(&content);
+    let generated = backend.parse_php(&result);
+    let original_property = &original[0].properties[0];
+    let generated_property = &generated[0].properties[0];
+    assert!(original_property.native_type_hint.is_none());
+    assert!(
+        generated_property.native_type_hint.is_none(),
+        "promotion must preserve originally untyped property semantics: {result}"
+    );
+    assert_eq!(
+        generated_property.type_hint, original_property.type_hint,
+        "effective PHPDoc type must survive on promoted property: {result}"
+    );
+    assert!(result.contains(&format!("/** @var {doc_type} */")));
+}

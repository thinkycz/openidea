+#[test]
+fn constructor_span_promotion_transfers_property_docblock_to_parameter() {
+    let content =
+        "<?php\nclass SpanCase {\n    /** @var positive-int */\n    private int $value;\n}\n";
+    let action = constructor_span_action(content, "Generate promoted constructor");
+    assert_disjoint_constructor_edits(content, &action);
+    let result = apply_workspace_edit(content, action.edit.as_ref().unwrap());
+    let constructor = result
+        .find("public function __construct")
+        .expect("constructor");
+    let docblock = result
+        .find("/** @var positive-int */")
+        .expect("property documentation preserved");
+    let parameter = result
+        .find("private int $value")
+        .expect("promoted parameter");
+    assert!(
+        constructor < docblock && docblock < parameter,
+        "documentation belongs to promoted parameter: {result}"
+    );
+    assert_eq!(result.matches("/** @var positive-int */").count(), 1);
+    assert_owned_constructor(&result);
+}

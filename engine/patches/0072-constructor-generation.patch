+#[test]
+fn constructor_legality_promotion_respects_php80_syntax_boundary() {
+    let content = "<?php\nclass SpanCase {\n    private int $value;\n}\n";
+    let point = position_of(content, "$value");
+    for (version, supported) in [
+        (phpantom_lsp::types::PhpVersion::new(7, 4), false),
+        (phpantom_lsp::types::PhpVersion::new(8, 0), true),
+    ] {
+        let backend = create_test_backend();
+        backend.set_php_version(version);
+        let actions = get_code_actions_in_range(
+            &backend,
+            "file:///test.php",
+            content,
+            Range::new(point, point),
+        );
+        let traditional = find_action_titled(&actions, "Generate constructor")
+            .expect("traditional remains available");
+        assert!(traditional.disabled.is_none());
+        let promoted = find_action_titled(&actions, "Generate promoted constructor")
+            .expect("promotion result");
+        assert_eq!(promoted.disabled.is_none(), supported, "target {version:?}");
+        if !supported {
+            assert!(promoted.edit.is_none());
+        }
+    }
+}

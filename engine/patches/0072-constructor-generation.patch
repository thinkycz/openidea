+
+/// Reach a line end after a member only within its canonical body/sibling boundary.
+pub(super) fn member_insertion_offset<'a>(
+    end: u32,
+    members: &Sequence<'a, ClassLikeMember<'a>>,
+    content: &str,
+    trivia: &[Trivia<'a>],
+    body_end: u32,
+) -> usize {
+    let next = members
+        .iter()
+        .filter(|member| member.span().start.offset >= end)
+        .min_by_key(|member| member.span().start.offset);
+    let boundary = next
+        .map(|member| {
+            get_docblock_text_with_offset(trivia, content, member)
+                .map(|(_, offset)| offset)
+                .filter(|offset| *offset >= end)
+                .unwrap_or_else(|| member.span().start.offset)
+        })
+        .unwrap_or(body_end)
+        .min(body_end);
+    // A following member's docblock belongs to that member. Also never split
+    // an intervening multi-line comment merely to reach the first newline.
+    let Some(newline) = content[end as usize..boundary as usize].find('\n') else {
+        return end as usize;
+    };
+    let newline = end as usize + newline;
+    let index = trivia.partition_point(|item| item.span.end.offset <= newline as u32);
+    if trivia.get(index).is_some_and(|item| {
+        item.span.start.offset <= newline as u32 && !matches!(item.kind, TriviaKind::WhiteSpace)
+    }) {
+        return end as usize;
+    }
+    newline + 1
+}

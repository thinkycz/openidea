+/// Query-local declaration and composed hierarchy; never published to symbol caches.
+pub(super) struct GenerationInheritance {
+    context: crate::types::FileContext,
+    target: crate::types::ClassInfo,
+    own_traits: crate::types::ClassInfo,
+    parent: Option<crate::types::ClassInfo>,
+    final_private_constructor: bool,
+}
+
+impl GenerationInheritance {
+    pub(super) fn existing_accessor(&self, name: &str) -> bool {
+        self.parent
+            .as_ref()
+            .and_then(|parent| parent.get_method_ci(name))
+            .is_some_and(|method| {
+                !method.is_virtual
+                    && !method.is_abstract
+                    && method.visibility != crate::types::Visibility::Private
+            })
+    }
+
+    pub(super) fn constructor_refusal(&self) -> Option<&'static str> {
+        if self.final_private_constructor {
+            return Some(
+                "A final parent constructor cannot be replaced, including a final private constructor.",
+            );
+        }
+        if self
+            .own_traits
+            .get_method_ci("__construct")
+            .is_some_and(|method| !method.is_virtual && !method.is_abstract)
+        {
+            return Some(
+                "A constructor supplied by a used trait must retain its initialization. Edit it explicitly instead of generating a replacement.",
+            );
+        }
+        if self
+            .parent
+            .as_ref()
+            .and_then(|parent| parent.get_method_ci("__construct"))
+            .is_some_and(|method| {
+                !method.is_virtual
+                    && (method.is_final
+                        || (!method.is_abstract
+                            && method.visibility != crate::types::Visibility::Private))
+            })
+        {
+            return Some(
+                "The inherited constructor must retain parent initialization. Generate an explicit delegating constructor instead of guessing its arguments.",
+            );
+        }
+        None
+    }
+}
+
+fn complete_generation_graph(
+    class: &crate::types::ClassInfo,
+    loader: &dyn Fn(&str) -> Option<std::sync::Arc<crate::types::ClassInfo>>,
+    depth: u32,
+    visiting: &mut std::collections::HashSet<crate::atom::Atom>,
+    done: &mut std::collections::HashSet<crate::atom::Atom>,
+) -> bool {
+    let name = class.fqn();
+    if done.contains(&name) {
+        return true;
+    }
+    if depth > crate::types::MAX_INHERITANCE_DEPTH || done.len() + visiting.len() >= 1000 {
+        return false;
+    }
+    if !visiting.insert(name) {
+        return false;
+    }
+    for dependency in class
+        .parent_class
+        .iter()
+        .chain(&class.interfaces)
+        .chain(&class.used_traits)
+    {
+        let Some(owner) = loader(&format!("\\{dependency}")) else {
+            return false;
+        };
+        if !complete_generation_graph(&owner, loader, depth + 1, visiting, done) {
+            return false;
+        }
+    }
+    visiting.remove(&name);
+    done.insert(name);
+    true
+}
+
+impl crate::Backend {
+    pub(super) fn generation_inheritance(
+        &self,
+        content: &str,
+        position: Position,
+    ) -> Result<GenerationInheritance, &'static str> {
+        // This canonical recovery context is also used by ordinary completion;
+        // it rebuilds namespace/import ownership without publishing edited text.
+        let context = self.array_key_recovery_context(content, position);
+        let cursor = crate::text_position::position_to_offset(content, position);
+        let target = crate::class_lookup::find_class_at_offset(&context.classes, cursor)
+            .ok_or("The current PHP declaration could not be resolved safely.")?
+            .clone();
+        let loader = super::override_methods::canonical_loader(self, &context);
+        if !complete_generation_graph(
+            &target,
+            &loader,
+            0,
+            &mut std::collections::HashSet::new(),
+            &mut std::collections::HashSet::new(),
+        ) {
+            return Err(
+                "The inherited PHP contracts are unresolved, cyclic or exceed the generation limit. No code was generated.",
+            );
+        }
+        let mut own = target.clone();
+        own.parent_class = None;
+        own.interfaces.clear();
+        let own_traits = crate::inheritance::resolve_class_with_inheritance(&own, &loader);
+        let parent = target
+            .parent_class
+            .and_then(|name| loader(&format!("\\{name}")))
+            .map(|parent| crate::inheritance::resolve_class_with_inheritance(&parent, &loader));
+        let mut final_private_constructor = false;
+        let mut parent_name = target.parent_class;
+        for _ in 0..crate::types::MAX_INHERITANCE_DEPTH {
+            let Some(name) = parent_name else {
+                break;
+            };
+            let Some(parent) = loader(&format!("\\{name}")) else {
+                break;
+            };
+            let mut local = (*parent).clone();
+            local.parent_class = None;
+            local.interfaces.clear();
+            let composed = crate::inheritance::resolve_class_with_inheritance(&local, &loader);
+            if composed.get_method_ci("__construct").is_some_and(|method| {
+                !method.is_virtual
+                    && method.is_final
+                    && method.visibility == crate::types::Visibility::Private
+            }) {
+                final_private_constructor = true;
+            }
+            parent_name = parent.parent_class;
+        }
+        drop(loader);
+        Ok(GenerationInheritance {
+            context,
+            target,
+            own_traits,
+            parent,
+            final_private_constructor,
+        })
+    }
+
+    pub(super) fn generated_signature_admitted(
+        &self,
+        uri: &str,
+        content: &str,
+        inheritance: &GenerationInheritance,
+        name: &str,
+        text: &str,
+    ) -> bool {
+        let snippet = format!("<?php class __WorkbenchGeneratedSignature {{\n{text}\n}}\n");
+        let _parse = crate::parser::with_parse_cache(&snippet);
+        let classes = Self::parse_php_versioned(&snippet, Some(self.php_version()));
+        let Some(method) = classes.first().and_then(|class| class.get_method_ci(name)) else {
+            return false;
+        };
+        let mut method = method.clone();
+        let context = &inheritance.context;
+        // Offsets in a generated snippet must not consult original-source names.
+        let lexical = crate::types::FileContext {
+            classes: Vec::new(),
+            use_map: context.use_map.clone(),
+            namespace: context.namespace.clone(),
+            namespace_spans: None,
+            resolved_names: None,
+        };
+        let prepared = crate::parser::with_parsed_program(
+            &snippet,
+            "generated_accessor_contract",
+            |program, _| {
+                if !program.errors.is_empty() {
+                    return None;
+                }
+                let class = program
+                    .statements
+                    .iter()
+                    .find_map(|statement| match statement {
+                        mago_syntax::cst::Statement::Class(class) => Some(class),
+                        _ => None,
+                    })?;
+                let syntax = class.members.iter().find_map(|member| match member {
+                    ClassLikeMember::Method(method) => Some(method),
+                    _ => None,
+                })?;
+                if syntax.parameter_list.parameters.len() != method.parameters.len() {
+                    return None;
+                }
+                for (parameter, syntax) in method
+                    .parameters
+                    .make_mut()
+                    .iter_mut()
+                    .zip(syntax.parameter_list.parameters.iter())
+                {
+                    parameter.native_type_hint = match syntax.hint.as_ref() {
+                        Some(hint) => Some(super::override_methods::portable_hint(
+                            hint,
+                            &inheritance.target,
+                            &lexical,
+                            self.php_version(),
+                            false,
+                        )?),
+                        None => None,
+                    };
+                }
+                method.native_return_type = match syntax.return_type_hint.as_ref() {
+                    Some(hint) => Some(super::override_methods::portable_hint(
+                        &hint.hint,
+                        &inheritance.target,
+                        &lexical,
+                        self.php_version(),
+                        true,
+                    )?),
+                    None => None,
+                };
+                method.return_type = method.native_return_type.clone();
+                Some(super::override_methods::PreparedMethod {
+                    method,
+                    returns_reference: syntax.ampersand.is_some(),
+                })
+            },
+        );
+        let Some(prepared) = prepared else {
+            return false;
+        };
+        self.generated_class_owned_method_satisfies_contracts(
+            uri,
+            content,
+            &inheritance.target,
+            &prepared,
+            context,
+        )
+    }
+}
+
+pub(super) fn disabled_generation(
+    title: &str,
+    kind: CodeActionKind,
+    reason: &str,
+) -> CodeActionOrCommand {
+    CodeActionOrCommand::CodeAction(CodeAction {
+        title: title.to_string(),
+        kind: Some(kind),
+        disabled: Some(CodeActionDisabled {
+            reason: reason.to_string(),
+        }),
+        ..CodeAction::default()
+    })
+}

+fn inherited_constructor_actions(source: &str) -> Vec<CodeActionOrCommand> {
+    let backend = create_test_backend();
+    backend.update_ast("file:///test.php", source);
+    let point = position_of(source, "private int $value");
+    get_code_actions_in_range(
+        &backend,
+        "file:///test.php",
+        source,
+        Range::new(point, point),
+    )
+}
+
+fn inherited_constructor_enabled<'a>(
+    actions: &'a [CodeActionOrCommand],
+    title: &str,
+) -> Option<&'a CodeAction> {
+    for item in actions {
+        if let CodeActionOrCommand::Command(command) = item {
+            assert_ne!(
+                command.title, title,
+                "constructor generation must propose edits"
+            );
+        }
+    }
+    let action = find_action_titled(actions, title)?;
+    if let Some(disabled) = &action.disabled {
+        assert!(!disabled.reason.trim().is_empty());
+        return None;
+    }
+    assert!(action.command.is_none() && action.edit.is_some());
+    Some(action)
+}
+
+fn inherited_constructor_parent_initialization_preserved_or_refused(
+    actions: &[CodeActionOrCommand],
+    required_argument: bool,
+) {
+    for title in ["Generate constructor", "Generate promoted constructor"] {
+        if let Some(action) = inherited_constructor_enabled(actions, title) {
+            let edits = extract_edits(action);
+            let generated = edits
+                .iter()
+                .map(|edit| edit.new_text.as_str())
+                .collect::<Vec<_>>()
+                .join("\n");
+            assert!(
+                generated.contains("parent::__construct("),
+                "enabled generation must not silently bypass parent initialization: {generated}"
+            );
+            if required_argument {
+                assert!(
+                    !generated.contains("parent::__construct()"),
+                    "required parent argument must be forwarded"
+                );
+                assert!(
+                    generated.contains("string $"),
+                    "parent input needs a caller-supplied typed parameter: {generated}"
+                );
+            }
+        }
+    }
+}
+
+#[test]
+fn inherited_generation_final_parent_constructor_including_private_refuses_both_variants() {
+    for visibility in ["public", "private"] {
+        let source = format!(
+            "<?php\nclass ParentCase {{ final {visibility} function __construct() {{}} }}\nclass ChildCase extends ParentCase {{ private int $value; }}\n"
+        );
+        let actions = inherited_constructor_actions(&source);
+        for title in ["Generate constructor", "Generate promoted constructor"] {
+            assert!(
+                inherited_constructor_enabled(&actions, title).is_none(),
+                "final {visibility} constructor may not be overridden"
+            );
+        }
+    }
+}
+
+#[test]
+fn inherited_generation_required_parent_constructor_is_not_silently_bypassed() {
+    let actions = inherited_constructor_actions(
+        "<?php\nclass ParentCase { protected string $token; public function __construct(string $token) { $this->token = $token; } }\nclass ChildCase extends ParentCase { private int $value; }\n",
+    );
+    inherited_constructor_parent_initialization_preserved_or_refused(&actions, true);
+}

+// Inherited safety is exercised through public Backend actions after publishing
+// the real source into the canonical class index.
+fn inherited_accessor_actions(source: &str) -> Vec<CodeActionOrCommand> {
+    let backend = create_test_backend();
+    backend.set_php_version(phpantom_lsp::types::PhpVersion::new(8, 3));
+    backend.update_ast("file:///test.php", source);
+    actions_at(&backend, source, "private int $value")
+}
+
+fn inherited_accessor_enabled<'a>(
+    actions: &'a [CodeActionOrCommand],
+    title: &str,
+) -> Option<&'a CodeAction> {
+    for item in actions {
+        if let CodeActionOrCommand::Command(command) = item {
+            assert_ne!(
+                command.title, title,
+                "generation must not become an executable command"
+            );
+        }
+    }
+    let action = find_action_titled(actions, title)?;
+    if let Some(disabled) = &action.disabled {
+        assert!(!disabled.reason.trim().is_empty(), "refusal needs a reason");
+        return None;
+    }
+    assert!(
+        action.command.is_none() && action.edit.is_some(),
+        "enabled generation must propose reviewed edits"
+    );
+    Some(action)
+}
+
+fn inherited_accessor_refused(actions: &[CodeActionOrCommand], title: &str) {
+    assert!(
+        inherited_accessor_enabled(actions, title).is_none(),
+        "illegal inherited method replacement must not be enabled: {title}"
+    );
+}
+
+fn inherited_accessor_compatible_or_refused(
+    actions: &[CodeActionOrCommand],
+    title: &str,
+    compatible_signature: &str,
+) {
+    if let Some(action) = inherited_accessor_enabled(actions, title) {
+        let generated = extract_edits(action)
+            .iter()
+            .map(|edit| edit.new_text.as_str())
+            .collect::<Vec<_>>()
+            .join("\n");
+        assert!(
+            generated.contains(compatible_signature),
+            "enabled replacement must satisfy the inherited native signature, not blindly use the property type: {generated}"
+        );
+    }
+}

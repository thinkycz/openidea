diff --git a/src/code_actions/helpers.rs b/src/code_actions/helpers.rs
index 9eaf62f..2017a97 100644
--- a/src/code_actions/helpers.rs
+++ b/src/code_actions/helpers.rs
@@ -581,3 +581,118 @@ pub(super) fn disabled_generation(
         ..CodeAction::default()
     })
 }
+
+/// Layout owned by generated tokens, separate from captured source fragments.
+pub(super) struct GenerationLayout {
+    /// Absolute indentation of the generated member header and closing brace.
+    pub member_indent: String,
+    /// One source indentation unit beyond the member indentation.
+    pub body_indent: String,
+    /// Line ending for generated layout tokens, excluding captured source bytes.
+    pub newline: &'static str,
+}
+
+impl GenerationLayout {
+    #[cfg(test)]
+    pub(super) fn legacy(indent: &str) -> Self {
+        Self {
+            member_indent: indent.to_owned(),
+            body_indent: format!("{indent}{indent}"),
+            newline: "\n",
+        }
+    }
+}
+
+impl GenerationInheritance {
+    /// Derive indentation from the canonical class and first member positions.
+    pub(super) fn layout(
+        &self,
+        content: &str,
+        member: u32,
+        newline: &'static str,
+        fallback_unit: &str,
+    ) -> GenerationLayout {
+        let class_indent = indent_of_line_at(content, self.target.keyword_offset as usize);
+        let offset = member as usize;
+        let start = content[..offset]
+            .rfind('\n')
+            .map_or(0, |newline| newline + 1);
+        let prefix = &content[start..offset];
+        let relative = prefix.strip_prefix(class_indent.as_str()).filter(|unit| {
+            !unit.is_empty() && prefix.bytes().all(|byte| matches!(byte, b' ' | b'\t'))
+        });
+        let (member_indent, unit) = match relative {
+            Some(unit) => (prefix.to_owned(), unit),
+            None => (format!("{class_indent}{fallback_unit}"), fallback_unit),
+        };
+        let body_indent = format!("{member_indent}{unit}");
+        GenerationLayout {
+            member_indent,
+            body_indent,
+            newline,
+        }
+    }
+}
+
+/// Infer a generation fallback unit from structural whitespace only.
+pub(super) fn generation_indent_unit(content: &str, trivia: &[Trivia<'_>]) -> &'static str {
+    for item in trivia
+        .iter()
+        .filter(|item| matches!(item.kind, TriviaKind::WhiteSpace))
+    {
+        let text = &content[item.span.start.offset as usize..item.span.end.offset as usize];
+        let Some((_, indent)) = text.rsplit_once('\n') else {
+            continue;
+        };
+        if indent.starts_with('\t') {
+            return "\t";
+        }
+        let spaces = indent.bytes().take_while(|byte| *byte == b' ').count();
+        if spaces >= 2 {
+            return if spaces.is_multiple_of(4) {
+                "    "
+            } else {
+                "  "
+            };
+        }
+    }
+    "    "
+}
+
+/// Choose a layout newline from lexer-owned whitespace, never literal/doc bytes.
+pub(super) fn generation_newline(
+    content: &str,
+    trivia: &[Trivia<'_>],
+    anchor: u32,
+) -> &'static str {
+    for item in trivia.iter().rev().filter(|item| {
+        item.span.start.offset < anchor && matches!(item.kind, TriviaKind::WhiteSpace)
+    }) {
+        let end = item.span.end.offset.min(anchor) as usize;
+        let start = item.span.start.offset as usize;
+        if let Some(newline) = content[start..end].rfind('\n') {
+            let newline = start + newline;
+            return if newline > 0 && content.as_bytes()[newline - 1] == b'\r' {
+                "\r\n"
+            } else {
+                "\n"
+            };
+        }
+    }
+    for item in trivia
+        .iter()
+        .filter(|item| item.span.end.offset > anchor && matches!(item.kind, TriviaKind::WhiteSpace))
+    {
+        let start = item.span.start.offset.max(anchor) as usize;
+        let end = item.span.end.offset as usize;
+        if let Some(newline) = content[start..end].find('\n') {
+            let newline = start + newline;
+            return if newline > 0 && content.as_bytes()[newline - 1] == b'\r' {
+                "\r\n"
+            } else {
+                "\n"
+            };
+        }
+    }
+    "\n"
+}

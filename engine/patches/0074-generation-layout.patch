+fn constructor_layout_fragment(source: &str, title: &str, needle: &str) -> (String, String) {
+    let backend = create_test_backend();
+    let point = position_of(source, needle);
+    let actions = get_code_actions_in_range(
+        &backend,
+        "file:///layout.php",
+        source,
+        Range::new(point, point),
+    );
+    let action = find_action_titled(&actions, title).expect("layout action");
+    assert!(action.disabled.is_none() && action.command.is_none());
+    let edits = extract_edits(action);
+    let nonempty: Vec<_> = edits
+        .iter()
+        .filter(|edit| !edit.new_text.is_empty())
+        .collect();
+    assert_eq!(nonempty.len(), 1, "one constructor fragment");
+    let fragment = nonempty[0].new_text.clone();
+    let mut ranges: Vec<_> = edits
+        .iter()
+        .map(|edit| {
+            (
+                lsp_pos_to_offset(source, edit.range.start),
+                lsp_pos_to_offset(source, edit.range.end),
+            )
+        })
+        .collect();
+    ranges.sort_unstable();
+    assert!(
+        ranges
+            .windows(2)
+            .all(|pair| pair[0].1 <= pair[1].0 && pair[0] != pair[1])
+    );
+    let result = apply_workspace_edit(source, action.edit.as_ref().unwrap());
+    let classes = backend.parse_php(&result);
+    let owner = classes
+        .iter()
+        .find(|class| class.name == "LayoutCase")
+        .expect("owning class survives");
+    assert_eq!(
+        owner
+            .methods
+            .iter()
+            .filter(|method| method.name.as_str() == "__construct")
+            .count(),
+        1
+    );
+    (fragment, result)
+}
+
+fn assert_constructor_layout(source: &str, member: &str, body: &str, newline: &str) {
+    for title in ["Generate constructor", "Generate promoted constructor"] {
+        let (fragment, _) = constructor_layout_fragment(source, title, "private int $value");
+        assert!(
+            fragment.contains(&format!("{newline}{member}public function __construct(")),
+            "member indent: {fragment:?}"
+        );
+        if title == "Generate constructor" {
+            assert!(
+                fragment.contains(&format!("{newline}{body}$this->value = $value;{newline}")),
+                "constructor body adds one relative unit: {fragment:?}"
+            );
+        } else {
+            assert!(
+                fragment.contains(&format!("{newline}{body}private int $value,{newline}")),
+                "promoted parameter adds one relative unit: {fragment:?}"
+            );
+        }
+    }
+}

+#[test]
+fn accessor_name_collision_noncolliding_group_preserves_typed_accessors_and_owner() {
+    let backend = create_test_backend();
+    for (native_type, first, second, getter_first, getter_second) in [
+        ("int", "foo_bar", "bazQux", "getFooBar", "getBazQux"),
+        ("bool", "foo_bar", "bazQux", "isFooBar", "isBazQux"),
+        ("string", "foo_bar", "bazQux", "getFooBar", "getBazQux"),
+    ] {
+        let source = format!(
+            "<?php\nclass CollisionCase {{ private {native_type} ${first}, ${second}; }}\nclass Neighbor {{}}\n"
+        );
+        let actions = actions_at(&backend, &source, "private");
+        let parameter_first = format!("${first}");
+        let parameter_second = format!("${second}");
+        for title in [
+            "Generate getter",
+            "Generate setter",
+            "Generate getter and setter",
+        ] {
+            let mut expected = Vec::new();
+            if title != "Generate setter" {
+                expected.extend([
+                    (getter_first, native_type, None),
+                    (getter_second, native_type, None),
+                ]);
+            }
+            if title != "Generate getter" {
+                expected.extend([
+                    (
+                        "setFooBar",
+                        "self",
+                        Some((parameter_first.as_str(), native_type)),
+                    ),
+                    (
+                        "setBazQux",
+                        "self",
+                        Some((parameter_second.as_str(), native_type)),
+                    ),
+                ]);
+            }
+            let action =
+                find_action_titled(&actions, title).expect("noncolliding group stays available");
+            accessor_collision_assert_generated(&backend, &source, action, &expected);
+        }
+    }
+}

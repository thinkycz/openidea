+#[test]
+fn accessor_name_collision_case_distinct_properties_refuse_case_insensitive_methods() {
+    let backend = create_test_backend();
+    for declaration in ["$foo, $Foo", "$Foo, $foo"] {
+        let source = format!("<?php\nclass CollisionCase {{ private int {declaration}; }}\n");
+        let actions = actions_at(&backend, &source, "private int");
+        for (title, method) in [
+            ("Generate getter", "getFoo"),
+            ("Generate setter", "setFoo"),
+            ("Generate getter and setter", "getFoo"),
+        ] {
+            accessor_collision_disabled(&actions, title, &["$foo", "$Foo"], method);
+        }
+    }
+}

+fn accessor_collision_disabled(
+    actions: &[CodeActionOrCommand],
+    title: &str,
+    properties: &[&str],
+    method: &str,
+) {
+    for item in actions {
+        if let CodeActionOrCommand::Command(command) = item {
+            assert_ne!(
+                command.title, title,
+                "ambiguous generation must not execute"
+            );
+        }
+    }
+    let matching: Vec<_> = actions
+        .iter()
+        .filter_map(|item| match item {
+            CodeActionOrCommand::CodeAction(action) if action.title == title => Some(action),
+            _ => None,
+        })
+        .collect();
+    assert_eq!(matching.len(), 1, "{title} needs one explicit refusal");
+    let action = matching[0];
+    let refusal = action
+        .disabled
+        .as_ref()
+        .expect("ambiguous action is disabled");
+    assert!(
+        action.edit.is_none(),
+        "disabled action must have no workspace edit"
+    );
+    assert!(
+        action.command.is_none(),
+        "disabled action must have no command"
+    );
+    let reason = refusal.reason.to_ascii_lowercase();
+    assert!(
+        reason.contains(&method.to_ascii_lowercase()),
+        "identify the conflicting method: {}",
+        refusal.reason
+    );
+    for property in properties {
+        assert!(
+            refusal.reason.contains(property),
+            "identify conflicting property {property}: {}",
+            refusal.reason
+        );
+    }
+    assert!(
+        ["rename", "separate", "split"]
+            .iter()
+            .any(|repair| reason.contains(repair)),
+        "explain how to resolve the ambiguity: {}",
+        refusal.reason
+    );
+}
+
+type AccessorCollisionSignature<'a> = (&'a str, &'a str, Option<(&'a str, &'a str)>);
+
+fn accessor_collision_assert_generated(
+    backend: &phpantom_lsp::Backend,
+    source: &str,
+    action: &CodeAction,
+    expected: &[AccessorCollisionSignature<'_>],
+) {
+    assert!(action.disabled.is_none() && action.command.is_none());
+    let edits = extract_edits(action);
+    assert!(!edits.is_empty());
+    let result = apply_edits(source, &edits);
+    let classes = backend.parse_php(&result);
+    let owner = classes
+        .iter()
+        .find(|class| class.name == "CollisionCase")
+        .expect("generated methods remain owned by the target class");
+    let original = backend.parse_php(source);
+    let original_owner = original
+        .iter()
+        .find(|class| class.name == "CollisionCase")
+        .unwrap();
+    let generated: Vec<_> = owner
+        .methods
+        .iter()
+        .filter(|method| {
+            !original_owner
+                .methods
+                .iter()
+                .any(|existing| existing.name == method.name)
+        })
+        .collect();
+    assert_eq!(
+        generated.len(),
+        expected.len(),
+        "unexpected generated methods"
+    );
+    let mut names = std::collections::HashSet::new();
+    for method in &owner.methods {
+        assert!(
+            names.insert(method.name.to_ascii_lowercase()),
+            "duplicate PHP method {}",
+            method.name
+        );
+    }
+    for (name, return_type, parameter) in expected {
+        let method = generated
+            .iter()
+            .find(|method| method.name == *name)
+            .unwrap_or_else(|| panic!("missing generated {name}"));
+        assert_eq!(
+            method
+                .native_return_type
+                .as_ref()
+                .map(ToString::to_string)
+                .as_deref(),
+            Some(*return_type)
+        );
+        if let Some((parameter_name, parameter_type)) = parameter {
+            assert_eq!(method.parameters.len(), 1);
+            assert_eq!(method.parameters[0].name.as_str(), *parameter_name);
+            assert_eq!(
+                method.parameters[0]
+                    .native_type_hint
+                    .as_ref()
+                    .map(ToString::to_string)
+                    .as_deref(),
+                Some(*parameter_type)
+            );
+        } else {
+            assert!(method.parameters.is_empty());
+        }
+    }
+    for class in classes.iter().filter(|class| class.name != "CollisionCase") {
+        assert!(
+            class
+                .methods
+                .iter()
+                .all(|method| !expected.iter().any(|(name, _, _)| method.name == *name)),
+            "accessors must not land in neighboring class {}",
+            class.name
+        );
+    }
+}

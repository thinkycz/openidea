+#[test]
+fn accessor_name_collision_snake_and_camel_group_refuses_all_ambiguous_actions() {
+    let backend = create_test_backend();
+    for declaration in ["$foo_bar, $fooBar", "$fooBar, $foo_bar"] {
+        let source = format!("<?php\nclass CollisionCase {{\n    private int {declaration};\n}}\n");
+        for needle in ["private int", "$foo_bar", "$fooBar"] {
+            let actions = actions_at(&backend, &source, needle);
+            for (title, method) in [
+                ("Generate getter", "getFooBar"),
+                ("Generate setter", "setFooBar"),
+                ("Generate getter and setter", "getFooBar"),
+            ] {
+                accessor_collision_disabled(&actions, title, &["$foo_bar", "$fooBar"], method);
+            }
+        }
+    }
+}

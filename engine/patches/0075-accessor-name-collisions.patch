 // ── Helpers ─────────────────────────────────────────────────────────────────
 
+// Reserve only admitted candidates: an existing/inherited accessor may leave
+// an independent member available, but a collision refuses the whole action.
+fn accessor_name_collision(available: &[AvailableAccessors], getter: bool) -> Option<String> {
+    let mut names = std::collections::HashMap::new();
+    for candidate in available {
+        if !(if getter {
+            candidate.can_getter
+        } else {
+            candidate.can_setter
+        }) {
+            continue;
+        }
+        let name = if getter {
+            getter_method_name(&candidate.prop.name, candidate.prop.type_hint.as_ref())
+        } else {
+            setter_method_name(&candidate.prop.name)
+        };
+        if let Some(previous) =
+            names.insert(name.to_ascii_lowercase(), candidate.prop.name.as_str())
+        {
+            return Some(format!(
+                "Generated method {name} is ambiguous between ${previous} and ${}. Rename a property so that each accessor has a unique name.",
+                candidate.prop.name
+            ));
+        }
+    }
+    None
+}

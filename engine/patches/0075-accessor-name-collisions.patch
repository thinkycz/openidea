+#[test]
+fn accessor_name_collision_readonly_groups_refuse_only_ambiguous_getter() {
+    let backend = create_test_backend();
+    backend.set_php_version(phpantom_lsp::types::PhpVersion::new(8, 3));
+    for (class_kind, declaration, method) in [
+        (
+            "readonly class",
+            "private int $foo_bar, $fooBar",
+            "getFooBar",
+        ),
+        (
+            "class",
+            "private readonly int $foo_bar, $fooBar",
+            "getFooBar",
+        ),
+        (
+            "readonly class",
+            "private bool $foo_bar, $fooBar",
+            "isFooBar",
+        ),
+    ] {
+        let source = format!("<?php\n{class_kind} CollisionCase {{ {declaration}; }}\n");
+        let actions = actions_at(&backend, &source, declaration);
+        accessor_collision_disabled(
+            &actions,
+            "Generate getter",
+            &["$foo_bar", "$fooBar"],
+            method,
+        );
+        assert!(find_action_titled(&actions, "Generate setter").is_none());
+        assert!(find_action_titled(&actions, "Generate getter and setter").is_none());
+    }
+}

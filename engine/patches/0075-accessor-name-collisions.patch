+#[test]
+fn accessor_name_collision_existing_setter_leaves_unique_setter_but_refuses_getter_batch() {
+    let backend = create_test_backend();
+    let source = "<?php\nclass CollisionCase {\n    private int $foo_bar, $fooBar, $unique;\n    public function SETFOOBAR(int $value): self { return $this; }\n}\nclass Neighbor {}\n";
+    let actions = actions_at(&backend, source, "private int");
+    let setter =
+        find_action_titled(&actions, "Generate setter").expect("unique setter remains available");
+    accessor_collision_assert_generated(
+        &backend,
+        source,
+        setter,
+        &[("setUnique", "self", Some(("$unique", "int")))],
+    );
+    for title in ["Generate getter", "Generate getter and setter"] {
+        accessor_collision_disabled(&actions, title, &["$foo_bar", "$fooBar"], "getFooBar");
+    }
+}

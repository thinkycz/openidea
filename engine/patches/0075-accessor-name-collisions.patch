+#[test]
+fn accessor_name_collision_existing_getter_leaves_unique_getter_but_refuses_setter_batch() {
+    let backend = create_test_backend();
+    let source = "<?php\nclass CollisionCase {\n    private int $foo_bar, $fooBar, $unique;\n    public function GETFOOBAR(): int { return $this->foo_bar; }\n}\nclass Neighbor {}\n";
+    let actions = actions_at(&backend, source, "private int");
+    let getter =
+        find_action_titled(&actions, "Generate getter").expect("unique getter remains available");
+    accessor_collision_assert_generated(&backend, source, getter, &[("getUnique", "int", None)]);
+    for title in ["Generate setter", "Generate getter and setter"] {
+        accessor_collision_disabled(&actions, title, &["$foo_bar", "$fooBar"], "setFooBar");
+    }
+}

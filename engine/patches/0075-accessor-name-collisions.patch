+#[test]
+fn accessor_name_collision_inherited_getter_exclusion_leaves_unique_getter() {
+    let backend = create_test_backend();
+    let source = "<?php\nclass ParentCase { public function GETFOOBAR(): int { return 1; } }\nclass CollisionCase extends ParentCase { private int $foo_bar, $fooBar, $unique; }\nclass Neighbor {}\n";
+    backend.update_ast("file:///test.php", source);
+    let actions = actions_at(&backend, source, "private int");
+    let getter = find_action_titled(&actions, "Generate getter")
+        .expect("independent getter remains available");
+    accessor_collision_assert_generated(&backend, source, getter, &[("getUnique", "int", None)]);
+    for title in ["Generate setter", "Generate getter and setter"] {
+        accessor_collision_disabled(&actions, title, &["$foo_bar", "$fooBar"], "setFooBar");
+    }

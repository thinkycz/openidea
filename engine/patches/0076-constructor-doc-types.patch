+fn constructor_doc_type_result(source: &str, title: &str) -> String {
+    let backend = create_test_backend();
+    let point = position_of(source, "private");
+    let actions = get_code_actions_in_range(
+        &backend,
+        "file:///constructor-doc-types.php",
+        source,
+        Range::new(point, point),
+    );
+    let action = find_action_titled(&actions, title).expect("constructor stays available");
+    assert!(
+        action.disabled.is_none(),
+        "unexpected refusal: {:?}",
+        action.disabled
+    );
+    assert!(action.command.is_none());
+    if title == "Generate constructor" {
+        assert!(
+            extract_edits(action)
+                .iter()
+                .all(|edit| edit.range.start == edit.range.end),
+            "traditional generation must retain declarations and property documentation"
+        );
+    }
+    apply_workspace_edit(source, action.edit.as_ref().expect("reviewable edit"))
+}
+
+fn assert_constructor_doc_types(source: &str, defaults: &[(&str, Option<&str>)]) -> String {
+    let result = constructor_doc_type_result(source, "Generate constructor");
+    let backend = create_test_backend();
+    let original = backend.parse_php(source);
+    let generated = backend.parse_php(&result);
+    let original_owner = original
+        .iter()
+        .find(|class| class.name == "DocTypeCase")
+        .unwrap();
+    let owner = generated
+        .iter()
+        .find(|class| class.name == "DocTypeCase")
+        .expect("target class survives");
+    let constructors: Vec<_> = owner
+        .methods
+        .iter()
+        .filter(|method| method.name.eq_ignore_ascii_case("__construct"))
+        .collect();
+    assert_eq!(
+        constructors.len(),
+        1,
+        "exactly one constructor is generated"
+    );
+    let constructor = constructors[0];
+    assert_eq!(
+        constructor.parameters.len(),
+        original_owner.properties.len()
+    );
+    assert_eq!(defaults.len(), original_owner.properties.len());
+    for property in &original_owner.properties {
+        let parameter_name = format!("${}", property.name);
+        let parameter = constructor
+            .parameters
+            .iter()
+            .find(|parameter| parameter.name == parameter_name.as_str())
+            .expect("each property has its own constructor parameter");
+        assert_eq!(
+            parameter.native_type_hint, property.native_type_hint,
+            "native constraints must come only from the declared property type: {result}"
+        );
+        assert_eq!(
+            parameter.type_hint, property.type_hint,
+            "effective documented property type must survive as parameter documentation: {result}"
+        );
+        let (_, default) = defaults
+            .iter()
+            .find(|(name, _)| *name == property.name.as_str())
+            .expect("fixture specifies parameter default");
+        assert_eq!(
+            parameter.default_value.as_deref(),
+            *default,
+            "captured default remains unchanged for {}",
+            property.name
+        );
+        let retained = owner
+            .properties
+            .iter()
+            .find(|candidate| candidate.name == property.name)
+            .expect("traditional constructor retains the property");
+        assert_eq!(retained.native_type_hint, property.native_type_hint);
+        assert_eq!(retained.type_hint, property.type_hint);
+    }
+    result
+}
+
+#[test]
+fn constructor_doc_types_callable_string_default_stays_untyped_with_callable_annotation() {
+    let source = "<?php\nclass DocTypeCase {\n    /** @var callable */\n    private $callback = 'strlen';\n}\n";
+    let result = assert_constructor_doc_types(source, &[("callback", Some("'strlen'"))]);
+    assert!(
+        result.contains("/** @var callable */"),
+        "original property documentation survives"
+    );
+}
+
+#[test]
+fn constructor_doc_types_callable_array_default_stays_untyped_with_callable_annotation() {
+    let source = "<?php\nclass Handler { public static function run(): int { return 1; } }\nclass DocTypeCase {\n    /** @var callable */\n    private $callback = [Handler::class, 'run'];\n}\n";
+    assert_constructor_doc_types(source, &[("callback", Some("[Handler::class, 'run']"))]);
+}
+
+#[test]
+fn constructor_doc_types_scalar_documentation_does_not_restrict_existing_storage_default() {
+    let source =
+        "<?php\nclass DocTypeCase {\n    /** @var int */\n    private $value = 'pending';\n}\n";
+    assert_constructor_doc_types(source, &[("value", Some("'pending'"))]);
+}
+
+#[test]
+fn constructor_doc_types_shape_and_generic_annotations_survive_on_parameters() {
+    let source = "<?php\nclass DocTypeCase {\n    /** @var array{key: int} */\n    private $shape = ['key' => 1];\n    /** @var list<string> */\n    private $names = ['Ada'];\n}\n";
+    assert_constructor_doc_types(
+        source,
+        &[("shape", Some("['key' => 1]")), ("names", Some("['Ada']"))],
+    );
+}
+
+#[test]
+fn constructor_doc_types_native_array_keeps_documented_element_refinement() {
+    let source = "<?php\nclass DocTypeCase {\n    /** @var list<int> */\n    private array $values = [1, 2];\n}\n";
+    assert_constructor_doc_types(source, &[("values", Some("[1, 2]"))]);
+}
+
+#[test]
+fn constructor_doc_types_native_int_and_imported_alias_remain_native() {
+    let source = "<?php\nnamespace Vendor { class Payload {} }\nnamespace App {\nuse Vendor\\Payload as Data;\nclass DocTypeCase {\n    private int $count = 7;\n    private Data $payload;\n}\n}\n";
+    assert_constructor_doc_types(source, &[("count", Some("7")), ("payload", None)]);
+}
+
+#[test]
+fn constructor_doc_types_promotion_keeps_untyped_documented_properties_and_exact_defaults() {
+    let source = "<?php\nclass Handler { public static function run(): int { return 1; } }\nclass DocTypeCase {\n    /** @var callable */\n    private $callback = 'strlen';\n    /** @var callable */\n    private $handler = [Handler::class, 'run'];\n    /** @var int */\n    private $value = 'pending';\n    /** @var array{key: int} */\n    private $shape = ['key' => 1];\n    /** @var list<string> */\n    private $names = ['Ada'];\n    private int $count = 7;\n}\n";
+    let result = constructor_doc_type_result(source, "Generate promoted constructor");
+    let backend = create_test_backend();
+    let original = backend.parse_php(source);
+    let generated = backend.parse_php(&result);
+    let before = original
+        .iter()
+        .find(|class| class.name == "DocTypeCase")
+        .unwrap();
+    let after = generated
+        .iter()
+        .find(|class| class.name == "DocTypeCase")
+        .unwrap();
+    assert_eq!(after.properties.len(), before.properties.len());
+    let constructors: Vec<_> = after
+        .methods
+        .iter()
+        .filter(|method| method.name.eq_ignore_ascii_case("__construct"))
+        .collect();
+    assert_eq!(constructors.len(), 1);
+    let constructor = constructors[0];
+    let defaults = [
+        ("callback", "'strlen'"),
+        ("handler", "[Handler::class, 'run']"),
+        ("value", "'pending'"),
+        ("shape", "['key' => 1]"),
+        ("names", "['Ada']"),
+        ("count", "7"),
+    ];
+    for property in &before.properties {
+        let retained = after
+            .properties
+            .iter()
+            .find(|candidate| candidate.name == property.name)
+            .unwrap();
+        assert_eq!(retained.native_type_hint, property.native_type_hint);
+        assert_eq!(
+            retained.type_hint, property.type_hint,
+            "promotion retains effective property documentation"
+        );
+        let parameter_name = format!("${}", property.name);
+        let parameter = constructor
+            .parameters
+            .iter()
+            .find(|candidate| candidate.name == parameter_name.as_str())
+            .unwrap();
+        assert_eq!(
+            parameter.native_type_hint, property.native_type_hint,
+            "promotion retains originally native constraints only"
+        );
+        let (_, default) = defaults
+            .iter()
+            .find(|(name, _)| *name == property.name.as_str())
+            .unwrap();
+        assert_eq!(parameter.default_value.as_deref(), Some(*default));
+    }
+}

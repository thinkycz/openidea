+/// Record lexical bodies that are created rather than executed by this
+/// declaration. Directly invoked closures remain part of its execution path.
+struct DocumentationScopes;
+
+struct DocumentationScopeState {
+    body: std::ops::Range<usize>,
+    immediate: std::collections::HashSet<u32>,
+    deferred: Vec<std::ops::Range<usize>>,
+    constructors_without_arguments: Vec<std::ops::Range<usize>>,
+}
+
+impl DocumentationScopeState {
+    fn defer(&mut self, span: Span) {
+        let start = span.start.offset as usize;
+        let end = span.end.offset as usize;
+        if self.body.contains(&start) && end <= self.body.end {
+            self.deferred
+                .push(start - self.body.start..end - self.body.start);
+        }
+    }
+}
+
+impl<'ast, 'arena> mago_syntax::walker::Walker<'ast, 'arena, DocumentationScopeState>
+    for DocumentationScopes
+{
+    fn walk_in_call(&self, call: &'ast Call<'arena>, state: &mut DocumentationScopeState) {
+        if let Call::Function(call) = call {
+            let mut target = call.function;
+            while let Expression::Parenthesized(parenthesized) = target {
+                target = parenthesized.expression;
+            }
+            if matches!(
+                target,
+                Expression::Closure(_) | Expression::ArrowFunction(_)
+            ) {
+                state.immediate.insert(target.span().start.offset);
+            }
+        }
+    }
+
+    fn walk_in_expression(
+        &self,
+        expression: &'ast Expression<'arena>,
+        state: &mut DocumentationScopeState,
+    ) {
+        match expression {
+            Expression::Instantiation(instantiation) if instantiation.argument_list.is_none() => {
+                let span = expression.span();
+                state
+                    .constructors_without_arguments
+                    .push(span.start.offset as usize..span.end.offset as usize);
+            }
+            Expression::Closure(_) | Expression::ArrowFunction(_)
+                if !state.immediate.contains(&expression.span().start.offset) =>
+            {
+                state.defer(expression.span())
+            }
+            Expression::AnonymousClass(class) => {
+                state.defer(Span::new(
+                    class.left_brace.file_id,
+                    class.left_brace.start,
+                    class.right_brace.end,
+                ));
+            }
+            _ => {}
+        }
+    }
+
+    fn walk_in_attribute_list(
+        &self,
+        attributes: &'ast mago_syntax::cst::attribute::AttributeList<'arena>,
+        state: &mut DocumentationScopeState,
+    ) {
+        state.defer(attributes.span());
+    }
+
+    fn walk_in_statement(
+        &self,
+        statement: &'ast Statement<'arena>,
+        state: &mut DocumentationScopeState,
+    ) {
+        if matches!(
+            statement,
+            Statement::Function(_)
+                | Statement::Class(_)
+                | Statement::Interface(_)
+                | Statement::Trait(_)
+                | Statement::Enum(_)
+        ) {
+            state.defer(statement.span());
+        }
+    }
+}
+
+impl Backend {
+    fn documentation_throws_semantics(
+        &self,
+        content: &str,
+        body: &std::ops::Range<usize>,
+        context: &crate::types::FileContext,
+    ) -> throws_analysis::ThrowsSemantics {
+        use mago_syntax::walker::Walker;
+        let (deferred, call_sites, constructors) = crate::parser::with_parsed_program(
+            content,
+            "documentation_throws_scopes",
+            |program, _| {
+                let mut state = DocumentationScopeState {
+                    body: body.clone(),
+                    immediate: std::collections::HashSet::new(),
+                    deferred: Vec::new(),
+                    constructors_without_arguments: Vec::new(),
+                };
+                DocumentationScopes.walk_program(program, &mut state);
+                let call_sites =
+                    crate::symbol_map::extraction::extract_symbol_map(program, content).call_sites;
+                (
+                    state.deferred,
+                    call_sites,
+                    state.constructors_without_arguments,
+                )
+            },
+        );
+        let mut semantics = throws_analysis::ThrowsSemantics::new(deferred);
+        let mut collect = |expression: &str, absolute: usize, arguments: Option<&str>| {
+            if !body.contains(&absolute) {
+                return;
+            }
+            let relative = absolute - body.start;
+            if !semantics.executes(relative) {
+                return;
+            }
+            if let Some(target) = self.resolve_callable_target_with_args_at_offset(
+                expression,
+                content,
+                absolute as u32,
+                context,
+                arguments,
+            ) {
+                semantics.calls.extend(
+                    target
+                        .throws
+                        .iter()
+                        .flat_map(|types| types.iter())
+                        .cloned()
+                        .map(|type_name| throws_analysis::ThrowInfo {
+                            type_name,
+                            origin: throws_analysis::ThrowTypeOrigin::Resolved,
+                            offset: relative,
+                        }),
+                );
+            }
+        };
+        for call in &call_sites {
+            collect(
+                &call.call_expression,
+                call.args_start as usize,
+                Some(&content[call.args_start as usize..call.args_end as usize]),
+            );
+        }
+        // Signature-help call sites require parentheses; PHP construction does not.
+        for constructor in constructors {
+            collect(&content[constructor.clone()], constructor.start, Some(""));
+        }
+        semantics
+    }
+}

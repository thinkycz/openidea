 }
+
+fn semantic_throw_workspace() -> (phpantom_lsp::Backend, tempfile::TempDir) {
+    crate::common::create_psr4_workspace_with_exception_stubs(
+        r#"{"autoload":{"psr-4":{"Vendor\\":"src/"}}}"#,
+        &[
+            (
+                "src/Failure.php",
+                "<?php namespace Vendor; class Failure extends \\RuntimeException {}",
+            ),
+            (
+                "src/Service.php",
+                "<?php namespace Vendor; class Service { /** @throws Failure */ public function fetch(): void { throw new Failure(); } }",
+            ),
+            (
+                "src/Other.php",
+                "<?php namespace Vendor; class Other { public function fetch(): void {} }",
+            ),
+            (
+                "src/ServiceChild.php",
+                "<?php namespace Vendor; class ServiceChild extends Service {}",
+            ),
+            (
+                "src/ThrowingConstructor.php",
+                "<?php namespace Vendor; class ThrowingConstructor { /** @throws Failure */ public function __construct() { throw new Failure(); } }",
+            ),
+            (
+                "src/StaticService.php",
+                "<?php namespace Vendor; class StaticService { /** @throws Failure */ public static function perform(): void { throw new Failure(); } }",
+            ),
+            (
+                "src/OtherFailure.php",
+                "<?php namespace Vendor; class OtherFailure extends \\Exception {}",
+            ),
+            (
+                "src/TemplateService.php",
+                r#"<?php namespace Vendor; class TemplateService {
+                /**
+                 * @template T of \Throwable
+                 * @param class-string<T> $type
+                 * @throws T
+                 */
+                public function fail(string $type): void { throw new $type(); }
+            }"#,
+            ),
+            (
+                "src/UnionService.php",
+                "<?php namespace Vendor; class UnionService { /** @throws Failure|OtherFailure */ public function fetch(): void {} }",
+            ),
+        ],
+    )
+}
+
+fn semantic_throw_documentation(body: &str) -> String {
+    let (backend, _directory) = semantic_throw_workspace();
+    generated_with_backend(
+        &format!(
+            "<?php\nnamespace App;\nuse Vendor\\Service as Client;\nuse Vendor\\Other;\nclass Documentation {{\n    public function |run(Client $client): void {{ {body} }}\n}}\n"
+        ),
+        &backend,
+    )
+}
+
+#[test]
+fn documentation_semantic_throws_resolves_new_receiver_in_composer_dependency() {
+    let result = semantic_throw_documentation("(new Client())->fetch();");
+    assert!(result.contains("@throws \\Vendor\\Failure"), "{result}");
+}
+
+#[test]
+fn documentation_semantic_throws_parameter_control_keeps_declared_exception() {
+    let result = semantic_throw_documentation("$client->fetch();");
+    assert!(result.contains("@throws \\Vendor\\Failure"), "{result}");
+}
+
+#[test]
+fn documentation_semantic_throws_same_callee_after_caught_call_still_escapes() {
+    let result = semantic_throw_documentation(
+        "try { $client->fetch(); } catch (\\Vendor\\Failure $failure) {} $client->fetch();",
+    );
+    assert!(result.contains("@throws \\Vendor\\Failure"), "{result}");
+    assert_eq!(result.matches("@throws").count(), 1, "{result}");
+}
+
+#[test]
+fn documentation_semantic_throws_caught_call_does_not_escape() {
+    let result = semantic_throw_documentation(
+        "try { (new Client())->fetch(); } catch (\\RuntimeException $failure) {}",
+    );
+    assert!(!result.contains("@throws"), "{result}");
+}
+
+#[test]
+fn documentation_semantic_throws_deferred_closure_does_not_execute_call() {
+    let result = semantic_throw_documentation(
+        "$deferred = static function () use ($client) { $client->fetch(); };",
+    );
+    assert!(!result.contains("@throws"), "{result}");
+}
+
+#[test]
+fn documentation_semantic_throws_deferred_arrow_does_not_execute_call() {

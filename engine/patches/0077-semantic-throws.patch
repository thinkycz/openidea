+fn semantic_throw_with_unpublished_source(previous: &str, current: &str) -> String {
+    let (backend, _directory) = semantic_throw_workspace();
+    let prefix = "<?php\nnamespace App;\nuse Vendor\\Service as Client;\nuse Vendor\\Other;\nclass Documentation {\n public function |run(Client $first, Other $other): void { ";
+    let old = format!("{prefix}{previous} }}\n}}\n");
+    let new = format!("{prefix}{current} }}\n}}\n");
+    let (old, _) = at_marker(&old);
+    let (current, position) = at_marker(&new);
+    assert_eq!(
+        old.len(),
+        current.len(),
+        "exercise same-length stale offsets"
+    );
+    backend.update_ast("file:///test.php", &old);
+    let actions = get_code_actions_at(
+        &backend,
+        "file:///test.php",
+        &current,
+        position.line,
+        position.character,
+    );
+    let action = find_action_titled(&actions, "Generate PHPDoc block")
+        .expect("current-source action remains available");
+    apply_workspace_edit(&current, action.edit.as_ref().unwrap())
+}
+
+#[test]
+fn documentation_semantic_throws_current_source_does_not_borrow_stale_receiver() {
+    let result = semantic_throw_with_unpublished_source("$first->fetch();", "$other->fetch();");
+    assert!(!result.contains("@throws"), "{result}");
+}
+
+#[test]
+fn documentation_semantic_throws_current_source_keeps_new_receiver_exception() {
+    let result = semantic_throw_with_unpublished_source("$other->fetch();", "$first->fetch();");
+    assert!(result.contains("@throws \\Vendor\\Failure"), "{result}");
+}
+
+#[test]
+fn documentation_semantic_throws_without_cached_call_map_uses_supplied_ast() {
+    let (backend, _directory) = semantic_throw_workspace();
+    let (source, position) =
+        at_marker("<?php\nfunction |run(): void { (new \\Vendor\\Service())->fetch(); }\n");
+    let actions = get_code_actions_at(
+        &backend,
+        "file:///uncached.php",
+        &source,
+        position.line,
+        position.character,
+    );
+    let action = find_action_titled(&actions, "Generate PHPDoc block")
+        .expect("uncached-source action remains available");
+    let result = apply_workspace_edit(&source, action.edit.as_ref().unwrap());
+    assert!(
+        result.contains("@throws Vendor\\Failure") || result.contains("@throws \\Vendor\\Failure"),
+        "{result}"
+    );
+}

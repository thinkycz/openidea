+/// Calls and deferred scopes derived from the current parsed declaration.
+/// Offsets are relative to the selected body, matching the catch analysis.
+pub(crate) struct ThrowsSemantics {
+    pub calls: Vec<ThrowInfo>,
+    deferred: Vec<std::ops::Range<usize>>,
+}
+
+impl ThrowsSemantics {
+    pub(crate) fn new(mut deferred: Vec<std::ops::Range<usize>>) -> Self {
+        deferred.sort_unstable_by_key(|scope| scope.start);
+        let mut merged: Vec<std::ops::Range<usize>> = Vec::with_capacity(deferred.len());
+        for scope in deferred {
+            if let Some(last) = merged.last_mut()
+                && scope.start <= last.end
+            {
+                last.end = last.end.max(scope.end);
+            } else {
+                merged.push(scope);
+            }
+        }
+        Self {
+            calls: Vec::new(),
+            deferred: merged,
+        }
+    }
+
+    pub(crate) fn executes(&self, offset: usize) -> bool {
+        let next = self.deferred.partition_point(|scope| scope.start <= offset);
+        next == 0 || !self.deferred[next - 1].contains(&offset)
+    }
+}

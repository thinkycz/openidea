+struct CursorSearch<'a> {
+    cursor: u32,
+    selected: CursorContext<'a>,
+    selected_span: Option<Span>,
+}
+
+impl<'a> CursorSearch<'a> {
+    fn consider(&mut self, context: CursorContext<'a>, span: Span) {
+        if matches!(context, CursorContext::None) {
+            return;
+        }
+        let length = span.end.offset.saturating_sub(span.start.offset);
+        if self.selected_span.is_none_or(|previous| {
+            length < previous.end.offset.saturating_sub(previous.start.offset)
+        }) {
+            self.selected = context;
+            self.selected_span = Some(span);
+        }
+    }
+}
+
+struct CursorContexts;
+
+impl<'a> Walker<'a, 'a, CursorSearch<'a>> for CursorContexts {
+    fn walk_statement(&self, statement: &'a Statement<'a>, search: &mut CursorSearch<'a>) {
+        let span = statement.span();
+        if search.cursor >= span.start.offset && search.cursor <= span.end.offset {
+            mago_syntax::walker::walk_statement(self, statement, search);
+        }
+    }
+
+    fn walk_expression(&self, expression: &'a Expression<'a>, search: &mut CursorSearch<'a>) {
+        let span = expression.span();
+        if search.cursor >= span.start.offset && search.cursor <= span.end.offset {
+            mago_syntax::walker::walk_expression(self, expression, search);
+        }
+    }
+
+    fn walk_in_statement(&self, statement: &'a Statement<'a>, search: &mut CursorSearch<'a>) {
+        search.consider(
+            find_in_statement(statement, search.cursor),
+            statement.span(),
+        );
+    }
+
+    fn walk_in_expression(&self, expression: &'a Expression<'a>, search: &mut CursorSearch<'a>) {
+        let Expression::AnonymousClass(class) = expression else {
+            return;
+        };
+        // Constructor arguments execute outside this class's member scope.
+        // A nested anonymous body there is still visited by the canonical walker.
+        if search.cursor < class.left_brace.start.offset
+            || search.cursor > class.right_brace.end.offset
+        {
+            return;
+        }
+        search.consider(
+            CursorContext::InClassLike {
+                kind: ClassLikeContextKind::AnonymousClass,
+                class_readonly: class.modifiers.contains_readonly(),
+                member: find_member_at_cursor(class.members.iter(), search.cursor),
+                all_members: &class.members,
+                body_end: class.right_brace.start.offset,
+            },
+            expression.span(),

+        .write()
+        .insert(uri.to_owned(), Arc::new(content.to_owned()));
+    let range = Range::new(Position::new(3, 12), Position::new(3, 12));
+    let direct = CodeAction {
+        title: "Extract interface".into(),
+        kind: Some(CodeActionKind::REFACTOR_EXTRACT),
+        data: Some(serde_json::json!({
+            "action_kind": "refactor.extractInterface",
+            "uri": uri,
+            "range": range,
+            "extra": null
+        })),
+        ..Default::default()
+    };
+    // The actual public resolve path must independently admit current syntax.
+    let (resolved, _) = backend.resolve_code_action(direct);
+    assert!(
+        resolved.edit.is_none(),

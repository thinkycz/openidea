+fn insertion_from_syntax(
+    content: &str,
+    keyword: u32,
+    declaration: mago_span::Span,
+    braces: (mago_span::Span, mago_span::Span),
+    members: &Sequence<'_, ClassLikeMember<'_>>,
+    newline: &'static str,
+) -> Option<MethodInsertion> {
+    let (open, right) = braces;
+    let close = right.start.offset as usize;
+    if content.get(close..right.end.offset as usize) != Some("}") {
+        return None;
+    }
+    let close_line = content[..close].rfind('\n').map_or(0, |offset| offset + 1);
+    let offset = if content[close_line..close]
+        .bytes()
+        .all(|byte| matches!(byte, b' ' | b'\t'))
+    {
+        close_line
+    } else {
+        close
+    };
+    let declaration_start = declaration.start.offset as usize;
+    let declaration_line = content[..declaration_start]
+        .rfind('\n')
+        .map_or(0, |offset| offset + 1);
+    let prefix = &content[declaration_line..declaration_start];
+    let class_indent = if keyword == 0 {
+        super::helpers::indent_of_line_at(content, declaration_start)
+    } else if prefix.bytes().all(|byte| matches!(byte, b' ' | b'\t')) {
+        prefix.to_owned()
+    } else {
+        String::new()
+    };
+    let indent = members
+        .first()
+        .and_then(|member| {
+            let start = member.span().start.offset as usize;
+            let line = content[..start].rfind('\n').map_or(0, |offset| offset + 1);
+            let prefix = &content[line..start];
+            (prefix.len() > class_indent.len()
+                && prefix.bytes().all(|byte| matches!(byte, b' ' | b'\t')))
+            .then(|| prefix.to_owned())
+        })
+        .unwrap_or_else(|| format!("{class_indent}    "));
+    Some(MethodInsertion {
+        keyword,
+        open: open.start.offset,
+        close: close as u32,
+        end: right.end.offset,
+        offset,
+        indent,
+        class_indent,
+        newline,
+    })
 }
 

+#[test]
+fn promoted_accessor_documented_shape_stays_doc_only_and_native_type_wins() {
+    let backend = create_test_backend();
+    for (content, native) in [
+        (
+            "<?php class Subject { /** @param array{label: string} $items */ public function __construct(private $items) {} }",
+            false,
+        ),
+        (
+            "<?php class Subject { /** @param list<string> $items */ public function __construct(private array $items) {} }",
+            true,
+        ),
+        (
+            "<?php class Subject { public function __construct(/** @var array{label: string} */ private $items) {} }",
+            false,
+        ),
+    ] {
+        let needle = if native {
+            "private array $items"
+        } else {
+            "private $items"
+        };
+        let actions = actions_at(&backend, content, needle);
+        let action = find_action_titled(&actions, "Generate getter and setter")
+            .expect("documented promoted property supports accessors");
+        let edits = extract_edits(action);
+        let inserted = edits
+            .iter()
+            .map(|e| e.new_text.as_str())
+            .collect::<String>();
+        if native {
+            assert!(inserted.contains("getItems(): array"), "{inserted}");
+            assert!(
+                inserted.contains("setItems(array $items): self"),
+                "{inserted}"
+            );
+        } else {
+            assert!(inserted.contains("@return array{"), "{inserted}");
+            assert!(inserted.contains("@param array{"), "{inserted}");
+            assert!(inserted.contains("label"), "{inserted}");
+            assert!(!inserted.contains("getItems():"), "{inserted}");
+            assert!(inserted.contains("setItems($items): self"), "{inserted}");
+        }
+    }
+}

+#[test]
+fn promoted_accessor_default_expression_does_not_select_outer_property() {
+    let backend = create_test_backend();
+    for (content, needle) in [
+        (
+            "<?php class Subject { public function __construct(private int $count = 1234) {} }",
+            "1234",
+        ),
+        (
+            "<?php class Subject { public function __construct(private object $value = new \\stdClass()) {} }",
+            "stdClass",
+        ),
+    ] {
+        assert!(generate_titles(&actions_at(&backend, content, needle)).is_empty());
+    }
+}

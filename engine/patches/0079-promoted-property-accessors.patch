+
+#[test]
+fn promoted_accessor_mutable_property_is_selected_by_parameter_cursor() {
+    let backend = create_test_backend();
+    let content = "<?php class Subject { public function __construct(private string $name, private bool $active) {} }";
+    for (needle, getter, setter) in [
+        ("$name", "getName(): string", "setName(string $name): self"),
+        (
+            "$active",
+            "isActive(): bool",
+            "setActive(bool $active): self",
+        ),
+    ] {
+        let actions = actions_at(&backend, content, needle);
+        let action = find_action_titled(&actions, "Generate getter and setter")
+            .expect("promoted property offers both accessors");
+        let result = apply_edits(content, &extract_edits(action));
+        assert!(result.contains(getter), "{result}");
+        assert!(result.contains(setter), "{result}");
+        assert!(result.contains("__construct(private string $name, private bool $active) {}"));
+        if needle == "$name" {
+            assert!(!result.contains("setActive("));
+        } else {
+            assert!(!result.contains("getName("));
+        }
+    }
+}
+
+#[test]
+fn promoted_accessor_readonly_parameter_and_class_keep_getter_only() {
+    let backend = create_test_backend();
+    for content in [
+        "<?php class Subject { public function __construct(private readonly string $name) {} }",
+        "<?php readonly class Subject { public function __construct(private string $name) {} }",
+    ] {
+        let actions = actions_at(&backend, content, "$name");
+        let action = find_action_titled(&actions, "Generate getter")
+            .expect("readonly promoted property retains getter");
+        let result = apply_edits(content, &extract_edits(action));
+        assert!(result.contains("getName(): string"), "{result}");
+        assert!(find_action_titled(&actions, "Generate setter").is_none());
+        assert!(find_action_titled(&actions, "Generate getter and setter").is_none());
+    }
+}
+
+#[test]
+fn promoted_accessor_ordinary_parameter_and_constructor_body_are_not_properties() {
+    let backend = create_test_backend();
+    for (content, needle) in [
+        (
+            "<?php class Subject { public function __construct(string $name) {} }",
+            "$name",
+        ),
+        (
+            "<?php class Subject { public function other(private string $name) {} }",
+            "$name",
+        ),
+        (
+            "<?php class Subject { public function __construct(private string $name) { echo $name; } }",
+            "echo $name",
+        ),
+    ] {
+        let actions = actions_at(&backend, content, needle);
+        assert!(
+            generate_titles(&actions).is_empty(),
+            "must not manufacture a promoted property: {:?}",
+            generate_titles(&actions)
+        );
+    }
+}
+
+#[test]
+fn promoted_accessor_existing_case_insensitive_method_keeps_independent_setter() {
+    let backend = create_test_backend();
+    let content = "<?php class Subject { public function __construct(private string $name) {} public function GETNAME(): string { return $this->name; } }";
+    let actions = actions_at(&backend, content, "$name");
+    assert!(find_action_titled(&actions, "Generate getter").is_none());
+    assert!(find_action_titled(&actions, "Generate getter and setter").is_none());
+    let setter =
+        find_action_titled(&actions, "Generate setter").expect("independent setter remains valid");
+    let result = apply_edits(content, &extract_edits(setter));
+    assert!(result.contains("setName(string $name): self"));
+    assert_eq!(result.matches("GETNAME(").count(), 1);
+}
+
+#[test]
+fn promoted_accessor_anonymous_unicode_crlf_owner_retains_following_code() {
+    let backend = create_test_backend();
+    let content = "<?php\r\n// café 🐘\r\n$o = new class('value') {\r\n  public function __construct(private string $name) {}\r\n}; echo 'outside';\r\n";
+    let actions = actions_at(&backend, content, "$name");
+    let action = find_action_titled(&actions, "Generate getter and setter")
+        .expect("anonymous promoted property supports accessors");
+    let result = apply_edits(content, &extract_edits(action));
+    assert!(
+        result.contains("  public function getName(): string\r\n"),
+        "{result}"
+    );
+    assert!(
+        result.contains("  public function setName(string $name): self\r\n"),
+        "{result}"
+    );
+    assert!(result.ends_with("}; echo 'outside';\r\n"), "{result}");
+    assert!(!result.replace("\r\n", "").contains('\n'));
+}

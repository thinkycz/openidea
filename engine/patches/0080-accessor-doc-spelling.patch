+#[test]
+fn accessor_doc_spelling_escaped_shape_preserves_comment_boundary_for_all_properties() {
+    let backend = create_test_backend();
+    let spelling = r#"array{"*\x2f public function injected($value) {} \x2f*": int}"#;
+    let sources = [
+        r#"<?php class Subject { /** @param array{"*\x2f public function injected($value) {} \x2f*": int} $value */ public function __construct(private $value) {} public function injected($value) {} }"#,
+        r#"<?php class Subject { public function __construct(/** @var array{"*\x2f public function injected($value) {} \x2f*": int} */ private $value) {} public function injected($value) {} }"#,
+        r#"<?php class Subject { /** @var array{"*\x2f public function injected($value) {} \x2f*": int} */ private $value; public function injected($value) {} }"#,
+    ];
+    for content in sources {
+        let actions = actions_at(&backend, content, "private $value");
+        let setter = find_action_titled(&actions, "Generate setter")
+            .expect("legitimate shape-valued property retains its setter");
+        let edits = extract_edits(setter);
+        assert!(!edits.is_empty());
+        let inserted = edits
+            .iter()
+            .map(|edit| edit.new_text.as_str())
+            .collect::<String>();
+        assert!(
+            inserted.contains(spelling),
+            "PHPDoc type spelling must remain escaped: {inserted}"
+        );
+        assert!(
+            !inserted.contains("*/ public function injected"),
+            "must not decode a comment terminator into executable PHP: {inserted}"
+        );
+    }
+}
+
+#[test]
+fn accessor_doc_spelling_escaped_shape_keeps_valid_getter_and_combined_actions() {
+    let backend = create_test_backend();
+    let content = r#"<?php class Subject { /** @param array{"*\x2f public function injected($value) {} \x2f*": int} $value */ public function __construct(private $value) {} public function injected($value) {} }"#;
+    let actions = actions_at(&backend, content, "private $value");
+    for title in ["Generate getter", "Generate getter and setter"] {
+        let action = find_action_titled(&actions, title).expect("matching action exists");
+        assert!(
+            action.disabled.is_none(),
+            "valid escaped PHPDoc must not be rejected as an inherited contract conflict: {action:?}"
+        );
+        let edits = extract_edits(action);
+        assert!(!edits.is_empty());
+        let inserted = edits
+            .iter()
+            .map(|edit| edit.new_text.as_str())
+            .collect::<String>();
+        assert!(
+            !inserted.contains("*/ public function injected"),
+            "{inserted}"
+        );
+    }
+}

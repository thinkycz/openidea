+/// Preserve the canonical tag parser's spelling alongside its semantic type.
+/// PhpType display can decode escaped shape keys into PHP comment delimiters.
+fn accessor_documented_type(
+    doc: &str,
+    kind: TagKind,
+    variable: Option<&str>,
+) -> Option<(PhpType, String)> {
+    let info = parse_docblock_for_tags(doc)?;
+    for tag in info.tags_by_kind_vendor_first(kind) {
+        if variable.is_some_and(|name| tag.variable().as_deref() != Some(name)) {
+            continue;
+        }
+        if let Some(spelling) = tag.type_text() {
+            let parsed = crate::docblock::sanitise_and_parse_docblock_type(&spelling)?;
+            return Some((parsed, spelling.into_owned()));
+        }
+    }
+    None
+}

+async fn trait_ctor_outgoing(
+    backend: &Backend,
+    uri: &Url,
+    source: &str,
+) -> Vec<CallHierarchyOutgoingCall> {
+    open_php(backend, uri, source).await;
+    let position = trait_ctor_position(source, "make():");
+    let roots = prepare_at(backend, uri, position.line, position.character).await;
+    assert_eq!(roots.len(), 1, "actual public prepare must find caller");
+    outgoing(backend, &roots[0]).await
+}

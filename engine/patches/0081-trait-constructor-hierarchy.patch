+/// Concrete implementation identity after PHP class/trait precedence.
+/// Unlike first-match navigation, callers can refuse invalid ambiguous composition.
+#[derive(Clone)]
+pub(crate) enum MethodOrigin {
+    Known {
+        owner: Arc<ClassInfo>,
+        method: Arc<crate::types::MethodInfo>,
+    },
+    /// A real declared requirement exists, but has no executable body.
+    Abstract,
+    Missing,
+    Unknown,
+    Ambiguous,
+}
+
+/// Resolve source ownership only; canonical parsed names/adaptations are inputs.
+/// No signature substitution, text scanning, or virtual-method inference occurs.
+pub(crate) fn resolve_concrete_method_origin(
+    class: &Arc<ClassInfo>,
+    name: &str,
+    loader: ClassLoader<'_>,
+) -> MethodOrigin {
+    struct Walk {
+        path: HashSet<(String, String)>,
+        completed: std::collections::HashMap<(String, String), MethodOrigin>,
+        remaining: usize,
+    }
+    fn combine(candidates: impl IntoIterator<Item = MethodOrigin>) -> MethodOrigin {
+        let mut found: Option<(Arc<ClassInfo>, Arc<crate::types::MethodInfo>)> = None;
+        let mut unknown = false;
+        let mut abstract_member = false;
+        for candidate in candidates {
+            match candidate {
+                MethodOrigin::Known { owner, method } => {
+                    if let Some((previous_owner, previous_method)) = &found {
+                        if !previous_owner.fqn().eq_ignore_ascii_case(&owner.fqn())
+                            || previous_method.name_offset != method.name_offset
+                            || !previous_method.name.eq_ignore_ascii_case(&method.name)
+                        {
+                            return MethodOrigin::Ambiguous;
+                        }
+                    } else {
+                        found = Some((owner, method));
+                    }
+                }
+                MethodOrigin::Ambiguous => return MethodOrigin::Ambiguous,
+                MethodOrigin::Unknown => unknown = true,
+                MethodOrigin::Abstract => abstract_member = true,
+                MethodOrigin::Missing => {}
+            }
+        }
+        if unknown {
+            return MethodOrigin::Unknown;
+        }
+        found.map_or(
+            if abstract_member {
+                MethodOrigin::Abstract
+            } else {
+                MethodOrigin::Missing
+            },
+            |(owner, method)| MethodOrigin::Known { owner, method },
+        )
+    }
+    fn walk(
+        class: &Arc<ClassInfo>,
+        name: &str,
+        loader: ClassLoader<'_>,
+        depth: u32,
+        state: &mut Walk,
+    ) -> MethodOrigin {
+        if depth > MAX_INHERITANCE_DEPTH.saturating_add(MAX_TRAIT_DEPTH) {
+            return MethodOrigin::Unknown;
+        }
+        let key = (class.fqn().to_ascii_lowercase(), name.to_ascii_lowercase());
+        if let Some(result) = state.completed.get(&key) {
+            return result.clone();
+        }
+        if state.remaining == 0 || !state.path.insert(key.clone()) {
+            return MethodOrigin::Unknown;
+        }
+        state.remaining -= 1;
+        let result = surface(class, name, loader, depth, state);
+        state.path.remove(&key);
+        // Unknown can depend on the active cycle path or exhausted budget.
+        // Memoize only completed semantic answers, keeping repeated diamonds cheap.
+        if !matches!(result, MethodOrigin::Unknown) {
+            state.completed.insert(key, result.clone());
+        }
+        result
+    }
+
+    fn surface(
+        class: &Arc<ClassInfo>,
+        name: &str,
+        loader: ClassLoader<'_>,
+        depth: u32,
+        state: &mut Walk,
+    ) -> MethodOrigin {
+        let mut own = class
+            .methods
+            .iter()
+            .filter(|method| !method.is_virtual && method.name.eq_ignore_ascii_case(name));
+        if let Some(method) = own.next() {
+            if own.next().is_some() {
+                return MethodOrigin::Ambiguous;
+            }
+            return if method.is_abstract {
+                MethodOrigin::Abstract
+            } else {
+                MethodOrigin::Known {
+                    owner: Arc::clone(class),
+                    method: Arc::clone(method),
+                }
+            };
+        }
+        let mut candidates = Vec::new();
+        for used_name in &class.used_traits {
+            let excluded = class.trait_precedences.iter().any(|precedence| {
+                precedence.method_name.eq_ignore_ascii_case(name)
+                    && precedence
+                        .insteadof
+                        .iter()
+                        .any(|excluded| excluded.eq_ignore_ascii_case(used_name))
+            });
+            if !excluded {
+                candidates.push(match loader(used_name) {
+                    Some(used) => walk(&used, name, loader, depth + 1, state),
+                    None => MethodOrigin::Unknown,
+                });
+            }
+        }
+        // Named aliases contribute their original implementation. Qualified
+        // aliases may retain an insteadof-excluded source under a fresh name.
+        for alias in &class.trait_aliases {
+            if !alias
+                .alias
+                .as_ref()
+                .is_some_and(|alias| alias.eq_ignore_ascii_case(name))
+            {
+                continue;
+            }
+            let mut sources = Vec::new();
+            for used_name in &class.used_traits {
+                if alias
+                    .trait_name
+                    .as_ref()
+                    .is_some_and(|source| !source.eq_ignore_ascii_case(used_name))
+                {
+                    continue;
+                }
+                // PHP binds an unqualified alias against all original direct
+                // trait tables, independently of insteadof exclusions.
+                sources.push(match loader(used_name) {
+                    Some(used) => walk(&used, &alias.method_name, loader, depth + 1, state),
+                    None => MethodOrigin::Unknown,
+                });
+            }
+            let result = if alias.trait_name.is_none()
+                && sources
+                    .iter()
+                    .filter(|source| {
+                        matches!(source, MethodOrigin::Known { .. } | MethodOrigin::Abstract)
+                    })
+                    .count()
+                    > 1
+            {
+                // Even a diamond exposing one implementation through two direct
+                // traits is ambiguous as an unqualified alias source in PHP.
+                MethodOrigin::Ambiguous
+            } else {
+                match combine(sources) {
+                    MethodOrigin::Missing => MethodOrigin::Unknown,
+                    result => result,
+                }
+            };
+            candidates.push(result);
+        }
+        let requirements = combine(candidates);
+        match requirements {
+            MethodOrigin::Missing | MethodOrigin::Abstract => {}
+            result => return result,
+        }
+        // A trait's abstract surface is an obligation, not an absent alias
+        // source and not an executable override. A concrete inherited method
+        // can satisfy it (including an abstract constructor alias).
+        match &class.parent_class {
+            Some(parent) => {
+                match crate::class_lookup::load_ancestor(&class.fqn(), parent, loader) {
+                    Some(parent) => match walk(&parent, name, loader, depth + 1, state) {
+                        MethodOrigin::Missing => requirements,
+                        result => result,
+                    },
+                    None => MethodOrigin::Unknown,
+                }
+            }
+            None => requirements,
+        }
+    }
+    walk(
+        class,
+        name,
+        loader,
+        0,
+        &mut Walk {
+            path: HashSet::new(),
+            completed: std::collections::HashMap::new(),
+            remaining: 1000,
+        },
+    )
+}

+#[cfg(test)]
+mod constructor_candidate_tests {
+    use super::*;
+
+    fn constructor_key() -> ReferenceIndexKey {
+        ReferenceIndexKey::Member {
+            name: "__construct".to_string(),
+            is_static: false,
+        }
+    }
+
+    #[test]
+    fn new_and_attribute_are_constructor_candidates_without_counting_member_references() {
+        let backend = Backend::new_test();
+        let uri = "file:///project/main.php";
+        backend.update_ast(
+            uri,
+            "<?php
+#[Vendor\\Attribute] class Consumer {}
+new \\Vendor\\Built();
+",
+        );
+        backend.workspace_indexed.store(true, Ordering::Release);
+        let key = constructor_key();
+        let candidates = backend
+            .reference_candidate_uris_for_keys(std::slice::from_ref(&key))
+            .unwrap();
+        assert!(
+            candidates.contains(uri),
+            "constructor scan must visit actual instantiation files even when the class belongs to vendor"
+        );
+        let counts: u32 = backend
+            .reference_index
+            .read()
+            .get(&key)
+            .map(|entries| entries.values().copied().sum())
+            .unwrap_or(0);
+        assert_eq!(counts, 0, "candidate-only hints are not member references");
+        let map = backend.symbol_maps.read().get(uri).cloned().unwrap();
+        let entries = backend.reference_entries_for_symbol_map(uri, &map);
+        assert_eq!(
+            entries
+                .iter()
+                .filter(|(candidate, counted)| *candidate == key && !*counted)
+                .count(),
+            2,
+            "both attribute and new contribute their own coarse candidate"
+        );
+    }
+
+    #[test]
+    fn keyword_constructor_candidates_are_removed_when_file_is_reparsed_without_them() {
+        let backend = Backend::new_test();
+        let uri = "file:///project/src/Consumer.php";
+        backend.update_ast(
+            uri,
+            "<?php
+class Consumer extends ParentType { function make() { new self(); new static(); new parent(); } }
+",
+        );
+        backend.workspace_indexed.store(true, Ordering::Release);
+        let key = constructor_key();
+        assert!(
+            backend
+                .reference_candidate_uris_for_keys(std::slice::from_ref(&key))
+                .unwrap()
+                .contains(uri)
+        );
+        let counts: u32 = backend
+            .reference_index
+            .read()
+            .get(&key)
+            .map(|entries| entries.values().copied().sum())
+            .unwrap_or(0);
+        assert_eq!(counts, 0);
+        backend.update_ast(
+            uri,
+            "<?php
+class Consumer {}
+",
+        );
+        assert!(
+            !backend
+                .reference_candidate_uris_for_keys(&[key])
+                .unwrap()
+                .contains(uri)
+        );
+    }
+
+    #[test]
+    fn ordinary_type_reference_does_not_become_constructor_candidate() {
+        let backend = Backend::new_test();
+        let uri = "file:///project/main.php";
+        backend.update_ast(
+            uri,
+            "<?php
+function take(\\Vendor\\Built $value): void {}
+",
+        );
+        backend.workspace_indexed.store(true, Ordering::Release);
+        assert!(
+            !backend
+                .reference_candidate_uris_for_keys(&[constructor_key()])
+                .unwrap()
+                .contains(uri)
+        );
+    }
+}

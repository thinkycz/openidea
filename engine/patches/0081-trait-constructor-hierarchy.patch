+    let source = "<?php\ntrait Requirement { abstract public function initialize(); }\nclass ParentType { public function __construct() {} }\nclass Built extends ParentType { use Requirement { Requirement::initialize as __construct; } public function initialize() {} }\nfunction make(): void { new Built(); }\n";
+    let calls = trait_ctor_outgoing(&backend, &uri, source).await;
+    assert_eq!(
+        calls.len(),
+        1,
+        "a valid abstract alias requirement must not hide the concrete inherited constructor"
+    );
+    assert_eq!(calls[0].to.uri, uri);
+    assert_eq!(calls[0].to.name, "__construct");
+    assert_eq!(calls[0].to.detail.as_deref(), Some("ParentType"));
+    assert_eq!(
+        calls[0].to.selection_range.start,
+        trait_ctor_position(source, "__construct()")
+    );
+    let callers = incoming(&backend, &calls[0].to).await;
+    assert_eq!(callers.len(), 1);
+    assert_eq!(callers[0].from.name, "make");
+    assert_eq!(callers[0].from.uri, uri);
+    assert_eq!(callers[0].from_ranges, calls[0].from_ranges);
+    assert!(outgoing(&backend, &calls[0].to).await.is_empty());
+}
+
+struct TraitCtorVendorFixture {
+    backend: Backend,
+    _dir: tempfile::TempDir,
+    trait_uri: Url,
+    caller_uri: Url,
+    vendor_uri: Url,
+    trait_source: &'static str,
+    caller_source: &'static str,
+}
+
+#[allow(deprecated)]
+async fn trait_ctor_vendor_fixture() -> TraitCtorVendorFixture {
+    const TRAIT: &str =
+        "<?php\nnamespace App;\ntrait Construction { public function __construct() {} }\n";
+    const CALLER: &str = "<?php\n// café 🐘\nfunction make(): void { new \\Vendor\\Built(); new \\Vendor\\Built(); new \\Vendor\\Child(); new \\Vendor\\Own(); }\n";
+    const MARKER: &str = "<?php\nnamespace App;\ninterface IndexMarker {}\n";
+    let (backend, dir) = create_psr4_workspace(
+        r#"{"autoload":{"psr-4":{"App\\":"src/"}}}"#,
+        &[
+            ("src/Construction.php", TRAIT),
+            ("src/IndexMarker.php", MARKER),
+            (
+                "src/IndexControl.php",
+                "<?php\nnamespace App;\nclass IndexControl implements IndexMarker {}\n",
+            ),
+            (
+                "vendor/acme/package/Built.php",
+                "<?php\nnamespace Vendor;\nclass Built { use \\App\\Construction; }\n",
+            ),
+            (
+                "vendor/acme/package/Child.php",
+                "<?php\nnamespace Vendor;\nclass Child extends Built {}\n",
+            ),
+            (
+                "vendor/acme/package/Own.php",
+                "<?php\nnamespace Vendor;\nclass Own extends Built { public function __construct() {} }\n",
+            ),
+            (
+                "vendor/acme/package/Unused.php",
+                "<?php\nnamespace Vendor;\nclass Unused { use \\App\\Construction; }\n",
+            ),
+            ("main.php", CALLER),
+            (
+                "vendor/composer/installed.json",
+                r#"{"packages":[{"name":"acme/package","version":"1.0.0","install-path":"../acme/package","autoload":{"psr-4":{"Vendor\\":""}}}]}"#,
+            ),
+            (
+                "vendor/composer/autoload_classmap.php",
+                r#"<?php
+$baseDir = dirname(dirname(__DIR__));
+return array(
+    'App\\Construction' => $baseDir . '/src/Construction.php',
+    'App\\IndexMarker' => $baseDir . '/src/IndexMarker.php',
+    'App\\IndexControl' => $baseDir . '/src/IndexControl.php',
+    'Vendor\\Built' => $baseDir . '/vendor/acme/package/Built.php',
+    'Vendor\\Child' => $baseDir . '/vendor/acme/package/Child.php',
+    'Vendor\\Own' => $baseDir . '/vendor/acme/package/Own.php',
+    'Vendor\\Unused' => $baseDir . '/vendor/acme/package/Unused.php',
+);
+"#,
+            ),
+        ],
+    );
+    backend
+        .initialize(InitializeParams {
+            root_uri: Some(Url::from_directory_path(dir.path()).unwrap()),
+            ..Default::default()
+        })
+        .await
+        .unwrap();
+    backend.initialized(InitializedParams {}).await;
+    let marker_uri = Url::from_file_path(dir.path().join("src/IndexMarker.php")).unwrap();
+    open_php(&backend, &marker_uri, MARKER).await;
+    // Public GTI lookup is a real workspace-index barrier, not a test mark flag.
+    let indexed = backend
+        .goto_implementation(tower_lsp::lsp_types::request::GotoImplementationParams {
+            text_document_position_params: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier { uri: marker_uri },
+                position: Position::new(2, 12),
+            },
+            work_done_progress_params: WorkDoneProgressParams::default(),
+            partial_result_params: PartialResultParams::default(),
+        })
+        .await
+        .unwrap();
+    let indexed_uris: Vec<Url> = match indexed {
+        Some(tower_lsp::lsp_types::request::GotoImplementationResponse::Scalar(location)) => {
+            vec![location.uri]
+        }
+        Some(tower_lsp::lsp_types::request::GotoImplementationResponse::Array(locations)) => {
+            locations.into_iter().map(|location| location.uri).collect()
+        }
+        Some(tower_lsp::lsp_types::request::GotoImplementationResponse::Link(locations)) => {
+            locations
+                .into_iter()
+                .map(|location| location.target_uri)
+                .collect()
+        }
+        None => Vec::new(),
+    };
+    assert_eq!(
+        indexed_uris,
+        vec![Url::from_file_path(dir.path().join("src/IndexControl.php")).unwrap()]
+    );
+    let vendor_uri = Url::parse(
+        backend
+            .fqn_uri_index()
+            .read()
+            .get("Vendor\\Built")
+            .expect("actual Composer installed metadata discovers vendor source"),
+    )
+    .unwrap();
+    assert_eq!(
+        vendor_uri.to_file_path().unwrap().canonicalize().unwrap(),
+        dir.path()
+            .join("vendor/acme/package/Built.php")
+            .canonicalize()
+            .unwrap()
+    );
+    assert!(
+        backend.get_classes_for_uri(vendor_uri.as_str()).is_none(),
+        "fixture must leave vendor consumer cold after project indexing"
+    );
+    let caller_uri = Url::from_file_path(dir.path().join("main.php")).unwrap();
+    assert!(
+        backend.parsed_uris().read().contains(caller_uri.as_str()),
+        "public barrier must really index the closed project caller"
+    );
+    let trait_uri = Url::from_file_path(dir.path().join("src/Construction.php")).unwrap();
+    open_php(&backend, &trait_uri, TRAIT).await;
+    TraitCtorVendorFixture {
+        backend,
+        _dir: dir,
+        trait_uri,
+        caller_uri,
+        vendor_uri,
+        trait_source: TRAIT,
+        caller_source: CALLER,
+    }
+}

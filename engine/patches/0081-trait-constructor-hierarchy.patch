+async fn trait_ctor_assert_vendor_symmetry(warm_first: bool) {
+    let fixture = trait_ctor_vendor_fixture().await;
+    let backend = &fixture.backend;
+    let constructor = trait_ctor_position(fixture.trait_source, "__construct()");
+    let roots = prepare_at(
+        backend,
+        &fixture.trait_uri,
+        constructor.line,
+        constructor.character,
+    )
+    .await;
+    assert_eq!(roots.len(), 1);
+    let make = trait_ctor_position(fixture.caller_source, "make():");
+    let caller = prepare_at(backend, &fixture.caller_uri, make.line, make.character).await;
+    assert_eq!(caller.len(), 1);
+    let line = fixture.caller_source.lines().nth(2).unwrap();
+    let expected: Vec<Range> = line
+        .match_indices("\\Vendor\\Built")
+        .map(|(column, name)| {
+            let start = line[..column].encode_utf16().count() as u32;
+            Range::new(
+                Position::new(2, start),
+                Position::new(2, start + name.encode_utf16().count() as u32),
+            )
+        })
+        .chain(line.match_indices("\\Vendor\\Child").map(|(column, name)| {
+            let start = line[..column].encode_utf16().count() as u32;
+            Range::new(
+                Position::new(2, start),
+                Position::new(2, start + name.encode_utf16().count() as u32),
+            )
+        }))
+        .collect();
+    if warm_first {
+        let calls = outgoing(backend, &caller[0]).await;
+        let composed = calls
+            .iter()
+            .find(|edge| edge.to.uri == fixture.trait_uri)
+            .expect("outgoing must resolve the actual vendor consumer constructor");
+        assert_eq!(composed.to.selection_range.start, constructor);
+        assert_eq!(composed.from_ranges, expected);
+        assert!(
+            backend
+                .get_classes_for_uri(fixture.vendor_uri.as_str())
+                .is_some()
+        );
+    } else {
+        assert!(
+            backend
+                .get_classes_for_uri(fixture.vendor_uri.as_str())
+                .is_none(),
+            "incoming-first really remains cold"
+        );
+    }
+    let callers = incoming(backend, &roots[0]).await;
+    assert_eq!(
+        callers.len(),
+        1,
+        "project trait's classmap-known vendor consumer new-sites must not disappear after workspace indexing"
+    );
+    assert_eq!(callers[0].from.name, "make");
+    assert_eq!(callers[0].from.uri, fixture.caller_uri);
+    assert_eq!(
+        callers[0].from_ranges, expected,
+        "include repeated Built and inherited Child; exclude Own override"
+    );
+    let calls = outgoing(backend, &caller[0]).await;
+    let composed = calls
+        .iter()
+        .find(|edge| edge.to.uri == fixture.trait_uri)
+        .expect("same concrete trait implementation");
+    assert_eq!(composed.to.selection_range.start, constructor);
+    assert_eq!(
+        composed.from_ranges, callers[0].from_ranges,
+        "incoming/outgoing symmetry independent of vendor load history"
+    );
+    assert_eq!(
+        calls.len(),
+        2,
+        "override keeps its independent real constructor edge"
+    );
+    let unused_uri = Url::parse(
+        backend
+            .fqn_uri_index()
+            .read()
+            .get("Vendor\\Unused")
+            .unwrap(),
+    )
+    .unwrap();
+    assert!(
+        backend.get_classes_for_uri(unused_uri.as_str()).is_none(),
+        "constructor references load actual receivers, not unrelated vendor consumers"
+    );
+    backend.shutdown().await.unwrap();
+}

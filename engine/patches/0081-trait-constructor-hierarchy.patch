+#[tokio::test]
+async fn trait_constructor_known_edge_cross_file_keeps_exact_declaration_and_repeated_sites() {
+    let (backend, dir) = create_psr4_workspace(
+        r#"{"autoload":{"psr-4":{"App\\":"src/"}}}"#,
+        &[
+            (
+                "src/Construction.php",
+                "<?php\nnamespace App;\ntrait Construction\n{\n    public function __construct() {}\n}\n",
+            ),
+            (
+                "src/Built.php",
+                "<?php\nnamespace App;\nclass Built { use Construction; }\n",
+            ),
+        ],
+    );
+    let uri = Url::from_file_path(dir.path().join("main.php")).unwrap();
+    let source =
+        "<?php\n// café 🐘\nfunction make(): void { new \\App\\Built(); new \\App\\Built(); }\n";
+    let calls = trait_ctor_outgoing(&backend, &uri, source).await;
+    assert_eq!(
+        calls.len(),
+        1,
+        "the known trait constructor must not disappear"
+    );
+    assert_eq!(calls[0].to.name, "__construct");
+    assert_eq!(
+        calls[0].to.uri,
+        Url::from_file_path(dir.path().join("src/Construction.php")).unwrap()
+    );
+    assert_eq!(calls[0].to.selection_range.start, Position::new(4, 20));
+    let first = trait_ctor_position(source, "\\App\\Built()");
+    let second_offset = source.rfind("\\App\\Built()").unwrap();
+    let second_prefix = &source[..second_offset];
+    let second = Position::new(
+        2,
+        second_prefix
+            .rsplit('\n')
+            .next()
+            .unwrap()
+            .encode_utf16()
+            .count() as u32,
+    );
+    assert_eq!(calls[0].from_ranges.len(), 2);
+    assert_eq!(calls[0].from_ranges[0].start, first);
+    assert_eq!(calls[0].from_ranges[1].start, second);
+    assert!(
+        outgoing(&backend, &calls[0].to).await.is_empty(),
+        "returned declaration is expandable"
+    );
+}

+            panic!("invalid root PHP fixture");
+        };
+        let d = tempfile::tempdir().unwrap();
+        let tool = script(d.path(), "analyzer café.php", b"#!/usr/bin/env php\n<?php echo json_encode(['php'=>PHP_BINARY,'cwd'=>getcwd(),'args'=>array_slice($argv,1)]);\n");
+        let mut command = runtime.command(&tool, d.path()).unwrap();
+        command
+            .current_dir(d.path())
+            .args(["analyse", "space café", ""]);
+        let output = crate::process::run_command_with_timeout(
+            &mut command,
+            std::time::Duration::from_secs(3),
+            &std::sync::atomic::AtomicBool::new(false),
+            "owned PHP fixture",
+            None,
+        )
+        .unwrap();
+        assert_eq!(output.code, 0);
+        let receipt: Value = serde_json::from_str(&output.stdout).unwrap();
+        assert_eq!(
+            Path::new(receipt["php"].as_str().unwrap())
+                .canonicalize()
+                .unwrap(),
+            **selected
+        );
+        assert_eq!(
+            Path::new(receipt["cwd"].as_str().unwrap())
+                .canonicalize()
+                .unwrap(),
+            d.path().canonicalize().unwrap()
+        );
+        assert_eq!(receipt["args"], json!(["analyse", "space café", ""]));
+    }
+    #[cfg(unix)]
+    #[test]
+    #[ignore = "Root supplies PHP_WORKBENCH_TEST_PHP for all six real analyzer adapter receipts"]
+    fn selected_php_runtime_all_file_and_workspace_adapters_use_real_runtime() {
+        let php = std::env::var("PHP_WORKBENCH_TEST_PHP")
+            .expect("root must provide actual PHP executable");
+        let runtime = PhpRuntime::from_options(Some(&json!({"phpRuntime":{"interpreter":php}})));
+        let PhpRuntime::Selected(selected) = &runtime else {

diff --git a/src/php_runtime.rs b/src/php_runtime.rs
new file mode 100644
index 0000000..5c59d36
--- /dev/null
+++ b/src/php_runtime.rs
@@ -0,0 +1,455 @@
+//! Immutable client-selected PHP for PHP-script analyzer launchers.
+use serde_json::Value;
+use std::{
+    fs::File,
+    io::Read,
+    path::{Path, PathBuf},
+    process::Command,
+};
+
+#[derive(Clone, Debug, Default)]
+pub(crate) enum PhpRuntime {
+    #[default]
+    Inherited,
+    Selected(std::sync::Arc<PathBuf>),
+    Invalid(std::sync::Arc<str>),
+}
+
+impl PhpRuntime {
+    /// Capture one literal client selection without executing the interpreter.
+    pub(crate) fn from_options(options: Option<&Value>) -> Self {
+        let Some(value) = options.and_then(|options| options.get("phpRuntime")) else {
+            return Self::Inherited;
+        };
+        let Some(value) = value.get("interpreter").and_then(Value::as_str) else {
+            return Self::Invalid(
+                "Selected PHP runtime requires one literal interpreter path or command.".into(),
+            );
+        };
+        match resolve_executable(value) {
+            Ok(path) => Self::Selected(std::sync::Arc::new(path)),
+            Err(error) => Self::Invalid(error.into()),
+        }
+    }
+
+    /// Apply the captured runtime to a recognized PHP launcher, preserving
+    /// direct execution for custom wrappers and native tools.
+    pub(crate) fn command(&self, tool: &Path, root: &Path) -> Result<Command, String> {
+        if matches!(self, Self::Inherited) {
+            return Ok(Command::new(tool));
+        }
+        let absolute = if tool.is_absolute() {
+            tool.to_owned()
+        } else if tool.components().count() > 1 {
+            root.join(tool)
+        } else {
+            resolve_executable(tool.to_str().ok_or("Analyzer path is not UTF-8")?)?
+        };
+        let absolute = absolute
+            .canonicalize()
+            .map_err(|_| "Cannot resolve analyzer launcher".to_owned())?;
+        if !is_php_launcher(&absolute)? {
+            // Unknown shell wrappers and native tools retain their own runtime.
+            return Ok(Command::new(tool));
+        }
+        match self {
+            Self::Selected(interpreter) => {
+                regular_executable(interpreter)?;
+                let mut command = Command::new(interpreter.as_ref());
+                command.arg(absolute);
+                Ok(command)
+            }
+            Self::Invalid(error) => Err(error.to_string()),
+            Self::Inherited => unreachable!(),
+        }
+    }
+}
+
+impl crate::Backend {
+    /// Share the initialized workspace choice with diagnostic workers.
+    pub(crate) fn php_runtime(&self) -> &PhpRuntime {
+        self.workspace.php_runtime.get_or_init(PhpRuntime::default)
+    }
+}
+
+fn regular_executable(path: &Path) -> Result<(), String> {
+    let metadata = std::fs::metadata(path)
+        .map_err(|_| "Selected PHP interpreter is unavailable".to_owned())?;
+    if !metadata.is_file() {
+        return Err("Selected PHP interpreter must be a regular executable file".into());
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        if metadata.permissions().mode() & 0o111 == 0 {
+            return Err("Selected PHP interpreter is not executable".into());
+        }
+    }
+    Ok(())
+}
+
+fn resolve_executable(value: &str) -> Result<PathBuf, String> {
+    if value.is_empty() || value.len() > 4096 || value.contains('\0') {
+        return Err(
+            "Selected PHP interpreter must be one nonempty literal executable path or PATH command"
+                .into(),
+        );
+    }
+    let path = Path::new(value);
+    let candidate = if path.is_absolute() {
+        path.to_owned()
+    } else {
+        if path.components().count() != 1 || value.chars().any(char::is_whitespace) {
+            return Err("Selected PHP interpreter must be absolute or a bare PATH command without arguments".into());
+        }
+        std::env::var_os("PATH")
+            .and_then(|paths| {
+                std::env::split_paths(&paths)
+                    .filter(|directory| directory.is_absolute())
+                    .map(|directory| directory.join(value))
+                    .find(|candidate| regular_executable(candidate).is_ok())
+            })
+            .ok_or_else(|| "Selected PHP interpreter was not found on PATH".to_owned())?
+    };
+    let canonical = candidate
+        .canonicalize()
+        .map_err(|_| "Cannot resolve selected PHP interpreter".to_owned())?;
+    regular_executable(&canonical)?;
+    Ok(canonical)
+}
+
+fn is_php_launcher(path: &Path) -> Result<bool, String> {
+    if !std::fs::metadata(path)
+        .map_err(|_| "Cannot inspect analyzer launcher".to_owned())?
+        .is_file()
+    {
+        return Err("Analyzer launcher must be a regular file".into());
+    }
+    #[cfg(unix)]
+    let file = {
+        use rustix::fs::{Mode, OFlags};
+        rustix::fs::open(
+            path,
+            OFlags::RDONLY | OFlags::NONBLOCK | OFlags::NOFOLLOW | OFlags::CLOEXEC,
+            Mode::empty(),
+        )
+        .map(File::from)
+        .map_err(|_| "Cannot open analyzer launcher".to_owned())?
+    };
+    #[cfg(not(unix))]
+    let file = File::open(path).map_err(|_| "Cannot open analyzer launcher".to_owned())?;
+    if !file
+        .metadata()
+        .map_err(|_| "Cannot inspect analyzer descriptor".to_owned())?
+        .is_file()
+    {
+        return Err("Analyzer launcher must be a regular file".into());
+    }
+    let mut bytes = Vec::new();
+    file.take(4096)
+        .read_to_end(&mut bytes)
+        .map_err(|_| "Cannot read analyzer header".to_owned())?;
+    let mut header = bytes.as_slice();
+    if header.starts_with(b"\xef\xbb\xbf") {
+        header = &header[3..];
+    }
+    if header.starts_with(b"#!") {
+        let Some(newline) = header.iter().position(|byte| *byte == b'\n') else {
+            return Ok(false);
+        };
+        header = &header[newline + 1..];
+    }
+    let header = header.trim_ascii_start();
+    Ok(header.starts_with(b"<?php") && header.get(5).is_none_or(u8::is_ascii_whitespace))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+    fn script(directory: &Path, name: &str, content: &[u8]) -> PathBuf {
+        let path = directory.join(name);
+        std::fs::write(&path, content).unwrap();
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o755)).unwrap();
+        }
+        path.canonicalize().unwrap()
+    }
+    #[test]
+    fn selected_php_runtime_options_absence_and_invalid_never_fallback() {
+        assert!(matches!(
+            PhpRuntime::from_options(None),
+            PhpRuntime::Inherited
+        ));
+        assert!(matches!(
+            PhpRuntime::from_options(Some(&json!({"other":1}))),
+            PhpRuntime::Inherited
+        ));
+        for value in [
+            json!(null),
+            json!({}),
+            json!({"interpreter":""}),
+            json!({"interpreter":"x\0y"}),
+            json!({"interpreter":"../php"}),
+            json!({"interpreter":"php -d x"}),
+            json!({"interpreter":"a".repeat(4097)}),
+            json!({"interpreter":"/not/a/real/php"}),
+        ] {
+            assert!(matches!(
+                PhpRuntime::from_options(Some(&json!({"phpRuntime":value}))),
+                PhpRuntime::Invalid(_)
+            ));
+        }
+    }
+    #[test]
+    fn selected_php_runtime_script_command_preserves_literal_args_and_native_wrappers() {
+        let d = tempfile::tempdir().unwrap();
+        let php = script(d.path(), "PHP café", b"#!/bin/sh\nexit 0\n")
+            .canonicalize()
+            .unwrap();
+        let tool = script(
+            d.path(),
+            "analyzer space",
+            b"#!/usr/bin/env php\n<?php\necho 'x';",
+        );
+        let runtime = PhpRuntime::Selected(std::sync::Arc::new(php.clone()));
+        let mut command = runtime.command(&tool, d.path()).unwrap();
+        command.args(["analyse", "literal café"]);
+        assert_eq!(command.get_program(), php.as_os_str());
+        assert_eq!(
+            command.get_args().collect::<Vec<_>>(),
+            vec![
+                tool.as_os_str(),
+                std::ffi::OsStr::new("analyse"),
+                std::ffi::OsStr::new("literal café")
+            ]
+        );
+        let invalid = PhpRuntime::Invalid("unavailable".into());
+        assert!(invalid.command(&tool, d.path()).is_err());
+        for (name, bytes) in [
+            ("wrapper", b"#!/bin/sh\necho wrapper\n".as_slice()),
+            ("native", b"\x7fELFbinary".as_slice()),
+        ] {
+            let native = script(d.path(), name, bytes);
+            assert_eq!(
+                invalid.command(&native, d.path()).unwrap().get_program(),
+                native.as_os_str()
+            );
+        }
+        assert_eq!(
+            PhpRuntime::Inherited
+                .command(&tool, d.path())
+                .unwrap()
+                .get_program(),
+            tool.as_os_str()
+        );
+    }
+    #[test]
+    fn selected_php_runtime_bounded_headers_and_regular_file_controls() {
+        let d = tempfile::tempdir().unwrap();
+        for (name, bytes, php) in [
+            ("plain", b"<?php\n".as_slice(), true),
+            ("bom", b"\xef\xbb\xbf<?php\n".as_slice(), true),
+            ("notphp", b"<?phpx".as_slice(), false),
+            ("shell", b"#!/bin/sh\necho '<?php';".as_slice(), false),
+        ] {
+            assert_eq!(
+                is_php_launcher(&script(d.path(), name, bytes)).unwrap(),
+                php
+            );
+        }
+        assert!(is_php_launcher(d.path()).is_err());
+        let long = script(d.path(), "long", &[b'#'; 8192]);
+        assert!(!is_php_launcher(&long).unwrap());
+    }
+    #[test]
+    fn selected_php_runtime_leading_whitespace_is_still_php_and_invalid_selection_refuses() {
+        let d = tempfile::tempdir().unwrap();
+        let tool = script(
+            d.path(),
+            "whitespace analyzer",
+            b"#!/usr/bin/env php\n\r\n \t<?php\necho '{}';",
+        );
+        let invalid = PhpRuntime::Invalid("selected PHP unavailable".into());
+        assert!(is_php_launcher(&tool).unwrap());
+        assert!(invalid.command(&tool, d.path()).is_err());
+    }
+
+    #[tokio::test]
+    async fn selected_php_runtime_initialize_shared_by_worker_clones() {
+        use tower_lsp::lsp_types::InitializeParams;
+        let backend = crate::Backend::new_test();
+        let params = InitializeParams {
+            initialization_options: Some(json!({"phpRuntime":{"interpreter":"/not/a/real/php"}})),
+            ..Default::default()
+        };
+        backend.on_initialize(params).await.unwrap();
+        assert!(matches!(
+            backend.clone_for_diagnostic_worker().php_runtime(),
+            PhpRuntime::Invalid(_)
+        ));
+        assert!(std::sync::Arc::ptr_eq(
+            &backend.workspace.php_runtime,
+            &backend.clone_for_blocking().workspace.php_runtime
+        ));
+    }
+
+    #[cfg(unix)]
+    #[test]

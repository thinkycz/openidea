+        let text = format!(
+            "#!/usr/bin/env php\n<?php file_put_contents({quoted}, json_encode(['php'=>PHP_BINARY,'cwd'=>getcwd(),'args'=>array_slice($argv,1)])); echo in_array('--format=json', $argv, true) ? '{{\"files\":[]}}' : '{{\"files\":{{}},\"errors\":[],\"totals\":{{\"errors\":0,\"file_errors\":0}}}}';\n"
+        );
+        let tool = script(d.path(), "actual analyzer café", text.as_bytes());
+        let file = d.path().join("Driver.php");
+        std::fs::write(&file, "<?php\r\n// exact café 🐘\r\n").unwrap();
+        let source = std::fs::read_to_string(&file).unwrap();
+        let cancel = std::sync::atomic::AtomicBool::new(false);
+        for case in 0..6 {
+            match case {
+                0 => {
+                    crate::phpstan::run_phpstan_with_runtime(
+                        &crate::phpstan::ResolvedPhpStan { path: tool.clone() },
+                        &source,
+                        &file,
+                        d.path(),
+                        &Default::default(),
+                        &cancel,
+                        &runtime,
+                    )
+                    .unwrap();
+                }
+                1 => {
+                    crate::phpstan::run_phpstan_workspace_with_runtime(
+                        &crate::phpstan::ResolvedPhpStan { path: tool.clone() },
+                        d.path(),
+                        &Default::default(),
+                        &cancel,
+                        &runtime,
+                    )
+                    .unwrap();
+                }
+                2 => {
+                    crate::phpcs::run_phpcs_with_runtime(
+                        &crate::phpcs::ResolvedPhpcs { path: tool.clone() },
+                        &source,
+                        &file,
+                        d.path(),
+                        &Default::default(),
+                        &cancel,
+                        &runtime,
+                    )
+                    .unwrap();
+                }
+                3 => {
+                    crate::phpcs::run_phpcs_workspace_with_runtime(
+                        &crate::phpcs::ResolvedPhpcs { path: tool.clone() },
+                        d.path(),
+                        &Default::default(),
+                        &cancel,
+                        &runtime,
+                    )
+                    .unwrap();
+                }
+                4 => {
+                    crate::phpmd::run_phpmd_with_runtime(
+                        &crate::phpmd::ResolvedPhpmd { path: tool.clone() },
+                        &source,
+                        d.path(),
+                        &Default::default(),
+                        &cancel,
+                        &runtime,
+                    )
+                    .unwrap();
+                }
+                _ => {
+                    crate::phpmd::run_phpmd_workspace_with_runtime(
+                        &crate::phpmd::ResolvedPhpmd { path: tool.clone() },
+                        d.path(),
+                        &Default::default(),
+                        &cancel,
+                        &runtime,
+                    )
+                    .unwrap();
+                }
+            }
+            let value: Value = serde_json::from_slice(&std::fs::read(&receipt).unwrap()).unwrap();
+            assert_eq!(
+                Path::new(value["php"].as_str().unwrap())
+                    .canonicalize()
+                    .unwrap(),
+                **selected,
+                "adapter {case}"
+            );
+            assert_eq!(
+                Path::new(value["cwd"].as_str().unwrap())
+                    .canonicalize()
+                    .unwrap(),
+                d.path().canonicalize().unwrap(),
+                "adapter {case}"
+            );
+            assert!(!value["args"].as_array().unwrap().is_empty());
+            assert_eq!(std::fs::read_to_string(&file).unwrap(), source);
+            std::fs::remove_file(&receipt).unwrap();
+        }
+    }
+}

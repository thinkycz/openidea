+    let html = "Before<table class=\"flags\"><caption>Available flags</caption><tr><th>Flag</th><th>Description</th></tr><tr><td><code>A&#124;B</code></td><td>Žofie &amp; 😀 array&lt;string&gt;</td></tr><tr><td>C</td><td>second row</td></tr></table>After";

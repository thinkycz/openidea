+    let text = super::formatting::html_to_markdown(&input);
+    assert_eq!(text.matches('&').count(), ampersands.len());
+    let ticks = "`".repeat(32_768);
+    let text = super::formatting::html_to_markdown(&format!(
+        "{ticks}<table><tr><td>tail</td></tr></table>"
+    ));
+    assert!(text.starts_with(&ticks));

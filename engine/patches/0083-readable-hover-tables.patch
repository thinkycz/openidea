+//! Convert supported HTML tables to ordinary Markdown lists; keep unsupported input intact.
+struct Tag<'a> {
+    name: &'a str,
+    close: bool,
+    end: usize,
+}
+fn tag(text: &str, at: usize) -> Option<Tag<'_>> {
+    let b = text.as_bytes();
+    if b.get(at) != Some(&b'<') {
+        return None;
+    }
+    let mut p = at + 1;
+    let close = b.get(p) == Some(&b'/');
+    if close {
+        p += 1;
+    }
+    let start = p;
+    while b.get(p).is_some_and(u8::is_ascii_alphabetic) {
+        p += 1;
+    }
+    if p == start
+        || !b
+            .get(p)
+            .is_some_and(|c| c.is_ascii_whitespace() || *c == b'>' || *c == b'/')
+    {
+        return None;
+    }
+    let name = &text[start..p];
+    let mut quote = None;
+    while let Some(&c) = b.get(p) {
+        if let Some(q) = quote {
+            if c == q {
+                quote = None;
+            }
+        } else if c == b'\'' || c == b'"' {
+            quote = Some(c);
+        } else if c == b'>' {
+            return Some(Tag {
+                name,
+                close,
+                end: p + 1,
+            });
+        } else if c == b'<' {
+            return None;
+        }
+        p += 1;
+    }
+    None
+}
+fn decode(text: &str) -> Option<String> {
+    let mut out = String::new();
+    let mut rest = text;
+    while let Some(at) = rest.find('&') {
+        out.push_str(&rest[..at]);
+        rest = &rest[at..];
+        let Some(end) = rest.as_bytes().iter().take(17).position(|b| *b == b';') else {
+            if rest
+                .as_bytes()
+                .get(1)
+                .is_some_and(|c| c.is_ascii_alphabetic() || *c == b'#')
+            {
+                return None;
+            }
+            out.push('&');
+            rest = &rest[1..];
+            continue;
+        };
+        let e = &rest[1..end];
+        if e.contains('&') || e.chars().any(char::is_whitespace) {
+            out.push('&');
+            rest = &rest[1..];
+            continue;
+        }
+        let value = match e {
+            "amp" => Some('&'),
+            "lt" => Some('<'),
+            "gt" => Some('>'),
+            "quot" => Some('"'),
+            "apos" => Some('\''),
+            "nbsp" => Some(' '),
+            "vert" | "VerticalLine" => Some('|'),
+            _ => e
+                .strip_prefix("#x")
+                .or_else(|| e.strip_prefix("#X"))
+                .and_then(|n| u32::from_str_radix(n, 16).ok())
+                .and_then(char::from_u32)
+                .or_else(|| {
+                    e.strip_prefix('#')
+                        .and_then(|n| n.parse::<u32>().ok())
+                        .and_then(char::from_u32)
+                }),
+        };
+        out.push(value.filter(|c| !c.is_control())?);
+        rest = &rest[end + 1..];
+    }
+    out.push_str(rest);
+    Some(out)
+}
+fn escaped(text: &str) -> String {
+    let mut out = String::new();
+    let mut whitespace = false;
+    for c in text.chars() {
+        if c.is_whitespace() {
+            if !whitespace {
+                out.push(' ');
+            }
+            whitespace = true;
+            continue;
+        }
+        whitespace = false;
+        match c {
+            '<' => out.push_str("&lt;"),
+            '>' => out.push_str("&gt;"),
+            '\\' | '\x60' | '*' | '_' | '[' | ']' => {
+                out.push('\\');
+                out.push(c);
+            }
+            _ => out.push(c),
+        }
+    }
+    out
+}
+fn inline(text: &str) -> Option<String> {
+    let mut out = String::new();
+    let mut cursor = 0;
+    let mut stack = Vec::new();
+    while let Some(rel) = text[cursor..].find('<') {
+        let at = cursor + rel;
+        out.push_str(&escaped(&text[cursor..at]));
+        let t = tag(text, at)?;
+        let name = t.name.to_ascii_lowercase();
+        if name == "code" && !t.close {
+            let mut end = t.end;
+            let (close, after) = loop {
+                let next = end + text[end..].find('<')?;
+                let t = tag(text, next)?;
+                if t.close && t.name.eq_ignore_ascii_case("code") {
+                    break (next, t.end);
+                }
+                end = t.end;
+            };
+            let content = decode(&text[t.end..close])?;
+            let width = content
+                .split(|c| c != '\x60')
+                .map(str::len)
+                .max()
+                .unwrap_or(0)
+                + 1;
+            let fence = "\x60".repeat(width);
+            let pad = content.starts_with('\x60') || content.ends_with('\x60');
+            out.push_str(&fence);
+            if pad {
+                out.push(' ');
+            }
+            out.push_str(&content);
+            if pad {
+                out.push(' ');
+            }
+            out.push_str(&fence);
+            cursor = after;
+            continue;
+        }
+        let marker = match name.as_str() {
+            "b" | "strong" => "**",
+            "i" | "em" => "*",
+            "span" => "",
+            "br" if !t.close => " / ",
+            "p" => " ",
+            _ => return None,
+        };
+        if name != "br" {
+            if t.close {
+                if stack.pop().as_deref() != Some(name.as_str()) {
+                    return None;
+                }
+            } else {
+                stack.push(name);
+            }
+        }
+        out.push_str(marker);
+        cursor = t.end;
+    }
+    out.push_str(&escaped(&text[cursor..]));
+    if !stack.is_empty() {
+        return None;
+    }
+    Some(out.trim().to_string())
+}
+fn table(text: &str, start: usize) -> Option<(usize, String)> {
+    let opening = tag(text, start)?;
+    if opening.close || !opening.name.eq_ignore_ascii_case("table") {
+        return None;
+    }
+    let mut cursor = opening.end;
+    let mut rows = Vec::<Vec<String>>::new();
+    let mut row = None::<Vec<String>>;
+    let mut cell = None::<(String, usize)>;
+    let mut caption = String::new();
+    let mut caption_start = None;
+    let mut wrappers = Vec::new();
+    loop {
+        let at = cursor + text[cursor..].find('<')?;
+        if cell.is_none() && caption_start.is_none() {
+            let loose = text[cursor..at].trim();
+            if !loose.is_empty() {
+                if row.is_some() {
+                    return None;
+                }
+                if !caption.is_empty() {
+                    caption.push(' ');
+                }
+                caption.push_str(&escaped(loose));
+            }
+        }
+        let t = tag(text, at)?;
+        let name = t.name.to_ascii_lowercase();
+        if let Some((kind, content_start)) = cell.as_ref() {
+            if t.close && &name == kind {
+                row.as_mut()?.push(inline(&text[*content_start..at])?);
+                cell = None;
+            } else if matches!(name.as_str(), "table" | "tr" | "td" | "th") {
+                return None;
+            }
+        } else if let Some(content_start) = caption_start {
+            if t.close && name == "caption" {
+                caption = inline(&text[content_start..at])?;
+                caption_start = None;
+            } else if matches!(name.as_str(), "table" | "tr" | "td" | "th") {
+                return None;
+            }
+        } else {
+            match (name.as_str(), t.close) {
+                ("table", true) => {
+                    if row.is_some() || !wrappers.is_empty() || rows.is_empty() {
+                        return None;
+                    }
+                    let mut out = String::from("\n\n");
+                    if !caption.is_empty() {
+                        out.push_str(&caption);
+                        out.push_str("\n\n");
+                    }
+                    for cells in rows {
+                        out.push_str("- ");
+                        out.push_str(&cells.join(" — "));
+                        out.push('\n');
+                    }
+                    out.push('\n');
+                    return Some((t.end, out));
+                }
+                ("tr", false) if row.is_none() => row = Some(Vec::new()),
+                ("tr", true) => {
+                    let cells = row.take()?;
+                    if cells.is_empty() {
+                        return None;
+                    }
+                    rows.push(cells);
+                }
+                ("td" | "th", false) if row.is_some() => cell = Some((name, t.end)),
+                ("caption", false) if row.is_none() && caption.is_empty() => {
+                    caption_start = Some(t.end)
+                }
+                ("thead" | "tbody" | "tfoot", false) if row.is_none() => wrappers.push(name),
+                ("thead" | "tbody" | "tfoot", true) if row.is_none() => {
+                    if wrappers.pop().as_deref() != Some(name.as_str()) {
+                        return None;
+                    }
+                }
+                _ => return None,
+            }
+        }
+        cursor = t.end;
+    }
+}
+// Markdown fences start on their own line, with up to three spaces of indentation.
+// An unclosed fence consumes the rest of the document as code.
+fn fence_end(text: &str, start: usize, width: usize, marker: u8) -> usize {
+    let Some(newline) = text[start..].find('\n') else {
+        return text.len();
+    };
+    let mut line_start = start + newline + 1;
+    while line_start < text.len() {
+        let line_end = text[line_start..]
+            .find('\n')
+            .map_or(text.len(), |n| line_start + n);
+        let line = text[line_start..line_end]
+            .strip_suffix('\r')
+            .unwrap_or(&text[line_start..line_end]);
+        let indent = line.bytes().take_while(|b| *b == b' ').count();
+        if indent <= 3 {
+            let tail = &line[indent..];
+            let count = tail.bytes().take_while(|b| *b == marker).count();
+            if count >= width && tail[count..].bytes().all(|b| b == b' ' || b == b'\t') {
+                return if line_end < text.len() {
+                    line_end + 1
+                } else {
+                    line_end
+                };
+            }
+        }
+        line_start = line_end.saturating_add(1);
+    }
+    text.len()
+}
+fn table_opener(text: &str, at: usize) -> bool {
+    let bytes = &text.as_bytes()[at..];
+    bytes
+        .get(..6)
+        .is_some_and(|prefix| prefix.eq_ignore_ascii_case(b"<table"))
+        && bytes
+            .get(6)
+            .is_some_and(|c| c.is_ascii_whitespace() || *c == b'>' || *c == b'/')
+}
+pub(super) fn convert(text: &str, legacy: impl Fn(&str) -> String) -> String {
+    let mut out = String::new();
+    let mut cursor = 0;
+    let mut pending = 0;
+    let mut line_start = 0;
+    while cursor < text.len() {
+        let byte = text.as_bytes()[cursor];
+        if matches!(byte, b'~' | b'`')
+            && cursor - line_start <= 3
+            && text[line_start..cursor].bytes().all(|b| b == b' ')
+        {
+            let width = text.as_bytes()[cursor..]
+                .iter()
+                .take_while(|b| **b == byte)
+                .count();
+            let line_end = text[cursor + width..]
+                .find('\n')
+                .map_or(text.len(), |n| cursor + width + n);
+            let valid_info = byte != b'`' || !text[cursor + width..line_end].contains('`');
+            if width >= 3 && valid_info {
+                let end = fence_end(text, cursor, width, byte);
+                out.push_str(&legacy(&text[pending..cursor]));
+                out.push_str(&text[cursor..end]);
+                cursor = end;
+                pending = end;
+                line_start = end;
+                continue;
+            }
+        }
+        // Table examples and existing Markdown code must not be reinterpreted as HTML.
+        if byte == b'\x60' {
+            let width = text.as_bytes()[cursor..]
+                .iter()
+                .take_while(|b| **b == b'\x60')
+                .count();
+            let fence = "\x60".repeat(width);
+            if let Some(end) = text[cursor + width..].find(&fence) {
+                let end = cursor + width + end + width;
+                out.push_str(&legacy(&text[pending..cursor]));
+                out.push_str(&text[cursor..end]);
+                if let Some(n) = text[cursor..end].rfind('\n') {
+                    line_start = cursor + n + 1;
+                }
+                cursor = end;
+                pending = end;
+                continue;
+            }
+            // A single unmatched run must not be counted/searched once per byte.
+            cursor += width;
+            continue;
+        }
+        if table_opener(text, cursor) {
+            out.push_str(&legacy(&text[pending..cursor]));
+            if let Some((end, replacement)) = table(text, cursor) {
+                out.push_str(&replacement);
+                if let Some(n) = text[cursor..end].rfind('\n') {
+                    line_start = cursor + n + 1;
+                }
+                cursor = end;
+                pending = end;
+                continue;
+            }
+            // A malformed opener retains its suffix without rescanning quoted/nested tags.
+            out.push_str(&text[cursor..]);
+            return out;
+        }
+        let c = text[cursor..].chars().next().unwrap();
+        cursor += c.len_utf8();
+        if c == '\n' {
+            line_start = cursor;
+        }
+    }
+    out.push_str(&legacy(&text[pending..]));
+    out
+}

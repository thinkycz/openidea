+fn html_table_tilde_fenced_examples_stay_literal_and_following_table_converts() {
+    for fence in [
+        "~~~html\n<table><tr><td>example</td></tr></table>\n~~~\n",
+        "   ~~~~html\r\n<table><tr><td>example</td></tr></table>\r\n   ~~~~~\r\n",
+        "~~~html\n<table><tr><td>unclosed example</td></tr></table>",
+    ] {
+        assert_eq!(super::formatting::html_to_markdown(fence), fence);
+    }
+    let input = "~~~html\n<table><tr><td>example</td></tr></table>\n~~~\n<table><tr><td>actual cell</td></tr></table>";
+    let text = super::formatting::html_to_markdown(input);
+    assert!(text.starts_with("~~~html\n<table><tr><td>example</td></tr></table>\n~~~\n"));
+    assert!(
+        text.contains("- actual cell"),
+        "post-fence prose did not resume: {text}"
+    );
+    let inline =
+        super::formatting::html_to_markdown("inline ~~~ <table><tr><td>actual</td></tr></table>");
+    assert!(
+        inline.contains("- actual"),
+        "inline tildes are not code fences: {inline}"
+    );
+}

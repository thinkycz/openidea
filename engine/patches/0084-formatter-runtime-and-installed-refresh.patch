+// Only installed.json changes below; both alternative source trees preexist.
+struct InstalledRefresh {
+    fixture: Projects,
+    vendor: &'static str,
+}
+impl InstalledRefresh {
+    fn new(vendor: &'static str, installed: bool) -> Self {
+        let value = Self {
+            fixture: Projects::new(),
+            vendor,
+        };
+        value.fixture.write(
+            "apps/a/composer.json",
+            &serde_json::json!({
+                "name":"fixture/a", "require":{"fixture/dependency":"*"},
+                "config":{"vendor-dir":vendor},
+                "autoload":{"psr-4":{"App\\":"src/"}}
+            })
+            .to_string(),
+        );
+        value
+            .fixture
+            .write("apps/a/composer.lock", "{\"packages\":[]}\n");
+        value.fixture.write(
+            "apps/a/.phpantom.toml",
+            "[indexing]\nstrategy = \"composer\"\n",
+        );
+        value
+            .fixture
+            .write("apps/a/.gitignore", &format!("/{vendor}/\n"));
+        for (tree, name) in [("old", "oldOnly"), ("new", "newOnly")] {
+            value.fixture.write(&format!("apps/a/{vendor}/fixture/dependency/{tree}/Service.php"),
+                &format!("<?php\r\nnamespace Installed;\r\nclass Service {{ /** café 🐘 {name} docs */ public function {name}(): void {{}} }}\r\n"));
+        }
+        value.fixture.write(
+            "apps/a/dependency.php",
+            "<?php\r\n// café 🐘\r\n$service = new \\Installed\\Service();\r\n$service->\r\n",
+        );
+        if installed {
+            value.set("old");
+        }
+        value
+    }
+    fn metadata(&self) -> PathBuf {
+        self.fixture
+            .path("a", &format!("{}/composer/installed.json", self.vendor))
+    }
+    fn set(&self, tree: &str) {
+        self.fixture.write(&format!("apps/a/{}/composer/installed.json", self.vendor),
+            &serde_json::json!({"packages":[{"name":"fixture/dependency","version":format!("1.0.0-{tree}"),
+                "install-path":"../fixture/dependency", "autoload":{"psr-4":{"Installed\\":format!("{tree}/")}}}]}).to_string());
+    }
+    async fn event(&self, router: &ProjectRouter, path: &Path, typ: FileChangeType) {
+        router
+            .did_change_watched_files(DidChangeWatchedFilesParams {
+                changes: vec![FileEvent {
+                    uri: Url::from_file_path(path).unwrap(),
+                    typ,
+                }],
+            })
+            .await;
+    }
+    async fn current(&self, router: &ProjectRouter, source: &str, name: &str, absent: &[&str]) {
+        let path = self.fixture.path("a", "dependency.php");
+        assert_members(router, &path, source, name, absent).await;
+        let result = items(router, &path, source).await;
+        let item = result
+            .into_iter()
+            .find(|item| has(std::slice::from_ref(item), name))
+            .unwrap();
+        let resolved = router.completion_resolve(item).await.unwrap();
+        assert!(
+            serde_json::to_string(&resolved.documentation)
+                .unwrap()
+                .contains(&format!("{name} docs"))
+        );
+        let tree = if name == "oldOnly" { "old" } else { "new" };
+        assert_definition(
+            router,
+            &path,
+            source,
+            "Service",
+            &self
+                .fixture
+                .path(
+                    "a",
+                    &format!("{}/fixture/dependency/{tree}/Service.php", self.vendor),
+                )
+                .canonicalize()
+                .unwrap(),
+        )
+        .await;
+        let definition = router
+            .goto_definition(GotoDefinitionParams {
+                text_document_position_params: TextDocumentPositionParams {
+                    text_document: TextDocumentIdentifier {
+                        uri: Url::from_file_path(&path).unwrap(),
+                    },
+                    position: position_of(source, "Service"),
+                },
+                work_done_progress_params: Default::default(),
+                partial_result_params: Default::default(),
+            })
+            .await
+            .unwrap();
+        let locations = definition_locations(definition);
+        assert_eq!(locations[0].range.start, Position::new(2, 0));
+    }
+}

+async fn composer_installed_refresh_default_vendor_create_and_delete() {
+    let value = InstalledRefresh::new("vendor", false);
+    let router = value.fixture.router().await;
+    let path = value.fixture.path("a", "dependency.php");
+    let source = open(&router, &path).await;
+    assert!(!has(&items(&router, &path, &source).await, "oldOnly"));
+    value.set("old");
+    value
+        .event(&router, &value.metadata(), FileChangeType::CREATED)
+        .await;
+    value
+        .current(&router, &source, "oldOnly", &["newOnly"])
+        .await;
+    fs::remove_file(value.metadata()).unwrap();
+    value
+        .event(&router, &value.metadata(), FileChangeType::DELETED)
+        .await;
+    let result = items(&router, &path, &source).await;
+    assert!(!has(&result, "oldOnly") && !has(&result, "newOnly"));
+    router.shutdown().await.unwrap();
+}

+#[tokio::test]
+async fn composer_installed_refresh_external_vendor_canonical_deletion_retires_source() {
+    let value = InstalledRefresh::new("../external dependencies", true);
+    // Real watchers can deliver the physical spelling, without the configured ../.
+    let physical_metadata = value.metadata().canonicalize().unwrap();
+    assert_ne!(physical_metadata, value.metadata());
+    let router = value.fixture.router().await;
+    let path = value.fixture.path("a", "dependency.php");
+    let source = open(&router, &path).await;
+    value
+        .current(&router, &source, "oldOnly", &["newOnly"])
+        .await;
+    let old_item = items(&router, &path, &source)
+        .await
+        .into_iter()
+        .find(|item| has(std::slice::from_ref(item), "oldOnly"))
+        .unwrap();
+    fs::remove_file(value.metadata()).unwrap();
+    assert!(!physical_metadata.exists());
+    value
+        .event(&router, &physical_metadata, FileChangeType::DELETED)
+        .await;
+    let result = items(&router, &path, &source).await;
+    assert!(
+        !has(&result, "oldOnly") && !has(&result, "newOnly"),
+        "removed metadata must retire dependency selection, even with a normalized event URI"
+    );
+    assert!(
+        router.completion_resolve(old_item).await.is_err(),
+        "physical metadata deletion must retire the prior resolve token"
+    );
+    assert_eq!(fs::read_to_string(&path).unwrap(), source);
+    router.shutdown().await.unwrap();
+}

+#[tokio::test]
+async fn composer_installed_refresh_symlink_vendor_physical_deletion_retires_source() {
+    let value = InstalledRefresh::new("vendor alias", true);
+    let vendor = value.fixture.path("a", "vendor alias");
+    let physical_vendor = value.fixture.path("a", "physical vendor");
+    fs::rename(&vendor, &physical_vendor).unwrap();
+    std::os::unix::fs::symlink(&physical_vendor, &vendor).unwrap();
+    let physical_metadata = value.metadata().canonicalize().unwrap();
+    assert_ne!(physical_metadata, value.metadata());
+    let router = value.fixture.router().await;
+    let path = value.fixture.path("a", "dependency.php");
+    let source = open(&router, &path).await;
+    // Definitions use the scanner's physical source identity here.
+    assert_members(&router, &path, &source, "oldOnly", &["newOnly"]).await;
+    let old_item = items(&router, &path, &source)
+        .await
+        .into_iter()
+        .find(|item| has(std::slice::from_ref(item), "oldOnly"))
+        .unwrap();
+    fs::remove_file(&physical_metadata).unwrap();
+    value
+        .event(&router, &physical_metadata, FileChangeType::DELETED)
+        .await;
+    let result = items(&router, &path, &source).await;
+    assert!(
+        !has(&result, "oldOnly") && !has(&result, "newOnly"),
+        "physical deletion through a configured vendor directory alias must retire dependencies"
+    );
+    assert!(router.completion_resolve(old_item).await.is_err());
+    assert_eq!(fs::read_to_string(&path).unwrap(), source);
+    router.shutdown().await.unwrap();

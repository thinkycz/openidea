+#[tokio::test]
+async fn composer_installed_refresh_custom_vendor_current_source_and_retired_resolve() {
+    let value = InstalledRefresh::new("dependencies with spaces", true);
+    let root_manifest = fs::read(value.fixture.path("a", "composer.json")).unwrap();
+    let root_lock = fs::read(value.fixture.path("a", "composer.lock")).unwrap();
+    let router = value.fixture.router().await;
+    let path = value.fixture.path("a", "dependency.php");
+    let source = open(&router, &path).await;
+    value
+        .current(&router, &source, "oldOnly", &["newOnly"])
+        .await;
+    let old_item = items(&router, &path, &source)
+        .await
+        .into_iter()
+        .find(|i| has(std::slice::from_ref(i), "oldOnly"))
+        .unwrap();
+    let bpath = value.fixture.path("b", "index.php");
+    let bsource = open(&router, &bpath).await;
+    assert_members(&router, &bpath, &bsource, "fromB", &["oldOnly", "newOnly"]).await;
+    // Retained unsaved sibling text must be replayed into its own fresh context.
+    let declaration = value.fixture.path("b", "src/Service.php");
+    let before = open(&router, &declaration).await;
+    replace(
+        &router,
+        &declaration,
+        2,
+        &before.replace("fromB", "fromBUnsaved"),
+    )
+    .await;
+    value.set("new");
+    value
+        .event(&router, &value.metadata(), FileChangeType::CHANGED)
+        .await;
+    value
+        .current(&router, &source, "newOnly", &["oldOnly"])
+        .await;
+    assert!(
+        router.completion_resolve(old_item).await.is_err(),
+        "retired graph token must refuse"
+    );
+    assert_members(
+        &router,
+        &bpath,
+        &bsource,
+        "fromBUnsaved",
+        &["fromB", "oldOnly", "newOnly"],
+    )
+    .await;
+    assert_eq!(
+        fs::read(value.fixture.path("a", "composer.json")).unwrap(),
+        root_manifest
+    );
+    assert_eq!(
+        fs::read(value.fixture.path("a", "composer.lock")).unwrap(),
+        root_lock
+    );
+    assert_eq!(fs::read_to_string(&path).unwrap(), source);
+    assert_eq!(fs::read_to_string(&declaration).unwrap(), before);
+    router.shutdown().await.unwrap();
+}

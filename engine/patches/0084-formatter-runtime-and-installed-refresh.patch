+#[cfg(unix)]
+mod selected_formatter_runtime_tests {
+    use super::*;
+    use crate::formatting::ResolvedTool;
+    use std::path::{Path, PathBuf};
+    use tower_lsp::lsp_types::{InitializeParams, Url};
+
+    fn executable(root: &Path, name: &str, source: &str) -> PathBuf {
+        use std::os::unix::fs::PermissionsExt;
+        let path = root.join(name);
+        std::fs::write(&path, source).unwrap();
+        std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o755)).unwrap();
+        path.canonicalize().unwrap()
+    }
+    fn php_quote(value: &Path) -> String {
+        format!(
+            "'{}'",
+            value
+                .to_str()
+                .unwrap()
+                .replace('\\', "\\\\")
+                .replace('\'', "\\'")
+        )
+    }
+    fn tool(root: &Path, kind: Tool, receipt: &Path) -> ResolvedTool {
+        let stdin = matches!(kind, Tool::Pint);
+        let source = format!(
+            "#!/usr/bin/env php\n<?php\n$stdin=stream_get_contents(STDIN); $file=end($argv); $input={input}; file_put_contents({receipt},json_encode(['php'=>PHP_BINARY,'cwd'=>getcwd(),'argv'=>array_slice($argv,1),'stdin'=>$stdin,'input'=>$input])); $output=str_replace('bad','good',$input); {output} exit({exit});\n",
+            input = if stdin {
+                "$stdin"
+            } else {
+                "file_get_contents($file)"
+            },
+            receipt = php_quote(receipt),
+            output = if stdin {
+                "echo $output;"
+            } else {
+                "file_put_contents($file,$output);"
+            },
+            exit = if matches!(kind, Tool::Phpcbf) { 1 } else { 0 },
+        );
+        ResolvedTool {
+            tool: kind,
+            path: executable(root, &format!("{} café tool", kind.name()), &source),
+        }
+    }
+    #[allow(deprecated)]
+    async fn backend(root: &Path, interpreter: &str) -> crate::Backend {
+        let backend = crate::Backend::new_test();
+        backend
+            .on_initialize(InitializeParams {
+                root_uri: Some(Url::from_directory_path(root).unwrap()),
+                initialization_options: Some(
+                    serde_json::json!({"phpRuntime":{"interpreter":interpreter}}),
+                ),
+                ..Default::default()
+            })
+            .await
+            .unwrap();
+        backend
+    }
+    fn receipt(path: &Path, php: &Path, root: &Path, input: &str) -> serde_json::Value {
+        let value: serde_json::Value =
+            serde_json::from_slice(&std::fs::read(path).unwrap()).unwrap();
+        assert_eq!(
+            Path::new(value["php"].as_str().unwrap())
+                .canonicalize()
+                .unwrap(),
+            php.canonicalize().unwrap()
+        );
+        assert_eq!(
+            Path::new(value["cwd"].as_str().unwrap())
+                .canonicalize()
+                .unwrap(),
+            root.canonicalize().unwrap()
+        );
+        assert_eq!(value["input"], input);
+        value
+    }
+    fn no_sibling_temps(root: &Path) {
+        assert!(!std::fs::read_dir(root).unwrap().any(|entry| {
+            entry
+                .unwrap()
+                .file_name()
+                .to_string_lossy()
+                .starts_with("phpantom-fmt-")
+        }));
+    }
+
+    #[tokio::test]
+    #[ignore = "Root supplies selected PHP83 and controlled PATH PHP82 for actual formatter receipts"]
+    async fn selected_formatter_runtime_backend_php_and_blade_receipts_preserve_cli_legacy() {
+        let selected = PathBuf::from(
+            std::env::var("PHP_WORKBENCH_TEST_PHP").expect("owned selected PHP required"),
+        );
+        let inherited = PathBuf::from(
+            std::env::var("PHP_WORKBENCH_TEST_PATH_PHP").expect("controlled PATH PHP required"),
+        );
+        assert_ne!(
+            selected.canonicalize().unwrap(),
+            inherited.canonicalize().unwrap()
+        );
+        let directory = tempfile::tempdir().unwrap();
+        let root = directory.path().canonicalize().unwrap();
+        let backend = backend(&root, selected.to_str().unwrap()).await;
+        let file = root.join("Driver café.php");
+        let input = "<?php\r\n// café 🐘 bad\r\n";
+        std::fs::write(&file, input).unwrap();
+        let output = input.replace("bad", "good");
+        let marker = root.join("receipt.json");
+        let cancel = AtomicBool::new(false);
+        for kind in Tool::ALL {
+            let tool = tool(&root, kind, &marker);
+            let strategy = FormattingStrategy::External(vec![tool]);
+            let formatted = backend
+                .format_content(&strategy, &file, input, &cancel)
+                .unwrap();
+            assert_eq!(formatted.as_deref(), Some(output.as_str()));
+            let actual = receipt(&marker, &selected, &root, input);
+            let args = actual["argv"].as_array().unwrap();
+            match kind {
+                Tool::Pint => assert_eq!(
+                    args,
+                    &vec![serde_json::json!(format!(
+                        "--stdin-filename={}",
+                        file.display()
+                    ))]
+                ),
+                Tool::PhpCsFixer | Tool::Phpcbf => {
+                    let path = Path::new(args.last().unwrap().as_str().unwrap());
+                    assert_eq!(path.parent().unwrap(), root);
+                    assert!(!path.exists(), "owned sibling temp must be removed");
+                    assert_ne!(path, file);
+                    let prefix: Vec<&str> = args[..args.len() - 1]
+                        .iter()
+                        .map(|value| value.as_str().unwrap())
+                        .collect();
+                    assert_eq!(
+                        prefix,
+                        if matches!(kind, Tool::PhpCsFixer) {
+                            vec!["fix", "--using-cache=no", "--quiet", "--no-interaction"]
+                        } else {
+                            vec!["--no-colors", "-q"]
+                        }
+                    );
+                }
+            }
+            assert_eq!(std::fs::read_to_string(&file).unwrap(), input);
+            no_sibling_temps(&root);
+            // Actual public API used by format_cli remains inherited, even after Backend selection.
+            let legacy = super::super::format_content(
+                &strategy,
+                input,
+                &file,
+                Some(&root),
+                &FormattingConfig::default(),
+                backend.php_version(),
+                &cancel,
+            )
+            .unwrap();
+            assert_eq!(legacy.as_deref(), Some(output.as_str()));
+            receipt(&marker, &inherited, &root, input);
+        }
+        let blade = root.join("View café.blade.php");
+        let markup = "<div>bad café 🐘</div>\r\n";
+        std::fs::write(&blade, markup).unwrap();
+        let strategy = crate::formatting::blade::BladeFormattingStrategy::Pint {
+            tool: tool(&root, Tool::Pint, &marker),
+            flag: true,
+        };
+        let formatted = backend
+            .format_blade_content(&strategy, &blade, markup, &Default::default(), &cancel)
+            .unwrap();
+        assert_eq!(
+            formatted.as_deref(),
+            Some(markup.replace("bad", "good").as_str())
+        );
+        let actual = receipt(&marker, &selected, &root, markup);
+        assert_eq!(
+            actual["argv"],
+            serde_json::json!([format!("--stdin-filename={}", blade.display()), "--blade"])
+        );
+        let legacy = crate::formatting::blade::format_blade_content(
+            &strategy,
+            markup,
+            &blade,
+            Some(&root),
+            &FormattingConfig::default(),
+            &Default::default(),
+            &cancel,
+        )
+        .unwrap();
+        assert_eq!(
+            legacy.as_deref(),
+            Some(markup.replace("bad", "good").as_str())
+        );
+        receipt(&marker, &inherited, &root, markup);
+        assert_eq!(std::fs::read_to_string(&blade).unwrap(), markup);
+        no_sibling_temps(&root);
+    }
+
+    #[tokio::test]
+    #[ignore = "Root supplies controlled PATH PHP for positive legacy preflight then invalid-selection refusal"]
+    async fn selected_formatter_runtime_invalid_refuses_without_php_execution_and_cleans_temps() {
+        let inherited = PathBuf::from(
+            std::env::var("PHP_WORKBENCH_TEST_PATH_PHP").expect("controlled PATH PHP required"),
+        );
+        let directory = tempfile::tempdir().unwrap();
+        let root = directory.path().canonicalize().unwrap();
+        let backend = backend(&root, "/owned/missing/selected/php").await;
+        let file = root.join("Driver.php");
+        let input = "<?php // bad café 🐘\r\n";
+        std::fs::write(&file, input).unwrap();
+        let marker = root.join("receipt.json");
+        let cancel = AtomicBool::new(false);
+        for kind in Tool::ALL {
+            let strategy = FormattingStrategy::External(vec![tool(&root, kind, &marker)]);
+            super::super::format_content(
+                &strategy,
+                input,
+                &file,
+                Some(&root),
+                &FormattingConfig::default(),
+                backend.php_version(),
+                &cancel,
+            )
+            .unwrap()
+            .unwrap();
+            receipt(&marker, &inherited, &root, input);
+            std::fs::remove_file(&marker).unwrap();
+            assert!(
+                backend
+                    .format_content(&strategy, &file, input, &cancel)
+                    .is_err()
+            );
+            assert!(
+                !marker.exists(),
+                "invalid selected PHP must not launch through PATH"
+            );
+            assert_eq!(std::fs::read_to_string(&file).unwrap(), input);
+            no_sibling_temps(&root);
+        }
+        let strategy = crate::formatting::blade::BladeFormattingStrategy::Pint {
+            tool: tool(&root, Tool::Pint, &marker),
+            flag: true,
+        };
+        assert!(
+            backend
+                .format_blade_content(
+                    &strategy,
+                    &file,
+                    "<div>bad</div>",
+                    &Default::default(),
+                    &cancel
+                )
+                .is_err()
+        );
+        assert!(!marker.exists());
+        no_sibling_temps(&root);
+    }
+
+    #[tokio::test]

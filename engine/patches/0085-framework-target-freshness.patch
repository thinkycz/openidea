+
+struct AttributeWire {
+    client: crate::common::lsp_transport::TransportClient,
+    pending: std::collections::VecDeque<serde_json::Value>,
+    next_id: i64,
+}
+impl AttributeWire {
+    async fn new(fixture: &Projects) -> Self {
+        let mut wire = Self {
+            client: crate::common::lsp_transport::serve(ProjectRouter::new),
+            pending: Default::default(),
+            next_id: 1,
+        };
+        wire.request("initialize",Some(serde_json::json!({
+            "rootUri":Url::from_directory_path(&fixture.root).unwrap(),
+            "workspaceFolders":[{"uri":Url::from_directory_path(&fixture.root).unwrap(),"name":"attribute-targets"}],
+            "capabilities":{}
+        }))).await;
+        wire.notify("initialized", serde_json::json!({})).await;
+        wire
+    }
+    async fn notify(&mut self, method: &str, params: serde_json::Value) {
+        self.client
+            .send(
+                "attribute wire notification",
+                serde_json::json!({"jsonrpc":"2.0","method":method,"params":params}),
+            )
+            .await;
+    }
+    async fn next_message(&mut self) -> serde_json::Value {
+        loop {
+            let message = self
+                .client
+                .read_until("next actual attribute wire frame", |_| true)
+                .await;
+            if let Some(id) = message
+                .get("id")
+                .filter(|_| message.get("method").is_some())
+            {
+                let result = if message["method"] == "workspace/configuration" {
+                    serde_json::Value::Array(vec![
+                        serde_json::Value::Null;
+                        message["params"]["items"]
+                            .as_array()
+                            .map_or(0, Vec::len)
+                    ])
+                } else {
+                    serde_json::Value::Null
+                };
+                self.client
+                    .send(
+                        "answer attribute server request",
+                        serde_json::json!({"jsonrpc":"2.0","id":id,"result":result}),
+                    )
+                    .await;
+            } else {
+                return message;
+            }
+        }
+    }
+    async fn request(
+        &mut self,
+        method: &str,
+        params: Option<serde_json::Value>,
+    ) -> serde_json::Value {
+        let id = self.next_id;
+        self.next_id += 1;
+        let mut request = serde_json::json!({"jsonrpc":"2.0","id":id,"method":method});
+        if let Some(params) = params {
+            request["params"] = params;
+        }
+        self.client.send("attribute wire request", request).await;
+        let response = tokio::time::timeout(std::time::Duration::from_secs(20), async {
+            loop {
+                let message = self.next_message().await;
+                if message.get("method").is_none() && message["id"] == id {
+                    return message;
+                }
+                self.pending.push_back(message);
+            }
+        })
+        .await
+        .expect("attribute RPC must finish without pulling diagnostics");
+        assert!(
+            response.get("error").is_none(),
+            "attribute RPC {method} failed: {response}"
+        );
+        response["result"].clone()
+    }
+    async fn first_complete(&mut self, uri: &Url, version: i32) -> serde_json::Value {
+        let matches = |message: &serde_json::Value| {
+            message["method"] == "textDocument/publishDiagnostics"
+                && message["params"]["uri"] == uri.as_str()
+                && message["params"]["version"] == version
+                && message["params"]["phpantomDiagnosticComplete"] == true
+        };
+        tokio::time::timeout(std::time::Duration::from_secs(20), async {
+            if let Some(index) = self.pending.iter().position(matches) {
+                return self.pending.remove(index).unwrap();
+            }
+            loop {
+                let message = self.next_message().await;
+                if matches(&message) {
+                    return message;
+                }
+                self.pending.push_back(message);
+            }
+        })
+        .await
+        .expect("first complete source-versioned attribute diagnostic publication")
+    }
+    /// Retire() has stopped old contexts and waits for this response before
+    /// constructing/replaying new ones. Exclude old frames queued before it.
+    async fn target_retirement_boundary(&mut self) -> serde_json::Value {
+        tokio::time::timeout(std::time::Duration::from_secs(20), async {
+            loop {
+                let message = self
+                    .client
+                    .read_until("actual target context retirement request", |_| true)
+                    .await;
+                if let Some(id) = message
+                    .get("id")
+                    .filter(|_| message.get("method").is_some())
+                {
+                    let retirement = message["method"] == "client/unregisterCapability";
+                    if retirement {
+                        assert!(
+                            message["params"]["unregisterations"]
+                                .as_array()
+                                .is_some_and(|items| items.iter().any(
+                                    |item| item["method"] == "workspace/didChangeWatchedFiles"
+                                )),
+                            "retirement must unregister an initialized project watcher: {message}"
+                        );
+                        // Clear ONLY at the observed causal boundary, never based
+                        // on a diagnostic's desired semantic value.
+                        self.pending.clear();
+                    }
+                    let result = if message["method"] == "workspace/configuration" {
+                        serde_json::Value::Array(vec![
+                            serde_json::Value::Null;
+                            message["params"]["items"]
+                                .as_array()
+                                .map_or(0, Vec::len)
+                        ])
+                    } else {
+                        serde_json::Value::Null
+                    };
+                    self.client
+                        .send(
+                            "answer target retirement or server request",
+                            serde_json::json!({"jsonrpc":"2.0","id":id,"result":result}),
+                        )
+                        .await;
+                    if retirement {
+                        return message;
+                    }
+                } else {
+                    self.pending.push_back(message);
+                }
+            }
+        })
+        .await
+        .expect("target-changing event must causally retire initialized contexts")
+    }
+    async fn open(&mut self, path: &Path) -> serde_json::Value {
+        let uri = Url::from_file_path(path).unwrap();
+        self.notify("textDocument/didOpen",serde_json::json!({"textDocument":{"uri":uri,"languageId":"php","version":1,"text":fs::read_to_string(path).unwrap()}})).await;
+        self.first_complete(&uri, 1).await
+    }
+    async fn change(&mut self, path: &Path, version: i32, text: &str) -> serde_json::Value {
+        let uri = Url::from_file_path(path).unwrap();
+        self.notify("textDocument/didChange",serde_json::json!({"textDocument":{"uri":uri,"version":version},"contentChanges":[{"text":text}]})).await;
+        self.first_complete(&uri, version).await
+    }
+    async fn close(mut self) {
+        self.request("shutdown", None).await;
+        self.client
+            .send(
+                "attribute wire exit",
+                serde_json::json!({"jsonrpc":"2.0","method":"exit"}),
+            )
+            .await;
+    }
+}
+fn attribute_wire_code(frame: &serde_json::Value, code: &str) -> Vec<serde_json::Value> {
+    frame["params"]["diagnostics"]
+        .as_array()
+        .expect("complete push diagnostic list")
+        .iter()
+        .filter(|item| item["code"] == code)
+        .cloned()
+        .collect()
+}
+async fn attribute_wire_legal_declaration(
+    wire: &mut AttributeWire,
+    fixture: &Projects,
+    project: &str,
+) {
+    let path = fixture.path(project, "attribute.php");
+    let params = TextDocumentPositionParams {
+        text_document: TextDocumentIdentifier {
+            uri: Url::from_file_path(&path).unwrap(),
+        },
+        position: position_after(
+            ATTRIBUTE_WIRE_SOURCE,
+            "new \\Illuminate\\Container\\Attributes\\BindW",
+        ),
+    };
+    let result = wire
+        .request(
+            "textDocument/definition",
+            Some(
+                serde_json::to_value(GotoDefinitionParams {
+                    text_document_position_params: params.clone(),
+                    work_done_progress_params: Default::default(),
+                    partial_result_params: Default::default(),
+                })
+                .unwrap(),
+            ),
+        )
+        .await;
+    let locations = definition_locations(
+        serde_json::from_value::<Option<GotoDefinitionResponse>>(result).unwrap(),
+    );
+    assert_eq!(
+        locations.len(),
+        1,
+        "legal BindWhen declaration must stay navigable: {locations:?}"
+    );
+    assert_eq!(
+        locations[0].uri,
+        Url::from_file_path(fixture.path(project, "src/BindWhen.php")).unwrap()
+    );
+    let result = wire
+        .request(
+            "textDocument/completion",
+            Some(
+                serde_json::to_value(CompletionParams {
+                    text_document_position: params,
+                    context: None,
+                    work_done_progress_params: Default::default(),
+                    partial_result_params: Default::default(),
+                })
+                .unwrap(),
+            ),
+        )
+        .await;
+    let items = match serde_json::from_value::<Option<CompletionResponse>>(result).unwrap() {
+        Some(CompletionResponse::Array(items)) => items,
+        Some(CompletionResponse::List(list)) => list.items,
+        None => Vec::new(),
+    };
+    assert!(
+        items.iter().any(|item| item.label.contains("BindWhen")),
+        "legal declaration must remain completable: {items:?}"
+    );
+}

@@ -0,0 +1,84 @@
+//! Target-independent attribute argument features collected from an already parsed AST.
+use crate::symbol_map::AttributeClosureKind;
+use mago_syntax::cst::*;
+use mago_syntax::walker::Walker;
+
+pub(super) fn collect(program: &Program<'_>) -> Vec<(u32, u32, AttributeClosureKind)> {
+    let mut spans = Vec::new();
+    Attributes.walk_program(program, &mut spans);
+    spans.sort_unstable();
+    spans.dedup();
+    spans
+}
+
+struct Attributes;
+impl<'ast, 'arena> Walker<'ast, 'arena, Vec<(u32, u32, AttributeClosureKind)>> for Attributes {
+    fn walk_in_attribute(
+        &self,
+        attribute: &'ast Attribute<'arena>,
+        spans: &mut Vec<(u32, u32, AttributeClosureKind)>,
+    ) {
+        if let Some(arguments) = &attribute.argument_list {
+            for argument in &arguments.arguments {
+                if let Some(value) = argument.value() {
+                    ArgumentClosures.walk_expression(value, spans);
+                }
+            }
+        }
+    }
+}
+
+/// Descend through the argument expression (including arrays/new arguments),
+/// stopping at function/class body boundaries. A closure nested in an argument
+/// closure's body is ordinary function-body syntax, not another attribute argument.
+struct ArgumentClosures;
+impl<'ast, 'arena> Walker<'ast, 'arena, Vec<(u32, u32, AttributeClosureKind)>>
+    for ArgumentClosures
+{
+    fn walk_closure(
+        &self,
+        closure: &'ast Closure<'arena>,
+        spans: &mut Vec<(u32, u32, AttributeClosureKind)>,
+    ) {
+        let start = closure
+            .r#static
+            .as_ref()
+            .map_or(closure.function.span.start.offset, |keyword| {
+                keyword.span.start.offset
+            });
+        let kind = if closure.r#static.is_none() {
+            AttributeClosureKind::NonStatic
+        } else if closure.use_clause.is_some() {
+            AttributeClosureKind::Capturing
+        } else {
+            AttributeClosureKind::StaticNonCapturing
+        };
+        spans.push((start, closure.function.span.end.offset, kind));
+    }
+    fn walk_arrow_function(
+        &self,
+        closure: &'ast ArrowFunction<'arena>,
+        spans: &mut Vec<(u32, u32, AttributeClosureKind)>,
+    ) {
+        let start = closure
+            .r#static
+            .as_ref()
+            .map_or(closure.r#fn.span.start.offset, |keyword| {
+                keyword.span.start.offset
+            });
+        spans.push((
+            start,
+            closure.r#fn.span.end.offset,
+            AttributeClosureKind::Arrow,
+        ));
+    }
+    fn walk_anonymous_class(
+        &self,
+        class: &'ast AnonymousClass<'arena>,
+        spans: &mut Vec<(u32, u32, AttributeClosureKind)>,
+    ) {
+        if let Some(arguments) = &class.argument_list {
+            self.walk_partial_argument_list(arguments, spans);
+        }
+    }
+}

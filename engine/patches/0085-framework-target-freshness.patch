+/// Classify the consuming project from declared requirements or saved installed
+/// dependencies. A wrapper can pull Illuminate in transitively without naming it
+/// in the root manifest. Installed version strings are not compatibility claims.
+/// Keep this separate from application classification and analyzer policy.
+pub(crate) fn is_laravel_project_with_installed(root: &Path, package: &ComposerPackage) -> bool {
+    is_laravel_project(package)
+        || read_installed_packages(root, &get_vendor_dir(package)).is_some_and(|installed| {
+            installed.packages.iter().any(|entry| {
+                entry
+                    .get("name")
+                    .and_then(serde_json::Value::as_str)
+                    .is_some_and(|name| {
+                        name.eq_ignore_ascii_case("laravel/framework")
+                            || name.to_ascii_lowercase().starts_with("illuminate/")
+                    })
+            })
+        })
+}

+// Context retirement is the causal transport boundary for a saved-target rebuild.
+// Publications already queued before this request still belong to the previous profile.
+async fn target_reload_retirement_barrier(
+    client: &mut crate::common::lsp_transport::TransportClient,
+) {
+    tokio::time::timeout(std::time::Duration::from_secs(20), async {
+        loop {
+            let message = client
+                .read_until("target context retirement boundary", |_| true)
+                .await;
+            if let Some(id) = message
+                .get("id")
+                .filter(|_| message.get("method").is_some())
+            {
+                let retired = message["method"] == "client/unregisterCapability";
+                let result = if message["method"] == "workspace/configuration" {
+                    serde_json::Value::Array(vec![
+                        serde_json::Value::Null;
+                        message["params"]["items"]
+                            .as_array()
+                            .map_or(0, Vec::len)
+                    ])
+                } else {
+                    serde_json::Value::Null
+                };
+                client
+                    .send(
+                        "answer retiring context request",
+                        serde_json::json!({"jsonrpc":"2.0","id":id,"result":result}),
+                    )
+                    .await;
+                if retired {
+                    return;
+                }
+            }
+        }
+    })
+    .await
+    .expect("changed effective target must retire the previous project context")
+}
+
+async fn target_reload_push_frame(
+    client: &mut crate::common::lsp_transport::TransportClient,
+    uri: &Url,
+    missing: bool,
+) -> serde_json::Value {
+    tokio::time::timeout(std::time::Duration::from_secs(20), async {
+        loop {
+            let message = client
+                .read_until("first complete versioned target diagnostics", |message| {
+                    if message.get("id").is_some() && message.get("method").is_some() {
+                        return true;
+                    }
+                    message["method"] == "textDocument/publishDiagnostics"
+                        && message["params"]["uri"] == uri.as_str()
+                        && message["params"]["version"] == 2
+                        && message["params"]["phpantomDiagnosticComplete"] == true
+                })
+                .await;
+            if let Some(id) = message
+                .get("id")
+                .filter(|_| message.get("method").is_some())
+            {
+                let result = if message["method"] == "workspace/configuration" {
+                    serde_json::Value::Array(vec![
+                        serde_json::Value::Null;
+                        message["params"]["items"]
+                            .as_array()
+                            .map_or(0, Vec::len)
+                    ])
+                } else {
+                    serde_json::Value::Null
+                };
+                client
+                    .send(
+                        "answer server request",
+                        serde_json::json!({"jsonrpc":"2.0","id":id,"result":result}),
+                    )
+                    .await;
+                continue;
+            }
+            let diagnostics = message["params"]["diagnostics"]
+                .as_array()
+                .expect("complete native diagnostic list");
+            assert!(
+                diagnostics.iter().any(|d| d["message"]
+                    .as_str()
+                    .is_some_and(|m| m.contains("PushReloadUnsavedMarker"))),
+                "first complete result must keep unsaved-only source: {message}"
+            );
+            let actual_missing = diagnostics.iter().any(|d| {
+                d["code"] == "unknown_function"
+                    && d["message"]
+                        .as_str()
+                        .is_some_and(|m| m.contains("array_find"))
+            });
+            assert_eq!(
+                actual_missing, missing,
+                "first complete result must use current target, without semantic retries: {message}"
+            );
+            return message;
+        }
+    })
+    .await
+    .expect("saved target edit must push current unsaved source diagnostics without reopening")
+}

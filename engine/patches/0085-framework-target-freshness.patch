+        let replacement = format!("true{}", " ".repeat(expression.len() - 4));
+        let edited = source.replace(expression, &replacement);
+        assert_eq!(edited.len(), source.len());
+        assert!(
+            collect(&backend, &edited).is_empty(),
+            "stale same-length spans cannot diagnose different source"
+        );
+        backend.update_ast("file:///owned/attribute.php", &edited);
+        assert!(collect(&backend, &edited).is_empty());
+    }
+}

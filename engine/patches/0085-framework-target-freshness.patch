index 0000000..3e88659
--- /dev/null
+++ b/src/diagnostics/retire_fence_tests.rs
@@ -0,0 +1,193 @@
+//! Exercise actual ClientSocket backpressure without a test-only production API.
+use std::future::{Future, poll_fn};
+use std::pin::Pin;
+use std::sync::Arc;
+use std::task::Poll;
+use std::time::Duration;
+
+use tokio::io::{AsyncReadExt, AsyncWriteExt, DuplexStream};
+use tower_lsp::lsp_types::{Diagnostic, Unregistration};
+use tower_lsp::{LanguageServer, LspService, Server};
+
+use crate::Backend;
+
+async fn write_frame(stream: &mut DuplexStream, value: serde_json::Value) {
+    let bytes = serde_json::to_vec(&value).unwrap();
+    let header = format!("Content-Length: {}\r\n\r\n", bytes.len());
+    stream.write_all(header.as_bytes()).await.unwrap();
+    stream.write_all(&bytes).await.unwrap();
+}
+async fn read_frame(stream: &mut DuplexStream) -> serde_json::Value {
+    let mut header = Vec::new();
+    while !header.ends_with(b"\r\n\r\n") {
+        header.push(
+            stream
+                .read_u8()
+                .await
+                .expect("actual LSP output remains open"),
+        );
+        assert!(header.len() < 4096, "bounded LSP frame header");
+    }
+    let header = std::str::from_utf8(&header).unwrap();
+    let len: usize = header
+        .lines()
+        .find_map(|line| line.strip_prefix("Content-Length: "))
+        .unwrap()
+        .parse()
+        .unwrap();
+    let mut body = vec![0; len];
+    stream.read_exact(&mut body).await.unwrap();
+    serde_json::from_slice(&body).unwrap()
+}
+async fn poll_once<F: Future + ?Sized>(mut future: Pin<&mut F>) -> Poll<F::Output> {
+    poll_fn(|cx| Poll::Ready(future.as_mut().poll(cx))).await
+}
+
+fn publish(
+    backend: Arc<Backend>,
+    kind: u8,
+    uri: String,
+) -> Pin<Box<dyn Future<Output = ()> + Send>> {
+    Box::pin(async move {
+        match kind {
+            0 => {
+                backend.assemble_and_push(&uri).await;
+            }
+            1 => {
+                backend.clear_diagnostics_for_file(&uri).await;
+            }
+            2 => {
+                backend.flush_workspace_diag_updates(vec![uri]).await;
+            }
+            _ => unreachable!(),
+        }
+    })
+}
+
+async fn actual_blocked_send_is_drained_before_shutdown_and_retirement_request(kind: u8) {
+    let (service, socket) = LspService::build(Backend::new).finish();
+    // This is a real shallow worker clone, with the same Client, flags and
+    // diagnostic state as the service, not a replacement fake transport.
+    let backend = Arc::new(service.inner().clone_for_diagnostic_worker());
+    let retire_backend = Arc::new(backend.clone_for_diagnostic_worker());
+    let (mut client, server) = tokio::io::duplex(1 << 16);
+    let (input, output) = tokio::io::split(server);
+    let mut driver = Box::pin(Server::new(input, output, socket).serve(service));
+    write_frame(&mut client,serde_json::json!({"jsonrpc":"2.0","id":1,"method":"initialize","params":{"capabilities":{}}})).await;
+    let initialized=tokio::time::timeout(Duration::from_secs(10),async {
+        tokio::select! {
+            _=&mut driver=>panic!("actual server terminated during initialize"),
+            response=async { loop { let frame=read_frame(&mut client).await; if frame["id"]==1 && frame.get("method").is_none() {return frame;} } }=>response,
+        }
+    }).await.expect("actual transport initialize");
+    assert_eq!(initialized["id"], 1);
+    assert!(initialized.get("error").is_none());
+    // Do not send initialized: no background workers are needed to exercise
+    // these existing send methods, and none can add unrelated publications.
+    // Stop polling the driver so its actual bounded ClientSocket cannot drain.
+    let mut blocked = None;
+    for number in 0..64 {
+        let uri = format!("file:///owned/retire-send-{kind}-{number}.php");
+        let diagnostic = Diagnostic {
+            message: format!("owned send {number}"),
+            ..Diagnostic::default()
+        };
+        backend
+            .diag
+            .last_fast
+            .lock()
+            .insert(uri.clone(), vec![diagnostic.clone()]);
+        backend
+            .diag
+            .workspace_diags
+            .lock()
+            .set_native(&uri, vec![diagnostic]);
+        let mut future = publish(backend.clone(), kind, uri.clone());
+        match poll_once(future.as_mut()).await {
+            Poll::Ready(()) => {}
+            Poll::Pending => {
+                blocked = Some((uri, future));
+                break;
+            }
+        }
+    }
+    let (blocked_uri, blocked_send) = blocked
+        .expect("fixture must reach ACTUAL ClientSocket backpressure before asserting retirement");
+    let mut retiring = Box::pin(async move {
+        retire_backend.shutdown().await.unwrap();
+    });
+    assert!(
+        poll_once(retiring.as_mut()).await.is_pending(),
+        "shutdown must wait for an actual accepted diagnostic send blocked on transport (kind{kind})"
+    );
+    // Resume the real driver; no artificial gate is released by the test.
+    let driver = tokio::spawn(driver);
+    tokio::time::timeout(Duration::from_secs(10), async {
+        tokio::join!(blocked_send, retiring);
+    })
+    .await
+    .expect("transport draining releases accepted send and shutdown");
+    let publisher_client = backend.client.as_ref().unwrap().clone();
+    let mut retirement = Box::pin(async move {
+        publisher_client
+            .unregister_capability(vec![Unregistration {
+                id: "owned-retirement".into(),
+                method: "workspace/didChangeWatchedFiles".into(),
+            }])
+            .await
+            .unwrap();
+    });
+    assert!(
+        poll_once(retirement.as_mut()).await.is_pending(),
+        "real unregister awaits its client acknowledgement"
+    );
+    let mut saw_blocked_send = false;
+    let marker = tokio::time::timeout(Duration::from_secs(10), async {
+        loop {
+            let frame = read_frame(&mut client).await;
+            if frame["method"] == "textDocument/publishDiagnostics"
+                && frame["params"]["uri"] == blocked_uri
+            {
+                saw_blocked_send = true;
+            }
+            if frame["method"] == "client/unregisterCapability" {
+                return frame;
+            }
+        }
+    })
+    .await
+    .expect("actual diagnostic frames and retirement request");
+    assert!(
+        saw_blocked_send,
+        "accepted blocked send must appear BEFORE the retirement marker"
+    );
+    write_frame(
+        &mut client,
+        serde_json::json!({"jsonrpc":"2.0","id":marker["id"],"result":null}),
+    )
+    .await;
+    tokio::time::timeout(Duration::from_secs(10), retirement)
+        .await
+        .expect("retirement response drains");
+    assert!(
+        !backend
+            .assemble_and_push("file:///owned/post-retirement.php")
+            .await,
+        "worker clone sees shutdown and refuses later admission"
+    );
+    driver.abort();
+    let _ = driver.await;
+}
+
+#[tokio::test]
+async fn diagnostic_retire_fence_waits_for_actual_assembled_push_enqueue() {
+    actual_blocked_send_is_drained_before_shutdown_and_retirement_request(0).await;
+}
+#[tokio::test]
+async fn diagnostic_retire_fence_waits_for_actual_did_close_clear_enqueue() {
+    actual_blocked_send_is_drained_before_shutdown_and_retirement_request(1).await;
+}
+#[tokio::test]
+async fn diagnostic_retire_fence_waits_for_actual_workspace_push_enqueue() {
+    actual_blocked_send_is_drained_before_shutdown_and_retirement_request(2).await;
+}

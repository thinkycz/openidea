+// Public feature gates use source-versioned COMPLETE push publications, not provisional pull caches.
+const ATTRIBUTE_WIRE_SOURCE: &str = "<?php\n// café 🐘\nuse Illuminate\\Container\\Attributes\\BindWhen as OwnedGate;\n/* café 🐘 */ #[OwnedGate(Concrete::class, static function () { return true; })]\nclass Guarded {}\nclass Concrete {}\n$legal = new \\Illuminate\\Container\\Attributes\\BindWhen(Concrete::class, static function () { return true; });\n";
+const ATTRIBUTE_WIRE_DECLARATION: &str = "<?php\nnamespace Illuminate\\Container\\Attributes;\n#[\\Attribute(\\Attribute::TARGET_CLASS | \\Attribute::IS_REPEATABLE)]\nclass BindWhen { public function __construct(public string $concrete, public \\Closure $condition) {} }\n";
+
+fn attribute_wire_config(version: &str) -> String {
+    format!(
+        "[php]\nversion='{version}'\n[indexing]\nstrategy='composer'\n[phpstan]\ncommand=''\n[phpcs]\ncommand=''\n[phpmd]\ncommand=''\n[mago]\ncommand=''\n"
+    )
+}
+fn attribute_wire_fixture(a: &str, b: &str) -> Projects {
+    let fixture = Projects::new();
+    for (project, version) in [("a", a), ("b", b)] {
+        fixture.write(
+            &format!("apps/{project}/.phpantom.toml"),
+            &attribute_wire_config(version),
+        );
+        fixture.write(
+            &format!("apps/{project}/src/BindWhen.php"),
+            ATTRIBUTE_WIRE_DECLARATION,

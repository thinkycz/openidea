+/// The directory holding the installed framework's default configuration.
+/// Installed metadata is authoritative when present. With no metadata, keep
+/// the conventional configured-vendor layout; never search guessed ancestors.
+fn framework_config_dir(root: &std::path::Path) -> Option<std::path::PathBuf> {
+    let vendor = crate::composer::read_composer_package(root)
+        .as_ref()
+        .map(crate::composer::get_vendor_dir)
+        .unwrap_or_else(|| "vendor".to_string());
+    let vendor_root = root.join(&vendor);
+    let package_root = match crate::composer::read_installed_packages(root, &vendor) {
+        Some(installed) => {
+            let mut frameworks = installed.packages.iter().filter(|entry| {
+                entry
+                    .get("name")
+                    .and_then(serde_json::Value::as_str)
+                    .is_some_and(|name| name.eq_ignore_ascii_case("laravel/framework"))
+            });
+            let framework = frameworks.next()?;
+            // Ambiguous records cannot identify one authoritative installed source.
+            if frameworks.next().is_some() {
+                return None;
+            }
+            match framework.get("install-path") {
+                Some(value) => {
+                    let path = value.as_str().filter(|path| !path.is_empty())?;
+                    installed.composer_dir.join(path)
+                }
+                // Composer 1 omits install-path and uses vendor/<package name>.
+                None => vendor_root.join("laravel/framework"),
+            }
+        }
+        None => {
+            // An unreadable or otherwise unusable existing metadata input must
+            // not silently select a potentially stale conventional directory.
+            let missing = matches!(std::fs::symlink_metadata(vendor_root.join("composer/installed.json")),
+                Err(error) if error.kind() == std::io::ErrorKind::NotFound);
+            if !missing {
+                return None;
+            }
+            vendor_root.join("laravel/framework")
+        }
+    };
+    let config = package_root.join("config");
+    config.is_dir().then_some(config)
 }
 

+    assert!(retry);
+    assert!(seen.is_empty());
+    assert_eq!(
+        f.target().await.php_version,
+        "8.5",
+        "fresh startup uses the resolved prepared fallback target"
+    );
+    assert!(!f.apply(&mut seen).await);
+    assert_eq!(
+        f.target().await.php_version,
+        "8.3",
+        "later Composer bytes remain pending despite unchanged global bytes"
+    );
+    f.router.shutdown().await.unwrap();
+}
+
+#[tokio::test]
+async fn global_supervisor_starts_when_rootless_transport_adds_first_folder() {
+    let dir = tempfile::tempdir().unwrap();
+    let root = dir.path().canonicalize().unwrap().join("added-project");
+    std::fs::create_dir_all(&root).unwrap();
+    std::fs::write(
+        root.join("composer.json"),
+        r#"{"name":"owned/added","require":{"php":"^8.2"}}"#,
+    )
+    .unwrap();
+    let global = dir.path().join("owned-global.toml");
+    std::fs::write(&global, "[php]\nversion='8.3'\n").unwrap();
+    let router = ProjectRouter::new_test_with_full_stubs();
+    *router.state.test_global_path.lock() = Some(global.clone());
+    router
+        .initialize(InitializeParams::default())
+        .await
+        .unwrap();
+    router.initialize_all().await;
+    assert!(router.state.global_task.lock().is_none());
+    router
+        .change_workspace_folders(DidChangeWorkspaceFoldersParams {
+            event: WorkspaceFoldersChangeEvent {
+                added: vec![WorkspaceFolder {
+                    uri: Url::from_directory_path(&root).unwrap(),
+                    name: "added-project".into(),
+                }],
+                removed: vec![],
+            },
+        })
+        .await;
+    assert!(router.state.global_task.lock().is_some());
+    // The first iteration is autonomous. No request initiates target repair.
+    std::fs::write(&global, "[php]\nversion='8.5'\n").unwrap();
+    tokio::time::timeout(Duration::from_secs(10), async {
+        loop {
+            let applied = router
+                .state
+                .contexts
+                .read()
+                .iter()
+                .filter(|c| c.root.as_ref() == Some(&root))
+                .find_map(|c| c.backend.workspace.active_php_target.read().clone());
+            if applied.is_some_and(|target| target.php_version == "8.5") {
+                break;
+            }
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .expect("adding first folder starts autonomous global observation");
+    router.shutdown().await.unwrap();
+}
+
+#[tokio::test]
+async fn global_supervisor_malformed_sibling_preserves_applied_composer_fallback() {
+    let f = Fixture::new_detailed("# initial\n", "[php]\nversion='8.2'\n", true, "").await;
+    let sibling = f.root.join("sibling");
+    let uri = Url::from_file_path(sibling.join("caller.php")).unwrap();
+    let target = || ProjectTargetQuery {
+        uri: Some(uri.clone()),
+    };
+    assert_eq!(
+        f.router
+            .workbench_active_target(target())
+            .await
+            .unwrap()
+            .php_version,
+        "8.3"
+    );
+    let mut seen = Inputs::new();
+    f.apply(&mut seen).await;
+    std::fs::write(sibling.join(".phpantom.toml"), "[php\n").unwrap();
+    for composer in [r#"{"require":{"php":"^8.4"}}"#, "{invalid-json"] {
+        std::fs::write(sibling.join("composer.json"), composer).unwrap();
+        std::fs::write(
+            &f.global,
+            format!(
+                "# global metadata generation {}\n[php]\nextensions=['date']\n",
+                composer.len()
+            ),
+        )
+        .unwrap();
+        f.apply(&mut seen).await;
+        assert_eq!(
+            f.router
+                .workbench_active_target(target())
+                .await
+                .unwrap()
+                .php_version,
+            "8.3",
+            "invalid sibling config preserves its applied fallback, not a re-resolved old Config"
+        );
+    }
+    // Deletion is a successful effective-config load. Its current valid
+    // Composer fallback must win rather than importing last-good settings.
+    std::fs::remove_file(sibling.join(".phpantom.toml")).unwrap();
+    std::fs::write(
+        sibling.join("composer.json"),
+        r#"{"require":{"php":"^8.4"}}"#,
+    )
+    .unwrap();
+    std::fs::write(
+        &f.global,
+        "# deletion generation\n[php]\nextensions=['date']\n",
+    )
+    .unwrap();
+    f.apply(&mut seen).await;
+    assert_eq!(
+        f.router
+            .workbench_active_target(target())
+            .await
+            .unwrap()
+            .php_version,
+        "8.4"
+    );
+    f.router.shutdown().await.unwrap();
+}
diff --git a/src/project_router_global_served_owner_tests.rs b/src/project_router_global_served_owner_tests.rs
new file mode 100644
index 0000000..bab0cbe
--- /dev/null
+++ b/src/project_router_global_served_owner_tests.rs
@@ -0,0 +1,410 @@
+//! Test-only removable service owner; the real framed Server/ClientSocket stays
+//! alive so an already issued unregister reply can arrive after owner Drop.
+use super::*;
+use std::future::Future;
+use std::pin::Pin;
+use std::sync::Weak;
+use std::task::{Context, Poll};
+use std::time::Duration;
+use tokio::io::{AsyncReadExt, AsyncWriteExt, DuplexStream, ReadHalf, WriteHalf};
+use tower::Service;
+use tower_lsp::jsonrpc::{Request, Response};
+use tower_lsp::{ExitedError, LspService, Server};
+
+// Dev-only `tower = "0.4"` is needed to name the trait implemented by LspService.
+// No product API, scheduler or dependency behavior changes are needed.
+type Slot = Arc<parking_lot::Mutex<Option<LspService<ProjectRouter>>>>;
+struct RemovableOwner(Slot);
+impl Service<Request> for RemovableOwner {
+    type Response = Option<Response>;
+    type Error = ExitedError;
+    type Future =
+        Pin<Box<dyn Future<Output = std::result::Result<Self::Response, Self::Error>> + Send>>;
+    fn poll_ready(&mut self, cx: &mut Context<'_>) -> Poll<std::result::Result<(), Self::Error>> {
+        match self.0.lock().as_mut() {
+            Some(service) => service.poll_ready(cx),
+            None => Poll::Ready(Ok(())),
+        }
+    }
+    fn call(&mut self, request: Request) -> Self::Future {
+        if let Some(service) = self.0.lock().as_mut() {
+            return service.call(request);
+        }
+        // This one test-only request proves the framing/response pump survived
+        // late delivery after its real language-service owner was removed.
+        let response = request.id().cloned().map(|id| {
+            if request.method() == "test/ownerGoneTransportProbe" {
+                Response::from_ok(id, serde_json::json!(17))
+            } else {
+                Response::from_error(id, Error::method_not_found())
+            }
+        });
+        Box::pin(async move { Ok(response) })
+    }
+}
+
+struct Wire {
+    _dir: tempfile::TempDir,
+    root: PathBuf,
+    global: PathBuf,
+    slot: Slot,
+    core: Weak<RouterState>,
+    sources: Weak<crate::source_authority::SourceAuthority>,
+    read: ReadHalf<DuplexStream>,
+    write: WriteHalf<DuplexStream>,
+    buffer: Vec<u8>,
+    server: tokio::task::JoinHandle<()>,
+    next_id: i64,
+    registrations: Vec<Value>,
+}
+impl Wire {
+    async fn new() -> Self {
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path().canonicalize().unwrap().join("project");
+        std::fs::create_dir_all(&root).unwrap();
+        std::fs::write(
+            root.join("composer.json"),
+            r#"{"name":"owned/lifecycle","require":{"php":"^8.2"}}"#,
+        )
+        .unwrap();
+        let global = dir.path().join("owned-global.toml");
+        std::fs::write(&global, Self::config("8.3")).unwrap();
+        let (service, socket) = LspService::build(|client| {
+            let router = ProjectRouter::new(client);
+            *router.state.test_global_path.lock() = Some(global.clone());
+            router
+        })
+        .custom_method(
+            "phpWorkbench/activeTarget",
+            ProjectRouter::workbench_active_target,
+        )
+        .finish();
+        let core = Arc::downgrade(&service.inner().state);
+        let sources = Arc::downgrade(&service.inner().state.sources);
+        let slot = Arc::new(parking_lot::Mutex::new(Some(service)));
+        let (client, server) = tokio::io::duplex(1 << 16);
+        let (server_read, server_write) = tokio::io::split(server);
+        let task = tokio::spawn(
+            Server::new(server_read, server_write, socket)
+                .concurrency_level(crate::LSP_CONCURRENCY)
+                .serve(RemovableOwner(Arc::clone(&slot))),
+        );
+        let (read, write) = tokio::io::split(client);
+        let mut wire = Self {
+            _dir: dir,
+            root,
+            global,
+            slot,
+            core,
+            sources,
+            read,
+            write,
+            buffer: Vec::new(),
+            server: task,
+            next_id: 1,
+            registrations: Vec::new(),
+        };
+        wire.request("initialize", serde_json::json!({
+            "rootUri": Url::from_directory_path(&wire.root).unwrap(),
+            "workspaceFolders": [{"uri":Url::from_directory_path(&wire.root).unwrap(),"name":"owned-lifecycle"}],
+            "capabilities": {"workspace":{"didChangeWatchedFiles":{"dynamicRegistration":true}}}
+        })).await;
+        wire.send(serde_json::json!({"jsonrpc":"2.0","method":"initialized","params":{}}))
+            .await;
+        let uri = Url::from_file_path(wire.root.join("caller.php")).unwrap();
+        let target = wire
+            .request("phpWorkbench/activeTarget", serde_json::json!({"uri":uri}))
+            .await;
+        assert_eq!(target["php_version"], "8.3");
+        assert!(
+            wire.registrations
+                .iter()
+                .any(
+                    |message| message["params"]["registrations"]
+                        .as_array()
+                        .is_some_and(|items| items
+                            .iter()
+                            .any(|item| item["method"] == "workspace/didChangeWatchedFiles"))
+                ),
+            "real initialization dynamically registered project watchers"
+        );
+        wire
+    }
+    fn config(version: &str) -> String {
+        format!(
+            "[php]\nversion='{version}'\n[indexing]\nstrategy='composer'\n[phpstan]\ncommand=''\n[phpcs]\ncommand=''\n[phpmd]\ncommand=''\n[mago]\ncommand=''\n"
+        )
+    }
+    async fn send(&mut self, message: Value) {
+        let body = serde_json::to_vec(&message).unwrap();
+        self.write
+            .write_all(format!("Content-Length: {}\r\n\r\n", body.len()).as_bytes())
+            .await
+            .unwrap();
+        self.write.write_all(&body).await.unwrap();
+        self.write.flush().await.unwrap();
+    }
+    fn parsed(&mut self) -> Option<Value> {
+        let header_end = self
+            .buffer
+            .windows(4)
+            .position(|window| window == b"\r\n\r\n")?;
+        let header = std::str::from_utf8(&self.buffer[..header_end]).unwrap();
+        let length: usize = header
+            .lines()
+            .find_map(|line| line.strip_prefix("Content-Length: "))
+            .unwrap()
+            .parse()
+            .unwrap();
+        let end = header_end + 4 + length;
+        if self.buffer.len() < end {
+            return None;
+        }
+        let message = serde_json::from_slice(&self.buffer[header_end + 4..end]).unwrap();
+        self.buffer.drain(..end);
+        Some(message)
+    }
+    async fn next(&mut self) -> Value {
+        tokio::time::timeout(Duration::from_secs(25), async {
+            loop {
+                if let Some(message) = self.parsed() {
+                    return message;
+                }
+                let mut chunk = [0u8; 4096];
+                tokio::select! {
+                    result = self.read.read(&mut chunk) => {
+                        let count = result.expect("read actual framed server");
+                        assert!(count > 0, "server transport closed");
+                        self.buffer.extend_from_slice(&chunk[..count]);
+                    }
+                    result = &mut self.server => panic!("served transport ended: {result:?}"),
+                }
+            }
+        })
+        .await
+        .expect("bounded actual framed server response")
+    }
+    async fn answer(&mut self, message: Value) {
+        if message["method"] == "client/registerCapability" {
+            self.registrations.push(message.clone());
+        }
+        if let Some(id) = message
+            .get("id")
+            .filter(|_| message.get("method").is_some())
+        {
+            let result = if message["method"] == "workspace/configuration" {
+                Value::Array(vec![
+                    Value::Null;
+                    message["params"]["items"]
+                        .as_array()
+                        .map_or(0, Vec::len)
+                ])
+            } else {
+                Value::Null
+            };
+            self.send(serde_json::json!({"jsonrpc":"2.0","id":id,"result":result}))
+                .await;
+        }
+    }
+    async fn request(&mut self, method: &str, params: Value) -> Value {
+        let id = self.next_id;
+        self.next_id += 1;
+        let mut frame = serde_json::json!({"jsonrpc":"2.0","id":id,"method":method});
+        // Unit-parameter standard methods such as shutdown must omit params;
+        // JSON null is not equivalent for the selected Tower-LSP decoder.
+        if !params.is_null() {
+            frame["params"] = params;
+        }
+        self.send(frame).await;
+        tokio::time::timeout(Duration::from_secs(25), async {
+            loop {
+                let message = self.next().await;
+                if message.get("method").is_none() && message["id"] == id {
+                    assert!(
+                        message.get("error").is_none(),
+                        "RPC {method} failed: {message}"
+                    );
+                    return message["result"].clone();
+                }
+                self.answer(message).await;
+            }
+        })
+        .await
+        .expect("overall RPC deadline independent of irrelevant frame traffic")
+    }
+    async fn hold_autonomous_retirement(&mut self) -> Value {
+        std::fs::write(&self.global, Self::config("8.5")).unwrap();
+        tokio::time::timeout(Duration::from_secs(25), async {
+            loop {
+                let message = self.next().await;
+                if message["method"] == "client/unregisterCapability" {
+                    assert!(
+                        message["params"]["unregisterations"]
+                            .as_array()
+                            .is_some_and(|items| items
+                                .iter()
+                                .any(|item| item["method"] == "workspace/didChangeWatchedFiles"))
+                    );
+                    // Return WITHOUT responding: the real supervisor is now blocked
+                    // in Client::unregister_capability over the real Pending map.
+                    return message;
+                }
+                self.answer(message).await;
+            }
+        })
+        .await
+        .expect("overall autonomous retirement deadline")
+    }
+    fn drop_actual_owner(&self) {
+        drop(self.slot.lock().take().expect("one real service owner"));
+    }
+    async fn stop(mut self) {
+        let has_owner = self.slot.lock().is_some();
+        if has_owner {
+            self.request("shutdown", Value::Null).await;
+        }
+        self.drop_if_present();
+        self.server.abort();
+        let result = (&mut self.server).await;
+        assert!(
+            result.is_ok() || result.as_ref().is_err_and(|error| error.is_cancelled()),
+            "server panicked during cleanup: {result:?}"
+        );
+    }
+    fn drop_if_present(&self) {
+        drop(self.slot.lock().take());
+    }
+}
+impl Drop for Wire {
+    fn drop(&mut self) {
+        self.drop_if_present();
+        self.server.abort();
+    }
+}
+
+async fn served_owner_scenario() {
+    let mut wire = Wire::new().await;
+    let source = wire.root.join("caller.php");
+    let saved = "<?php\nnew SavedOwnerMarker();\n";
+    let dirty = "<?php\nnew UnsavedOwnerMarker();\narray_find([1], static fn($v) => true);\n";
+    std::fs::write(&source, saved).unwrap();
+    let uri = Url::from_file_path(&source).unwrap();
+    wire.send(serde_json::json!({"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":uri,"languageId":"php","version":1,"text":saved}}})).await;
+    wire.send(serde_json::json!({"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":uri,"version":2},"contentChanges":[{"text":dirty}]}})).await;
+    // The actual completed version2 publication acknowledges acceptance of
+    // dirty source. It is an input receipt, before the global-only transition.
+    loop {
+        let message = wire.next().await;
+        if message["method"] == "textDocument/publishDiagnostics"
+            && message["params"]["uri"] == uri.as_str()
+            && message["params"]["version"] == 2
+            && message["params"]["phpantomDiagnosticComplete"] == true
+        {
+            break;
+        }
+        wire.answer(message).await;
+    }
+    let (files, prior_ids) = {
+        let owner = wire.slot.lock();
+        let router = owner.as_ref().unwrap().inner();
+        let document = router
+            .state
+            .documents
+            .read()
+            .get(uri.as_str())
+            .cloned()
+            .unwrap();
+        assert_eq!(document.version, 2);
+        assert_eq!(document.text, dirty);
+        let context = router.selected(&uri);
+        assert_eq!(
+            context
+                .backend
+                .open_files
+                .read()
+                .get(uri.as_str())
+                .map(|text| text.as_str()),
+            Some(dirty)
+        );
+        let files = Arc::downgrade(&context.backend.open_files);
+        let ids = router
+            .state
+            .contexts
+            .read()
+            .iter()
+            .map(|context| context.id)
+            .collect::<Vec<_>>();
+        (files, ids)
+    };
+    let held = wire.hold_autonomous_retirement().await;
+    {
+        let owner = wire.slot.lock();
+        let router = owner.as_ref().unwrap().inner();
+        let contexts = router.state.contexts.read();
+        assert_eq!(
+            contexts
+                .iter()
+                .map(|context| context.id)
+                .collect::<Vec<_>>(),
+            prior_ids,
+            "normal retirement waits for real unregister acknowledgement before replacement"
+        );
+        assert!(
+            contexts
+                .iter()
+                .all(|context| context.backend.shutdown_flag.load(Ordering::Acquire))
+        );
+    }
+    wire.drop_actual_owner();
+    tokio::time::timeout(Duration::from_secs(15), async {
+        loop {
+            let retained = wire.core.upgrade().is_some()
+                || wire.sources.upgrade().is_some()
+                || files.upgrade().is_some();
+            if !retained {
+                break;
+            }
+            // Drain accepted notifications so this oracle tests owner retention,
+            // not a controller that intentionally stops reading a bounded queue.
+            tokio::select! {
+                _ = tokio::task::yield_now() => {},
+                message = wire.next() => wire.answer(message).await,
+            }
+        }
+    })
+    .await
+    .expect(
+        "dropped owner releases core, source authority and dirty backend store before late reply",
+    );
+    wire.send(serde_json::json!({"jsonrpc":"2.0","id":held["id"],"result":null}))
+        .await;
+    assert_eq!(
+        wire.request("test/ownerGoneTransportProbe", Value::Null)
+            .await,
+        serde_json::json!(17),
+        "actual framed response sink survived the cancelled Pending waiter and late delivery"
+    );
+    assert_eq!(std::fs::read_to_string(&source).unwrap(), saved);
+    assert!(!wire.server.is_finished());
+    // Independent real ProjectRouter connection in the same runtime still
+    // initializes and handles an actual semantic request after late delivery.
+    let mut independent = Wire::new().await;
+    let other_uri = Url::from_file_path(independent.root.join("other.php")).unwrap();
+    let target = independent
+        .request(
+            "phpWorkbench/activeTarget",
+            serde_json::json!({"uri":other_uri}),
+        )
+        .await;
+    assert_eq!(target["php_version"], "8.3");
+    independent.stop().await;
+    wire.stop().await;
+}
+
+#[tokio::test]
+async fn global_supervisor_real_unregister_owner_drop_releases_dirty_stores_and_accepts_late_wire_reply()
+ {
+    tokio::time::timeout(Duration::from_secs(90), served_owner_scenario())
+        .await
+        .expect("overall served router owner lifecycle deadline");
+}

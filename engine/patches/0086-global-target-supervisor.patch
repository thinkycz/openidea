+//! Autonomous global-profile observation belongs to the transport router.
+use super::*;
+use sha2::{Digest, Sha256};
+use std::collections::BTreeSet;
+use std::time::Duration;
+
+const INTERVAL: Duration = Duration::from_secs(2);
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+enum Fingerprint {
+    Missing,
+    Content([u8; 32]),
+    Unreadable(std::io::ErrorKind),
+}
+
+type Inputs = HashMap<PathBuf, Fingerprint>;
+
+#[cfg(test)]
+pub(super) struct TestHook {
+    stage: u8,
+    entered: tokio::sync::Notify,
+    release: tokio::sync::Notify,
+}
+
+async fn fingerprints(paths: Vec<PathBuf>) -> Inputs {
+    // The closure owns paths only: a blocked filesystem read cannot retain
+    // router state, document ledgers or the transport facade.
+    tokio::task::spawn_blocking(move || {
+        paths
+            .into_iter()
+            .map(|path| {
+                let stamp = match std::fs::read(&path) {
+                    Ok(bytes) => Fingerprint::Content(Sha256::digest(bytes).into()),
+                    Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+                        Fingerprint::Missing
+                    }
+                    Err(error) => Fingerprint::Unreadable(error.kind()),
+                };
+                (path, stamp)
+            })
+            .collect()
+    })
+    .await
+    .unwrap_or_default()
+}
+
+impl ProjectRouter {
+    #[cfg(test)]
+    async fn pause_global_test(&self, stage: u8) {
+        let hook = {
+            let mut slot = self.state.test_global_hook.lock();
+            if slot.as_ref().is_some_and(|hook| hook.stage == stage) {
+                slot.take()
+            } else {
+                None
+            }
+        };
+        if let Some(hook) = hook {
+            hook.entered.notify_one();
+            hook.release.notified().await;
+        }
+    }
+
+    pub(super) fn start_global_supervisor(&self) {
+        if self.state.global_stop.load(Ordering::Acquire) {
+            return;
+        }
+        let paths: BTreeSet<_> = self
+            .state
+            .contexts
+            .read()
+            .iter()
+            .filter(|context| context.root.is_some())
+            .filter_map(|context| context.backend.workspace.global_config_path.clone())
+            .collect();
+        if paths.is_empty() {
+            return;
+        }
+        let mut slot = self.state.global_task.lock();
+        if slot.is_some() {
+            return;
+        }
+        let weak = Arc::downgrade(&self.state);
+        let stop = Arc::clone(&self.state.global_stop);
+        let wake = Arc::clone(&self.state.global_wake);
+        *slot = Some(tokio::spawn(async move {
+            let mut observed = Inputs::new();
+            loop {
+                if stop.load(Ordering::Acquire) {
+                    break;
+                }
+                // First iteration reconciles immediately. Never baseline bytes
+                // sampled after startup without comparing them to applied state.
+                let Some(gate) = weak.upgrade().map(|state| Arc::clone(&state.gate)) else {
+                    break;
+                };
+                let guard = tokio::select! {
+                    guard = gate.write_owned() => guard,
+                    _ = wake.notified() => { if stop.load(Ordering::Acquire) { break; } else { continue; } },
+                };
+                if stop.load(Ordering::Acquire) {
+                    break;
+                }
+                let Some(state) = weak.upgrade() else {
+                    break;
+                };
+                let router = ProjectRouter {
+                    state,
+                    owns_supervisor: false,
+                };
+                let retry = router.reconcile_global_locked(&mut observed).await;
+                drop(router);
+                drop(guard);
+                if retry {
+                    continue;
+                }
+                tokio::select! {
+                    _ = tokio::time::sleep(INTERVAL) => {},
+                    _ = wake.notified() => {},
+                }
+            }
+        }));
+    }
+
+    /// Caller owns router write gate. `true` requests a coalesced immediate
+    /// follow-up because the input changed during preparation/application.
+    async fn reconcile_global_locked(&self, observed: &mut Inputs) -> bool {
+        let contexts = self.state.contexts.read().clone();
+        let global_paths: BTreeSet<_> = contexts
+            .iter()
+            .filter(|context| context.root.is_some())
+            .filter_map(|context| context.backend.workspace.global_config_path.clone())
+            .collect();
+        if global_paths.is_empty() {
+            return false;
+        }
+        let before_global = fingerprints(global_paths.iter().cloned().collect()).await;
+        // A failed blocking observation is not an empty successful generation.
+        if before_global.len() != global_paths.len() {
+            return false;
+        }
+        let changed = before_global.iter().any(|(path, stamp)| {
+            matches!(stamp, Fingerprint::Unreadable(_)) || observed.get(path) != Some(stamp)
+        });
+        if !changed {
+            return false;
+        }
+        if before_global
+            .values()
+            .any(|stamp| matches!(stamp, Fingerprint::Unreadable(_)))
+        {
+            // Retry on the next interval even if permissions recover without an mtime change.
+            return false;
+        }
+        let project_paths: Vec<_> = contexts
+            .iter()
+            .filter_map(|context| context.root.as_ref())
+            .flat_map(|root| {
+                [
+                    root.join(crate::config::CONFIG_FILE_NAME),
+                    root.join("composer.json"),
+                ]
+            })
+            .collect();
+        let before_project = fingerprints(project_paths.clone()).await;
+        if before_project.len() != project_paths.iter().collect::<BTreeSet<_>>().len() {
+            return false;
+        }
+        // A preparation worker owns value snapshots/paths only, never router
+        // state or Backend Arcs. Cancellation releases the transport/core even
+        // if a filesystem read itself is temporarily uninterruptible.
+        let inputs: Vec<_> = contexts
+            .iter()
+            .filter_map(|context| {
+                context.root.as_ref().map(|root| {
+                    (
+                        root.clone(),
+                        context.backend.workspace.global_config_path.clone(),
+                        context.backend.config(),
+                        context.backend.php_version(),
+                        context.backend.version.clone(),
+                        context.backend.workspace.active_php_target.read().clone(),
+                    )
+                })
+            })
+            .collect();
+        let preparation = tokio::task::spawn_blocking(move || {
+            let mut prepared = HashMap::new();
+            let mut target_changed = false;
+            let mut warnings = Vec::new();
+            for (root, global_path, previous, previous_version, engine, applied) in inputs {
+                let (config, version) =
+                    match crate::config::load_config_from(&root, global_path.as_deref()) {
+                        Ok(config) => {
+                            let composer_package = composer::read_composer_package(&root);
+                            let version = crate::workbench_active_target::resolve_php_version(
+                                &config,
+                                composer_package.as_ref(),
+                            );
+                            (config, version)
+                        }
+                        // A malformed profile preserves the actual applied target,
+                        // including its previous Composer fallback. Resolving the
+                        // old Config against new Composer bytes would silently
+                        // import a new target through an invalid config generation.
+                        Err(error) => {
+                            warnings.push(error.to_string());
+                            (previous, previous_version)
+                        }
+                    };
+                let requested = crate::workbench_active_target::ActiveTarget::applied(
+                    version,
+                    config.php.extensions.as_deref(),
+                    &engine,
+                );
+                target_changed |= applied.is_some_and(|applied| applied != requested);
+                prepared.insert(normalized(&root), (config, version));
+            }
+            (prepared, target_changed, warnings)
+        })
+        .await;
+        let Ok((prepared, target_changed, warnings)) = preparation else {
+            return false;
+        };
+        for warning in warnings {
+            tracing::warn!("Retaining last valid global/project configuration: {warning}");
+        }
+        // Pin exactly the effective Config values just validated. A fresh
+        // initialization must not perform a second unowned disk-config parse.
+        let after_prepare_global = fingerprints(global_paths.iter().cloned().collect()).await;
+        let after_prepare_project = fingerprints(project_paths.clone()).await;
+        if before_global != after_prepare_global || before_project != after_prepare_project {
+            observed.clear();
+            return true;
+        }
+        #[cfg(test)]
+        self.pause_global_test(0).await;
+        if target_changed {
+            let params = self.state.params.read().clone();
+            if let Some(params) = params {
+                if let Err(error) = self.rebuild_with_configs(params, Some(&prepared)).await {
+                    tracing::warn!("Global PHP target replacement failed: {error}");
+                    observed.clear();
+                    return false;
+                }
+            } else {
+                return false;
+            }
+        } else {
+            // Same target, changed ordinary settings: use the same publication,
+            // filter reconciliation and diagnostics path as normal reload.
+            for context in &contexts {
+                let Some(root) = context.root.as_ref() else {
+                    continue;
+                };
+                if let Some((config, _version)) = prepared.get(&normalized(root)) {
+                    context.backend.apply_loaded_config(config.clone());
+                }
+            }
+        }
+        #[cfg(test)]
+        self.pause_global_test(1).await;
+        let after_global = fingerprints(global_paths.iter().cloned().collect()).await;
+        let after_project = fingerprints(project_paths).await;
+        if before_global != after_global || before_project != after_project {
+            // Do not mark a newer unseen generation handled. The next iteration
+            // sees current applied state and prepares the newest stable inputs.
+            observed.clear();
+            return true;
+        }
+        *observed = before_global;
+        false
+    }

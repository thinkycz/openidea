+struct Fixture {
+    _dir: tempfile::TempDir,
+    root: PathBuf,
+    global: PathBuf,
+    router: ProjectRouter,
+}
+impl Fixture {
+    async fn new(global: &str, project: &str) -> Self {
+        Self::new_with_sibling(global, project, false).await
+    }
+    async fn new_with_sibling(global: &str, project: &str, sibling: bool) -> Self {
+        Self::new_detailed(global, project, sibling, "[php]\nversion='8.2'\n").await
+    }
+    async fn new_detailed(
+        global: &str,
+        project: &str,
+        sibling: bool,
+        sibling_project: &str,
+    ) -> Self {
+        let dir = tempfile::tempdir().unwrap();
+        let root = dir.path().canonicalize().unwrap().join("project");
+        std::fs::create_dir_all(&root).unwrap();
+        let global_path = dir.path().join("owned-global.toml");
+        std::fs::write(&global_path, global).unwrap();
+        std::fs::write(root.join(".phpantom.toml"), project).unwrap();
+        std::fs::write(
+            root.join("composer.json"),
+            r#"{"name":"owned/global-target","require":{"php":"^8.2"}}"#,
+        )
+        .unwrap();
+        if sibling {
+            std::fs::create_dir_all(root.join("sibling/src")).unwrap();
+            std::fs::write(root.join("sibling/composer.json"), r#"{"name":"owned/sibling","require":{"php":"^8.3"},"autoload":{"psr-4":{"Sibling\\":"src/"}}}"#).unwrap();
+            std::fs::write(root.join("sibling/.phpantom.toml"), sibling_project).unwrap();
+            std::fs::write(
+                root.join("sibling/src/Service.php"),
+                "<?php namespace Sibling; class Service { public string $savedOnly; }\n",
+            )
+            .unwrap();
+        }
+        let router = ProjectRouter::new_test_with_full_stubs();
+        *router.state.test_global_path.lock() = Some(global_path.clone());
+        router
+            .initialize(InitializeParams {
+                root_uri: Some(Url::from_directory_path(&root).unwrap()),
+                workspace_folders: Some(vec![WorkspaceFolder {
+                    uri: Url::from_directory_path(&root).unwrap(),
+                    name: "owned-global".into(),
+                }]),
+                ..Default::default()
+            })
+            .await
+            .unwrap();
+        // Initialize real backends without starting the autonomous timer. The
+        // transaction seam below is deterministic; a separate case starts it.
+        router.projects().await;
+        Self {
+            _dir: dir,
+            root,
+            global: global_path,
+            router,
+        }
+    }
+    async fn apply(&self, observed: &mut Inputs) -> bool {
+        let _guard = self.router.state.gate.write().await;
+        self.router.reconcile_global_locked(observed).await
+    }
+    async fn target(&self) -> crate::workbench_active_target::ActiveTarget {
+        self.router
+            .workbench_active_target(ProjectTargetQuery {
+                uri: Some(Url::from_file_path(self.root.join("main.php")).unwrap()),
+            })
+            .await
+            .unwrap()
+    }
+    async fn completion(&self, prefix: &str) -> Vec<String> {
+        let path = self.root.join("main.php");
+        let text = format!("<?php\n{prefix}\n");
+        let uri = Url::from_file_path(&path).unwrap();
+        let already_open = self
+            .router
+            .state
+            .documents
+            .read()
+            .get(uri.as_str())
+            .cloned();
+        if let Some(document) = already_open {
+            assert_eq!(document.text, text);
+        } else {
+            self.router
+                .did_open(DidOpenTextDocumentParams {
+                    text_document: TextDocumentItem {
+                        uri,
+                        language_id: "php".into(),
+                        version: 1,
+                        text: text.clone(),
+                    },
+                })
+                .await;
+        }
+        let result = self
+            .router
+            .completion(CompletionParams {
+                text_document_position: TextDocumentPositionParams {
+                    text_document: TextDocumentIdentifier {
+                        uri: Url::from_file_path(path).unwrap(),
+                    },
+                    position: Position::new(1, prefix.len() as u32),
+                },
+                context: None,
+                work_done_progress_params: Default::default(),
+                partial_result_params: Default::default(),
+            })
+            .await
+            .unwrap();
+        match result {
+            Some(CompletionResponse::Array(items)) => items,
+            Some(CompletionResponse::List(list)) => list.items,
+            None => Vec::new(),
+        }
+        .into_iter()
+        .map(|item| item.label.split('(').next().unwrap().to_string())
+        .collect()
+    }
+}

+#[tokio::test]
+async fn global_supervisor_is_autonomous_and_owner_drop_releases_core() {
+    let f = Fixture::new("[php]\nversion='8.3'\n", "").await;
+    let weak = Arc::downgrade(&f.router.state);
+    // A gate blocks the real autonomous iteration until the input is changed.
+    let gate = Arc::clone(&f.router.state.gate);
+    let guard = gate.write().await;
+    f.router.start_global_supervisor();
+    std::fs::write(&f.global, "[php]\nversion='8.5'\n").unwrap();
+    drop(guard);
+    // Notify-driven observed state is checked without invoking reconciliation
+    // or sending a request that could trigger target replacement.
+    tokio::time::timeout(Duration::from_secs(10), async {
+        loop {
+            let applied = f
+                .router
+                .state
+                .contexts
+                .read()
+                .iter()
+                .filter(|c| c.root.as_ref() == Some(&f.root))
+                .find_map(|c| c.backend.workspace.active_php_target.read().clone());
+            if applied.is_some_and(|target| target.php_version == "8.5") {
+                break;
+            }
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .expect("autonomous watcher applies input, not a helper-only substitute");
+    let task = f
+        .router
+        .state
+        .global_task
+        .lock()
+        .as_ref()
+        .unwrap()
+        .abort_handle();
+    drop(f);
+    tokio::time::timeout(Duration::from_secs(5), async {
+        while weak.upgrade().is_some() {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .expect("transport facade drop cannot retain router core");
+    assert!(task.is_finished());
+}

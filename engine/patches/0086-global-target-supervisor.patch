+impl ProjectRouter {
+    fn stop_global_supervisor(&self) {
+        self.state.global_stop.store(true, Ordering::Release);
+        self.state.global_wake.notify_waiters();
+        // Reject worker publication before cancellation is observed by an
+        // in-flight supervisor future; do not wait for RouterState Drop.
+        for context in self.state.contexts.read().iter() {
+            context.backend.signal_shutdown_workers();
+        }
+        if let Some(task) = self.state.global_task.lock().take() {
+            task.abort();
+        }
+    }
+}
+impl Drop for ProjectRouter {
+    fn drop(&mut self) {
+        if self.owns_supervisor {
+            self.stop_global_supervisor();
+        }
+    }
+}
+impl Drop for RouterState {
+    fn drop(&mut self) {
+        self.global_stop.store(true, Ordering::Release);
+        self.global_wake.notify_waiters();
+        if let Some(task) = self.global_task.get_mut().take() {
+            task.abort();
+        }
+        for context in self.contexts.get_mut() {
+            context.backend.signal_shutdown_workers();
+        }
+    }
+}

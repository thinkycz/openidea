new file mode 100644
index 0000000..8f8665c
--- /dev/null
+++ b/vendor/tower-lsp/src/service/client/pending.rs
@@ -0,0 +1,504 @@
+//! Types for tracking server-to-client JSON-RPC requests.
+
+use std::fmt::{self, Debug, Formatter};
+use std::future::Future;
+use std::sync::{Arc, Weak};
+
+use dashmap::{mapref::entry::Entry, DashMap};
+use futures::channel::oneshot;
+use tracing::warn;
+
+use crate::jsonrpc::{Id, Response};
+
+/// A hashmap containing pending client requests, keyed by request ID.
+pub struct Pending(Arc<DashMap<Id, Vec<Waiter>>>);
+
+/// Identity is independent of the request ID so cancelling one duplicate-ID
+/// waiter cannot remove a different live waiter from the FIFO.
+struct Waiter {
+    token: Arc<()>,
+    sender: oneshot::Sender<Response>,
+}
+
+impl Waiter {
+    fn deliver(self, response: Response) {
+        // Cancellation can race after insert removes the sender but before
+        // delivery. The response is then obsolete, not a transport panic.
+        if self.sender.send(response).is_err() {
+            warn!("received response for a cancelled client request, ignoring");
+        }
+    }
+}
+
+/// The future owns this registration even before its first poll. Weak ownership
+/// permits the Pending map itself to be dropped while an independent wait exists.
+struct Registration {
+    pending: Weak<DashMap<Id, Vec<Waiter>>>,
+    id: Id,
+    token: Arc<()>,
+}
+
+impl Drop for Registration {
+    fn drop(&mut self) {
+        let pending = match self.pending.upgrade() {
+            Some(pending) => pending,
+            None => return,
+        };
+        let removed = match pending.entry(self.id.clone()) {
+            Entry::Occupied(mut entry) => {
+                let removed = entry
+                    .get()
+                    .iter()
+                    .position(|waiter| Arc::ptr_eq(&waiter.token, &self.token))
+                    .map(|index| entry.get_mut().remove(index));
+                if entry.get().is_empty() {
+                    entry.remove();
+                }
+                removed
+            }
+            Entry::Vacant(_) => None,
+        };
+        // Drop the sender after releasing the map guard, including cancellation.
+        drop(removed);
+    }
+}
+
+impl Pending {
+    /// Creates a new pending client requests map.
+    pub fn new() -> Self {
+        Pending(Arc::new(DashMap::new()))
+    }
+
+    /// Inserts the given response into the map.
+    ///
+    /// The corresponding `.wait()` future will then resolve to the given value.
+    pub fn insert(&self, r: Response) {
+        let waiter = match r.id() {
+            Id::Null => {
+                warn!("received response with request ID of `null`, ignoring");
+                None
+            }
+            id => match self.0.entry(id.clone()) {
+                Entry::Vacant(_) => {
+                    warn!("received response with unknown request ID: {}", id);
+                    None
+                }
+                Entry::Occupied(mut entry) => Some(match entry.get().len() {
+                    1 => entry.remove().remove(0),
+                    _ => entry.get_mut().remove(0),
+                }),
+            },
+        };
+        // Release the map entry guard before waking/delivering to a receiver:
+        // its completion/drop cleanup may access this same request ID.
+        if let Some(waiter) = waiter {
+            waiter.deliver(r);
+        }
+    }
+
+    /// Marks the given request ID as pending and waits for its corresponding response to arrive.
+    ///
+    /// If the same request ID is being waited upon in multiple locations, then the incoming
+    /// response will be routed to one of the callers in a first come, first served basis. To
+    /// ensure correct routing of JSON-RPC requests, each identifier value used _must_ be unique.
+    pub fn wait(&self, id: Id) -> impl Future<Output = Response> + Send + 'static {
+        let (tx, rx) = oneshot::channel();
+        let token = Arc::new(());
+        let registration = Registration {
+            pending: Arc::downgrade(&self.0),
+            id: id.clone(),
+            token: Arc::clone(&token),
+        };
+        let waiter = Waiter { token, sender: tx };
+        match self.0.entry(id) {
+            Entry::Vacant(entry) => {
+                entry.insert(vec![waiter]);
+            }
+            Entry::Occupied(mut entry) => {
+                let txs = entry.get_mut();
+                txs.reserve(1); // We assume concurrent waits are rare, so reserve one by one.
+                txs.push(waiter);
+            }
+        }
+
+        async move {
+            let _registration = registration;
+            rx.await.expect("sender already dropped")
+        }
+    }
+}
+
+impl Debug for Pending {
+    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
+        struct Waiters(usize);
+
+        impl Debug for Waiters {
+            fn fmt(&self, f: &mut Formatter) -> fmt::Result {
+                f.debug_tuple("Waiters").field(&self.0).finish()
+            }
+        }
+
+        let iter = self
+            .0
+            .iter()
+            .map(|e| (e.key().clone(), Waiters(e.value().len())));
+
+        f.debug_map().entries(iter).finish()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use serde_json::json;
+
+    use super::*;
+
+    #[tokio::test(flavor = "current_thread")]
+    async fn waits_for_client_response() {
+        let pending = Pending::new();
+
+        let id = Id::Number(1);
+        let wait_fut = pending.wait(id.clone());
+
+        let response = Response::from_ok(id, json!({}));
+        pending.insert(response.clone());
+
+        assert_eq!(wait_fut.await, response);
+    }
+
+    #[tokio::test(flavor = "current_thread")]
+    async fn routes_responses_in_fifo_order() {
+        let pending = Pending::new();
+
+        let id = Id::Number(1);
+        let wait_fut1 = pending.wait(id.clone());
+        let wait_fut2 = pending.wait(id.clone());
+
+        let foo = Response::from_ok(id.clone(), json!("foo"));
+        let bar = Response::from_ok(id, json!("bar"));
+        pending.insert(bar.clone());
+        pending.insert(foo.clone());
+
+        assert_eq!(wait_fut1.await, bar);
+        assert_eq!(wait_fut2.await, foo);
+    }
+}
+
+#[cfg(test)]
+mod cancellation_tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn pending_cancellation_unpolled_future_removes_registration() {
+        let pending = Pending::new();
+        let id = Id::Number(101);
+        let wait = pending.wait(id.clone());
+        assert_eq!(
+            pending.0.get(&id).unwrap().len(),
+            1,
+            "positive registration control"
+        );
+        drop(wait);
+        assert!(
+            !pending.0.contains_key(&id),
+            "dropping an unpolled request must remove its waiter"
+        );
+    }
+
+    #[tokio::test(flavor = "current_thread")]
+    async fn pending_cancellation_polled_future_removes_registration() {
+        let pending = Pending::new();
+        let id = Id::Number(102);
+        let mut wait = Box::pin(pending.wait(id.clone()));
+        assert!(
+            futures::poll!(wait.as_mut()).is_pending(),
+            "actual oneshot receiver is waiting"
+        );
+        drop(wait);
+        assert!(
+            !pending.0.contains_key(&id),
+            "aborted awaiting request must not retain its sender"
+        );
+    }
+
+    #[test]
+    fn pending_cancellation_late_response_does_not_panic_or_recreate_registration() {
+        let pending = Pending::new();
+        let id = Id::Number(103);
+        let wait = pending.wait(id.clone());
+        drop(wait);
+        // Exercise real insertion after cancellation, not a fake response sink.
+        pending.insert(Response::from_ok(id.clone(), json!({"late":true})));
+        assert!(!pending.0.contains_key(&id));
+    }
+
+    #[tokio::test(flavor = "current_thread")]
+    async fn pending_cancellation_removes_only_its_duplicate_id_slot_and_preserves_live_fifo() {
+        let pending = Pending::new();
+        let id = Id::Number(104);
+        let first = pending.wait(id.clone());
+        let middle = pending.wait(id.clone());
+        let last = pending.wait(id.clone());
+        drop(middle);
+        assert_eq!(
+            pending.0.get(&id).unwrap().len(),
+            2,
+            "exact registration cleanup must retain other live receivers"
+        );
+        let a = Response::from_ok(id.clone(), json!("first live waiter"));
+        let b = Response::from_ok(id.clone(), json!("last live waiter"));
+        pending.insert(a.clone());
+        pending.insert(b.clone());
+        assert_eq!(first.await, a);
+        assert_eq!(last.await, b);
+        assert!(pending.0.is_empty());
+    }
+
+    #[test]
+    fn pending_cancellation_repeated_aborts_leave_no_retained_entries() {
+        let pending = Pending::new();
+        for id in 200..328 {
+            drop(pending.wait(Id::Number(id)));
+        }
+        assert!(
+            pending.0.is_empty(),
+            "cancelled server requests must not accumulate while Client stays alive"
+        );
+    }
+}
+
+#[cfg(test)]
+mod delivery_race_tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn pending_cancellation_after_sender_pop_before_delivery_is_non_panicking() {
+        let pending = Pending::new();
+        let id = Id::Number(401);
+        let wait = pending.wait(id.clone());
+        // This is the scheduler window in insert(): registration already
+        // removed under map lock, but sender delivery has not happened yet.
+        let mut popped = pending.0.remove(&id).unwrap().1;
+        let waiter = popped.remove(0);
+        assert!(pending.0.is_empty());
+        drop(wait);
+        // Same actual delivery implementation insert uses, with a real dropped
+        // oneshot receiver. No timing race or production test hook is required.
+        waiter.deliver(Response::from_ok(id, json!({"raced":true})));
+        assert!(pending.0.is_empty());
+    }
+}
+
+// Append to src/service/client/pending.rs. Unit scope permits private ownership
+// assertions while all request delivery uses the production framed transport.
+#[cfg(all(test, feature = "runtime-tokio"))]
+mod served_transport_tests {
+    use std::sync::Arc;
+
+    use async_trait::async_trait;
+    use futures::{SinkExt, StreamExt};
+    use lsp_types::{InitializeParams, InitializeResult, Unregistration};
+    use serde_json::{json, Value};
+    use tokio::io::{DuplexStream, ReadHalf};
+    use tokio::task::JoinHandle;
+    use tokio_util::codec::{FramedRead, FramedWrite};
+
+    use crate::codec::LanguageServerCodec;
+    use crate::jsonrpc::Result;
+    use crate::{Client, LanguageServer, LspService, Server};
+
+    struct Backend {
+        client: Client,
+    }
+
+    #[async_trait]
+    impl LanguageServer for Backend {
+        async fn initialize(&self, _: InitializeParams) -> Result<InitializeResult> {
+            Ok(InitializeResult::default())
+        }
+
+        async fn shutdown(&self) -> Result<()> {
+            Ok(())
+        }
+    }
+
+    impl Backend {
+        async fn ping(&self) -> Result<i32> {
+            Ok(17)
+        }
+    }
+
+    type Reader = FramedRead<ReadHalf<DuplexStream>, LanguageServerCodec<Value>>;
+
+    async fn next_frame(reader: &mut Reader, server: &mut JoinHandle<()>) -> Value {
+        tokio::select! {
+            frame = reader.next() => frame
+                .expect("served transport ended before expected frame")
+                .expect("decode actual server frame"),
+            result = &mut *server => {
+                panic!("served transport ended before expected frame: {:?}", result)
+            }
+        }
+    }
+
+    fn unregister(id: &str) -> Vec<Unregistration> {
+        vec![Unregistration {
+            id: id.to_owned(),
+            method: "workspace/didChangeWatchedFiles".to_owned(),
+        }]
+    }
+
+    #[tokio::test(flavor = "current_thread")]
+    async fn served_cancellation_late_response_preserves_transport_and_releases_state() {
+        let (service, socket) = LspService::build(|client| Backend { client })
+            .custom_method("owned/ping", Backend::ping)
+            .finish();
+        let client = service.inner().client.clone();
+        let weak_client = Arc::downgrade(&client.inner);
+        let weak_pending = Arc::downgrade(&client.inner.pending);
+        let (server_io, controller_io) = tokio::io::duplex(16 * 1024);
+        let (server_read, server_write) = tokio::io::split(server_io);
+        let (controller_read, controller_write) = tokio::io::split(controller_io);
+        let mut reader = FramedRead::new(controller_read, LanguageServerCodec::<Value>::default());
+        let mut writer =
+            FramedWrite::new(controller_write, LanguageServerCodec::<Value>::default());
+        let mut server =
+            tokio::spawn(Server::new(server_read, server_write, socket).serve(service));
+
+        writer
+            .send(json!({
+                "jsonrpc": "2.0", "id": 100, "method": "initialize",
+                "params": {"capabilities": {}}
+            }))
+            .await
+            .expect("send initialize frame");
+        assert_eq!(
+            next_frame(&mut reader, &mut server).await,
+            json!({
+                "jsonrpc": "2.0", "id": 100, "result": {"capabilities": {}}
+            })
+        );
+
+        let cancelled_client = client.clone();
+        let cancelled = tokio::spawn(async move {
+            cancelled_client
+                .unregister_capability(unregister("owned-cancelled"))
+                .await
+        });
+        let outgoing = next_frame(&mut reader, &mut server).await;
+        assert_eq!(outgoing["method"], "client/unregisterCapability");
+        assert_eq!(
+            outgoing["params"]["unregisterations"][0]["id"],
+            "owned-cancelled"
+        );
+        let cancelled_id = outgoing
+            .get("id")
+            .expect("actual outgoing request id")
+            .clone();
+        assert!(cancelled_id.is_number());
+        assert_eq!(
+            client.inner.pending.0.len(),
+            1,
+            "positive pending registration control"
+        );
+        cancelled.abort();
+        assert!(cancelled
+            .await
+            .expect_err("request task must be cancelled")
+            .is_cancelled());
+
+        // Do not stop at an immediate leak assertion: the old implementation
+        // must reach its actual late-response delivery path and expose its panic.
+        writer
+            .send(json!({
+                "jsonrpc": "2.0", "id": cancelled_id, "result": null
+            }))
+            .await
+            .expect("send actual late response frame");
+        writer
+            .send(json!({
+                "jsonrpc": "2.0", "id": 101, "method": "owned/ping"
+            }))
+            .await
+            .expect("send independent incoming request");
+        assert_eq!(
+            next_frame(&mut reader, &mut server).await,
+            json!({
+                "jsonrpc": "2.0", "id": 101, "result": 17
+            })
+        );
+        assert!(
+            client.inner.pending.0.is_empty(),
+            "cancelled registration leaked"
+        );
+
+        let live_client = client.clone();
+        let live = tokio::spawn(async move {
+            live_client
+                .unregister_capability(unregister("owned-live"))
+                .await
+        });
+        let outgoing = next_frame(&mut reader, &mut server).await;
+        assert_eq!(outgoing["method"], "client/unregisterCapability");
+        assert_eq!(
+            outgoing["params"]["unregisterations"][0]["id"],
+            "owned-live"
+        );
+        let live_id = outgoing.get("id").expect("actual live request id").clone();
+        assert_ne!(live_id, cancelled_id);
+        assert_eq!(client.inner.pending.0.len(), 1);
+        writer
+            .send(json!({
+                "jsonrpc": "2.0", "id": live_id, "result": null
+            }))
+            .await
+            .expect("send actual live response frame");
+        // If the transport panics while routing this response, report it rather
+        // than waiting forever on the otherwise outstanding client task.
+        tokio::select! {
+            result = live => result.expect("live request task panicked").expect("live request failed"),
+            result = &mut server => panic!("transport ended during live reply: {:?}", result),
+        }
+        assert!(
+            client.inner.pending.0.is_empty(),
+            "completed registration leaked"
+        );
+
+        writer
+            .send(json!({
+                "jsonrpc": "2.0", "id": 102, "method": "shutdown"
+            }))
+            .await
+            .expect("send shutdown");
+        assert_eq!(
+            next_frame(&mut reader, &mut server).await,
+            json!({
+                "jsonrpc": "2.0", "id": 102, "result": null
+            })
+        );
+        writer
+            .send(json!({"jsonrpc": "2.0", "method": "exit"}))
+            .await
+            .expect("send exit");
+        writer
+            .close()
+            .await
+            .expect("close controller input normally");
+        drop(client);
+        server
+            .await
+            .expect("served transport must finish without panic");
+        drop(writer);
+        drop(reader);
+        assert!(
+            weak_client.upgrade().is_none(),
+            "ClientInner retained after normal close"
+        );
+        assert!(
+            weak_pending.upgrade().is_none(),
+            "Pending retained after normal close"
+        );
+    }
+}
diff --git a/vendor/tower-lsp/src/service/client/socket.rs b/vendor/tower-lsp/src/service/client/socket.rs
new file mode 100644
index 0000000..5006895
--- /dev/null
+++ b/vendor/tower-lsp/src/service/client/socket.rs
@@ -0,0 +1,149 @@
+//! Loopback connection to the language client.
+
+use std::pin::Pin;
+use std::sync::Arc;
+use std::task::{Context, Poll};
+
+use futures::channel::mpsc::Receiver;
+use futures::sink::Sink;
+use futures::stream::{FusedStream, Stream, StreamExt};
+
+use super::{ExitedError, Pending, ServerState, State};
+use crate::jsonrpc::{Request, Response};
+
+/// A loopback channel for server-to-client communication.
+#[derive(Debug)]
+pub struct ClientSocket {
+    pub(super) rx: Receiver<Request>,
+    pub(super) pending: Arc<Pending>,
+    pub(super) state: Arc<ServerState>,
+}
+
+impl ClientSocket {
+    /// Splits this `ClientSocket` into two halves capable of operating independently.
+    ///
+    /// The two halves returned implement the [`Stream`] and [`Sink`] traits, respectively.
+    ///
+    /// [`Stream`]: futures::Stream
+    /// [`Sink`]: futures::Sink
+    pub fn split(self) -> (RequestStream, ResponseSink) {
+        let ClientSocket { rx, pending, state } = self;
+        let state_ = state.clone();
+
+        (
+            RequestStream { rx, state: state_ },
+            ResponseSink { pending, state },
+        )
+    }
+}
+
+/// Yields a stream of pending server-to-client requests.
+impl Stream for ClientSocket {
+    type Item = Request;
+
+    fn poll_next(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Option<Self::Item>> {
+        if self.state.get() == State::Exited || self.rx.is_terminated() {
+            Poll::Ready(None)
+        } else {
+            self.rx.poll_next_unpin(cx)
+        }
+    }
+
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        self.rx.size_hint()
+    }
+}
+
+impl FusedStream for ClientSocket {
+    fn is_terminated(&self) -> bool {
+        self.rx.is_terminated()
+    }
+}
+
+/// Routes client-to-server responses back to the server.
+impl Sink<Response> for ClientSocket {
+    type Error = ExitedError;
+
+    fn poll_ready(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {
+        if self.state.get() == State::Exited || self.rx.is_terminated() {
+            Poll::Ready(Err(ExitedError(())))
+        } else {
+            Poll::Ready(Ok(()))
+        }
+    }
+
+    fn start_send(self: Pin<&mut Self>, item: Response) -> Result<(), Self::Error> {
+        self.pending.insert(item);
+        Ok(())
+    }
+
+    fn poll_flush(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {
+        Poll::Ready(Ok(()))
+    }
+
+    fn poll_close(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {
+        Poll::Ready(Ok(()))
+    }
+}
+
+/// Yields a stream of pending server-to-client requests.
+#[derive(Debug)]
+#[must_use = "streams do nothing unless polled"]
+pub struct RequestStream {
+    rx: Receiver<Request>,
+    state: Arc<ServerState>,
+}
+
+impl Stream for RequestStream {
+    type Item = Request;
+
+    fn poll_next(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Option<Self::Item>> {
+        if self.state.get() == State::Exited || self.rx.is_terminated() {
+            Poll::Ready(None)
+        } else {
+            self.rx.poll_next_unpin(cx)
+        }
+    }
+
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        self.rx.size_hint()
+    }
+}
+
+impl FusedStream for RequestStream {
+    fn is_terminated(&self) -> bool {
+        self.rx.is_terminated()
+    }
+}
+
+/// Routes client-to-server responses back to the server.
+#[derive(Debug)]
+pub struct ResponseSink {
+    pending: Arc<Pending>,
+    state: Arc<ServerState>,
+}
+
+impl Sink<Response> for ResponseSink {
+    type Error = ExitedError;
+
+    fn poll_ready(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {
+        if self.state.get() == State::Exited {
+            Poll::Ready(Err(ExitedError(())))
+        } else {
+            Poll::Ready(Ok(()))
+        }
+    }
+
+    fn start_send(self: Pin<&mut Self>, item: Response) -> Result<(), Self::Error> {
+        self.pending.insert(item);
+        Ok(())
+    }
+
+    fn poll_flush(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {
+        Poll::Ready(Ok(()))
+    }
+
+    fn poll_close(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {
+        Poll::Ready(Ok(()))
+    }
+}

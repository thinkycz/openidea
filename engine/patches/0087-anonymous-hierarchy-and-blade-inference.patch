+#[test]
+fn hierarchy_projection_component_method_records_only_its_actual_generated_body_scope() {
+    let source = concat!(
+        "<p>café 🐘</p>\r\n",
+        "@php\r\n",
+        "function __blade_template(): void { projectionUserLeaf(); }\r\n",
+        "projectionComponentLeaf();\r\n",
+        "@endphp\r\n",
+    );
+    let (php, map) = preprocess_with_vars(
+        source,
+        &[("title".to_owned(), "string".to_owned())],
+        TemplateKind::Component,
+        Some("App\\View\\Components\\Card"),
+        None,
+        &Default::default(),
+    );
+    let projection = map
+        .hierarchy_projection
+        .expect("component-method generated provenance");
+    assert!(php.contains("abstract class __blade_scope_App_View_Components_Card extends \\App\\View\\Components\\Card"));
+    assert_eq!(
+        php.as_bytes()[projection.wrapper_scope_start as usize],
+        b'{'
+    );
+    assert!(
+        php[..projection.wrapper_scope_start as usize]
+            .ends_with("public function __blade_template() ")
+    );
+    let symbols = hierarchy_projection_symbol_map(&php);
+    let template_call = php.find("projectionComponentLeaf();").unwrap() as u32;
+    let user_call = php.find("projectionUserLeaf();").unwrap() as u32;
+    assert_eq!(
+        symbols.find_enclosing_scope(template_call),
+        projection.wrapper_scope_start
+    );
+    assert_ne!(
+        symbols.find_enclosing_scope(user_call),
+        projection.wrapper_scope_start,
+        "a user function with the same name must retain its own lexical scope"
+    );
+    assert!(
+        symbols
+            .scopes
+            .iter()
+            .any(|(start, end)| *start == projection.wrapper_scope_start && template_call < *end)
+    );
+    assert_eq!(
+        projection.visible_end,
+        tower_lsp::lsp_types::Position::new(5, 0)
+    );
+    assert_eq!(
+        projection.virtual_sha256,
+        crate::symbol_map::AnonymousCallable::source_hash(&php)
+    );
+    assert_eq!(
+        projection.template_sha256,
+        crate::symbol_map::AnonymousCallable::source_hash(source)
+    );
+    let origin = tower_lsp::lsp_types::Position::new(0, 0);
+    assert_eq!(map.try_php_to_blade(map.blade_to_php(origin)), Some(origin));
+}

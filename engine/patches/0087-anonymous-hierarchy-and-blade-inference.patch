+        let contract = "<?php namespace Illuminate\\Contracts\\View; interface Factory { public function make(string $name): mixed; }";
+        backend
+            .open_files
+            .write()
+            .insert(contract_uri.to_owned(), Arc::new(contract.to_owned()));
+        backend.update_ast(contract_uri, contract);
+        let uri = "file:///owned-typed-receiver/caller.php";
+        let source = "<?php\nfunction renderOwned(\\Illuminate\\Contracts\\View\\Factory $views): void {\n    $views->make('owned-shop', []);\n}\n";
+        backend
+            .open_files
+            .write()
+            .insert(uri.to_owned(), Arc::new(source.to_owned()));
+        backend.update_ast(uri, source);
+        let map = backend.symbol_map_for(uri).unwrap();
+        assert_eq!(
+            map.view_receiver_sites.len(),
+            1,
+            "actual candidate extraction fixture"
+        );
+        (backend, uri, source, map)
+    }
+
+    fn confirm_under_foreign_scope(foreign_receiver: Option<PhpType>) {
+        assert!(!walk::is_diagnostic_scope_active());
+        let (backend, uri, source, map) = fixture();
+        let baseline = backend.typed_receiver_view_spans_for(uri, &map);
+        assert_eq!(
+            baseline.len(),
+            1,
+            "cold source-owned receiver must confirm before foreign cache"
+        );
+        assert_eq!(
+            baseline[0].start,
+            source.find("'owned-shop'").unwrap() as u32 + 1
+        );
+        assert_eq!(
+            baseline[0].end,
+            baseline[0].start + "owned-shop".len() as u32
+        );
+        assert_eq!(locations(&baseline)[0].2, "owned-shop");
+        backend.evict_typed_receiver_view_spans(uri);
+        assert!(
+            !backend
+                .typed_receiver_view_spans_cache
+                .read()
+                .contains_key(uri),
+            "second confirmation must be cold, not baseline reuse"

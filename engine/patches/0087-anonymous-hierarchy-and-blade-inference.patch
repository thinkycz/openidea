 use tower_lsp::lsp_types::Position;
 
+/// Producer-owned identity of the generated template execution wrapper.
+/// Names are not authority: these coordinates and digests are emitted by lowering.
+#[derive(Debug, Clone, Copy)]
+pub(crate) struct BladeHierarchyProjection {
+    /// Exact generated function/method body brace after hoisted imports are inserted.
+    pub wrapper_scope_start: u32,
+    /// Final generated PHP source, including prologue and epilogue.
+    pub virtual_sha256: [u8; 32],
+    /// Original visible source, including HTML that may lower to identical PHP.

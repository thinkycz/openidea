+        "function anonymousLeaf(): int { return 1; }\r\n",
+        "function anonymousHost(): void {\r\n",
+        "    /* café 🐘 */ $closure = static FUNCTION (int $value): int { anonymousLeaf(); return anonymousLeaf(); };\r\n",
+        "    /* café 🐘 */ $arrow = static FN(int $value): int => anonymousLeaf();\r\n",
+        "}\r\n",
+    );
+    open_php(&backend, &uri, source).await;
+    let host = anonymous_hierarchy_prepare(&backend, &uri, source, "anonymousHost").await;
+    assert!(
+        outgoing(&backend, &host).await.is_empty(),
+        "declaration is not invocation"
+    );
+    let leaf = anonymous_hierarchy_prepare(&backend, &uri, source, "anonymousLeaf").await;
+    let callers = incoming(&backend, &leaf).await;
+    assert_eq!(callers.len(), 2);
+    for (keyword, label, count) in [("FUNCTION", "Closure", 2), ("FN", "Arrow function", 1)] {
+        let item = anonymous_hierarchy_prepare(&backend, &uri, source, keyword).await;
+        let start = anonymous_hierarchy_position(source, keyword);
+        assert_eq!(item.name, label);
+        assert_eq!(item.kind, SymbolKind::FUNCTION);
+        assert_eq!(
+            item.selection_range,
+            Range::new(
+                start,
+                Position::new(start.line, start.character + keyword.len() as u32)
+            )
+        );
+        assert_eq!(
+            item.range.start,
+            anonymous_hierarchy_position(
+                source,
+                if keyword == "FUNCTION" {
+                    "static FUNCTION"
+                } else {
+                    "static FN"
+                }
+            )
+        );
+        assert!(item.range.end > item.selection_range.end);
+        let caller = callers
+            .iter()
+            .find(|call| call.from.selection_range == item.selection_range)
+            .unwrap();
+        assert_eq!(caller.from.data, item.data);
+        assert_eq!(caller.from_ranges.len(), count);
+        let edges = outgoing(&backend, &item).await;
+        assert_eq!(edges.len(), 1);
+        assert_eq!(edges[0].to.name, "anonymousLeaf");
+        assert_eq!(edges[0].from_ranges, caller.from_ranges);
+        assert!(
+            incoming(&backend, &item).await.is_empty(),
+            "no invented value-flow caller"
+        );
+        assert_eq!(item.data.as_ref().unwrap()["incoming"], "unknown");
+    }
+}

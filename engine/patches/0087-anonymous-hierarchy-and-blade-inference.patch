+// Deterministic foreign diagnostic-scope ownership controls. No scheduler retries.
+fn foreign_scope_item_backend() -> Backend {
+    let backend = Backend::new_test();
+    backend.update_ast(
+        "file:///owned-foreign-scope/Item.php",
+        "<?php namespace App; class Item { public string $name; }",
+    );
+    backend
+}
+
+fn foreign_scope_install_sentinel()
+-> crate::type_engine::variable::forward_walk::DiagnosticScopeGuard {
+    use crate::type_engine::variable::forward_walk as walk;
+    assert!(
+        !walk::is_diagnostic_scope_active(),
+        "independent test starts without a diagnostic owner"
+    );
+    let guard = walk::with_diagnostic_scope_cache();
+    let mut scope = walk::ScopeState::new();
+    scope.set(
+        "$sentinel",
+        vec![crate::types::ResolvedType::from_type_string(
+            PhpType::literal_string_raw("foreign-owner"),
+        )],
+    );
+    walk::record_scope_snapshot(0, &scope);
+    guard
+}
+
+fn foreign_scope_assert_preserved(offset: u32) {
+    use crate::type_engine::variable::forward_walk as walk;
+    assert!(walk::is_diagnostic_scope_active());
+    let sentinel = walk::lookup_diagnostic_scope("$sentinel", offset)
+        .expect("outer cache must remain installed");
+    assert_eq!(
+        crate::types::ResolvedType::types_joined(&sentinel),
+        PhpType::literal_string_raw("foreign-owner")
+    );
+    assert!(
+        walk::lookup_diagnostic_scope("$model", offset)
+            .unwrap()
+            .is_empty(),
+        "caller inference must not replace the foreign owner's snapshots"
+    );
+}
+
+#[test]
+fn component_bare_annotated_variable_uses_its_own_source_contract() {
+    let backend = foreign_scope_item_backend();
+    let uri = "file:///owned-foreign-scope/component-caller.php";
+    let blade = "@php\n/** @var \\App\\Item $model */\n@endphp\n<x-webshop::brand.boxes :hairAnalysis=\"$model\" />\n";
+    let (virtual_php, _) = crate::blade::preprocessor::preprocess(blade);
+    backend.update_ast(uri, &virtual_php);
+    let tags = vec!["webshop::brand.boxes".to_owned()];
+    let infer = || {
+        let occurrences =
+            crate::blade::component_tags::scan_component_tag_calls(blade, &tags, &|_| None);
+        assert_eq!(
+            occurrences.len(),
+            1,
+            "genuine preprocessor/scanner correlation fixture"
+        );
+        backend.extract_component_call_site_vars(uri, &virtual_php, occurrences)
+    };
+    let baseline = infer();
+    assert_eq!(baseline.len(), 1);
+    let initial = baseline[0]

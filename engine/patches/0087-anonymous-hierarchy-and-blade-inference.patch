+// Source-only append to tests/integration/call_hierarchy.rs after the existing
+// six IIFE tests; uses their public-handler helpers. No execution by reviewer.
+// This explicitly covers the logical FileScope of the generated Blade wrapper,
+// visible origin/EOF projection, actual IIFE operator ranges and dirty identity.
+#[tokio::test]
+async fn blade_top_level_file_scope_has_visible_origin_exact_invocation_ranges_and_stale_guard() {
+    let backend = create_test_backend();
+    let php_uri = Url::parse("file:///blade-file-scope-leaves.php").unwrap();
+    let php = "<?php\nfunction bladeScopeLeafA(): int { return 1; }\nfunction bladeScopeLeafB(): int { return 2; }\n";
+    open_php(&backend, &php_uri, php).await;
+    let uri = Url::parse("file:///top-level-scope.blade.php").unwrap();
+    let source = concat!(
+        "<h1>café 🐘</h1>\r\n",
+        "@php\r\n",
+        "bladeScopeLeafA();\r\n",
+        "/* café 🐘 */ (static fn() => bladeScopeLeafA())();\r\n",
+        "@endphp\r\n",
+    );
+    crate::common::open_document(&backend, &uri, "blade", source).await;
+    let old_arrow = anonymous_hierarchy_prepare(&backend, &uri, source, "fn()").await;
+    let leaf_a = anonymous_hierarchy_prepare(&backend, &php_uri, php, "bladeScopeLeafA").await;
+    let callers = incoming(&backend, &leaf_a).await;
+    assert_eq!(
+        callers.len(),
+        2,
+        "one template FileScope caller and one anonymous body, not a generated wrapper function"
+    );
+    let file_call = callers
+        .iter()
+        .find(|call| call.from.kind == SymbolKind::FILE)
+        .expect("a real top-level Blade named call has an explicit FileScope owner");
+    let old_file = file_call.from.clone();
+    assert_eq!(old_file.uri, uri);
+    assert_eq!(old_file.data.as_ref().unwrap()["file_scope"], true);
+    assert_eq!(
+        old_file.data.as_ref().unwrap()["offset"],
+        0,
+        "identity stays virtual file0"
+    );
+    assert_eq!(old_file.data.as_ref().unwrap()["incoming"], "unknown");
+    assert_eq!(
+        old_file.selection_range,
+        Range::new(Position::new(0, 0), Position::new(0, 0))
+    );
+    assert_eq!(
+        old_file.range,
+        Range::new(Position::new(0, 0), Position::new(5, 0)),
+        "FileScope visible extent excludes generated prologue and closing wrapper epilogue"
+    );
+    let direct_start = anonymous_hierarchy_position(source, "bladeScopeLeafA();");
+    let direct_range = Range::new(
+        direct_start,
+        Position::new(direct_start.line, direct_start.character + 15),
+    );
+    assert_eq!(file_call.from_ranges, [direct_range]);
+    assert!(callers.iter().any(|call| call.from.data == old_arrow.data));
+
+    // The item's visible selection must be a real public reprepare location,
+    // even though Blade0:0 maps to a nonzero virtual prologue-line offset.
+    let prepared = prepare_at(&backend, &uri, 0, 0).await;
+    assert_eq!(prepared.len(), 1);
+    assert_eq!(prepared[0].kind, SymbolKind::FILE);
+    assert_eq!(prepared[0].data, old_file.data);
+    assert_eq!(prepared[0].range, old_file.range);
+    assert_eq!(prepared[0].selection_range, old_file.selection_range);
+    assert!(
+        incoming(&backend, &old_file).await.is_empty(),
+        "runtime includes/entrypoints remain unknown"
+    );
+
+    let operator = known_literal_invocation_range(source, "bladeScopeLeafA())();", 18, 2);
+    let file_edges = outgoing(&backend, &old_file).await;
+    assert_eq!(
+        file_edges.len(),
+        2,
+        "top-level leaf plus literal IIFE; nested body leaf is not flattened"
+    );
+    let direct_edge = file_edges
+        .iter()
+        .find(|edge| edge.to.name == "bladeScopeLeafA")
+        .unwrap();
+    assert_eq!(direct_edge.to.uri, php_uri);
+    assert_eq!(direct_edge.from_ranges, [direct_range]);
+    let invocation_edge = file_edges
+        .iter()
+        .find(|edge| edge.to.data == old_arrow.data)
+        .unwrap();
+    assert_eq!(
+        invocation_edge.to.selection_range,
+        old_arrow.selection_range
+    );
+    assert_eq!(
+        invocation_edge.from_ranges,
+        [operator],
+        "UTF16/CRLF visible parentheses translated exactly once"
+    );
+    let back = incoming(&backend, &old_arrow).await;
+    assert_eq!(back.len(), 1);
+    assert_eq!(back[0].from.kind, SymbolKind::FILE);
+    assert_eq!(back[0].from.data, old_file.data);
+    assert_eq!(back[0].from.range, old_file.range);
+    assert_eq!(back[0].from.selection_range, old_file.selection_range);
+    assert_eq!(back[0].from_ranges, [operator]);
+    let body_edges = outgoing(&backend, &old_arrow).await;
+    assert_eq!(body_edges.len(), 1);
+    assert_eq!(body_edges[0].to.name, "bladeScopeLeafA");
+
+    // Same-length dirty replacement changes only the anonymous body's target.
+    // Both old items have positive expansions above, so stale refusal is useful.
+    let changed = source.replace("=> bladeScopeLeafA()", "=> bladeScopeLeafB()");
+    assert_eq!(changed.len(), source.len());
+    anonymous_hierarchy_change(&backend, &uri, &changed).await;
+    for item in [old_file, old_arrow] {
+        assert!(
+            backend
+                .outgoing_calls(CallHierarchyOutgoingCallsParams {
+                    item: item.clone(),
+                    work_done_progress_params: Default::default(),
+                    partial_result_params: Default::default(),
+                })
+                .await
+                .unwrap()
+                .is_none()
+        );
+        assert!(
+            backend
+                .incoming_calls(CallHierarchyIncomingCallsParams {
+                    item,
+                    work_done_progress_params: Default::default(),
+                    partial_result_params: Default::default(),
+                })
+                .await
+                .unwrap()
+                .is_none()
+        );
+    }
+    let fresh_file = prepare_at(&backend, &uri, 0, 0).await.remove(0);
+    let fresh_arrow = anonymous_hierarchy_prepare(&backend, &uri, &changed, "fn()").await;
+    assert_eq!(fresh_file.kind, SymbolKind::FILE);
+    assert_eq!(
+        fresh_file.range,
+        Range::new(Position::new(0, 0), Position::new(5, 0))
+    );
+    let fresh_edges = outgoing(&backend, &fresh_file).await;
+    assert_eq!(fresh_edges.len(), 2);
+    let fresh_direct = fresh_edges
+        .iter()
+        .find(|edge| edge.to.name == "bladeScopeLeafA")
+        .unwrap();
+    assert_eq!(fresh_direct.from_ranges, [direct_range]);
+    let fresh_invocation = fresh_edges
+        .iter()
+        .find(|edge| edge.to.data == fresh_arrow.data)
+        .unwrap();
+    assert_eq!(fresh_invocation.from_ranges, [operator]);
+    let fresh_body = outgoing(&backend, &fresh_arrow).await;
+    assert_eq!(fresh_body.len(), 1);
+    assert_eq!(fresh_body[0].to.name, "bladeScopeLeafB");
+    assert_eq!(fresh_body[0].to.uri, php_uri);
+    let fresh_back = incoming(&backend, &fresh_arrow).await;
+    assert_eq!(fresh_back.len(), 1);
+    assert_eq!(fresh_back[0].from.data, fresh_file.data);
+    assert_eq!(fresh_back[0].from_ranges, [operator]);
+    let still_a = incoming(&backend, &leaf_a).await;
+    assert_eq!(still_a.len(), 1);
+    assert_eq!(still_a[0].from.data, fresh_file.data);
+    assert_eq!(still_a[0].from_ranges, [direct_range]);
+}

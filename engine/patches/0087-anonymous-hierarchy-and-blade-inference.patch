+        let guard = walk::with_diagnostic_scope_cache();
+        let mut scope = walk::ScopeState::new();
+        scope.set(
+            "$sentinel",
+            vec![ResolvedType::from_type_string(PhpType::literal_string_raw(
+                "foreign-owner",
+            ))],
+        );
+        if let Some(ty) = foreign_receiver {
+            scope.set("$views", vec![ResolvedType::from_type_string(ty)]);
+        }
+        walk::record_scope_snapshot(0, &scope);
+        let receiver_offset = source.rfind("$views").unwrap() as u32;
+        walk::begin_targeted_coverage();
+        walk::record_covered_region(receiver_offset, source.len() as u32);
+        let original_receiver = walk::lookup_diagnostic_scope("$views", receiver_offset).unwrap();
+        let original_receiver = ResolvedType::types_joined(&original_receiver);
+
+        let actual = backend.typed_receiver_view_spans_for(uri, &map); // One cold query.
+        let sentinel = walk::lookup_diagnostic_scope("$sentinel", receiver_offset)
+            .expect("outer owner restored");
+        assert_eq!(
+            ResolvedType::types_joined(&sentinel),
+            PhpType::literal_string_raw("foreign-owner")
+        );
+        let restored_receiver = walk::lookup_diagnostic_scope("$views", receiver_offset).unwrap();
+        assert_eq!(
+            ResolvedType::types_joined(&restored_receiver),
+            original_receiver
+        );
+        assert!(
+            walk::lookup_diagnostic_scope("$sentinel", 0).is_none(),
+            "targeted coverage must remain unchanged"
+        );
+        assert!(walk::scope_snapshots_cover(receiver_offset));
+        assert!(!walk::is_building_scopes());
+        drop(guard);
+        assert!(!walk::is_diagnostic_scope_active());
+        assert_eq!(
+            locations(&actual),
+            locations(&baseline),
+            "foreign diagnostic receiver scope must not poison cached render confirmation"
+        );
+        let cached = backend.typed_receiver_view_spans_for(uri, &map);
+        assert_eq!(
+            locations(&cached),
+            locations(&baseline),
+            "first cold result must cache the source-owned spans"
+        );
+    }
+
+    #[test]
+    fn typed_receiver_cold_confirmation_ignores_foreign_missing_receiver() {
+        confirm_under_foreign_scope(None);
+    }
+
+    #[test]
+    fn typed_receiver_cold_confirmation_ignores_foreign_wrong_receiver_type() {
+        confirm_under_foreign_scope(Some(PhpType::named(crate::atom::atom("UnrelatedReceiver"))));
+    }
+}

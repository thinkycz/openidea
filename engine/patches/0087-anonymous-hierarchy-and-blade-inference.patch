+    use super::*;
+    use crate::php_type::PhpType;
+    use crate::type_engine::variable::forward_walk as walk;
+    use crate::types::ResolvedType;
+
+    fn locations(spans: &[SymbolSpan]) -> Vec<(u32, u32, String)> {
+        spans
+            .iter()
+            .map(|span| {
+                let crate::symbol_map::SymbolKind::LaravelStringKey { key, .. } = &span.kind else {
+                    panic!("confirmed render must be a real Laravel key span");
+                };
+                (span.start, span.end, key.to_string())
+            })
+            .collect()
+    }
+
+    fn fixture() -> (Backend, &'static str, &'static str, Arc<SymbolMap>) {
+        let backend = Backend::new_test();
+        backend.resolved_class_cache.write().set_laravel(true);

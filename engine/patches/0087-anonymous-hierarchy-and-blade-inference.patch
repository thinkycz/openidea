+fn hierarchy_projection_symbol_map(php: &str) -> crate::symbol_map::SymbolMap {
+    let arena = mago_allocator::LocalArena::new();
+    let file = mago_database::file::FileId::new(b"projection.php");
+    let program = mago_syntax::parser::parse_file_content(&arena, file, php.as_bytes());
+    crate::symbol_map::extract_symbol_map(program, php)
+}
+
+#[test]
+fn hierarchy_projection_hoisted_unicode_imports_shift_the_actual_wrapper_by_utf8_bytes() {
+    let body = "<p>café 🐘</p>\n@php projectionHoistLeaf(); @endphp\n";
+    let (plain_php, plain_map) = preprocess(body);
+    let source = format!(
+        "@use('App\\Models\\Žluťoučký as Článek')\n@use('App\\Models\\{{\n    First,\n    Second,\n}}')\n{body}"
+    );
+    let expected_imports = concat!(
+        "use App\\Models\\Žluťoučký as Článek;\n",
+        "use App\\Models\\{\n    First,\n    Second,\n};\n",
+    );
+    let (php, map) = preprocess(&source);
+    let plain = plain_map
+        .hierarchy_projection
+        .expect("plain generated provenance");
+    let projection = map
+        .hierarchy_projection
+        .expect("hoisted generated provenance");
+    assert!(
+        php.contains(expected_imports),
+        "exact real hoisted imports: {php}"
+    );
+    assert_ne!(
+        expected_imports.len(),
+        expected_imports.chars().count(),
+        "fixture must distinguish bytes from scalar columns"
+    );
+    assert_eq!(
+        projection.wrapper_scope_start,
+        plain.wrapper_scope_start + expected_imports.len() as u32
+    );
+    assert_eq!(
+        map.prologue_lines,
+        plain_map.prologue_lines
+            + expected_imports
+                .bytes()
+                .filter(|byte| *byte == b'\n')
+                .count() as u32
+    );
+    assert_eq!(
+        php.as_bytes()[projection.wrapper_scope_start as usize],
+        b'{'
+    );
+    assert!(
+        php[..projection.wrapper_scope_start as usize].ends_with("function __blade_template() ")
+    );
+    let symbols = hierarchy_projection_symbol_map(&php);
+    let leaf = php.find("projectionHoistLeaf();").unwrap() as u32;
+    assert_eq!(
+        symbols.find_enclosing_scope(leaf),
+        projection.wrapper_scope_start,
+        "real AST lexical owner must match adjusted provenance"
+    );
+    assert!(
+        symbols
+            .scopes
+            .iter()
+            .any(|(start, end)| *start == projection.wrapper_scope_start && leaf < *end)
+    );
+    let origin = tower_lsp::lsp_types::Position::new(0, 0);
+    let erased_directive_end = tower_lsp::lsp_types::Position::new(
+        0,
+        source.lines().next().unwrap().encode_utf16().count() as u32,
+    );
+    // Hoisted @use text has no PHP at this visible line. The forward map
+    // collapses the erased directive; inverse chooses its final anchor.
+    assert_eq!(
+        map.blade_to_php(origin),
+        map.blade_to_php(erased_directive_end)
+    );
+    assert_eq!(
+        map.try_php_to_blade(map.blade_to_php(origin)),
+        Some(erased_directive_end)
+    );
+    assert_eq!(
+        projection.visible_end,
+        crate::text_position::offset_to_position(&source, source.len())
+    );
+    assert_eq!(
+        projection.virtual_sha256,
+        crate::symbol_map::AnonymousCallable::source_hash(&php)
+    );
+    assert_eq!(
+        projection.template_sha256,
+        crate::symbol_map::AnonymousCallable::source_hash(&source)
+    );
+    assert_ne!(plain_php, php);
+}

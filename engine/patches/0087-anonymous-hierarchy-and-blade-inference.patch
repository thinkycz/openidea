+async fn literal_iife_and_file_scope_edges_are_reciprocal_without_flattening_bodies() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///literal-iife.php").unwrap();
+    let source = concat!(
+        "<?php\r\n",
+        "function iifeLeaf(): int { return 1; }\r\n",
+        "function iifeHost(): void {\r\n",
+        "    /* café 🐘 */ (((static function () { iifeLeaf(); })))();\r\n",
+        "    /* café 🐘 */ ((static fn() => iifeLeaf()))();\r\n",
+        "    $uninvoked = function () { iifeLeaf(); };\r\n",
+        "    $reference = iifeLeaf(...);\r\n",
+        "    $unknown();\r\n",
+        "}\r\n",
+        "iifeLeaf();\r\n",
+        "(fn() => iifeLeaf())();\r\n",
+    );
+    open_php(&backend, &uri, source).await;
+    let host = anonymous_hierarchy_prepare(&backend, &uri, source, "iifeHost").await;
+    let outgoing_host = outgoing(&backend, &host).await;
+    assert_eq!(outgoing_host.len(), 2);
+    for (edge, expected) in outgoing_host.iter().zip([
+        known_literal_invocation_range(source, "})))();", 4, 2),
+        known_literal_invocation_range(source, "iifeLeaf()))();", 12, 2),
+    ]) {
+        assert!(edge.to.data.as_ref().unwrap().get("anonymous").is_some());
+        assert_eq!(edge.from_ranges, [expected]);
+        let callers = incoming(&backend, &edge.to).await;
+        assert_eq!(callers.len(), 1);
+        assert_eq!(callers[0].from.name, "iifeHost");
+        assert_eq!(callers[0].from_ranges, edge.from_ranges);
+        assert_eq!(edge.to.data.as_ref().unwrap()["incoming"], "unknown");
+        let leaves = outgoing(&backend, &edge.to).await;
+        assert_eq!(leaves.len(), 1);
+        assert_eq!(leaves[0].to.name, "iifeLeaf");
+    }
+    let leaf = anonymous_hierarchy_prepare(&backend, &uri, source, "iifeLeaf").await;
+    let callers = incoming(&backend, &leaf).await;
+    assert_eq!(callers.len(), 5, "four anonymous bodies and one file scope");
+    assert_eq!(
+        callers
+            .iter()
+            .filter(|call| call.from.kind == SymbolKind::FUNCTION)
+            .count(),
+        4
+    );
+    let file_caller = callers
+        .iter()
+        .find(|call| call.from.kind == SymbolKind::FILE)
+        .unwrap();
+    let direct = anonymous_hierarchy_position(source, "iifeLeaf();\r\n(fn()");
+    assert_eq!(
+        file_caller.from_ranges,
+        [Range::new(
+            direct,
+            Position::new(direct.line, direct.character + 8)
+        )]
+    );
+    let prepared_file = prepare_at(&backend, &uri, 0, 0).await.remove(0);
+    assert_eq!(prepared_file.kind, SymbolKind::FILE);
+    assert_eq!(prepared_file.data, file_caller.from.data);
+    assert_eq!(
+        prepared_file.selection_range,
+        Range::new(Position::new(0, 0), Position::new(0, 0))
+    );
+    assert_eq!(prepared_file.range.end, Position::new(11, 0));
+    assert_eq!(prepared_file.data.as_ref().unwrap()["incoming"], "unknown");
+    assert!(incoming(&backend, &prepared_file).await.is_empty());
+    let file_edges = outgoing(&backend, &prepared_file).await;
+    assert_eq!(file_edges.len(), 2);
+    assert_eq!(
+        file_edges
+            .iter()
+            .filter(|edge| edge.to.name == "iifeLeaf")
+            .count(),
+        1
+    );
+    let anonymous_edge = file_edges
+        .iter()
+        .find(|edge| edge.to.data.as_ref().unwrap().get("anonymous").is_some())
+        .unwrap();
+    assert_eq!(
+        anonymous_edge.from_ranges,
+        [known_literal_invocation_range(
+            source,
+            "iifeLeaf())();",
+            11,
+            2
+        )]
+    );
+    let invocation_callers = incoming(&backend, &anonymous_edge.to).await;
+    assert_eq!(invocation_callers.len(), 1);
+    assert_eq!(invocation_callers[0].from.kind, SymbolKind::FILE);
+    assert_eq!(
+        invocation_callers[0].from_ranges,
+        anonymous_edge.from_ranges
+    );
+    let uninvoked =
+        anonymous_hierarchy_prepare(&backend, &uri, source, "function () { iifeLeaf(); };").await;
+    assert!(incoming(&backend, &uninvoked).await.is_empty());
+}

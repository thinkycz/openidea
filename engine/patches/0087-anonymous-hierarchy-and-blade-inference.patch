+#[tokio::test]
+async fn blade_file_scope_html_only_dirty_change_retires_raw_identity_when_virtual_php_is_identical()
+ {
+    let backend = create_test_backend();
+    let php_uri = Url::parse("file:///html-only-leaf.php").unwrap();
+    let php = "<?php\nfunction htmlOnlyLeaf(): int { return 1; }\n";
+    open_php(&backend, &php_uri, php).await;
+    let uri = Url::parse("file:///html-only-file-scope.blade.php").unwrap();
+    let source = concat!(
+        "<h1>alpha</h1>\r\n",
+        "@php\r\n",
+        "htmlOnlyLeaf();\r\n",
+        "/* café 🐘 */ (static fn() => htmlOnlyLeaf())();\r\n",
+        "@endphp\r\n",
+    );
+    crate::common::open_document(&backend, &uri, "blade", source).await;
+    let old_file = prepare_at(&backend, &uri, 0, 0).await.remove(0);
+    assert_eq!(old_file.kind, SymbolKind::FILE);
+    let old_edges = outgoing(&backend, &old_file).await;
+    assert_eq!(
+        old_edges.len(),
+        2,
+        "positive known direct call and literal IIFE control"
+    );
+    let old_direct = old_edges
+        .iter()
+        .find(|edge| edge.to.name == "htmlOnlyLeaf")
+        .unwrap();
+    let old_arrow = old_edges
+        .iter()
+        .find(|edge| edge.to.data.as_ref().unwrap().get("anonymous").is_some())
+        .unwrap();
+    assert_eq!(old_direct.to.uri, php_uri);
+    assert_eq!(
+        outgoing(&backend, &old_arrow.to).await[0].to.name,
+        "htmlOnlyLeaf"
+    );
+    let before_virtual = backend
+        .blade_virtual_php(uri.as_str())
+        .expect("actual initial generated PHP");
+    let changed = source.replace("<h1>alpha</h1>", "<h1>omega</h1>");
+    assert_ne!(source, changed);
+    assert_eq!(source.len(), changed.len(), "only same-width HTML changes");
+    assert_eq!(
+        source.encode_utf16().count(),
+        changed.encode_utf16().count()
+    );
+    anonymous_hierarchy_change(&backend, &uri, &changed).await;
+    // No successful semantic retry is used to admit the obsolete item.
+    assert!(
+        backend
+            .outgoing_calls(CallHierarchyOutgoingCallsParams {
+                item: old_file.clone(),
+                work_done_progress_params: Default::default(),
+                partial_result_params: Default::default(),
+            })
+            .await
+            .unwrap()
+            .is_none(),
+        "virtual digest alone must not authorize the old raw-source file identity"
+    );
+    assert!(
+        backend
+            .incoming_calls(CallHierarchyIncomingCallsParams {
+                item: old_file.clone(),
+                work_done_progress_params: Default::default(),
+                partial_result_params: Default::default(),
+            })
+            .await
+            .unwrap()
+            .is_none()
+    );
+    let fresh = prepare_at(&backend, &uri, 0, 0).await.remove(0);
+    let after_virtual = backend
+        .blade_virtual_php(uri.as_str())
+        .expect("actual fresh generated PHP");
+    assert_eq!(
+        before_virtual, after_virtual,
+        "this fixture must isolate raw HTML authority, not a changed virtual source"
+    );
+    assert_eq!(fresh.kind, SymbolKind::FILE);
+    assert_eq!(fresh.selection_range, old_file.selection_range);
+    assert_eq!(fresh.range, old_file.range);
+    assert_eq!(
+        fresh.range,
+        Range::new(Position::new(0, 0), Position::new(5, 0))
+    );
+    let before_data = old_file.data.as_ref().unwrap();
+    let fresh_data = fresh.data.as_ref().unwrap();
+    assert_eq!(before_data["source_sha256"], fresh_data["source_sha256"]);
+    assert_ne!(
+        before_data["blade_projection"]["template_sha256"],
+        fresh_data["blade_projection"]["template_sha256"]
+    );
+    let fresh_edges = outgoing(&backend, &fresh).await;
+    assert_eq!(fresh_edges.len(), 2);
+    let direct = fresh_edges
+        .iter()
+        .find(|edge| edge.to.name == "htmlOnlyLeaf")
+        .unwrap();
+    let arrow = fresh_edges
+        .iter()
+        .find(|edge| edge.to.data.as_ref().unwrap().get("anonymous").is_some())
+        .unwrap();
+    assert_eq!(direct.from_ranges, old_direct.from_ranges);
+    assert_eq!(arrow.from_ranges, old_arrow.from_ranges);
+    assert_eq!(
+        arrow.to.data, old_arrow.to.data,
+        "unchanged virtual callable retains its identity"
+    );
+    let known_callers = incoming(&backend, &arrow.to).await;
+    assert_eq!(known_callers.len(), 1);
+    assert_eq!(known_callers[0].from.data, fresh.data);
+    assert_eq!(known_callers[0].from.selection_range, fresh.selection_range);
+    assert_eq!(known_callers[0].from_ranges, arrow.from_ranges);
+}

+    let source = concat!(
+        "<?php\r\n",
+        "class FixedCtor { public function __construct() {} }\r\n",
+        "trait UnboundFactory { public function __construct() {} public function traitSelf(): void { new self(); } public function traitStatic(): void { new static(); } public function explicitClass(): void { /* café 🐘 */ new FixedCtor(); } }\r\n",
+        "final class ConsumerOne { use UnboundFactory; }\r\n",
+        "final class ConsumerTwo { use UnboundFactory; public function __construct() {} }\r\n",
+    );
+    open_php(&backend, &uri, source).await;
+    for name in ["traitSelf", "traitStatic"] {
+        let owner =
+            keyword_constructor_prepare(&backend, &uri, source, &format!("function {name}"), name)
+                .await;
+        assert!(
+            outgoing(&backend, &owner).await.is_empty(),
+            "trait keyword cannot invent a consuming class"
+        );
+    }
+    for needle in [
+        "trait UnboundFactory { public function __construct",
+        "class ConsumerTwo { use UnboundFactory; public function __construct",
+    ] {
+        let constructor =
+            keyword_constructor_prepare(&backend, &uri, source, needle, "__construct").await;
+        assert!(
+            incoming(&backend, &constructor).await.is_empty(),
+            "incoming must validate the same constructor certainty"
+        );
+    }
+    let fixed = keyword_constructor_prepare(
+        &backend,
+        &uri,
+        source,
+        "class FixedCtor { public function __construct",
+        "__construct",
+    )
+    .await;
+    let explicit = keyword_constructor_prepare(
+        &backend,
+        &uri,
+        source,
+        "function explicitClass",
+        "explicitClass",
+    )
+    .await;
+    let range = keyword_constructor_range(source, "new FixedCtor()", "FixedCtor");
+    let edges = outgoing(&backend, &explicit).await;
+    assert_eq!(
+        edges.len(),
+        1,
+        "explicit named construction inside a trait remains known"
+    );
+    assert_eq!(edges[0].to.selection_range, fixed.selection_range);
+    assert_eq!(edges[0].from_ranges, vec![range]);
+    let back = incoming(&backend, &fixed).await;
+    assert_eq!(back.len(), 1);
+    assert_eq!(back[0].from.selection_range, explicit.selection_range);
+    assert_eq!(back[0].from_ranges, vec![range]);
+}

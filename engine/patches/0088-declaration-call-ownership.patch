+/// New expressions directly in attribute metadata are not declaration-time
+/// invocations. Stop at value-producing callable/class body boundaries: their
+/// real body calls remain known and parameter defaults have separate ownership.
+pub(super) fn deferred_new_spans(expression: &Expression<'_>) -> Vec<(u32, u32)> {
+    let mut spans = Vec::new();
+    DeferredNew.walk_expression(expression, &mut spans);
+    spans
+}
+struct DeferredNew;
+impl<'ast, 'arena> Walker<'ast, 'arena, Vec<(u32, u32)>> for DeferredNew {
+    fn walk_in_instantiation(
+        &self,
+        instantiation: &'ast Instantiation<'arena>,
+        spans: &mut Vec<(u32, u32)>,
+    ) {
+        // Keyword constructors retain their shared navigation symbol kind,
+        // but have the same deferred execution timing as named constructors.
+        // Mask recovered `new static` too; its invalid attribute syntax is
+        // diagnosed separately and must not invent an eager caller.
+        if matches!(
+            instantiation.class,
+            Expression::Identifier(_)
+                | Expression::Self_(_)
+                | Expression::Parent(_)
+                | Expression::Static(_)
+        ) {
+            let span = instantiation.class.span();
+            spans.push((span.start.offset, span.end.offset));
+        }
+    }
+    fn walk_closure(&self, _: &'ast Closure<'arena>, _: &mut Vec<(u32, u32)>) {}
+    fn walk_arrow_function(&self, _: &'ast ArrowFunction<'arena>, _: &mut Vec<(u32, u32)>) {}
+    fn walk_anonymous_class(
+        &self,
+        class: &'ast AnonymousClass<'arena>,
+        spans: &mut Vec<(u32, u32)>,
+    ) {
+        if let Some(arguments) = &class.argument_list {
+            self.walk_partial_argument_list(arguments, spans);
+        }
+    }
+}

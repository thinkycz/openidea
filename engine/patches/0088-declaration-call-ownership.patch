+#[tokio::test]
+async fn hierarchy_late_static_constructor_requires_unique_final_implementation() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///keyword-constructor-certainty.php").unwrap();
+    let source = concat!(
+        "<?php\r\n",
+        "class OpenCtorBase { public function __construct() {} public function maybeStatic(): void { /* café 🐘 */ new static(); } public function knownSelf(): void { new self(); } }\r\n",
+        "class OpenCtorChild extends OpenCtorBase { public function __construct() {} }\r\n",
+        "class LockedCtorBase { final public function __construct() {} public function lockedStatic(): void { /* café 🐘 */ new /* gap */ static(); } }\r\n",
+        "class LockedCtorChild extends LockedCtorBase {}\r\n",
+    );
+    open_php(&backend, &uri, source).await;
+    let base = keyword_constructor_prepare(
+        &backend,
+        &uri,
+        source,
+        "class OpenCtorBase { public function __construct",
+        "__construct",
+    )
+    .await;
+    let child = keyword_constructor_prepare(
+        &backend,
+        &uri,
+        source,
+        "class OpenCtorChild extends OpenCtorBase { public function __construct",
+        "__construct",
+    )
+    .await;
+    let ambiguous = keyword_constructor_prepare(
+        &backend,
+        &uri,
+        source,
+        "function maybeStatic",
+        "maybeStatic",
+    )
+    .await;
+    assert!(
+        outgoing(&backend, &ambiguous).await.is_empty(),
+        "late static cannot choose base or overriding subclass"
+    );
+    let known_self =
+        keyword_constructor_prepare(&backend, &uri, source, "function knownSelf", "knownSelf")
+            .await;
+    let self_range = keyword_constructor_range(source, "new self()", "self");
+    let known_edges = outgoing(&backend, &known_self).await;
+    assert_eq!(
+        known_edges.len(),
+        1,
+        "new self remains lexical even in a nonfinal class"
+    );
+    assert_eq!(known_edges[0].to.selection_range, base.selection_range);
+    assert_eq!(known_edges[0].from_ranges, vec![self_range]);
+    let base_in = incoming(&backend, &base).await;
+    assert_eq!(
+        base_in.len(),
+        1,
+        "incoming must not borrow broader static keyword references"
+    );
+    assert_eq!(base_in[0].from.selection_range, known_self.selection_range);
+    assert_eq!(base_in[0].from_ranges, vec![self_range]);
+    assert!(
+        incoming(&backend, &child).await.is_empty(),
+        "no guessed overriding subclass target"
+    );
+    let locked = keyword_constructor_prepare(
+        &backend,
+        &uri,
+        source,
+        "final public function __construct",
+        "__construct",
+    )
+    .await;
+    let factory = keyword_constructor_prepare(
+        &backend,
+        &uri,
+        source,
+        "function lockedStatic",
+        "lockedStatic",
+    )
+    .await;
+    let range = keyword_constructor_range(source, "new /* gap */ static()", "static");
+    let edges = outgoing(&backend, &factory).await;
+    assert_eq!(
+        edges.len(),
+        1,
+        "a final concrete constructor cannot be overridden"
+    );
+    assert_eq!(edges[0].to.selection_range, locked.selection_range);
+    assert_eq!(edges[0].from_ranges, vec![range]);
+    let back = incoming(&backend, &locked).await;
+    assert_eq!(back.len(), 1);
+    assert_eq!(back[0].from.selection_range, factory.selection_range);
+    assert_eq!(back[0].from_ranges, vec![range]);
+}

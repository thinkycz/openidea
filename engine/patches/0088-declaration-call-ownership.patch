+fn keyword_constructor_range(source: &str, needle: &str, token: &str) -> Range {
+    let start =
+        source.find(needle).expect("fixture needle") + needle.rfind(token).expect("callee token");
+    let prefix = &source[..start];
+    let position = Position::new(
+        prefix.bytes().filter(|b| *b == b'\n').count() as u32,
+        prefix.rsplit('\n').next().unwrap().encode_utf16().count() as u32,
+    );
+    Range::new(
+        position,
+        Position::new(
+            position.line,
+            position.character + token.encode_utf16().count() as u32,
+        ),
+    )
+}

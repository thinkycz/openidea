+        (
+            "function makeSelf",
+            "makeSelf",
+            "new /* gap */ self",
+            "self",
+            &child,
+        ),
+        (
+            "function makeStatic",
+            "makeStatic",
+            "new /* gap */\r\n static",
+            "static",
+            &child,
+        ),
+        (
+            "function makeParent",
+            "makeParent",
+            "new /* gap */ parent",
+            "parent",
+            &base,
+        ),
+    ];
+    let mut expected_child = Vec::new();
+    let mut expected_base = Vec::new();
+    for (needle, name, site, keyword, target) in cases {
+        let owner = keyword_constructor_prepare(&backend, &uri, source, needle, name).await;
+        let range = keyword_constructor_range(source, site, keyword);
+        let edges = outgoing(&backend, &owner).await;
+        assert_eq!(edges.len(), 1, "one actual keyword construction");
+        assert_eq!(edges[0].to.uri, target.uri);
+        assert_eq!(edges[0].to.selection_range, target.selection_range);
+        assert_eq!(edges[0].from_ranges, vec![range]);
+        let expected = (owner.selection_range, vec![range]);
+        if keyword == "parent" {
+            expected_base.push(expected);
+        } else {
+            expected_child.push(expected);
+        }
+    }
+    for (target, expected) in [(&base, expected_base), (&child, expected_child)] {
+        let calls = incoming(&backend, target).await;
+        assert_eq!(
+            calls.len(),
+            expected.len(),
+            "no constructor caller from navigable keyword mentions"
+        );
+        for (selection, ranges) in expected {
+            assert_eq!(
+                calls
+                    .iter()
+                    .filter(|call| call.from.uri == uri
+                        && call.from.selection_range == selection
+                        && call.from_ranges == ranges)
+                    .count(),
+                1
+            );
+        }
+    }
+    let mentions =
+        keyword_constructor_prepare(&backend, &uri, source, "function mentions", "mentions").await;
+    assert!(
+        outgoing(&backend, &mentions).await.is_empty(),
+        "type, return, ::class and property mentions are not constructors"
+    );
+}

+#[test]
+fn keyword_constructor_references_refuse_same_length_stale_ast_roles() {
+    let backend = Backend::new_test();
+    let uri = "file:///keyword-reference-source-authority.php";
+    let source = "<?php final class KeywordSourceReference { public function __construct() {} public function make() { new self()     ; } }";
+    backend
+        .open_files
+        .write()
+        .insert(uri.to_owned(), std::sync::Arc::new(source.to_owned()));
+    backend.update_ast(uri, source);
+    let owners = ["KeywordSourceReference".to_owned()];
+    let before = backend.find_constructor_references(&owners, false);
+    assert_eq!(before.len(), 1, "positive genuine new keyword control");
+    let changed = source.replace("new self()     ", "    self::class");
+    assert_eq!(source.len(), changed.len());
+    // Emulate the existing separately captured map/content seam; do not reparse.
+    backend
+        .open_files
+        .write()
+        .insert(uri.to_owned(), std::sync::Arc::new(changed.clone()));
+    assert!(
+        backend
+            .find_constructor_references(&owners, false)
+            .is_empty(),
+        "same-length current self::class must not inherit the old new-self AST role"
+    );
+    backend
+        .open_files
+        .write()
+        .insert(uri.to_owned(), std::sync::Arc::new(source.to_owned()));
+    assert_eq!(
+        backend.find_constructor_references(&owners, false).len(),
+        1,
+        "restoring exact source keeps valid provenance usable"
+    );
+    backend
+        .open_files
+        .write()
+        .insert(uri.to_owned(), std::sync::Arc::new(changed.clone()));
+    backend.update_ast(uri, &changed);
+    assert!(
+        backend
+            .find_constructor_references(&owners, false)
+            .is_empty(),
+        "fresh non-invocation map stays negative"
+    );
+}

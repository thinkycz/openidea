+        "class DefaultOwner { public function defaultMethod($arg = new MethodDefaultToken()): void {} }\n",
+        "$closure = function ($arg = new ClosureDefaultToken()): void {};\n",
+        "$arrow = fn($arg = new ArrowDefaultToken()) => $arg;\n",
+    );
+    open_php(&backend, &uri, source).await;
+    let file = prepare_at(&backend, &uri, 0, 0).await;
+    assert_eq!(file.len(), 1);
+    assert!(
+        outgoing(&backend, &file[0]).await.is_empty(),
+        "declarations do not evaluate optional parameter defaults at file execution"
+    );
+    for (class, needle) in [
+        ("FunctionDefaultToken", "defaultFunction"),
+        ("MethodDefaultToken", "defaultMethod"),
+        ("ClosureDefaultToken", "function ($arg"),
+        ("ArrowDefaultToken", "fn($arg"),
+    ] {
+        let owner = anonymous_hierarchy_prepare(&backend, &uri, source, needle).await;
+        let default_call = format!("{class}()");
+        let prepared = anonymous_hierarchy_prepare(&backend, &uri, source, &default_call).await;
+        assert_eq!(
+            prepared.selection_range, owner.selection_range,
+            "{class}: prepare on the default call belongs to its declaration"
+        );
+        let ctor = declaration_default_constructor(&backend, &uri, source, class).await;
+        let calls = incoming(&backend, &ctor).await;
+        assert_eq!(
+            calls.len(),
+            1,
+            "{class}: known optional default constructor is owned by its declaration"
+        );
+        assert_eq!(
+            calls[0].from.selection_range, owner.selection_range,
+            "{class}: no file/outer caller borrowing"
+        );
+        assert_eq!(calls[0].from.uri, owner.uri);
+        let outgoing = outgoing(&backend, &owner).await;
+        assert_eq!(
+            outgoing.len(),
+            1,
+            "{class}: static possible default edge, conditional on omitted argument"
+        );
+        assert_eq!(outgoing[0].to.selection_range, ctor.selection_range);
+        assert_eq!(outgoing[0].from_ranges, calls[0].from_ranges);
+    }
+}

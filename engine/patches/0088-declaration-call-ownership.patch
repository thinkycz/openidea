+// Append to call_hierarchy.rs after the noncall and keyword-constructor tests.
+async fn attribute_keyword_assert_deferred(keyword: &str) {
+    let backend = create_test_backend();
+    backend.set_php_version(phpantom_lsp::types::PhpVersion::new(8, 3));
+    let uri = Url::parse(&format!("file:///attribute-deferred-{keyword}.php")).unwrap();
+    let source = format!(
+        concat!(
+            "<?php\r\n",
+            "class AttributeKeywordBase {{ public function __construct() {{}} }}\r\n",
+            "#[\\Attribute] class AttributeKeywordMetadata {{ public function __construct(public mixed $value) {{}} }}\r\n",
+            "class AttributeKeywordChild extends AttributeKeywordBase {{\r\n",
+            " public function __construct() {{}}\r\n",
+            " #[AttributeKeywordMetadata([new /* deferred */ {0}()])]\r\n",
+            " public function decorated(): void {{}}\r\n",
+            " public function instantiate(): void {{ /* café 🐘 */ new /* real */ {0}(); }}\r\n",
+            "}}\r\n",
+        ),
+        keyword
+    );
+    open_php(&backend, &uri, &source).await;
+    let constructor_needle = if keyword == "self" {
+        "\r\n public function __construct"
+    } else {
+        "class AttributeKeywordBase { public function __construct"
+    };
+    let ctor =
+        keyword_constructor_prepare(&backend, &uri, &source, constructor_needle, "__construct")
+            .await;
+    let body = keyword_constructor_prepare(
+        &backend,
+        &uri,
+        &source,
+        "function instantiate",
+        "instantiate",
+    )
+    .await;
+    let expected =
+        keyword_constructor_range(&source, &format!("new /* real */ {keyword}"), keyword);
+    let calls = incoming(&backend, &ctor).await;
+    assert_eq!(
+        calls.len(),
+        1,
+        "attribute reflection metadata must not add a file/declaration caller: {keyword}"
+    );
+    assert_eq!(calls[0].from.selection_range, body.selection_range);
+    assert_eq!(calls[0].from_ranges, [expected]);
+    let edges = outgoing(&backend, &body).await;
+    assert_eq!(edges.len(), 1);
+    assert_eq!(edges[0].to.selection_range, ctor.selection_range);
+    assert_eq!(edges[0].from_ranges, [expected]);
+    let file = prepare_at(&backend, &uri, 0, 0).await.remove(0);
+    assert!(
+        outgoing(&backend, &file).await.is_empty(),
+        "no eager file execution from deferred {keyword}"
+    );
+    let decorated =
+        keyword_constructor_prepare(&backend, &uri, &source, "function decorated", "decorated")
+            .await;
+    assert!(outgoing(&backend, &decorated).await.is_empty());
+}

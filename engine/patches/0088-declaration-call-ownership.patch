+#[tokio::test]
+async fn hierarchy_keyword_constructors_reuse_inherited_and_trait_alias_origins() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///keyword-constructor-origins.php").unwrap();
+    let source = concat!(
+        "<?php\r\n",
+        "class KeywordAncestor { public function __construct() {} }\r\n",
+        "final class KeywordInherited extends KeywordAncestor { public function create(): void { /* café 🐘 */ new self(); new static(); new parent(); } }\r\n",
+        "trait KeywordInitializer { public function initialize() {} }\r\n",
+        "final class KeywordTraitFactory { use KeywordInitializer { initialize as __construct; } public function createTrait(): void { /* café 🐘 */ new /* comment */ self(); } }\r\n",
+    );
+    open_php(&backend, &uri, source).await;
+    let ancestor = keyword_constructor_prepare(
+        &backend,
+        &uri,
+        source,
+        "class KeywordAncestor { public function __construct",
+        "__construct",
+    )
+    .await;
+    let inherited =
+        keyword_constructor_prepare(&backend, &uri, source, "function create()", "create").await;
+    let ranges = ["self", "static", "parent"]
+        .map(|word| keyword_constructor_range(source, &format!("new {word}()"), word))
+        .to_vec();
+    let edges = outgoing(&backend, &inherited).await;
+    assert_eq!(edges.len(), 1);
+    assert_eq!(edges[0].to.selection_range, ancestor.selection_range);
+    assert_eq!(edges[0].from_ranges, ranges);
+    let back = incoming(&backend, &ancestor).await;
+    assert_eq!(back.len(), 1);
+    assert_eq!(back[0].from.selection_range, inherited.selection_range);
+    assert_eq!(back[0].from_ranges, ranges);
+    let initialization =
+        keyword_constructor_prepare(&backend, &uri, source, "function initialize", "initialize")
+            .await;
+    let factory = keyword_constructor_prepare(
+        &backend,
+        &uri,
+        source,
+        "function createTrait",
+        "createTrait",
+    )
+    .await;
+    let range = keyword_constructor_range(source, "new /* comment */ self", "self");
+    let edges = outgoing(&backend, &factory).await;
+    assert_eq!(edges.len(), 1);
+    assert_eq!(edges[0].to.selection_range, initialization.selection_range);
+    assert_eq!(edges[0].from_ranges, vec![range]);
+    let back = incoming(&backend, &initialization).await;
+    assert_eq!(back.len(), 1, "trait adaptation metadata is not an invoker");
+    assert_eq!(back[0].from.selection_range, factory.selection_range);
+    assert_eq!(back[0].from_ranges, vec![range]);
+}

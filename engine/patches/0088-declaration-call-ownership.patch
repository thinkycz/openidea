+async fn keyword_constructor_prepare(
+    backend: &Backend,
+    uri: &Url,
+    source: &str,
+    needle: &str,
+    token: &str,
+) -> CallHierarchyItem {
+    let range = keyword_constructor_range(source, needle, token);
+    let mut items = prepare_at(backend, uri, range.start.line, range.start.character).await;
+    assert_eq!(items.len(), 1, "unique prepare {needle}");
+    let item = items.remove(0);
+    assert_eq!(
+        item.selection_range, range,
+        "exact keyword/declaration selection"
+    );
+    item
+}

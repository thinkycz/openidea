+#[tokio::test]
+async fn type_hierarchy_global_owner_survives_close_with_only_namespaced_homonym_cached() {
+    let backend = create_test_backend();
+    let directory = tempfile::tempdir().unwrap();
+    let root = directory.path().canonicalize().unwrap();
+    let namespace_line = "namespace Shadow;\r\n";
+    // Equal byte/UTF16 declaration coordinates make className-only validation
+    // insufficient. The global namespace is semantically meaningful here.
+    let global_padding = format!("/*{}*/\r\n", " ".repeat(namespace_line.len() - 6));
+    let global = format!("<?php\r\n{global_padding}class Twin extends \\ParentA {{}}\r\n");
+    let shadow = format!("<?php\r\n{namespace_line}class Twin extends \\ParentB {{}}\r\n");
+    let parents = "<?php\r\nclass ParentA {}\r\nclass ParentB {}\r\n";
+    let consumer = "<?php\r\n/* café 🐘 */ $value = new \\Twin();\r\n";
+    assert_eq!(global.find("class Twin"), shadow.find("class Twin"));
+    assert_eq!(global.len(), shadow.len());
+    let global_path = root.join("Global.php");
+    let shadow_path = root.join("Shadow.php");
+    let parents_path = root.join("Parents.php");
+    let consumer_path = root.join("Consumer.php");
+    for (path, text) in [
+        (&global_path, global.as_str()),
+        (&shadow_path, shadow.as_str()),
+        (&parents_path, parents),
+        (&consumer_path, consumer),
+    ] {
+        std::fs::write(path, text).unwrap();
+    }
+    let global_uri = Url::from_file_path(&global_path).unwrap();
+    let shadow_uri = Url::from_file_path(&shadow_path).unwrap();
+    let parents_uri = Url::from_file_path(&parents_path).unwrap();
+    let consumer_uri = Url::from_file_path(&consumer_path).unwrap();
+    open_php(&backend, &parents_uri, parents).await;
+    open_php(&backend, &global_uri, &global).await;
+    open_php(&backend, &shadow_uri, &shadow).await;
+    // Standalone close restores disk declaration ownership, then deliberately
+    // releases its per-URI maps. fqn_class_index/fqn_uri_index retain Twin.
+    // No type request primes or reloads the global URI before this point.
+    backend
+        .did_close(DidCloseTextDocumentParams {
+            text_document: TextDocumentIdentifier {
+                uri: global_uri.clone(),
+            },
+        })
+        .await;
+    open_php(&backend, &consumer_uri, consumer).await;
+    let selected = prepare_type_token(&backend, &consumer_uri, consumer, "Twin").await;
+    assert_eq!(item_fqn(&selected), "Twin");
+    assert_eq!(
+        selected.uri, global_uri,
+        "canonical global ClassInfo must not borrow the only cached short-name homonym's source"
+    );
+    let expected_start = type_hierarchy_position(&global, "Twin");
+    assert_eq!(
+        selected.selection_range,
+        Range::new(
+            expected_start,
+            Position::new(expected_start.line, expected_start.character + 4)
+        )
+    );
+    let supers = supertypes_of(&backend, &selected).await;
+    assert_eq!(supers.len(), 1);
+    assert_eq!(item_fqn(&supers[0]), "ParentA");
+    assert_eq!(supers[0].uri, parents_uri);
+    let other = prepare_type_token(&backend, &shadow_uri, &shadow, "Twin").await;
+    assert_eq!(item_fqn(&other), "Shadow\\Twin");
+    assert_eq!(other.uri, shadow_uri);
+    let supers = supertypes_of(&backend, &other).await;
+    assert_eq!(supers.len(), 1);
+    assert_eq!(item_fqn(&supers[0]), "ParentB");
+    // A real receipt for the shadow source cannot authorize a global Twin
+    // token, despite identical class name/ranges and matching source bytes there.
+    let mut forged = selected.clone();
+    forged.uri = other.uri.clone();
+    forged.data = other.data.clone();
+    forged.data.as_mut().unwrap()["fqn"] = serde_json::json!("Twin");
+    assert!(supertypes_of(&backend, &forged).await.is_empty());
+    assert!(subtypes_of(&backend, &forged).await.is_empty());
+    for (path, text) in [(global_path, global), (shadow_path, shadow)] {
+        assert_eq!(std::fs::read(path).unwrap(), text.as_bytes());
+    }
+}

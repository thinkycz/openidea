+#[tokio::test]
+async fn blade_actual_wrapper_registers_named_classlikes_and_one_anonymous_class() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///views/type-declarations.blade.php").unwrap();
+    let text = "<p>🦀 visible prefix</p>\n@php\ninterface TemplateContract {}\ntrait TemplateFeature {}\nclass TemplateBase {}\nclass TemplateChild extends TemplateBase implements TemplateContract { use TemplateFeature; }\nenum TemplateChoice { use TemplateFeature; }\n$instance = new class extends TemplateBase {};\nfunction __blade_template() { class HiddenNestedDeclaration {} }\n@endphp\n";
+    open_php(&backend, &uri, text).await;
+    let classes = backend
+        .get_classes_for_uri(uri.as_str())
+        .expect("template class partition");
+    for expected in [
+        "TemplateContract",
+        "TemplateFeature",
+        "TemplateBase",
+        "TemplateChild",
+        "TemplateChoice",
+    ] {
+        assert_eq!(
+            classes
+                .iter()
+                .filter(|class| class.name == expected)
+                .count(),
+            1,
+            "{expected} registered once"
+        );
+    }
+    assert_eq!(
+        classes
+            .iter()
+            .filter(|class| class.name.starts_with("__anonymous@"))
+            .count(),
+        1
+    );
+    assert!(
+        !classes
+            .iter()
+            .any(|class| class.name == "HiddenNestedDeclaration")
+    );
+    let child = classes
+        .iter()
+        .find(|class| class.name == "TemplateChild")
+        .unwrap();
+    assert_eq!(child.parent_class.as_deref(), Some("TemplateBase"));
+    assert!(
+        child
+            .interfaces
+            .iter()
+            .any(|name| name == "TemplateContract")
+    );
+    assert!(
+        child
+            .used_traits
+            .iter()
+            .any(|name| name == "TemplateFeature")
+    );
+    let items = prepare_at(&backend, &uri, 5, 8).await;
+    assert_eq!(
+        items.len(),
+        1,
+        "first public type preparation must find actual template class"
+    );
+    assert_eq!(items[0].name, "TemplateChild");
+    assert_eq!(
+        items[0].selection_range,
+        Range::new(Position::new(5, 6), Position::new(5, 19))
+    );
+    assert_eq!(
+        item_names(&supertypes_of(&backend, &items[0]).await),
+        vec!["TemplateBase", "TemplateContract", "TemplateFeature"]
+    );
+}

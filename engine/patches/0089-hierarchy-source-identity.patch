+#[tokio::test]
+async fn hierarchy_anonymous_inherited_constructor_uses_closed_global_owner_not_cached_homonym() {
+    let backend = create_test_backend();
+    let directory = tempfile::tempdir().unwrap();
+    let root = directory.path().canonicalize().unwrap();
+    let namespace_line = "namespace Shadow;\r\n";
+    let padding = format!("/*{}*/\r\n", " ".repeat(namespace_line.len() - 6));
+    let global =
+        format!("<?php\r\n{padding}class TwinCtor {{ public function __construct() {{}} }}\r\n");
+    let shadow = format!(
+        "<?php\r\n{namespace_line}class TwinCtor {{ public function __construct() {{}} }}\r\n"
+    );
+    let factory = "<?php\r\nfunction createInheritedAnonymous(): void { /* café 🐘 */ $value = new class extends \\TwinCtor {}; }\r\n";
+    assert_eq!(global.find("class TwinCtor"), shadow.find("class TwinCtor"));
+    assert_eq!(global.find("__construct"), shadow.find("__construct"));
+    assert_eq!(global.len(), shadow.len());
+    let global_path = root.join("GlobalCtor.php");
+    let shadow_path = root.join("ShadowCtor.php");
+    let factory_path = root.join("Factory.php");
+    for (path, text) in [
+        (&global_path, global.as_str()),
+        (&shadow_path, shadow.as_str()),
+        (&factory_path, factory),
+    ] {
+        std::fs::write(path, text).unwrap();
+    }
+    let global_uri = Url::from_file_path(&global_path).unwrap();
+    let shadow_uri = Url::from_file_path(&shadow_path).unwrap();
+    let factory_uri = Url::from_file_path(&factory_path).unwrap();
+    open_php(&backend, &global_uri, &global).await;
+    open_php(&backend, &shadow_uri, &shadow).await;
+    // The disk-backed canonical global class remains indexed, but standalone
+    // didClose releases its per-URI maps. Only Shadow's short name is cached.
+    backend
+        .did_close(DidCloseTextDocumentParams {
+            text_document: TextDocumentIdentifier {
+                uri: global_uri.clone(),
+            },
+        })
+        .await;
+    open_php(&backend, &factory_uri, factory).await;
+    let caller =
+        anonymous_hierarchy_prepare(&backend, &factory_uri, factory, "createInheritedAnonymous")
+            .await;
+    // First outgoing must select its true inherited owner without priming or
+    // re-preparing the global constructor to restore its per-URI source maps.
+    let first_outgoing = outgoing(&backend, &caller).await;
+    assert_eq!(first_outgoing.len(), 1);
+    let target = &first_outgoing[0].to;
+    assert_eq!(
+        target.uri, global_uri,
+        "resolved global constructor metadata cannot borrow Shadow's aligned source"
+    );
+    assert_eq!(target.name, "__construct");
+    assert_eq!(
+        target.selection_range,
+        keyword_constructor_range(&global, "public function __construct", "__construct")
+    );
+    let site = keyword_constructor_range(factory, "new class extends", "class");
+    assert_eq!(first_outgoing[0].from_ranges, vec![site]);
+    let first_incoming = incoming(&backend, target).await;
+    assert_eq!(first_incoming.len(), 1);
+    assert_eq!(first_incoming[0].from.uri, factory_uri);
+    assert_eq!(
+        first_incoming[0].from.selection_range,
+        caller.selection_range
+    );
+    assert_eq!(first_incoming[0].from_ranges, vec![site]);
+    let unrelated =
+        anonymous_hierarchy_prepare(&backend, &shadow_uri, &shadow, "__construct").await;
+    assert!(
+        incoming(&backend, &unrelated).await.is_empty(),
+        "the namespaced homonym does not gain the global anonymous construction caller"
+    );
+    for (path, text) in [
+        (global_path, global.as_str()),
+        (shadow_path, shadow.as_str()),
+        (factory_path, factory),
+    ] {
+        assert_eq!(std::fs::read(path).unwrap(), text.as_bytes());
+    }
+}

+#[tokio::test]
+async fn hierarchy_anonymous_class_creation_has_own_constructor_and_body_owners() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///anonymous-constructor-owners.php").unwrap();
+    let source = concat!(
+        "<?php\r\n",
+        "function constructionArgument(): mixed { return null; }\r\n",
+        "function constructionBody(): void {}\r\n",
+        "function nestedConstructionBody(): void {}\r\n",
+        "function createAnonymous(): void { /* café 🐘 */ $value = new class(constructionArgument()) { public function __construct($value) { constructionBody(); } }; }\r\n",
+        "function nestedCreation(): void { $later = function () { /* café 🐘 */ $value = new class { public function __construct() { nestedConstructionBody(); } }; }; }\r\n",
+    );
+    open_php(&backend, &uri, source).await;
+    let factory = anonymous_hierarchy_prepare(&backend, &uri, source, "createAnonymous").await;
+    let ctor = anonymous_hierarchy_prepare(&backend, &uri, source, "__construct($value)").await;
+    let site = keyword_constructor_range(source, "new class(constructionArgument())", "class");
+    let edges = outgoing(&backend, &factory).await;
+    assert_eq!(
+        edges.len(),
+        2,
+        "creation invokes constructor and evaluates argument, not constructor body calls"
+    );
+    let edge = edges
+        .iter()
+        .find(|call| call.to.selection_range == ctor.selection_range)
+        .expect("constructor edge");
+    assert_eq!(edge.to.uri, uri);
+    assert_eq!(edge.from_ranges, vec![site]);
+    let arguments: Vec<_> = edges
+        .iter()
+        .filter(|call| call.to.name == "constructionArgument")
+        .collect();
+    assert_eq!(arguments.len(), 1);
+    assert_eq!(
+        arguments[0].from_ranges,
+        vec![keyword_constructor_range(
+            source,
+            "class(constructionArgument())",
+            "constructionArgument"
+        )]
+    );
+    let back = incoming(&backend, &ctor).await;
+    assert_eq!(back.len(), 1);
+    assert_eq!(back[0].from.selection_range, factory.selection_range);
+    assert_eq!(back[0].from_ranges, vec![site]);
+    let ctor_edges = outgoing(&backend, &ctor).await;
+    assert_eq!(ctor_edges.len(), 1);
+    assert_eq!(ctor_edges[0].to.name, "constructionBody");
+    assert_eq!(
+        ctor_edges[0].from_ranges,
+        vec![keyword_constructor_range(
+            source,
+            "constructionBody();",
+            "constructionBody"
+        )]
+    );
+    let outer = anonymous_hierarchy_prepare(&backend, &uri, source, "nestedCreation").await;
+    assert!(
+        outgoing(&backend, &outer).await.is_empty(),
+        "declaring a closure does not create its nested class"
+    );
+    let closure = anonymous_hierarchy_prepare(&backend, &uri, source, "function ()").await;
+    let nested_ctor = anonymous_hierarchy_prepare(&backend, &uri, source, "__construct()").await;
+    let nested_edges = outgoing(&backend, &closure).await;
+    assert_eq!(nested_edges.len(), 1);
+    assert_eq!(
+        nested_edges[0].to.selection_range,
+        nested_ctor.selection_range
+    );
+    let nested_range = keyword_constructor_range(source, "new class {", "class");
+    assert_eq!(nested_edges[0].from_ranges, vec![nested_range]);
+    let nested_back = incoming(&backend, &nested_ctor).await;
+    assert_eq!(nested_back.len(), 1);
+    assert_eq!(nested_back[0].from.selection_range, closure.selection_range);
+    assert_eq!(nested_back[0].from_ranges, vec![nested_range]);
+    assert!(
+        incoming(&backend, &closure).await.is_empty(),
+        "known body creation does not invent invocation of the uninvoked closure"
+    );
+}

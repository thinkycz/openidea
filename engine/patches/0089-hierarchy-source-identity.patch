+            .prepare_type_hierarchy(TypeHierarchyPrepareParams {
+                text_document_position_params: TextDocumentPositionParams {
+                    text_document: TextDocumentIdentifier {
+                        uri: item.uri.clone(),
+                    },
+                    position: item.selection_range.start,
+                },
+                work_done_progress_params: Default::default(),
+            })
+            .await
+            .unwrap()
+            .unwrap_or_default();
+        assert_eq!(again.as_slice(), std::slice::from_ref(&item));
+        items.push(item);
+    }
+    assert_ne!(
+        items[0].uri.query(),
+        items[1].uri.query(),
+        "different actual project contexts"
+    );
+    for forged in [
+        {
+            let mut item = items[0].clone();
+            item.uri = items[1].uri.clone();
+            item
+        },
+        {
+            let mut item = items[0].clone();
+            item.uri.set_query(Some("project_context=invalid"));
+            item
+        },
+    ] {
+        let result = router
+            .supertypes(TypeHierarchySupertypesParams {
+                item: forged,
+                work_done_progress_params: Default::default(),
+                partial_result_params: Default::default(),
+            })
+            .await;
+        assert!(
+            result.is_err(),
+            "foreign/malformed context must be rejected before stripping"
+        );
+    }
+    let recovered = router
+        .supertypes(TypeHierarchySupertypesParams {
+            item: items[0].clone(),
+            work_done_progress_params: Default::default(),
+            partial_result_params: Default::default(),
+        })
+        .await
+        .unwrap()
+        .unwrap_or_default();
+    assert!(recovered.iter().any(|parent| parent.name == "Exception"));
+    router.shutdown().await.unwrap();
+}

+#[tokio::test]
+async fn hierarchy_anonymous_class_creation_reuses_cross_file_inherited_and_trait_origins() {
+    let backend = create_test_backend();
+    let base_uri = Url::parse("file:///AnonymousConstructionBase.php").unwrap();
+    let caller_uri = Url::parse("file:///AnonymousConstructionCaller.php").unwrap();
+    let base = "<?php\r\nclass AnonymousConstructionParent { public function __construct() {} }\r\ntrait AnonymousConstructionInit { public function initialize() {} }\r\n";
+    let caller = concat!(
+        "<?php\r\n",
+        "function inheritedCreation(): void { /* café 🐘 */ $x = new class extends AnonymousConstructionParent {}; }\r\n",
+        "function traitCreation(): void { /* café 🐘 */ $x = new class { use AnonymousConstructionInit { initialize as __construct; } }; }\r\n",
+        "function noConstructorCreation(): void { $x = new class {}; }\r\n",
+    );
+    open_php(&backend, &base_uri, base).await;
+    open_php(&backend, &caller_uri, caller).await;
+    for (factory_name, target_name, site) in [
+        (
+            "inheritedCreation",
+            "__construct",
+            "new class extends AnonymousConstructionParent",
+        ),
+        (
+            "traitCreation",
+            "initialize",
+            "new class { use AnonymousConstructionInit",
+        ),
+    ] {
+        let factory =
+            anonymous_hierarchy_prepare(&backend, &caller_uri, caller, factory_name).await;
+        let target = anonymous_hierarchy_prepare(&backend, &base_uri, base, target_name).await;
+        let range = keyword_constructor_range(caller, site, "class");
+        let edges = outgoing(&backend, &factory).await;
+        assert_eq!(edges.len(), 1);
+        assert_eq!(edges[0].to.uri, base_uri);
+        assert_eq!(edges[0].to.selection_range, target.selection_range);
+        assert_eq!(edges[0].from_ranges, vec![range]);
+        let back = incoming(&backend, &target).await;
+        assert_eq!(back.len(), 1, "no duplicate or trait-metadata invoker");
+        assert_eq!(back[0].from.uri, caller_uri);
+        assert_eq!(back[0].from.selection_range, factory.selection_range);
+        assert_eq!(back[0].from_ranges, vec![range]);
+    }
+    let empty =
+        anonymous_hierarchy_prepare(&backend, &caller_uri, caller, "noConstructorCreation").await;
+    assert!(
+        outgoing(&backend, &empty).await.is_empty(),
+        "no constructor implementation means no fabricated callable"
+    );
+}

+#[tokio::test]
+async fn immediate_object_nonfinal_inherited_trait_and_anonymous_origins_are_exact_and_reciprocal()
+{
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///immediate-object-origin-cases.php").unwrap();
+    let source = concat!(
+        "<?php\r\n",
+        "class DirectInvokeOpen { public function __construct() {} public function __invoke(int $value): void {} }\r\n",
+        "class DirectInvokeParent { public function __construct() {} public function __invoke(int $value): void {} }\r\n",
+        "class DirectInvokeChild extends DirectInvokeParent {}\r\n",
+        "trait DirectInvokeTrait { public function __invoke(int $value): void {} }\r\n",
+        "class DirectInvokeTraitUser { use DirectInvokeTrait; }\r\n",
+        "function openObjectHost(): void { /* café 🐘 */ (new DirectInvokeOpen())(1); }\r\n",
+        "function inheritedObjectHost(): void { /* café 🐘 */ (new DirectInvokeChild())(2); }\r\n",
+        "function traitObjectHost(): void { /* café 🐘 */ (new DirectInvokeTraitUser())(3); }\r\n",
+        "function anonymousOwnObjectHost(): void { /* café 🐘 */ (new class { public function __construct() {} public function __invoke(int $own): void {} })(4); }\r\n",
+        "function anonymousInheritedObjectHost(): void { /* café 🐘 */ (new class extends DirectInvokeParent {})(5); }\r\n",
+    );
+    open_php(&backend, &uri, source).await;
+    for (host_name, method_context, site, arity, count) in [
+        (
+            "openObjectHost",
+            "class DirectInvokeOpen { public function __construct() {} public function __invoke",
+            "(new DirectInvokeOpen())(1)",
+            "(1)",
+            1,
+        ),
+        (
+            "inheritedObjectHost",
+            "class DirectInvokeParent { public function __construct() {} public function __invoke",
+            "(new DirectInvokeChild())(2)",
+            "(2)",
+            2,
+        ),
+        (
+            "traitObjectHost",
+            "trait DirectInvokeTrait { public function __invoke",
+            "(new DirectInvokeTraitUser())(3)",
+            "(3)",
+            1,
+        ),
+        (
+            "anonymousOwnObjectHost",
+            "public function __invoke(int $own)",
+            "public function __invoke(int $own): void {} })(4)",
+            "(4)",
+            1,
+        ),
+        (
+            "anonymousInheritedObjectHost",
+            "class DirectInvokeParent { public function __construct() {} public function __invoke",
+            "(new class extends DirectInvokeParent {})(5)",
+            "(5)",
+            2,
+        ),
+    ] {
+        let host = anonymous_hierarchy_prepare(&backend, &uri, source, host_name).await;
+        let target =
+            immediate_object_target(&backend, &uri, source, method_context, "__invoke").await;
+        let expected = immediate_object_source_range(source, site, arity);
+        let edges = outgoing(&backend, &host).await;
+        let invoke = edges
+            .iter()
+            .filter(|edge| edge.to.name == "__invoke")
+            .collect::<Vec<_>>();
+        assert_eq!(
+            invoke.len(),
+            1,
+            "exact concrete receiver, regardless of final modifier: {host_name}"
+        );
+        assert_eq!(invoke[0].to.uri, uri);
+        assert_eq!(
+            invoke[0].to.selection_range, target.selection_range,
+            "declaring method/trait origin: {host_name}"
+        );
+        assert_eq!(invoke[0].from_ranges, [expected]);
+        assert_eq!(
+            edges.len(),
+            if host_name == "traitObjectHost" { 1 } else { 2 },
+            "retain real constructor independently; no fabricated constructor for trait-only class"
+        );
+        let back = incoming(&backend, &target).await;
+        assert_eq!(
+            back.len(),
+            count,
+            "only actual immediate invocation hosts: {host_name}"
+        );
+        assert_eq!(
+            back.iter()
+                .filter(|call| call.from.uri == uri
+                    && call.from.selection_range == host.selection_range
+                    && call.from_ranges == [expected])
+                .count(),
+            1,
+            "reciprocal caller and exact outer operator: {host_name}"
+        );
+    }
+}

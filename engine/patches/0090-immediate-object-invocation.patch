+fn immediate_object_source_range(source: &str, context: &str, token: &str) -> Range {
+    let offset =
+        source.find(context).expect("extended fixture context") + context.rfind(token).unwrap();
+    let prefix = &source[..offset];
+    let start = Position::new(
+        prefix.bytes().filter(|byte| *byte == b'\n').count() as u32,
+        prefix.rsplit('\n').next().unwrap().encode_utf16().count() as u32,
+    );
+    Range::new(
+        start,
+        Position::new(
+            start.line,
+            start.character + token.encode_utf16().count() as u32,
+        ),
+    )
+}

+async fn immediate_object_target(
+    backend: &Backend,
+    uri: &Url,
+    source: &str,
+    context: &str,
+    token: &str,
+) -> CallHierarchyItem {
+    let range = immediate_object_source_range(source, context, token);
+    let items = prepare_at(backend, uri, range.start.line, range.start.character).await;
+    assert_eq!(items.len(), 1, "public preparation control: {context}");
+    assert_eq!(items[0].selection_range, range);
+    items[0].clone()
+}

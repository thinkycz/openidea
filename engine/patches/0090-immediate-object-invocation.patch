+#[tokio::test]
+async fn immediate_boundary_callable_creation_allocates_without_invoking_the_object() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///immediate-callable-creation.php").unwrap();
+    let source = concat!(
+        "<?php\n",
+        "class CallableCreationInvoker { public function __construct() {} public function __invoke(): void {} }\n",
+        "function createObjectCallable(): \\Closure { return (new CallableCreationInvoker())(...); }\n",
+        "function createAnonymousCallable(): \\Closure { return (new class { public function __construct() {} public function __invoke(): void {} })(...); }\n"
+    );
+    open_php(&backend, &uri, source).await;
+    for name in ["createObjectCallable", "createAnonymousCallable"] {
+        let host = anonymous_hierarchy_prepare(&backend, &uri, source, name).await;
+        let calls = outgoing(&backend, &host).await;
+        assert_eq!(
+            calls.len(),
+            1,
+            "callable creation still allocates the receiver"
+        );
+        assert_eq!(calls[0].to.name, "__construct");
+    }
+    for context in [
+        "class CallableCreationInvoker { public function __construct() {} public function __invoke",
+        "return (new class { public function __construct() {} public function __invoke",
+    ] {
+        let target = immediate_object_target(&backend, &uri, source, context, "__invoke").await;
+        assert!(
+            incoming(&backend, &target).await.is_empty(),
+            "creating a callable does not invoke its body"
+        );
+    }
+}

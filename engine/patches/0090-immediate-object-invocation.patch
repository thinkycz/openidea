+#[tokio::test]
+async fn immediate_boundary_same_length_dirty_receiver_change_replaces_reciprocal_edges() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///immediate-dirty-receiver.php").unwrap();
+    let source = concat!(
+        "<?php\n",
+        "class First { public function __invoke(): void {} }\n",
+        "class Other { public function __invoke(): void {} }\n",
+        "function dirtyObjectHost(): void { (new First())(51); }\n"
+    );
+    let changed = source.replace("(new First())(51)", "(new Other())(51)");
+    assert_eq!(source.len(), changed.len());
+    open_php(&backend, &uri, source).await;
+    let first = immediate_object_target(
+        &backend,
+        &uri,
+        source,
+        "class First { public function __invoke",
+        "__invoke",
+    )
+    .await;
+    let other = immediate_object_target(
+        &backend,
+        &uri,
+        source,
+        "class Other { public function __invoke",
+        "__invoke",
+    )
+    .await;
+    let host = anonymous_hierarchy_prepare(&backend, &uri, source, "dirtyObjectHost").await;
+    immediate_boundary_assert_edge(
+        &backend,
+        &host,
+        &first,
+        vec![immediate_object_source_range(
+            source,
+            "(new First())(51)",
+            "(51)",
+        )],
+    )
+    .await;
+    for (version, current, live, retired, site) in [
+        (2, changed.as_str(), &other, &first, "(new Other())(51)"),
+        (3, source, &first, &other, "(new First())(51)"),
+    ] {
+        backend
+            .did_change(DidChangeTextDocumentParams {
+                text_document: VersionedTextDocumentIdentifier {
+                    uri: uri.clone(),
+                    version,
+                },
+                content_changes: vec![TextDocumentContentChangeEvent {
+                    range: None,
+                    range_length: None,
+                    text: current.to_owned(),
+                }],
+            })
+            .await;
+        let host = anonymous_hierarchy_prepare(&backend, &uri, current, "dirtyObjectHost").await;
+        immediate_boundary_assert_edge(
+            &backend,
+            &host,
+            live,
+            vec![immediate_object_source_range(current, site, "(51)")],
+        )
+        .await;
+        assert!(
+            incoming(&backend, retired).await.is_empty(),
+            "first reply loses old receiver at version {version}"
+        );
+    }
+}

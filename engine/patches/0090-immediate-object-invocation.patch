+    let source = concat!(
+        "<?php\n",
+        "namespace One { class Same { public function __invoke(): void {} } }\n",
+        "namespace Two { class Same { public function __invoke(): void {} } }\n",
+        "namespace Host { use One\\Same as First; use Two\\Same as Second; function firstHost(): void { (new First())(31); } function secondHost(): void { (new Second())(32); } }\n"
+    );
+    open_php(&backend, &uri, source).await;
+    for (host_name, context, site, operator) in [
+        (
+            "firstHost",
+            "namespace One { class Same { public function __invoke",
+            "(new First())(31)",
+            "(31)",
+        ),
+        (
+            "secondHost",
+            "namespace Two { class Same { public function __invoke",
+            "(new Second())(32)",
+            "(32)",
+        ),
+    ] {
+        let host = anonymous_hierarchy_prepare(&backend, &uri, source, host_name).await;
+        let target = immediate_object_target(&backend, &uri, source, context, "__invoke").await;
+        immediate_boundary_assert_edge(
+            &backend,
+            &host,
+            &target,
+            vec![immediate_object_source_range(source, site, operator)],
+        )
+        .await;
+        assert_eq!(incoming(&backend, &target).await.len(), 1);
+    }
+    // Entire source and body braces collide; the only distinction is source URI.
+    let anonymous = "<?php\n(new class { public function __invoke(): void {} })(33);\n";
+    let a = Url::parse("file:///immediate-anonymous-owner-a.php").unwrap();
+    let b = Url::parse("file:///immediate-anonymous-owner-b.php").unwrap();
+    open_php(&backend, &a, anonymous).await;
+    open_php(&backend, &b, anonymous).await;
+    for owner in [&a, &b] {
+        let mut prepared_file = prepare_at(&backend, owner, 0, 0).await;
+        assert_eq!(prepared_file.len(), 1);
+        let host = prepared_file.remove(0);
+        assert_eq!(host.kind, SymbolKind::FILE);
+        let target =
+            immediate_object_target(&backend, owner, anonymous, "function __invoke", "__invoke")
+                .await;
+        assert_eq!(&target.uri, owner);
+        immediate_boundary_assert_edge(
+            &backend,
+            &host,
+            &target,
+            vec![immediate_object_source_range(
+                anonymous,
+                "public function __invoke(): void {} })(33)",
+                "(33)",
+            )],
+        )
+        .await;
+        let back = incoming(&backend, &target).await;
+        assert_eq!(back.len(), 1);
+        assert_eq!(
+            &back[0].from.uri, owner,
+            "no same-brace cross-file borrowing"
+        );
+    }
+}

+fn immediate_object_range(context: &str, token: &str) -> Range {
+    let start = IMMEDIATE_OBJECT_SOURCE
+        .find(context)
+        .expect("unique fixture context")
+        + context.rfind(token).expect("exact token in context");
+    let prefix = &IMMEDIATE_OBJECT_SOURCE[..start];
+    let position = Position::new(
+        prefix.bytes().filter(|byte| *byte == b'\n').count() as u32,
+        prefix.rsplit('\n').next().unwrap().encode_utf16().count() as u32,
+    );
+    Range::new(
+        position,
+        Position::new(
+            position.line,
+            position.character + token.encode_utf16().count() as u32,
+        ),
+    )
+}

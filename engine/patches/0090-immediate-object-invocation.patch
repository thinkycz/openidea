+#[tokio::test]
+async fn immediate_boundary_php_and_blade_file_calls_do_not_steal_nested_closure_sites() {
+    let backend = create_test_backend();
+    let definition_uri = Url::parse("file:///immediate-file-target.php").unwrap();
+    let definition = "<?php\nclass FileBoundaryInvoker { public function __invoke(): void {} }\n";
+    open_php(&backend, &definition_uri, definition).await;
+    let target = immediate_object_target(
+        &backend,
+        &definition_uri,
+        definition,
+        "function __invoke",
+        "__invoke",
+    )
+    .await;
+    for (uri_text, source, blade) in [
+        (
+            "file:///immediate-file-owner.php",
+            "<?php\r\n/* 🐘 */ (new FileBoundaryInvoker())(41);\r\n$nested = static function () { (new FileBoundaryInvoker())(42); };\r\n",
+            false,
+        ),
+        (
+            "file:///immediate-file-owner.blade.php",
+            "<p>café 🐘</p>\r\n@php\r\n/* 🐘 */ (new FileBoundaryInvoker())(41);\r\n$nested = static function () { (new FileBoundaryInvoker())(42); };\r\n@endphp\r\n",
+            true,
+        ),
+    ] {
+        let uri = Url::parse(uri_text).unwrap();
+        if blade {
+            crate::common::open_document(&backend, &uri, "blade", source).await;
+        } else {
+            open_php(&backend, &uri, source).await;
+        }
+        let mut items = prepare_at(&backend, &uri, 0, 0).await;
+        assert_eq!(items.len(), 1);
+        let file = items.remove(0);
+        assert_eq!(file.kind, SymbolKind::FILE);
+        assert_eq!(
+            file.selection_range,
+            Range::new(Position::new(0, 0), Position::new(0, 0))
+        );
+        let closure = anonymous_hierarchy_prepare(&backend, &uri, source, "function ()").await;
+        immediate_boundary_assert_edge(
+            &backend,
+            &file,
+            &target,
+            vec![immediate_object_source_range(
+                source,
+                "(new FileBoundaryInvoker())(41)",
+                "(41)",
+            )],
+        )
+        .await;
+        immediate_boundary_assert_edge(
+            &backend,
+            &closure,
+            &target,
+            vec![immediate_object_source_range(
+                source,
+                "(new FileBoundaryInvoker())(42)",
+                "(42)",
+            )],
+        )
+        .await;
+        assert_eq!(
+            outgoing(&backend, &file).await.len(),
+            1,
+            "assigned nested closure body is not file execution"
+        );
+        let back = incoming(&backend, &target).await;
+        let local = back
+            .iter()
+            .filter(|call| call.from.uri == uri)
+            .collect::<Vec<_>>();
+        assert_eq!(
+            local.len(),
+            2,
+            "logical file + nested closure, no generated wrapper"
+        );
+        assert!(
+            local
+                .iter()
+                .all(|call| !call.from.name.contains("__blade_template"))
+        );
+    }
+}

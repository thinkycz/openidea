+async fn immediate_boundary_assert_edge(
+    backend: &Backend,
+    host: &CallHierarchyItem,
+    target: &CallHierarchyItem,
+    expected: Vec<Range>,
+) {
+    let edges = outgoing(backend, host).await;
+    let matched = edges
+        .iter()
+        .filter(|edge| {
+            edge.to.uri == target.uri && edge.to.selection_range == target.selection_range
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(matched.len(), 1, "one concrete target from {}", host.name);
+    assert_eq!(
+        immediate_object_sorted_ranges(matched[0].from_ranges.clone()),
+        immediate_object_sorted_ranges(expected.clone())
+    );
+    let callers = incoming(backend, target).await;
+    let matched = callers
+        .iter()
+        .filter(|call| {
+            call.from.uri == host.uri && call.from.selection_range == host.selection_range
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(matched.len(), 1, "one reciprocal caller {}", host.name);
+    assert_eq!(
+        immediate_object_sorted_ranges(matched[0].from_ranges.clone()),
+        immediate_object_sorted_ranges(expected)
+    );
+}

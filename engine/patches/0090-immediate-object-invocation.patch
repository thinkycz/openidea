+#[tokio::test]
+async fn immediate_object_constructor_and_explicit_invoke_are_independent_positive_controls() {
+    let (backend, uri) = immediate_object_fixture().await;
+    let host = anonymous_hierarchy_prepare(
+        &backend,
+        &uri,
+        IMMEDIATE_OBJECT_SOURCE,
+        "immediateObjectHost",
+    )
+    .await;
+    let edges = outgoing(&backend, &host).await;
+    let constructors = edges
+        .iter()
+        .filter(|edge| edge.to.name == "__construct")
+        .collect::<Vec<_>>();
+    assert_eq!(constructors.len(), 1);
+    assert_eq!(
+        constructors[0].from_ranges,
+        [
+            immediate_object_range(
+                "(((new ImmediateObjectInvoker())))(7)",
+                "ImmediateObjectInvoker"
+            ),
+            immediate_object_range(
+                "(new ImmediateObjectInvoker())->__invoke(8)",
+                "ImmediateObjectInvoker"
+            ),
+        ]
+    );
+    let invokes = edges
+        .iter()
+        .filter(|edge| edge.to.name == "__invoke")
+        .collect::<Vec<_>>();
+    assert_eq!(
+        invokes.len(),
+        1,
+        "explicit __invoke resolves to the declared method"
+    );
+    assert!(
+        invokes[0]
+            .from_ranges
+            .contains(&immediate_object_range("->__invoke(8)", "__invoke"))
+    );
+    assert_ne!(
+        constructors[0].to.selection_range,
+        invokes[0].to.selection_range
+    );
+    assert_eq!(constructors[0].to.uri, uri);
+    assert_eq!(invokes[0].to.uri, uri);
+    let constructor_callers = incoming(&backend, &constructors[0].to).await;
+    assert_eq!(
+        constructor_callers.len(),
+        2,
+        "host and construction-only function, independently of __invoke"
+    );
+    let host_callers = constructor_callers
+        .iter()
+        .filter(|call| call.from.uri == uri && call.from.selection_range == host.selection_range)
+        .collect::<Vec<_>>();
+    assert_eq!(host_callers.len(), 1);
+    assert_eq!(
+        immediate_object_sorted_ranges(host_callers[0].from_ranges.clone()),
+        constructors[0].from_ranges
+    );
+}

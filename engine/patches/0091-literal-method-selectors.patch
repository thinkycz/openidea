+#[tokio::test]
+async fn literal_selector_stale_encoded_reference_refuses_all_edits_then_exact_restore_recovers() {
+    let backend = create_test_backend();
+    let definition_uri = Url::parse("file:///literal-stale-declaration.php").unwrap();
+    let usage_uri = Url::parse("file:///literal-stale-usage.php").unwrap();
+    let definition = "<?php\nclass LiteralStaleTarget { public function run(): void {} public function sun(): void {} }\n";
+    let before = "<?php\nfunction useLiteral(LiteralStaleTarget $object): void { $object->{\"\\x72un\"}(); }\n";
+    let after = before.replace("\\x72un", "\\x73un");
+    assert_eq!(before.len(), after.len());
+    open_php(&backend, &definition_uri, definition).await;
+    open_php(&backend, &usage_uri, before).await;
+    let (decl_line, decl_character) = line_char_of(definition, "function run(");
+    let (use_line, use_character) = line_char_of(before, "\\x72un");
+    assert!(
+        prepare_rename(&backend, &usage_uri, use_line, use_character + 1)
+            .await
+            .is_some()
+    );
+    // Reuse the existing deterministic stale-buffer seam, not a timing race.
+    set_buffer_without_reparsing(&backend, &usage_uri, &after);
+    assert!(
+        prepare_rename(&backend, &usage_uri, use_line, use_character + 1)
+            .await
+            .is_none()
+    );
+    assert!(
+        rename(
+            &backend,
+            &definition_uri,
+            decl_line,
+            decl_character + 9,
+            "execute"
+        )
+        .await
+        .is_none(),
+        "one stale decoded reference refuses the whole declaration rename"
+    );
+    set_buffer_without_reparsing(&backend, &usage_uri, before);
+    let edit = rename(
+        &backend,
+        &definition_uri,
+        decl_line,
+        decl_character + 9,
+        "execute",
+    )
+    .await
+    .expect("exact source restoration satisfies retained role receipt");
+    assert_eq!(
+        apply_edits(before, &edits_for_uri(&edit, &usage_uri)),
+        before.replace("\\x72un", "execute")
+    );
+    assert_eq!(
+        apply_edits(definition, &edits_for_uri(&edit, &definition_uri)),
+        definition.replace("function run(", "function execute(")
+    );
+}

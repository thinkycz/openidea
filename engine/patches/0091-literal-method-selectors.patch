+const LITERAL_RENAME_SOURCE: &str = concat!(
+    "<?php\r\n",
+    "class LiteralRenameTarget { public function run(int $value): void {} }\r\n",
+    "function literalRenameHost(LiteralRenameTarget $object, ?LiteralRenameTarget $nullable): void {\r\n",
+    " /* café 🐘 */ $object->{'run'}(1);\r\n",
+    " $object->{\"\\x72un\"}(2);\r\n",
+    " $nullable?->{B\"\\x72un\"}(3);\r\n",
+    " $object->{(b'run')}(4);\r\n",
+    " $created = $object->{B\"\\x72un\"}(...);\r\n",
+    "}\r\n",
+);

+    " /* café 🐘 */ $object->{\"\\x72un\"}();\r\n",
+    "}\r\n",
+    "function nullsafeLiteralHost(?LiteralObjectTarget $object): void {\r\n",
+    " /* café 🐘 */ $object?->run();\r\n",
+    " /* café 🐘 */ $object?->{'run'}();\r\n",
+    " /* café 🐘 */ $object?->{\"\\x72un\"}();\r\n",
+    "}\r\n",
+    "function staticLiteralHost(): void {\r\n",
+    " /* café 🐘 */ LiteralStaticTarget::run();\r\n",
+    " /* café 🐘 */ LiteralStaticTarget::{'run'}();\r\n",
+    " /* café 🐘 */ LiteralStaticTarget::{\"\\x72un\"}();\r\n",
+    "}\r\n",
+    "function dynamicSelectorHost(LiteralObjectTarget $object, ?LiteralObjectTarget $nullable, string $method): void {\r\n",
+    " $object->{$method}(); $nullable?->{$method}(); LiteralStaticTarget::{$method}();\r\n",
+    "}\r\n",
+    "function creationSelectorHost(LiteralObjectTarget $object): void {\r\n",
+    " $ordinary = $object->{'run'}(...); $static = LiteralStaticTarget::{'run'}(...);\r\n",
+    "}\r\n",
+    // PHP single-quoted strings do not decode hexadecimal escapes.
+    "function singleQuotedEscapeHost(LiteralObjectTarget $object): void { $object->{'\\x72un'}(); }\r\n",
+);
+
+async fn literal_method_fixture() -> (Backend, Url) {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///literal-method-selector-hierarchy.php").unwrap();
+    open_php(&backend, &uri, LITERAL_METHOD_SOURCE).await;
+    (backend, uri)
+}
+
+fn literal_method_range(context: &str, token: &str) -> Range {
+    let offset = LITERAL_METHOD_SOURCE
+        .find(context)
+        .expect("unique source context")
+        + context.rfind(token).expect("source token");
+    let prefix = &LITERAL_METHOD_SOURCE[..offset];
+    let start = Position::new(
+        prefix.bytes().filter(|byte| *byte == b'\n').count() as u32,
+        prefix.rsplit('\n').next().unwrap().encode_utf16().count() as u32,
+    );
+    Range::new(
+        start,
+        Position::new(
+            start.line,
+            start.character + token.encode_utf16().count() as u32,
+        ),
+    )
+}
+
+fn literal_method_sorted_ranges(mut ranges: Vec<Range>) -> Vec<Range> {
+    ranges.sort_by_key(|range| {
+        (
+            range.start.line,
+            range.start.character,
+            range.end.line,
+            range.end.character,
+        )
+    });
+    ranges
+}
+
+async fn literal_method_target(
+    backend: &Backend,
+    uri: &Url,
+    static_target: bool,
+) -> CallHierarchyItem {
+    let context = if static_target {
+        "class LiteralStaticTarget { public static function run"
+    } else {
+        "class LiteralObjectTarget { public function run"
+    };
+    let range = literal_method_range(context, "run");
+    let items = prepare_at(backend, uri, range.start.line, range.start.character).await;
+    assert_eq!(items.len(), 1, "literal target declaration positive");
+    assert_eq!(items[0].selection_range, range);
+    items[0].clone()
+}
+
+fn literal_method_expected(static_target: bool, nullsafe: bool) -> Vec<Range> {
+    let receiver = if static_target {
+        "LiteralStaticTarget::"
+    } else if nullsafe {
+        "$object?->"
+    } else {
+        "$object->"
+    };
+    vec![
+        literal_method_range(&format!("{receiver}run();"), "run"),
+        literal_method_range(&format!("{receiver}{{'run'}}();"), "run"),
+        // The target is decoded run, but the invocation range retains the six
+        // raw source characters \x72un, never a fabricated 3-character span.
+        literal_method_range(&format!("{receiver}{{\"\\x72un\"}}();"), "\\x72un"),
+    ]
+}
+
+#[tokio::test]
+async fn literal_method_identifier_positives_cover_ordinary_nullsafe_and_static_receivers() {
+    let (backend, uri) = literal_method_fixture().await;
+    for (name, static_target, nullsafe) in [
+        ("ordinaryLiteralHost", false, false),
+        ("nullsafeLiteralHost", false, true),
+        ("staticLiteralHost", true, false),
+    ] {
+        let host = anonymous_hierarchy_prepare(&backend, &uri, LITERAL_METHOD_SOURCE, name).await;
+        let target = literal_method_target(&backend, &uri, static_target).await;
+        let edges = outgoing(&backend, &host).await;
+        assert_eq!(edges.len(), 1);
+        assert_eq!(edges[0].to.uri, uri);
+        assert_eq!(edges[0].to.selection_range, target.selection_range);
+        assert!(
+            edges[0]
+                .from_ranges
+                .contains(&literal_method_expected(static_target, nullsafe)[0]),
+            "existing Identifier positive: {name}"
+        );
+    }
+}
+
+#[tokio::test]
+async fn literal_method_string_selectors_have_exact_ordinary_nullsafe_and_static_outgoing_sites() {
+    let (backend, uri) = literal_method_fixture().await;
+    for (name, static_target, nullsafe) in [
+        ("ordinaryLiteralHost", false, false),
+        ("nullsafeLiteralHost", false, true),
+        ("staticLiteralHost", true, false),
+    ] {
+        let host = anonymous_hierarchy_prepare(&backend, &uri, LITERAL_METHOD_SOURCE, name).await;
+        let target = literal_method_target(&backend, &uri, static_target).await;
+        let edges = outgoing(&backend, &host).await;
+        assert_eq!(
+            edges.len(),
+            1,
+            "one real method, not one node per spelling: {name}"
+        );
+        assert_eq!(edges[0].to.uri, uri);
+        assert_eq!(edges[0].to.selection_range, target.selection_range);
+        assert_eq!(
+            literal_method_sorted_ranges(edges[0].from_ranges.clone()),
+            literal_method_expected(static_target, nullsafe),
+            "all actual invocation spellings: {name}"
+        );
+    }
+}
+
+#[tokio::test]
+async fn literal_method_string_selectors_have_reciprocal_exact_incoming_sites() {
+    let (backend, uri) = literal_method_fixture().await;
+    for (static_target, names) in [
+        (false, vec!["ordinaryLiteralHost", "nullsafeLiteralHost"]),
+        (true, vec!["staticLiteralHost"]),
+    ] {
+        let target = literal_method_target(&backend, &uri, static_target).await;
+        let callers = incoming(&backend, &target).await;
+        assert_eq!(
+            callers.len(),
+            names.len(),
+            "no creation/dynamic/incorrectly decoded extra callers"
+        );
+        for name in names {
+            let host =
+                anonymous_hierarchy_prepare(&backend, &uri, LITERAL_METHOD_SOURCE, name).await;
+            let matches = callers
+                .iter()
+                .filter(|call| {
+                    call.from.uri == uri && call.from.selection_range == host.selection_range
+                })
+                .collect::<Vec<_>>();
+            assert_eq!(matches.len(), 1);
+            assert_eq!(
+                literal_method_sorted_ranges(matches[0].from_ranges.clone()),
+                literal_method_expected(static_target, name == "nullsafeLiteralHost")
+            );
+        }
+    }
+}
+
+#[tokio::test]
+async fn literal_method_dynamic_selectors_callable_creation_and_single_quote_escapes_do_not_invent_run()
+ {
+    let (backend, uri) = literal_method_fixture().await;
+    for name in [
+        "dynamicSelectorHost",
+        "creationSelectorHost",
+        "singleQuotedEscapeHost",
+    ] {
+        let host = anonymous_hierarchy_prepare(&backend, &uri, LITERAL_METHOD_SOURCE, name).await;
+        assert!(
+            outgoing(&backend, &host).await.is_empty(),
+            "not a proven invocation of run: {name}"
+        );
+    }
+}

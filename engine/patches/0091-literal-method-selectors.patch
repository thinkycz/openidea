+    set_buffer_without_reparsing(&backend, &uri, &after);
+    assert!(
+        prepare_rename(&backend, &uri, line, character + 1)
+            .await
+            .is_none(),
+        "generic raw 'run' spelling cannot override stale literal-role fingerprint"
+    );
+    let (decl_line, decl_character) = line_char_of(before, "function run(");

+    let before = "<?php\nclass PlainLiteralTarget { public function run(): void {} }\nfunction usePlain(PlainLiteralTarget $object): void {\n $object->{'run'}();      \n}\n";
+    // The old method-name bytes AND complete quoted literal remain at their
+    // original offsets, but are now inside a comment, not an invocation AST.
+    let after = before
+        .replace("$object->", "/*       ")

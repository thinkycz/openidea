 use super::*;
 
+/// A fixed selector's semantic name and exact raw source range.
+struct KnownMethodSelector {
+    name: crate::atom::Atom,
+    start: u32,
+    end: u32,
+}
+
+/// Only identifiers and plain quoted literals inside brace selectors are fixed.
+/// Mago supplies decoding; source bytes supply quote/prefix/interior boundaries.
+fn known_method_selector<'a>(
+    selector: &'a ClassLikeMemberSelector<'a>,
+    ctx: &mut ExtractionCtx<'a>,
+) -> Option<KnownMethodSelector> {
+    if let ClassLikeMemberSelector::Identifier(ident) = selector {
+        return Some(KnownMethodSelector {
+            name: crate::atom::atom_bytes(ident.value),
+            start: ident.span.start.offset,
+            end: ident.span.end.offset,
+        });
+    }
+    let ClassLikeMemberSelector::Expression(selector) = selector else {
+        return None;
+    };
+    let mut expression = selector.expression;
+    while let Expression::Parenthesized(parenthesized) = expression {
+        expression = parenthesized.expression;
+    }
+    let Expression::Literal(literal::Literal::String(literal)) = expression else {
+        return None;
+    };
+    let name = literal.value.and_then(literal_bytes_to_str)?;
+    if name.is_empty() {
+        return None;
+    }
+    let raw = ctx
+        .content
+        .get(literal.span.start.offset as usize..literal.span.end.offset as usize)?;
+    let bytes = raw.as_bytes();
+    let (prefix_len, quote) = match bytes {
+        [quote @ (b'\'' | b'"'), ..] => (1, *quote),
+        [b'b' | b'B', quote @ (b'\'' | b'"'), ..] => (2, *quote),
+        _ => return None,
+    };
+    if bytes.last() != Some(&quote) {
+        return None;
+    }
+    let start = literal.span.start.offset.checked_add(prefix_len)?;
+    let end = literal.span.end.offset.checked_sub(1)?;
+    if start >= end {
+        return None;
+    }
+    let name = crate::atom::atom(name);
+    ctx.literal_method_selectors.push(LiteralMethodSelector {
+        start,
+        end,
+        literal_start: literal.span.start.offset,
+        literal_end: literal.span.end.offset,
+        raw_literal: raw.into(),
+        name,
+    });
+    Some(KnownMethodSelector { name, start, end })
+}

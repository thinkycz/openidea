+fn literal_rename_expected(source: &str) -> String {
+    source
+        .replace("function run(", "function execute(")
+        .replace("{'run'}", "{'execute'}")
+        .replace("{\"\\x72un\"}", "{\"execute\"}")
+        .replace("{B\"\\x72un\"}", "{B\"execute\"}")
+        .replace("{(b'run')}", "{(b'execute')}")
+}

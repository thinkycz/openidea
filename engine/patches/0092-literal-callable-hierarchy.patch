+/// Accept only names PHP declarations can spell, with one optional root slash.
+/// Do not normalize malformed runtime strings into existing symbols.
+fn valid_literal_callable_target(target: &str) -> bool {
+    fn identifier(name: &str) -> bool {
+        let mut bytes = name.bytes();
+        let Some(first) = bytes.next() else {
+            return false;
+        };
+        (first == b'_' || first.is_ascii_alphabetic() || first >= 0x80)
+            && bytes.all(|b| b == b'_' || b.is_ascii_alphanumeric() || b >= 0x80)
+    }
+    let target = target.strip_prefix('\\').unwrap_or(target);
+    let (name, method) = match target.split_once("::") {
+        Some((name, method)) => (name, Some(method)),
+        None => (target, None),
+    };
+    name.split('\\').all(identifier) && method.is_none_or(identifier)
+}

+    "  /* café 🐘 */ ('SCALARLEAF')(14);\r\n",
+    "  /* café 🐘 */ (b\"\\x73calarLeaf\")(15);\r\n",
+    "  /* café 🐘 */ ('ScalarTarget::run')(21);\r\n",
+    "  /* café 🐘 */ ('\\ScalarTarget::run')(22);\r\n",
+    "  /* café 🐘 */ ('CallScope\\ScalarTarget::run')(23);\r\n",
+    "  /* café 🐘 */ ('SCALARTARGET::RUN')(24);\r\n",
+    " }\r\n",
+    " function literalCallableNegatives(callable $dynamic): void {\r\n",
+    "  $stored = 'scalarLeaf'; $dynamic(98);\r\n",
+    "  ('importedLeaf')(91); ('ImportedTarget::run')(92); ('\\x73calarLeaf')(93);\r\n",
+    "  $functionCreation = ('scalarLeaf')(...); $methodCreation = ('ScalarTarget::run')(...);\r\n",
+    " }\r\n}\r\n",
+);
+
+fn literal_callable_range(source: &str, context: &str, token: &str) -> Range {
+    let offset = source.find(context).expect("unique fixture context")
+        + context.rfind(token).expect("source token");
+    let prefix = &source[..offset];
+    let start = Position::new(
+        prefix.bytes().filter(|byte| *byte == b'\n').count() as u32,
+        prefix.rsplit('\n').next().unwrap().encode_utf16().count() as u32,
+    );
+    Range::new(
+        start,
+        Position::new(
+            start.line,
+            start.character + token.encode_utf16().count() as u32,
+        ),
+    )
+}
+fn literal_callable_sorted(mut ranges: Vec<Range>) -> Vec<Range> {
+    ranges.sort_by_key(|r| (r.start.line, r.start.character, r.end.line, r.end.character));
+    ranges
+}
+async fn literal_callable_target(
+    backend: &Backend,
+    uri: &Url,
+    source: &str,
+    context: &str,
+    token: &str,
+) -> CallHierarchyItem {
+    let range = literal_callable_range(source, context, token);
+    let items = prepare_at(backend, uri, range.start.line, range.start.character).await;
+    assert_eq!(items.len(), 1, "public declaration positive: {context}");
+    assert_eq!(items[0].uri, *uri);
+    assert_eq!(items[0].selection_range, range);
+    items[0].clone()
+}
+async fn literal_callable_fixture() -> (Backend, Url) {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///literal-callable-scope.php").unwrap();
+    open_php(&backend, &uri, LITERAL_CALLABLE_SOURCE).await;
+    (backend, uri)
+}
+
+fn literal_callable_expected(which: usize) -> Vec<Range> {
+    let sites: &[(&str, &str)] = match which {
+        0 => &[
+            ("scalarLeaf(); importedLeaf();", "importedLeaf"),
+            ("((('scalarLeaf')))(11)", "(11)"),
+            ("('\\scalarLeaf')(12)", "(12)"),
+            ("('SCALARLEAF')(14)", "(14)"),
+            ("(b\"\\x73calarLeaf\")(15)", "(15)"),
+        ],
+        1 => &[
+            ("scalarLeaf(); importedLeaf();", "scalarLeaf"),
+            ("('CallScope\\scalarLeaf')(13)", "(13)"),
+        ],
+        2 => &[
+            ("ImportedTarget::run();", "run"),
+            ("('ScalarTarget::run')(21)", "(21)"),
+            ("('\\ScalarTarget::run')(22)", "(22)"),
+            ("('SCALARTARGET::RUN')(24)", "(24)"),
+        ],
+        3 => &[
+            ("ScalarTarget::run(); ImportedTarget", "run"),
+            ("('CallScope\\ScalarTarget::run')(23)", "(23)"),
+        ],
+        _ => unreachable!(),
+    };
+    sites
+        .iter()
+        .map(|(context, token)| literal_callable_range(LITERAL_CALLABLE_SOURCE, context, token))
+        .collect()
+}
+async fn literal_callable_targets(backend: &Backend, uri: &Url) -> Vec<CallHierarchyItem> {
+    let mut items = Vec::new();
+    // Context includes namespace plus declaration so equal short names cannot
+    // choose whichever file-level declaration happens to be indexed first.
+    for (context, token) in [
+        ("namespace {\r\n function scalarLeaf", "scalarLeaf"),
+        (
+            "function scalarLeaf(): void {}\r\n class ScalarTarget { public static function run",
+            "run",
+        ),
+    ] {
+        items.push(
+            literal_callable_target(backend, uri, LITERAL_CALLABLE_SOURCE, context, token).await,
+        );
+    }
+    let local_function = literal_callable_target(backend, uri, LITERAL_CALLABLE_SOURCE,
+        "use function \\scalarLeaf as importedLeaf; use \\ScalarTarget as ImportedTarget;\r\n function scalarLeaf", "scalarLeaf").await;
+    let local_static = literal_callable_target(backend, uri, LITERAL_CALLABLE_SOURCE,
+        "class ScalarTarget { public static function run(): void {} }\r\n function literalCallableHost", "run").await;
+    // Expected order: global function, local function, global static, local static.
+    vec![
+        items.remove(0),
+        local_function,
+        items.remove(0),
+        local_static,
+    ]
+}

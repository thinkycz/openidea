+#[tokio::test]
+async fn literal_callable_anonymous_source_receipts_reject_other_uri_and_same_length_edits() {
+    let backend = create_test_backend();
+    let target_uri = Url::parse("file:///literal-callable-guard-targets.php").unwrap();
+    let targets = "<?php\r\nnamespace Guard;\r\nfunction guardLeaf(): void {}\r\nfunction guardElse(): void {}\r\n";
+    open_php(&backend, &target_uri, targets).await;
+    let left = Url::parse("file:///literal-callable-guard-left.php").unwrap();
+    let right = Url::parse("file:///literal-callable-guard-right.php").unwrap();
+    let source = "<?php\r\n/* café 🐘 */ $guarded = function () { \\Guard\\guardLeaf(); ('Guard\\guardLeaf')(31); };\r\n";
+    for uri in [&left, &right] {
+        open_php(&backend, uri, source).await;
+    }
+    let first = anonymous_hierarchy_prepare(&backend, &left, source, "function ()").await;
+    let peer = anonymous_hierarchy_prepare(&backend, &right, source, "function ()").await;
+    for item in [&first, &peer] {
+        let edges = outgoing(&backend, item).await;
+        assert_eq!(
+            edges.len(),
+            1,
+            "genuine positive before deliberate source forgery"
+        );
+        assert_eq!(edges[0].to.uri, target_uri);
+        assert!(edges[0].from_ranges.contains(&literal_callable_range(
+            source,
+            "\\Guard\\guardLeaf();",
+            "\\Guard\\guardLeaf"
+        )));
+    }
+    let mut forged = first.clone();
+    forged.uri = right.clone();
+    assert!(
+        outgoing(&backend, &forged).await.is_empty(),
+        "same bytes/brace offsets do not authorize another URI"
+    );
+    let mut stripped = first.clone();
+    stripped
+        .data
+        .as_mut()
+        .unwrap()
+        .as_object_mut()
+        .unwrap()
+        .remove("anonymous");
+    assert!(
+        outgoing(&backend, &stripped).await.is_empty(),
+        "removing an anonymous source discriminator cannot bypass its current declaration guard"
+    );
+    let dirty = source.replace("('Guard\\guardLeaf')(31)", "('Guard\\guardElse')(31)");
+    assert_ne!(dirty, source);
+    assert_eq!(dirty.len(), source.len());
+    anonymous_hierarchy_change(&backend, &left, &dirty).await;
+    assert!(
+        outgoing(&backend, &first).await.is_empty(),
+        "retained exact source item cannot retarget after same-length edit"
+    );
+    let fresh = anonymous_hierarchy_prepare(&backend, &left, &dirty, "function ()").await;
+    let changed = outgoing(&backend, &fresh).await;
+    assert_eq!(
+        changed.len(),
+        2,
+        "fresh literal call reaches Else while explicit identifier still reaches Leaf"
+    );
+    let else_item = literal_callable_target(
+        &backend,
+        &target_uri,
+        targets,
+        "function guardElse",
+        "guardElse",
+    )
+    .await;
+    let found = changed
+        .iter()
+        .filter(|edge| {
+            edge.to.uri == target_uri && edge.to.selection_range == else_item.selection_range
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(found.len(), 1);
+    assert_eq!(
+        found[0].from_ranges,
+        [literal_callable_range(
+            &dirty,
+            "('Guard\\guardElse')(31)",
+            "(31)"
+        )]
+    );
+    // The untouched peer keeps its original source identity and target.
+    assert_eq!(outgoing(&backend, &peer).await.len(), 1);
+}

+#[tokio::test]
+async fn builtin_callable_qualified_context_keeps_immutable_target_coordinates_and_reciprocal_owner()
+ {
+    use phpantom_lsp::{ProjectRouter, workbench_builtins::BuiltinQuery};
+    let temp = tempfile::tempdir().unwrap();

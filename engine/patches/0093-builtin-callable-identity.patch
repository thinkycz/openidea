+                uri: edge.to.uri.to_string(),
+            })
+            .await
+            .unwrap();
+        assert_eq!(document.uri, edge.to.uri.to_string());
+        let oracle =
+            builtin_identity_oracle(Url::parse(canonical).unwrap(), document.content, method);
+        builtin_identity_assert(&edge.to, &oracle, true);
+        let callers = router
+            .incoming_calls(CallHierarchyIncomingCallsParams {
+                item: edge.to.clone(),
+                work_done_progress_params: Default::default(),
+                partial_result_params: Default::default(),
+            })
+            .await
+            .unwrap()
+            .unwrap_or_default();
+        assert_eq!(callers.len(), 1);
+        assert_eq!(callers[0].from.uri, uri);
+        assert_eq!(callers[0].from.selection_range, host.selection_range);
+        assert_eq!(
+            callers[0].from_ranges,
+            [builtin_identity_expected(true, method)]

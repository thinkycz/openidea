+        anonymous_hierarchy_prepare(&backend, &source_uri, source, "builtinClassSourceHost").await;
+    let first = outgoing(&backend, &host).await;
+    assert_eq!(first.len(), 1);
+    builtin_identity_assert(&first[0].to, &expected, false);
+    let forged = "<?php\r\nclass DateTimeImmutable { public static function createFromFormat(...$args) {} }\r\n";
+    open_php(&backend, &uri, forged).await;
+    let getter = backend
+        .workbench_builtin(BuiltinQuery {
+            uri: uri.to_string(),

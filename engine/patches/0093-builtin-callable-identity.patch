+    assert_eq!(
+        after.len(),
+        1,
+        "immutable builtin stays available after forbidden replacement input"
+    );
+    builtin_identity_assert(&after[0].to, &expected, false);
+    assert_eq!(
+        first, after,
+        "no forged or older overload coordinates are admitted"
+    );

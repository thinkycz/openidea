+#[tokio::test]
+async fn builtin_function_sibling_first_publication_keeps_later_canonical_prepare_and_incoming() {
+    use phpantom_lsp::{types::PhpVersion, workbench_builtins::BuiltinQuery};
+    let backend = crate::common::create_test_backend_with_full_stubs();
+    backend.set_php_version(PhpVersion::new(8, 3));
+    let earlier_uri = Url::parse("phpantom-stub-fn://addslashes").unwrap();
+    let canonical_uri = Url::parse("phpantom-stub-fn://strtolower").unwrap();
+    let earlier_doc = backend
+        .workbench_builtin(BuiltinQuery {
+            uri: earlier_uri.to_string(),
+        })
+        .await
+        .unwrap();
+    let later_doc = backend
+        .workbench_builtin(BuiltinQuery {
+            uri: canonical_uri.to_string(),
+        })
+        .await
+        .unwrap();
+    assert_eq!(
+        earlier_doc.content, later_doc.content,
+        "actual two-function shared raw catalog source; getter does not parse/warm"
+    );
+    let earlier = builtin_identity_function_oracle("addslashes", earlier_doc.content);
+    let later = builtin_identity_function_oracle("strtolower", later_doc.content);
+    let first_uri = Url::parse("file:///builtin-sibling-first.php").unwrap();
+    let first_source = "<?php\r\nfunction firstBuiltinSibling(): void { addslashes('a'); }\r\n";
+    open_php(&backend, &first_uri, first_source).await;
+    let first =
+        anonymous_hierarchy_prepare(&backend, &first_uri, first_source, "firstBuiltinSibling")
+            .await;
+    let first_edges = outgoing(&backend, &first).await;
+    assert_eq!(first_edges.len(), 1);
+    builtin_identity_assert(&first_edges[0].to, &earlier, false);
+    let later_uri = Url::parse("file:///builtin-sibling-later.php").unwrap();
+    let later_source = "<?php\r\nfunction laterBuiltinSibling(): void { /* café 🐘 */ strtolower('B'); ('strtolower')('C'); }\r\n";
+    open_php(&backend, &later_uri, later_source).await;
+    let host =
+        anonymous_hierarchy_prepare(&backend, &later_uri, later_source, "laterBuiltinSibling")
+            .await;
+    let edges = outgoing(&backend, &host).await;
+    assert_eq!(
+        edges.len(),
+        1,
+        "earlier sibling cannot own/hide the later canonical function"
+    );
+    builtin_identity_assert(&edges[0].to, &later, false);
+    let prepared = prepare_at(
+        &backend,
+        &canonical_uri,
+        later.selection.start.line,
+        later.selection.start.character,
+    )
+    .await;
+    assert_eq!(
+        prepared.len(),
+        1,
+        "top-level canonical source prepare cannot skip a declaration indexed under alphabetic sibling URI"
+    );
+    builtin_identity_assert(&prepared[0], &later, false);
+    let calls = incoming(&backend, &prepared[0]).await;
+    assert_eq!(calls.len(), 1);
+    assert_eq!(calls[0].from.uri, later_uri);
+    assert_eq!(calls[0].from.selection_range, host.selection_range);
+    let mut actual = calls[0].from_ranges.clone();
+    actual.sort_by_key(|range| (range.start.line, range.start.character));
+    assert_eq!(
+        actual,
+        [
+            builtin_identity_range(later_source, "strtolower('B')", "strtolower"),
+            builtin_identity_range(later_source, "('strtolower')('C')", "('C')")

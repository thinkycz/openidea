+const BUILTIN_IDENTITY_LITERAL: &str = concat!(
+    "<?php\r\nfunction literalIdentityHost(): void {\r\n",
+    " /* café 🐘 */ ('strtolower')('A');\r\n",
+    " /* café 🐘 */ ('DateTimeImmutable::createFromFormat')('!Y', '2026');\r\n",
+    "}\r\nfunction builtinIdentityCreation(): void { $a=('strtolower')(...); $b=('DateTimeImmutable::createFromFormat')(...); }\r\n",
+);
+const BUILTIN_IDENTITY_DIRECT: &str = "<?php\r\nfunction ordinaryIdentityHost(): void { /* café 🐘 */ strtolower('A'); DateTimeImmutable::createFromFormat('!Y', '2026'); }\r\n";
+
+struct BuiltinIdentityOracle {
+    uri: Url,
+    content: String,
+    name: &'static str,
+    start: usize,
+    selection: Range,
+    declaration: Range,
+}
+fn builtin_identity_point(source: &str, offset: usize) -> Position {
+    let prefix = &source[..offset];
+    Position::new(
+        prefix.bytes().filter(|byte| *byte == b'\n').count() as u32,
+        prefix.rsplit('\n').next().unwrap().encode_utf16().count() as u32,
+    )
+}
+fn builtin_identity_range(source: &str, context: &str, token: &str) -> Range {
+    let offset = source.find(context).expect("exact source context")
+        + context.rfind(token).expect("source token");
+    Range::new(
+        builtin_identity_point(source, offset),
+        builtin_identity_point(source, offset + token.len()),
+    )
+}
+fn builtin_identity_oracle(uri: Url, content: String, method: bool) -> BuiltinIdentityOracle {
+    let (name, start) = if method {
+        let class_header = "\nclass DateTimeImmutable implements DateTimeInterface\n";
+        let class = content
+            .find(class_header)
+            .expect("exact top-level DateTimeImmutable source header")
+            + 1;
+        let next_header = "\nclass DateTime implements DateTimeInterface\n";
+        let class_end = class
+            + content[class..]
+                .find(next_header)
+                .expect("independent next top-level DateTime boundary");
+        assert!(
+            content[class..class_end]
+                .starts_with("class DateTimeImmutable implements DateTimeInterface\n{")
+        );
+        assert!(content[class_end..].starts_with(next_header));
+        let marker = "#[PhpStormStubsElementAvailable(from: '8.0')]";
+        let supported = content[class..class_end]
+            .match_indices(marker)
+            .filter_map(|(offset, _)| {
+                let after = class + offset + marker.len();
+                content[after..class_end]
+                    .trim_start()
+                    .starts_with("public static function createFromFormat(")
+                    .then_some(after)
+            })
+            .collect::<Vec<_>>();
+        assert_eq!(
+            supported.len(),
+            1,
+            "PHP8.3 selects the 8.0+ overload, never the earlier 5.5..7.4 duplicate"
+        );
+        let after = supported[0];
+        let offset = after
+            + content[after..].find("function createFromFormat(").unwrap()
+            + "function ".len();
+        ("createFromFormat", offset)
+    } else {
+        let declarations = content
+            .match_indices("function strtolower(")
+            .collect::<Vec<_>>();
+        assert_eq!(
+            declarations.len(),
+            1,
+            "independent immutable function source witness"
+        );
+        ("strtolower", declarations[0].0 + "function ".len())
+    };
+    assert_eq!(&content[start..start + name.len()], name);
+    let body = start
+        + content[start..]
+            .find('{')
+            .expect("concrete bundled stub body");
+    let end = body + content[body..].find('}').unwrap() + 1;
+    assert!(
+        content[body + 1..end - 1].trim().is_empty(),
+        "these exact bundled stub declarations have empty bodies"
+    );
+    let selection = Range::new(
+        builtin_identity_point(&content, start),
+        builtin_identity_point(&content, start + name.len()),
+    );
+    let declaration = Range::new(selection.start, builtin_identity_point(&content, end));
+    BuiltinIdentityOracle {
+        uri,
+        content,
+        name,
+        start,
+        selection,
+        declaration,
+    }
+}
+fn builtin_identity_assert(
+    item: &CallHierarchyItem,
+    oracle: &BuiltinIdentityOracle,
+    qualified: bool,
+) {
+    let mut uri = item.uri.clone();
+    if qualified {
+        assert!(uri.query().unwrap().starts_with("project_context="));
+        uri.set_query(None);
+    }
+    assert_eq!(
+        uri, oracle.uri,
+        "actual declaration URI, not a same-named sibling"
+    );
+    assert_eq!(item.name, oracle.name);
+    assert_eq!(
+        item.selection_range, oracle.selection,
+        "coordinates must select the target-supported declaration in immutable raw bytes"
+    );
+    assert_eq!(
+        item.range, oracle.declaration,
+        "full declaration range belongs to the same raw source"
+    );
+    let data = item.data.as_ref().unwrap();
+    let payload = if qualified { &data["payload"] } else { data };
+    assert_eq!(
+        payload["offset"].as_u64(),
+        Some(oracle.start as u64),
+        "receipt offset must match immutable target source"
+    );
+}
+fn builtin_identity_expected(literal: bool, method: bool) -> Range {
+    if literal {
+        if method {
+            builtin_identity_range(
+                BUILTIN_IDENTITY_LITERAL,
+                "('DateTimeImmutable::createFromFormat')('!Y', '2026')",
+                "('!Y', '2026')",
+            )
+        } else {
+            builtin_identity_range(BUILTIN_IDENTITY_LITERAL, "('strtolower')('A')", "('A')")
+        }
+    } else if method {
+        builtin_identity_range(
+            BUILTIN_IDENTITY_DIRECT,
+            "DateTimeImmutable::createFromFormat('!Y', '2026')",
+            "createFromFormat",
+        )
+    } else {
+        builtin_identity_range(BUILTIN_IDENTITY_DIRECT, "strtolower('A')", "strtolower")
+    }
+}

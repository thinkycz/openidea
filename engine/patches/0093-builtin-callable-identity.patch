+#[tokio::test]
+async fn builtin_forced_virtual_text_cannot_grant_unavailable_version_or_extension_authority_and_project_polyfill_still_works()
+ {
+    use phpantom_lsp::{types::PhpVersion, workbench_builtins::BuiltinQuery};
+    // Fresh backends per applied profile, not a mutation-based restoration claim.
+    for (minor, extensions, array_available, curl_available) in [
+        (3, Vec::<String>::new(), false, false),
+        (4, vec!["curl".to_owned()], true, true),
+    ] {
+        let backend = crate::common::create_test_backend_with_full_stubs();
+        let mut config = phpantom_lsp::config::Config::default();
+        config.php.extensions = Some(extensions);
+        backend.set_config(config);
+        backend.set_php_version(PhpVersion::new(8, minor));
+        let array_uri = Url::parse("phpantom-stub-fn://array_find").unwrap();
+        let curl_uri = Url::parse("phpantom-stub-fn://curl_version").unwrap();
+        let array_doc = backend
+            .workbench_builtin(BuiltinQuery {
+                uri: array_uri.to_string(),
+            })
+            .await;
+        let curl_doc = backend
+            .workbench_builtin(BuiltinQuery {
+                uri: curl_uri.to_string(),
+            })
+            .await;
+        assert_eq!(array_doc.is_ok(), array_available);
+        assert_eq!(curl_doc.is_ok(), curl_available);
+        let user_uri = Url::parse(&format!("file:///builtin-profile-8{minor}.php")).unwrap();
+        let source = "<?php\r\nfunction builtinProfileHost(): void { ('array_find')([], static fn($value) => true); ('curl_version')(); ('WorkbenchUnknownBuiltin')(); }\r\n";
+        open_php(&backend, &user_uri, source).await;
+        let host =
+            anonymous_hierarchy_prepare(&backend, &user_uri, source, "builtinProfileHost").await;
+        let before = outgoing(&backend, &host).await;
+        assert_eq!(
+            before.iter().any(|edge| edge.to.name == "array_find"),
+            array_available
+        );
+        assert_eq!(
+            before.iter().any(|edge| edge.to.name == "curl_version"),
+            curl_available
+        );
+        assert!(
+            !before
+                .iter()
+                .any(|edge| edge.to.name == "WorkbenchUnknownBuiltin")
+        );
+        for (name, uri) in [
+            ("array_find", array_uri.clone()),
+            ("curl_version", curl_uri.clone()),
+            (
+                "WorkbenchUnknownBuiltin",
+                Url::parse("phpantom-stub-fn://WorkbenchUnknownBuiltin").unwrap(),
+            ),
+        ] {
+            let forged = format!(
+                "<?php\r\n/* client-forged source café 🐘 */ function {name}(...$args) {{}}\r\n"
+            );
+            open_php(&backend, &uri, &forged).await;
+        }
+        let after = outgoing(&backend, &host).await;
+        assert_eq!(
+            backend
+                .workbench_builtin(BuiltinQuery {
+                    uri: array_uri.to_string()
+                })
+                .await
+                .is_ok(),
+            array_available
+        );
+        assert_eq!(
+            backend
+                .workbench_builtin(BuiltinQuery {
+                    uri: curl_uri.to_string()
+                })
+                .await
+                .is_ok(),
+            curl_available
+        );
+        assert!(
+            backend
+                .workbench_builtin(BuiltinQuery {
+                    uri: "phpantom-stub-fn://WorkbenchUnknownBuiltin".into()
+                })
+                .await
+                .is_err()
+        );
+        assert_eq!(
+            after.iter().any(|edge| edge.to.name == "array_find"),
+            array_available,
+            "virtual didOpen cannot restore an unavailable PHP function"
+        );
+        assert_eq!(
+            after.iter().any(|edge| edge.to.name == "curl_version"),
+            curl_available,
+            "virtual didOpen cannot grant a disabled extension"
+        );
+        assert!(
+            !after
+                .iter()
+                .any(|edge| edge.to.name == "WorkbenchUnknownBuiltin"),
+            "unknown virtual URI is not a source authority"
+        );
+        for edge in &after {
+            let doc = if edge.to.name == "array_find" {
+                array_doc.as_ref().unwrap()
+            } else {
+                curl_doc.as_ref().unwrap()
+            };
+            let oracle = builtin_identity_function_oracle(
+                if edge.to.name == "array_find" {
+                    "array_find"
+                } else {
+                    "curl_version"
+                },
+                doc.content.clone(),
+            );
+            builtin_identity_assert(&edge.to, &oracle, false);
+        }
+        if !array_available {
+            let project_uri = Url::parse("file:///valid-php83-array-find-polyfill.php").unwrap();
+            let project = "<?php\r\nfunction array_find(array $values, callable $predicate): mixed { return null; }\r\n";
+            open_php(&backend, &project_uri, project).await;
+            let recovered = outgoing(&backend, &host).await;
+            let matches = recovered
+                .iter()
+                .filter(|edge| edge.to.name == "array_find")
+                .collect::<Vec<_>>();
+            assert_eq!(matches.len(), 1);
+            assert_eq!(
+                matches[0].to.uri, project_uri,
+                "legitimate project polyfill uses project authority, not unavailable builtin authority"
+            );
+            assert_eq!(
+                matches[0].to.selection_range,
+                builtin_identity_range(project, "function array_find(", "array_find")
+            );
+        }
+    }
+}

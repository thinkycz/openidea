+        let mut malformed = edge.to.clone();
+        malformed.uri.set_query(Some("project_context=invalid"));
+        assert!(
+            router
+                .incoming_calls(CallHierarchyIncomingCallsParams {
+                    item: malformed,
+                    work_done_progress_params: Default::default(),
+                    partial_result_params: Default::default()
+                })
+                .await
+                .is_err(),
+            "malformed qualifier is rejected before source lookup"
+        );
+    }
+    router.shutdown().await.unwrap();
+}

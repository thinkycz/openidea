+        builtin_identity_oracle(class_uri, class_doc.content, true),
+    ];
+    let literal_uri = Url::parse("file:///builtin-identity-literal.php").unwrap();
+    let direct_uri = Url::parse("file:///builtin-identity-direct.php").unwrap();
+    open_php(&backend, &literal_uri, BUILTIN_IDENTITY_LITERAL).await;
+    let literal = anonymous_hierarchy_prepare(
+        &backend,
+        &literal_uri,
+        BUILTIN_IDENTITY_LITERAL,
+        "literalIdentityHost",
+    )
+    .await;
+    let cold = outgoing(&backend, &literal).await;
+    assert_eq!(
+        cold.len(),
+        2,
+        "first literal query has both supported builtin targets"
+    );
+    for oracle in &oracles {
+        builtin_identity_assert(
+            &cold
+                .iter()
+                .find(|edge| edge.to.name == oracle.name)
+                .unwrap()
+                .to,
+            oracle,
+            false,
+        );
+    }
+    open_php(&backend, &direct_uri, BUILTIN_IDENTITY_DIRECT).await;
+    let direct = anonymous_hierarchy_prepare(
+        &backend,
+        &direct_uri,
+        BUILTIN_IDENTITY_DIRECT,
+        "ordinaryIdentityHost",
+    )
+    .await;
+    let ordinary = outgoing(&backend, &direct).await;
+    let warm = outgoing(&backend, &literal).await;
+    // Assert every stage against raw target source, not merely equality of
+    // two answers that could share the same wrong duplicate declaration.
+    for (label, edges, is_literal) in [
+        ("cold", &cold, true),
+        ("ordinary", &ordinary, false),
+        ("warm", &warm, true),
+    ] {
+        assert_eq!(
+            edges.len(),
+            2,
+            "both builtin targets remain present at {label}: {edges:?}"
+        );
+        for (index, oracle) in oracles.iter().enumerate() {
+            let found = edges
+                .iter()
+                .filter(|edge| edge.to.name == oracle.name)
+                .collect::<Vec<_>>();
+            assert_eq!(found.len(), 1);
+            builtin_identity_assert(&found[0].to, oracle, false);
+            assert_eq!(
+                found[0].from_ranges,
+                [builtin_identity_expected(is_literal, index == 1)]
+            );
+        }
+    }
+    assert_eq!(
+        cold, warm,
+        "query history cannot mutate declaration identity"
+    );
+    // Reciprocal scans are deliberately after the cold→ordinary→warm sequence.
+    for (index, oracle) in oracles.iter().enumerate() {
+        let target = &cold
+            .iter()
+            .find(|edge| edge.to.name == oracle.name)
+            .unwrap()
+            .to;
+        let callers = incoming(&backend, target).await;
+        assert_eq!(callers.len(), 2);
+        for (owner, expected) in [
+            (&literal, builtin_identity_expected(true, index == 1)),
+            (&direct, builtin_identity_expected(false, index == 1)),
+        ] {
+            assert_eq!(
+                callers
+                    .iter()
+                    .filter(|call| call.from.uri == owner.uri
+                        && call.from.selection_range == owner.selection_range
+                        && call.from_ranges == [expected])
+                    .count(),
+                1
+            );
+        }
+        let still = backend
+            .workbench_builtin(BuiltinQuery {
+                uri: oracle.uri.to_string(),
+            })
+            .await
+            .unwrap();
+        assert_eq!(still.content, oracle.content);
+    }
+    let creation = anonymous_hierarchy_prepare(
+        &backend,
+        &literal_uri,
+        BUILTIN_IDENTITY_LITERAL,
+        "builtinIdentityCreation",
+    )
+    .await;
+    assert!(outgoing(&backend, &creation).await.is_empty());
+}
+
+fn builtin_identity_function_oracle(name: &'static str, content: String) -> BuiltinIdentityOracle {
+    let needle = format!("function {name}(");
+    let matches = content.match_indices(&needle).collect::<Vec<_>>();
+    assert_eq!(
+        matches.len(),
+        1,
+        "finite real bundled function declaration witness: {name}"
+    );
+    let start = matches[0].0 + "function ".len();
+    let body = start + content[start..].find('{').unwrap();
+    let end = body + content[body..].find('}').unwrap() + 1;
+    assert!(content[body + 1..end - 1].trim().is_empty());
+    let selection = Range::new(
+        builtin_identity_point(&content, start),
+        builtin_identity_point(&content, start + name.len()),
+    );
+    let declaration = Range::new(selection.start, builtin_identity_point(&content, end));
+    BuiltinIdentityOracle {
+        uri: Url::parse(&format!("phpantom-stub-fn://{name}")).unwrap(),
+        content,
+        name,
+        start,
+        selection,
+        declaration,
+    }
+}

+        .unwrap();
+    let expected = builtin_identity_oracle(uri.clone(), document.content, true);
+    let source_uri = Url::parse("file:///builtin-class-forced-source.php").unwrap();
+    let source = "<?php\r\nfunction builtinClassSourceHost(): void { /* café 🐘 */ ('DateTimeImmutable::createFromFormat')('!Y','2026'); }\r\n";
+    open_php(&backend, &source_uri, source).await;

+        .initialize(InitializeParams {
+            root_uri: Some(Url::from_directory_path(&root).unwrap()),
+            ..Default::default()
+        })
+        .await
+        .unwrap();
+    router.initialized(InitializedParams {}).await;
+    let uri = Url::from_file_path(root.join("literal.php")).unwrap();
+    router
+        .did_open(DidOpenTextDocumentParams {
+            text_document: TextDocumentItem {
+                uri: uri.clone(),
+                language_id: "php".into(),
+                version: 1,
+                text: BUILTIN_IDENTITY_LITERAL.into(),
+            },
+        })
+        .await;
+    let position = builtin_identity_range(
+        BUILTIN_IDENTITY_LITERAL,
+        "function literalIdentityHost",
+        "literalIdentityHost",
+    )
+    .start;
+    let prepared = router
+        .prepare_call_hierarchy(CallHierarchyPrepareParams {
+            text_document_position_params: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier { uri: uri.clone() },

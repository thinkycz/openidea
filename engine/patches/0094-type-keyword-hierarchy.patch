+#[tokio::test]
+async fn type_keyword_prepare_named_declarations_use_exact_tokens_and_keep_reference_precedence() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///named-type-keywords.php").unwrap();
+    let content = "<?php\r\nnamespace KeywordScope;\r\n/* café 🐘 class Fake {} */\r\ninterface BaseFace {}\r\ninterface NamedFace extends BaseFace {}\r\ntrait NamedTrait {}\r\nenum NamedEnum { case One; }\r\nclass BaseClass {}\r\n#[\\AllowDynamicProperties]\r\nClAsS /* class Decoy {} */ NamedClass extends BaseClass {}\r\n";
+    open_php(&backend, &uri, content).await;
+    let point = |offset: usize| {
+        let prefix = &content[..offset];
+        Position::new(
+            prefix.bytes().filter(|byte| *byte == b'\n').count() as u32,
+            prefix.rsplit('\n').next().unwrap().encode_utf16().count() as u32,
+        )
+    };
+    for (keyword, name) in [
+        ("interface", "NamedFace"),
+        ("trait", "NamedTrait"),
+        ("enum", "NamedEnum"),
+        ("ClAsS", "NamedClass"),
+    ] {
+        let name_offset = content.find(name).unwrap();
+        let at_name = point(name_offset);
+        let positive = prepare_at(&backend, &uri, at_name.line, at_name.character).await;
+        assert_eq!(positive.len(), 1, "{name}");
+        let keyword_offset = if name == "NamedClass" {
+            content.find("ClAsS").unwrap()
+        } else {
+            content[..name_offset].rfind(keyword).unwrap()
+        };
+        for offset in keyword_offset..keyword_offset + keyword.len() {
+            let at = point(offset);
+            assert_eq!(
+                prepare_at(&backend, &uri, at.line, at.character).await,
+                positive,
+                "every byte in the actual {keyword} token must identify {name}"
+            );
+        }
+        let after = point(keyword_offset + keyword.len());
+        assert!(
+            prepare_at(&backend, &uri, after.line, after.character)
+                .await
+                .is_empty(),
+            "keyword fallback must not claim following trivia for {name}"
+        );
+    }
+    for text in ["class Fake", "class Decoy"] {
+        let at = point(content.find(text).unwrap());
+        assert!(
+            prepare_at(&backend, &uri, at.line, at.character)
+                .await
+                .is_empty(),
+            "a comment token is never a declaration: {text}"
+        );
+    }
+    let at = point(content.rfind("BaseClass").unwrap());
+    let parent = prepare_at(&backend, &uri, at.line, at.character).await;
+    assert_eq!(parent.len(), 1);
+    assert_eq!(
+        parent[0].name, "BaseClass",
+        "an existing reference span retains precedence over declaration fallback"
+    );
+}

+#[tokio::test]
+async fn type_keyword_prepare_builtin_definition_handoff_matches_name_and_expands() {
+    let backend = crate::common::create_test_backend_with_full_stubs();
+    let uri = Url::parse("file:///builtin-keyword-handoff.php").unwrap();
+    let content = "<?php\r\n/* café 🐘 */ RuntimeException::class;\r\n";
+    open_php(&backend, &uri, content).await;
+    let column = "/* café 🐘 */ ".encode_utf16().count() as u32;
+    let definition = backend
+        .goto_definition(GotoDefinitionParams {
+            text_document_position_params: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier { uri: uri.clone() },
+                position: Position::new(1, column),
+            },
+            work_done_progress_params: Default::default(),
+            partial_result_params: Default::default(),
+        })
+        .await
+        .unwrap()
+        .expect("actual definition navigation");
+    let location = match definition {
+        GotoDefinitionResponse::Scalar(location) => location,
+        GotoDefinitionResponse::Array(locations) => {
+            assert_eq!(locations.len(), 1);
+            locations.into_iter().next().unwrap()
+        }
+        GotoDefinitionResponse::Link(_) => panic!("expected actual class declaration Location"),
+    };
+    assert_eq!(location.uri.scheme(), "phpantom-stub");
+    let positive = prepare_at(&backend, &uri, 1, column).await;
+    assert_eq!(positive.len(), 1);
+    assert_eq!(positive[0].name, "RuntimeException");
+    let prepared = prepare_at(
+        &backend,
+        &location.uri,
+        location.range.start.line,
+        location.range.start.character,
+    )
+    .await;
+    assert_eq!(
+        prepared, positive,
+        "the actual GoToDefinition landing caret must prepare the same immutable class"
+    );
+    let supers = supertypes_of(&backend, &prepared[0]).await;
+    assert!(supers.iter().any(|parent| parent.name == "Exception"));
+}

+        ),
+        (
+            "directFinalMethod",
+            Some(("ArrayClassNameProvenance\\OpenTarget", "sealed")),
+        ),
+        (
+            "assignedFinalMethod",
+            Some(("ArrayClassNameProvenance\\OpenTarget", "sealed")),
+        ),
+        (
+            "closedAssignedLate",
+            Some(("ArrayClassNameProvenance\\ClosedTarget", "run")),
+        ),
+        ("boundedOpen", None),
+        (
+            "boundedFinalMethod",
+            Some(("ArrayClassNameProvenance\\OpenTarget", "sealed")),
+        ),
+        (
+            "boundedClosed",
+            Some(("ArrayClassNameProvenance\\ClosedTarget", "run")),
+        ),
+    ] {
+        let root = array_exact_root(&backend, &uri, source, name).await;
+        let edges = outgoing(&backend, &root).await;
+        if let Some((owner, method)) = expected {
+            assert_eq!(edges.len(), 1, "{name}: {edges:?}");
+            assert_eq!(edges[0].to.data.as_ref().unwrap()["owner"], owner);
+            assert_eq!(edges[0].to.name, method);
+            let reverse = incoming(&backend, &edges[0].to).await;
+            assert!(
+                reverse
+                    .iter()
+                    .any(|edge| edge.from.selection_range == root.selection_range
+                        && edge.from_ranges == edges[0].from_ranges),
+                "{name} incoming: {reverse:?}"
+            );
+            assert!(
+                reverse.iter().all(|edge| ![
+                    "directLate",
+                    "assignedLate",
+                    "copiedLate",
+                    "boundedOpen"
+                ]
+                .contains(&edge.from.name.as_str())),
+                "open class bounds cannot grant exact body ownership: {reverse:?}"
+            );
+        } else {
+            assert!(edges.is_empty(), "{name}: {edges:?}");
+        }
+    }
+}
+
+#[tokio::test]
+async fn array_callable_exact_assigned_absolute_names_do_not_rebind_imports() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///array-assigned-runtime-fqn.php").unwrap();
+    let source = "<?php\nnamespace { class Alias { public static function ping() {} } }\nnamespace Foreign { class Actual { public static function ping() {} } }\nnamespace Local { use Foreign\\Actual as Alias; function arrayAssignedNamespaceHost() { $absolute=\\Alias::class; ([$absolute,'ping'])(); $runtime='Alias'; ([$runtime,'ping'])(); $imported=Alias::class; ([$imported,'ping'])(); $unknown=\\Missing\\Alias::class; ([$unknown,'ping'])(); } }\n";
+    open_php(&backend, &uri, source).await;
+    let root = array_exact_root(&backend, &uri, source, "arrayAssignedNamespaceHost").await;
+    let edges = outgoing(&backend, &root).await;
+    assert_eq!(
+        edges.len(),
+        2,
+        "absolute constants and runtime strings cannot use lexical aliases: {edges:?}"
+    );
+    for (owner, contexts) in [
+        (
+            "Alias",
+            vec!["([$absolute,'ping'])();", "([$runtime,'ping'])();"],
+        ),
+        ("Foreign\\Actual", vec!["([$imported,'ping'])();"]),
+    ] {
+        let edge = edges
+            .iter()
+            .find(|edge| edge.to.data.as_ref().unwrap()["owner"] == owner)
+            .unwrap();
+        assert_eq!(
+            edge.from_ranges,
+            contexts
+                .iter()
+                .map(|context| noncall_exact_range(source, context, "ping"))
+                .collect::<Vec<_>>()
+        );
+        array_exact_reverse(&backend, &root, edge).await;
+    }
+}
diff --git a/src/symbol_map/extraction/array_callable.rs b/src/symbol_map/extraction/array_callable.rs
new file mode 100644
index 0000000..04c98a8
--- /dev/null
+++ b/src/symbol_map/extraction/array_callable.rs
@@ -0,0 +1,283 @@
+//! Exact quoted selectors and literal-array callable source roles.
+use mago_span::HasSpan;
+use mago_syntax::cst::sequence::TokenSeparatedSequence;
+
+use super::array_callable_values::unparenthesized_expression;
+use super::*;
+
+/// Mago owns decoding; immutable source owns the full quote/prefix receipt.
+pub(super) fn method_literal(
+    expression: &Expression<'_>,
+    content: &str,
+) -> Option<LiteralMethodSelector> {
+    let Expression::Literal(literal::Literal::String(literal)) =
+        unparenthesized_expression(expression)
+    else {
+        return None;
+    };
+    let name = literal.value.and_then(literal_bytes_to_str)?;
+    if name.is_empty() {
+        return None;
+    }
+    let raw = content.get(literal.span.start.offset as usize..literal.span.end.offset as usize)?;
+    let bytes = raw.as_bytes();
+    let (prefix_len, quote) = match bytes {
+        [quote @ (b'\'' | b'"'), ..] => (1, *quote),
+        [b'b' | b'B', quote @ (b'\'' | b'"'), ..] => (2, *quote),
+        _ => return None,
+    };
+    if bytes.last() != Some(&quote) {
+        return None;
+    }
+    let start = literal.span.start.offset.checked_add(prefix_len)?;
+    let end = literal.span.end.offset.checked_sub(1)?;
+    if start >= end {
+        return None;
+    }
+    Some(LiteralMethodSelector {
+        start,
+        end,
+        literal_start: literal.span.start.offset,
+        literal_end: literal.span.end.offset,
+        raw_literal: raw.into(),
+        name: crate::atom::atom(name),
+    })
+}
+
+fn php_identifier(name: &str) -> bool {
+    let mut bytes = name.bytes();
+    let Some(first) = bytes.next() else {
+        return false;
+    };
+    (first == b'_' || first.is_ascii_alphabetic() || first >= 0x80)
+        && bytes.all(|byte| byte == b'_' || byte.is_ascii_alphanumeric() || byte >= 0x80)
+}
+
+/// Allocation metadata is source-local and does not grant a global synthetic name.
+fn array_callable_allocation(expression: &Expression<'_>) -> Option<ImmediateObjectReceiver> {
+    match unparenthesized_expression(expression) {
+        Expression::Instantiation(inst) => match inst.class {
+            Expression::Identifier(_)
+            | Expression::Self_(_)
+            | Expression::Static(_)
+            | Expression::Parent(_) => {
+                let span = inst.class.span();
+                Some(ImmediateObjectReceiver::Instantiation {
+                    operand_start: span.start.offset,
+                    operand_end: span.end.offset,
+                })
+            }
+            _ => None,
+        },
+        Expression::AnonymousClass(anonymous) => Some(ImmediateObjectReceiver::AnonymousClass {
+            body_start: anonymous.left_brace.start.offset,
+            body_end: anonymous.right_brace.end.offset,
+            keyword_start: anonymous.class.span.start.offset,
+        }),
+        _ => None,
+    }
+}
+
+struct ArrayCallableDescription {
+    selector: LiteralMethodSelector,
+    subject_text: SubjectText,
+    is_static: bool,
+    allocation: Option<ImmediateObjectReceiver>,
+}
+
+fn same_values(left: [&Expression<'_>; 2], right: [&Expression<'_>; 2]) -> bool {
+    std::ptr::eq(left[0], right[0]) && std::ptr::eq(left[1], right[1])
+}
+
+pub(super) fn try_emit_array_callable_span<'a>(
+    elements: &TokenSeparatedSequence<'a, ArrayElement<'a>>,
+    ctx: &mut ExtractionCtx<'a>,
+) -> Option<(u32, u32)> {
+    let before = array_callable_values(elements, false)?;
+    let since = array_callable_values(elements, true)?;
+    if !same_values(before, since) {
+        return None;
+    }
+    let description = describe_array_callable(before, ctx.content, false)?;
+    Some(emit_array_callable_reference(&description, ctx, None))
+}
+
+/// Each PHP target selects its own normalized slots. Generic references never
+/// authorize a runtime edge or collapse two version-dependent receivers.
+pub(super) fn extract_array_callable_invocations<'a>(
+    elements: &TokenSeparatedSequence<'a, ArrayElement<'a>>,
+    ctx: &mut ExtractionCtx<'a>,
+    span_base: usize,
+    scope_start: u32,
+    invocation_start: u32,
+    invocation_end: u32,
+) {
+    let before = array_callable_values(elements, false);
+    let since = array_callable_values(elements, true);
+    let variants = match (before, since) {
+        (Some(before), Some(since)) if same_values(before, since) => {
+            [(Some(before), None), (None, None)]
+        }
+        (before, since) => [(before, Some(false)), (since, Some(true))],
+    };
+    for (values, php80) in variants {
+        let Some(description) =
+            values.and_then(|values| describe_array_callable(values, ctx.content, true))
+        else {
+            continue;
+        };
+        let selector = &description.selector;
+        if php80.is_none() {
+            // Only an unambiguous immediate invocation proves that a pair of
+            // class/method strings is a callable rather than ordinary data.
+            let range = emit_array_callable_reference(&description, ctx, Some(span_base));
+            ctx.non_invoked_callable_spans.push(range);
+        } else {
+            // Extraction has no applied target. A version-dependent final
+            // receiver cannot grant a unique standalone reference at this token.
+            let mut index = span_base;
+            while index < ctx.spans.len() {
+                let span = &ctx.spans[index];
+                if span.start == selector.start
+                    && span.end == selector.end
+                    && matches!(
+                        span.kind,
+                        SymbolKind::MemberAccess {
+                            is_array_callable: true,
+                            ..
+                        }
+                    )
+                {
+                    ctx.spans.remove(index);
+                } else {
+                    index += 1;
+                }
+            }
+        }
+        ctx.literal_method_selectors.push(selector.clone());
+        ctx.array_callable_invocations
+            .push(ArrayCallableInvocation {
+                selector_start: selector.start,
+                selector_end: selector.end,
+                subject_text: description.subject_text,
+                member_name: selector.name,
+                is_static: description.is_static,
+                php80,
+                allocation: description.allocation,
+                invoking_scope_start: scope_start,
+                invocation_start,
+                invocation_end,
+            });
+    }
+}
+
+fn emit_array_callable_reference(
+    description: &ArrayCallableDescription,
+    ctx: &mut ExtractionCtx<'_>,
+    invoked_span_base: Option<usize>,
+) -> (u32, u32) {
+    let site = &description.selector;
+    if let Some(base) = invoked_span_base {
+        let mut index = base;
+        while index < ctx.spans.len() {
+            let span = &ctx.spans[index];
+            if span.start == site.start
+                && span.end == site.end
+                && matches!(
+                    span.kind,
+                    SymbolKind::MemberAccess {
+                        is_array_callable: true,
+                        ..
+                    }
+                )
+            {
+                ctx.spans.remove(index);
+            } else {
+                index += 1;
+            }
+        }
+    }
+    ctx.spans.push(SymbolSpan {
+        start: site.start,
+        end: site.end,
+        kind: SymbolKind::MemberAccess {
+            subject_text: description.subject_text.clone(),
+            member_name: site.name,
+            is_static: description.is_static,
+            is_method_call: true,
+            docblock_ref: DocblockMemberRef::No,
+            is_array_callable: true,
+            is_nullsafe: false,
+        },
+    });
+    ctx.literal_method_selectors.push(site.clone());
+    (site.start, site.end)
+}
+
+fn describe_array_callable(
+    [receiver, method]: [&Expression<'_>; 2],
+    content: &str,
+    invoked: bool,
+) -> Option<ArrayCallableDescription> {
+    let receiver = unparenthesized_expression(receiver);
+    let selector = method_literal(method, content)?;
+    if !php_identifier(selector.name.as_str()) {
+        return None;
+    }
+    let receiver_span = receiver.span();
+    let (subject, subject_span, is_static) = match receiver {
+        Expression::Access(Access::ClassConstant(access))
+            if matches!(
+                &access.constant,
+                ClassLikeConstantSelector::Identifier(name) if bytes_to_str(name.value).eq_ignore_ascii_case("class")
+            ) =>
+        {
+            (
+                expr_to_subject_text(access.class),
+                access.class.span(),
+                true,
+            )
+        }
+        Expression::Literal(literal::Literal::String(class)) if invoked => {
+            let name = class.value.and_then(literal_bytes_to_str)?;
+            let name = name.strip_prefix('\\').unwrap_or(name);
+            if !name.split('\\').all(php_identifier) {
+                return None;
+            }
+            (format!("\\{name}"), receiver_span, true)
+        }
+        Expression::AnonymousClass(_) => {
+            // Generic subject resolution must not manufacture a globally
+            // trusted anonymous name. The invocation's exact body receipt
+            // selects this object in the per-URI class cache.
+            (
+                content
+                    .get(receiver_span.start.offset as usize..receiver_span.end.offset as usize)?
+                    .to_owned(),
+                receiver_span,
+                false,
+            )
+        }
+        Expression::Variable(_)
+        | Expression::Access(_)
+        | Expression::Call(_)
+        | Expression::Instantiation(_)
+        | Expression::Clone(_)
+        | Expression::ArrayAccess(_) => (expr_to_subject_text(receiver), receiver_span, false),
+        _ => return None,
+    };
+    if subject.is_empty() {
+        return None;
+    }
+    Some(ArrayCallableDescription {
+        subject_text: SubjectText::new(
+            subject,
+            subject_span.start.offset,
+            subject_span.end.offset,
+            content,
+        ),
+        selector,
+        is_static,
+        allocation: array_callable_allocation(receiver),
+    })
+}
diff --git a/src/symbol_map/extraction/array_callable_values.rs b/src/symbol_map/extraction/array_callable_values.rs
new file mode 100644
index 0000000..fffa2b0
--- /dev/null
+++ b/src/symbol_map/extraction/array_callable_values.rs
@@ -0,0 +1,186 @@
+use mago_syntax::cst::sequence::TokenSeparatedSequence;
+use mago_syntax::cst::*;
+
+use crate::atom::{bytes_to_str, literal_bytes_to_str};
+
+pub(super) fn unparenthesized_expression<'a>(
+    mut expression: &'a Expression<'a>,
+) -> &'a Expression<'a> {
+    while let Expression::Parenthesized(parenthesized) = expression {
+        expression = parenthesized.expression;
+    }
+    expression
+}
+
+/// The callable's slots are its final runtime keys, not source positions.
+/// Unknown writes cannot be ignored because they may overwrite either slot.
+pub(super) fn array_callable_values<'a>(
+    elements: &TokenSeparatedSequence<'a, ArrayElement<'a>>,
+    php80: bool,
+) -> Option<[&'a Expression<'a>; 2]> {
+    let mut remaining = 4096;
+    let entries = written_entries(elements, &mut remaining, 0, php80)?;
+    if entries.len() != 2 {
+        return None;
+    }
+    let receiver = entries
+        .iter()
+        .find_map(|(key, value)| (*key == WrittenKey::Integer(0)).then_some(*value))?;
+    let selector = entries
+        .iter()
+        .find_map(|(key, value)| (*key == WrittenKey::Integer(1)).then_some(*value))?;
+    Some([receiver, selector])
+}
+
+#[derive(PartialEq, Eq)]
+enum WrittenKey {
+    Integer(i64),
+    String(String),
+}
+
+struct WrittenEntries<'a> {
+    entries: Vec<(WrittenKey, &'a Expression<'a>)>,
+    next: Option<i64>,
+    highest_integer: Option<i64>,
+    php80: bool,
+}
+
+impl<'a> WrittenEntries<'a> {
+    fn new(php80: bool) -> Self {
+        Self {
+            entries: Vec::new(),
+            next: Some(0),
+            highest_integer: None,
+            php80,
+        }
+    }
+
+    fn set(&mut self, key: WrittenKey, value: &'a Expression<'a>) {
+        if let WrittenKey::Integer(index) = key {
+            let first_integer = self.highest_integer.is_none();
+            self.highest_integer = Some(self.highest_integer.map_or(index, |old| old.max(index)));
+            if self.php80 && first_integer {
+                // Since PHP 8.0, the first integer key may seed a negative
+                // append cursor. String keys do not seed that cursor.
+                self.next = index.checked_add(1);
+            } else if self.php80 || index >= 0 {
+                self.next = self
+                    .next
+                    .and_then(|next| index.checked_add(1).map(|after| next.max(after)));
+            }
+        }
+        if let Some((_, existing)) = self
+            .entries
+            .iter_mut()
+            .find(|(existing, _)| *existing == key)
+        {
+            *existing = value;
+        } else {
+            self.entries.push((key, value));
+        }
+    }
+
+    fn append(&mut self, value: &'a Expression<'a>) -> Option<()> {
+        let index = self.next?;
+        self.set(WrittenKey::Integer(index), value);
+        Some(())
+    }
+}
+
+fn written_entries<'a>(
+    elements: &TokenSeparatedSequence<'a, ArrayElement<'a>>,
+    remaining: &mut usize,
+    depth: usize,
+    php80: bool,
+) -> Option<Vec<(WrittenKey, &'a Expression<'a>)>> {
+    if depth > 32 {
+        return None;
+    }
+    let mut result = WrittenEntries::new(php80);
+    for element in elements.iter() {
+        *remaining = remaining.checked_sub(1)?;
+        match element {
+            ArrayElement::KeyValue(pair) => result.set(written_key(pair.key)?, pair.value),
+            ArrayElement::Value(element) => result.append(element.value)?,
+            ArrayElement::Variadic(element) => {
+                let source = match unparenthesized_expression(element.value) {
+                    Expression::Array(array) => {
+                        written_entries(&array.elements, remaining, depth + 1, php80)?
+                    }
+                    Expression::LegacyArray(array) => {
+                        written_entries(&array.elements, remaining, depth + 1, php80)?
+                    }
+                    _ => return None,
+                };
+                for (key, value) in source {
+                    match key {
+                        WrittenKey::Integer(_) => result.append(value)?,
+                        WrittenKey::String(_) => result.set(key, value),
+                    }
+                }
+            }
+            ArrayElement::Missing(_) => return None,
+        }
+        // Literal writes and spreads cannot remove a key. Three surviving
+        // keys can never become the callable's two slots later in this array
+        // or after spreading it into another literal.
+        if result.entries.len() > 2 {
+            return None;
+        }
+    }
+    Some(result.entries)
+}
+
+fn written_key(expression: &Expression<'_>) -> Option<WrittenKey> {
+    match unparenthesized_expression(expression) {
+        Expression::Literal(Literal::String(literal)) => {
+            let decoded = literal_bytes_to_str(literal.value?)?;
+            Some(match crate::php_type::canonical_int_key(decoded) {
+                Some(index) => WrittenKey::Integer(index),
+                None => WrittenKey::String(decoded.to_string()),
+            })
+        }
+        Expression::Literal(Literal::Null(_)) => Some(WrittenKey::String(String::new())),
+        other => written_numeric_key(other).map(WrittenKey::Integer),
+    }
+}
+
+fn written_numeric_key<'a>(mut expression: &'a Expression<'a>) -> Option<i64> {
+    let mut negative = false;
+    loop {
+        expression = unparenthesized_expression(expression);
+        match expression {
+            Expression::UnaryPrefix(unary) => {
+                match unary.operator {
+                    unary::UnaryPrefixOperator::Plus(_) => {}
+                    unary::UnaryPrefixOperator::Negation(_) => negative = !negative,
+                    _ => return None,
+                }
+                expression = unary.operand;
+            }
+            Expression::Literal(Literal::Integer(integer)) => {
+                integer.value?;
+                let raw = bytes_to_str(integer.raw);
+                return if negative {
+                    crate::php_type::parse_php_int_literal(&format!("-{raw}"))
+                } else {
+                    crate::php_type::parse_php_int_literal(raw)
+                };
+            }
+            Expression::Literal(Literal::Float(float)) => {
+                let value = if negative {
+                    -float.value.0
+                } else {
+                    float.value.0
+                };
+                return (value.is_finite()
+                    && value >= i64::MIN as f64
+                    && value < -(i64::MIN as f64))
+                    .then(|| value.trunc() as i64);
+            }
+            Expression::Literal(Literal::True(_)) => return Some(if negative { -1 } else { 1 }),
+            Expression::Literal(Literal::False(_) | Literal::Null(_)) => return Some(0),
+            _ => return None,
+        }
+    }
+}

+#[tokio::test]
+async fn structural_named_public_search_uses_dirty_utf16_source_and_selected_project() {
+    use sha2::{Digest, Sha256};
+    let temp = TempDir::new().unwrap();
+    let root = temp.path().canonicalize().unwrap();
+    project(&root);
+    let nested = root.join("nested");
+    project(&nested);
+    let path = root.join("index.php");
+    let disk = "<?php render(value: 'disk', mode: true);\r\n";
+    fs::write(&path, disk).unwrap();
+    let closed = root.join("closed.php");
+    fs::write(&closed, "<?php render(value: 'closed', mode: true);").unwrap();
+    fs::write(
+        nested.join("index.php"),
+        "<?php render(value: 'child', mode: true);",
+    )
+    .unwrap();
+    let router = router(&[&root]).await;
+    let uri = Url::from_file_path(&path).unwrap();
+    router
+        .did_open(DidOpenTextDocumentParams {
+            text_document: TextDocumentItem {
+                uri: uri.clone(),
+                language_id: "php".into(),
+                version: 1,
+                text: disk.into(),
+            },
+        })
+        .await;
+    let prefix = "/* café🐘 */ ";
+    let live = format!(
+        "<?php\r\n{prefix}render(value: $ž + 1, mode: true); outer(render(value: $nested, mode: true));\r\nrender(Value: $case, mode: true); render(mode: true, value: $order); render($positional, true);\r\n"
+    );
+    router
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: uri.clone(),
+                version: 2,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: live.clone(),
+            }],
+        })
+        .await;
+    let hash = format!("{:x}", Sha256::digest(live.as_bytes()));
+    let request = json!({"uri":uri,"generation":301,"scope":"project",
+        "pattern":"render(value: $__ss_value, mode: true)",
+        "expectedSources":[{"uri":uri,"version":2,"sha256Utf8":hash}]});
+    let reply = router
+        .workbench_structural_search(serde_json::from_value(request.clone()).unwrap())
+        .await
+        .unwrap();
+    assert!(!reply.incomplete);
+    assert_eq!(
+        reply
+            .files
+            .iter()
+            .map(|file| file.matches.len())
+            .sum::<usize>(),
+        3
+    );
+    assert!(
+        reply
+            .files
+            .iter()
+            .all(|file| !file.stamp.uri.to_file_path().unwrap().starts_with(&nested))
+    );
+    let file = reply
+        .files
+        .iter()
+        .find(|file| file.stamp.uri == uri)
+        .unwrap();
+    assert_eq!(file.matches.len(), 2);
+    assert_eq!(file.stamp.utf8_bytes, live.len() as u64);
+    assert_eq!(file.stamp.sha256_utf8, hash);
+    let stamp = serde_json::to_value(&file.stamp).unwrap();
+    assert_eq!(stamp["source"]["kind"], "open");
+    assert_eq!(stamp["source"]["version"], 2);
+    let first = &file.matches[0];
+    assert_eq!(
+        &live[first.call.start_byte as usize..first.call.end_byte as usize],
+        "render(value: $ž + 1, mode: true)"
+    );
+    assert_eq!(
+        first.call.range.start,
+        Position::new(1, prefix.encode_utf16().count() as u32)
+    );
+    assert_eq!(
+        first.call.range.end,
+        Position::new(
+            1,
+            format!("{prefix}render(value: $ž + 1, mode: true)")
+                .encode_utf16()
+                .count() as u32
+        )
+    );
+    let capture = serde_json::to_value(&first.captures["value"]).unwrap();
+    assert_eq!(capture["kind"], "expression");
+    let range = &capture["ranges"][0];
+    assert_eq!(
+        &live[range["startByte"].as_u64().unwrap() as usize
+            ..range["endByte"].as_u64().unwrap() as usize],
+        "$ž + 1"
+    );
+    assert_eq!(
+        range["range"]["start"]["character"],
+        format!("{prefix}render(value: ").encode_utf16().count() as u32
+    );
+    let newer = live.replace("$ž", "$fresh");
+    router
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: uri.clone(),
+                version: 3,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: newer.clone(),
+            }],
+        })
+        .await;
+    assert_eq!(
+        router
+            .workbench_structural_search(serde_json::from_value(request.clone()).unwrap())
+            .await
+            .unwrap_err()
+            .code,
+        tower_lsp::jsonrpc::ErrorCode::ServerError(-32801)
+    );
+    let mut fresh = request;
+    fresh["expectedSources"][0]["version"] = json!(3);
+    fresh["expectedSources"][0]["sha256Utf8"] =
+        json!(format!("{:x}", Sha256::digest(newer.as_bytes())));
+    let reply = router
+        .workbench_structural_search(serde_json::from_value(fresh).unwrap())
+        .await
+        .unwrap();
+    let file = reply
+        .files
+        .iter()
+        .find(|file| file.stamp.uri == uri)
+        .unwrap();
+    let capture = serde_json::to_value(&file.matches[0].captures["value"]).unwrap();
+    let range = &capture["ranges"][0];
+    assert_eq!(
+        &newer[range["startByte"].as_u64().unwrap() as usize
+            ..range["endByte"].as_u64().unwrap() as usize],
+        "$fresh + 1"
+    );
+    assert_eq!(fs::read_to_string(&path).unwrap(), disk);
+    assert_eq!(
+        fs::read_to_string(&closed).unwrap(),
+        "<?php render(value: 'closed', mode: true);"
+    );
+    router.shutdown().await.unwrap();
+}

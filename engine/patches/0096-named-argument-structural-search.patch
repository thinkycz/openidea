+#[tokio::test]
+async fn structural_named_public_replacement_checks_selected_dirty_source_and_roles() {
+    let f = Fixture::new().await;
+    let live = "<?php\r\n/* café🐘 */ foo(value: $ž /* note */ + 1); foo(value: $other);\r\n";
+    f.router
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: uri(&f.source),
+                version: 2,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: live.into(),
+            }],
+        })
+        .await;
+    let search = json!({"uri":uri(&f.source),"generation":401,"scope":"document",
+        "pattern":"foo(value: $__ss_value)",
+        "expectedSources":[{"uri":uri(&f.source),"version":2,"sha256Utf8":sha(live)}]});
+    let found = serde_json::to_value(
+        f.router
+            .workbench_structural_search(serde_json::from_value(search.clone()).unwrap())
+            .await
+            .unwrap(),
+    )
+    .unwrap();
+    assert_eq!(found["files"][0]["matches"].as_array().unwrap().len(), 2);
+    let selected = &found["files"][0]["matches"][0];
+    assert_eq!(selected["captures"]["value"]["kind"], "expression");
+    assert_eq!(
+        selected["call"]["range"]["start"]["character"],
+        "/* café🐘 */ ".encode_utf16().count() as u32
+    );
+    let query = json!({"search":search,"replacement":"bar(payload: $__ss_value, strict: true)",
+        "selections":[{"stamp":found["files"][0]["stamp"],"calls":[selected["call"]]}]});
+    let reply = f.replace(query.clone()).await.unwrap();
+    assert_eq!(reply["kind"], "parenthesizedExpression");
+    assert_eq!(reply["edits"].as_array().unwrap().len(), 1);
+    assert_eq!(reply["edits"][0]["edits"].as_array().unwrap().len(), 1);
+    assert_eq!(reply["edits"][0]["edits"][0]["call"], selected["call"]);
+    assert_eq!(
+        reply["edits"][0]["edits"][0]["newText"],
+        "(bar(payload: ($ž /* note */ + 1), strict: true))"
+    );
+    assert_eq!(
+        apply(live, &reply["edits"][0]["edits"]),
+        "<?php\r\n/* café🐘 */ (bar(payload: ($ž /* note */ + 1), strict: true)); foo(value: $other);\r\n"
+    );
+    for replacement in ["bar(payload: $__ss_missing)", "bar(...$__ss_value)"] {
+        let mut invalid = query.clone();
+        invalid["replacement"] = json!(replacement);
+        assert_eq!(
+            f.replace(invalid).await.unwrap_err().code,
+            ErrorCode::InvalidParams
+        );
+    }
+    let changed = live.replace("$ž", "$fresh");
+    f.router
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: uri(&f.source),
+                version: 3,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: changed.clone(),
+            }],
+        })
+        .await;
+    assert_eq!(
+        f.replace(query.clone()).await.unwrap_err().code,
+        ErrorCode::ServerError(-32801)
+    );
+    let mut stale_selection = query;
+    stale_selection["search"]["expectedSources"][0]["version"] = json!(3);
+    stale_selection["search"]["expectedSources"][0]["sha256Utf8"] = json!(sha(&changed));
+    assert_eq!(
+        f.replace(stale_selection).await.unwrap_err().code,
+        ErrorCode::ServerError(-32801)
+    );
+    assert_eq!(std::fs::read(&f.closed).unwrap(), f.disk.as_bytes());
+    f.finish().await;

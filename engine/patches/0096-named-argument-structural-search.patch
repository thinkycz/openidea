+
+#[test]
+fn replace_named_values_retains_capture_bytes_external_crlf_and_reviewed_fixed_labels() {
+    let source = "<?php\r\n$note = 'café🐘'; decode(json: $json /* inside */ ?? '{}', associative: $assoc); keep();\r\n";
+    let edits = prepare(
+        "decode(json: $__ss_value, associative: $__ss_flag)",
+        "decode(json: $__ss_value, associative: true, flags: JSON_THROW_ON_ERROR)",
+        source,
+        &[0],
+    )
+    .unwrap();
+    assert_eq!(edits.edits.len(), 1);
+    assert_eq!(edits.edits[0].source.range.start.line, 1);
+    assert_eq!(
+        edits.edits[0].source.range.start.character,
+        "$note = 'café🐘'; ".encode_utf16().count() as u32
+    );
+    assert_eq!(
+        apply(source, &edits),
+        "<?php\r\n$note = 'café🐘'; (decode(json: ($json /* inside */ ?? '{}'), associative: true, flags: JSON_THROW_ON_ERROR)); keep();\r\n"
+    );
+}
+
+#[test]
+fn replace_named_repeated_values_and_captured_receiver_keep_expression_roles() {
+    let source = "<?php same(first: $a + 1, second: $a/* note */+1);";
+    let edits = prepare(
+        "same(first: $__ss_x, second: $__ss_x)",
+        "triple(first: $__ss_x, second: $__ss_x, third: $__ss_x)",
+        source,
+        &[0],
+    )
+    .unwrap();
+    assert_eq!(
+        apply(source, &edits),
+        "<?php (triple(first: ($a + 1), second: ($a/* note */+1), third: ($a + 1)));"
+    );
+    let source = "<?php factory()->save(value: $payload ? $a : $b);";
+    let edits = prepare(
+        "$__ss_receiver->save(value: $__ss_value)",
+        "emit(target: $__ss_receiver, value: $__ss_value)",
+        source,
+        &[0],
+    )
+    .unwrap();
+    assert_eq!(
+        apply(source, &edits),
+        "<?php (emit(target: (factory()), value: ($payload ? $a : $b)));"
+    );
+}
+
+#[test]
+fn replace_named_templates_refuse_unknown_or_sequence_roles_and_keep_positional_tails() {
+    let named = Pattern::compile("old(value: $__ss_x)").unwrap();
+    for template in [
+        "newer(value: $__ss_unknown)",
+        "newer(...$__ss_x)",
+        "newer(value: $__ss_x); evil()",
+    ] {
+        assert!(Template::compile(&named, template).is_err(), "{template}");
+    }
+    let positional_tail = Pattern::compile("old(1, ...$__ss_rest)").unwrap();
+    for template in ["newer(value: $__ss_rest)", "newer(value: 1, ...$__ss_rest)"] {
+        assert!(
+            Template::compile(&positional_tail, template).is_err(),
+            "named destination cannot reinterpret positional tail: {template}"
+        );
+    }
+    for source in ["<?php old(1);", "<?php old(1, /* keep */ $a, $b);"] {
+        let edits = prepare(
+            "old(1, ...$__ss_rest)",
+            "newer(9, ...$__ss_rest)",
+            source,
+            &[0],
+        )
+        .unwrap();
+        let result = apply(source, &edits);
+        assert!(!result.contains("newer(9,)"));
+        if source.contains("keep") {
+            assert!(result.contains("/* keep */ $a, $b"));
+        }
+    }
+}

+#[tokio::test]
+async fn named_call_receipt_opaque_identity_and_real_uri_redirects_are_refused() {
+    let backend = create_test_backend();
+    let left = Url::parse("file:///named-receipt-left.php").unwrap();
+    let right = Url::parse("file:///named-receipt-right.php").unwrap();
+    open_php(&backend, &left, NAMED_RECEIPT_SOURCE).await;
+    let alpha =
+        anonymous_hierarchy_prepare(&backend, &left, NAMED_RECEIPT_SOURCE, "namedReceiptAlpha")
+            .await;
+    let method = anonymous_hierarchy_prepare(&backend, &left, NAMED_RECEIPT_SOURCE, "run()").await;
+    named_receipt_positive(&backend, &alpha, "namedReceiptLeafA").await;
+    named_receipt_positive(&backend, &method, "namedReceiptLeafA").await;
+    let peer = NAMED_RECEIPT_SOURCE
+        .replace("namedReceiptAlpha", "namedReceiptBravo")
+        .replace("namedReceiptLeafA", "namedReceiptLeafC")
+        .replace("namedReceiptLeafB", "namedReceiptLeafD")
+        .replace("NamedReceiptOwnerA", "NamedReceiptOwnerB")
+        .replace("namedReceiptHost", "namedReceiptPeer");
+    assert_eq!(peer.len(), NAMED_RECEIPT_SOURCE.len());
+    open_php(&backend, &right, &peer).await;
+    let bravo = anonymous_hierarchy_prepare(&backend, &right, &peer, "namedReceiptBravo").await;
+    let peer_edges = outgoing(&backend, &bravo).await;
+    assert_eq!(peer_edges.len(), 1);
+    assert_eq!(peer_edges[0].to.name, "namedReceiptLeafC");
+    assert_eq!(bravo.selection_range, alpha.selection_range);
+    let mut redirected = alpha.clone();
+    redirected.uri = right;
+    let mut forged_function = alpha.clone();
+    forged_function.data.as_mut().unwrap()["function"] = serde_json::json!("namedReceiptBravo");
+    let mut forged_owner = method.clone();
+    forged_owner.data.as_mut().unwrap()["owner"] = serde_json::json!("NamedReceiptOwnerB");
+    let mut refusals = Vec::new();
+    for (label, forged) in [
+        ("real-other-uri", redirected),
+        ("opaque-function", forged_function),
+        ("opaque-owner", forged_owner),
+    ] {
+        refusals.push((label, named_receipt_refused(&backend, &forged).await));
+    }
+    assert!(
+        refusals.iter().all(|(_, result)| *result == (true, true)),
+        "real current peer declarations do not authorize stale or forged identity: {refusals:?}"
+    );
+    named_receipt_positive(&backend, &alpha, "namedReceiptLeafA").await;
+    named_receipt_positive(&backend, &method, "namedReceiptLeafA").await;
+}
+
+#[tokio::test]
+async fn named_call_receipt_unchanged_source_survives_unrelated_peer_edits() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///named-receipt-unchanged.php").unwrap();
+    let peer = Url::parse("file:///named-receipt-unrelated.php").unwrap();
+    open_php(&backend, &uri, NAMED_RECEIPT_SOURCE).await;
+    let alpha =
+        anonymous_hierarchy_prepare(&backend, &uri, NAMED_RECEIPT_SOURCE, "namedReceiptAlpha")
+            .await;
+    let method = anonymous_hierarchy_prepare(&backend, &uri, NAMED_RECEIPT_SOURCE, "run()").await;
+    named_receipt_positive(&backend, &alpha, "namedReceiptLeafA").await;
+    named_receipt_positive(&backend, &method, "namedReceiptLeafA").await;
+    let peer_before = "<?php\r\nfunction unrelatedReceiptPeer(): int { return 1; }\r\n";
+    let peer_after = "<?php\r\nfunction unrelatedReceiptPeer(): int { return 2; }\r\n";
+    open_php(&backend, &peer, peer_before).await;
+    anonymous_hierarchy_change(&backend, &peer, peer_after).await;
+    let current =
+        anonymous_hierarchy_prepare(&backend, &uri, NAMED_RECEIPT_SOURCE, "namedReceiptAlpha")
+            .await;
+    assert_eq!(
+        current.data, alpha.data,
+        "another document does not change this declaration's source receipt"
+    );
+    named_receipt_positive(&backend, &alpha, "namedReceiptLeafA").await;
+    named_receipt_positive(&backend, &method, "namedReceiptLeafA").await;
+}

+#[tokio::test]
+async fn named_call_receipt_refuses_same_name_body_retarget_after_accepted_change() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///named-receipt-body.php").unwrap();
+    open_php(&backend, &uri, NAMED_RECEIPT_SOURCE).await;
+    let original =
+        anonymous_hierarchy_prepare(&backend, &uri, NAMED_RECEIPT_SOURCE, "namedReceiptAlpha")
+            .await;
+    named_receipt_positive(&backend, &original, "namedReceiptLeafA").await;
+    let changed = NAMED_RECEIPT_SOURCE.replace(
+        "function namedReceiptAlpha(): void { namedReceiptLeafA(); }",
+        "function namedReceiptAlpha(): void { namedReceiptLeafB(); }",
+    );
+    assert_eq!(changed.len(), NAMED_RECEIPT_SOURCE.len());
+    assert_ne!(changed, NAMED_RECEIPT_SOURCE);
+    anonymous_hierarchy_change(&backend, &uri, &changed).await;
+    let current = anonymous_hierarchy_prepare(&backend, &uri, &changed, "namedReceiptAlpha").await;
+    assert_eq!(current.selection_range, original.selection_range);
+    assert_eq!(
+        current.data.as_ref().unwrap()["function"],
+        original.data.as_ref().unwrap()["function"]
+    );
+    named_receipt_positive(&backend, &current, "namedReceiptLeafB").await;
+    assert_eq!(
+        named_receipt_refused(&backend, &original).await,
+        (true, true),
+        "an old tree must not silently expand a new source body at identical coordinates"
+    );
+}

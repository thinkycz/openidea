+const NAMED_RECEIPT_SOURCE: &str = concat!(
+    "<?php\r\n",
+    "/* café 🐘 */ function namedReceiptLeafA(): void {}\r\n",
+    "function namedReceiptLeafB(): void {}\r\n",
+    "function namedReceiptAlpha(): void { namedReceiptLeafA(); }\r\n",
+    "class NamedReceiptOwnerA { public static function run(): void { namedReceiptLeafA(); } }\r\n",
+    "function namedReceiptHost(): void { namedReceiptAlpha(); NamedReceiptOwnerA::run(); }\r\n",
+);
+
+async fn named_receipt_refused(backend: &Backend, item: &CallHierarchyItem) -> (bool, bool) {
+    let outgoing = backend
+        .outgoing_calls(CallHierarchyOutgoingCallsParams {
+            item: item.clone(),
+            work_done_progress_params: Default::default(),
+            partial_result_params: Default::default(),
+        })
+        .await
+        .unwrap();
+    let incoming = backend
+        .incoming_calls(CallHierarchyIncomingCallsParams {
+            item: item.clone(),
+            work_done_progress_params: Default::default(),
+            partial_result_params: Default::default(),
+        })
+        .await
+        .unwrap();
+    (outgoing.is_none(), incoming.is_none())
+}
+
+async fn named_receipt_positive(backend: &Backend, item: &CallHierarchyItem, leaf: &str) {
+    let edges = outgoing(backend, item).await;
+    assert_eq!(
+        edges.len(),
+        1,
+        "a real body must establish a nonempty positive control"
+    );
+    assert_eq!(edges[0].to.name, leaf);
+    let callers = incoming(backend, item).await;
+    assert_eq!(
+        callers.len(),
+        1,
+        "the actual host invokes this named declaration"
+    );
+    assert_eq!(callers[0].from.name, "namedReceiptHost");
+    assert_eq!(callers[0].from_ranges.len(), 1);
+}
+
+#[tokio::test]
+async fn named_call_receipt_function_refuses_accepted_same_offset_rename() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///named-receipt-function.php").unwrap();
+    open_php(&backend, &uri, NAMED_RECEIPT_SOURCE).await;
+    let original =
+        anonymous_hierarchy_prepare(&backend, &uri, NAMED_RECEIPT_SOURCE, "namedReceiptAlpha")
+            .await;
+    named_receipt_positive(&backend, &original, "namedReceiptLeafA").await;
+    let changed = NAMED_RECEIPT_SOURCE.replace("namedReceiptAlpha", "namedReceiptBravo");
+    assert_eq!(changed.len(), NAMED_RECEIPT_SOURCE.len());
+    anonymous_hierarchy_change(&backend, &uri, &changed).await;
+    let current = anonymous_hierarchy_prepare(&backend, &uri, &changed, "namedReceiptBravo").await;
+    assert_eq!(current.selection_range, original.selection_range);
+    assert_eq!(
+        current.data.as_ref().unwrap()["offset"],
+        original.data.as_ref().unwrap()["offset"]
+    );
+    assert_ne!(
+        current.data.as_ref().unwrap()["function"],
+        original.data.as_ref().unwrap()["function"]
+    );
+    named_receipt_positive(&backend, &current, "namedReceiptLeafA").await;
+    assert_eq!(
+        named_receipt_refused(&backend, &original).await,
+        (true, true),
+        "an old function identity cannot authorize the replacement at its retained offset"
+    );
+}

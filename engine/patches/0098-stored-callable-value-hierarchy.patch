+    /// Central setters already represent writes used by assignments, array
+    /// mutation and by-reference parameters. Propagate without recursively
+    /// calling them; ordinary scopes have no reference metadata and return.
+    pub(super) fn write_reference_peers(
+        &mut self,
+        name: &str,
+        types: &[ResolvedType],
+        unresolved: bool,
+    ) {
+        let Some(cells) = self.reference_cells.as_ref() else {
+            return;
+        };

+#[test]
+fn callable_source_lookup_marks_unknown_branch_incomplete_and_reassignment_revokes_origin() {
+    use crate::type_engine::resolver::VarResolutionCtx;
+    use crate::types::CallableValueSource;
+    use sha2::{Digest, Sha256};
+
+    let content = r#"<?php
+function storedUnknownBranch(bool $condition, callable $unknown): void {
+    $stored = function (): int { return 1; };
+    if ($condition) {
+        $stored = $unknown;
+    }
+    $stored(); // merged
+    $stored = $unknown;
+    $stored(); // overwritten
+}
+"#;
+    let source = Arc::new(CallableValueSource {
+        uri: "file:///stored-unknown-branch.php".to_owned(),
+        source_sha256: Sha256::digest(content.as_bytes()).into(),
+        source_length: content.len() as u32,
+    });
+    let loader = |_: &str| None;
+    let merged_offset = content.find("$stored(); // merged").unwrap() as u32;
+    let class = crate::class_lookup::class_context_placeholder(content, merged_offset);
+    let ctx = VarResolutionCtx::new("$stored", &class, &[], content, merged_offset, &loader);
+    let values = super::resolve_variable_types_with_callable_source(&ctx, Arc::clone(&source));
+    let origins = ResolvedType::joined_callable_origins(&values)
+        .expect("known possibility survives alongside the unknown callable branch");
+    assert!(
+        !origins.complete,
+        "unknown callable value prevents exhaustive resolution"
+    );
+    assert_eq!(origins.origins.len(), 1);
+    let origin = &origins.origins[0];
+    assert_eq!(origin.source, source);
+    assert_eq!(
+        &content[origin.expression_start as usize..origin.expression_end as usize],
+        "function (): int { return 1; }"
+    );
+
+    let overwritten_offset = content.find("$stored(); // overwritten").unwrap() as u32;
+    let overwritten_ctx =
+        VarResolutionCtx::new("$stored", &class, &[], content, overwritten_offset, &loader);
+    let overwritten = super::resolve_variable_types_with_callable_source(&overwritten_ctx, source);
+    assert!(
+        !overwritten.is_empty(),
+        "the unknown parameter still has a callable type"
+    );
+    assert!(
+        ResolvedType::joined_callable_origins(&overwritten).is_none(),
+        "an unconditional unknown write must remove the old closure origin"
+    );
+}

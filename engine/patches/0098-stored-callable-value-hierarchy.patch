diff --git a/src/call_hierarchy/stored.rs b/src/call_hierarchy/stored.rs
new file mode 100644
index 0000000..fd434a0
--- /dev/null
+++ b/src/call_hierarchy/stored.rs
@@ -0,0 +1,473 @@
+//! Stored callable targets reuse source-qualified variable flow and syntax receipts.
+use super::*;
+use crate::symbol_map::{CallableValueSite, CallableValueSyntax, VariableCallableInvocation};
+use crate::type_engine::resolver::{Loaders, VarResolutionCtx};
+use crate::types::{CallableValueOrigin, CallableValueSource, ResolvedType};
+
+#[derive(Default)]
+struct StoredCallResolution {
+    callees: Vec<PhpCallable>,
+    complete: bool,
+}
+
+impl Backend {
+    fn variable_callables(
+        &self,
+        cache: &mut FileCache,
+        uri: &str,
+        site: &VariableCallableInvocation,
+    ) -> StoredCallResolution {
+        let Some((content, _, Some(hash))) = self.cached_file(cache, uri) else {
+            return StoredCallResolution::default();
+        };
+        let Ok(source_length) = u32::try_from(content.len()) else {
+            return StoredCallResolution::default();
+        };
+        if site.invocation_start >= site.invocation_end
+            || content
+                .get(site.invocation_start as usize..site.invocation_end as usize)
+                .is_none()
+        {
+            return StoredCallResolution::default();
+        }
+        let context = self.file_context_at(uri, site.invocation_start);
+        let placeholder =
+            crate::class_lookup::class_context_placeholder(&content, site.invocation_start);
+        let current_class =
+            crate::class_lookup::find_class_at_offset(&context.classes, site.invocation_start)
+                .unwrap_or(&placeholder);
+        let class_loader = self.class_loader(&context);
+        let function_loader = self.function_loader(&context);
+        let ctx = VarResolutionCtx {
+            backend: Some(self),
+            loaders: Loaders::with_function(Some(&function_loader)),
+            ..VarResolutionCtx::new(
+                &site.variable,
+                current_class,
+                &context.classes,
+                &content,
+                site.invocation_start,
+                &class_loader,
+            )
+        };
+        let values =
+            crate::type_engine::variable::resolution::resolve_variable_types_with_callable_source(
+                &ctx,
+                Arc::new(CallableValueSource {
+                    uri: uri.to_owned(),
+                    source_sha256: hash,
+                    source_length,
+                }),
+            );
+        let Some(origins) = ResolvedType::joined_callable_origins(&values) else {
+            return StoredCallResolution::default();
+        };
+        let mut result = StoredCallResolution {
+            callees: Vec::new(),
+            complete: origins.complete,
+        };
+        for origin in &origins.origins {
+            let resolved = self.stored_origin_callables(cache, origin);
+            result.complete &= resolved.complete;
+            for callee in resolved.callees {
+                if !result
+                    .callees
+                    .iter()
+                    .any(|existing| php_item_key(&existing.item) == php_item_key(&callee.item))
+                {
+                    result.callees.push(callee);
+                }
+            }
+        }
+        result
+    }
+
+    fn stored_origin_callables(
+        &self,
+        cache: &mut FileCache,
+        origin: &CallableValueOrigin,
+    ) -> StoredCallResolution {
+        let uri = origin.source.uri.as_str();
+        let Some((content, map, Some(hash))) = self.cached_file(cache, uri) else {
+            return StoredCallResolution::default();
+        };
+        if hash != origin.source.source_sha256
+            || usize::try_from(origin.source.source_length).ok() != Some(content.len())
+            || origin.expression_start >= origin.expression_end
+            || content
+                .get(origin.expression_start as usize..origin.expression_end as usize)
+                .is_none()
+        {
+            return StoredCallResolution::default();
+        }
+        if let Some(snapshot) = &origin.array_snapshot
+            && snapshot.transformed
+        {
+            return self.stored_array_snapshot_callables(cache, uri, origin, &snapshot.shape);
+        }
+        let start = map
+            .callable_value_sites
+            .partition_point(|site| site.expression_start < origin.expression_start);
+        let records = map.callable_value_sites[start..]
+            .iter()
+            .take_while(|site| site.expression_start == origin.expression_start)
+            .filter(|site| site.expression_end == origin.expression_end);
+        let mut result = StoredCallResolution::default();
+        for record in records {
+            if let CallableValueSyntax::Array(array) = &record.kind
+                && array.php80.is_some_and(|mode| {
+                    mode != (self.php_version() >= crate::types::PhpVersion::new(8, 0))
+                })
+            {
+                continue;
+            }
+            let callees = self.stored_value_callables(cache, uri, &content, &map, &hash, record);
+            if callees.is_empty() {
+                result.complete = false;
+                return result;
+            }
+            result.complete = true;
+            for callee in callees {
+                if !result
+                    .callees
+                    .iter()
+                    .any(|existing| php_item_key(&existing.item) == php_item_key(&callee.item))
+                {
+                    result.callees.push(callee);
+                }
+            }
+        }
+        result
+    }
+
+    /// A source-qualified write transforms an already proven array value.
+    /// Only a sealed, complete pair grants an edge; no annotation-only shape
+    /// or independently joined receiver/method keys enter this path.
+    fn stored_array_snapshot_callables(
+        &self,
+        cache: &mut FileCache,
+        uri: &str,
+        origin: &CallableValueOrigin,
+        shape: &crate::php_type::PhpType,
+    ) -> StoredCallResolution {
+        let crate::php_type::TypeKind::ArrayShape(entries) = shape.kind() else {
+            return StoredCallResolution::default();
+        };
+        if shape.as_unsealed_shape().is_some()
+            || entries.len() != 2
+            || entries.iter().any(|entry| entry.optional)
+        {
+            return StoredCallResolution::default();
+        }
+        let slot = |wanted: &str| {
+            entries.iter().enumerate().find_map(|(index, entry)| {
+                let positional = index.to_string();
+                (entry.key.as_deref().unwrap_or(&positional) == wanted).then_some(&entry.value_type)
+            })
+        };
+        let (Some(receiver), Some(method)) = (slot("0"), slot("1")) else {
+            return StoredCallResolution::default();
+        };
+        let Some(crate::php_type::LiteralValue::String(raw)) = method.as_literal() else {
+            return StoredCallResolution::default();
+        };
+        let Some(method) = crate::util::unescape_php_string_literal(raw) else {
+            return StoredCallResolution::default();
+        };
+        let member = crate::atom::atom(&method);
+        let context = self.file_context_at(uri, origin.expression_start);
+        let lexical =
+            crate::class_lookup::find_class_at_offset(&context.classes, origin.expression_start);
+        let class_loader = self.class_loader(&context);
+        let mut candidates = Vec::new();
+        let mut complete = true;
+        for receiver in receiver.union_members() {
+            if let Some(name) = receiver.as_class_name_literal() {
+                if let Some(class) = self.find_or_load_class(name) {
+                    candidates.push((class, true, false));
+                } else {
+                    complete = false;
+                }
+            } else if let Some(crate::php_type::LiteralValue::String(raw)) = receiver.as_literal() {
+                if let Some(name) = crate::util::unescape_php_string_literal(raw)
+                    && let Some(class) = self.find_or_load_class(name.trim_start_matches('\\'))
+                    && class
+                        .fqn()
+                        .eq_ignore_ascii_case(name.trim_start_matches('\\'))
+                {
+                    candidates.push((class, true, false));
+                } else {
+                    complete = false;
+                }
+            } else if matches!(receiver.kind(), crate::php_type::TypeKind::ClassString(_)) {
+                let classes = crate::type_engine::resolver::resolve_class_string_inner_classes(
+                    receiver,
+                    lexical.map_or("", |class| class.name.as_str()),
+                    &context.classes,
+                    &class_loader,
+                );
+                if classes.is_empty() {
+                    complete = false;
+                }
+                candidates.extend(classes.into_iter().map(|class| (class, true, true)));
+            } else if let Some(name) = receiver.class_name()
+                && !name.starts_with(crate::types::ANONYMOUS_CLASS_PREFIX)
+                && let Some(class) = self.find_or_load_class(name)
+            {
+                candidates.push((class, false, false));
+            } else {
+                complete = false;
+            }
+        }
+        let callees = self.concrete_array_candidates(
+            cache,
+            uri,
+            (&context.classes, lexical),
+            "",
+            &member,
+            candidates,
+        );
+        StoredCallResolution {
+            complete: complete && !callees.is_empty(),
+            callees,
+        }
+    }
+
+    fn stored_value_callables(
+        &self,
+        cache: &mut FileCache,
+        uri: &str,
+        content: &str,
+        map: &SymbolMap,
+        source_hash: &[u8; 32],
+        value: &CallableValueSite,
+    ) -> Vec<PhpCallable> {
+        match &value.kind {
+            CallableValueSyntax::RuntimeString { target } => self
+                .literal_callable(
+                    cache,
+                    uri,
+                    &LiteralCallableInvocation {
+                        target: *target,
+                        invoking_scope_start: map.find_enclosing_scope(value.expression_start),
+                        invocation_start: value.expression_start,
+                        invocation_end: value.expression_end,
+                    },
+                )
+                .into_iter()
+                .collect(),
+            CallableValueSyntax::Anonymous { keyword_start } => {
+                let Some(record) = map.anonymous_callables.iter().find(|record| {
+                    record.keyword_start == *keyword_start
+                        && record.expression_start == value.expression_start
+                        && record.expression_end == value.expression_end
+                }) else {
+                    return Vec::new();
+                };
+                build_anonymous_callable(uri, content, record, source_hash)
+                    .into_iter()
+                    .collect()
+            }
+            CallableValueSyntax::Object { receiver } => {
+                let Some((class, late_static)) = self.immediate_object_receiver_class(
+                    uri,
+                    map,
+                    receiver,
+                    value.expression_start,
+                ) else {
+                    return Vec::new();
+                };
+                self.concrete_method_callable(cache, uri, &class, "__invoke", late_static)
+                    .into_iter()
+                    .collect()
+            }
+            CallableValueSyntax::Array(array) => {
+                self.array_callables(cache, uri, content, map, array)
+            }
+            CallableValueSyntax::FirstClass {
+                callee_start,
+                callee_end,
+            } => {
+                if self.php_version() < crate::types::PhpVersion::new(8, 1)
+                    || *callee_start < value.expression_start
+                    || *callee_end > value.expression_end
+                    || callee_start >= callee_end
+                {
+                    return Vec::new();
+                }
+                let span = map
+                    .spans
+                    .iter()
+                    .filter(|span| {
+                        span.start >= *callee_start
+                            && (span.end == *callee_end
+                                || map.literal_method_selectors.iter().any(|selector| {
+                                    selector.start == span.start
+                                        && selector.end == span.end
+                                        && selector.literal_end == *callee_end
+                                }))
+                            && matches!(
+                                span.kind,
+                                SymbolKind::FunctionCall { .. }
+                                    | SymbolKind::MemberAccess {
+                                        is_method_call: true,
+                                        is_array_callable: false,
+                                        ..
+                                    }
+                            )
+                    })
+                    .max_by_key(|span| span.end);
+                let Some(span) = span else {
+                    return Vec::new();
+                };
+                if let SymbolKind::MemberAccess {
+                    subject_text,
+                    member_name,
+                    is_static,
+                    ..
+                } = &span.kind
+                {
+                    return self.array_callables(
+                        cache,
+                        uri,
+                        content,
+                        map,
+                        &ArrayCallableInvocation {
+                            selector_start: span.start,
+                            selector_end: span.end,
+                            subject_text: subject_text.clone(),
+                            member_name: *member_name,
+                            is_static: *is_static,
+                            php80: None,
+                            allocation: None,
+                            invoking_scope_start: map.find_enclosing_scope(value.expression_start),
+                            invocation_start: value.expression_start,
+                            invocation_end: value.expression_end,
+                        },
+                    );
+                }
+                let position = offset_to_position(content, span.start as usize);
+                // Definition resolves the lexical function head at creation,
+                // never the later variable or a rebound method receiver.
+                self.resolve_definition(uri, content, position)
+                    .into_iter()
+                    .filter_map(|location| self.php_callable_at_location(cache, &location))
+                    .collect()
+            }
+        }
+    }
+
+    pub(super) fn collect_stored_incoming(
+        &self,
+        cache: &mut FileCache,
+        target: &PhpCallable,
+        grouped: &mut HashMap<String, (CallHierarchyItem, Vec<Range>)>,
+    ) -> bool {
+        let mut complete = true;
+        for (uri, _) in self
+            .user_file_symbol_maps()
+            .into_iter()
+            .filter(|(_, map)| !map.variable_callable_invocations.is_empty())
+        {
+            let Some((content, map, Some(hash))) = self.cached_file(cache, &uri) else {
+                complete = false;
+                continue;
+            };
+            for site in &map.variable_callable_invocations {
+                if matches!(
+                    map.call_execution_owner(site.invocation_start),
+                    Some(CallExecutionOwner::Deferred)
+                ) {
+                    continue;
+                }
+                let Some(caller) = self.syntactic_call_site_caller(
+                    cache,
+                    &uri,
+                    &content,
+                    &map,
+                    &hash,
+                    SyntacticCallSite {
+                        start: site.invocation_start,
+                        end: site.invocation_end,
+                        scope: site.invoking_scope_start,
+                    },
+                ) else {
+                    complete = false;
+                    continue;
+                };
+                let resolved = self.variable_callables(cache, &uri, site);
+                complete &= resolved.complete;
+                if !resolved
+                    .callees
+                    .iter()
+                    .any(|callee| php_item_key(&callee.item) == php_item_key(&target.item))
+                {
+                    continue;
+                }
+                let range = byte_range_to_lsp_range(
+                    &content,
+                    site.invocation_start as usize,
+                    site.invocation_end as usize,
+                );
+                grouped
+                    .entry(php_item_key(&caller.item))
+                    .and_modify(|(_, ranges)| push_unique_range(ranges, range))
+                    .or_insert_with(|| (caller.item, vec![range]));
+            }
+        }
+        complete
+    }
+
+    pub(super) fn collect_stored_outgoing(
+        &self,
+        cache: &mut FileCache,
+        target: &PhpCallable,
+        grouped: &mut HashMap<String, (CallHierarchyItem, Vec<Range>)>,
+    ) -> bool {
+        let uri = target.item.uri.as_str();
+        let Some((content, map, Some(hash))) = self.cached_file(cache, uri) else {
+            return false;
+        };
+        let mut complete = true;
+        for site in &map.variable_callable_invocations {
+            if matches!(
+                map.call_execution_owner(site.invocation_start),
+                Some(CallExecutionOwner::Deferred)
+            ) {
+                continue;
+            }
+            let Some(caller) = self.syntactic_call_site_caller(
+                cache,
+                uri,

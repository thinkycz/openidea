+#[tokio::test]
+async fn stored_callable_reassignment_unknown_overwrite_and_branch_alternatives_keep_flow_identity()
+{
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///stored-callable-flow.php").unwrap();
+    let source = concat!(
+        "<?php\r\n",

@@ -0,0 +1,223 @@
+//! Direct-local PHP reference cells for source-qualified callable provenance.
+//!
+//! `definite` is an equivalence relation represented by all pairs in each
+//! cell. `possible` contains direct pair alternatives from branch joins. It
+//! is deliberately not transitively closed: separate possible relationships
+//! need not hold on the same execution path.
+
+use super::*;
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub(super) struct ReferenceCells {
+    definite: Vec<(Atom, Atom)>,
+    possible: Vec<(Atom, Atom)>,
+    opaque: bool,
+}
+
+fn pair(a: Atom, b: Atom) -> (Atom, Atom) {
+    if a.as_str() < b.as_str() {
+        (a, b)
+    } else {
+        (b, a)
+    }
+}
+
+fn push_pair(pairs: &mut Vec<(Atom, Atom)>, a: Atom, b: Atom) {
+    if a != b {
+        let item = pair(a, b);
+        if !pairs.contains(&item) {
+            pairs.push(item);
+            pairs.sort_unstable_by(|a, b| {
+                (a.0.as_str(), a.1.as_str()).cmp(&(b.0.as_str(), b.1.as_str()))
+            });
+        }
+    }
+}
+
+fn peers(pairs: &[(Atom, Atom)], key: Atom) -> Vec<Atom> {
+    pairs
+        .iter()
+        .filter_map(|&(a, b)| {
+            if a == key {
+                Some(b)
+            } else if b == key {
+                Some(a)
+            } else {
+                None
+            }
+        })
+        .collect()
+}
+
+impl ScopeState {
+    pub(crate) fn same_reference_state_as(&self, other: &Self) -> bool {
+        self.reference_cells == other.reference_cells
+    }
+
+    pub(super) fn sanitize_reference_origins(&self, values: &mut [ResolvedType]) {
+        if self
+            .reference_cells
+            .as_ref()
+            .is_some_and(|cells| cells.opaque)
+        {
+            for value in values {
+                value.callable_origins = None;
+            }
+        }
+    }
+
+    /// An unmodelled cell (indexed/property/dynamic reference), or a reference
+    /// relation beyond the budget, makes subsequent callable values unknown.
+    /// Preserve normal type information, but never publish stale provenance.
+    pub(crate) fn mark_references_opaque(&mut self) {
+        let cells = self.reference_cells.get_or_insert_with(Default::default);
+        cells.opaque = true;
+        cells.definite.clear();
+        cells.possible.clear();
+        let keys: Vec<_> = self.locals.keys().copied().collect();
+        for key in keys {
+            if let Some(values) = self.locals.get_mut(&key) {
+                for value in values {
+                    value.callable_origins = None;
+                }
+            }
+        }
+    }
+
+    pub(crate) fn has_reference_peers(&self, name: &str) -> bool {
+        let key = atom(name);
+        self.reference_cells.as_ref().is_some_and(|cells| {
+            cells
+                .definite
+                .iter()
+                .chain(&cells.possible)
+                .any(|&(a, b)| a == key || b == key)
+        })
+    }
+
+    pub(crate) fn detach_reference(&mut self, name: &str) {
+        if let Some(cells) = self.reference_cells.as_mut() {
+            let key = atom(name);
+            cells.definite.retain(|&(a, b)| a != key && b != key);
+            cells.possible.retain(|&(a, b)| a != key && b != key);
+        }
+    }
+
+    pub(crate) fn bind_reference(&mut self, name: &str, target: &str) {
+        if name == target {
+            return;
+        }
+        self.detach_reference(name);
+        self.invalidate_dependent_keys(name);
+        self.invalidate_proofs(name);
+        let types = self.get(target).to_vec();
+        if types.is_empty() {
+            self.set_untyped(name);
+        } else {
+            self.set(name, types);
+        }
+        let key = atom(name);
+        let target = atom(target);
+        let cells = self.reference_cells.get_or_insert_with(Default::default);
+        if cells.opaque {
+            return;
+        }
+        let mut members = peers(&cells.definite, target);
+        members.push(target);
+        for member in members {
+            push_pair(&mut cells.definite, key, member);
+        }
+        for possible in peers(&cells.possible, target) {
+            push_pair(&mut cells.possible, key, possible);
+        }
+        if cells.definite.len() + cells.possible.len() > 512 {
+            self.mark_references_opaque();
+        }
+    }

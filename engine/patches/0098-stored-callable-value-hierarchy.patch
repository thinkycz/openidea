+    let a = anonymous_hierarchy_prepare(&backend, &uri, source, "a(int $n)").await;
+    let b = anonymous_hierarchy_prepare(&backend, &uri, source, "b(int $n)").await;
+    let edges = stored_callable_observed_edges(&backend, &host, source).await;
+    stored_callable_assert_edge(
+        &backend,
+        &host,
+        &edges,
+        &a,
+        vec![noncall_exact_range(source, "$copy(302)", "(302)")],
+    )
+    .await;
+    stored_callable_assert_edge(
+        &backend,
+        &host,

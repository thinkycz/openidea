+/// Resolve source-derived callable values through the ordinary variable walker.
+///
+/// The caller supplies the exact parsed source receipt. Ordinary per-pass
+/// memos and diagnostic snapshots contain type-only values and must not stand
+/// in for this source-qualified lookup. Nested foreign-source lookups start
+/// without authority rather than inheriting the caller's URI.
+pub(crate) fn resolve_variable_types_with_callable_source(
+    ctx: &VarResolutionCtx<'_>,
+    source: Arc<crate::types::CallableValueSource>,
+) -> Vec<ResolvedType> {
+    if usize::try_from(source.source_length).ok() != Some(ctx.content.len())
+        || source.uri.is_empty()
+    {
+        return Vec::new();
+    }
+    let variable = if ctx.var_name.starts_with('$') {
+        std::borrow::Cow::Borrowed(ctx.var_name)
+    } else {
+        std::borrow::Cow::Owned(format!("${}", ctx.var_name))
+    };
+    let key = var_query_key(
+        ctx.content,
+        &variable,
+        ctx.cursor_offset,
+        ctx.current_class.name,
+    );
+    let Some(_guard) = try_acquire_var_guard(key) else {
+        return Vec::new();
+    };
+    let _diagnostics = super::forward_walk::suspend_diagnostic_scope();
+    let mut source_ctx = ctx.clone();
+    source_ctx.var_name = &variable;
+    source_ctx.callable_source = Some(source);
+    source_ctx.top_level_scope = None;
+    with_parsed_program(
+        ctx.content,
+        "resolve_callable_variable_values",
+        |program, _| resolve_variable_in_statements(program.statements.iter(), &source_ctx),
+    )

+                continue;
+            }
+            self.invalidate_dependent_keys(peer.as_str());
+            self.invalidate_proofs(peer.as_str());
+            self.unresolved.remove(&peer);
+            // A possible write preserves both source-known alternatives. An
+            // unknown old/new value is top: keep the known alternatives only
+            // as incomplete provenance, never as a definite current value.
+            let values = self.locals.get_or_insert_default(peer);
+            for incoming in types {
+                if let Some(existing) = values.iter_mut().find(|value| {
+                    value.type_string == incoming.type_string
+                        && value.class_info.as_ref().map(|class| &class.name)
+                            == incoming.class_info.as_ref().map(|class| &class.name)
+                }) {
+                    existing.join_callable_origins(incoming);
+                } else {
+                    values.push(incoming.clone());
+                }
+            }
+            for value in values {
+                value.mark_callable_origins_incomplete();
+            }
+        }
+    }
+
+    pub(super) fn merge_reference_cells(&mut self, other: &ScopeState) {
+        if self.reference_cells.is_none() && other.reference_cells.is_none() {
+            return;
+        }
+        let mine = self.reference_cells.take().unwrap_or_default();
+        let theirs = other.reference_cells.as_deref();
+        let mut joined = ReferenceCells::default();
+        for &(a, b) in &mine.definite {
+            if theirs.is_some_and(|cells| cells.definite.contains(&(a, b))) {
+                push_pair(&mut joined.definite, a, b);
+            } else {
+                push_pair(&mut joined.possible, a, b);
+            }
+        }
+        for &(a, b) in &mine.possible {
+            push_pair(&mut joined.possible, a, b);
+        }
+        if let Some(theirs) = theirs {
+            for &(a, b) in theirs.definite.iter().chain(&theirs.possible) {
+                if !joined.definite.contains(&(a, b)) {
+                    push_pair(&mut joined.possible, a, b);
+                }
+            }
+        }
+        let opaque = mine.opaque
+            || theirs.is_some_and(|cells| cells.opaque)
+            || joined.definite.len() + joined.possible.len() > 512;
+        self.reference_cells = Some(Box::new(joined));
+        if opaque {
+            self.mark_references_opaque();
+        }
+    }
+}

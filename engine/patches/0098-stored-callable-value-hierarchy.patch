+#[tokio::test]
+async fn stored_callable_byref_unknown_unset_and_compound_writes_cannot_reuse_old_origins() {
+    for (label, write, direct_mutator) in [
+        (
+            "typed-byref",
+            "mutationReplaceUnknown($stored, $unknown);",
+            true,
+        ),
+        (
+            "untyped-byref",
+            "mutationReplaceUntyped($stored, $unknown);",
+            true,
+        ),
+        ("unset", "unset($stored);", false),
+        ("compound", "$stored .= ' invalid';", false),
+    ] {
+        let backend = create_test_backend();
+        let uri = Url::parse(&format!("file:///stored-invalidation-{label}.php")).unwrap();
+        let source = [
+            "<?php\r\n",
+            "function mutationA(int $n): int { return $n; }\r\n",
+            "function mutationReplaceUnknown(string &$value, string $unknown): void { $value = $unknown; }\r\n",
+            "function mutationReplaceUntyped(&$value, string $unknown): void { $value = $unknown; }\r\n",
+            "function storedPositiveControl(): void {}\r\n",
+            "function mutationInvalidationHost(string $unknown): void {\r\n",
+            " storedPositiveControl(); $stored = 'mutationA'; /* café 🐘 */ $stored(201);\r\n ",
+            write,
+            " $stored(202);\r\n}\r\n",
+        ].concat();
+        open_php(&backend, &uri, &source).await;
+        let host = array_exact_root(&backend, &uri, &source, "mutationInvalidationHost").await;
+        let target = array_exact_root(&backend, &uri, &source, "mutationA").await;
+        let edges = stored_callable_observed_edges(&backend, &host, &source).await;
+        stored_callable_assert_edge(
+            &backend,
+            &host,
+            &edges,
+            &target,
+            vec![noncall_exact_range(&source, "$stored(201)", "(201)")],
+        )
+        .await;
+        let forbidden = noncall_exact_range(&source, "$stored(202)", "(202)");
+        assert!(
+            edges
+                .iter()
+                .all(|edge| !edge.from_ranges.contains(&forbidden)),
+            "{label}: unknown byref output, unset, and a string containing spaces cannot inherit an old callable target"
+        );
+        assert_eq!(edges.len(), if direct_mutator { 3 } else { 2 });
+        backend.shutdown().await.unwrap();

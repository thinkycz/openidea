+#[tokio::test]
+async fn stored_callable_branch_closures_keep_same_signature_distinct_body_origins() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///stored-branch-same-signature.php").unwrap();
+    let source = concat!(
+        "<?php\r\n",
+        "function mutationA(int $n): int { return $n; }\r\n",
+        "function mutationB(int $n): int { return $n; }\r\n",
+        "function storedPositiveControl(): void {}\r\n",
+        "function mutationBranchHost(bool $flag): void {\r\n",
+        " $first = static function (int $n): int { return mutationA($n); };\r\n",
+        " $second = static function (int $n): int { return mutationB($n); };\r\n",
+        " $selected = $first; if ($flag) { $selected = $second; }\r\n",
+        " /* café 🐘 */ $selected(401); storedPositiveControl();\r\n}\r\n",
+    );
+    open_php(&backend, &uri, source).await;
+    let host = array_exact_root(&backend, &uri, source, "mutationBranchHost").await;
+    let first = anonymous_hierarchy_prepare(
+        &backend,
+        &uri,
+        source,
+        "function (int $n): int { return mutationA",
+    )
+    .await;
+    let second = anonymous_hierarchy_prepare(
+        &backend,
+        &uri,
+        source,
+        "function (int $n): int { return mutationB",
+    )
+    .await;
+    assert_ne!(first.selection_range, second.selection_range);
+    let edges = stored_callable_observed_edges(&backend, &host, source).await;
+    let site = noncall_exact_range(source, "$selected(401)", "(401)");
+    for (target, leaf, body_context) in [
+        (&first, "mutationA", "return mutationA($n)"),
+        (&second, "mutationB", "return mutationB($n)"),
+    ] {
+        stored_callable_assert_edge(&backend, &host, &edges, target, vec![site]).await;
+        let body = outgoing(&backend, target).await;
+        assert_eq!(body.len(), 1);
+        assert_eq!(body[0].to.name, leaf);
+        assert_eq!(
+            body[0].from_ranges,
+            [noncall_exact_range(source, body_context, leaf)]
+        );
+        array_exact_reverse(&backend, target, &body[0]).await;
+    }
+    assert_eq!(
+        edges.len(),
+        3,
+        "equal callable signatures do not merge distinct closure body identities"
+    );
+    backend.shutdown().await.unwrap();
+}

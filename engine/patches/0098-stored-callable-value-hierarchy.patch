+    let source = concat!(
+        "<?php\r\n",
+        "function storedClosureLeaf(): void {}\r\n",
+        "function storedUnusedClosureLeaf(): void {}\r\n",
+        "function storedPositiveControl(): void {}\r\n",
+        "function storedClosureHost(): void {\r\n",
+        " $stored = function (int $n): int { storedClosureLeaf(); return $n; };\r\n",
+        " $uninvoked = function () { storedUnusedClosureLeaf(); };\r\n",
+        " /* café 🐘 */ $stored(301); $stored(302);\r\n",
+        " storedPositiveControl();\r\n}\r\n",
+    );
+    open_php(&backend, &uri, source).await;
+    let host = array_exact_root(&backend, &uri, source, "storedClosureHost").await;
+    let target = anonymous_hierarchy_prepare(&backend, &uri, source, "function (int $n)").await;
+    let uninvoked = anonymous_hierarchy_prepare(
+        &backend,
+        &uri,
+        source,
+        "function () { storedUnusedClosureLeaf",
+    )
+    .await;
+    let body = outgoing(&backend, &target).await;
+    assert_eq!(body.len(), 1);
+    assert_eq!(body[0].to.name, "storedClosureLeaf");
+    assert_eq!(
+        body[0].from_ranges,
+        [noncall_exact_range(
+            source,
+            "{ storedClosureLeaf();",
+            "storedClosureLeaf"
+        )]
+    );
+    let unused_body = outgoing(&backend, &uninvoked).await;
+    assert_eq!(unused_body.len(), 1);
+    assert_eq!(unused_body[0].to.name, "storedUnusedClosureLeaf");
+    let edges = stored_callable_observed_edges(&backend, &host, source).await;
+    stored_callable_assert_edge(
+        &backend,
+        &host,
+        &edges,
+        &target,
+        vec![
+            noncall_exact_range(source, "$stored(301)", "(301)"),
+            noncall_exact_range(source, "$stored(302)", "(302)"),
+        ],
+    )
+    .await;
+    assert_eq!(
+        edges.len(),
+        2,
+        "nested body calls belong to the closures, not their creating host"
+    );
+    assert!(
+        incoming(&backend, &uninvoked).await.is_empty(),
+        "an uninvoked stored closure has no caller"
+    );
+    backend.shutdown().await.unwrap();

+        "function storedFlowB(int $n): int { return $n; }\r\n",
+        "function storedPositiveControl(): void {}\r\n",
+        "function storedFlowHost(callable $unknown, bool $flag): void {\r\n",
+        " $known = 'storedFlowA'; $known(701);\r\n",
+        " $known = 'storedFlowB'; $known(702);\r\n",
+        " $maybe = 'storedFlowA'; $maybe = $unknown; $maybe(703);\r\n",
+        " $branch = 'storedFlowA'; if ($flag) { $branch = 'storedFlowB'; }\r\n",
+        " /* café 🐘 */ $branch(704); $unknown(705);\r\n",
+        " $uninvoked = 'storedFlowA'; storedPositiveControl();\r\n}\r\n",
+    );
+    open_php(&backend, &uri, source).await;
+    let host = array_exact_root(&backend, &uri, source, "storedFlowHost").await;
+    let a = array_exact_root(&backend, &uri, source, "storedFlowA").await;
+    let b = array_exact_root(&backend, &uri, source, "storedFlowB").await;
+    let edges = stored_callable_observed_edges(&backend, &host, source).await;
+    let branch_site = noncall_exact_range(source, "$branch(704)", "(704)");
+    stored_callable_assert_edge(
+        &backend,
+        &host,
+        &edges,
+        &a,
+        vec![
+            noncall_exact_range(source, "$known(701)", "(701)"),
+            branch_site,
+        ],
+    )
+    .await;
+    stored_callable_assert_edge(
+        &backend,
+        &host,
+        &edges,
+        &b,
+        vec![
+            noncall_exact_range(source, "$known(702)", "(702)"),
+            branch_site,
+        ],
+    )
+    .await;
+    assert_eq!(
+        edges.len(),
+        3,
+        "known branch alternatives are possible callees; unknown values cannot inherit a stale known target"
+    );
+    backend.shutdown().await.unwrap();
+}

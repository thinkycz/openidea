+#[test]
+fn callable_source_lookup_partitions_identical_files_and_bypasses_type_only_memo() {
+    use crate::type_engine::resolver::VarResolutionCtx;
+    use crate::types::CallableValueSource;
+    use sha2::{Digest, Sha256};
+
+    let content = "<?php\r\n/* café 🐘 */ $stored = 'storedLeaf'; $stored(1);\r\n";
+    let offset = content.rfind("$stored(1)").unwrap() as u32;
+    let class = crate::class_lookup::class_context_placeholder(content, offset);
+    let loader = |_: &str| None;
+    let ctx = VarResolutionCtx::new("$stored", &class, &[], content, offset, &loader);
+    let _memo = super::with_var_type_memo();
+    let ordinary = super::resolve_variable_types(
+        "$stored",
+        &class,
+        &[],
+        content,
+        offset,
+        &loader,
+        None,
+        Loaders::default(),
+    );
+    assert!(!ordinary.is_empty());
+    assert!(
+        ordinary
+            .iter()
+            .all(|value| value.callable_origins.is_none())
+    );
+    let digest: [u8; 32] = Sha256::digest(content.as_bytes()).into();
+    for uri in ["file:///same-a.php", "file:///same-b.php"] {
+        let source = Arc::new(CallableValueSource {
+            uri: uri.to_owned(),
+            source_sha256: digest,
+            source_length: content.len() as u32,
+        });
+        let query_ctx = VarResolutionCtx {
+            var_name: if uri.ends_with("same-b.php") {
+                "stored"
+            } else {
+                "$stored"
+            },
+            ..ctx.clone()
+        };
+        let values =
+            super::resolve_variable_types_with_callable_source(&query_ctx, Arc::clone(&source));
+        assert!(!values.is_empty());
+        let origins = ResolvedType::joined_callable_origins(&values)
+            .expect("source-aware lookup mints an actual value origin");
+        assert!(origins.complete);
+        assert_eq!(origins.origins.len(), 1);
+        assert_eq!(origins.origins[0].source, source);
+        let origin = &origins.origins[0];
+        assert_eq!(
+            &content[origin.expression_start as usize..origin.expression_end as usize],
+            "'storedLeaf'"
+        );
+    }
+    let after = super::resolve_variable_types(
+        "$stored",
+        &class,
+        &[],
+        content,
+        offset,
+        &loader,
+        None,
+        Loaders::default(),
+    );
+    assert!(
+        after.iter().all(|value| value.callable_origins.is_none()),
+        "source-qualified results must never populate the ordinary type-only memo"
+    );
+}

+async fn stored_callable_observed_edges(
+    backend: &Backend,
+    caller: &CallHierarchyItem,
+    source: &str,
+) -> Vec<CallHierarchyOutgoingCall> {
+    let edges = outgoing(backend, caller).await;
+    let controls = edges
+        .iter()
+        .filter(|edge| edge.to.name == "storedPositiveControl")
+        .collect::<Vec<_>>();
+    assert_eq!(
+        controls.len(),
+        1,
+        "the public hierarchy must retain a real direct-call positive control"
+    );
+    assert_eq!(
+        controls[0].from_ranges,
+        [noncall_exact_range(
+            source,
+            "storedPositiveControl();",
+            "storedPositiveControl"
+        )]
+    );
+    array_exact_reverse(backend, caller, controls[0]).await;
+    edges
+}
+
+async fn stored_callable_assert_edge(
+    backend: &Backend,
+    caller: &CallHierarchyItem,
+    edges: &[CallHierarchyOutgoingCall],
+    target: &CallHierarchyItem,
+    expected: Vec<Range>,
+) {
+    let matching = edges
+        .iter()
+        .filter(|edge| {
+            edge.to.uri == target.uri && edge.to.selection_range == target.selection_range
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(
+        matching.len(),
+        1,
+        "stored invocation must reach its actual declaration: {target:?}; {edges:?}"
+    );
+    let edge = matching[0];
+    assert_eq!(edge.to.name, target.name);
+    assert_eq!(edge.to.kind, target.kind);
+    assert_eq!(edge.to.range, target.range);
+    assert_eq!(
+        edge.from_ranges, expected,
+        "only later invocation sites may call this body"
+    );
+    array_exact_reverse(backend, caller, edge).await;
+}

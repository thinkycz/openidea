+        "class PairRight { public static function initialLeft(int $n): void {} public static function initialRight(int $n): void {} public static function nextTarget(int $n): void {} }\r\n",
+        "function storedPositiveControl(): void {}\r\n",
+        "function pairMutationHost(bool $flag): void {\r\n",
+        " $pair = [PairLeft::class, 'initialLeft']; if ($flag) { $pair = [PairRight::class, 'initialRight']; }\r\n",
+        " $copy = $pair; $pair[1] = 'nextTarget'; /* café 🐘 */ $pair(901); $copy(902);\r\n",
+        " storedPositiveControl();\r\n}\r\n",
+    );
+    open_php(&backend, &uri, source).await;
+    let host = array_exact_root(&backend, &uri, source, "pairMutationHost").await;
+    let edges = stored_callable_observed_edges(&backend, &host, source).await;
+    for (class, method, context, token) in [
+        ("PairLeft", "nextTarget", "$pair(901)", "(901)"),

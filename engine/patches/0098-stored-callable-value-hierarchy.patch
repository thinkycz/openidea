+// Try: Show Callees on storedCallableNavigation. Follow the later variable
+// calls to their stored function, anonymous body, object method or array target.
+// The scalar copy keeps strlen while the shared reference changes to strtolower.
+function storedCallableNavigation(): array
+{
+    $scalar = 'strlen';
+    $copy = $scalar;
+    $reference =& $scalar;
+    $reference = 'strtolower';
+    $firstClass = strlen(...);
+    $closure = static function (string $value): int { return strlen($value); };
+    $arrow = static fn(string $value): int => strlen($value);
+    $object = new class {
+        public function __invoke(string $value): int { return strlen($value); }
+    };
+    $array = [\DateTimeImmutable::class, 'createFromFormat'];
+    return [
+        'reference' => $scalar('A'),
+        'copy' => $copy('A'),
+        'firstClass' => $firstClass('A'),
+        'closure' => $closure('A'),
+        'arrow' => $arrow('A'),
+        'object' => $object('A'),
+        'array' => $array('!Y', '2026') instanceof \DateTimeImmutable,
+    ];
+}

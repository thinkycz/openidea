+#[tokio::test]
+async fn stored_callable_conditional_reference_cells_and_unset_keep_possible_targets() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///stored-reference-branches.php").unwrap();
+    let source = concat!(
+        "<?php\r\n",
+        "function aliasChoiceA(int $n): void {} function aliasChoiceB(int $n): void {} function aliasChoiceC(int $n): void {}\r\n",
+        "function storedPositiveControl(): void {}\r\n",
+        "function aliasChoiceHost(bool $flag): void {\r\n",
+        " $left = 'aliasChoiceA'; $right = 'aliasChoiceB';\r\n",
+        " if ($flag) { $alias =& $left; } else { $alias =& $right; }\r\n",
+        " $alias = 'aliasChoiceC'; /* café 🐘 */ $left(801); $right(802); $alias(803);\r\n",
+        " $detached = 'aliasChoiceA'; $peer =& $detached; unset($peer); $peer = 'aliasChoiceB';\r\n",
+        " $detached(811); $peer(812); storedPositiveControl();\r\n}\r\n",
+    );
+    open_php(&backend, &uri, source).await;
+    let host = array_exact_root(&backend, &uri, source, "aliasChoiceHost").await;
+    let edges = stored_callable_observed_edges(&backend, &host, source).await;
+    for (name, sites) in [
+        (
+            "aliasChoiceA",
+            vec![("$left(801)", "(801)"), ("$detached(811)", "(811)")],
+        ),
+        (
+            "aliasChoiceB",
+            vec![("$right(802)", "(802)"), ("$peer(812)", "(812)")],
+        ),
+        (
+            "aliasChoiceC",
+            vec![
+                ("$left(801)", "(801)"),
+                ("$right(802)", "(802)"),
+                ("$alias(803)", "(803)"),
+            ],
+        ),
+    ] {
+        let target = array_exact_root(&backend, &uri, source, name).await;
+        stored_callable_assert_edge(
+            &backend,
+            &host,
+            &edges,
+            &target,
+            sites
+                .into_iter()
+                .map(|(context, token)| noncall_exact_range(source, context, token))
+                .collect(),
+        )
+        .await;
+    }
+    assert_eq!(edges.len(), 4);
+    backend.shutdown().await.unwrap();
+}

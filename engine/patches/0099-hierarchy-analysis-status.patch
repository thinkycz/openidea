+++ b/src/project_router_hierarchy.rs
@@ -0,0 +1,95 @@
+//! Query-local hierarchy coverage over the same project/source authority as LSP.
+use super::ProjectRouter;
+use crate::Backend;
+use crate::call_hierarchy::status::HierarchyReply;
+use tower_lsp::jsonrpc::{Error, ErrorCode, Result};
+use tower_lsp::lsp_types::{
+    CallHierarchyIncomingCall, CallHierarchyIncomingCallsParams, CallHierarchyOutgoingCall,
+    CallHierarchyOutgoingCallsParams,
+};
+
+/// Incoming hierarchy with explicit coverage for the requested project.
+pub const CALL_HIERARCHY_INCOMING_ANALYSIS_METHOD: &str = "phpWorkbench/callHierarchyIncoming";
+/// Outgoing hierarchy with explicit coverage for the requested project.
+pub const CALL_HIERARCHY_OUTGOING_ANALYSIS_METHOD: &str = "phpWorkbench/callHierarchyOutgoing";
+
+fn changed_source() -> Error {
+    Error::new(ErrorCode::ServerError(-32801))
+}
+
+impl Backend {
+    /// Resolve callers and their query-local coverage without changing LSP items.
+    pub async fn call_hierarchy_incoming_analysis(
+        &self,
+        params: CallHierarchyIncomingCallsParams,
+    ) -> Result<HierarchyReply<CallHierarchyIncomingCall>> {
+        let backend = self.clone_for_blocking();
+        crate::server::run_blocking_cancel_safe("call_hierarchy_incoming_analysis", move || {
+            backend.ensure_workspace_indexed_for_request();
+            backend.with_prepared_current_semantics(|| {
+                backend
+                    .incoming_calls_analysis_impl(&params.item)
+                    .ok_or_else(changed_source)
+            })
+        })
+        .await
+        .ok_or_else(Error::internal_error)?
+    }
+
+    /// Resolve callees and their query-local coverage without changing LSP items.
+    pub async fn call_hierarchy_outgoing_analysis(
+        &self,
+        params: CallHierarchyOutgoingCallsParams,
+    ) -> Result<HierarchyReply<CallHierarchyOutgoingCall>> {
+        let backend = self.clone_for_blocking();
+        crate::server::run_blocking_cancel_safe("call_hierarchy_outgoing_analysis", move || {
+            backend.with_prepared_current_semantics(|| {
+                backend
+                    .outgoing_calls_analysis_impl(&params.item)
+                    .ok_or_else(changed_source)
+            })
+        })
+        .await
+        .ok_or_else(Error::internal_error)?
+    }
+}
+
+impl ProjectRouter {
+    /// Expand callers in the item's originating project, preserving its receipt.
+    pub async fn workbench_call_hierarchy_incoming(
+        &self,
+        mut params: CallHierarchyIncomingCallsParams,
+    ) -> Result<HierarchyReply<CallHierarchyIncomingCall>> {
+        let _request = self.request_guard().await;
+        let project = self.project_from_data(&mut params.item.data).await?;
+        self.normalize_hierarchy_uri(&project, &mut params.item.uri)?;
+        let mut reply = project
+            .backend
+            .call_hierarchy_incoming_analysis(params)
+            .await?;
+        for edge in &mut reply.items {
+            self.tag_data(&project, &mut edge.from.data);
+        }
+        self.qualify_locations(&project, &mut reply)?;
+        Ok(reply)
+    }
+
+    /// Expand callees in the item's originating project, preserving its receipt.
+    pub async fn workbench_call_hierarchy_outgoing(
+        &self,
+        mut params: CallHierarchyOutgoingCallsParams,
+    ) -> Result<HierarchyReply<CallHierarchyOutgoingCall>> {
+        let _request = self.request_guard().await;
+        let project = self.project_from_data(&mut params.item.data).await?;
+        self.normalize_hierarchy_uri(&project, &mut params.item.uri)?;
+        let mut reply = project
+            .backend
+            .call_hierarchy_outgoing_analysis(params)
+            .await?;
+        for edge in &mut reply.items {
+            self.tag_data(&project, &mut edge.to.data);
+        }
+        self.qualify_locations(&project, &mut reply)?;
+        Ok(reply)
+    }
+}

+#[tokio::test]
+async fn hierarchy_analysis_router_preserves_context_receipts_and_partial_source_issues() {
+    use phpantom_lsp::{HierarchyAnalysisState as State, HierarchyIssueKind as Kind};
+    let (_temporary, router, uris, hosts, leaves) = hierarchy_analysis_router_fixture().await;
+    for index in 0..2 {
+        let host = &hosts[index];
+        let host_receipt = host.data.clone();
+        let reply = router
+            .workbench_call_hierarchy_outgoing(CallHierarchyOutgoingCallsParams {
+                item: host.clone(),
+                work_done_progress_params: Default::default(),
+                partial_result_params: Default::default(),
+            })
+            .await
+            .unwrap();
+        assert_eq!(reply.analysis.state, State::Partial);
+        assert!(!reply.analysis.issues_truncated);
+        assert_eq!(reply.analysis.issues.len(), 1);
+        assert_eq!(reply.analysis.issues[0].kind, Kind::UnresolvedCall);
+        assert_eq!(reply.analysis.issues[0].uri, uris[index]);
+        assert_eq!(
+            reply.analysis.issues[0].range,
+            noncall_exact_range(HIERARCHY_ANALYSIS_ROUTER_SOURCE, "$unknown(1)", "$unknown")
+        );
+        assert_eq!(reply.items.len(), 2, "known edges survive partial coverage");
+        let leaf = reply
+            .items
+            .iter()
+            .find(|edge| edge.to.name == "analysisRouterLeaf")
+            .unwrap();
+        assert_eq!(
+            leaf.to, leaves[index],
+            "prepared opaque receipts survive outgoing transport"
+        );
+        assert_eq!(
+            leaf.to.uri, uris[index],
+            "same names in another Composer context must not redirect edges"
+        );
+        let builtin = reply
+            .items
+            .iter()
+            .find(|edge| edge.to.name == "strtolower")
+            .unwrap();
+        let owner = host_receipt.as_ref().unwrap()["_phpWorkbenchProject"]
+            .as_u64()
+            .unwrap();
+        assert_eq!(builtin.to.uri.scheme(), "phpantom-stub-fn");
+        assert_eq!(
+            builtin.to.uri.query(),
+            Some(format!("project_context={owner}").as_str())
+        );
+        let builtin_data = builtin.to.data.as_ref().unwrap();
+        assert_eq!(builtin_data["_phpWorkbenchProject"].as_u64(), Some(owner));
+        assert_eq!(
+            builtin_data["payload"]["uri"],
+            "phpantom-stub-fn://strtolower"
+        );
+        assert!(builtin_data["payload"]["source_length"].as_u64().unwrap() > 0);
+        assert_eq!(
+            builtin_data["payload"]["source_sha256"]
+                .as_array()
+                .unwrap()
+                .len(),
+            32
+        );
+        let prepared_builtin = router
+            .prepare_call_hierarchy(CallHierarchyPrepareParams {
+                text_document_position_params: TextDocumentPositionParams {
+                    text_document: TextDocumentIdentifier {
+                        uri: builtin.to.uri.clone(),
+                    },
+                    position: builtin.to.selection_range.start,
+                },
+                work_done_progress_params: Default::default(),
+            })
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(
+            prepared_builtin.as_slice(),
+            std::slice::from_ref(&builtin.to)
+        );
+        for callee in [&leaf.to, &builtin.to] {
+            let receipt = callee.data.clone();
+            let incoming = router
+                .workbench_call_hierarchy_incoming(CallHierarchyIncomingCallsParams {
+                    item: callee.clone(),
+                    work_done_progress_params: Default::default(),
+                    partial_result_params: Default::default(),
+                })
+                .await
+                .unwrap();
+            assert_eq!(incoming.analysis.state, State::Partial);
+            assert_eq!(incoming.items.len(), 1);
+            assert_eq!(
+                incoming.items[0].from, *host,
+                "incoming restores the exact prepared caller receipt"
+            );
+            let context = if callee.name == "strtolower" {
+                "strtolower('X')"
+            } else {
+                "analysisRouterLeaf(); strtolower"
+            };
+            assert_eq!(
+                incoming.items[0].from_ranges,
+                [noncall_exact_range(
+                    HIERARCHY_ANALYSIS_ROUTER_SOURCE,
+                    context,
+                    &callee.name
+                )]
+            );
+            assert!(!incoming.analysis.issues_truncated);
+            assert_eq!(incoming.analysis.issues.len(), 1);
+            assert_eq!(incoming.analysis.issues[0].uri, uris[index]);
+            assert_eq!(incoming.analysis.issues[0].kind, Kind::UnresolvedCall);
+            assert_eq!(callee.data, receipt);
+        }
+        let unavailable = router
+            .workbench_call_hierarchy_outgoing(CallHierarchyOutgoingCallsParams {
+                item: builtin.to.clone(),
+                work_done_progress_params: Default::default(),
+                partial_result_params: Default::default(),
+            })
+            .await
+            .unwrap();
+        assert_eq!(unavailable.analysis.state, State::Unavailable);
+        assert_eq!(host.data, host_receipt);
+    }
+    router.shutdown().await.unwrap();
+}

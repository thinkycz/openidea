+async fn hierarchy_analysis_distinguishes_empty_unknown_and_mixed_calls_with_exact_source() {
+    use phpantom_lsp::{HierarchyAnalysisState as State, HierarchyIssueKind as Kind};
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///hierarchy-analysis.php").unwrap();
+    let source = "<?php\r\nfunction statusLeaf(int $n): int { return $n; }\r\nfunction statusEmpty(): void {}\r\nfunction statusUnknown(callable $unknown): void { /* café 🐘 */ $unknown(1); }\r\nfunction statusMixed(callable $unknown): void { statusLeaf(0); $unknown(statusLeaf(1)); }\r\n";
+    open_php(&backend, &uri, source).await;
+    let empty = anonymous_hierarchy_prepare(&backend, &uri, source, "statusEmpty").await;
+    let reply = hierarchy_analysis_outgoing(&backend, &empty).await;
+    assert!(reply.items.is_empty());
+    assert_eq!(reply.analysis.state, State::Resolved);
+    assert!(reply.analysis.issues.is_empty());
+    for (name, context, known) in [
+        ("statusUnknown", "$unknown(1)", false),
+        ("statusMixed", "$unknown(statusLeaf(1))", true),
+    ] {
+        let root = anonymous_hierarchy_prepare(&backend, &uri, source, name).await;
+        let opaque = root.data.clone();
+        let reply = hierarchy_analysis_outgoing(&backend, &root).await;
+        assert_eq!(reply.analysis.state, State::Partial);
+        assert_eq!(reply.analysis.issues.len(), 1);
+        let issue = &reply.analysis.issues[0];
+        assert_eq!(issue.kind, Kind::UnresolvedCall);
+        assert_eq!(issue.uri, uri);
+        assert_eq!(
+            issue.range,
+            noncall_exact_range(source, context, "$unknown")
+        );
+        assert_eq!(!reply.items.is_empty(), known);
+        assert!(!reply.analysis.issues_truncated);
+        if known {
+            assert_eq!(reply.items.len(), 1);
+            assert_eq!(reply.items[0].to.name, "statusLeaf");
+            assert_eq!(reply.items[0].from_ranges.len(), 2);
+        }
+        assert_eq!(root.data, opaque);
+    }
+    backend.shutdown().await.unwrap();
+}

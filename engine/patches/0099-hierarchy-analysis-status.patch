+#[tokio::test]
+async fn hierarchy_analysis_invocation_budget_preserves_known_edges_and_reports_limit() {
+    use phpantom_lsp::{HierarchyAnalysisState as State, HierarchyIssueKind as Kind};
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///hierarchy-analysis-invocation-budget.php").unwrap();
+    let mut source = "<?php\r\nclass StatusBudgetEmpty {}\r\nfunction statusBudgetLeaf(): void {}\r\nfunction statusBudgetHost(): void {\r\n    statusBudgetLeaf();\r\n".to_owned();
+    // Exceed the 4096 status-inspection budget without producing thousands
+    // of unknown issues or real constructor targets. The edge builder still
+    // has a genuine positive control which must survive partial coverage.
+    for _ in 0..4104 {
+        source.push_str("    new StatusBudgetEmpty();\r\n");
+    }
+    source.push_str("}\r\n");
+    open_php(&backend, &uri, &source).await;
+    let host = anonymous_hierarchy_prepare(&backend, &uri, &source, "statusBudgetHost").await;
+    let leaf = anonymous_hierarchy_prepare(&backend, &uri, &source, "statusBudgetLeaf").await;
+    let receipt = host.data.clone();
+    let outgoing = hierarchy_analysis_outgoing(&backend, &host).await;
+    assert_eq!(outgoing.items.len(), 1);
+    assert_eq!(outgoing.items[0].to, leaf);
+    assert_eq!(
+        outgoing.items[0].from_ranges,
+        [noncall_exact_range(
+            &source,
+            "statusBudgetLeaf();",
+            "statusBudgetLeaf"
+        )]
+    );
+    assert_eq!(outgoing.analysis.state, State::Partial);
+    assert!(outgoing.analysis.issues_truncated);
+    assert!(
+        outgoing
+            .analysis
+            .issues
+            .iter()
+            .any(|issue| issue.kind == Kind::Limit)
+    );
+    assert!(
+        outgoing
+            .analysis
+            .issues
+            .iter()
+            .all(|issue| issue.uri == uri && issue.range.start < issue.range.end)
+    );
+    assert_eq!(host.data, receipt);
+
+    let incoming = backend
+        .call_hierarchy_incoming_analysis(CallHierarchyIncomingCallsParams {
+            item: leaf,
+            work_done_progress_params: Default::default(),
+            partial_result_params: Default::default(),
+        })
+        .await
+        .unwrap();
+    assert_eq!(incoming.items.len(), 1);
+    assert_eq!(incoming.items[0].from, host);
+    assert_eq!(incoming.analysis.state, State::Partial);
+    assert!(incoming.analysis.issues_truncated);
+    assert!(
+        incoming
+            .analysis
+            .issues
+            .iter()
+            .any(|issue| issue.kind == Kind::Limit)
+    );
+    backend.shutdown().await.unwrap();
+}

new file mode 100644
index 0000000..89c36be
--- /dev/null
+++ b/src/call_hierarchy/status.rs
@@ -0,0 +1,711 @@
+//! Per-query observations over actual source invocation sites, not fake graph nodes.
+use super::*;
+use crate::symbol_map::{HierarchyInvocation, HierarchyInvocationKind};
+use serde::{Deserialize, Serialize};
+
+const MAX_COVERAGE_INVOCATIONS: usize = 4096;
+
+fn range_key(range: &Range) -> (u32, u32, u32, u32) {
+    (
+        range.start.line,
+        range.start.character,
+        range.end.line,
+        range.end.character,
+    )
+}
+
+/// One source-authoritative index reused for all inspected callers in a file.
+struct CoverageIndex {
+    calls: HashMap<(u32, u32), usize>,
+    array_ranges: HashMap<(u32, u32), Vec<Range>>,
+    explicit_owners: HashMap<u32, Vec<usize>>,
+    lexical_scopes: HashMap<u32, Vec<usize>>,
+}
+impl CoverageIndex {
+    fn new(map: &SymbolMap, content: &str) -> Self {
+        let mut index = Self {
+            calls: HashMap::new(),
+            array_ranges: HashMap::new(),
+            explicit_owners: HashMap::new(),
+            lexical_scopes: HashMap::new(),
+        };
+        for (position, call) in map.call_sites.iter().enumerate() {
+            index
+                .calls
+                .entry((
+                    call.args_start.saturating_sub(1),
+                    call.args_end.saturating_add(1),
+                ))
+                .or_insert(position);
+        }
+        for array in &map.array_callable_invocations {
+            index
+                .array_ranges
+                .entry((array.invocation_start, array.invocation_end))
+                .or_default()
+                .push(byte_range_to_lsp_range(
+                    content,
+                    array.selector_start as usize,
+                    array.selector_end as usize,
+                ));
+        }
+        for (position, site) in map.hierarchy_invocations.iter().enumerate() {
+            match map.call_execution_owner(site.invocation_start) {
+                Some(CallExecutionOwner::Deferred) => {}
+                Some(CallExecutionOwner::Callable(owner)) => index
+                    .explicit_owners
+                    .entry(owner)
+                    .or_default()
+                    .push(position),
+                None => index
+                    .lexical_scopes
+                    .entry(site.invoking_scope_start)
+                    .or_default()
+                    .push(position),
+            }
+        }
+        index
+    }
+    fn caller_sites(&self, target: &PhpCallable, map: &SymbolMap) -> Vec<usize> {
+        let owner = target
+            .item
+            .data
+            .as_ref()
+            .and_then(|data| data.get("offset"))
+            .and_then(serde_json::Value::as_u64)
+            .and_then(|offset| u32::try_from(offset).ok());
+        let mut positions = owner
+            .and_then(|owner| self.explicit_owners.get(&owner))
+            .cloned()
+            .unwrap_or_default();
+        if let Some(scope) = target.scope_start
+            && let Some(sites) = self.lexical_scopes.get(&scope)
+        {
+            positions.extend(sites.iter().copied().filter(|position| {
+                let site = &map.hierarchy_invocations[*position];
+                target.body.is_some_and(|(start, end)| {
+                    site.invocation_start >= start && site.invocation_end <= end
+                })
+            }));
+        }
+        positions.sort_unstable();
+        positions
+    }
+}
+
+/// Known graph edges paired with bounded, query-local source observations.
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct HierarchyReply<T> {
+    /// Genuine resolved edges, including known possibilities in partial results.
+    pub items: Vec<T>,
+    /// Coverage and unresolved source sites for this query.
+    pub analysis: HierarchyAnalysis,
+}
+
+/// Coverage of the inspected source, rather than a claim of full PHP parity.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum HierarchyAnalysisState {
+    #[default]
+    /// All inspected actual invocation sites were accounted for.
+    Resolved,
+    /// Some possible calls were unresolved, unsupported or beyond a limit.
+    Partial,
+    /// The requested source could not be inspected with current authority.
+    Unavailable,
+}
+
+/// Bounded issues observed while resolving a single hierarchy query.
+#[derive(Clone, Debug, Default, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct HierarchyAnalysis {
+    /// Overall query coverage.
+    pub state: HierarchyAnalysisState,
+    /// At most64 distinct source issues.
+    pub issues: Vec<HierarchyIssue>,
+    /// Additional issues or source sites exceeded the bounded query budget.
+    pub issues_truncated: bool,
+}
+
+/// Why an actual source call could not be fully accounted for.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum HierarchyIssueKind {
+    /// Supported source syntax lacks a complete concrete callable target.
+    UnresolvedCall,
+    /// This actual invocation form is not modeled by the graph.
+    UnsupportedCall,
+    /// A finite query budget prevented further inspection.
+    Limit,
+    /// A candidate source could not be inspected with current authority.
+    SourceUnavailable,
+}
+
+/// An issue at an exact caller source range, without a synthetic callable node.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct HierarchyIssue {
+    /// The observed resolution limitation.
+    pub kind: HierarchyIssueKind,
+    /// Source containing the actual invocation.
+    pub uri: Url,
+    /// Callee source range, translated to Blade coordinates when appropriate.
+    pub range: Range,
+}
+
+impl HierarchyAnalysis {
+    fn finish(mut self) -> Self {
+        self.issues.sort_by(|a, b| {
+            (
+                a.uri.as_str(),
+                a.range.start.line,
+                a.range.start.character,
+                a.range.end.line,
+                a.range.end.character,
+                a.kind as u8,
+            )
+                .cmp(&(
+                    b.uri.as_str(),
+                    b.range.start.line,
+                    b.range.start.character,
+                    b.range.end.line,
+                    b.range.end.character,
+                    b.kind as u8,
+                ))
+        });
+        self
+    }
+
+    fn add(&mut self, issue: HierarchyIssue) {
+        if self.state != HierarchyAnalysisState::Unavailable {
+            self.state = HierarchyAnalysisState::Partial;
+        }
+        if self.issues.contains(&issue) {
+            return;
+        }
+        if self.issues.len() == 64 {
+            self.issues_truncated = true;
+        } else {
+            self.issues.push(issue);
+        }
+    }
+
+    fn merge(&mut self, other: Self) {
+        if other.state == HierarchyAnalysisState::Unavailable {
+            // An unavailable potential caller makes incoming coverage partial;
+            // the requested declaration itself can still be inspected.
+            self.state = HierarchyAnalysisState::Partial;
+        }
+        for issue in other.issues {
+            self.add(issue);
+        }
+        self.issues_truncated |= other.issues_truncated;
+        if other.issues_truncated {
+            self.state = HierarchyAnalysisState::Partial;
+        }
+    }
+}
+
+impl Backend {
+    pub(crate) fn incoming_calls_impl(
+        &self,
+        item: &CallHierarchyItem,
+    ) -> Option<Vec<CallHierarchyIncomingCall>> {
+        self.incoming_calls_items_impl(item, &mut FileCache::default())
+    }
+
+    pub(crate) fn outgoing_calls_impl(
+        &self,
+        item: &CallHierarchyItem,
+    ) -> Option<Vec<CallHierarchyOutgoingCall>> {
+        self.outgoing_calls_items_impl(item, &mut FileCache::default())
+    }
+
+    pub(crate) fn outgoing_calls_analysis_impl(
+        &self,
+        item: &CallHierarchyItem,
+    ) -> Option<HierarchyReply<CallHierarchyOutgoingCall>> {
+        let mut cache = FileCache::default();
+        let items = self.outgoing_calls_items_impl(item, &mut cache)?;
+        let target = self.php_callable_from_item(&mut cache, item)?;
+        let mut invocation_budget = MAX_COVERAGE_INVOCATIONS;
+        self.outgoing_analysis(&mut cache, &target, &items, &mut invocation_budget, None);
+        Some(HierarchyReply {
+            items,
+            analysis: cache.analysis.finish(),
+        })
+    }
+
+    pub(crate) fn incoming_calls_analysis_impl(
+        &self,
+        item: &CallHierarchyItem,
+    ) -> Option<HierarchyReply<CallHierarchyIncomingCall>> {
+        let mut cache = FileCache::default();
+        let items = self.incoming_calls_items_impl(item, &mut cache)?;
+        let target = self.php_callable_from_item(&mut cache, item)?;
+        if target
+            .item
+            .data
+            .as_ref()
+            .is_some_and(|data| data.get("file_scope").is_some())
+        {
+            cache.analysis.state = HierarchyAnalysisState::Unavailable;
+            return Some(HierarchyReply {
+                items,
+                analysis: cache.analysis.finish(),
+            });
+        }
+        let mut inspected = std::collections::HashSet::new();
+        let mut budget = 256usize;
+        let mut invocation_budget = MAX_COVERAGE_INVOCATIONS;
+        // Unknown calls may name this target even when references cannot index
+        // them. Inspect each actual caller once, rather than declaring an empty
+        // references result exhaustive. This is bounded project coverage only.
+        let mut files = self.user_file_symbol_maps();
+        files.sort_by(|a, b| a.0.cmp(&b.0));
+        for (uri, _) in files {
+            let Some((content, map, Some(hash))) = self.cached_file(&mut cache, &uri) else {
+                cache.analysis.add(HierarchyIssue {
+                    kind: HierarchyIssueKind::SourceUnavailable,
+                    uri: Url::parse(&uri).ok()?,
+                    range: Range::default(),
+                });
+                continue;
+            };
+            let _lines = crate::text_position::PassLineTable::new(&content);
+            let coverage_index = CoverageIndex::new(&map, &content);
+            for site in &map.hierarchy_invocations {
+                if matches!(
+                    map.call_execution_owner(site.invocation_start),
+                    Some(CallExecutionOwner::Deferred)
+                ) {
+                    continue;
+                }
+                if invocation_budget == 0 {
+                    self.inventory_issue(
+                        &mut cache,
+                        &uri,
+                        &content,
+                        site,
+                        HierarchyIssueKind::Limit,
+                    );
+                    cache.analysis.issues_truncated = true;
+                    return Some(HierarchyReply {
+                        items,
+                        analysis: cache.analysis.finish(),
+                    });
+                }
+                invocation_budget -= 1;
+                if site.invocation_start >= site.invocation_end
+                    || content
+                        .get(site.invocation_start as usize..site.invocation_end as usize)
+                        .is_none()
+                {
+                    self.inventory_issue(
+                        &mut cache,
+                        &uri,
+                        &content,
+                        site,
+                        HierarchyIssueKind::SourceUnavailable,
+                    );
+                    continue;
+                }
+                let Some(caller) =
+                    self.inventory_caller(&mut cache, &uri, &content, &map, &hash, site)
+                else {
+                    self.inventory_issue(
+                        &mut cache,
+                        &uri,
+                        &content,
+                        site,
+                        HierarchyIssueKind::UnsupportedCall,
+                    );
+                    continue;
+                };
+                if !inspected.insert(php_item_key(&caller.item)) {
+                    continue;
+                }
+                if budget == 0 {
+                    self.inventory_issue(
+                        &mut cache,
+                        &uri,
+                        &content,
+                        site,
+                        HierarchyIssueKind::Limit,
+                    );
+                    cache.analysis.issues_truncated = true;
+                    return Some(HierarchyReply {
+                        items,
+                        analysis: cache.analysis.finish(),
+                    });
+                }
+                budget -= 1;
+                let accumulated = std::mem::take(&mut cache.analysis);
+                let mut caller_item = caller.item.clone();
+                self.translate_item_to_blade(&mut caller_item);
+                if let Some(outgoing) = self.outgoing_calls_items_impl(&caller_item, &mut cache) {
+                    self.outgoing_analysis(
+                        &mut cache,
+                        &caller,
+                        &outgoing,
+                        &mut invocation_budget,
+                        Some(&coverage_index),
+                    );
+                } else {
+                    self.inventory_issue(
+                        &mut cache,
+                        &uri,
+                        &content,
+                        site,
+                        HierarchyIssueKind::UnresolvedCall,
+                    );
+                }
+                let mut observed = std::mem::replace(&mut cache.analysis, accumulated);
+                if observed.state == HierarchyAnalysisState::Unavailable {
+                    observed.add(HierarchyIssue {
+                        kind: HierarchyIssueKind::SourceUnavailable,
+                        uri: caller.item.uri.clone(),
+                        range: caller_item.selection_range,
+                    });
+                }
+                cache.analysis.merge(observed);
+            }
+        }
+        Some(HierarchyReply {
+            items,
+            analysis: cache.analysis.finish(),
+        })
+    }
+
+    fn inventory_caller(
+        &self,
+        cache: &mut FileCache,
+        uri: &str,
+        content: &str,
+        map: &SymbolMap,
+        hash: &[u8; 32],
+        site: &HierarchyInvocation,
+    ) -> Option<PhpCallable> {
+        self.syntactic_call_site_caller(
+            cache,
+            uri,
+            content,
+            map,
+            hash,
+            SyntacticCallSite {
+                start: site.invocation_start,
+                end: site.invocation_end,
+                scope: site.invoking_scope_start,
+            },
+        )
+    }
+
+    pub(super) fn inventory_issue(
+        &self,
+        cache: &mut FileCache,
+        uri: &str,
+        content: &str,
+        site: &HierarchyInvocation,
+        kind: HierarchyIssueKind,
+    ) {
+        let Ok(uri_value) = Url::parse(uri) else {
+            cache.analysis.state = HierarchyAnalysisState::Unavailable;
+            return;
+        };
+        if site.callee_start >= site.callee_end
+            || content
+                .get(site.callee_start as usize..site.callee_end as usize)
+                .is_none()
+        {
+            cache.analysis.add(HierarchyIssue {
+                kind: HierarchyIssueKind::SourceUnavailable,
+                uri: uri_value,
+                range: Range::default(),
+            });
+            return;
+        }
+        let mut ranges = [byte_range_to_lsp_range(
+            content,
+            site.callee_start as usize,
+            site.callee_end as usize,
+        )];
+        self.translate_ranges_to_blade(uri, &mut ranges);
+        cache.analysis.add(HierarchyIssue {
+            kind,
+            uri: uri_value,
+            range: ranges[0],
+        });
+    }
+
+    fn has_unmodeled_callable_dispatch(
+        &self,
+        uri: &str,
+        content: &str,
+        site: &HierarchyInvocation,
+        call: Option<&crate::symbol_map::CallSite>,
+    ) -> bool {
+        let Some(call) = call else {
+            return false;
+        };
+        if call.arg_count == 0 {
+            return false;
+        }
+        let context = self.file_context_at(uri, site.invocation_start);
+        let Some(target) = self.resolve_callable_target_at_offset(
+            &call.call_expression,
+            content,
+            call.args_start,
+            &context,
+        ) else {
+            return false;
+        };
+        let Some(text) = content.get(call.args_start as usize..call.args_end as usize) else {
+            return false;
+        };
+        let arguments = crate::type_engine::types::conditional::split_text_args(text);
+        let binds_callable = |parameters: &[crate::types::ParameterInfo]| {
+            let bound = crate::call_args::bind_text_args_to_params(parameters, &arguments);
+            parameters.iter().zip(bound).any(|(parameter, argument)| {
+                argument.is_some()
+                    && parameter.type_hint.as_ref().is_some_and(|hint| {
+                        hint.union_members()
+                            .iter()
+                            .any(|member| member.is_callable())
+                    })
+            })
+        };
+        binds_callable(&target.parameters)
+            || target
+                .overloads
+                .iter()
+                .any(|overload| binds_callable(&overload.parameters))
+    }
+
+    fn known_allocation_without_constructor(
+        &self,
+        uri: &str,
+        map: &SymbolMap,
+        site: &HierarchyInvocation,
+    ) -> bool {
+        let class = match site.kind {
+            HierarchyInvocationKind::AnonymousConstruction => {
+                let Some(construction) = map
+                    .anonymous_class_constructions
+                    .iter()
+                    .find(|value| value.keyword_start == site.callee_start)
+                else {
+                    return false;
+                };
+                self.symbols
+                    .uri_classes_index
+                    .read()
+                    .get(uri)
+                    .and_then(|classes| {
+                        classes
+                            .iter()
+                            .find(|class| {
+                                class.name.starts_with(crate::types::ANONYMOUS_CLASS_PREFIX)
+                                    && class.start_offset == construction.body_start
+                                    && class.end_offset == construction.body_end
+                            })
+                            .cloned()
+                    })
+            }
+            HierarchyInvocationKind::Construction => {
+                let Some(span) = map.lookup(site.callee_start) else {
+                    return false;
+                };
+                let fqn = match &span.kind {
+                    SymbolKind::ClassReference { name, is_fqn, .. } => {
+                        if *is_fqn {
+                            name.trim_start_matches('\\').to_owned()
+                        } else {
+                            self.file_context(uri).resolve_name_at(name, span.start)
+                        }
+                    }
+                    SymbolKind::SelfStaticParent(kind) => {
+                        let Some(fqn) = self.resolve_keyword_to_fqn(kind, uri, span.start) else {
+                            return false;
+                        };
+                        fqn
+                    }
+                    _ => return false,
+                };
+                self.find_or_load_class(&fqn)
+            }
+            _ => return false,
+        };
+        let Some(class) = class else {
+            return false;
+        };
+        if class.kind != crate::types::ClassLikeKind::Class {
+            return false;
+        }
+        let loader = |name: &str| self.find_or_load_class(name);
+        matches!(
+            crate::inheritance::ancestry::resolve_concrete_method_origin(
+                &class,
+                "__construct",
+                &loader
+            ),
+            crate::inheritance::ancestry::MethodOrigin::Missing
+        )
+    }
+
+    fn outgoing_analysis(
+        &self,
+        cache: &mut FileCache,
+        target: &PhpCallable,
+        items: &[CallHierarchyOutgoingCall],
+        invocation_budget: &mut usize,
+        coverage_index: Option<&CoverageIndex>,
+    ) {
+        if target.body.is_none()
+            || matches!(
+                target.item.uri.scheme(),
+                "phpantom-stub" | "phpantom-stub-fn"
+            )
+        {
+            cache.analysis.state = HierarchyAnalysisState::Unavailable;
+            return;
+        }
+        let uri = target.item.uri.as_str();
+        let Some((content, map, Some(hash))) = self.cached_file(cache, uri) else {
+            cache.analysis.state = HierarchyAnalysisState::Unavailable;
+            return;
+        };
+        let _lines = crate::text_position::PassLineTable::new(&content);
+        let local_index;
+        let index = if let Some(index) = coverage_index {
+            index
+        } else {
+            local_index = CoverageIndex::new(&map, &content);
+            &local_index
+        };
+        let covered_ranges: std::collections::HashSet<_> = items
+            .iter()
+            .flat_map(|item| &item.from_ranges)
+            .map(range_key)
+            .collect();
+        for position in index.caller_sites(target, &map) {
+            let site = &map.hierarchy_invocations[position];
+            if *invocation_budget == 0 {
+                self.inventory_issue(cache, uri, &content, site, HierarchyIssueKind::Limit);
+                cache.analysis.issues_truncated = true;
+                return;
+            }
+            *invocation_budget -= 1;
+            let Some(caller) = self.inventory_caller(cache, uri, &content, &map, &hash, site)
+            else {
+                // Only attribute an ownerless site when its source lies in the
+                // selected body; nested callable bodies have explicit owners.
+                if target.body.is_some_and(|(start, end)| {
+                    site.invocation_start >= start && site.invocation_end <= end
+                }) && Some(site.invoking_scope_start) == target.scope_start
+                {
+                    self.inventory_issue(
+                        cache,
+                        uri,
+                        &content,
+                        site,
+                        HierarchyIssueKind::UnsupportedCall,
+                    );
+                }
+                continue;
+            };
+            if php_item_key(&caller.item) != php_item_key(&target.item) {
+                continue;
+            }
+            if site.invocation_start >= site.invocation_end
+                || content
+                    .get(site.invocation_start as usize..site.invocation_end as usize)
+                    .is_none()
+            {
+                self.inventory_issue(
+                    cache,
+                    uri,
+                    &content,
+                    site,
+                    HierarchyIssueKind::SourceUnavailable,
+                );
+                continue;
+            }
+            let call = index
+                .calls
+                .get(&(site.invocation_start, site.invocation_end))
+                .and_then(|position| map.call_sites.get(*position));
+            if self.has_unmodeled_callable_dispatch(uri, &content, site, call) {
+                self.inventory_issue(
+                    cache,
+                    uri,
+                    &content,
+                    site,
+                    HierarchyIssueKind::UnsupportedCall,
+                );
+            }
+            if site.kind == HierarchyInvocationKind::Unsupported {
+                self.inventory_issue(
+                    cache,
+                    uri,
+                    &content,
+                    site,
+                    HierarchyIssueKind::UnsupportedCall,
+                );
+                continue;
+            }
+            let callee_range = byte_range_to_lsp_range(
+                &content,
+                site.callee_start as usize,
+                site.callee_end as usize,
+            );
+            let args_range = byte_range_to_lsp_range(
+                &content,
+                site.invocation_start as usize,
+                site.invocation_end as usize,
+            );
+            let mut accepted = vec![callee_range, args_range];
+            // Literal arrays report only their actual selector interior.
+            if let Some(ranges) = index
+                .array_ranges
+                .get(&(site.invocation_start, site.invocation_end))
+            {
+                accepted.extend(ranges.iter().copied());
+            }
+            let first_literal = map
+                .literal_method_selectors
+                .partition_point(|literal| literal.start < site.callee_start);
+            for literal in map.literal_method_selectors[first_literal..]
+                .iter()
+                .take_while(|literal| literal.start <= site.callee_end)
+            {
+                if literal.end <= site.callee_end {
+                    accepted.push(byte_range_to_lsp_range(
+                        &content,
+                        literal.start as usize,
+                        literal.end as usize,
+                    ));
+                }
+            }
+            self.translate_ranges_to_blade(uri, &mut accepted);
+            let covered = accepted
+                .iter()
+                .any(|range| covered_ranges.contains(&range_key(range)));
+            if covered {
+                continue;
+            }
+            // A concrete allocation without a constructor is a resolved empty
+            // graph contribution, unlike an unresolved invocation.
+            if self.known_allocation_without_constructor(uri, &map, site) {
+                continue;
+            }
+            self.inventory_issue(
+                cache,
+                uri,
+                &content,
+                site,
+                HierarchyIssueKind::UnresolvedCall,
+            );
+        }
+    }
+}

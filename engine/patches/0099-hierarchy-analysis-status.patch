+                .unwrap();
+            assert_eq!(items.len(), 1);
+            destination.push(items[0].clone());
+        }
+        uris.push(uri);
+    }
+    assert_ne!(
+        hosts[0].data.as_ref().unwrap()["_phpWorkbenchProject"],
+        hosts[1].data.as_ref().unwrap()["_phpWorkbenchProject"]
+    );
+    (temporary, router, uris, hosts, leaves)
+}

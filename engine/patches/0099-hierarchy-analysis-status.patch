+#[tokio::test]
+async fn hierarchy_analysis_router_refuses_foreign_and_invalid_builtin_qualifiers_both_directions()
+{
+    let (_temporary, router, _uris, hosts, _leaves) = hierarchy_analysis_router_fixture().await;
+    let mut builtins = Vec::new();
+    for host in hosts {
+        let reply = router
+            .workbench_call_hierarchy_outgoing(CallHierarchyOutgoingCallsParams {
+                item: host,
+                work_done_progress_params: Default::default(),
+                partial_result_params: Default::default(),
+            })
+            .await
+            .unwrap();
+        builtins.push(
+            reply
+                .items
+                .into_iter()
+                .find(|edge| edge.to.name == "strtolower")
+                .unwrap()
+                .to,
+        );
+    }
+    assert_ne!(builtins[0].uri.query(), builtins[1].uri.query());
+    let pristine = builtins[0].clone();
+    for forged in [
+        {
+            let mut item = pristine.clone();
+            item.uri = builtins[1].uri.clone();
+            item
+        },
+        {
+            let mut item = pristine.clone();
+            item.uri.set_query(Some("project_context=invalid"));
+            item
+        },
+        {
+            let mut item = pristine.clone();
+            item.uri
+                .set_query(Some("project_context=18446744073709551615"));
+            item
+        },
+    ] {
+        assert!(
+            router
+                .workbench_call_hierarchy_incoming(CallHierarchyIncomingCallsParams {
+                    item: forged.clone(),
+                    work_done_progress_params: Default::default(),
+                    partial_result_params: Default::default(),
+                })
+                .await
+                .is_err(),
+            "foreign/malformed context must be refused before builtin normalization"
+        );
+        assert!(
+            router
+                .workbench_call_hierarchy_outgoing(CallHierarchyOutgoingCallsParams {
+                    item: forged,
+                    work_done_progress_params: Default::default(),
+                    partial_result_params: Default::default(),
+                })
+                .await
+                .is_err(),
+            "outgoing analysis must enforce the same authority as incoming"
+        );
+    }
+    let recovered = router
+        .workbench_call_hierarchy_incoming(CallHierarchyIncomingCallsParams {
+            item: pristine.clone(),
+            work_done_progress_params: Default::default(),
+            partial_result_params: Default::default(),
+        })
+        .await
+        .unwrap();
+    assert_eq!(
+        recovered.items.len(),
+        1,
+        "refused forgeries must not retire the legitimate context"
+    );
+    assert_eq!(pristine, builtins[0]);
+    router.shutdown().await.unwrap();
+}

+/// At most one pre-edit source is retained per pending caller. Intermediate
+/// accepted versions add target URIs, not another source payload.
+#[derive(Default)]
+pub(crate) struct PendingBladeRefresh {
+    pub(crate) before: Option<Arc<String>>,
+    pub(crate) revision: Option<crate::diagnostics::revision::Revision>,
+    pub(crate) root_ticket: Option<Arc<()>>,
+    pub(crate) accepted: bool,
+    pub(crate) targets: HashSet<String>,
+}
+
+struct BladeRefreshEpoch {
+    caller: String,
+    revision: Option<crate::diagnostics::revision::Revision>,
+    ticket: Option<Arc<()>>,
+    input: Arc<()>,
+}
+impl BladeRefreshEpoch {
+    fn current(&self, backend: &Backend) -> bool {
+        let documents = backend.diag.documents.lock();
+        documents.input_matches(&self.input)
+            && self.ticket.as_ref().map_or_else(
+                || documents.parsed(&self.caller, self.revision.as_ref()),
+                |ticket| {
+                    !backend.open_files.read().contains_key(&self.caller)
+                        && documents.index_current(&self.caller, ticket)
+                },
+            )
+    }
+    fn adopt_own_publication(&mut self, backend: &Backend, changed: &[String]) {
+        if self.ticket.is_none() || !changed.iter().any(|uri| uri == &self.caller) {
+            return;
+        }
+        let _merge = backend.index_merge_gate.lock();
+        if !backend.diag.documents.lock().input_matches(&self.input)
+            || backend.open_files.read().contains_key(&self.caller)
+        {
+            return;
+        }
+        let ticket = backend.index_source_ticket(&self.caller);
+        self.ticket = Some(Arc::clone(&ticket));
+        if let Some(work) = backend.blade_pending_refreshes.lock().get_mut(&self.caller)
+            && work.revision.is_none()
+        {
+            work.root_ticket = Some(ticket);
+        }
+    }
+    fn release(self, backend: &Backend) {
+        if let Some(ticket) = self.ticket {
+            backend.release_index_source_ticket(&self.caller, &ticket);
+        }
+    }
+}
+
+pub(crate) struct BladeRefreshOwner {
+    uri: String,
+    revision: Option<crate::diagnostics::revision::Revision>,
+    ticket: Option<Arc<()>>,
+    scope: Option<BladeScope>,
+}
+impl BladeRefreshOwner {
+    pub(crate) fn current(&self, backend: &Backend) -> bool {
+        let documents = backend.diag.documents.lock();
+        let owned = self.ticket.as_ref().map_or_else(
+            || documents.parsed(&self.uri, self.revision.as_ref()),
+            |ticket| {
+                !backend.open_files.read().contains_key(&self.uri)
+                    && documents.index_current(&self.uri, ticket)
+            },
+        );
+        drop(documents);
+        owned && backend.blade_injected_vars.read().get(&self.uri) == self.scope.as_ref()
+    }
+    fn release(self, backend: &Backend) {
+        if let Some(ticket) = self.ticket {
+            backend.release_index_source_ticket(&self.uri, &ticket);
+        }
+    }
+}

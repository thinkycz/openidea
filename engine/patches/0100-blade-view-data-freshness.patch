+mod blade_caller_refresh_topology {
+    //! Deterministic dependency components for Blade refresh.
+    //! The SCC traversals are O(V + E); canonical URI ordering and deterministic
+    //! ready-component selection add sorting / heap comparison costs.
+
+    use std::cmp::Reverse;
+    use std::collections::{BinaryHeap, HashMap, HashSet};
+
+    #[derive(Debug, Clone, PartialEq, Eq)]
+    pub(super) struct BladeRenderComponent {
+        pub(super) members: Vec<String>,
+        pub(super) cyclic: bool,
+    }
+
+    /// Partition the supplied induced graph into true SCCs and return its
+    /// condensation in renderer-before-rendered order. Unknown adjacency endpoints
+    /// are outside this pass. Duplicate input URIs are accepted once.
+    pub(super) fn blade_render_components(
+        mut uris: Vec<String>,
+        adjacency: &HashMap<String, HashSet<String>>,
+    ) -> Vec<BladeRenderComponent> {
+        uris.sort_unstable();
+        uris.dedup();
+        let count = uris.len();
+        let indices: HashMap<&str, usize> = uris
+            .iter()
+            .enumerate()
+            .map(|(index, uri)| (uri.as_str(), index))
+            .collect();
+        // URI strings remain owned once. Graph traversal uses compact indices.
+        let mut forward = vec![Vec::new(); count];
+        let mut reverse = vec![Vec::new(); count];
+        for (source, uri) in uris.iter().enumerate() {
+            if let Some(targets) = adjacency.get(uri) {
+                forward[source].extend(
+                    targets
+                        .iter()
+                        .filter_map(|target| indices.get(target.as_str()).copied()),
+                );
+                forward[source].sort_unstable();
+                for &target in &forward[source] {
+                    reverse[target].push(source);
+                }
+            }
+        }
+        // The outer source loop is sorted, so reverse lists are already sorted.
+        drop(indices);
+
+        let mut visited = vec![false; count];
+        let mut finish = Vec::with_capacity(count);
+        let mut frames: Vec<(usize, usize)> = Vec::new();
+        for root in 0..count {
+            if visited[root] {
+                continue;
+            }
+            visited[root] = true;
+            frames.push((root, 0));
+            while let Some((node, next_edge)) = frames.last_mut() {
+                let current = *node;
+                if let Some(&target) = forward[current].get(*next_edge) {
+                    *next_edge += 1;
+                    if !visited[target] {
+                        visited[target] = true;
+                        frames.push((target, 0));
+                    }
+                } else {
+                    finish.push(current);
+                    frames.pop();
+                }
+            }
+        }
+
+        let mut component_of = vec![usize::MAX; count];
+        let mut members: Vec<Vec<usize>> = Vec::new();
+        let mut pending = Vec::new();
+        while let Some(root) = finish.pop() {
+            if component_of[root] != usize::MAX {
+                continue;
+            }
+            let component = members.len();
+            let mut group = Vec::new();
+            component_of[root] = component;
+            pending.push(root);
+            while let Some(node) = pending.pop() {
+                group.push(node);
+                for &parent in &reverse[node] {
+                    if component_of[parent] == usize::MAX {
+                        component_of[parent] = component;
+                        pending.push(parent);
+                    }
+                }
+            }
+            group.sort_unstable();
+            members.push(group);
+        }
+        // Reverse edges are no longer needed while constructing condensation.
+        drop(reverse);
+        let mut outgoing: Vec<HashSet<usize>> = vec![HashSet::new(); members.len()];
+        let mut indegree = vec![0usize; members.len()];
+        let cyclic: Vec<bool> = members
+            .iter()
+            .map(|group| group.len() > 1 || forward[group[0]].contains(&group[0]))
+            .collect();
+        for (source, targets) in forward.iter().enumerate() {
+            let from = component_of[source];
+            for &target in targets {
+                let to = component_of[target];
+                if from != to && outgoing[from].insert(to) {
+                    indegree[to] += 1;
+                }
+            }
+        }
+        drop(forward);
+        drop(component_of);
+
+        // Lowest member URI determines deterministic ties between ready SCCs.
+        let mut ready = BinaryHeap::new();
+        for (component, group) in members.iter().enumerate() {
+            if indegree[component] == 0 {
+                ready.push(Reverse((group[0], component)));
+            }
+        }
+        let mut result = Vec::with_capacity(members.len());
+        while let Some(Reverse((_, component))) = ready.pop() {
+            let group = std::mem::take(&mut members[component]);
+            result.push(BladeRenderComponent {
+                members: group
+                    .into_iter()
+                    .map(|index| std::mem::take(&mut uris[index]))
+                    .collect(),
+                cyclic: cyclic[component],
+            });
+            for target in outgoing[component].drain() {
+                indegree[target] -= 1;
+                if indegree[target] == 0 {
+                    ready.push(Reverse((members[target][0], target)));
+                }
+            }
+        }
+        debug_assert_eq!(result.len(), members.len());
+        result
+    }

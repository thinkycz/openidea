+/// Walk only statically written compact names. The iterator stack follows the
+/// already parsed AST (whose nesting the PHP parser bounds), without recursive
+/// Rust calls or an arbitrary new limit on PHP's number of names. Effective
+/// literal slots retain only source-sized borrowed values; keys are evaluated
+/// before their surviving values are visited, including PHP spread semantics.
+fn collect_compact_names<'ast, 'arena>(
+    expr: &'ast Expression<'arena>,
+    entries: &mut Vec<SiteEntry<'ast, 'arena>>,
+) -> bool {
+    enum Input<'ast, 'arena> {
+        Expr(&'ast Expression<'arena>),
+        Values(std::iter::Flatten<std::vec::IntoIter<Option<CompactArrayEntry<'ast, 'arena>>>>),
+    }
+    let mut pending = vec![Input::Expr(expr)];
+    let mut complete = true;
+    while let Some(input) = pending.pop() {
+        match input {
+            Input::Expr(Expression::Literal(Literal::String(s))) => {
+                match string_literal_contents(s) {
+                    Some(name) => entries.push(SiteEntry::Variable {
+                        name,
+                        key_range: (s.span.start.offset + 1, s.span.end.offset - 1),
+                    }),
+                    None => complete = false,
+                }
+            }
+            Input::Expr(Expression::Array(array)) => {
+                let values = effective_compact_array(array.elements.iter());
+                complete &= values.complete;
+                pending.push(Input::Values(values.entries.into_iter().flatten()));
+            }
+            Input::Expr(Expression::LegacyArray(array)) => {
+                let values = effective_compact_array(array.elements.iter());
+                complete &= values.complete;
+                pending.push(Input::Values(values.entries.into_iter().flatten()));
+            }
+            Input::Expr(_) => complete = false,
+            Input::Values(mut values) => {
+                let Some(entry) = values.next() else {
+                    continue;
+                };
+                pending.push(Input::Values(values));
+                pending.push(Input::Expr(entry.value));
+            }
+        }
+    }
+    complete
+}
+
+#[derive(Clone, PartialEq, Eq, Hash)]
+enum CompactArrayKey {
+    Integer(i64),
+    String(Vec<u8>),
+    UnknownInteger,
+    Unknown,
+}
+struct CompactArrayEntry<'ast, 'arena> {
+    key: CompactArrayKey,
+    value: &'ast Expression<'arena>,
+    certain: bool,
+}
+struct CompactArrayValues<'ast, 'arena> {
+    entries: Vec<Option<CompactArrayEntry<'ast, 'arena>>>,
+    positions: std::collections::HashMap<CompactArrayKey, Vec<usize>>,
+    next_index: Option<i64>,
+    highest_integer: Option<i64>,
+    complete: bool,
+}
+impl<'ast, 'arena> CompactArrayValues<'ast, 'arena> {
+    fn new() -> Self {
+        Self {
+            entries: Vec::new(),
+            positions: Default::default(),
+            next_index: Some(0),
+            highest_integer: None,
+            complete: true,
+        }
+    }
+    fn uncertain_keys(&mut self, strings_only: bool) {
+        self.complete = false;
+        self.next_index = None;
+        for entry in self.entries.iter_mut().flatten() {
+            if !strings_only
+                || matches!(
+                    entry.key,
+                    CompactArrayKey::String(_) | CompactArrayKey::Unknown
+                )
+            {
+                entry.certain = false;
+            }
+        }
+    }
+    fn write(&mut self, key: CompactArrayKey, value: &'ast Expression<'arena>, certain: bool) {
+        let known = matches!(
+            key,
+            CompactArrayKey::Integer(_) | CompactArrayKey::String(_)
+        );
+        if let CompactArrayKey::Integer(index) = key {
+            let first_integer = self.highest_integer.is_none();
+            self.highest_integer = Some(self.highest_integer.map_or(index, |old| old.max(index)));
+            // PHP8+ array literals seed their append cursor from the first
+            // integer key, including a negative key. This is distinct from
+            // assigning a negative key to an already-created empty array.
+            self.next_index = self.next_index.and_then(|next| {
+                if first_integer || index >= next {
+                    index.checked_add(1)
+                } else {
+                    Some(next)
+                }
+            });
+        }
+        if certain && known {
+            if let Some(indices) = self.positions.get_mut(&key) {
+                let first = indices[0];
+                for index in indices.iter().skip(1) {
+                    self.entries[*index] = None;
+                }
+                self.entries[first] = Some(CompactArrayEntry {
+                    key,
+                    value,
+                    certain,
+                });
+                indices.truncate(1);
+                return;
+            }
+        } else if known && let Some(indices) = self.positions.get(&key) {
+            for index in indices {
+                if let Some(entry) = &mut self.entries[*index] {
+                    entry.certain = false;
+                }
+            }
+        }
+        let index = self.entries.len();
+        self.entries.push(Some(CompactArrayEntry {
+            key: key.clone(),
+            value,
+            certain,
+        }));
+        if known {
+            self.positions.entry(key).or_default().push(index);
+        }
+    }
+    fn append(&mut self, value: &'ast Expression<'arena>, certain: bool) {
+        let key = if certain {
+            match self.next_index {
+                Some(index) => CompactArrayKey::Integer(index),
+                None => {
+                    self.complete = false;
+                    CompactArrayKey::UnknownInteger
+                }
+            }
+        } else {
+            self.complete = false;
+            self.next_index = None;
+            CompactArrayKey::UnknownInteger
+        };
+        self.write(key, value, certain);
+    }
+    fn spread(&mut self, source: Self) {
+        if !source.complete {
+            self.uncertain_keys(true);
+        }
+        for entry in source.entries.into_iter().flatten() {
+            match entry.key {
+                CompactArrayKey::Integer(_) | CompactArrayKey::UnknownInteger => {
+                    self.append(entry.value, entry.certain)
+                }
+                CompactArrayKey::String(_) => self.write(entry.key, entry.value, entry.certain),
+                CompactArrayKey::Unknown => {
+                    self.uncertain_keys(true);
+                    self.write(CompactArrayKey::Unknown, entry.value, entry.certain);
+                }
+            }
+        }
+    }
+}
+
+/// Constant scalar keys use PHP's existing integer spelling/coercion helpers.
+/// Other expressions stay unknown; no caller variable or constant is executed.
+fn compact_array_key(mut key: &Expression<'_>) -> Option<CompactArrayKey> {
+    let mut negative = false;
+    let mut numeric_prefix = false;
+    loop {
+        match key {
+            Expression::Parenthesized(group) => key = group.expression,
+            Expression::UnaryPrefix(prefix) => match prefix.operator {
+                UnaryPrefixOperator::Plus(_) => {
+                    numeric_prefix = true;
+                    key = prefix.operand;
+                }
+                UnaryPrefixOperator::Negation(_) => {
+                    numeric_prefix = true;
+                    negative = !negative;
+                    key = prefix.operand;
+                }
+                _ => return None,
+            },
+            _ => break,
+        }
+    }
+    match key {
+        Expression::Literal(Literal::Integer(value)) => {
+            let raw = bytes_to_str(value.raw);
+            crate::php_type::parse_php_int_literal(&if negative {
+                format!("-{raw}")
+            } else {
+                raw.to_owned()
+            })
+            .map(CompactArrayKey::Integer)
+        }
+        Expression::Literal(Literal::Float(value)) => {
+            let value = if negative {
+                -value.value.0
+            } else {
+                value.value.0
+            };
+            (value.is_finite() && value >= i64::MIN as f64 && value < -(i64::MIN as f64))
+                .then(|| CompactArrayKey::Integer(value.trunc() as i64))
+        }
+        Expression::Literal(Literal::String(value)) if !numeric_prefix => {
+            let value = value.value?;
+            match literal_bytes_to_str(value) {
+                Some(text) if crate::php_type::is_decimal_int_array_key(text) => {
+                    Some(CompactArrayKey::Integer(text.parse().ok()?))
+                }
+                _ => Some(CompactArrayKey::String(value.to_vec())),
+            }
+        }
+        Expression::Literal(Literal::True(_)) if !numeric_prefix => {
+            Some(CompactArrayKey::Integer(1))
+        }
+        Expression::Literal(Literal::False(_)) if !numeric_prefix => {
+            Some(CompactArrayKey::Integer(0))
+        }

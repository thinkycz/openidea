--- a/tests/integration/blade_shared_vars.rs
+++ b/tests/integration/blade_shared_vars.rs
@@ -194,4 +194,269 @@ class ProfileComposer
             "the template's own annotation decides the type, got: {hover}"
         );
     }
+
+    async fn precedence_open_template(
+        backend: &phpantom_lsp::Backend,
+    ) -> tower_lsp::lsp_types::Url {
+        tower_lsp::LanguageServer::initialized(backend, tower_lsp::lsp_types::InitializedParams {})
+            .await;
+        for model in ["SharedA", "CallerB", "ComposedC"] {
+            crate::common::open_php_file(backend, &format!("app/{model}.php")).await;
+        }
+        let caller = crate::common::open_php_file(backend, "app/Controller.php").await;
+        let source =
+            std::fs::read_to_string(crate::common::workspace_path(backend, "app/Controller.php"))
+                .unwrap();
+        let member = source
+            .find("$ready->bOnly")
+            .expect("caller readiness control");
+        let labels = crate::common::complete_labels_at_opened(
+            backend,
+            &caller,
+            0,
+            (member + "$ready->".len()) as u32,
+        )
+        .await;
+        assert!(
+            labels.iter().any(|label| label == "bOnly"),
+            "explicitly opened caller must resolve its PHP control: {labels:?}"
+        );
+        let definitions = crate::common::definition_locations(
+            crate::common::goto_definition_at(backend, &caller, 0, (member + 10) as u32).await,
+        );
+        assert!(
+            definitions
+                .iter()
+                .any(|target| target.uri.path().ends_with("/app/CallerB.php")),
+            "caller control must navigate to the real model before opening Blade: {definitions:?}"
+        );
+        open_blade_template(backend, "resources/views/about.blade.php").await
+    }
+
+    async fn precedence_assert_member(
+        backend: &phpantom_lsp::Backend,
+        uri: &tower_lsp::lsp_types::Url,
+        line: u32,
+        class: &str,
+        property: &str,
+    ) {
+        let labels = crate::common::complete_labels_at_opened(backend, uri, line, 10).await;
+        assert!(
+            labels.iter().any(|label| label == property),
+            "missing {class}::{property}: {labels:?}"
+        );
+        assert!(
+            ["aOnly", "bOnly", "cOnly"]
+                .into_iter()
+                .filter(|name| *name != property)
+                .all(|other| !labels.iter().any(|label| label == other)),
+            "incorrect source type leaked members: {labels:?}"
+        );
+        let targets = crate::common::definition_locations(
+            crate::common::goto_definition_at(backend, uri, line, 12).await,
+        );
+        assert!(
+            targets
+                .iter()
+                .any(|target| target.uri.path().ends_with(&format!("/app/{class}.php"))),
+            "definition must reach {class} property: {targets:?}"
+        );
+    }
+
+    fn precedence_workspace(
+        calls: &str,
+        composer: &str,
+        template: &str,
+    ) -> (phpantom_lsp::Backend, tempfile::TempDir) {
+        let provider = format!(
+            r#"<?php
+namespace App\Providers;
+use Illuminate\Support\Facades\View;
+class ViewServiceProvider {{ function boot(): void {{
+ View::share('item', new \App\SharedA());
+ {composer}
+}} }}
+"#
+        );
+        let caller = format!(
+            "<?php namespace App; class Controller {{ function show(array $data): void {{ {calls} }} function ready(CallerB $ready): string {{ return $ready->bOnly; }} }}\n"
+        );
+        create_psr4_workspace(
+            COMPOSER_JSON,
+            &[
+                ("bootstrap/providers.php", PROVIDERS_PHP),
+                ("app/Providers/ViewServiceProvider.php", &provider),
+                (
+                    "vendor/illuminate/Foundation/Application.php",
+                    APPLICATION_CLASS,
+                ),
+                (
+                    "app/SharedA.php",
+                    "<?php namespace App; class SharedA { public string $aOnly; }",
+                ),
+                (
+                    "app/CallerB.php",
+                    "<?php namespace App; class CallerB { public string $bOnly; }",
+                ),
+                (
+                    "app/ComposedC.php",
+                    "<?php namespace App; class ComposedC { public string $cOnly; }",
+                ),
+                ("app/Controller.php", &caller),
+                ("resources/views/about.blade.php", template),
+            ],
+        )
+    }
+
+    #[tokio::test]
+    async fn explicit_render_data_overrides_global_shared_type() {
+        let (backend, _dir) = precedence_workspace(
+            "view('about', ['item' => new CallerB()]);",
+            "",
+            "{{ $item->bOnly }}\n",
+        );
+        let uri = precedence_open_template(&backend).await;
+        let hover = markup_hover_at(&backend, &uri, 0, 5).await;
+        assert!(
+            hover.contains("CallerB") && !hover.contains("SharedA"),
+            "caller data must win shared fallback: {hover}"
+        );
+        precedence_assert_member(&backend, &uri, 0, "CallerB", "bOnly").await;
+    }
+
+    #[tokio::test]
+    async fn omitted_render_data_uses_global_shared_type() {
+        let (backend, _dir) = precedence_workspace("view('about');", "", "{{ $item->aOnly }}\n");
+        let uri = precedence_open_template(&backend).await;
+        let hover = markup_hover_at(&backend, &uri, 0, 5).await;
+        assert!(
+            hover.contains("SharedA") && !hover.contains("CallerB"),
+            "shared fallback must remain available: {hover}"
+        );
+        precedence_assert_member(&backend, &uri, 0, "SharedA", "aOnly").await;
+    }
+
+    #[tokio::test]
+    async fn targeted_composer_overrides_explicit_and_shared_render_data() {
+        let (backend, _dir) = precedence_workspace(
+            "view('about', ['item' => new CallerB()]);",
+            "View::composer('about', function ($view) { $view->with('item', new \\App\\ComposedC()); });",
+            "{{ $item->cOnly }}\n",
+        );
+        let uri = precedence_open_template(&backend).await;
+        let hover = markup_hover_at(&backend, &uri, 0, 5).await;
+        assert!(
+            hover.contains("ComposedC") && !hover.contains("CallerB") && !hover.contains("SharedA"),
+            "composer must preserve higher precedence: {hover}"
+        );
+        precedence_assert_member(&backend, &uri, 0, "ComposedC", "cOnly").await;
+    }
+
+    #[tokio::test]
+    async fn caller_with_omitted_data_preserves_shared_union_alternative() {
+        let (backend, _dir) = precedence_workspace(
+            "view('about', ['item' => new CallerB()]); view('about');",
+            "",
+            "{{ $item }}\n",
+        );
+        let uri = precedence_open_template(&backend).await;
+        let hover = markup_hover_at(&backend, &uri, 0, 5).await;
+        assert!(
+            hover.contains("SharedA") && hover.contains("CallerB"),
+            "fallback must apply per site before union: {hover}"
+        );
+    }
+
+    #[tokio::test]
+    async fn template_annotation_overrides_shared_caller_and_composer() {
+        let (backend, _dir) = precedence_workspace(
+            "view('about', ['item' => new CallerB()]);",
+            "View::composer('about', function ($view) { $view->with('item', new \\App\\ComposedC()); });",
+            "@php\n/** @var \\App\\CallerB $item */\n@endphp\n{{ $item->bOnly }}\n",
+        );
+        let uri = precedence_open_template(&backend).await;
+        let hover = markup_hover_at(&backend, &uri, 3, 5).await;
+        assert!(
+            hover.contains("CallerB") && !hover.contains("ComposedC") && !hover.contains("SharedA"),
+            "author annotation must remain highest: {hover}"
+        );
+        precedence_assert_member(&backend, &uri, 3, "CallerB", "bOnly").await;
+    }
+
+    #[tokio::test]
+    async fn unknown_render_data_does_not_make_shared_type_exhaustive() {
+        let (backend, _dir) =
+            precedence_workspace("view('about', $data);", "", "{{ $item->aOnly }}\n");
+        let uri = precedence_open_template(&backend).await;
+        let hover = crate::common::hover_text_at(&backend, &uri, 0, 5)
+            .await
+            .unwrap_or_default();
+        assert!(
+            !hover.contains("SharedA") || hover.contains("mixed"),
+            "unknown data must not make SharedA exhaustive: {hover}"
+        );
+        let labels = crate::common::complete_labels_at_opened(&backend, &uri, 0, 10).await;
+        assert!(
+            !labels.iter().any(|label| label == "aOnly"),
+            "unknown overriding data must not offer false shared-only member: {labels:?}"
+        );
+    }
+
+    #[tokio::test]
+    async fn later_known_with_overrides_unknown_data_without_poisoning_the_key() {
+        let (backend, _dir) = precedence_workspace(
+            "view('about', $data)->with('item', new CallerB());",
+            "",
+            "{{ $item->bOnly }}\n",
+        );
+        let uri = precedence_open_template(&backend).await;
+        let hover = markup_hover_at(&backend, &uri, 0, 5).await;
+        assert!(
+            hover.contains("CallerB") && !hover.contains("SharedA") && !hover.contains("mixed"),
+            "known later write must remain exact: {hover}"
+        );
+        precedence_assert_member(&backend, &uri, 0, "CallerB", "bOnly").await;
+    }
+
+    #[tokio::test]
+    async fn known_ignored_data_keys_preserve_shared_fallback() {
+        for data in ["[123]", "[0 => 123]", "['bad-key' => 123]", "['' => 123]"] {
+            let (backend, _dir) = precedence_workspace(
+                &format!("view('about', {data});"),
+                "",
+                "{{ $item->aOnly }}\n",
+            );
+            let uri = precedence_open_template(&backend).await;
+            let hover = markup_hover_at(&backend, &uri, 0, 5).await;
+            assert!(
+                hover.contains("SharedA") && !hover.contains("mixed"),
+                "known data keys dropped by extract cannot override shared item: {data}: {hover}"
+            );
+            precedence_assert_member(&backend, &uri, 0, "SharedA", "aOnly").await;
+        }
+    }
+
+    #[tokio::test]
+    async fn later_unknown_with_data_does_not_keep_prior_explicit_type_exhaustive() {
+        let (backend, _dir) = precedence_workspace(
+            "view('about', ['item' => new CallerB()])->with($data);",
+            "",
+            "{{ $item->bOnly }}\n",
+        );
+        let uri = precedence_open_template(&backend).await;
+        let hover = crate::common::hover_text_at(&backend, &uri, 0, 5)
+            .await

diff --git a/tests/integration/blade_public_readiness.rs b/tests/integration/blade_public_readiness.rs
new file mode 100644
index 0000000..dea9a60
--- /dev/null
+++ b/tests/integration/blade_public_readiness.rs
@@ -0,0 +1,158 @@
+//! Pending Blade dependency graphs refuse stale public completion and resolution.
+use crate::common::{
+    LARAVEL_APP_COMPOSER, create_psr4_workspace, open_document, open_php, position_after,
+    workspace_uri,
+};
+use phpantom_lsp::Backend;
+use tower_lsp::{LanguageServer, jsonrpc::ErrorCode, lsp_types::*};
+
+const USER: &str = "<?php namespace App; class User { /** Stable readiness member. */ public string $userOnly = ''; }";
+const OTHER: &str = "<?php namespace App; class Other { public string $otherOnly = ''; }";
+const CALLER: &str = "<?php namespace App; class Caller { function show() { $person = new User(); return view('page', compact('person')); } }";
+const PAGE: &str = "@include('partial')\n";
+const PARTIAL: &str = "{{ $person->userOnly }}\n";
+const UNSUPPORTED: &str = "@include('page', ['person' => [$person]])\n{{ $person->userOnly }}\n";
+const REPAIRED: &str = "@include('page')\n{{ $person->userOnly }}\n";
+const UNRELATED: &str =
+    "<?php namespace App; function independent(User $unrelated): void { $unrelated->userOnly; }";
+
+fn parameters(uri: &Url, source: &str, receiver: &str) -> CompletionParams {
+    CompletionParams {
+        text_document_position: TextDocumentPositionParams {
+            text_document: TextDocumentIdentifier { uri: uri.clone() },
+            position: position_after(source, receiver),
+        },
+        work_done_progress_params: Default::default(),
+        partial_result_params: Default::default(),
+        context: Some(CompletionContext {
+            trigger_kind: CompletionTriggerKind::TRIGGER_CHARACTER,
+            trigger_character: Some(">".into()),
+        }),
+    }
+}
+
+fn items(response: Option<CompletionResponse>) -> Vec<CompletionItem> {
+    match response {
+        Some(CompletionResponse::Array(items)) => items,
+        Some(CompletionResponse::List(list)) => list.items,
+        None => Vec::new(),
+    }
+}
+
+async fn typed_item(backend: &Backend, uri: &Url, source: &str, receiver: &str) -> CompletionItem {
+    let values = items(
+        backend
+            .completion(parameters(uri, source, receiver))
+            .await
+            .unwrap(),
+    );
+    assert!(
+        !values.iter().any(|item| item.label == "otherOnly"),
+        "unrelated model leaked into the current User completion: {values:?}"
+    );
+    let item = values
+        .into_iter()
+        .find(|item| item.label == "userOnly")
+        .expect("nonempty current typed member completion");
+    assert_eq!(item.kind, Some(CompletionItemKind::PROPERTY));
+    assert_eq!(
+        item.data
+            .as_ref()
+            .and_then(|data| data.get("u"))
+            .and_then(serde_json::Value::as_str),
+        Some(uri.as_str()),
+        "retain the actual originating item; do not invent/modify a resolve receipt"
+    );
+    item
+}
+
+async fn change(backend: &Backend, uri: &Url, version: i32, source: &str) {
+    backend
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: uri.clone(),
+                version,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: source.into(),
+            }],
+        })
+        .await;
+}
+
+#[tokio::test]
+async fn blade_pending_nonidentity_cycle_refuses_public_completion_and_retained_resolve_until_repaired()
+ {
+    let (backend, dir) = create_psr4_workspace(
+        LARAVEL_APP_COMPOSER,
+        &[
+            ("app/User.php", USER),
+            ("app/Other.php", OTHER),
+            ("app/Caller.php", CALLER),
+            ("app/Independent.php", UNRELATED),
+            ("resources/views/page.blade.php", PAGE),
+            ("resources/views/partial.blade.php", PARTIAL),
+        ],
+    );
+    let user = workspace_uri(&backend, "app/User.php");
+    let other = workspace_uri(&backend, "app/Other.php");
+    let caller = workspace_uri(&backend, "app/Caller.php");
+    let independent = workspace_uri(&backend, "app/Independent.php");
+    let page = workspace_uri(&backend, "resources/views/page.blade.php");
+    let partial = workspace_uri(&backend, "resources/views/partial.blade.php");
+    // Headless initialization does not index the workspace: acknowledge real
+    // model/caller source through didOpen before any template assertion.
+    open_php(&backend, &user, USER).await;
+    open_php(&backend, &other, OTHER).await;
+    open_php(&backend, &caller, CALLER).await;
+    open_php(&backend, &independent, UNRELATED).await;
+    let independent_item = typed_item(&backend, &independent, UNRELATED, "$unrelated->").await;
+    let independent_resolved = backend.completion_resolve(independent_item).await.unwrap();
+    assert!(
+        independent_resolved.documentation.is_some(),
+        "resolve positive control"
+    );
+    open_document(&backend, &page, "blade", PAGE).await;
+    open_document(&backend, &partial, "blade", PARTIAL).await;
+    let retained = typed_item(&backend, &partial, PARTIAL, "$person->").await;
+    let resolved = backend.completion_resolve(retained.clone()).await.unwrap();
+    assert!(
+        resolved.documentation.is_some(),
+        "actual Blade resolve worked before the edit"
+    );
+
+    // A->B was transparent. This real unsaved B edit adds a nonidentity B->A
+    // edge; each turn nests person again, so the graph cannot publish a current
+    // fixed point. No private flags, diagnostic caches or synthetic callbacks.
+    change(&backend, &partial, 2, UNSUPPORTED).await;
+    let completion_error = backend
+        .completion(parameters(&partial, UNSUPPORTED, "$person->"))
+        .await
+        .expect_err("pending graph must not advertise stale completion items");
+    assert_eq!(completion_error.code, ErrorCode::ServerError(-32801));
+    let resolve_error = backend
+        .completion_resolve(retained)
+        .await
+        .expect_err("retained old item must not resolve while its origin is pending");
+    assert_eq!(resolve_error.code, ErrorCode::ServerError(-32801));
+    // Refusal belongs to the affected graph, not every document in the backend.
+    typed_item(&backend, &independent, UNRELATED, "$unrelated->").await;
+
+    // Repair the edge without saving/reopening. Public typed completion is the
+    // readiness observation, rather than inspecting a crate-private queue.
+    change(&backend, &partial, 3, REPAIRED).await;
+    let current = typed_item(&backend, &partial, REPAIRED, "$person->").await;
+    let current_resolved = backend.completion_resolve(current).await.unwrap();
+    assert!(current_resolved.documentation.is_some());
+    typed_item(&backend, &independent, UNRELATED, "$unrelated->").await;
+    assert_eq!(
+        std::fs::read_to_string(dir.path().join("resources/views/partial.blade.php")).unwrap(),
+        PARTIAL
+    );
+    assert_eq!(
+        std::fs::read_to_string(dir.path().join("app/Caller.php")).unwrap(),
+        CALLER
+    );
+}
diff --git a/tests/integration/blade_shared_vars.rs b/tests/integration/blade_shared_vars.rs

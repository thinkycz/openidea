+#[tokio::test]
+async fn blade_caller_refresh_implicit_cycle_reseeds_current_external_type() {
+    for self_render in [false, true] {
+        let page = if self_render {
+            "@include('page')\n{{ $person->userOnly }}\n"
+        } else {
+            "@include('partial')\n{{ $person->userOnly }}\n"
+        };
+        let partial = "@include('page')\n{{ $person->userOnly }}\n";
+        let mut files = vec![("resources/views/page.blade.php", page)];
+        if !self_render {
+            files.push(("resources/views/partial.blade.php", partial));
+        }
+        let (backend, dir, caller, views) = graph_fixture(&files).await;
+        for (uri, (_, source)) in views.iter().zip(&files) {
+            assert_member(&backend, uri, source, "userOnly", true).await;
+        }
+        change(
+            &backend,
+            &caller,
+            2,
+            &CALLER.replace("new User()", "new Other()"),
+        )
+        .await;
+        for (uri, (_, source)) in views.iter().zip(&files) {
+            assert_member(&backend, uri, source, "otherOnly", true).await;
+            assert_member(&backend, uri, source, "userOnly", false).await;
+            let pos = position_after(source, "$person");
+            let hover = hover_text_at(&backend, uri, pos.line, pos.character)
+                .await
+                .unwrap();
+            assert!(
+                hover.contains("Other") && !hover.contains("User"),
+                "{hover}"
+            );
+            let edited = source.replace("userOnly", "otherOnly");
+            change(&backend, uri, 2, &edited).await;
+            let pos = position_after(&edited, "otherOn");
+            let definitions = definition_locations(
+                goto_definition_at(&backend, uri, pos.line, pos.character).await,
+            );
+            assert!(
+                definitions
+                    .iter()
+                    .any(|location| location.uri.path().ends_with("/app/Other.php")),
+                "{definitions:?}"
+            );
+        }
+        assert_eq!(
+            std::fs::read_to_string(dir.path().join("app/Caller.php")).unwrap(),
+            CALLER
+        );
+        for (path, source) in &files {
+            assert_eq!(
+                std::fs::read_to_string(dir.path().join(path)).unwrap(),
+                *source
+            );
+        }
+    }
+    let annotated = "@php /** @var \\App\\Other $person */ @endphp\n@include('page')\n{{ $person->otherOnly }}\n";
+    let (backend, _dir, caller, views) =

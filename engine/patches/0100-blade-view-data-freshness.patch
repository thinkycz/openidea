+mod blade_caller_refresh_classifier {
+    //! AST proof for transparent Blade render cycles.
+    //! Classifies effects only; never resolves or widens a PHP type.
+
+    use mago_span::HasSpan;
+    use mago_syntax::cst::*;
+    use mago_syntax::walker::Walker;
+
+    /// The trusted lowering projection identifies the actual generated wrapper.
+    /// Unsupported or malformed code is ineligible for identity propagation.
+    pub(super) fn transparent_blade_cycle_body(
+        virtual_php: &str,
+        wrapper_scope_start: u32,
+    ) -> bool {
+        struct Finder;
+        struct Found {
+            offset: u32,
+            result: Option<bool>,
+            first_effect: Option<u32>,
+            end: u32,
+        }
+        impl Found {
+            fn inspect_body(&mut self, body: &Block<'_>) {
+                self.result = Some(transparent_wrapper_statements(body));
+                self.first_effect = body
+                    .statements
+                    .iter()
+                    .skip(1)
+                    .find(|statement| !matches!(statement, Statement::Noop(_)))
+                    .map(|statement| statement.span().start.offset);
+                self.end = body.right_brace.end.offset;
+            }
+        }
+        impl<'ast, 'arena> Walker<'ast, 'arena, Found> for Finder {
+            fn walk_in_function(&self, node: &'ast Function<'arena>, found: &mut Found) {
+                if crate::atom::bytes_to_str(node.name.value) == crate::blade::WRAPPER_FUNCTION
+                    && node.parameter_list.parameters.is_empty()
+                    && node.body.left_brace.start.offset == found.offset
+                {
+                    found.inspect_body(&node.body);
+                }
+            }
+            fn walk_in_method(&self, node: &'ast Method<'arena>, found: &mut Found) {
+                if crate::atom::bytes_to_str(node.name.value) != crate::blade::WRAPPER_FUNCTION
+                    || !node.parameter_list.parameters.is_empty()
+                {
+                    return;
+                }
+                if let MethodBody::Concrete(body) = &node.body
+                    && body.left_brace.start.offset == found.offset
+                {
+                    found.inspect_body(body);
+                }
+            }
+        }
+        crate::parser::with_parsed_program(virtual_php, "blade_cycle_identity", |program, _| {
+            if !program.errors.is_empty() {
+                return false;
+            }
+            let mut found = Found {
+                offset: wrapper_scope_start,
+                result: None,
+                first_effect: None,
+                end: wrapper_scope_start,
+            };
+            for statement in program.statements.iter() {
+                Finder.walk_statement(statement, &mut found);
+            }
+            found.result.unwrap_or(false)
+                && !program.trivia.iter().any(|trivia| {
+                    // A leading contract is a fixed seed. A later PHPDoc can
+                    // change the engine's type at only some render edges,
+                    // which is not whole-node identity propagation.
+                    trivia.kind == TriviaKind::DocBlockComment
+                        && found
+                            .first_effect
+                            .is_some_and(|start| trivia.span.start.offset >= start)
+                        && trivia.span.end.offset <= found.end
+                        && crate::atom::bytes_to_str(trivia.value).contains("@var")
+                })
+        })
+    }
+
+    fn transparent_wrapper_statements(body: &Block<'_>) -> bool {
+        let mut statements = body.statements.iter();
+        // Only the first, generated global is permitted. A second user-authored
+        // global can replace bindings and is rejected by the statement whitelist.
+        let Some(Statement::Global(global)) = statements.next() else {
+            return false;
+        };
+        let mut variables = global.variables.iter();
+        let direct_name = |variable: &Variable<'_>, expected: &str| matches!(variable, Variable::Direct(v) if crate::atom::bytes_to_str(v.name) == expected);
+        if !variables.next().is_some_and(|v| direct_name(v, "$errors"))
+            || !variables.next().is_some_and(|v| direct_name(v, "$__env"))
+            || !variables.all(|v| matches!(v, Variable::Direct(_)))
+        {
+            return false;
+        }
+        statements.all(|statement| match statement {
+            Statement::Noop(_) | Statement::Inline(_) => true,
+            Statement::Echo(echo) => echo
+                .values
+                .iter()
+                .all(|value| cycle_read_only_expression(value)),
+            Statement::EchoTag(echo) => echo
+                .values
+                .iter()
+                .all(|value| cycle_read_only_expression(value)),
+            Statement::Expression(expression) => {
+                cycle_identity_render(expression.expression)
+                    || cycle_read_only_expression(expression.expression)
+            }
+            _ => false,
+        })
+    }
+
+    /// An include forwards its environment. Static same-name overrides copy
+    /// those same values, so neither form can construct a new type term.
+    fn cycle_identity_render(expression: &Expression<'_>) -> bool {
+        let Expression::Call(Call::Function(call)) = expression else {
+            return false;
+        };
+        let Expression::Identifier(name) = call.function else {
+            return false;
+        };
+        if crate::atom::bytes_to_str(name.value()) != "blade_view_directive" {
+            return false;
+        }
+        let mut args = call.argument_list.arguments.iter();
+        let Some(Argument::Positional(argument)) = args.next() else {
+            return false;
+        };
+        if argument.ellipsis.is_some()
+            || !matches!(argument.value, Expression::Literal(Literal::String(s))
+                if s.value.and_then(crate::atom::literal_bytes_to_str).is_some_and(|name| !name.is_empty()))
+        {
+            return false;
+        }
+        match args.next() {
+            None => true,
+            Some(Argument::Positional(data))
+                if data.ellipsis.is_none() && args.next().is_none() =>
+            {
+                same_name_identity_data(data.value)
+            }
+            _ => false,
+        }
+    }
+
+    fn same_name_identity_data(expression: &Expression<'_>) -> bool {
+        let elements = match expression {
+            Expression::Array(array) => &array.elements,
+            Expression::LegacyArray(array) => &array.elements,
+            _ => return false,
+        };
+        elements.iter().all(|element| {
+            let ArrayElement::KeyValue(entry) = element else {
+                return false;
+            };
+            let Expression::Literal(Literal::String(key)) = entry.key else {
+                return false;
+            };
+            let Some(name) = super::string_literal_contents(key) else {
+                return false;
+            };
+            let Expression::Variable(Variable::Direct(value)) = entry.value else {
+                return false;
+            };
+            let mut bytes = name.bytes();
+            bytes
+                .next()
+                .is_some_and(|byte| byte == b'_' || byte.is_ascii_alphabetic() || byte >= 0x80)
+                && bytes.all(|byte| byte == b'_' || byte.is_ascii_alphanumeric() || byte >= 0x80)
+                && crate::atom::bytes_to_str(value.name).strip_prefix('$') == Some(name.as_str())
+        })
+    }
+
+    /// A syntactic no-binding-write whitelist. It deliberately excludes unknown
+    /// calls, references, operators, array access and dynamic property selectors.
+    /// Read-only property expressions follow existing PHP variable resolution;
+    /// this function neither executes magic methods nor claims to prove purity.
+    fn cycle_read_only_expression(expression: &Expression<'_>) -> bool {
+        let mut pending = vec![expression];
+        while let Some(expression) = pending.pop() {
+            match expression {
+                Expression::Literal(_) | Expression::Variable(Variable::Direct(_)) => {}
+                Expression::Parenthesized(group) => pending.push(group.expression),
+                Expression::Access(Access::Property(property)) => {
+                    if !matches!(property.property, ClassLikeMemberSelector::Identifier(_)) {
+                        return false;
+                    }
+                    pending.push(property.object);
+                }
+                Expression::Access(Access::NullSafeProperty(property)) => {
+                    if !matches!(property.property, ClassLikeMemberSelector::Identifier(_)) {
+                        return false;
+                    }
+                    pending.push(property.object);
+                }
+                Expression::Call(Call::Function(call)) => {
+                    let Expression::Identifier(name) = call.function else {
+                        return false;
+                    };
+                    if crate::atom::bytes_to_str(name.value()) != "e" {
+                        return false;
+                    }
+                    let mut args = call.argument_list.arguments.iter();
+                    let Some(Argument::Positional(argument)) = args.next() else {
+                        return false;
+                    };
+                    if argument.ellipsis.is_some() || args.next().is_some() {
+                        return false;
+                    }
+                    pending.push(argument.value);
+                }
+                _ => return false,
+            }
+        }
+        true
+    }

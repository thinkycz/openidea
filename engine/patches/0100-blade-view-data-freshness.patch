+        &caller,
+        2,
+        &CALLER.replace("new User()", "new Other()"),
+    )
+    .await;
+    assert_member(&backend, &views[0], annotated, "otherOnly", true).await;
+    assert_member(&backend, &views[0], annotated, "userOnly", false).await;
+}

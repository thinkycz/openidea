+        match frame.0.next() {
+            Some(ArrayElement::KeyValue(entry)) => match compact_array_key(entry.key) {
+                Some(key) => frame.1.write(key, entry.value, true),
+                None => {
+                    frame.1.uncertain_keys(false);
+                    frame.1.write(CompactArrayKey::Unknown, entry.value, true);
+                }
+            },
+            Some(ArrayElement::Value(entry)) => frame.1.append(entry.value, true),
+            Some(ArrayElement::Variadic(entry)) => match entry.value {
+                Expression::Array(array) => {
+                    frames.push((array.elements.iter(), CompactArrayValues::new()))
+                }
+                Expression::LegacyArray(array) => {
+                    frames.push((array.elements.iter(), CompactArrayValues::new()))
+                }
+                _ => frame.1.uncertain_keys(true),
+            },
+            Some(ArrayElement::Missing(_)) => frame.1.uncertain_keys(false),
+            None => {
+                let (_, completed) = frames.pop().expect("completed literal");
+                match frames.last_mut() {
+                    Some(parent) => parent.1.spread(completed),
+                    None => return completed,
+                }
+            }
+        }

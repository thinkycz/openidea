+//! Unsaved caller edits refresh existing Blade virtual PHP without reopening it.
+use crate::common::{
+    LARAVEL_APP_COMPOSER, complete_labels_at_opened, create_psr4_workspace, definition_locations,
+    goto_definition_at, hover_text_at, open_document, open_php, position_after,
+};
+use phpantom_lsp::Backend;
+use tower_lsp::{LanguageServer, lsp_types::*};
+
+const USER: &str = "<?php namespace App; class User { public string $userOnly = ''; }";
+const OTHER: &str = "<?php namespace App; class Other { public string $otherOnly = ''; }";
+const TEMPLATE: &str = "{{ $person->userOnly }}\n";
+const CALLER: &str = "<?php namespace App; class Caller { function show() { $person = new User(); return view('page', compact('person')); } }";
+
+async fn fixture() -> (Backend, tempfile::TempDir, Url, Url, Url) {
+    let (backend, dir) = create_psr4_workspace(
+        LARAVEL_APP_COMPOSER,
+        &[
+            ("app/User.php", USER),
+            ("app/Other.php", OTHER),
+            ("app/Caller.php", CALLER),
+            ("resources/views/page.blade.php", TEMPLATE),
+            ("resources/views/next.blade.php", TEMPLATE),
+        ],
+    );
+    let caller = Url::from_file_path(dir.path().join("app/Caller.php")).unwrap();
+    let page = Url::from_file_path(dir.path().join("resources/views/page.blade.php")).unwrap();
+    let next = Url::from_file_path(dir.path().join("resources/views/next.blade.php")).unwrap();
+    open_php(&backend, &caller, CALLER).await;
+    open_document(&backend, &page, "blade", TEMPLATE).await;
+    open_document(&backend, &next, "blade", TEMPLATE).await;
+    assert_member(&backend, &page, TEMPLATE, "userOnly", true).await;
+    (backend, dir, caller, page, next)
+}
+
+async fn change(backend: &Backend, uri: &Url, version: i32, text: &str) {
+    backend
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: uri.clone(),
+                version,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: text.into(),
+            }],
+        })
+        .await;
+}
+
+async fn assert_member(backend: &Backend, uri: &Url, text: &str, member: &str, present: bool) {
+    let pos = position_after(text, "$person->");
+    let labels = complete_labels_at_opened(backend, uri, pos.line, pos.character).await;
+    assert_eq!(
+        labels.iter().any(|label| label == member),
+        present,
+        "{uri}: {member}, completions: {labels:?}"
+    );
+}
+
+#[tokio::test]
+async fn blade_caller_refresh_unsaved_type_reaches_completion_hover_definition() {
+    let (backend, dir, caller, page, _) = fixture().await;
+    let changed = CALLER.replace("new User()", "new Other()");
+    change(&backend, &caller, 2, &changed).await;
+    let caller_pos = position_after(&changed, "$person");
+    assert!(
+        hover_text_at(&backend, &caller, caller_pos.line, caller_pos.character)
+            .await
+            .unwrap()
+            .contains("Other")
+    );
+    assert_member(&backend, &page, TEMPLATE, "otherOnly", true).await;
+    assert_member(&backend, &page, TEMPLATE, "userOnly", false).await;
+    let variable = position_after(TEMPLATE, "$person");
+    assert!(
+        hover_text_at(&backend, &page, variable.line, variable.character)
+            .await
+            .unwrap()
+            .contains("Other")
+    );
+    let property = position_after(TEMPLATE, "userOn");
+    assert!(
+        definition_locations(
+            goto_definition_at(&backend, &page, property.line, property.character).await
+        )
+        .is_empty()
+    );
+    assert_eq!(
+        std::fs::read_to_string(dir.path().join("app/Caller.php")).unwrap(),
+        CALLER
+    );
+}
+
+#[tokio::test]
+async fn blade_caller_refresh_removed_view_clears_old_template_scope() {
+    let (backend, _dir, caller, page, _) = fixture().await;
+    change(
+        &backend,
+        &caller,
+        2,
+        "<?php namespace App; class Caller { function show() { return null; } }",
+    )
+    .await;
+    assert_member(&backend, &page, TEMPLATE, "userOnly", false).await;
+}
+
+#[tokio::test]
+async fn blade_caller_refresh_renamed_view_updates_old_and_new_targets() {
+    let (backend, _dir, caller, page, next) = fixture().await;
+    let changed = CALLER
+        .replace("'page'", "'next'")
+        .replace("new User()", "new Other()");
+    change(&backend, &caller, 2, &changed).await;
+    assert_member(&backend, &page, TEMPLATE, "userOnly", false).await;
+    assert_member(&backend, &next, TEMPLATE, "otherOnly", true).await;
+}
+
+#[tokio::test]
+async fn blade_caller_refresh_preserves_unsaved_template_overlay() {
+    let (backend, dir, caller, page, _) = fixture().await;
+    let overlay = "{{-- unsaved overlay --}}\n{{ $person->otherOnly }}\n";
+    change(&backend, &page, 2, overlay).await;
+    change(
+        &backend,
+        &caller,
+        2,
+        &CALLER.replace("new User()", "new Other()"),
+    )
+    .await;
+    assert_member(&backend, &page, overlay, "otherOnly", true).await;
+    let property = position_after(overlay, "otherOn");
+    let definitions = definition_locations(
+        goto_definition_at(&backend, &page, property.line, property.character).await,
+    );
+    assert!(
+        definitions
+            .iter()
+            .any(|loc| loc.uri.path().ends_with("/app/Other.php")),
+        "{definitions:?}"
+    );
+    assert_eq!(
+        std::fs::read_to_string(dir.path().join("resources/views/page.blade.php")).unwrap(),
+        TEMPLATE
+    );
+}
+
+#[tokio::test]
+async fn blade_caller_refresh_save_control_updates_existing_template() {
+    let (backend, _dir, caller, page, _) = fixture().await;
+    let changed = CALLER.replace("new User()", "new Other()");
+    change(&backend, &caller, 2, &changed).await;
+    backend
+        .did_save(DidSaveTextDocumentParams {
+            text_document: TextDocumentIdentifier { uri: caller },
+            text: None,
+        })
+        .await;
+    // didSave inference is deliberately detached; wait on the observable result.
+    let pos = position_after(TEMPLATE, "$person->");
+    for _ in 0..100 {
+        if complete_labels_at_opened(&backend, &page, pos.line, pos.character)
+            .await
+            .iter()
+            .any(|v| v == "otherOnly")
+        {
+            return;
+        }
+        tokio::time::sleep(std::time::Duration::from_millis(10)).await;
+    }
+    panic!("saved caller failed to refresh existing template");
+}
+
+async fn graph_fixture(views: &[(&str, &str)]) -> (Backend, tempfile::TempDir, Url, Vec<Url>) {
+    let mut files = vec![
+        ("app/User.php", USER),
+        ("app/Other.php", OTHER),
+        ("app/Caller.php", CALLER),
+    ];
+    files.extend_from_slice(views);
+    let (backend, dir) = create_psr4_workspace(LARAVEL_APP_COMPOSER, &files);
+    let caller = Url::from_file_path(dir.path().join("app/Caller.php")).unwrap();
+    open_php(&backend, &caller, CALLER).await;
+    let mut uris = Vec::new();
+    for (path, content) in views {
+        let uri = Url::from_file_path(dir.path().join(path)).unwrap();
+        open_document(&backend, &uri, "blade", content).await;
+        uris.push(uri);
+    }
+    (backend, dir, caller, uris)
+}
+
+#[tokio::test]
+async fn blade_caller_refresh_unsaved_type_flows_to_included_partial() {
+    let page = "@include('partial')\n";
+    let (backend, _dir, caller, views) = graph_fixture(&[
+        ("resources/views/page.blade.php", page),
+        ("resources/views/partial.blade.php", TEMPLATE),
+    ])
+    .await;
+    assert_member(&backend, &views[1], TEMPLATE, "userOnly", true).await;
+    change(
+        &backend,
+        &caller,
+        2,
+        &CALLER.replace("new User()", "new Other()"),
+    )
+    .await;
+    assert_member(&backend, &views[1], TEMPLATE, "otherOnly", true).await;
+    assert_member(&backend, &views[1], TEMPLATE, "userOnly", false).await;
+}
+
+#[tokio::test]
+async fn blade_caller_refresh_unsaved_type_flows_to_component_attribute() {

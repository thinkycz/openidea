+impl BladeRenderEnvironment {
+    fn new(mut vars: InferredVars, complete: bool) -> Self {
+        vars.sort_by(|a, b| a.0.cmp(&b.0));
+        Self {
+            vars,
+            complete,
+            apply_defaults: true,
+        }
+    }
+    fn declarations(vars: InferredVars) -> Self {
+        let mut value = Self::new(vars, false);
+        value.apply_defaults = false;
+        value
+    }
+    fn equivalent(&self, other: &Self) -> bool {
+        self.complete == other.complete
+            && self.apply_defaults == other.apply_defaults
+            && self.vars.len() == other.vars.len()
+            && self
+                .vars
+                .iter()
+                .zip(&other.vars)
+                .all(|((a, at), (b, bt))| a == b && at.equivalent(bt))
+    }

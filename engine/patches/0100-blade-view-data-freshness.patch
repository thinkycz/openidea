+fn merge_render_site_with_shared_fallback(
+    merged: &mut HashMap<String, Vec<PhpType>>,
+    vars: Vec<(String, PhpType)>,
+    complete: bool,
+    shared_fallback: &[(String, PhpType)],
+) {
+    for (name, fallback) in shared_fallback {
+        if vars.iter().any(|(provided, _)| provided == name) {
+            continue;
+        }
+        // An unreadable data argument may carry this name. Shared defaults are
+        // definite only when this known render site's omission is established.
+        merged.entry(name.clone()).or_default().push(if complete {
+            fallback.clone()
+        } else {
+            PhpType::mixed()
+        });
+    }
+    for (name, ty) in vars {
+        merged.entry(name).or_default().push(ty);
+    }
+}

+    /// Stage resource symbols outside admission locks and publish only the
+    /// matching open source, even if a newer edit or close won during parsing.
+    pub(crate) fn update_current_resource_symbol_index(
+        &self,
+        uri: &str,
+        content: &Arc<String>,
+    ) -> bool {
+        let symbol_map = Arc::new(self.resource_symbol_map(content));
+        let _merge = self.index_merge_gate.lock();
+        if self
+            .diag
+            .documents
+            .lock()
+            .capture_source(uri, content)
+            .is_err()
+            || !self
+                .open_files
+                .read()
+                .get(uri)
+                .is_some_and(|current| Arc::ptr_eq(current, content))
+        {
+            return false;
+        }
+        self.diag.documents.lock().retire_index_source(uri);
+        self.symbol_maps
+            .write()
+            .insert(uri.into(), Arc::clone(&symbol_map));
+        self.reindex_references_for_symbol_maps_batch(vec![(uri.into(), symbol_map)]);
+        true
+    }

+fn sole_workspace(advertised: bool) -> (Backend, tempfile::TempDir) {
+    let composer = COMPOSER_JSON.replace("^11.0", if advertised { "^13.0" } else { "^12.0" });
+    let trait_source = if advertised {
+        ENUMERATES_VALUES_PHP.replace(
+            " * @property-read HigherOrderCollectionProxy<TKey, TValue> $some",
+            " * @property-read HigherOrderCollectionProxy<TKey, TValue> $sole\n * @property-read HigherOrderCollectionProxy<TKey, TValue> $some",
+        )
+    } else {
+        ENUMERATES_VALUES_PHP.to_string()
+    };
+    workspace_with_trait(&composer, &trait_source)
+}
+
+async fn assert_sole_item_type(collection: &str, expression: &str) {
+    let (backend, dir) = sole_workspace(true);
+    let content = probe_source(collection, expression);
+    let uri = open_php_at(&backend, &dir, "src/SoleProbe.php", &content).await;
+    let position = position_after(&content, "$res");
+    let hover = hover_text_at(&backend, &uri, position.line, position.character)
+        .await
+        .expect("the assigned sole result must hover");
+    let ty = hover
+        .lines()
+        .find_map(|line| line.strip_prefix("$result = "))
+        .unwrap_or_else(|| panic!("missing result type for {expression}: {hover}"));
+    assert_eq!(ty, "User", "{collection}: {expression}: {hover}");
+    assert!(
+        hover.contains("namespace App;"),
+        "the original application item must be returned: {hover}"
+    );
+}

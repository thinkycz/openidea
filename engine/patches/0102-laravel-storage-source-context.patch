+    /// Recover classes and lexical names from the supplied source without
+    /// publishing editor metadata. Closed provider files may have lazily
+    /// cached classes while their imports and namespace remain uncached.
+    pub(crate) fn source_file_context(&self, content: &str) -> FileContext {
+        let _parse = crate::parser::with_parse_cache(content);
+        let (mut classes, blocks) = Self::parse_php_classes_by_block(content, None, false, true);
+        let (use_map, namespace, resolved_names) =
+            crate::parser::with_parsed_program(content, "source_file_context", |program, _| {
+                let mut use_map = std::collections::HashMap::new();
+                Self::extract_use_statements_from_statements(
+                    program.statements.iter(),
+                    &mut use_map,
+                );
+                let namespace = Self::extract_namespace_from_statements(program.statements.iter());
+                let arena = mago_allocator::LocalArena::new();
+                let names = mago_names::resolver::NameResolver::new(&arena).resolve(program);
+                (
+                    use_map,
+                    namespace,
+                    Some(Arc::new(crate::names::OwnedResolvedNames::from_resolved(
+                        &names,
+                    ))),
+                )
+            });
+        Self::resolve_parent_class_names_by_block(&mut classes, &blocks, &use_map, &namespace);
+        let classes = classes
+            .into_iter()
+            .map(|(mut class, namespace, _)| {
+                class.file_namespace = namespace.as_deref().map(crate::atom::atom);
+                Arc::new(class)
+            })
+            .collect();
+        FileContext {
+            classes,
+            use_map,
+            namespace,
+            namespace_spans: (!blocks.is_empty()).then_some(blocks),
+            resolved_names,
+        }
+    }
+

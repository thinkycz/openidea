diff --git a/src/backend/laravel/storage_tests.rs b/src/backend/laravel/storage_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..26a0076a8dcaa65747e8ca6498cd47045d639139
--- /dev/null
+++ b/src/backend/laravel/storage_tests.rs
@@ -0,0 +1,305 @@
+use crate::Backend;
+use crate::composer::Psr4Mapping;
+use crate::types::ClassInfo;
+use crate::virtual_members::laravel::{
+    StorageDriverRegistration, extract_storage_driver_registrations,
+};
+use std::sync::Arc;
+use tower_lsp::lsp_types::Url;
+
+const IMPORTED_PROVIDER: &str = r#"<?php
+namespace App\Providers;
+use Illuminate\Support\Facades\Storage;
+use Illuminate\Filesystem\FilesystemAdapter as DiskAdapter;
+class StorageProvider {
+    public function boot(): void {
+        Storage::extend('pantry', function ($app, $config) {
+            return new DiskAdapter();
+        });
+    }
+}
+"#;
+
+struct Fixture {
+    backend: Backend,
+    _directory: tempfile::TempDir,
+    provider_uri: String,
+    source: String,
+}
+
+impl Fixture {
+    fn new(source: &str) -> Self {
+        let directory = tempfile::tempdir().unwrap();
+        let root = directory.path().canonicalize().unwrap();
+        for (name, content) in [
+            (
+                "vendor/illuminate/Filesystem/FilesystemAdapter.php",
+                "<?php namespace Illuminate\\Filesystem; class FilesystemAdapter {}",
+            ),
+            (
+                "app/Providers/RelativeAdapter.php",
+                "<?php namespace App\\Providers; class RelativeAdapter {}",
+            ),
+            (
+                "app/Adapters/FirstAdapter.php",
+                "<?php namespace App\\Adapters; class FirstAdapter {}",
+            ),
+            (
+                "app/Adapters/SecondAdapter.php",
+                "<?php namespace App\\Adapters; class SecondAdapter {}",
+            ),
+            ("app/Providers/StorageProvider.php", source),
+        ] {
+            let path = root.join(name);
+            std::fs::create_dir_all(path.parent().unwrap()).unwrap();
+            std::fs::write(path, content).unwrap();
+        }
+        let backend = Backend::new_test_with_workspace(
+            root.clone(),
+            vec![
+                Psr4Mapping {
+                    prefix: "App\\".into(),
+                    base_path: "app/".into(),
+                },
+                Psr4Mapping {
+                    prefix: "Illuminate\\".into(),
+                    base_path: "vendor/illuminate/".into(),
+                },
+            ],
+        );
+        Self {
+            backend,
+            _directory: directory,
+            provider_uri: Url::from_file_path(root.join("app/Providers/StorageProvider.php"))
+                .unwrap()
+                .to_string(),
+            source: source.to_owned(),
+        }
+    }
+
+    fn assert_no_editor_metadata(&self) {
+        // Ordinary lazy class caching is allowed, but recovery must not
+        // publish editor metadata even under a synthetic/recovery URI.
+        assert!(self.backend.open_files.read().is_empty());
+        assert!(self.backend.file_imports.read().is_empty());
+        assert!(self.backend.file_namespaces.read().is_empty());
+        assert!(self.backend.resolved_names.read().is_empty());
+        assert!(self.backend.symbol_maps.read().is_empty());
+        let uri = self.provider_uri.as_str();
+        assert!(
+            !self.backend.open_files.read().contains_key(uri),
+            "inference must not invent didOpen"
+        );
+        assert!(
+            !self.backend.file_imports.read().contains_key(uri),
+            "source imports must remain transient"
+        );
+        assert!(
+            !self.backend.file_namespaces.read().contains_key(uri),
+            "source namespaces must remain transient"
+        );
+        assert!(
+            !self.backend.resolved_names.read().contains_key(uri),
+            "source name map must remain transient"
+        );
+        assert!(
+            !self.backend.symbol_maps.read().contains_key(uri),
+            "inference must not publish a provider symbol map"
+        );
+    }
+
+    fn infer(&self) -> Vec<StorageDriverRegistration> {
+        self.assert_no_editor_metadata();
+        let before: Vec<Arc<ClassInfo>> = self
+            .backend
+            .symbols
+            .uri_classes_index
+            .read()
+            .get(&self.provider_uri)
+            .cloned()
+            .unwrap_or_default();
+        let parsed_before = self.backend.parsed_uris.read().contains(&self.provider_uri);
+        let mut registrations = extract_storage_driver_registrations(&self.source);
+        assert!(
+            !registrations.is_empty(),
+            "the actual registration extractor must recognize this fixture"
+        );
+        assert!(
+            registrations.iter().all(|reg| reg.return_type.is_none()),
+            "fixtures must exercise closure body inference, not annotations"
+        );
+        self.backend
+            .infer_storage_driver_return_types(&mut registrations, &self.source);
+        self.assert_no_editor_metadata();
+        let after = self
+            .backend
+            .symbols
+            .uri_classes_index
+            .read()
+            .get(&self.provider_uri)
+            .cloned()
+            .unwrap_or_default();
+        assert_eq!(
+            before.len(),
+            after.len(),
+            "transient recovery must not index the provider"
+        );
+        assert!(
+            before.iter().zip(&after).all(|(a, b)| Arc::ptr_eq(a, b)),
+            "existing lazy provider classes must not be replaced"
+        );
+        assert_eq!(
+            parsed_before,
+            self.backend.parsed_uris.read().contains(&self.provider_uri)
+        );
+        let path = Url::parse(&self.provider_uri)
+            .unwrap()
+            .to_file_path()
+            .unwrap();
+        assert_eq!(std::fs::read_to_string(path).unwrap(), self.source);
+        registrations
+    }
+}
+
+fn assert_type(registrations: &[StorageDriverRegistration], driver: &str, expected: &str) {
+    let reg = registrations
+        .iter()
+        .find(|reg| reg.driver == driver)
+        .expect("expected literal driver registration");
+    assert_eq!(
+        reg.return_type.as_ref().and_then(|ty| ty.base_name()),
+        Some(expected),
+        "driver {driver}: {:?}",
+        reg.return_type
+    );
+}
+
+#[test]
+fn storage_source_context_cold_imported_closure_return() {
+    let fixture = Fixture::new(IMPORTED_PROVIDER);
+    assert!(
+        fixture
+            .backend
+            .file_context(&fixture.provider_uri)
+            .classes
+            .is_empty()
+    );
+    assert_type(
+        &fixture.infer(),
+        "pantry",
+        "Illuminate\\Filesystem\\FilesystemAdapter",
+    );
+}
+
+#[test]
+fn storage_source_context_lazy_provider_still_recovers_missing_imports() {
+    let fixture = Fixture::new(IMPORTED_PROVIDER);
+    assert!(
+        fixture
+            .backend
+            .find_or_load_class("App\\Providers\\StorageProvider")
+            .is_some()
+    );
+    let old_context = fixture.backend.file_context(&fixture.provider_uri);
+    assert_eq!(
+        old_context.classes.len(),
+        1,
+        "exercise the real lazy class parser"
+    );
+    assert!(old_context.use_map.is_empty());
+    assert!(old_context.namespace.is_none());
+    fixture.assert_no_editor_metadata();
+    assert_type(
+        &fixture.infer(),
+        "pantry",
+        "Illuminate\\Filesystem\\FilesystemAdapter",
+    );
+}
+
+#[test]
+fn storage_source_context_cold_namespace_relative_arrow_return() {
+    let fixture = Fixture::new(
+        r#"<?php
+namespace App\Providers;
+use Illuminate\Support\Facades\Storage;
+class StorageProvider {
+    public function boot(): void {
+        Storage::extend('relative', fn ($app, $config) => new RelativeAdapter());
+    }
+}
+"#,
+    );
+    assert_type(
+        &fixture.infer(),
+        "relative",
+        "App\\Providers\\RelativeAdapter",
+    );
+}
+
+#[test]
+fn storage_source_context_alias_collision_uses_each_closure_namespace() {
+    let fixture = Fixture::new(
+        r#"<?php
+namespace App\First {
+    use Illuminate\Support\Facades\Storage;
+    use App\Adapters\FirstAdapter as Disk;
+    class FirstProvider {
+        public function boot(): void {
+            Storage::extend('first', fn ($app, $config) => new Disk());
+        }
+    }
+}
+namespace App\Second {
+    use Illuminate\Support\Facades\Storage;
+    use App\Adapters\SecondAdapter as Disk;
+    class SecondProvider {
+        public function boot(): void {
+            Storage::extend('second', function ($app, $config) { return new Disk(); });
+        }
+    }
+}
+"#,
+    );
+    let registrations = fixture.infer();
+    assert_eq!(registrations.len(), 2);
+    assert_ne!(
+        registrations[0].closure_offset,
+        registrations[1].closure_offset
+    );
+    assert_type(&registrations, "first", "App\\Adapters\\FirstAdapter");
+    assert_type(&registrations, "second", "App\\Adapters\\SecondAdapter");
+}
+
+#[test]
+fn storage_source_context_fully_qualified_body_is_a_positive_control() {
+    let fixture = Fixture::new(
+        r#"<?php
+use Illuminate\Support\Facades\Storage;
+Storage::extend('qualified', fn ($app, $config) => new \Illuminate\Filesystem\FilesystemAdapter());
+"#,
+    );
+    assert_type(
+        &fixture.infer(),
+        "qualified",
+        "Illuminate\\Filesystem\\FilesystemAdapter",
+    );
+}
+
+#[test]
+fn storage_source_context_unresolved_custom_driver_stays_unknown() {
+    let fixture = Fixture::new(
+        r#"<?php
+namespace App\Providers;
+use Illuminate\Support\Facades\Storage;
+Storage::extend('unknown', fn ($app, $config) => $config['adapter']);
+"#,
+    );
+    let registrations = fixture.infer();
+    assert_eq!(registrations.len(), 1);
+    assert_eq!(registrations[0].driver, "unknown");
+    assert!(
+        registrations[0].return_type.is_none(),
+        "an unresolved config value must not invent a concrete adapter: {:?}",
+        registrations[0].return_type
+    );
+}

diff --git a/tests/integration/diagnostics_return_type_errors.rs b/tests/integration/diagnostics_return_type_errors.rs
index dadd3c1c72954b3d4d700f0a258005caf1fad2cf..09d743827a1ff6787bfc2593356a48b4fee08bd8 100644
--- a/tests/integration/diagnostics_return_type_errors.rs
+++ b/tests/integration/diagnostics_return_type_errors.rs
@@ -4978,3 +4978,180 @@ namespace Second {
         "Short names should resolve against the commented namespace block, got: {diags:?}"
     );
 }
+
+fn assert_return_contract_case(
+    doc_type: Option<&str>,
+    native_type: Option<&str>,
+    statement: &str,
+    diagnosed: bool,
+) {
+    for method in [false, true] {
+        let doc = doc_type.map_or_else(String::new, |ty| format!("/** @return {ty} */\n"));
+        let native = native_type.map_or_else(String::new, |ty| format!(": {ty}"));
+        let declaration = if method {
+            format!(
+                "class ReturnContractFixture {{\n{doc}public function result(){native} {{\n    {statement}\n}}\n}}\n"
+            )
+        } else {
+            format!("{doc}function result(){native} {{\n    {statement}\n}}\n")
+        };
+        let php = format!("<?php\n{declaration}");
+        let diags = collect(&php);
+        let messages = messages_with_code(&diags, "type_mismatch_return");
+        assert_eq!(
+            messages.len(),
+            usize::from(diagnosed),
+            "method={method}, doc={doc_type:?}, native={native_type:?}, statement={statement}: {diags:?}"
+        );
+        if diagnosed {
+            let diagnostic = diags
+                .iter()
+                .find(|diag| {
+                    diag.code == Some(NumberOrString::String("type_mismatch_return".into()))
+                })
+                .unwrap();
+            let return_start = php.rfind("    return").unwrap() + 4;
+            let (start, length) = if statement == "return;" {
+                (return_start, "return".len())
+            } else {
+                let expression = statement
+                    .strip_prefix("return ")
+                    .unwrap()
+                    .strip_suffix(';')
+                    .unwrap();
+                (return_start + "return ".len(), expression.len())
+            };
+            let preceding = &php[..start];
+            let line = preceding.bytes().filter(|byte| *byte == b'\n').count() as u32;
+            let character = preceding
+                .rsplit('\n')
+                .next()
+                .unwrap()
+                .encode_utf16()
+                .count() as u32;
+            assert_eq!(
+                diagnostic.range,
+                Range::new(
+                    Position::new(line, character),
+                    Position::new(line, character + length as u32),
+                ),
+                "diagnostic must identify this return keyword or expression: {php}"
+            );
+        }
+    }
+}
+
+#[test]
+fn return_contract_doc_only_nullable_bare_return_is_implicit_null() {
+    for doc in ["?string", "string|null", "null", "mixed"] {
+        assert_return_contract_case(Some(doc), None, "return;", false);
+    }
+}
+
+#[test]
+fn return_contract_doc_only_nonnullable_bare_return_is_still_diagnosed() {
+    for doc in ["string", "int", "array<string, int>", "never"] {
+        assert_return_contract_case(Some(doc), None, "return;", true);
+    }
+}
+
+#[test]
+fn return_contract_native_nullable_or_mixed_still_requires_a_value() {
+    for native in ["?string", "string|null", "null", "mixed"] {
+        assert_return_contract_case(None, Some(native), "return;", true);
+    }
+}
+
+#[test]
+fn return_contract_native_void_bare_return_survives_conflicting_doc() {
+    for doc in [None, Some("string"), Some("?string"), Some("mixed")] {
+        assert_return_contract_case(doc, Some("void"), "return;", false);
+    }
+}
+
+#[test]
+fn return_contract_native_void_value_is_illegal_despite_doc() {
+    for doc in [None, Some("int"), Some("mixed"), Some("null")] {
+        for statement in [
+            "return 42;",
+            "return null;",
+            "return unresolvedReturnValue();",
+        ] {
+            assert_return_contract_case(doc, Some("void"), statement, true);
+        }
+    }
+}
+
+#[test]
+fn return_contract_nullable_or_void_doc_cannot_legalize_native_string_bare_return() {
+    for doc in ["?string", "string|null", "null", "mixed", "void"] {
+        assert_return_contract_case(Some(doc), Some("string"), "return;", true);
+    }
+}
+
+#[test]
+fn return_contract_explicit_null_is_valid_for_nullable_contracts() {
+    for ty in ["?string", "string|null", "null", "mixed"] {
+        assert_return_contract_case(Some(ty), None, "return null;", false);
+        assert_return_contract_case(None, Some(ty), "return null;", false);
+    }
+}
+
+#[test]
+fn return_contract_value_expressions_still_obey_doc_refinement() {
+    // Bare scalar PHPDoc retains native nullability under the shared merge policy.
+    assert_return_contract_case(Some("string"), Some("?string"), "return null;", false);
+    assert_return_contract_case(
+        Some("array<string, int>"),
+        Some("array"),
+        "return ['key' => 'wrong'];",
+        true,
+    );
+    assert_return_contract_case(
+        Some("array<string, int>"),
+        Some("array"),
+        "return ['key' => 42];",
+        false,
+    );
+}
+
+#[test]
+fn return_contract_native_never_rejects_bare_return_despite_doc() {
+    for doc in [
+        None,
+        Some("never"),
+        Some("void"),
+        Some("mixed"),
+        Some("?string"),
+    ] {
+        assert_return_contract_case(doc, Some("never"), "return;", true);
+    }
+}
+
+#[test]
+fn return_contract_native_never_rejects_return_throw_despite_doc() {
+    for doc in [
+        None,
+        Some("never"),
+        Some("void"),
+        Some("mixed"),
+        Some("?string"),
+    ] {
+        assert_return_contract_case(
+            doc,
+            Some("never"),
+            "return throw new \\RuntimeException();",
+            true,
+        );
+    }
+}
+
+#[test]
+fn return_contract_doc_only_never_accepts_return_throw() {
+    assert_return_contract_case(
+        Some("never"),
+        None,
+        "return throw new \\RuntimeException();",
+        false,
+    );
+}

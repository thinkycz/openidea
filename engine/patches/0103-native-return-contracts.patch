+// ── Nullable and Void Return Contracts ──────────────────────────────────────
+// A PHPDoc-only nullable result may use a bare return, which yields null.
+// A native nullable declaration requires an explicit null expression instead.
+// All three methods below are valid PHP and need no return-type diagnostic.
+
+class NullableReturnContractDemo
+{
+    public bool $voidReachedReturn = false;
+
+    /** @return string|null */
+    public function documentedNullable(bool $hasValue)
+    {
+        if (!$hasValue) {
+            return;
+        }
+
+        return 'ready';
+    }
+
+    public function nativeNullable(bool $hasValue): ?string
+    {
+        if (!$hasValue) {
+            return null;
+        }
+
+        return 'ready';
+    }
+
+    public function nativeVoid(): void
+    {
+        $this->voidReachedReturn = true;
+        return;
+    }
+}
+
+

+// Append as a separate private module to canonical src/indexing/preload.rs.
+#[cfg(all(test, unix))]
+mod workspace_index_alias_overlay_tests {
+    use super::*;
+    use tower_lsp::lsp_types::{DidOpenTextDocumentParams, TextDocumentItem};
+
+    #[tokio::test]
+    async fn workspace_index_alias_disk_failure_does_not_retire_current_preferred_overlay() {
+        let directory = tempfile::tempdir().unwrap();
+        let root = directory.path().canonicalize().unwrap();
+        let target = root.join("Target.php");
+        let alias = root.join("Alias.php");
+        std::fs::write(&target, b"<?php\xff").unwrap();
+        std::os::unix::fs::symlink(&target, &alias).unwrap();
+        let owner = Url::from_file_path(&target).unwrap();
+        let failed = Url::from_file_path(&alias).unwrap();
+        let backend = Backend::new_test_with_workspace(root.clone(), vec![]);
+        // The same source-authority lifecycle invoked by ProjectRouter before
+        // Backend.on_did_open; Backend alone does not own router admission.
+        backend.symbols.source_authority.open(owner.as_str());
+        let overlay =
+            "<?php class CurrentOverlay { public function overlayOnly(): int { return 42; } }\n";
+        backend
+            .on_did_open(DidOpenTextDocumentParams {
+                text_document: TextDocumentItem {
+                    uri: owner.clone(),
+                    language_id: "php".into(),
+                    version: 7,
+                    text: overlay.into(),
+                },
+            })
+            .await;
+        assert_eq!(
+            backend
+                .symbols
+                .source_authority
+                .preferred(failed.as_str())
+                .as_deref(),
+            Some(owner.as_str())
+        );
+        assert_eq!(
+            backend.get_file_content(failed.as_str()).as_deref(),
+            Some(overlay)
+        );
+        assert!(backend.parsed_uris.read().contains(owner.as_str()));
+        {
+            let open = backend.open_files.read();
+            let text = open.get(owner.as_str()).unwrap();
+            assert!(
+                matches!(
+                    backend
+                        .diag
+                        .documents
+                        .lock()
+                        .capture_source(owner.as_str(), text),
+                    Ok(Some(_))
+                ),
+                "actual accepted current overlay required"
+            );
+        }
+        backend.mark_workspace_indexed();
+        // Actual production batch deliberately reads the alias's invalid disk
+        // bytes, then must reconcile failure with current preferred ownership.
+        backend.parse_paths_parallel_with_progress(&[(failed.to_string(), alias)], None);
+        assert!(
+            backend.workspace_index_complete(),
+            "raw alias failure cannot make a valid preferred editor owner unavailable"
+        );
+        assert!(
+            !backend
+                .workspace_index_outcome
+                .lock()
+                .unreadable
+                .contains(failed.as_str())
+        );
+        assert_eq!(
+            backend.get_file_content(failed.as_str()).as_deref(),
+            Some(overlay)
+        );
+        assert!(backend.parsed_uris.read().contains(owner.as_str()));
+        // A separate genuinely unreadable source still makes the index partial.
+        let unrelated = root.join("Unrelated.php");
+        std::fs::write(&unrelated, b"<?php\xff").unwrap();
+        let unrelated_uri = Url::from_file_path(&unrelated).unwrap();
+        backend.parse_paths_parallel_with_progress(&[(unrelated_uri.to_string(), unrelated)], None);
+        assert_eq!(
+            backend.workspace_index_outcome(),
+            WorkspaceIndexOutcome::Partial {
+                unreadable_files: 1,
+                overflow: false
+            }
+        );
+        assert!(
+            backend
+                .workspace_index_outcome
+                .lock()
+                .unreadable
+                .contains(unrelated_uri.as_str())
+        );
+    }
+
+    #[tokio::test]
+    async fn workspace_index_preferred_name_without_current_open_source_is_not_proof() {
+        let directory = tempfile::tempdir().unwrap();
+        let root = directory.path().canonicalize().unwrap();
+        let target = root.join("Target.php");
+        let alias = root.join("Alias.php");
+        std::fs::write(&target, b"<?php\xff").unwrap();
+        std::os::unix::fs::symlink(&target, &alias).unwrap();
+        let backend = Backend::new_test_with_workspace(root, vec![]);
+        let owner = Url::from_file_path(&target).unwrap();
+        let failed = Url::from_file_path(&alias).unwrap();
+        backend.symbols.source_authority.open(owner.as_str());
+        backend.mark_workspace_indexed();
+        // A ledger alias alone (or orphaned open bytes without an accepted
+        // document incarnation) must never suppress an actual read failure.
+        backend
+            .open_files
+            .write()
+            .insert(owner.to_string(), Arc::new("<?php class Orphan {}".into()));
+        backend.parse_paths_parallel_with_progress(&[(failed.to_string(), alias)], None);
+        assert_eq!(
+            backend.workspace_index_outcome(),
+            WorkspaceIndexOutcome::Partial {
+                unreadable_files: 1,
+                overflow: false
+            }
+        );
+    }
+}

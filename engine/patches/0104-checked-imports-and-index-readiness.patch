+#[tokio::test]
+async fn optimize_imports_checked_never_reorders_inline_output_across_php_tag_terminators() {
+    let source = "<?php\nuse stdClass as Zed ?>one<?php ;\nuse DateTimeImmutable as Alpha ?>two<?php ;\nnew Zed; new Alpha;\n";
+    let (_dir, uri) = fixture(source);
+    let backend = create_test_backend();
+    open(&backend, &uri, source, 1).await;
+    match backend
+        .workbench_optimize_imports(params(&uri, source, 1))
+        .await
+    {
+        Ok(result) => {
+            if result.edit.is_some() {
+                assert_eq!(applied(&uri, source, &result, 1), source);
+            }
+        }
+        Err(error) => assert_eq!(error.code, ErrorCode::InvalidRequest),
+    }
+    assert_eq!(
+        std::fs::read_to_string(uri.to_file_path().unwrap()).unwrap(),
+        source
+    );
+}

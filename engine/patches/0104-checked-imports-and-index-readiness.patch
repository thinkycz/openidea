+// Append to proposed preload.rs only AFTER production admission.
+#[cfg(test)]
+mod workspace_index_outcome_tests {
+    use super::*;
+
+    #[test]
+    fn workspace_index_outcome_failure_storage_is_bounded_and_overflow_stays_partial() {
+        let mut state = WorkspaceIndexState::default();
+        for n in 0..4097 {
+            state.retain_failure(&format!("file:///input-{n}.php"));
+        }
+        assert_eq!(state.unreadable.len(), 4096);
+        assert!(state.unreadable_overflow);
+        assert_eq!(
+            state.outcome(),
+            WorkspaceIndexOutcome::Partial {
+                unreadable_files: 4096,
+                overflow: true
+            }
+        );
+        state.retain_failure("file:///input-0.php");
+        assert_eq!(state.unreadable.len(), 4096);
+        assert_eq!(
+            state.outcome().message(),
+            "Workspace index partial: at least 4096 files could not be read"
+        );
+    }
+
+    #[test]
+    fn workspace_index_outcome_running_refresh_never_exposes_complete() {
+        let directory = tempfile::tempdir().unwrap();
+        let backend = Backend::new_test_with_workspace(directory.path().to_path_buf(), Vec::new());
+        assert_eq!(
+            backend.workspace_index_outcome(),
+            WorkspaceIndexOutcome::Unavailable
+        );
+        backend.mark_workspace_indexed();
+        backend
+            .workspace_index_outcome
+            .lock()
+            .retain_failure("file:///failed.php");
+        assert!(!backend.workspace_index_complete());
+        let _lock = backend.workspace_index_lock.lock();
+        let pass = WorkspaceIndexPass::begin(&backend);
+        assert_eq!(
+            backend.workspace_index_outcome(),
+            WorkspaceIndexOutcome::Running
+        );
+        assert!(!backend.workspace_index_complete());
+        assert_eq!(pass.finish(), WorkspaceIndexOutcome::Complete);
+        assert!(backend.workspace_index_complete());
+    }
+
+    #[test]
+    fn workspace_index_outcome_read_errors_distinguish_vanished_from_invalid_utf8() {
+        let dir = tempfile::tempdir().unwrap();
+        assert!(matches!(
+            read_index_path(&dir.path().join("missing.php")),
+            IndexRead::Vanished
+        ));
+        let path = dir.path().join("invalid.php");
+        std::fs::write(&path, b"<?php\xff").unwrap();
+        assert!(matches!(read_index_path(&path), IndexRead::Unavailable));
+        let backend = Backend::new_test();
+        backend.mark_workspace_indexed();
+        let missing = dir.path().join("vanished.php");
+        backend.parse_paths_parallel_with_progress(
+            &[(crate::util::path_to_uri(&missing), missing)],
+            None,
+        );
+        assert!(backend.workspace_index_complete());
+    }
+
+    #[test]
+    fn workspace_index_outcome_only_current_nonopen_failures_are_admitted() {
+        let backend = Backend::new_test();
+        let items = vec![
+            "file:///stale.php".to_owned(),
+            "file:///open.php".to_owned(),
+            "file:///current.php".to_owned(),
+        ];
+        let tickets = items
+            .iter()
+            .map(|uri| backend.index_source_ticket(uri))
+            .collect::<Vec<_>>();
+        backend.diag.documents.lock().retire_index_source(&items[0]);
+        backend
+            .open_files
+            .write()
+            .insert(items[1].clone(), Arc::new("<?php".into()));
+        backend.retain_owned_index_read_failures(
+            &items,
+            &|uri: &String| uri.as_str(),
+            &tickets,
+            vec![0, 1, 2],
+        );
+        let state = backend.workspace_index_outcome.lock();
+        assert_eq!(state.unreadable.len(), 1);
+        assert!(state.unreadable.contains(&items[2]));
+        drop(state);
+        for (uri, ticket) in items.iter().zip(tickets) {
+            backend.release_index_source_ticket(uri, &ticket);
+        }
+    }
+
+    #[tokio::test]
+    async fn workspace_index_outcome_task_failure_remains_failed_until_explicit_new_pass() {
+        let directory = tempfile::tempdir().unwrap();
+        let backend = Backend::new_test_with_workspace(directory.path().to_path_buf(), Vec::new());
+        let worker = backend.clone_for_blocking();
+        let result: Option<()> =
+            crate::server::run_blocking_cancel_safe("index-outcome-test", move || {
+                let _lock = worker.workspace_index_lock.lock();
+                let _pass = WorkspaceIndexPass::begin(&worker);
+                panic!("owned index worker failure");
+            })
+            .await;
+        assert!(result.is_none());
+        assert_eq!(
+            backend.workspace_index_outcome(),
+            WorkspaceIndexOutcome::Failed
+        );
+        assert!(backend.workspace_indexed.load(Ordering::Acquire));
+        assert!(!backend.workspace_index_complete());
+        assert_eq!(
+            backend.ensure_workspace_index_ready_with_progress(None),
+            WorkspaceIndexOutcome::Failed
+        );
+        assert_eq!(
+            backend.ensure_workspace_indexed_with_progress(None),
+            WorkspaceIndexOutcome::Complete
+        );
+    }
+}

+//! Original-template edits from shared CST ownership, never virtual line edits.
+use crate::{
+    Backend,
+    blade::source_map::BladeSourceMap,
+    code_actions::{build_use_directive_deletion_edit, plan_unused_import_deletions},
+    text_position::{LineIndex, utf16_col_to_byte_offset},
+};
+use mago_syntax::{
+    cst::{Block, Function, Method, MethodBody},
+    walker::Walker,
+};
+use sha2::{Digest, Sha256};
+use std::collections::HashSet;
+use tower_lsp::lsp_types::{Position, Range, TextEdit};
+
+const MAX_BYTES: usize = 8 * 1024 * 1024;
+const MAX_RANGES: usize = 10_000;
+const PROOF_BUDGET: usize = 100_000;
+const PREFIX: &str = "<?php\n";
+
+fn offset(text: &str, index: &LineIndex<'_>, position: Position) -> Option<usize> {
+    let start = index.line_start(position.line as usize);
+    let end = index.line_start(position.line as usize + 1);
+    let at = start.checked_add(utf16_col_to_byte_offset(
+        text.get(start..end)?,
+        position.character,
+    ))?;
+    (at <= text.len() && text.is_char_boundary(at) && index.position(at) == position).then_some(at)
+}
+
+/// Verify the complete piecewise mapping, not just two endpoints. All source
+/// bytes and both-direction anchors in the affected interval must agree with
+/// one contiguous original PHP substring; generated helper text is no owner.
+fn mapped_span(
+    template: &str,
+    php: &str,
+    map: &BladeSourceMap,
+    ti: &LineIndex<'_>,
+    pi: &LineIndex<'_>,
+    bytes: std::ops::Range<usize>,
+    budget: &mut usize,
+) -> Option<(usize, usize)> {
+    let (start, end) = (bytes.start, bytes.end);
+    if start >= end || end > template.len() {
+        return None;
+    }
+    let first = ti.position(start);
+    let last = ti.position(end);
+    let ps = offset(php, pi, map.blade_to_php(first))?;
+    let pe = offset(php, pi, map.blade_to_php(last))?;
+    if template.get(start..end)? != php.get(ps..pe)? {
+        return None;
+    }
+    let verify = |b: Position, p: Position| -> Option<()> {
+        let bo = offset(template, ti, b)?;
+        let po = offset(php, pi, p)?;
+        if bo < start
+            || bo > end
+            || po < ps
+            || po > pe
+            || po - ps != bo - start
+            || map.blade_to_php(b) != p
+            || (bo < end && map.try_php_to_blade(p) != Some(b))
+        {
+            return None;
+        }
+        Some(())
+    };
+    for line in first.line..=last.line {
+        if *budget == 0 {
+            return None;
+        }
+        *budget -= 1;
+        let lo = start.max(ti.line_start(line as usize));
+        let hi = end.min(ti.line_start(line as usize + 1));
+        if lo > hi {
+            return None;
+        }
+        for at in [lo, hi] {
+            let b = ti.position(at);
+            verify(b, pi.position(ps.checked_add(at - start)?))?;
+        }
+        if let Some(anchors) = map.adjustments.get(line as usize) {
+            for &(bc, pc) in anchors {
+                if *budget == 0 {
+                    return None;
+                }
+                *budget -= 1;
+                let b = Position::new(line, bc);
+                let p = Position::new(line.checked_add(map.prologue_lines)?, pc);
+                // Check either side so a generated zero-width segment cannot
+                // hide between matching original endpoints.
+                let bo = offset(template, ti, b);
+                let po = offset(php, pi, p);
+                let relevant = bo.is_some_and(|at| start <= at && at < end)
+                    || po.is_some_and(|at| ps <= at && at < pe);
+                if relevant {
+                    verify(b, p)?;
+                }
+            }
+        }
+    }
+    Some((ps, pe))
+}
+
+struct Found {
+    scope: u32,
+    body: Option<(usize, usize)>,
+    duplicate: bool,
+}
+impl Found {
+    fn body(&mut self, body: &Block<'_>) {
+        if self.body.is_some() {
+            self.duplicate = true;
+        }
+        self.body = Some((
+            body.left_brace.end.offset as usize,
+            body.right_brace.start.offset as usize,
+        ));
+    }
+}
+struct FindWrapper;
+impl<'ast, 'arena> Walker<'ast, 'arena, Found> for FindWrapper {
+    fn walk_in_function(&self, node: &'ast Function<'arena>, found: &mut Found) {
+        if crate::atom::bytes_to_str(node.name.value) == crate::blade::WRAPPER_FUNCTION
+            && node.parameter_list.parameters.is_empty()
+            && node.body.left_brace.start.offset == found.scope
+        {
+            found.body(&node.body);
+        }
+    }
+    fn walk_in_method(&self, node: &'ast Method<'arena>, found: &mut Found) {
+        if crate::atom::bytes_to_str(node.name.value) == crate::blade::WRAPPER_FUNCTION
+            && node.parameter_list.parameters.is_empty()
+            && let MethodBody::Concrete(body) = &node.body
+            && body.left_brace.start.offset == found.scope
+        {
+            found.body(body);
+        }
+    }
+}
+
+pub(super) fn plan(
+    backend: &Backend,
+    uri: &str,
+    template: &str,
+    ranges: &[Range],
+) -> Option<Vec<TextEdit>> {
+    if template.len() > MAX_BYTES || ranges.len() > MAX_RANGES {
+        return None;
+    }
+    let removed_lines: HashSet<_> = ranges.iter().map(|r| r.start.line as usize).collect();
+    let mut edits = Vec::new();
+    let mut island_ranges = Vec::new();
+    for range in ranges {
+        if let Some(edit) =
+            build_use_directive_deletion_edit(template, range, &removed_lines, ranges)
+        {
+            edits.push(edit);
+        } else {
+            island_ranges.push(*range);
+        }
+    }
+    if !island_ranges.is_empty() {
+        let php = backend.blade_virtual_php_arc(uri)?;
+        let map = backend.blade_source_maps.read().get(uri).cloned()?;
+        let projection = map.hierarchy_projection?;
+        if php.len() > MAX_BYTES
+            || <[u8; 32]>::from(Sha256::digest(php.as_bytes())) != projection.virtual_sha256
+            || <[u8; 32]>::from(Sha256::digest(template.as_bytes())) != projection.template_sha256
+        {
+            return None;
+        }
+        let body = crate::parser::with_parsed_program(&php, "blade_import_owner", |program, _| {
+            if !program.errors.is_empty() {
+                return None;
+            }
+            let mut found = Found {
+                scope: projection.wrapper_scope_start,
+                body: None,
+                duplicate: false,
+            };
+            for statement in program.statements.iter() {
+                FindWrapper.walk_statement(statement, &mut found);
+            }
+            if found.duplicate { None } else { found.body }
+        })?;
+        // Strip only the producer-owned wrapper braces. The shared planner
+        // now sees real island imports at top level, while generated prologue
+        // imports remain outside this owned body and cannot be edited here.
+        let synthetic = format!("{}{}", PREFIX, php.get(body.0..body.1)?);
+        if synthetic.len() > MAX_BYTES {
+            return None;
+        }
+        let ti = LineIndex::new(template);
+        let pi = LineIndex::new(&php);
+        let si = LineIndex::new(&synthetic);
+        let mut proof = PROOF_BUDGET;
+        let mut projected = Vec::new();
+        for range in island_ranges {
+            let a = offset(template, &ti, range.start)?;
+            let b = offset(template, &ti, range.end)?;
+            let (a, b) = mapped_span(template, &php, &map, &ti, &pi, a..b, &mut proof)?;
+            if a < body.0 || b > body.1 {
+                return None;
+            }
+            projected.push(Range::new(
+                si.position(PREFIX.len() + a - body.0),
+                si.position(PREFIX.len() + b - body.0),
+            ));
+        }
+        let planned = plan_unused_import_deletions(&synthetic, &projected)?;
+        for edit in planned {
+            if !edit.new_text.is_empty() {
+                return None;
+            }
+            let a = offset(&synthetic, &si, edit.range.start)?;
+            let b = offset(&synthetic, &si, edit.range.end)?;
+            // The shared plan may expand into harmless virtual blank lines.
+            // Keep that whitespace in the template: it may represent @endphp
+            // or generated boilerplate rather than user PHP. This only
+            // narrows an already CST-authorized deletion, never adds bytes.
+            let raw = synthetic.get(a..b)?;
+            let trimmed = raw.trim_matches(|c: char| c.is_ascii_whitespace());
+            if trimmed.is_empty() {
+                return None;
+            }
+            let left = raw.len()
+                - raw
+                    .trim_start_matches(|c: char| c.is_ascii_whitespace())
+                    .len();
+            let a = a + left;
+            let b = a + trimmed.len();
+            if a < PREFIX.len() {
+                return None;
+            }
+            let pa = body.0 + a - PREFIX.len();
+            let pb = body.0 + b - PREFIX.len();
+            if pa < body.0 || pb > body.1 {
+                return None;
+            }
+            let ba = map.try_php_to_blade(pi.position(pa))?;
+            let ta = offset(template, &ti, ba)?;
+            let tb = ta.checked_add(pb.checked_sub(pa)?)?;
+            if tb > template.len() || !template.is_char_boundary(tb) {
+                return None;
+            }
+            // The exclusive end can share an anchor with @endphp. Derive it
+            // from byte identity, then prove its forward mapping, rather than
+            // accepting the lossy reverse map's later directive boundary.
+            let bb = ti.position(tb);
+            if mapped_span(template, &php, &map, &ti, &pi, ta..tb, &mut proof)? != (pa, pb) {
+                return None;
+            }
+            edits.push(TextEdit {
+                range: Range::new(ba, bb),
+                new_text: String::new(),
+            });
+        }
+    }
+    // Mixed @use/island batches are atomic: one unmappable diagnostic above
+    // refused the entire plan. Validate all original-coordinate edits jointly.
+    edits.sort_by_key(|e| (e.range.start, e.range.end));
+    edits.dedup_by(|a, b| a.range == b.range);
+    if edits
+        .windows(2)
+        .any(|pair| pair[0].range.end > pair[1].range.start)
+    {
+        return None;
+    }
+    Some(edits)
+}

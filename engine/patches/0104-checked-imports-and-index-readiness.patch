+#[tokio::test]
+async fn optimize_imports_checked_preserves_inline_code_and_used_import_siblings() {
+    for (source, expected) in [
+        (
+            "<?php\nuse stdClass as Spare; $kept = 42;\necho $kept;\n",
+            "<?php\n $kept = 42;\necho $kept;\n",
+        ),
+        (
+            "<?php\nuse stdClass as Spare; use DateTimeImmutable as Clock;\nfunction demo(Clock $clock): Clock { return $clock; }\n",
+            "<?php\n use DateTimeImmutable as Clock;\nfunction demo(Clock $clock): Clock { return $clock; }\n",
+        ),
+        (
+            "<?php\nuse stdClass as Spare, DateTimeImmutable as Clock;\nfunction demo(Clock $clock): Clock { return $clock; }\n",
+            "<?php\nuse DateTimeImmutable as Clock;\nfunction demo(Clock $clock): Clock { return $clock; }\n",
+        ),
+    ] {
+        let (_dir, uri) = fixture(source);
+        let backend = create_test_backend();
+        open(&backend, &uri, source, 1).await;
+        let result = backend
+            .workbench_optimize_imports(params(&uri, source, 1))
+            .await
+            .unwrap();
+        assert_eq!(applied(&uri, source, &result, 1), expected);
+        assert_eq!(
+            std::fs::read_to_string(uri.to_file_path().unwrap()).unwrap(),
+            source
+        );
+    }
+}

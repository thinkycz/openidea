+#[cfg(test)]
+mod workspace_index_rootless_outcome_tests {
+    use super::*;
+
+    #[test]
+    fn workspace_index_outcome_rootless_success_and_unwind_do_not_admit_complete_index() {
+        let backend = Backend::new_test();
+        assert_eq!(
+            backend.workspace_index_outcome(),
+            WorkspaceIndexOutcome::Unavailable
+        );
+        let reports = std::sync::Mutex::new(Vec::new());
+        assert_eq!(
+            backend.ensure_workspace_indexed_with_progress(Some(&|percentage, message| {
+                reports.lock().unwrap().push((percentage, message));
+            })),
+            WorkspaceIndexOutcome::Unavailable
+        );
+        assert_eq!(
+            backend.workspace_index_outcome(),
+            WorkspaceIndexOutcome::Unavailable
+        );
+        assert_eq!(
+            reports
+                .lock()
+                .unwrap()
+                .last()
+                .map(|(_, message)| message.as_str()),
+            Some("Workspace index is not available")
+        );
+        assert!(
+            !reports
+                .lock()
+                .unwrap()
+                .iter()
+                .any(|(_, message)| message == "Workspace index ready")
+        );
+        assert!(!backend.workspace_indexed.load(Ordering::Acquire));
+        assert!(!backend.workspace_index_complete());
+        let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            let _lock = backend.workspace_index_lock.lock();
+            let _pass = WorkspaceIndexPass::begin(&backend);
+            assert_eq!(
+                backend.workspace_index_outcome(),
+                WorkspaceIndexOutcome::Running
+            );
+            panic!("rootless index attempt failed");
+        }));
+        assert!(result.is_err());
+        assert_eq!(
+            backend.workspace_index_outcome(),
+            WorkspaceIndexOutcome::Failed
+        );
+        assert!(!backend.workspace_indexed.load(Ordering::Acquire));
+        assert!(!backend.workspace_index_complete());
+    }
+}

@@ -0,0 +1,401 @@
+//! Public checked Optimize Imports regressions; root owns execution.
+use crate::common::{apply_edits, create_test_backend};
+use phpantom_lsp::{
+    ProjectRouter,
+    workbench_optimize_imports::{OptimizeImportsParams, OptimizeImportsResult},
+    workbench_rename::ExpectedSource,
+};
+use sha2::{Digest, Sha256};
+use tower_lsp::{LanguageServer, jsonrpc::ErrorCode, lsp_types::*};
+
+const BEFORE: &str = "<?php\r\nnamespace Demo;\r\nuse DateTimeZone as Zone;\r\nuse ArrayObject;\r\nuse stdClass as Spare;\r\nuse DateTimeImmutable as Clock;\r\nuse function strrev as UnusedReverse;\r\nuse function strlen;\r\nuse const PHP_VERSION;\r\n// café 🐘\r\nfunction stamp(Clock $clock, Zone $zone): ArrayObject { strlen($clock->format('c')); return new ArrayObject([PHP_VERSION, $zone]); }\r\n";
+const AFTER: &str = "<?php\r\nnamespace Demo;\r\nuse ArrayObject;\r\nuse DateTimeImmutable as Clock;\r\nuse DateTimeZone as Zone;\r\nuse function strlen;\r\nuse const PHP_VERSION;\r\n// café 🐘\r\nfunction stamp(Clock $clock, Zone $zone): ArrayObject { strlen($clock->format('c')); return new ArrayObject([PHP_VERSION, $zone]); }\r\n";
+fn fixture(text: &str) -> (tempfile::TempDir, Url) {
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("source.php");
+    std::fs::write(&path, text).unwrap();
+    (dir, Url::from_file_path(path).unwrap())
+}
+async fn open(server: &impl LanguageServer, uri: &Url, text: &str, version: i32) {
+    server
+        .did_open(DidOpenTextDocumentParams {
+            text_document: TextDocumentItem {
+                uri: uri.clone(),
+                language_id: "php".into(),
+                version,
+                text: text.into(),
+            },
+        })
+        .await;
+}
+fn params(uri: &Url, text: &str, version: i32) -> OptimizeImportsParams {
+    OptimizeImportsParams {
+        expected_source: ExpectedSource {
+            uri: uri.clone(),
+            version,
+            sha256_utf8: format!("{:x}", Sha256::digest(text.as_bytes())),
+        },
+    }
+}
+fn applied(uri: &Url, text: &str, result: &OptimizeImportsResult, version: i32) -> String {
+    assert_eq!(result.source.uri, *uri);
+    assert_eq!(result.source.version, version);
+    assert_eq!(
+        result.source.sha256_utf8,
+        format!("{:x}", Sha256::digest(text.as_bytes()))
+    );
+    let edit = result.edit.as_ref().expect("actual combined edit expected");
+    assert!(edit.changes.is_none());
+    let Some(DocumentChanges::Edits(documents)) = &edit.document_changes else {
+        panic!("only source text edits")
+    };
+    assert_eq!(documents.len(), 1);
+    let document = &documents[0];
+    assert_eq!(document.text_document.uri, *uri);
+    assert_eq!(document.text_document.version, Some(version));
+    let edits: Vec<_> = document
+        .edits
+        .iter()
+        .map(|edit| match edit {
+            OneOf::Left(edit) => edit.clone(),
+            _ => panic!("no annotations/operations"),
+        })
+        .collect();
+    apply_edits(text, &edits)
+}
+#[tokio::test]
+async fn optimize_imports_checked_combines_cleanup_sort_crlf_unicode_and_never_publishes_temporary_source()
+ {
+    let (_dir, uri) = fixture(BEFORE);
+    let backend = create_test_backend();
+    open(&backend, &uri, BEFORE, 0).await;
+    let first = backend
+        .workbench_optimize_imports(params(&uri, BEFORE, 0))
+        .await
+        .unwrap();
+    assert_eq!(applied(&uri, BEFORE, &first, 0), AFTER);
+    let repeated = backend
+        .workbench_optimize_imports(params(&uri, BEFORE, 0))
+        .await
+        .unwrap();
+    assert_eq!(
+        applied(&uri, BEFORE, &repeated, 0),
+        AFTER,
+        "original open source still owns the same hash/version"
+    );
+    assert_eq!(
+        std::fs::read_to_string(uri.to_file_path().unwrap()).unwrap(),
+        BEFORE
+    );
+    backend
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: uri.clone(),
+                version: 1,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: AFTER.into(),
+            }],
+        })
+        .await;
+    assert!(
+        backend
+            .workbench_optimize_imports(params(&uri, AFTER, 1))
+            .await
+            .unwrap()
+            .edit
+            .is_none()
+    );
+}
+#[tokio::test]
+async fn optimize_imports_checked_hash_and_version_refuse_independently_then_fresh_unsaved_source_succeeds()
+ {
+    let (_dir, uri) = fixture(BEFORE);
+    let backend = create_test_backend();
+    open(&backend, &uri, BEFORE, 1).await;
+    let changed = BEFORE.replace("café", "cafè");
+    assert_eq!(changed.len(), BEFORE.len());
+    backend
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: uri.clone(),
+                version: 2,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: changed.clone(),
+            }],
+        })
+        .await;
+    assert_eq!(
+        backend
+            .workbench_optimize_imports(params(&uri, BEFORE, 2))
+            .await
+            .unwrap_err()
+            .code,
+        ErrorCode::ServerError(-32801)
+    );
+    assert_eq!(
+        backend
+            .workbench_optimize_imports(params(&uri, &changed, 1))
+            .await
+            .unwrap_err()
+            .code,
+        ErrorCode::ServerError(-32801)
+    );
+    let reply = backend
+        .workbench_optimize_imports(params(&uri, &changed, 2))
+        .await
+        .unwrap();
+    assert_eq!(
+        applied(&uri, &changed, &reply, 2),
+        AFTER.replace("café", "cafè")
+    );
+    assert_eq!(
+        std::fs::read_to_string(uri.to_file_path().unwrap()).unwrap(),
+        BEFORE
+    );
+}
+#[tokio::test]
+async fn optimize_imports_checked_missing_closed_malformed_and_syntax_error_are_not_noops() {
+    let (_dir, uri) = fixture(BEFORE);
+    let backend = create_test_backend();
+    assert_eq!(
+        backend
+            .workbench_optimize_imports(params(&uri, BEFORE, 1))
+            .await
+            .unwrap_err()
+            .code,
+        ErrorCode::ServerError(-32801)
+    );
+    open(&backend, &uri, BEFORE, 1).await;
+    let mut bad = params(&uri, BEFORE, 1);
+    bad.expected_source.sha256_utf8 = "x".repeat(64);
+    assert_eq!(
+        backend
+            .workbench_optimize_imports(bad)
+            .await
+            .unwrap_err()
+            .code,
+        ErrorCode::InvalidParams
+    );
+    let mut bad = params(&uri, BEFORE, 1);
+    bad.expected_source.uri = Url::parse("https://invalid.example/source.php").unwrap();
+    assert_eq!(
+        backend
+            .workbench_optimize_imports(bad)
+            .await
+            .unwrap_err()
+            .code,
+        ErrorCode::InvalidParams
+    );
+    backend
+        .did_close(DidCloseTextDocumentParams {
+            text_document: TextDocumentIdentifier { uri: uri.clone() },
+        })
+        .await;
+    assert_eq!(
+        backend
+            .workbench_optimize_imports(params(&uri, BEFORE, 1))
+            .await
+            .unwrap_err()
+            .code,
+        ErrorCode::ServerError(-32801)
+    );
+    let broken = "<?php\nuse DateTime;\nfunction {";
+    open(&backend, &uri, broken, 3).await;
+    assert_eq!(
+        backend
+            .workbench_optimize_imports(params(&uri, broken, 3))
+            .await
+            .unwrap_err()
+            .code,
+        ErrorCode::InvalidRequest
+    );
+}
+#[tokio::test]
+async fn optimize_imports_checked_group_member_cleanup_and_trailing_comment_preservation() {
+    let source = "<?php\nnamespace Vendor { class C {} class B {} }\nnamespace App {\nuse Vendor\\{C, B as Bee};\nuse stdClass as Spare; // keep café 🐘\nfunction demo(Bee $b): Bee { return $b; }\n}\n";
+    let (_dir, uri) = fixture(source);
+    let backend = create_test_backend();
+    open(&backend, &uri, source, 1).await;
+    let reply = backend
+        .workbench_optimize_imports(params(&uri, source, 1))
+        .await
+        .unwrap();
+    let result = applied(&uri, source, &reply, 1);
+    assert!(result.contains("use Vendor\\{B as Bee};"));
+    assert!(!result.contains("stdClass"));
+    assert!(result.contains("// keep café 🐘"));
+    assert!(result.contains("function demo(Bee $b): Bee { return $b; }"));
+}

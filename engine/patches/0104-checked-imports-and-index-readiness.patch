@@ -0,0 +1,487 @@
+//! Checked, source-only Optimize Imports; temporary text is never published.
+use crate::diagnostics::use_statements::scan_use_statements;
+use crate::text_position::{offset_to_position, position_to_byte_offset};
+use crate::{Backend, project_router::ProjectRouter, workbench_rename::ExpectedSource};
+use serde::{Deserialize, Serialize};
+use std::{collections::HashSet, sync::Arc};
+use tower_lsp::jsonrpc::{Error, ErrorCode, Result};
+use tower_lsp::lsp_types::{
+    DocumentChanges, OneOf, OptionalVersionedTextDocumentIdentifier, Range, TextDocumentEdit,
+    TextEdit, WorkspaceEdit,
+};
+
+/// Selected-provider protocol name.
+pub const METHOD: &str = "phpWorkbench/optimizeImports";
+/// Capability advertised only when this handler is registered.
+pub const CAPABILITY: &str = "phpWorkbenchOptimizeImports";
+const MAX_BYTES: usize = 8 * 1024 * 1024;
+const MAX_IMPORTS: usize = 10_000;
+
+/// One exact editor-owned source; URI also selects the project authority.
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct OptimizeImportsParams {
+    /// Exact open wire version and unnormalized UTF-8 hash.
+    pub expected_source: ExpectedSource,
+}
+
+/// One immutable source receipt and final proposal, or checked no-op.
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct OptimizeImportsResult {
+    /// Original source that both passes actually checked.
+    pub source: ExpectedSource,
+    /// Final original-coordinate, single-source proposal; None means no change.
+    pub edit: Option<WorkspaceEdit>,
+}
+
+fn changed() -> Error {
+    Error {
+        code: ErrorCode::ServerError(-32801),
+        message: "PHP import source changed or is not open".into(),
+        data: None,
+    }
+}
+fn unsafe_plan(message: &'static str) -> Error {
+    Error {
+        code: ErrorCode::InvalidRequest,
+        message: message.into(),
+        data: None,
+    }
+}
+impl OptimizeImportsParams {
+    fn validate_shape(&self) -> Result<()> {
+        let source = &self.expected_source;
+        if source.uri.as_str().len() > 1024 * 1024
+            || source.uri.scheme() != "file"
+            || source.uri.query().is_some()
+            || source.uri.fragment().is_some()
+            || !source
+                .uri
+                .to_file_path()
+                .is_ok_and(|path| path.is_absolute())
+        {
+            return Err(Error::invalid_params(
+                "Expected an absolute local source URI",
+            ));
+        }
+        if source.sha256_utf8.len() != 64
+            || !source.sha256_utf8.bytes().all(|b| b.is_ascii_hexdigit())
+        {
+            return Err(Error::invalid_params(
+                "sha256Utf8 must contain exactly 64 hexadecimal digits",
+            ));
+        }
+        Ok(())
+    }
+}
+impl ProjectRouter {
+    /// Optimize the same preferred document authority as other source requests.
+    pub async fn workbench_optimize_imports(
+        &self,
+        params: OptimizeImportsParams,
+    ) -> Result<OptimizeImportsResult> {
+        params.validate_shape()?;
+        let _request = self.request_guard().await;
+        let project = self.project_for(&params.expected_source.uri).await?;
+        project.backend.workbench_optimize_imports(params).await
+    }
+}
+impl Backend {
+    /// Compute both passes while source verification and semantics remain held.
+    pub async fn workbench_optimize_imports(
+        &self,
+        params: OptimizeImportsParams,
+    ) -> Result<OptimizeImportsResult> {
+        params.validate_shape()?;
+        let backend = self.clone_for_blocking();
+        crate::server::run_blocking_cancel_safe("optimize_imports", move || {
+            crate::workbench_rename::authority_path(&params.expected_source.uri)
+                .map_err(|_| changed())?;
+            backend.with_prepared_current_semantics(|| {
+                let expected = std::slice::from_ref(&params.expected_source);
+                backend
+                    .verify_rename_sources(expected)
+                    .map_err(|_| changed())?;
+                let uri = params.expected_source.uri.as_str();
+                if backend.is_blade_file(uri) {
+                    return Err(unsafe_plan(
+                        "Optimize Imports requires a PHP source document",
+                    ));
+                }
+                let original = backend
+                    .open_files
+                    .read()
+                    .get(uri)
+                    .cloned()
+                    .ok_or_else(changed)?;
+                let _parse = crate::parser::with_parse_cache_arc(Arc::clone(&original));
+                let final_text = backend.plan_optimized_imports(uri, &original)?;
+                let edit = if final_text.as_str() == original.as_str() {
+                    None
+                } else {
+                    Some(WorkspaceEdit {
+                        document_changes: Some(DocumentChanges::Edits(vec![TextDocumentEdit {
+                            text_document: OptionalVersionedTextDocumentIdentifier {
+                                uri: params.expected_source.uri.clone(),
+                                version: Some(params.expected_source.version),
+                            },
+                            edits: vec![OneOf::Left(TextEdit {
+                                range: Range::new(
+                                    offset_to_position(&original, 0),
+                                    offset_to_position(&original, original.len()),
+                                ),
+                                new_text: final_text,
+                            })],
+                        }])),
+                        ..WorkspaceEdit::default()
+                    })
+                };
+                backend
+                    .verify_rename_sources(expected)
+                    .map_err(|_| changed())?;
+                Ok(OptimizeImportsResult {
+                    source: params.expected_source.clone(),
+                    edit,
+                })
+            })
+        })
+        .await
+        .ok_or_else(Error::internal_error)?
+    }
+
+    fn plan_optimized_imports(&self, uri: &str, original: &str) -> Result<String> {
+        if original.len() > MAX_BYTES {
+            return Err(unsafe_plan("Optimize Imports supports sources up to 8 MiB"));
+        }
+        require_valid_php(original)?;
+        let statements = scan_use_statements(original);
+        if statements.len() > MAX_IMPORTS {
+            return Err(unsafe_plan("Too many import statements"));
+        }
+        if !statements.iter().any(|statement| statement.top_level) {
+            return Ok(original.to_owned());
+        }
+        let map = self
+            .symbol_maps
+            .read()
+            .get(uri)
+            .cloned()
+            .ok_or_else(changed)?;
+        if map.source(original).is_none() {
+            return Err(changed());
+        }
+        let mut diagnostics = Vec::new();
+        self.collect_unused_import_diagnostics(uri, original, &mut diagnostics);
+        if diagnostics.len() > MAX_IMPORTS {
+            return Err(unsafe_plan("Too many unused import edits"));
+        }
+        let all_ranges: Vec<_> = diagnostics
+            .iter()
+            .map(|diagnostic| diagnostic.range)
+            .collect();
+        let edits = crate::code_actions::plan_unused_import_deletions(original, &all_ranges)
+            .ok_or_else(|| unsafe_plan("Import removal ownership could not be proven safely"))?;
+        let intermediate = apply_edits_checked(original, &edits)?;
+        require_valid_php(&intermediate)?;
+        let sorted = sort_surviving_imports(&intermediate)?;
+        require_valid_php(&sorted)?;
+        Ok(sorted)
+    }
+}
+
+fn require_valid_php(text: &str) -> Result<()> {
+    if !crate::parser::with_parsed_program(text, "optimize_imports", |program, _| {
+        program.errors.is_empty()
+    }) {
+        return Err(unsafe_plan(
+            "Resolve PHP syntax errors before optimizing imports",
+        ));
+    }
+    Ok(())
+}
+fn strict_range(text: &str, range: &Range) -> Result<(usize, usize)> {
+    let start = position_to_byte_offset(text, range.start);
+    let end = position_to_byte_offset(text, range.end);
+    if start > end
+        || end > text.len()
+        || !text.is_char_boundary(start)
+        || !text.is_char_boundary(end)
+        || offset_to_position(text, start) != range.start
+        || offset_to_position(text, end) != range.end
+    {
+        return Err(unsafe_plan("Invalid import edit range"));
+    }
+    Ok((start, end))
+}
+fn apply_edits_checked(text: &str, edits: &[TextEdit]) -> Result<String> {
+    let mut spans = edits
+        .iter()
+        .map(|edit| strict_range(text, &edit.range).map(|(a, b)| (a, b, edit.new_text.as_str())))
+        .collect::<Result<Vec<_>>>()?;
+    spans.sort_by_key(|(a, b, _)| (*a, *b));
+    let mut previous = 0;
+    for (start, end, _) in &spans {
+        if *start < previous {
+            return Err(unsafe_plan("Overlapping import edits"));
+        }
+        previous = *end;
+    }
+    let mut result = text.to_owned();
+    for (start, end, replacement) in spans.into_iter().rev() {
+        result.replace_range(start..end, replacement);
+    }
+    Ok(result)
+}
+
+fn namespace_declarations(text: &str) -> Result<HashSet<(usize, usize)>> {
+    use mago_span::HasSpan;
+    use mago_syntax::cst::Statement;
+    fn collect<'a>(
+        statements: impl Iterator<Item = &'a Statement<'a>>,
+        out: &mut HashSet<(usize, usize)>,
+    ) -> Option<()> {
+        for statement in statements {
+            match statement {
+                Statement::Namespace(namespace) => collect(namespace.statements().iter(), out)?,
+                Statement::Use(statement) => {
+                    if out.len() >= MAX_IMPORTS {
+                        return None;
+                    }
+                    let span = statement.span();
+                    out.insert((span.start.offset as usize, span.end.offset as usize));
+                }
+                _ => {}
+            }
+        }
+        Some(())
+    }
+    crate::parser::with_parsed_program(text, "optimize_import_spans", |program, _| {
+        if !program.errors.is_empty() {
+            return None;
+        }
+        let mut result = HashSet::new();
+        collect(program.statements.iter(), &mut result)?;
+        Some(result)
+    })
+    .ok_or_else(|| unsafe_plan("Import declaration ownership could not be proven safely"))
+}
+
+struct Import<'a> {
+    start: usize,
+    end: usize,
+    body: &'a str,
+    ending: &'a str,
+    key: (u8, String),
+}
+fn sort_surviving_imports(text: &str) -> Result<String> {
+    let owners = namespace_declarations(text)?;
+    let statements = scan_use_statements(text);
+    if statements.len() > MAX_IMPORTS {
+        return Err(unsafe_plan("Too many import statements"));
+    }
+    let mut imports = Vec::new();
+    for statement in statements.into_iter().filter(|s| s.top_level) {
+        // A lexer candidate can bridge close/open tags to a later semicolon.
+        // Only the exact CST declaration with an explicit semicolon may move.
+        if !owners.contains(&(statement.keyword_start, statement.statement_end))
+            || text
+                .as_bytes()
+                .get(statement.statement_end.saturating_sub(1))
+                != Some(&b';')
+        {
+            continue;
+        }
+        let start = text[..statement.keyword_start]
+            .rfind('\n')
+            .map_or(0, |at| at + 1);
+        let body_end = statement.end;
+        let mut end = body_end;
+        if text.as_bytes().get(end) == Some(&b'\r') {
+            end += 1;
+        }
+        if text.as_bytes().get(end) == Some(&b'\n') {
+            end += 1;
+        }
+        let prefix = text[..start].strip_suffix('\n').unwrap_or(&text[..start]);
+        let prefix = prefix.strip_suffix('\r').unwrap_or(prefix);
+        let previous = prefix.rsplit('\n').next().unwrap_or("").trim();
+        let leading_comment = previous.starts_with("//")
+            || previous.starts_with('#')
+            || previous.starts_with("/*")
+            || previous.starts_with('*')
+            || previous.ends_with("*/");
+        if leading_comment
+            || !text[start..statement.keyword_start].trim().is_empty()
+            || !text[statement.statement_end..body_end].trim().is_empty()
+        {
+            continue;
+        }
+        let mut name = text[statement.keyword_start + 3..statement.statement_end].trim_start();
+        let first = name.split_whitespace().next().unwrap_or("");
+        let kind = if first.eq_ignore_ascii_case("function") {
+            1
+        } else if first.eq_ignore_ascii_case("const") {
+            2
+        } else {
+            0
+        };
+        if kind != 0 {
+            name = name[first.len()..].trim_start();
+        }
+        let key = name
+            .split(|c: char| c.is_whitespace() || matches!(c, ';' | ',' | '{'))
+            .next()
+            .unwrap_or("")
+            .trim_start_matches('\\');
+        if key.is_empty() || key.starts_with('/') {
+            continue;
+        }
+        imports.push(Import {
+            start,
+            end,
+            body: &text[start..body_end],
+            ending: &text[body_end..end],
+            key: (kind, key.to_ascii_lowercase()),
+        });
+    }
+    let mut edits = Vec::new();
+    let mut at = 0;
+    while at < imports.len() {
+        let mut end = at + 1;
+        while end < imports.len() && imports[end - 1].end == imports[end].start {
+            end += 1;
+        }
+        let run = &imports[at..end];
+        let mut ordered: Vec<_> = run.iter().collect();
+        ordered.sort_by(|a, b| a.key.cmp(&b.key));
+        let mut replacement = String::new();
+        for (slot, entry) in run.iter().zip(ordered) {
+            replacement.push_str(entry.body);
+            replacement.push_str(slot.ending);
+        }
+        if text[run[0].start..run[run.len() - 1].end] != replacement {
+            edits.push(TextEdit {
+                range: Range::new(
+                    offset_to_position(text, run[0].start),
+                    offset_to_position(text, run[run.len() - 1].end),
+                ),
+                new_text: replacement,
+            });
+        }
+        at = end;
+    }
+    apply_edits_checked(text, &edits)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use tower_lsp::lsp_types::Position;
+    #[test]
+    fn optimize_imports_sort_preserves_crlf_alias_group_comments_and_eof() {
+        let before = "<?php\r\nuse Zoo\\{B, /* owned */ A as Alias};\r\nuse Alpha\\One as Other;";
+        let after = "<?php\r\nuse Alpha\\One as Other;\r\nuse Zoo\\{B, /* owned */ A as Alias};";
+        assert_eq!(sort_surviving_imports(before).unwrap(), after);
+        assert_eq!(sort_surviving_imports(after).unwrap(), after);
+    }
+    #[test]
+    fn optimize_imports_sort_respects_comment_blank_namespace_trait_and_closure_boundaries() {
+        let before = "<?php\nnamespace First {\n// owned by Zoo\nuse Zoo\\Z;\nuse Delta\\D;\nuse Beta\\B;\n\nuse Y\\Y; // attached\nuse X\\X;\ntrait T {} class C { use T; }\n$f=function() use ($x) {};\n}\nnamespace Second {\nuse D\\D;\nuse A\\A;\n}\n";
+        let after = before
+            .replace("use Delta\\D;\nuse Beta\\B;", "use Beta\\B;\nuse Delta\\D;")
+            .replace("use D\\D;\nuse A\\A;", "use A\\A;\nuse D\\D;");
+        assert_eq!(sort_surviving_imports(before).unwrap(), after);
+    }
+    #[test]
+    fn optimize_imports_internal_range_validation_rejects_surrogate_and_overlap() {
+        let text = "//🐘\r\n";
+        assert!(strict_range(text, &Range::new(Position::new(0, 3), Position::new(0, 4))).is_err());
+        let edits = [
+            TextEdit {
+                range: Range::new(Position::new(0, 0), Position::new(0, 2)),
+                new_text: String::new(),
+            },
+            TextEdit {
+                range: Range::new(Position::new(0, 1), Position::new(0, 2)),
+                new_text: String::new(),
+            },
+        ];
+        assert!(apply_edits_checked(text, &edits).is_err());
+        assert_eq!(text, "//🐘\r\n");
+    }
+}

+/// Exact declaration ownership, never a line-wide usage exclusion. This also
+/// visits namespace imports in Blade's generated wrapper. Trait composition
+/// uses ClassLikeMember::TraitUse and must remain a real alias reference.
+fn namespace_import_declaration_ranges(content: &str) -> Vec<ByteRange> {
+    use mago_span::HasSpan;
+    use mago_syntax::{
+        cst::{Statement, Terminator},
+        walker::Walker,
+    };
+    struct Declarations;
+    impl<'ast, 'arena> Walker<'ast, 'arena, Vec<ByteRange>> for Declarations {
+        fn walk_in_statement(&self, node: &'ast Statement<'arena>, out: &mut Vec<ByteRange>) {
+            if let Statement::Use(import) = node {
+                // An invented/missing terminator cannot grant exclusion over
+                // the following expression. Other parse errors do not disable
+                // the whole collector or hide independently owned imports.
+                if matches!(import.terminator, Terminator::Missing(_)) {
+                    return;
+                }
+                let span = import.span();
+                out.push((span.start.offset as usize, span.end.offset as usize));
+            }
+        }
+        // Namespace import declarations cannot occur inside expressions.
+        // In particular closure `use ($x)` is not a Statement::Use. Avoid
+        // walking large literal/expression trees just to find declarations.
+        fn walk_expression(
+            &self,
+            _node: &'ast mago_syntax::cst::Expression<'arena>,
+            _out: &mut Vec<ByteRange>,
+        ) {
+        }
+    }
+    crate::parser::with_parsed_program(content, "unused_import_declaration_owners", |program, _| {
+        let mut ranges = Vec::new();
+        for statement in program.statements.iter() {
+            Declarations.walk_statement(statement, &mut ranges);
+        }
+        ranges.retain(|&(a, b)| {
+            a < b
+                && b <= content.len()
+                && content.is_char_boundary(a)
+                && content.is_char_boundary(b)
+        });
+        ranges.sort_unstable();
+        ranges.dedup();
+        ranges
+    })
+}

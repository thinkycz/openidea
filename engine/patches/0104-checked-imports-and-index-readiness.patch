+#[cfg(test)]
+mod pending_source_tests {
+    use super::*;
+    use sha2::{Digest, Sha256};
+    use tower_lsp::{LanguageServer, lsp_types::*};
+    #[tokio::test]
+    async fn optimize_imports_checked_reconciles_real_pending_source_before_unused_analysis() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("pending.php");
+        let before = "<?php\nuse DateTimeImmutable;\nfunction demo() {}\n";
+        let after = "<?php\nuse DateTimeImmutable;\nfunction demo(DateTimeImmutable $value): DateTimeImmutable { return $value; }\n";
+        std::fs::write(&path, before).unwrap();
+        let uri = Url::from_file_path(path).unwrap();
+        let backend = Backend::new_test();
+        backend
+            .did_open(DidOpenTextDocumentParams {
+                text_document: TextDocumentItem {
+                    uri: uri.clone(),
+                    language_id: "php".into(),
+                    version: 1,
+                    text: before.into(),
+                },
+            })
+            .await;
+        // Actual didChange publication boundary, before the parser worker: the
+        // current wire source is committed while old semantic maps remain.
+        let text = Arc::new(after.to_owned());
+        {
+            let _merge = backend.index_merge_gate.lock();
+            let mut documents = backend.diag.documents.lock();
+            assert!(documents.change(uri.as_str(), 2, &text));
+            backend
+                .open_files
+                .write()
+                .insert(uri.to_string(), Arc::clone(&text));
+            let revision = documents
+                .capture_source(uri.as_str(), &text)
+                .unwrap()
+                .unwrap();
+            assert!(!documents.parsed(uri.as_str(), Some(&revision)));
+        }
+        let result = backend
+            .workbench_optimize_imports(OptimizeImportsParams {
+                expected_source: ExpectedSource {
+                    uri: uri.clone(),
+                    version: 2,
+                    sha256_utf8: format!("{:x}", Sha256::digest(after.as_bytes())),
+                },
+            })
+            .await
+            .unwrap();
+        assert!(result.edit.is_none(), "the now-used import must survive");
+        let documents = backend.diag.documents.lock();
+        let revision = documents
+            .capture_source(uri.as_str(), &text)
+            .unwrap()
+            .unwrap();
+        assert!(documents.parsed(uri.as_str(), Some(&revision)));
+        assert!(
+            backend
+                .symbol_maps
+                .read()
+                .get(uri.as_str())
+                .unwrap()
+                .source(after)
+                .is_some()
+        );
+        assert_eq!(
+            std::fs::read_to_string(uri.to_file_path().unwrap()).unwrap(),
+            before
+        );
+    }
+}

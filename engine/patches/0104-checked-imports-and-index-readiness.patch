+/// Plan unused-import removals from exact CST statement/member owners. No
+/// source outside a diagnosed member/declaration can be consumed as a line.
+pub(crate) fn plan_unused_import_deletions(
+    content: &str,
+    ranges: &[Range],
+) -> Option<Vec<TextEdit>> {
+    use crate::text_position::{LineIndex, utf16_col_to_byte_offset};
+    use mago_span::HasSpan;
+    use mago_syntax::cst::{Statement, UseItems};
+    use std::collections::HashMap;
+    const LIMIT: usize = 10_000;
+    if content.len() > 8 * 1024 * 1024 || ranges.len() > LIMIT {
+        return None;
+    }
+    struct Owner {
+        start: usize,
+        end: usize,
+        members: Vec<(usize, usize)>,
+    }
+    fn collect<'a>(
+        statements: impl Iterator<Item = &'a Statement<'a>>,
+        owners: &mut Vec<Owner>,
+        members: &mut usize,
+    ) -> Option<()> {
+        for statement in statements {
+            match statement {
+                Statement::Namespace(namespace) => {
+                    collect(namespace.statements().iter(), owners, members)?
+                }
+                Statement::Use(statement) => {
+                    let spans: Vec<_> = match &statement.items {
+                        UseItems::Sequence(sequence) => sequence
+                            .items
+                            .iter()
+                            .take(LIMIT + 1)
+                            .map(|item| item.span())
+                            .collect(),
+                        UseItems::TypedSequence(sequence) => sequence
+                            .items
+                            .iter()
+                            .take(LIMIT + 1)
+                            .map(|item| item.span())
+                            .collect(),
+                        UseItems::TypedList(list) => list
+                            .items
+                            .iter()
+                            .take(LIMIT + 1)
+                            .map(|item| item.span())
+                            .collect(),
+                        UseItems::MixedList(list) => list
+                            .items
+                            .iter()
+                            .take(LIMIT + 1)
+                            .map(|item| item.span())
+                            .collect(),
+                    };
+                    *members = members.checked_add(spans.len())?;
+                    if owners.len() >= LIMIT || *members > LIMIT {
+                        return None;
+                    }
+                    let span = statement.span();
+                    owners.push(Owner {
+                        start: span.start.offset as usize,
+                        end: span.end.offset as usize,
+                        members: spans
+                            .into_iter()
+                            .map(|span| (span.start.offset as usize, span.end.offset as usize))
+                            .collect(),
+                    });
+                }
+                _ => {}
+            }
+        }
+        Some(())
+    }
+    let owners =
+        crate::parser::with_parsed_program(content, "unused_import_plan", |program, _| {
+            if !program.errors.is_empty() {
+                return None;
+            }
+            let mut owners = Vec::new();
+            let mut members = 0;
+            collect(program.statements.iter(), &mut owners, &mut members)?;
+            Some(owners)
+        })?;
+    let index = LineIndex::new(content);
+    let offset = |position: Position| {
+        let start = index.line_start(position.line as usize);
+        let end = index.line_start(position.line as usize + 1);
+        let line = content.get(start..end)?;
+        let at = start.checked_add(utf16_col_to_byte_offset(line, position.character))?;
+        (at <= content.len() && content.is_char_boundary(at) && index.position(at) == position)
+            .then_some(at)
+    };
+    let mut lookup = HashMap::new();
+    let mut removed: Vec<Vec<bool>> = owners
+        .iter()
+        .map(|owner| vec![false; owner.members.len()])
+        .collect();
+    for (owner_index, owner) in owners.iter().enumerate() {
+        if owner.start >= owner.end || owner.end > content.len() {
+            return None;
+        }
+        // Canonical diagnostics highlight the whole declaration when it has
+        // exactly one member, and the exact member otherwise.
+        if owner.members.len() == 1
+            && lookup
+                .insert((owner.start, owner.end), (owner_index, 0))
+                .is_some()
+        {
+            return None;
+        }
+        for (member_index, &span) in owner.members.iter().enumerate() {
+            if span.0 < span.1 && owner.start <= span.0 && span.1 <= owner.end {
+                if lookup.insert(span, (owner_index, member_index)).is_some() {
+                    return None;
+                }
+            } else {
+                return None;
+            }
+        }
+    }
+    let mut original_ranges = HashMap::new();
+    for range in ranges {
+        let span = (offset(range.start)?, offset(range.end)?);
+        let &(owner, member) = lookup.get(&span)?;
+        removed[owner][member] = true;
+        original_ranges.entry(owner).or_insert(range);
+    }
+    let removed_lines: HashSet<usize> = ranges
+        .iter()
+        .map(|range| range.start.line as usize)
+        .collect();
+    let comment = |text: &str| text.contains("//") || text.contains("/*") || text.contains('#');
+    let mut edits = Vec::new();
+    for (owner_index, owner) in owners.iter().enumerate() {
+        let mask = &removed[owner_index];
+        if !mask.iter().any(|removed| *removed) {
+            continue;
+        }
+        if mask.iter().all(|removed| *removed) {
+            // Closing-tag terminators are execution boundaries, not removable
+            // declaration punctuation. Refuse rather than consuming a tag.
+            if content.as_bytes().get(owner.end - 1) != Some(&b';') {
+                return None;
+            }
+            if comment(&content[owner.start..owner.end]) {
+                return None;
+            }
+            let range = *original_ranges.get(&owner_index)?;
+            let raw = build_line_deletion_edit(content, range, &removed_lines, ranges);
+            let (raw_start, raw_end) = (offset(raw.range.start)?, offset(raw.range.end)?);
+            let only_trivia = raw_start <= owner.start
+                && owner.end <= raw_end
+                && content
+                    .get(raw_start..owner.start)?
+                    .bytes()
+                    .all(|byte| byte.is_ascii_whitespace())
+                && content
+                    .get(owner.end..raw_end)?
+                    .bytes()
+                    .all(|byte| byte.is_ascii_whitespace());
+            let (start, end) = if only_trivia {
+                (raw_start, raw_end)
+            } else {
+                (owner.start, owner.end)
+            };
+            edits.push(TextEdit {
+                range: Range::new(index.position(start), index.position(end)),
+                new_text: String::new(),
+            });
+        } else {
+            for (member, &is_removed) in mask.iter().enumerate() {
+                if !is_removed {
+                    continue;
+                }
+                let span = owner.members[member];
+                let (start, end) = if mask[..member].contains(&false) {
+                    (owner.members[member - 1].1, span.1)
+                } else {
+                    (span.0, owner.members.get(member + 1)?.0)
+                };
+                if start > span.0
+                    || end < span.1
+                    || start < owner.start
+                    || end > owner.end
+                    || comment(&content[start..end])
+                {
+                    return None;
+                }
+                // Apart from this exact member, consume only its separator and
+                // whitespace; a neighboring used member is never part of it.
+                if !content[start..span.0]
+                    .bytes()
+                    .chain(content[span.1..end].bytes())
+                    .all(|byte| byte.is_ascii_whitespace() || byte == b',')
+                {
+                    return None;
+                }
+                edits.push(TextEdit {
+                    range: Range::new(index.position(start), index.position(end)),
+                    new_text: String::new(),
+                });
+            }
+        }
+    }
+    edits.sort_by_key(|edit| (edit.range.start, edit.range.end));
+    edits.dedup_by(|a, b| a.range == b.range);
+    // Raw blank-line policies may overlap only after each deletion has
+    // independently proved its declaration/member and surrounding trivia.
+    let mut merged: Vec<TextEdit> = Vec::new();
+    for edit in edits {
+        if let Some(previous) = merged.last_mut()
+            && previous.range.end >= edit.range.start
+        {
+            previous.range.end = previous.range.end.max(edit.range.end);
+        } else {
+            merged.push(edit);
         }
     }
+    Some(merged)
 }
 

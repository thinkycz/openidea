+//! Exercise actual legacy code-action resolve and CLI planning without disk writes.
+use crate::common::{
+    apply_edits, create_test_backend, extract_edits, find_action, find_action_containing,
+    get_code_actions_at, resolve_action,
+};
+use std::sync::Arc;
+const URI: &str = "file:///owned-import.php";
+fn legacy(source: &str, single: bool) -> String {
+    let backend = create_test_backend();
+    backend.update_ast(URI, source);
+    let actions = get_code_actions_at(&backend, URI, source, 1, 4);
+    let action = if single {
+        find_action_containing(&actions, "Remove unused import")
+    } else {
+        find_action(&actions, "Remove all unused imports")
+    }
+    .expect("actual unused-import action");
+    let resolved = resolve_action(&backend, URI, source, action);
+    apply_edits(source, &extract_edits(&resolved))
+}
+#[test]
+fn unused_import_ownership_legacy_bulk_and_single_preserve_same_line_assignment() {
+    let source = "<?php\nuse stdClass as Spare; $kept = 42;\necho $kept;\n";
+    let expected = "<?php\n $kept = 42;\necho $kept;\n";
+    assert_eq!(legacy(source, false), expected);
+    assert_eq!(legacy(source, true), expected);
+}
+#[test]
+fn unused_import_ownership_legacy_preserves_used_second_statement_and_comma_member() {
+    for (source, expected) in [
+        (
+            "<?php\nuse stdClass as Spare; use DateTimeImmutable as Clock;\nfunction demo(Clock $clock): Clock { return $clock; }\n",
+            "<?php\n use DateTimeImmutable as Clock;\nfunction demo(Clock $clock): Clock { return $clock; }\n",
+        ),
+        (
+            "<?php\nuse stdClass as Spare, DateTimeImmutable as Clock;\nfunction demo(Clock $clock): Clock { return $clock; }\n",
+            "<?php\nuse DateTimeImmutable as Clock;\nfunction demo(Clock $clock): Clock { return $clock; }\n",
+        ),
+    ] {
+        assert_eq!(legacy(source, false), expected);
+    }
+}
+#[test]
+fn unused_import_ownership_multiple_unused_same_line_are_constrained_before_dedup() {
+    let source =
+        "<?php\nuse stdClass as Spare; use DateTimeZone as Other; $kept = 42;\necho $kept;\n";
+    assert_eq!(legacy(source, false), "<?php\n  $kept = 42;\necho $kept;\n");
+}
+#[test]
+fn unused_import_ownership_preserves_trailing_comment_bytes() {
+    let source = "<?php\nuse stdClass as Spare; // keep café 🐘\necho 1;\n";
+    assert_eq!(legacy(source, false), "<?php\n // keep café 🐘\necho 1;\n");
+}
+#[test]
+fn unused_import_ownership_actual_cli_planner_preserves_code_tags_and_used_members() {
+    for (source, expected) in [
+        (
+            "<?php\nuse stdClass as Spare; $kept = 42;\necho $kept;\n",
+            "<?php\n $kept = 42;\necho $kept;\n",
+        ),
+        (
+            "<?php use stdClass as Spare; $kept = 42;\necho $kept;\n",
+            "<?php  $kept = 42;\necho $kept;\n",
+        ),
+        (
+            "<?php\nuse stdClass as Spare, DateTimeImmutable as Clock;\nfunction demo(Clock $c): Clock { return $c; }\n",
+            "<?php\nuse DateTimeImmutable as Clock;\nfunction demo(Clock $c): Clock { return $c; }\n",
+        ),
+    ] {
+        let backend = create_test_backend();
+        backend.update_ast(URI, source);
+        backend
+            .open_files()
+            .write()
+            .insert(URI.into(), Arc::new(source.into()));
+        let (result, fixes) = phpantom_lsp::fix::fix_unused_imports(&backend, URI, source);
+        assert!(!fixes.is_empty());
+        assert_eq!(result, expected);
+    }
+}
+
+#[test]
+fn unused_import_ownership_single_member_group_accepts_full_statement_diagnostic() {
+    let source = "<?php\nuse App\\Models\\{User};\n";
+    assert_eq!(legacy(source, false), "<?php\n");
+    assert_eq!(legacy(source, true), "<?php\n");
+}
+#[test]
+fn unused_import_ownership_indented_namespace_keeps_exact_statement_identity() {
+    let source = "<?php\nnamespace App {\n    use stdClass as Spare;\n    echo 1;\n}\n";
+    let backend = create_test_backend();
+    backend.update_ast(URI, source);
+    let actions = get_code_actions_at(&backend, URI, source, 2, 8);
+    let action =
+        find_action(&actions, "Remove all unused imports").expect("actual indented import action");
+    let resolved = resolve_action(&backend, URI, source, action);
+    assert_eq!(
+        apply_edits(source, &extract_edits(&resolved)),
+        "<?php\nnamespace App {\n    echo 1;\n}\n"
+    );
+}
+
+#[test]
+fn unused_import_ownership_keeps_used_same_line_aliases() {
+    for source in [
+        "<?php\nuse stdClass as Kept; $value = new Kept;\n",
+        "<?php\n$prefix = 42; use stdClass as Kept; $value = new Kept;\n",
+        "<?php\nuse function strlen as kept_strlen; $value = kept_strlen('abc');\n",
+        "<?php\nuse const PHP_VERSION as KEPT_VERSION; echo KEPT_VERSION;\n",
+    ] {
+        let backend = create_test_backend();
+        backend.update_ast(URI, source);
+        backend
+            .open_files()
+            .write()
+            .insert(URI.into(), Arc::new(source.into()));
+        let (after, fixes) = phpantom_lsp::fix::fix_unused_imports(&backend, URI, source);
+        assert_eq!(
+            after, source,
+            "a real same-line reference must retain its import"
+        );
+        assert!(fixes.is_empty());
+    }
+}

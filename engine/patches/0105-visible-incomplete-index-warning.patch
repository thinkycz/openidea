diff --git a/tests/integration/index_warning.rs b/tests/integration/index_warning.rs
new file mode 100644
index 0000000..ed944e7
--- /dev/null
+++ b/tests/integration/index_warning.rs
@@ -0,0 +1,275 @@
+//! Tests-only first: actual Backend initialization/full-index transport.
+use super::common::lsp_transport::{TransportClient, serve_backend};
+use serde_json::{Value, json};
+use std::time::{Duration, Instant};
+
+const PARTIAL: &str = "PHP workspace indexing finished with partial results. Some PHP files could not be read. Check file permissions and encoding, then restart the PHP language service.";
+
+async fn next(client: &mut TransportClient, deadline: Instant) -> Value {
+    tokio::time::timeout(
+        deadline.saturating_duration_since(Instant::now()),
+        client.read_until("next actual server frame", |_| true),
+    )
+    .await
+    .expect("bounded actual server response")
+}
+
+async fn pump(
+    client: &mut TransportClient,
+    trace: &mut Vec<Value>,
+    what: &str,
+    predicate: impl Fn(&Value) -> bool,
+) {
+    let deadline = Instant::now() + Duration::from_secs(30);
+    loop {
+        let msg = next(client, deadline).await;
+        let done = predicate(&msg);
+        // A real client acknowledges server-initiated progress/refresh requests.
+        // No response, diagnostic, source content or progress event is invented.
+        if msg.get("method").is_some() && msg.get("id").is_some() {
+            client
+                .send(
+                    "acknowledge actual server request",
+                    json!({"jsonrpc":"2.0","id":msg["id"],"result":null}),
+                )
+                .await;
+        }
+        trace.push(msg);
+        if done {
+            return;
+        }
+        assert!(Instant::now() < deadline, "did not observe {what}");
+    }
+}
+
+fn warnings(trace: &[Value]) -> Vec<&Value> {
+    trace
+        .iter()
+        .filter(|m| m["method"] == "window/showMessage" && m["params"]["type"] == 2)
+        .collect()
+}
+
+async fn run_case(progress: bool, unreadable: bool) {
+    let dir = tempfile::tempdir().unwrap();
+    std::fs::create_dir(dir.path().join("src")).unwrap();
+    std::fs::write(
+        dir.path().join("composer.json"),
+        br#"{"name":"owned/index-warning","autoload":{"psr-4":{"IndexWarning\\":"src/"}}}"#,
+    )
+    .unwrap();
+    std::fs::write(dir.path().join(".phpantom.toml"), "[indexing]\nstrategy = \"full\"\n[phpstan]\ncommand = \"\"\n[phpcs]\ncommand = \"\"\n[phpmd]\ncommand = \"\"\n[mago]\ncommand = \"\"\n[formatting]\nphp-cs-fixer = \"\"\nphpcbf = \"\"\npint = \"\"\n").unwrap();
+    let valid = b"<?php\nnamespace IndexWarning; final class Seed {}\n";
+    std::fs::write(dir.path().join("src/Seed.php"), valid).unwrap();
+    // Portable real read_to_string failure; works for root CI and Windows too.
+    let bad: &[u8] = if unreadable {
+        b"<?php\n\xff\xfe\n"
+    } else {
+        b"<?php\nnamespace IndexWarning; final class Good {}\n"
+    };
+    std::fs::write(dir.path().join("src/Unreadable.php"), bad).unwrap();
+    let driver = dir.path().join("Driver.php");
+    let text = "<?php\nuse IndexWarning\\Seed;\nfunction inspect(Seed $seed): void {}\n";
+    std::fs::write(&driver, text).unwrap();
+    let uri = tower_lsp::lsp_types::Url::from_file_path(dir.path()).unwrap();
+    let mut client = serve_backend();
+    let mut trace = Vec::new();
+    client.send("actual initialize", json!({"jsonrpc":"2.0","id":1,"method":"initialize","params":{"rootUri":uri,"capabilities":{"window":{"workDoneProgress":progress},"workspace":{"codeLens":{"refreshSupport":true}}}}})).await;
+    pump(&mut client, &mut trace, "initialize response", |m| {
+        m.get("method").is_none() && m["id"] == 1
+    })
+    .await;
+    client
+        .send(
+            "actual initialized",
+            json!({"jsonrpc":"2.0","method":"initialized","params":{}}),
+        )
+        .await;
+    // This exact real pipeline sends codeLens/refresh AFTER the complete
+    // full-index attempt's End/notice. No wall-clock silence is used as proof.
+    pump(
+        &mut client,
+        &mut trace,
+        "full-index completion refresh",
+        |m| m["method"] == "workspace/codeLens/refresh",
+    )
+    .await;
+    let first = warnings(&trace);
+    if unreadable {
+        assert_eq!(
+            first.len(),
+            1,
+            "a finished partial startup must be visible independently of progress support: {trace:#?}"
+        );
+        assert_eq!(first[0]["params"]["message"], PARTIAL);
+        assert!(
+            !first[0]["params"]["message"]
+                .as_str()
+                .unwrap()
+                .contains(dir.path().to_string_lossy().as_ref())
+        );
+    } else {
+        assert!(
+            first.is_empty(),
+            "a complete index must not warn: {trace:#?}"
+        );
+    }
+    if progress {
+        let end = trace
+            .iter()
+            .position(|m| {
+                m["method"] == "$/progress"
+                    && m["params"]["token"]
+                        .as_str()
+                        .is_some_and(|s| s.starts_with("phpantom/full-index"))
+                    && m["params"]["value"]["kind"] == "end"
+            })
+            .expect("actual full-index End");
+        if unreadable {
+            assert_eq!(
+                trace[end]["params"]["value"]["message"],
+                "Workspace index partial: 1 file could not be read"
+            );
+            let notice = trace
+                .iter()
+                .position(|m| m["method"] == "window/showMessage" && m["params"]["type"] == 2)
+                .unwrap();
+            assert!(
+                notice > end,
+                "transient progress ends before the historical warning"
+            );
+        }
+    } else {
+        assert!(
+            !trace
+                .iter()
+                .any(|m| m["method"] == "window/workDoneProgress/create"
+                    || m["method"] == "$/progress"),
+            "no progress requests without capability"
+        );
+    }
+    let driver_uri = tower_lsp::lsp_types::Url::from_file_path(&driver).unwrap();
+    client.send("open readable source", json!({"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":driver_uri,"languageId":"php","version":1,"text":text}}})).await;
+    // Real references() calls ensure_workspace_indexed_for_request. The
+    // already-finished cached attempt must not trigger another startup notice.
+    for id in [20, 21] {
+        client.send("actual cached-index reference request",json!({"jsonrpc":"2.0","id":id,"method":"textDocument/references","params":{"textDocument":{"uri":driver_uri},"position":{"line":2,"character":18},"context":{"includeDeclaration":true}}})).await;
+        pump(&mut client, &mut trace, "references response", |m| {
+            m.get("method").is_none() && m["id"] == id
+        })
+        .await;
+        assert_eq!(
+            warnings(&trace).len(),
+            if unreadable { 1 } else { 0 },
+            "cached requests must not repeat the warning"
+        );
+    }
+    client
+        .send(
+            "normal shutdown",
+            json!({"jsonrpc":"2.0","id":99,"method":"shutdown","params":null}),
+        )
+        .await;
+    pump(&mut client, &mut trace, "shutdown response", |m| {
+        m.get("method").is_none() && m["id"] == 99
+    })
+    .await;
+    client
+        .send(
+            "normal exit",
+            json!({"jsonrpc":"2.0","method":"exit","params":null}),
+        )
+        .await;
+    assert_eq!(warnings(&trace).len(), if unreadable { 1 } else { 0 });
+    assert_eq!(
+        std::fs::read(dir.path().join("src/Seed.php")).unwrap(),
+        valid
+    );
+    assert_eq!(
+        std::fs::read(dir.path().join("src/Unreadable.php")).unwrap(),
+        bad
+    );
+    assert_eq!(std::fs::read_to_string(driver).unwrap(), text);
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn index_warning_partial_with_progress() {
+    run_case(true, true).await;
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn index_warning_partial_without_progress() {
+    run_case(false, true).await;
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn index_warning_complete_with_progress_no_warning() {
+    run_case(true, false).await;
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn index_warning_complete_without_progress_no_warning() {
+    run_case(false, false).await;
+}
+
+async fn rootless_case(progress: bool) {
+    let mut client = serve_backend();
+    let mut trace = Vec::new();
+    client.send("rootless initialize",json!({"jsonrpc":"2.0","id":1,"method":"initialize","params":{"capabilities":{"window":{"workDoneProgress":progress},"workspace":{"codeLens":{"refreshSupport":true}}}}})).await;
+    pump(
+        &mut client,
+        &mut trace,
+        "rootless initialize response",
+        |m| m.get("method").is_none() && m["id"] == 1,
+    )
+    .await;
+    client
+        .send(
+            "rootless initialized",
+            json!({"jsonrpc":"2.0","method":"initialized","params":{}}),
+        )
+        .await;
+    pump(
+        &mut client,
+        &mut trace,
+        "rootless initialization notice",
+        |m| m["method"] == "window/logMessage" && m["params"]["message"] == "PHPantom initialized!",
+    )
+    .await;
+    client.send("scratch open",json!({"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"untitled:OwnedScratch.php","languageId":"php","version":1,"text":"<?php function scratch(): void {}"}}})).await;
+    client.send("rootless symbol barrier",json!({"jsonrpc":"2.0","id":20,"method":"workspace/symbol","params":{"query":"scratch"}})).await;
+    pump(&mut client, &mut trace, "rootless request response", |m| {
+        m.get("method").is_none() && m["id"] == 20
+    })
+    .await;
+    client
+        .send(
+            "rootless shutdown",
+            json!({"jsonrpc":"2.0","id":99,"method":"shutdown","params":null}),
+        )
+        .await;
+    pump(&mut client, &mut trace, "rootless shutdown response", |m| {
+        m.get("method").is_none() && m["id"] == 99
+    })
+    .await;
+    client
+        .send(
+            "rootless exit",
+            json!({"jsonrpc":"2.0","method":"exit","params":null}),
+        )
+        .await;
+    assert!(
+        warnings(&trace).is_empty(),
+        "a rootless/scratch session has no finished workspace attempt: {trace:#?}"
+    );
+    assert!(!trace.iter().any(|m| {
+        m["method"] == "$/progress"
+            && m["params"]["token"]
+                .as_str()
+                .is_some_and(|s| s.starts_with("phpantom/full-index"))
+    }));
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn index_warning_rootless_scratch_with_progress_has_no_warning() {
+    rootless_case(true).await;
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn index_warning_rootless_scratch_without_progress_has_no_warning() {
+    rootless_case(false).await;
+}

+    /// Historical completion notice, not a current/global readiness authority.
+    /// Never include source paths, file contents, raw errors, or project data.
+    async fn notify_full_index_outcome(
+        &self,
+        outcome: Option<crate::indexing::preload::WorkspaceIndexOutcome>,
+    ) {
+        use crate::indexing::preload::WorkspaceIndexOutcome;
+        let message = match outcome {
+            Some(WorkspaceIndexOutcome::Partial { .. }) => {
+                "PHP workspace indexing finished with partial results. Some PHP files could not be read. Check file permissions and encoding, then restart the PHP language service."
+            }
+            Some(WorkspaceIndexOutcome::Failed) | None => {
+                "PHP workspace indexing did not finish. Some results may be incomplete. Restart the PHP language service."
+            }
+            Some(
+                WorkspaceIndexOutcome::Complete
+                | WorkspaceIndexOutcome::Unavailable
+                | WorkspaceIndexOutcome::Running,
+            ) => return,
+        };
+        if let Some(client) = &self.client {
+            client.show_message(MessageType::WARNING, message).await;
+        }
+    }

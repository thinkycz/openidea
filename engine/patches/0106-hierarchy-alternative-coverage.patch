diff --git a/src/definition/member/coverage.rs b/src/definition/member/coverage.rs
new file mode 100644
index 0000000000000000000000000000000000000000..933da0b025541cb47e8c1ef89187f9ec3bd22c61
--- /dev/null
+++ b/src/definition/member/coverage.rs
@@ -0,0 +1,652 @@
+//! Account for the alternatives retained by the existing receiver inference.
+//! This module does not infer types, load classes, inspect source or cache state.
+use std::sync::Arc;
+
+use crate::php_type::{PhpType, TypeKind};
+use crate::types::{AccessKind, ClassInfo, ResolvedType};
+
+/// Whether every inferred receiver alternative has an authoritative declaration.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum ReceiverCoverage {
+    /// All independent receiver alternatives are covered.
+    Complete,
+    /// At least one receiver alternative has no authoritative declaration.
+    Unresolved,
+    /// A finite accounting budget prevented complete inspection.
+    Limited,
+}
+
+const MAX_NODES: usize = 256;
+const MAX_DEPTH: usize = 32;
+const MAX_NAME_BYTES: usize = 65_536;
+
+struct Accounting<'a> {
+    candidates: &'a [Arc<ClassInfo>],
+    successful: &'a [bool],
+    nullsafe: bool,
+    access_kind: AccessKind,
+    qualify: &'a dyn Fn(&str) -> String,
+    nodes_left: usize,
+    name_bytes_left: usize,
+}
+
+/// Evaluate coverage without repeating the receiver's shared inference pass.
+/// Unions represent independent alternatives; intersections constrain one value.
+pub(super) fn receiver_coverage(
+    resolved: &[ResolvedType],
+    candidates: &[Arc<ClassInfo>],
+    successful: &[bool],
+    nullsafe: bool,
+    access_kind: AccessKind,
+    qualify: &dyn Fn(&str) -> String,
+) -> ReceiverCoverage {
+    if resolved.is_empty() || candidates.len() != successful.len() {
+        return ReceiverCoverage::Unresolved;
+    }
+    if resolved.len() > MAX_NODES || candidates.len() > MAX_NODES {
+        return ReceiverCoverage::Limited;
+    }
+    // Bound identity comparisons as well as type-node recursion. With at most
+    //256 candidates and256 nodes there are at most65536 candidate comparisons.
+    let mut candidate_name_bytes = 0usize;
+    for class in candidates {
+        candidate_name_bytes = candidate_name_bytes.saturating_add(class.fqn().len());
+        if candidate_name_bytes > MAX_NAME_BYTES {
+            return ReceiverCoverage::Limited;
+        }
+    }
+    let mut accounting = Accounting {
+        candidates,
+        successful,
+        nullsafe,
+        access_kind,
+        qualify,
+        nodes_left: MAX_NODES,
+        name_bytes_left: MAX_NAME_BYTES,
+    };
+    let mut limited = false;
+    for value in resolved {
+        match accounting.ty(&value.type_string, value.class_info.as_deref(), 0) {
+            ReceiverCoverage::Complete => {}
+            ReceiverCoverage::Unresolved => return ReceiverCoverage::Unresolved,
+            ReceiverCoverage::Limited => limited = true,
+        }
+    }
+    if limited {
+        ReceiverCoverage::Limited
+    } else {
+        ReceiverCoverage::Complete
+    }
+}
+
+impl Accounting<'_> {
+    fn ty(&mut self, ty: &PhpType, actual: Option<&ClassInfo>, depth: usize) -> ReceiverCoverage {
+        if depth >= MAX_DEPTH || self.nodes_left == 0 {
+            return ReceiverCoverage::Limited;
+        }
+        self.nodes_left -= 1;
+        // raw_kind avoids kind()'s recursive template-bound unwrap escaping
+        // this accounting budget. Shape/container wrappers do not grant methods.
+        match ty.raw_kind() {
+            TypeKind::Benevolent(inner) | TypeKind::TemplateParam(_, inner) => {
+                self.ty(inner, actual, depth + 1)
+            }
+            TypeKind::Nullable(inner) => {
+                if !self.nullsafe {
+                    return ReceiverCoverage::Unresolved;
+                }
+                self.ty(inner, actual, depth + 1)
+            }
+            TypeKind::Union(members) => {
+                let mut limited = false;
+                for member in members {
+                    // A class_info attached to a whole union cannot identify
+                    // which residual alternative each member names.
+                    match self.ty(member, None, depth + 1) {
+                        ReceiverCoverage::Complete => {}
+                        ReceiverCoverage::Unresolved => return ReceiverCoverage::Unresolved,
+                        ReceiverCoverage::Limited => limited = true,
+                    }
+                }
+                if limited {
+                    ReceiverCoverage::Limited
+                } else {
+                    ReceiverCoverage::Complete
+                }
+            }
+            TypeKind::Intersection(members) => {
+                let mut limited = false;
+                for member in members {
+                    match self.ty(member, None, depth + 1) {
+                        // One constraint supplying the method covers this
+                        // simultaneous receiver, even if another lacks it.
+                        ReceiverCoverage::Complete => return ReceiverCoverage::Complete,
+                        ReceiverCoverage::Unresolved => {}
+                        ReceiverCoverage::Limited => limited = true,
+                    }
+                }
+                if limited {
+                    ReceiverCoverage::Limited
+                } else {
+                    ReceiverCoverage::Unresolved
+                }
+            }
+            TypeKind::Named(name) => {
+                if name.eq_ignore_ascii_case("null") {
+                    return if self.nullsafe {
+                        ReceiverCoverage::Complete
+                    } else {
+                        ReceiverCoverage::Unresolved
+                    };
+                }
+                if non_receiver_name(name) {
+                    return ReceiverCoverage::Unresolved;
+                }
+                self.named(name, actual)
+            }
+            TypeKind::Generic(generic) => {
+                if non_receiver_name(&generic.name) {
+                    return ReceiverCoverage::Unresolved;
+                }
+                // Generic argument types describe contents/bindings, not
+                // independent receiver values: Box<Missing> is still Box.
+                self.named(&generic.name, actual)
+            }
+            TypeKind::StaticType(bound) | TypeKind::ThisType(bound) => self.named(bound, actual),
+            TypeKind::ClassNameLiteral(inner) => self.ty(inner, None, depth + 1),
+            TypeKind::ClassString(Some(inner)) | TypeKind::InterfaceString(Some(inner))
+                if self.access_kind == AccessKind::DoubleColon =>
+            {
+                self.ty(inner, None, depth + 1)
+            }
+            _ => ReceiverCoverage::Unresolved,
+        }
+    }
+
+    fn named(&mut self, name: &str, actual: Option<&ClassInfo>) -> ReceiverCoverage {
+        if let Some(class) = actual {
+            // Simple class-bearing leaves already have their canonical class.
+            // Requalifying a resolved global name in the caller namespace can
+            // silently redirect identity; use the actual class instead.
+            return self.canonical(&class.fqn());
+        }
+        if name.len() > self.name_bytes_left {
+            return ReceiverCoverage::Limited;
+        }
+        self.name_bytes_left -= name.len();
+        // Source imports take precedence over a coincidentally matching global
+        // name. The caller also preserves already canonical inferred identities.
+        let qualified = (self.qualify)(name);
+        if qualified.len() > self.name_bytes_left {
+            return ReceiverCoverage::Limited;
+        }
+        self.name_bytes_left -= qualified.len();
+        if self.matches_success(&qualified) {
+            ReceiverCoverage::Complete
+        } else {
+            ReceiverCoverage::Unresolved
+        }
+    }
+
+    fn canonical(&mut self, name: &str) -> ReceiverCoverage {
+        if name.len() > self.name_bytes_left {
+            return ReceiverCoverage::Limited;
+        }
+        self.name_bytes_left -= name.len();
+        if self.matches_success(name) {
+            ReceiverCoverage::Complete
+        } else {
+            ReceiverCoverage::Unresolved
+        }
+    }
+
+    fn matches_success(&self, name: &str) -> bool {
+        let canonical = name.trim_start_matches('\\');
+        self.candidates
+            .iter()
+            .zip(self.successful)
+            .any(|(class, successful)| {
+                *successful
+                    && class
+                        .fqn()
+                        .trim_start_matches('\\')
+                        .eq_ignore_ascii_case(canonical)
+            })
+    }
+}
+
+fn non_receiver_name(name: &str) -> bool {
+    let name = name.trim_start_matches('\\');
+    [
+        "mixed",
+        "object",
+        "null",
+        "true",
+        "false",
+        "bool",
+        "boolean",
+        "int",
+        "integer",
+        "float",
+        "double",
+        "real",
+        "string",
+        "numeric-string",
+        "non-empty-string",
+        "literal-string",
+        "class-string",
+        "interface-string",
+        "callable-string",
+        "resource",
+        "closed-resource",
+        "scalar",
+        "numeric",
+        "array-key",
+        "void",
+        "never",
+        "noreturn",
+        "callable",
+        "array",
+        "list",
+        "iterable",
+        "non-empty-array",
+        "non-empty-list",
+    ]
+    .iter()
+    .any(|keyword| name.eq_ignore_ascii_case(keyword))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::atom::atom;
+
+    fn class(fqn: &str) -> Arc<ClassInfo> {
+        let (namespace, name) = fqn
+            .rsplit_once('\\')
+            .map_or((None, fqn), |(namespace, name)| {
+                (Some(atom(namespace)), name)
+            });
+        Arc::new(ClassInfo {
+            name: atom(name),
+            file_namespace: namespace,
+            ..ClassInfo::default()
+        })
+    }
+
+    fn identity(name: &str) -> String {
+        name.to_owned()
+    }
+
+    #[test]
+    fn actual_simple_class_identity_is_not_requalified_in_the_caller_namespace() {
+        let known = class("GlobalKnown");
+        let value =
+            ResolvedType::from_both_arc(PhpType::named(atom("GlobalKnown")), Arc::clone(&known));
+        let forbidden_qualifier = |_: &str| -> String {
+            panic!("already resolved simple class must use actual identity")
+        };
+        assert_eq!(
+            receiver_coverage(
+                &[value],
+                &[known],
+                &[true],
+                false,
+                AccessKind::Arrow,
+                &forbidden_qualifier
+            ),
+            ReceiverCoverage::Complete
+        );
+    }
+
+    #[test]
+    fn union_requires_each_alternative_and_supports_existing_import_qualification() {
+        let known = class("Vendor\\Known");
+        let other = class("Vendor\\Other");
+        let qualify = |name: &str| match name {
+            "KnownAlias" => "Vendor\\Known".to_owned(),
+            "OtherAlias" => "Vendor\\Other".to_owned(),
+            other => format!("Caller\\{other}"),
+        };
+        let hint = PhpType::union(vec![
+            PhpType::named(atom("KnownAlias")),
+            PhpType::named(atom("Missing")),
+        ]);
+        let value = ResolvedType::from_both_arc(hint, Arc::clone(&known));
+        assert_eq!(
+            receiver_coverage(
+                &[value],
+                &[Arc::clone(&known)],
+                &[true],
+                false,
+                AccessKind::Arrow,
+                &qualify
+            ),
+            ReceiverCoverage::Unresolved
+        );
+        let both = ResolvedType::from_type_string(PhpType::union(vec![
+            PhpType::named(atom("KnownAlias")),
+            PhpType::named(atom("OtherAlias")),
+        ]));
+        assert_eq!(
+            receiver_coverage(
+                &[both],
+                &[known, other],
+                &[true, true],
+                false,
+                AccessKind::Arrow,
+                &qualify
+            ),
+            ReceiverCoverage::Complete
+        );
+    }
+
+    #[test]
+    fn fully_qualified_missing_homonym_cannot_be_certified_by_loaded_short_name() {
+        let known = class("Loaded\\Thing");
+        let value = ResolvedType::from_both_arc(
+            PhpType::union(vec![
+                PhpType::named(atom("\\Loaded\\Thing")),
+                PhpType::named(atom("\\Missing\\Thing")),
+            ]),
+            Arc::clone(&known),
+        );
+        assert_eq!(
+            receiver_coverage(
+                &[value],
+                &[known],
+                &[true],
+                false,
+                AccessKind::Arrow,
+                &identity
+            ),
+            ReceiverCoverage::Unresolved
+        );
+    }
+
+    #[test]
+    fn intersection_constraints_are_one_receiver_and_dnf_still_checks_each_union_arm() {
+        let known = class("Known");
+        let marker = class("Marker");
+        let other = class("Other");
+        let intersection = PhpType::intersection(vec![
+            PhpType::named(atom("Known")),
+            PhpType::named(atom("Marker")),
+        ]);
+        let resolved = [
+            ResolvedType::from_both_arc(intersection.clone(), Arc::clone(&known)),
+            ResolvedType::from_both_arc(intersection.clone(), Arc::clone(&marker)),
+        ];
+        assert_eq!(
+            receiver_coverage(
+                &resolved,
+                &[Arc::clone(&known), marker],
+                &[true, false],
+                false,
+                AccessKind::Arrow,
+                &identity
+            ),
+            ReceiverCoverage::Complete
+        );
+        let dnf = ResolvedType::from_type_string(PhpType::union(vec![
+            intersection,
+            PhpType::named(atom("Other")),
+        ]));
+        assert_eq!(
+            receiver_coverage(
+                std::slice::from_ref(&dnf),
+                &[Arc::clone(&known), Arc::clone(&other)],
+                &[true, true],
+                false,
+                AccessKind::Arrow,
+                &identity
+            ),
+            ReceiverCoverage::Complete
+        );
+        assert_eq!(
+            receiver_coverage(
+                &[dnf],
+                &[known, other],
+                &[true, false],
+                false,
+                AccessKind::Arrow,
+                &identity
+            ),
+            ReceiverCoverage::Unresolved
+        );
+    }
+
+    #[test]
+    fn generic_contents_are_not_receiver_alternatives_and_template_bounds_are_respected() {
+        let known = class("Known");
+        let value = ResolvedType::from_both_arc(
+            PhpType::generic("Known", vec![PhpType::named(atom("Missing"))]),
+            Arc::clone(&known),
+        );
+        assert_eq!(
+            receiver_coverage(
+                &[value],
+                &[Arc::clone(&known)],
+                &[true],
+                false,
+                AccessKind::Arrow,
+                &identity
+            ),
+            ReceiverCoverage::Complete
+        );
+        let bounded = ResolvedType::from_both_arc(
+            PhpType::template_param(atom("T"), PhpType::named(atom("Known"))),

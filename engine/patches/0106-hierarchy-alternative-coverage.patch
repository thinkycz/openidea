+const UNPUBLISHED_INDEX_LEAF: &str =
+    "<?php\r\nnamespace SourceReceipt;\r\nfinal class Leaf { public function ping(): void {} }\r\n";
+const UNPUBLISHED_INDEX_CALLER: &str = "<?php\r\nnamespace SourceReceipt;\r\nfinal class Caller { public function run(Leaf $leaf): void { /* café 🐘 */ $leaf->ping(); } }\r\n";
+const UNPUBLISHED_INDEX_BAD: &[u8] = b"<?php\r\n\xff\xfe\r\n";
+const UNPUBLISHED_INDEX_REPAIRED: &[u8] =
+    b"<?php\r\nnamespace SourceReceipt; final class Repaired {}\r\n";
+
+async fn unpublished_index_fixture(
+    excluded: bool,
+) -> (Backend, tempfile::TempDir, Url, Url, Url, CallHierarchyItem) {
+    let (backend, directory) = create_psr4_workspace(
+        r#"{"name":"owned/hierarchy-source-receipt","autoload":{"psr-4":{"SourceReceipt\\":"src/"}}}"#,
+        &[
+            ("src/Leaf.php", UNPUBLISHED_INDEX_LEAF),
+            ("src/Caller.php", UNPUBLISHED_INDEX_CALLER),
+        ],
+    );
+    let root = directory.path().canonicalize().unwrap();
+    let config = if excluded {
+        "[indexing]\nstrategy=\"full\"\nexclude=[\"src/InvalidUTF8.php\"]\n[external_tools]\nenabled=false\n"
+    } else {
+        "[indexing]\nstrategy=\"full\"\n[external_tools]\nenabled=false\n"
+    };
+    std::fs::write(root.join(".phpantom.toml"), config).unwrap();
+    let bad_path = root.join("src/InvalidUTF8.php");
+    std::fs::write(&bad_path, UNPUBLISHED_INDEX_BAD).unwrap();
+    let leaf_uri = Url::from_file_path(root.join("src/Leaf.php")).unwrap();
+    let caller_uri = Url::from_file_path(root.join("src/Caller.php")).unwrap();
+    let bad_uri = Url::from_file_path(&bad_path).unwrap();
+    backend
+        .initialize(InitializeParams {
+            root_uri: Some(Url::from_directory_path(&root).unwrap()),
+            workspace_folders: Some(vec![WorkspaceFolder {
+                uri: Url::from_directory_path(&root).unwrap(),
+                name: "source-receipt".into(),
+            }]),
+            ..Default::default()
+        })
+        .await
+        .unwrap();
+    backend.initialized(InitializedParams {}).await;
+    // Do not open Caller.php or InvalidUTF8.php: the first incoming handler
+    // must use actual workspace discovery/full indexing, not open-file maps.
+    open_php(&backend, &leaf_uri, UNPUBLISHED_INDEX_LEAF).await;
+    let position = noncall_exact_range(UNPUBLISHED_INDEX_LEAF, "function ping()", "ping").start;
+    let mut prepared = prepare_at(&backend, &leaf_uri, position.line, position.character).await;
+    assert_eq!(prepared.len(), 1);
+    let leaf = prepared.remove(0);
+    (backend, directory, leaf_uri, caller_uri, bad_uri, leaf)
+}

+/// Source-only CLASS imports for the exact lexical block at `offset`.
+/// Cached once per exact request-local parsed file, including failure. A None
+/// result is unavailable and must not fall back to the merged import table.
+pub(crate) fn class_source_imports(content: &str, offset: u32) -> Option<Arc<ClassSourceImports>> {
+    let cursor = usize::try_from(offset).ok()?;
+    if cursor > content.len() || !content.is_char_boundary(cursor) {
+        return None;
+    }
+    let content_len = u32::try_from(content.len()).ok()?;
+    // Clone the owning Rc and release the RefCell borrow before parsing or
+    // extraction. Exact equality and eviction remain the existing cache's job.
+    let cached =
+        PARSE_CACHE.with(|cell| cell.borrow().as_ref().and_then(|cache| cache.find(content)));
+    with_parsed_program(content, "class_source_imports", |program, _| {
+        let scopes = match cached.as_ref() {
+            Some(file) => file
+                .class_source_imports
+                .get_or_init(|| class_source_imports::extract(program, content_len))
+                .clone(),
+            None => class_source_imports::extract(program, content_len),
+        }?;
+        Some(scopes.at(offset))
+    })
+}

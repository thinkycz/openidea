+        );
+    }
+
+    #[test]
+    fn class_string_wrappers_are_receivers_only_for_double_colon() {
+        let known = class("Known");
+        let value = ResolvedType::from_type_string(PhpType::class_string(Some(PhpType::named(
+            atom("Known"),
+        ))));
+        assert_eq!(
+            receiver_coverage(
+                std::slice::from_ref(&value),
+                &[Arc::clone(&known)],
+                &[true],
+                false,
+                AccessKind::DoubleColon,
+                &identity
+            ),
+            ReceiverCoverage::Complete
+        );
+        assert_eq!(
+            receiver_coverage(
+                &[value],
+                &[known],
+                &[true],
+                false,
+                AccessKind::Arrow,
+                &identity
+            ),
+            ReceiverCoverage::Unresolved
+        );
+    }
+

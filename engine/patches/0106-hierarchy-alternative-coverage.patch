+#[tokio::test]
+async fn hierarchy_analysis_unpublished_user_source_recovers_after_accepted_disk_repair() {
+    use phpantom_lsp::HierarchyAnalysisState as State;
+    let (backend, directory, leaf_uri, caller_uri, bad_uri, leaf) =
+        unpublished_index_fixture(false).await;
+    let original_receipt = leaf.data.clone();
+    let before = unpublished_index_incoming(&backend, &leaf).await;
+    unpublished_index_assert_known_caller(&before, &caller_uri);
+    unpublished_index_assert_partial(&before, &bad_uri);
+    let repeat = unpublished_index_incoming(&backend, &leaf).await;
+    unpublished_index_assert_known_caller(&repeat, &caller_uri);
+    unpublished_index_assert_partial(&repeat, &bad_uri);
+    assert_eq!(
+        std::fs::read(bad_uri.to_file_path().unwrap()).unwrap(),
+        UNPUBLISHED_INDEX_BAD
+    );
+    std::fs::write(bad_uri.to_file_path().unwrap(), UNPUBLISHED_INDEX_REPAIRED).unwrap();
+    backend
+        .did_change_watched_files(DidChangeWatchedFilesParams {
+            changes: vec![FileEvent {
+                uri: bad_uri.clone(),
+                typ: FileChangeType::CHANGED,
+            }],
+        })
+        .await;
+    let after = unpublished_index_incoming(&backend, &leaf).await;
+    unpublished_index_assert_known_caller(&after, &caller_uri);
+    assert_eq!(after.analysis.state, State::Resolved);
+    assert!(after.analysis.issues.is_empty());
+    assert!(!after.analysis.issues_truncated);
+    assert_eq!(after.items[0].from, before.items[0].from);
+    assert_eq!(after.items[0].from_ranges, before.items[0].from_ranges);
+    assert_eq!(
+        leaf.data, original_receipt,
+        "repair of an unrelated source does not rewrite the prepared leaf receipt"
+    );
+    assert_eq!(
+        std::fs::read_to_string(leaf_uri.to_file_path().unwrap()).unwrap(),
+        UNPUBLISHED_INDEX_LEAF
+    );
+    assert_eq!(
+        std::fs::read_to_string(caller_uri.to_file_path().unwrap()).unwrap(),
+        UNPUBLISHED_INDEX_CALLER
+    );
+    assert_eq!(
+        std::fs::read(directory.path().join("src/InvalidUTF8.php")).unwrap(),
+        UNPUBLISHED_INDEX_REPAIRED
+    );
+    backend.shutdown().await.unwrap();
+}

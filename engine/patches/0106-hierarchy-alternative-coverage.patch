+            assert_eq!(
+                receiver_coverage(
+                    &[value],
+                    &[Arc::clone(&known)],
+                    &[true],
+                    false,
+                    AccessKind::Arrow,
+                    &identity
+                ),
+                ReceiverCoverage::Unresolved
+            );
+        }
+    }
+
+    #[test]
+    fn equivalent_canonical_candidates_and_inherited_location_dedup_keep_success() {
+        let known = class("Space\\Known");
+        let value = ResolvedType::from_type_string(PhpType::named(atom("\\space\\KNOWN")));
+        assert_eq!(
+            receiver_coverage(
+                &[value],
+                &[Arc::clone(&known), known],
+                &[false, true],
+                false,
+                AccessKind::Arrow,
+                &identity
+            ),
+            ReceiverCoverage::Complete
+        );

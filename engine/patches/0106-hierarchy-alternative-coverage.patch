+    let backend = create_test_backend();
+    let uri = Url::parse("file:///type-definition-root-global.php").unwrap();
+    let source = concat!(
+        "<?php\r\n",
+        "namespace {\r\n",
+        "class RootModel {}\r\n",
+        "}\r\n",
+        "namespace Decoy {\r\n",
+        "class RootModel {}\r\n",
+        "}\r\n",
+        "namespace Consumer {\r\n",
+        "use Decoy\\RootModel as RootModel;\r\n",
+        "function native(\\RootModel $nativeValue): void { /* café 🐘 */ $nativeValue; }\r\n",
+        "/** @param \\RootModel $docValue */\r\n",
+        "function documented($docValue): void { $docValue; }\r\n",
+        "}\r\n",
+    );
+    open_php(&backend, &uri, source).await;
+    for (context, token) in [
+        ("$nativeValue;", "$nativeValue"),

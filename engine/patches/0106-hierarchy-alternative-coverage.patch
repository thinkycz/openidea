+        let location = assert_single_location(response, 2);
+        assert_eq!(location.uri, uri);
+        assert_eq!(
+            location.range.start.character, 0,
+            "navigate to the actual global class keyword"
+        );
+    }
+    backend.shutdown().await.unwrap();

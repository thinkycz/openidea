+        );
+        let long_name = PhpType::named(atom(&"x".repeat(MAX_NAME_BYTES + 1)));
+        assert_eq!(
+            receiver_coverage(
+                &[ResolvedType::from_type_string(long_name)],
+                &[],
+                &[],
+                false,
+                AccessKind::Arrow,
+                &identity
+            ),
+            ReceiverCoverage::Limited
+        );
+    }
+}

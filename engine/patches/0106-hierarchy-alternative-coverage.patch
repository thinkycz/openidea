+        // location; successful bits must be captured before location dedup.
+        let left = class("Left");
+        let right = class("Right");
+        let values = [
+            ResolvedType::from_arc(Arc::clone(&left)),
+            ResolvedType::from_arc(Arc::clone(&right)),
+        ];
+        assert_eq!(
+            receiver_coverage(
+                &values,
+                &[left, right],
+                &[true, true],
+                false,
+                AccessKind::Arrow,
+                &identity
+            ),
+            ReceiverCoverage::Complete
+        );
+    }
+
+    #[test]
+    fn static_and_this_bounds_preserve_actual_class_identity() {

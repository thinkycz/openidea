+        );
+        let unknown =
+            ResolvedType::from_type_string(PhpType::template_param(atom("U"), PhpType::mixed()));
+        assert_eq!(
+            receiver_coverage(&[unknown], &[], &[], false, AccessKind::Arrow, &identity),
+            ReceiverCoverage::Unresolved
+        );
+    }
+
+    #[test]
+    fn nullable_short_circuit_is_complete_only_for_nullsafe_access() {
+        let known = class("Known");
+        let nullable = ResolvedType::from_both_arc(
+            PhpType::nullable(PhpType::named(atom("Known"))),
+            Arc::clone(&known),
+        );
+        assert_eq!(
+            receiver_coverage(
+                std::slice::from_ref(&nullable),

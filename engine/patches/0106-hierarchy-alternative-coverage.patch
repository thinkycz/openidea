+fn unpublished_index_assert_known_caller(
+    reply: &phpantom_lsp::HierarchyReply<CallHierarchyIncomingCall>,
+    caller_uri: &Url,
+) {
+    assert_eq!(
+        reply.items.len(),
+        1,
+        "an unpublished peer must not erase the real caller edge"
+    );
+    assert_eq!(reply.items[0].from.uri, *caller_uri);
+    assert_eq!(reply.items[0].from.name, "run");
+    assert_eq!(
+        reply.items[0].from_ranges,
+        [noncall_exact_range(
+            UNPUBLISHED_INDEX_CALLER,
+            "$leaf->ping()",
+            "ping"
+        )]
+    );
+    let data = reply.items[0]
+        .from
+        .data
+        .as_ref()
+        .expect("real current-source caller receipt");
+    assert!(data.get("source_sha256").is_some());
+}
+
+fn unpublished_index_assert_partial(
+    reply: &phpantom_lsp::HierarchyReply<CallHierarchyIncomingCall>,
+    bad_uri: &Url,
+) {
+    use phpantom_lsp::{HierarchyAnalysisState as State, HierarchyIssueKind as Kind};
+    assert_eq!(
+        reply.analysis.state,
+        State::Partial,
+        "a discovered user source rejected before publication cannot certify complete incoming coverage"
+    );
+    assert!(!reply.analysis.issues_truncated);
+    assert!(
+        reply.analysis.issues.iter().any(|issue| {
+            issue.kind == Kind::SourceUnavailable
+                && issue.uri == *bad_uri
+                && issue.range.start <= issue.range.end
+        }),
+        "the current query must identify the admitted unreadable source rather than relying on a past startup warning"
+    );
+}

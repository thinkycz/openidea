+// Optional actual public controls for tests/integration/type_definition.rs.
+// Source-only proposal; root owns execution and existing failure expectations.
+fn rooted_type_position(source: &str, context: &str, token: &str) -> Position {
+    let context_start = source.find(context).expect("unique source context");
+    let relative = source[context_start..context_start + context.len()]
+        .find(token)
+        .unwrap();
+    let offset = context_start + relative;
+    let prefix = &source[..offset];
+    let line = prefix.bytes().filter(|byte| *byte == b'\n').count() as u32;
+    let character = prefix.rsplit('\n').next().unwrap().encode_utf16().count() as u32;
+    Position::new(line, character)
+}

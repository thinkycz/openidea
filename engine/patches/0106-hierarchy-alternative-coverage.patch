+        let known = class("Known");
+        assert_eq!(
+            receiver_coverage(
+                &[ResolvedType::from_arc(Arc::clone(&known))],
+                &[known],
+                &[],
+                false,
+                AccessKind::Arrow,
+                &identity
+            ),
+            ReceiverCoverage::Unresolved
+        );
+        let too_many = vec![ResolvedType::from_type_string(PhpType::mixed()); MAX_NODES + 1];
+        assert_eq!(
+            receiver_coverage(&too_many, &[], &[], false, AccessKind::Arrow, &identity),
+            ReceiverCoverage::Limited
+        );
+        let mut deep = PhpType::named(atom("Known"));
+        for _ in 0..MAX_DEPTH + 1 {
+            deep = PhpType::class_string(Some(deep));
+        }
+        assert_eq!(
+            receiver_coverage(
+                &[ResolvedType::from_type_string(deep)],
+                &[],
+                &[],
+                false,
+                AccessKind::DoubleColon,
+                &identity

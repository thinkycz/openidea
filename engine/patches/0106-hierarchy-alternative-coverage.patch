@@ -0,0 +1,494 @@
+//! Bounded lexical CLASS import headers, owned by the exact parse-cache file.
+
+use std::collections::HashMap;
+use std::sync::Arc;
+
+use mago_span::HasSpan;
+use mago_syntax::cst::*;
+
+use crate::atom::bytes_to_str;
+
+/// CLASS imports belonging to one source namespace block.
+#[derive(Debug, Default)]
+pub(crate) struct ClassSourceImports {
+    pub(crate) namespace: Option<String>,
+    pub(crate) use_map: HashMap<String, String>,
+}
+
+impl ClassSourceImports {
+    /// Expand an actual lexical class alias, preserving qualified suffix bytes.
+    /// Absolute and namespace-relative names never consult source aliases.
+    pub(crate) fn imported_reference(&self, written: &str) -> Option<String> {
+        if written.starts_with('\\') {
+            return None;
+        }
+        let head = written.split('\\').next().unwrap_or(written);
+        if head.eq_ignore_ascii_case("namespace") && written.contains('\\') {
+            return None;
+        }
+        let prefix = self.use_map.get(head).or_else(|| {
+            self.use_map
+                .iter()
+                .find(|(alias, _)| alias.eq_ignore_ascii_case(head))
+                .map(|(_, target)| target)
+        })?;
+        Some(format!("{prefix}{}", &written[head.len()..]))
+    }
+
+    /// Resolve a WRITTEN PHP class name. The result is canonical without `\`.
+    /// Semantic identities must bypass this API or carry a leading root slash.
+    pub(crate) fn resolve_source_reference(&self, written: &str) -> String {
+        if written.starts_with('\\') {
+            return written.trim_start_matches('\\').to_owned();
+        }
+        let name = if written
+            .get(..10)
+            .is_some_and(|prefix| prefix.eq_ignore_ascii_case("namespace\\"))
+        {
+            &written[10..]
+        } else if let Some(imported) = self.imported_reference(written) {
+            return imported;
+        } else {
+            written
+        };
+        match self.namespace.as_deref() {
+            Some(namespace) => format!("{namespace}\\{name}"),
+            None => name.to_owned(),
+        }
+    }
+}
+
+pub(super) struct ClassSourceImportScopes {
+    global: Arc<ClassSourceImports>,
+    blocks: Vec<ClassSourceImportBlock>,
+}
+
+struct ClassSourceImportBlock {
+    start: u32,
+    end: u32,
+    imports: Arc<ClassSourceImports>,
+    includes_end: bool,
+}
+
+impl ClassSourceImportScopes {
+    pub(super) fn at(&self, offset: u32) -> Arc<ClassSourceImports> {
+        self.blocks
+            .iter()
+            .filter(|block| {
+                offset >= block.start
+                    && (offset < block.end || (block.includes_end && offset == block.end))
+            })
+            .min_by_key(|block| block.end.saturating_sub(block.start))
+            .map_or_else(
+                || Arc::clone(&self.global),
+                |block| Arc::clone(&block.imports),
+            )
+    }
+}
+
+struct HeaderBudget {
+    remaining_entries: usize,
+    remaining_name_bytes: usize,
+    lexical_headers: Vec<(u32, u32)>,
+    opaque_statements: Vec<(u32, u32)>,
+}
+
+impl HeaderBudget {
+    fn entry(&mut self) -> Option<()> {
+        self.remaining_entries = self.remaining_entries.checked_sub(1)?;
+        Some(())
+    }
+
+    fn name(&mut self, bytes: usize) -> Option<()> {
+        self.remaining_name_bytes = self.remaining_name_bytes.checked_sub(bytes)?;
+        Some(())
+    }
+}
+
+/// Only namespace/use headers are inspected. Callable and class bodies are opaque.
+pub(super) fn extract(
+    program: &Program<'_>,
+    content_len: u32,
+) -> Option<Arc<ClassSourceImportScopes>> {
+    let mut budget = HeaderBudget {
+        remaining_entries: 4096,
+        remaining_name_bytes: 65_536,
+        lexical_headers: Vec::new(),
+        opaque_statements: Vec::new(),
+    };
+    let mut blocks = Vec::new();
+    let global = collect_scope(
+        program.statements.iter(),
+        None,
+        content_len,
+        0,
+        &mut budget,
+        &mut blocks,
+    )?;
+    for error in program.errors {
+        budget.entry()?;
+        let span = error.span();
+        let start = span.start.offset;
+        let end = span.end.offset;
+        // A malformed header may be absent from the recovered CST. Only errors
+        // strictly inside an existing opaque statement are provably unrelated.
+        if budget
+            .lexical_headers
+            .iter()
+            .any(|&(left, right)| start <= right && end >= left)
+            || !budget
+                .opaque_statements
+                .iter()
+                .any(|&(left, right)| start > left && end <= right)
+        {
+            return None;
+        }
+    }
+    Some(Arc::new(ClassSourceImportScopes { global, blocks }))
+}
+
+fn collect_scope<'a>(
+    statements: impl Iterator<Item = &'a Statement<'a>>,
+    namespace: Option<String>,
+    scope_end: u32,
+    depth: usize,
+    budget: &mut HeaderBudget,
+    blocks: &mut Vec<ClassSourceImportBlock>,
+) -> Option<Arc<ClassSourceImports>> {
+    if depth >= 32 {
+        return None;
+    }
+    let mut headers = Vec::new();
+    for statement in statements {
+        budget.entry()?;
+        headers.push(statement);
+    }
+    let mut imports = ClassSourceImports {
+        namespace,
+        use_map: HashMap::new(),
+    };
+    for (index, statement) in headers.iter().enumerate() {
+        match statement {
+            Statement::Use(statement) => {
+                let span = statement.span();
+                budget
+                    .lexical_headers
+                    .push((span.start.offset, span.end.offset));
+                collect_use(&statement.items, &mut imports.use_map, budget)?;
+            }
+            Statement::Namespace(declaration) => {
+                let namespace = declaration
+                    .name
+                    .as_ref()
+                    .map(|name| bytes_to_str(name.value()));
+                if let Some(namespace) = namespace {
+                    budget.name(namespace.len())?;
+                }
+                let start = declaration.span().start.offset;
+                let header_end = match &declaration.body {
+                    NamespaceBody::BraceDelimited(body) => body.left_brace.end.offset,
+                    NamespaceBody::Implicit(body) => body.terminator.span().end.offset,
+                };
+                budget.lexical_headers.push((start, header_end));
+                let end = match &declaration.body {
+                    NamespaceBody::BraceDelimited(_) => declaration.span().end.offset,
+                    NamespaceBody::Implicit(_) => headers[index + 1..]
+                        .iter()
+                        .find_map(|statement| {
+                            if let Statement::Namespace(next) = statement {
+                                Some(next.span().start.offset)
+                            } else {
+                                None
+                            }
+                        })
+                        .unwrap_or(scope_end),
+                };
+                let child = collect_scope(
+                    declaration.statements().iter(),
+                    namespace.map(str::to_owned),
+                    end,
+                    depth + 1,
+                    budget,
+                    blocks,
+                )?;
+                let includes_end =
+                    matches!(&declaration.body, NamespaceBody::Implicit(_)) && end == scope_end;
+                blocks.push(ClassSourceImportBlock {
+                    start,
+                    end,
+                    imports: child,
+                    includes_end,
+                });
+            }
+            _ => {
+                let span = statement.span();
+                budget
+                    .opaque_statements
+                    .push((span.start.offset, span.end.offset));
+            }
+        }
+    }
+    Some(Arc::new(imports))
+}
+
+fn collect_use(
+    items: &UseItems<'_>,
+    imports: &mut HashMap<String, String>,
+    budget: &mut HeaderBudget,
+) -> Option<()> {
+    match items {
+        UseItems::Sequence(sequence) => {
+            for item in sequence.items.iter() {
+                collect_item(item, None, true, imports, budget)?;
+            }
+        }
+        UseItems::TypedSequence(sequence) => {
+            for item in sequence.items.iter() {
+                collect_item(item, None, false, imports, budget)?;
+            }
+        }
+        UseItems::TypedList(list) => {
+            let prefix = bytes_to_str(list.namespace.value());
+            for item in list.items.iter() {
+                collect_item(item, Some(prefix), false, imports, budget)?;
+            }
+        }
+        UseItems::MixedList(list) => {
+            let prefix = bytes_to_str(list.namespace.value());
+            for item in list.items.iter() {
+                collect_item(
+                    &item.item,
+                    Some(prefix),
+                    item.r#type.is_none(),
+                    imports,
+                    budget,
+                )?;
+            }
+        }
+    }
+    Some(())
+}
+
+fn collect_item(
+    item: &UseItem<'_>,
+    prefix: Option<&str>,
+    is_class: bool,
+    imports: &mut HashMap<String, String>,
+    budget: &mut HeaderBudget,
+) -> Option<()> {
+    budget.entry()?;
+    let raw = bytes_to_str(item.name.value()).trim_start_matches('\\');
+    budget.name(item.name.value().len())?;
+    if let Some(prefix) = prefix {
+        budget.name(prefix.len() + 1)?;
+    }
+    let alias = item
+        .alias
+        .as_ref()
+        .map(|alias| bytes_to_str(alias.identifier.value));
+    if let Some(alias) = alias {
+        budget.name(alias.len())?;
+    }
+    if !is_class {
+        return Some(());
+    }
+    let full = match prefix {
+        Some(prefix) => format!("{}\\{raw}", prefix.trim_start_matches('\\')),
+        None => raw.to_owned(),
+    };
+    let alias = alias.unwrap_or_else(|| crate::util::short_name(&full));
+    if imports
+        .keys()
+        .any(|previous| previous.eq_ignore_ascii_case(alias))
+    {
+        return None;
+    }
+    imports.insert(alias.to_owned(), full);
+    Some(())
+}

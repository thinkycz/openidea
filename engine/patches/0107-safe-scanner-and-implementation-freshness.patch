+
+    #[test]
+    fn watched_reader_survives_concurrent_truncate() {
+        const CHILD: &str = "PHPWB_READER_TRUNCATE_CHILD";
+        if let Some(path) = std::env::var_os(CHILD) {
+            let path = PathBuf::from(path);
+            let bytes = read_for_scan(&path).unwrap();
+            assert_eq!(bytes.len(), 2 * 1024 * 1024);
+            let truncate_path = path.clone();
+            thread::spawn(move || {
+                std::fs::OpenOptions::new()
+                    .write(true)
+                    .open(truncate_path)
+                    .unwrap()
+                    .set_len(0)
+                    .unwrap()
+            })
+            .join()
+            .unwrap();
+            // Actual read after another thread has truncated the file. A live
+            // file mapping can SIGBUS here; a heap snapshot remains readable.
+            assert_eq!(bytes[0], b'A');
+            assert_eq!(bytes[bytes.len() - 1], b'A');
+            drop(bytes);
+            let stop = Arc::new(AtomicBool::new(false));
+            let writer_stop = stop.clone();
+            let writer_path = path.clone();
+            let writer = thread::spawn(move || {
+                while !writer_stop.load(Ordering::Relaxed) {
+                    let mut file = std::fs::OpenOptions::new()
+                        .write(true)
+                        .truncate(true)
+                        .open(&writer_path)
+                        .unwrap();
+                    file.write_all(&vec![b'B'; 512 * 1024]).unwrap();
+                }
+            });
+            for _ in 0..100 {
+                match read_for_scan(&path) {
+                    Ok(snapshot) => {
+                        std::hint::black_box(
+                            snapshot
+                                .iter()
+                                .fold(0u8, |sum, byte| sum.wrapping_add(*byte)),
+                        );
+                    }
+                    Err(error) if error.kind() == std::io::ErrorKind::UnexpectedEof => {}
+                    Err(error) => panic!("unexpected read error: {error}"),
+                }
+            }
+            stop.store(true, Ordering::Relaxed);
+            writer.join().unwrap();
+            return;
+        }
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("peer.php");
+        std::fs::write(&path, vec![b'A'; 2 * 1024 * 1024]).unwrap();
+        // Isolate a SIGBUS from the test runner so an unsafe implementation
+        // yields a normal failing test rather than aborting the whole suite.
+        let child = std::process::Command::new(std::env::current_exe().unwrap())
+            .args([
+                "--exact",
+                "classmap_scanner::read_safety_tests::watched_reader_survives_concurrent_truncate",
+                "--nocapture",
+            ])
+            .env(CHILD, &path)
+            .output()
+            .unwrap();
+        assert!(
+            child.status.success(),
+            "reader child failed: status={} stdout={} stderr={}",
+            child.status,
+            String::from_utf8_lossy(&child.stdout),
+            String::from_utf8_lossy(&child.stderr)
+        );
+    }
+

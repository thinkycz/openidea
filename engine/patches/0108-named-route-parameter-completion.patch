+/// Bind literal route name and the active array to their actual argument roles.
+/// Unlike Artisan's shared array helper, Laravel route calls accept named and
+/// reordered arguments. Do not infer a route from dynamic names or an array
+/// occupying a different parameter slot.
+fn route_name_for_parameter_array(
+    content: &str,
+    paren_open: usize,
+    array_open: usize,
+    cursor_offset: usize,
+    route_name_role: &str,
+    temporary: bool,
+) -> Option<String> {
+    use crate::call_args::{split_named_text_arg, trim_argument_trivia};
+    use crate::text_scan::{ScanStep, find_matching_forward, scan_top_level};
+
+    const MAX_ROUTE_CALL_BYTES: usize = 64 * 1024;
+    let mut scan_end = paren_open
+        .saturating_add(MAX_ROUTE_CALL_BYTES)
+        .min(content.len());
+    while !content.is_char_boundary(scan_end) {
+        scan_end -= 1;
+    }
+    if cursor_offset > scan_end || (cursor_offset == scan_end && scan_end < content.len()) {
+        return None;
+    }
+    // The shared scanner is intentionally not heredoc-aware. Refuse ambiguous
+    // calls rather than treating punctuation in a heredoc/nowdoc as PHP code.
+    let bounded = content.get(paren_open..scan_end)?;
+    let end =
+        find_matching_forward(bounded, 0, b'(', b')').map_or(cursor_offset, |end| paren_open + end);
+    if content.get(paren_open..end)?.contains("<<<") {
+        return None;
+    }
+    let args_start = paren_open.checked_add(1)?;
+    if end < array_open || end > content.len() {
+        return None;
+    }
+    let args = content.get(args_start..end)?;
+    let target = array_open.checked_sub(args_start)?;
+    let mut start = 0;
+    let mut positional = 0;
+    let mut named_seen = false;
+    let mut route_name = None;
+    let mut parameters_seen = false;
+    let mut active_parameters = false;
+    let parameter_position = if temporary { 2 } else { 1 };
+    loop {
+        let remaining = &args[start..];
+        let end = scan_top_level(remaining.as_bytes(), |bytes, offset| {
+            if bytes[offset] == b',' {
+                ScanStep::Stop
+            } else {
+                ScanStep::Skip(1)
+            }
+        })
+        .map_or(args.len(), |offset| start + offset);
+        let argument = trim_argument_trivia(&args[start..end]);
+        if !argument.is_empty() {
+            let (name, value) = split_named_text_arg(argument);
+            let value = trim_argument_trivia(value);
+            let role = if let Some(name) = name {
+                named_seen = true;
+                if name == route_name_role {
+                    Some("route")
+                } else if name == "parameters" {
+                    Some("parameters")
+                } else {
+                    None
+                }
+            } else {
+                if named_seen || value.starts_with("...") {
+                    return None;
+                }
+                let role = if positional == 0 {
+                    Some("route")
+                } else if positional == parameter_position {
+                    Some("parameters")
+                } else {
+                    None
+                };
+                positional += 1;
+                role
+            };
+            if role == Some("route") {
+                if route_name.is_some() {
+                    return None;
+                }
+                route_name = Some(plain_route_name(value)?);
+            }
+            if role == Some("parameters") {
+                if parameters_seen {
+                    return None;
+                }
+                parameters_seen = true;
+                active_parameters = start <= target
+                    && target < end
+                    && std::ptr::eq(value.as_ptr(), content[array_open..].as_ptr());
+            }
+        }
+        if end == args.len() {
+            break;
+        }
+        start = end + 1;
+    }
+    active_parameters
+        .then_some(route_name?)
+        .filter(|name| !name.is_empty())
+}

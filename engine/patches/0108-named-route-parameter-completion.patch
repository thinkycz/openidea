+/// Extend through a plainly closed key only when the following token confirms
+/// that quote is the array key's end. Otherwise retain the old prefix edit.
+fn route_key_edit_end(content: &str, cursor_offset: usize, quote: u8) -> Option<usize> {
+    const MAX_KEY_SUFFIX_BYTES: usize = 4096;
+    let bytes = content.as_bytes();
+    let mut end = cursor_offset
+        .saturating_add(MAX_KEY_SUFFIX_BYTES)
+        .min(bytes.len());
+    while !content.is_char_boundary(end) {
+        end -= 1;
+    }
+    let preceding_slashes = bytes[..cursor_offset]
+        .iter()
+        .rev()
+        .take_while(|&&b| b == b'\\')
+        .count();
+    if preceding_slashes % 2 != 0 {
+        return None;
+    }
+    let mut pos = cursor_offset;
+    while pos < end {
+        match bytes[pos] {
+            b'\n' | b'\r' => return Some(cursor_offset),
+            b'$' if quote == b'"' => return None,
+            b'\\' => {
+                if quote == b'"' && bytes.get(pos + 1) == Some(&b'$') {
+                    return None;
+                }
+                pos = pos.saturating_add(2);
+            }
+            b if b == quote => {
+                let tail = crate::call_args::trim_argument_trivia(&content[pos + 1..end]);
+                if tail.starts_with("=>")
+                    || tail.starts_with(',')
+                    || tail.starts_with(']')
+                    || (end == bytes.len() && tail.is_empty())
+                {
+                    return Some(pos);
+                }
+                return Some(cursor_offset);
+            }
+            _ => pos += 1,
+        }
+    }
+    Some(cursor_offset)
+}
+
+/// Accept a complete plain PHP string literal, without dynamic interpolation.
+fn plain_route_name(value: &str) -> Option<String> {
+    let bytes = value.as_bytes();
+    let quote = *bytes.first()?;
+    if !matches!(quote, b'\'' | b'"') {
+        return None;
+    }
+    let mut pos = 1;
+    while pos < bytes.len() {
+        match bytes[pos] {
+            b'\\' => pos += 2,
+            b'$' if quote == b'"' => return None,
+            b if b == quote => {
+                if !crate::call_args::trim_argument_trivia(&value[pos + 1..]).is_empty() {
+                    return None;
+                }
+                return Some(value[1..pos].to_string());
+            }
+            _ => pos += 1,
+        }
+    }
+    None
 }
 

+//! Named/reordered Laravel route parameter array completion regressions.
+use crate::common::{
+    LARAVEL_SRC_COMPOSER, create_initialized_psr4_workspace, open_php_file, position_after,
+    response_labels,
+};
+use tower_lsp::{LanguageServer, lsp_types::*};
+
+const ROUTES: &str = "<?php use Illuminate\\Support\\Facades\\Route; Route::get('/users/{user}/posts/{post}', 'show')->name('users.posts.show');";
+
+async fn completion_after(body: &str, needle: &str) -> Option<CompletionResponse> {
+    let source = format!(
+        "<?php\nnamespace App;\nuse Illuminate\\Support\\Facades\\URL;\nuse function route as link_to;\nclass Runner {{ function go() {{ {body} }} }}"
+    );
+    let (backend, _dir, _) = create_initialized_psr4_workspace(
+        LARAVEL_SRC_COMPOSER,
+        &[("routes/web.php", ROUTES), ("src/Runner.php", &source)],
+        "routes/web.php",
+    )
+    .await;
+    let uri = open_php_file(&backend, "src/Runner.php").await;
+    backend
+        .completion(CompletionParams {
+            text_document_position: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier { uri },
+                position: position_after(&source, needle),
+            },
+            work_done_progress_params: WorkDoneProgressParams::default(),
+            partial_result_params: PartialResultParams::default(),
+            context: None,
+        })
+        .await
+        .unwrap()
+}
+
+#[tokio::test]
+async fn named_and_reordered_route_arguments_complete_parameter_keys() {
+    for body in [
+        "route(name: 'users.posts.show', parameters: ['us']);",
+        "route(parameters: ['us'], name: 'users.posts.show');",
+        "link_to(parameters: ['us'], name: 'users.posts.show');",
+        "to_route(parameters: ['us'], route: 'users.posts.show');",
+        "URL::temporarySignedRoute(parameters: ['us'], expiration: now(), name: 'users.posts.show');",
+    ] {
+        let labels = response_labels(completion_after(body, "['us").await);
+        assert!(labels.contains(&"user".to_owned()), "{body}: {labels:?}");
+    }
+}
+
+#[tokio::test]
+async fn unrelated_arguments_and_unrelated_methods_do_not_inherit_route_keys() {
+    for body in [
+        "route('users.posts.show', [], ['us']);",
+        "URL::temporarySignedRoute('users.posts.show', ['us'], []);",
+        "$custom->route(name: 'users.posts.show', parameters: ['us']);",
+        "route(name: $dynamic, parameters: ['us']);",
+        "route(name: 'users.posts.show', parameters: nested(['us']));",
+    ] {
+        let labels = response_labels(completion_after(body, "['us").await);
+        assert!(!labels.contains(&"user".to_owned()), "{body}: {labels:?}");
+    }
+}

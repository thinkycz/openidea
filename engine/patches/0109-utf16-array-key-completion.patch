+/// Resolve an LSP UTF-16 column to a scalar index only at an exact character
+/// boundary. A coordinate inside a surrogate pair or past the line is not a
+/// safe edit location.
+fn utf16_column_to_char_index(chars: &[char], column: u32) -> Option<usize> {
+    let mut units = 0u32;
+    for (index, ch) in chars.iter().enumerate() {
+        if units == column {
+            return Some(index);
+        }
+        units = units.checked_add(ch.len_utf16() as u32)?;
+        if units > column {
+            return None;
+        }
+    }
+    (units == column).then_some(chars.len())
 }
 

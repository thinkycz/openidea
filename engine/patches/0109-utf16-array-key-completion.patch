+#[test]
+fn utf16_array_key_detection_and_auto_close_use_real_code_unit_columns() {
+    let source = "<?php\r\n/* 🐘 */ $data['na'];\r\n";
+    let cursor = source.find("['na").unwrap() + "['na".len();
+    let position = crate::text_position::offset_to_position(source, cursor);
+    let ctx = detect_array_key_context(source, position).expect("array key");
+    assert_eq!(ctx.var_name, "$data");
+    assert_eq!(ctx.partial_key, "na");
+    let start = source.find("['na").unwrap() + "['".len();
+    assert_eq!(
+        ctx.key_start_col,
+        crate::text_position::offset_to_position(source, start).character
+    );
+    let backend = Backend::new_test();
+    let (range, trailing) = backend.compute_edit_range(&ctx, source, position);
+    assert_eq!(trailing, 2);
+    assert_eq!(
+        range.start,
+        crate::text_position::offset_to_position(source, start)
+    );
+    assert_eq!(
+        range.end,
+        crate::text_position::offset_to_position(source, cursor + 2)
+    );
+}

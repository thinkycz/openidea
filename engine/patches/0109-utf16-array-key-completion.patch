+#[test]
+fn utf16_array_key_detection_refuses_non_boundary_or_out_of_line_positions() {
+    let source = "<?php\n/* 🐘 */ $data['na'];\n";
+    let emoji = source.find('🐘').unwrap();
+    let before = crate::text_position::offset_to_position(source, emoji);
+    assert!(
+        detect_array_key_context(source, Position::new(before.line, before.character + 1))
+            .is_none()
+    );
+    let end = source.lines().nth(1).unwrap().encode_utf16().count() as u32;
+    assert!(detect_array_key_context(source, Position::new(1, end + 1)).is_none());
+}

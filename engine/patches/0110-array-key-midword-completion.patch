+//! UTF-16 and applied-edit regression coverage for array shape completion.
+use crate::common::create_test_backend;
+use tower_lsp::{LanguageServer, lsp_types::*};
+
+fn unmark(s: &str) -> String {
+    s.replace("<start>", "")
+        .replace("<caret>", "")
+        .replace("<end>", "")
+}
+fn marker_position(marked: &str, marker: &str) -> Position {
+    assert_eq!(marked.matches(marker).count(), 1);
+    let prefix = unmark(&marked[..marked.find(marker).unwrap()]);
+    Position::new(
+        prefix.bytes().filter(|&byte| byte == b'\n').count() as u32,
+        prefix.rsplit('\n').next().unwrap().encode_utf16().count() as u32,
+    )
+}
+fn byte_offset(text: &str, position: Position) -> usize {
+    let mut line = 0;
+    let mut column = 0;
+    for (offset, c) in text.char_indices() {
+        if line == position.line && column == position.character {
+            return offset;
+        }
+        if c == '\n' {
+            line += 1;
+            column = 0;
+        } else {
+            column += c.len_utf16() as u32;
+        }
+    }
+    assert_eq!((line, column), (position.line, position.character));
+    text.len()
+}
+
+async fn complete(marked: &str, label: &str) -> (String, TextEdit) {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///array_utf16.php").unwrap();
+    let source = unmark(marked);
+    backend
+        .did_open(DidOpenTextDocumentParams {
+            text_document: TextDocumentItem {
+                uri: uri.clone(),
+                language_id: "php".into(),
+                version: 1,
+                text: source.clone(),
+            },
+        })
+        .await;
+    let response = backend
+        .completion(CompletionParams {
+            text_document_position: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier { uri },
+                position: marker_position(marked, "<caret>"),
+            },
+            work_done_progress_params: WorkDoneProgressParams::default(),
+            partial_result_params: PartialResultParams::default(),
+            context: None,
+        })
+        .await
+        .unwrap()
+        .expect("completion response");
+    let items = match response {
+        CompletionResponse::Array(items) => items,
+        CompletionResponse::List(list) => list.items,
+    };
+    let item = items
+        .into_iter()
+        .find(|item| item.label == label)
+        .unwrap_or_else(|| panic!("missing {label}"));
+    let Some(CompletionTextEdit::Edit(edit)) = item.text_edit else {
+        panic!("plain edit expected")
+    };
+    (source, edit)
+}
+
+async fn assert_applied(marked: &str, label: &str, expected: &str) {
+    let (source, edit) = complete(marked, label).await;
+    assert_eq!(edit.range.start, marker_position(marked, "<start>"));
+    assert_eq!(edit.range.end, marker_position(marked, "<end>"));
+    let start = byte_offset(&source, edit.range.start);
+    let end = byte_offset(&source, edit.range.end);
+    assert_eq!(
+        format!("{}{}{}", &source[..start], edit.new_text, &source[end..]),
+        expected
+    );
+}
+
+#[tokio::test]
+async fn midkey_server_applied_edits_replace_suffix_for_both_quotes_and_utf16() {
+    for (marked, expected) in [
+        (
+            "<?php\n$_SERVER['<start>REQ<caret>UEST_METHOD']<end>;\n",
+            "<?php\n$_SERVER['REQUEST_METHOD'];\n",
+        ),
+        (
+            "<?php\r\n/* 🐘 */ $_SERVER[\"<start>REQ<caret>UEST_METHOD\"]<end>;\r\n",
+            "<?php\r\n/* 🐘 */ $_SERVER[\"REQUEST_METHOD\"];\r\n",
+        ),
+    ] {
+        assert_applied(marked, "REQUEST_METHOD", expected).await;
+    }
+}
+
+#[tokio::test]
+async fn midkey_shape_applied_edits_replace_suffix_and_preserve_code() {
+    let marked = "<?php\r\n/** @var array{name: string, age: int} $data */\r\n$data = getData();\r\n/* 🐘 */ $data['<start>na<caret>me']<end>; doSomething();\r\n";
+    let expected = "<?php\r\n/** @var array{name: string, age: int} $data */\r\n$data = getData();\r\n/* 🐘 */ $data['name']; doSomething();\r\n";
+    assert_applied(marked, "name", expected).await;
+}

+//! Isolated LSP regression for ordinary PHP expressions in array indices.
+use crate::common::create_test_backend;
+use tower_lsp::{LanguageServer, lsp_types::*};
+
+async fn selected(marked: &str, label: &str) -> (String, CompletionItem) {
+    let (prefix, suffix) = marked.split_once('|').expect("caret marker");
+    let source = format!("{prefix}{suffix}");
+    let position = Position::new(
+        prefix.bytes().filter(|&b| b == b'\n').count() as u32,
+        prefix.rsplit('\n').next().unwrap().encode_utf16().count() as u32,
+    );
+    let backend = create_test_backend();
+    backend.stub_constant_index_mut().insert(
+        "INDEX_REGRESSION_KEY",
+        "<?php const INDEX_REGRESSION_KEY = 1;",
+    );
+    backend.stub_function_index_mut().insert(
+        "index_regression_pick",
+        "<?php function index_regression_pick() {} ",
+    );
+    let uri = Url::parse("file:///unquoted-index-regression.php").unwrap();
+    backend
+        .did_open(DidOpenTextDocumentParams {
+            text_document: TextDocumentItem {
+                uri: uri.clone(),
+                language_id: "php".into(),
+                version: 1,
+                text: source.clone(),
+            },
+        })
+        .await;
+    let response = backend
+        .completion(CompletionParams {
+            text_document_position: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier { uri },
+                position,
+            },
+            work_done_progress_params: WorkDoneProgressParams::default(),
+            partial_result_params: Default::default(),
+            context: None,
+        })
+        .await
+        .unwrap();
+    let items = match response {
+        Some(CompletionResponse::Array(v)) => v,
+        Some(CompletionResponse::List(v)) => v.items,
+        None => vec![],
+    };
+    let item = items
+        .into_iter()
+        .find(|i| i.label == label)
+        .unwrap_or_else(|| panic!("missing {label} at {marked:?}"));
+    (source, item)
+}
+
+// Models the workbench fallback for unqualified identifier items without a
+// server range: replace the entire current word, not only the typed prefix.
+// This is not a test of the host's actual snippet renderer or additional edits.
+fn apply_word_fallback(source: &str, item: &CompletionItem, word: &str) -> String {
+    assert!(
+        item.text_edit.is_none(),
+        "test requires an item without server edit: {item:?}"
+    );
+    assert!(
+        item.additional_text_edits
+            .as_deref()
+            .unwrap_or_default()
+            .is_empty(),
+        "unexpected extra edits: {item:?}"
+    );
+    let start = source.rfind(word).expect("index word");
+    let inserted = item.insert_text.as_deref().unwrap_or(&item.label);
+    let rendered = if item.insert_text_format == Some(InsertTextFormat::SNIPPET) {
+        // The stub has no parameters; reject unhandled snippet constructs.
+        let text = inserted.replace("$0", "").replace("${0}", "");
+        assert!(!text.contains('$'), "unsupported snippet: {inserted}");
+        text
+    } else {
+        inserted.to_string()
+    };
+    format!(
+        "{}{}{}",
+        &source[..start],
+        rendered,
+        &source[start + word.len()..]
+    )
+}
+
+#[tokio::test]
+async fn ordinary_constant_inside_index_is_available_and_replaces_whole_word() {
+    let (source, item) = selected(
+        "<?php\n/* 🐘 */ $lookup[INDEX_REG|RESSION_KEY];\n",
+        "INDEX_REGRESSION_KEY",
+    )
+    .await;
+    assert_eq!(
+        apply_word_fallback(&source, &item, "INDEX_REGRESSION_KEY"),
+        source
+    );
+}
+
+#[tokio::test]
+async fn ordinary_function_inside_index_is_available_and_replaces_whole_word() {
+    let (source, item) = selected(
+        "<?php\n/* 🐘 */ $lookup[index_reg|ression_pick];\n",
+        "index_regression_pick",
+    )
+    .await;
+    let result = apply_word_fallback(&source, &item, "index_regression_pick");
+    assert_eq!(
+        result,
+        "<?php\n/* 🐘 */ $lookup[index_regression_pick()];\n"
+    );
+}

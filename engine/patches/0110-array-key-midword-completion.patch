+/// Extend the edit across a complete static key, but never across an
+/// ambiguous or interpolated suffix. The bound keeps live completion cheap.
+fn safe_key_suffix_units(chars: &[char], cursor: usize, quote: Option<char>) -> Option<usize> {
+    const MAX_SUFFIX_CHARS: usize = 4096;
+    let suffix = chars.get(cursor..)?;
+    if suffix.is_empty() {
+        return Some(0);
+    }
+    let Some(quote) = quote else {
+        return if suffix[0] == ']' { Some(1) } else { None };
+    };
+    // A bracket inside an unclosed quoted key may be literal data.
+    if suffix[0] == ']' {
+        return None;
+    }
+    let mut escaped = false;
+    let mut units = 0usize;
+    for (index, ch) in suffix.iter().copied().enumerate() {
+        if index >= MAX_SUFFIX_CHARS {
+            return None;
+        }
+        units = units.checked_add(ch.len_utf16())?;
+        if escaped {
+            // A narrow grammar avoids crossing PHP punctuation after an
+            // unfinished literal. Ambiguous escapes are not consumed.
+            if ch != quote && ch != '\\' {
+                return None;
+            }
+            escaped = false;
+            continue;
+        }
+        if ch == '\\' {
+            escaped = true;
+            continue;
+        }
+        if ch == quote {
+            let next = suffix.get(index + 1).copied();
+            if next == Some(']') {
+                return units.checked_add(1);
+            }
+            // Existing auto-inserted lone closing quote remains supported;
+            // a suffix followed by other syntax is ambiguous and declined.
+            if index == 0 && matches!(next, None | Some(';')) {
+                return Some(units);
+            }
+            return None;
+        }
+        if !(ch.is_alphanumeric() || ch == '_') {
+            return None;
+        }
+    }
+    None
 }
 

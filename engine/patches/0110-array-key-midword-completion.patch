+/// Escape literal key bytes for the PHP string delimiter being inserted.
+/// Nonprintable controls are refused rather than inventing escape semantics.
+fn escape_literal_key(key: &str, quote: char) -> Option<String> {
+    let mut escaped = String::with_capacity(key.len());
+    for ch in key.chars() {
+        if ch.is_control() {
+            return None;
+        }
+        if ch == '\\' || ch == quote || (quote == '"' && ch == '$') {
+            escaped.push('\\');
+        }
+        escaped.push(ch);
+    }
+    Some(escaped)
+}

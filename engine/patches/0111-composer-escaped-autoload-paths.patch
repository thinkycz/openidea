+//! LSP behavior from a Composer-generated autoload-files entry.
+use crate::common::{complete_labels_at_opened, create_psr4_workspace, open_document};
+use tower_lsp::{LanguageServer, lsp_types::*};
+
+#[tokio::test]
+async fn generated_escaped_autoload_file_is_visible_to_completion_and_definition() {
+    let metadata = include_str!("../fixtures/composer_escaped_generated/autoload_files.php");
+    let helper = "<?php\nfunction quoted_path_helper(): string { return 'ok'; }\n";
+    let content = "<?php\nquoted_path_\nquoted_path_helper();\n";
+    let (backend, dir) = create_psr4_workspace(
+        r#"{"name":"fixture/escaped-paths","autoload":{"files":["app/O'Brien/helpers.php"]}}"#,
+        &[
+            (".phpantom.toml", "[indexing]\nstrategy = \"none\"\n"),
+            ("vendor/composer/autoload_files.php", metadata),
+            ("app/O'Brien/helpers.php", helper),
+        ],
+    );
+    backend.initialized(InitializedParams {}).await;
+    let uri = Url::from_file_path(dir.path().join("consumer.php")).unwrap();
+    open_document(&backend, &uri, "php", content).await;
+    let labels = complete_labels_at_opened(&backend, &uri, 1, "quoted_path_".len() as u32).await;
+    assert!(
+        labels
+            .iter()
+            .any(|label| label.starts_with("quoted_path_helper")),
+        "generated autoload helper must complete: {labels:?}"
+    );
+    let result = backend
+        .goto_definition(GotoDefinitionParams {
+            text_document_position_params: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier { uri },
+                position: Position::new(2, 5),
+            },
+            work_done_progress_params: WorkDoneProgressParams::default(),
+            partial_result_params: PartialResultParams::default(),
+        })
+        .await
+        .unwrap()
+        .expect("helper definition");
+    let locations = match result {
+        GotoDefinitionResponse::Scalar(location) => vec![location],
+        GotoDefinitionResponse::Array(locations) => locations,
+        GotoDefinitionResponse::Link(links) => links
+            .into_iter()
+            .map(|link| Location {
+                uri: link.target_uri,
+                range: link.target_selection_range,
+            })
+            .collect(),
+    };
+    let expected = Url::from_file_path(dir.path().join("app/O'Brien/helpers.php")).unwrap();
+    assert!(
+        locations.iter().any(|location| location.uri == expected),
+        "definition must target decoded path: {locations:?}"
+    );
+}

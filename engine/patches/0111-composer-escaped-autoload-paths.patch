+//! Generated Composer path fixtures plus single-quoted PHP path semantics.
+use phpantom_lsp::composer::{
+    parse_autoload_classmap, parse_autoload_files, parse_autoload_namespaces,
+};
+use std::{fs, path::Path};
+
+fn write(root: &Path, relative: &str, text: &str) {
+    let path = root.join(relative);
+    fs::create_dir_all(path.parent().unwrap()).unwrap();
+    fs::write(path, text).unwrap();
+}
+
+#[test]
+fn generated_composer_files_resolve_escaped_apostrophe_and_ascii_control() {
+    let temp = tempfile::tempdir().unwrap();
+    let root = temp.path();
+    write(
+        root,
+        "app/O'Brien/helpers.php",
+        "<?php function quoted_path_helper() {}\n",
+    );
+    write(
+        root,
+        "app/back/slash/helpers.php",
+        "<?php function ascii_control() {}\n",
+    );
+    write(
+        root,
+        "vendor/composer/autoload_files.php",
+        include_str!("../fixtures/composer_escaped_generated/autoload_files.php"),
+    );
+    let files = parse_autoload_files(root, "vendor");
+    assert!(
+        files.contains(&root.join("app/O'Brien/helpers.php")),
+        "Composer-generated escaped apostrophe must resolve: {files:?}"
+    );
+    assert!(
+        files.contains(&root.join("app/back/slash/helpers.php")),
+        "ordinary Composer-generated path remains valid"
+    );
+}
+
+#[test]
+fn generated_composer_classmap_returns_decoded_source_paths() {
+    let temp = tempfile::tempdir().unwrap();
+    let root = temp.path();
+    write(
+        root,
+        "vendor/composer/autoload_classmap.php",
+        include_str!("../fixtures/composer_escaped_generated/autoload_classmap.php"),
+    );
+    let map = parse_autoload_classmap(root, "vendor");
+    assert_eq!(
+        map.get("Fixture\\Thing"),
+        Some(&root.join("app/O'Brien/Thing.php"))
+    );
+    assert_eq!(
+        map.get("Quoted\\Sample"),
+        Some(&root.join("app/O'Brien/src/Sample.php"))
+    );
+    assert_eq!(
+        map.get("Composer\\InstalledVersions"),
+        Some(&root.join("vendor/composer/InstalledVersions.php"))
+    );
+}
+
+#[test]
+fn synthetic_vendor_paths_decode_only_php_single_quote_escapes() {
+    let temp = tempfile::tempdir().unwrap();
+    let root = temp.path();
+    write(
+        root,
+        "vendor/O'Brien/☕/helpers.php",
+        "<?php function vendor_helper() {}\n",
+    );
+    write(
+        root,
+        "vendor/back\\slash/helpers.php",
+        "<?php function literal_backslash() {}\n",
+    );
+    write(
+        root,
+        "vendor/unknown\\q/helpers.php",
+        "<?php function unknown_escape() {}\n",
+    );
+    write(
+        root,
+        "vendor/composer/autoload_files.php",
+        r#"<?php return array(
+ 'one' => $vendorDir . '/O\'Brien/☕/helpers.php',
+ 'two' => $vendorDir . '/back\\slash/helpers.php',
+ 'three' => $vendorDir . '/unknown\q/helpers.php',
+ 'missing' => $vendorDir . '/O\'Brien/missing.php',
+);"#,
+    );
+    let files = parse_autoload_files(root, "vendor");
+    assert!(files.contains(&root.join("vendor/O'Brien/☕/helpers.php")));
+    assert!(files.contains(&root.join("vendor/back\\slash/helpers.php")));
+    assert!(files.contains(&root.join("vendor/unknown\\q/helpers.php")));
+    assert_eq!(files.len(), 3, "missing paths are still excluded");
+}
+
+#[test]
+fn legacy_psr0_scanner_follows_decoded_apostrophe_directory() {
+    let temp = tempfile::tempdir().unwrap();
+    let root = temp.path();
+    write(
+        root,
+        "legacy/O'Brien/Legacy/Thing.php",
+        "<?php\nclass Legacy_Thing {}\n",
+    );
+    write(
+        root,
+        "vendor/composer/autoload_namespaces.php",
+        r#"<?php return array(
+ 'Legacy_' => array($baseDir . '/legacy/O\'Brien'),
+);"#,
+    );
+    let map = parse_autoload_namespaces(root, "vendor");
+    assert_eq!(
+        map.get("Legacy_Thing"),
+        Some(&root.join("legacy/O'Brien/Legacy/Thing.php"))
+    );
+}

+//! Structural and quote-parity controls for Composer PSR-0 lists.
+use phpantom_lsp::composer::parse_autoload_namespaces;
+use std::{fs, path::Path};
+fn write(root: &Path, relative: &str, content: &str) {
+    let path = root.join(relative);
+    fs::create_dir_all(path.parent().unwrap()).unwrap();
+    fs::write(path, content).unwrap();
+}
+#[test]
+fn missing_extra_and_mismatched_list_closers_never_scan_paths() {
+    let tmp = tempfile::tempdir().unwrap();
+    let root = tmp.path();
+    for (directory, class) in [
+        ("missing", "Missing"),
+        ("extra", "Extra"),
+        ("wrong", "Wrong"),
+        ("valid", "Valid"),
+    ] {
+        write(
+            root,
+            &format!("{directory}/{class}.php"),
+            &format!("<?php class {class} {{}}\n"),
+        );
+    }
+    write(
+        root,
+        "vendor/composer/autoload_namespaces.php",
+        r#"<?php return array(
+ 'Missing_' => array($baseDir . '/missing',
+ 'Extra_' => array($baseDir . '/extra')),
+ 'Wrong_' => array($baseDir . '/wrong'],
+ 'Valid_' => [$baseDir . '/valid'],
+);"#,
+    );
+    let map = parse_autoload_namespaces(root, "vendor");
+    assert!(!map.contains_key("Missing"));
+    assert!(!map.contains_key("Extra"));
+    assert!(!map.contains_key("Wrong"));
+    assert_eq!(map.get("Valid"), Some(&root.join("valid/Valid.php")));
+}
+#[test]
+fn adjacent_escaped_backslash_apostrophe_and_quoted_comma_preserve_paths() {
+    let tmp = tempfile::tempdir().unwrap();
+    let root = tmp.path();
+    write(root, "first/One.php", "<?php class One {}\n");
+    write(root, "vendor/mix\\'s, café/Two.php", "<?php class Two {}\n");
+    write(root, "last/Three.php", "<?php class Three {}\n");
+    write(
+        root,
+        "vendor/composer/autoload_namespaces.php",
+        r#"<?php return array(
+ 'Legacy_' => array($baseDir . '/first', $vendorDir . '/mix\\\'s, café', $baseDir . '/last'),
+);"#,
+    );
+    let map = parse_autoload_namespaces(root, "vendor");
+    assert_eq!(map.get("One"), Some(&root.join("first/One.php")));
+    assert_eq!(
+        map.get("Two"),
+        Some(&root.join("vendor/mix\\'s, café/Two.php"))
+    );
+    assert_eq!(map.get("Three"), Some(&root.join("last/Three.php")));
+}
+
+#[test]
+fn valid_inner_trailing_comma_preserves_both_php_list_syntaxes() {
+    let tmp = tempfile::tempdir().unwrap();
+    let root = tmp.path();
+    write(root, "array/FromArray.php", "<?php class FromArray {}\n");
+    write(root, "short/FromShort.php", "<?php class FromShort {}\n");
+    write(
+        root,
+        "vendor/composer/autoload_namespaces.php",
+        r#"<?php return array(
+ 'Array_' => array($baseDir . '/array',),
+ 'Short_' => [$baseDir . '/short', ],
+);"#,
+    );
+    let map = parse_autoload_namespaces(root, "vendor");
+    assert_eq!(
+        map.get("FromArray"),
+        Some(&root.join("array/FromArray.php"))
+    );
+    assert_eq!(
+        map.get("FromShort"),
+        Some(&root.join("short/FromShort.php"))
+    );
+}
+
+#[test]
+fn leading_or_repeated_commas_and_invalid_closers_are_refused() {
+    let tmp = tempfile::tempdir().unwrap();
+    let root = tmp.path();
+    for (directory, class) in [
+        ("first", "First"),
+        ("second", "Second"),
+        ("badclose", "BadClose"),
+        ("valid", "Valid"),
+    ] {
+        write(
+            root,
+            &format!("{directory}/{class}.php"),
+            &format!("<?php class {class} {{}}\n"),
+        );
+    }
+    write(
+        root,
+        "vendor/composer/autoload_namespaces.php",
+        r#"<?php return array(
+ 'First_' => array(, $baseDir . '/first'),
+ 'Second_' => [$baseDir . '/second',,],
+ 'Bad_' => array($baseDir . '/badclose',],
+ 'Valid_' => array($baseDir . '/valid',),
+);"#,
+    );
+    let map = parse_autoload_namespaces(root, "vendor");
+    for name in ["First", "Second", "BadClose"] {
+        assert!(!map.contains_key(name), "malformed list loaded {name}");
+    }
+    assert_eq!(map.get("Valid"), Some(&root.join("valid/Valid.php")));
+}

+//! PSR-0 directory-list parsing against generated and malformed metadata.
+use phpantom_lsp::composer::parse_autoload_namespaces;
+use std::{fs, path::Path};
+
+fn write(root: &Path, relative: &str, content: &str) {
+    let path = root.join(relative);
+    fs::create_dir_all(path.parent().unwrap()).unwrap();
+    fs::write(path, content).unwrap();
+}
+#[test]
+fn generated_composer_psr0_comma_directory_is_scanned() {
+    let tmp = tempfile::tempdir().unwrap();
+    let root = tmp.path();
+    write(
+        root,
+        "legacy/O,Brien/Legacy/Service.php",
+        "<?php class Legacy_Service {}\n",
+    );
+    write(
+        root,
+        "vendor/composer/autoload_namespaces.php",
+        include_str!("../fixtures/composer_psr0_comma/autoload_namespaces.php"),
+    );
+    let map = parse_autoload_namespaces(root, "vendor");
+    assert_eq!(
+        map.get("Legacy_Service"),
+        Some(&root.join("legacy/O,Brien/Legacy/Service.php")),
+        "generated comma-containing path must be scanned"
+    );
+}
+#[test]
+fn multiple_psr0_directories_respect_quoted_commas_and_escapes() {
+    let tmp = tempfile::tempdir().unwrap();
+    let root = tmp.path();
+    write(root, "first/O,Brien/First.php", "<?php class First {}\n");
+    write(
+        root,
+        "vendor/O'Brien, café/Second.php",
+        "<?php class Second {}\n",
+    );
+    write(root, "last/Third.php", "<?php class Third {}\n");
+    write(
+        root,
+        "vendor/composer/autoload_namespaces.php",
+        r#"<?php return array(
+  'Legacy_' => array($baseDir . '/first/O,Brien', $vendorDir . '/O\'Brien, café', $baseDir . '/last'),
+);"#,
+    );
+    let map = parse_autoload_namespaces(root, "vendor");
+    assert_eq!(
+        map.get("First"),
+        Some(&root.join("first/O,Brien/First.php"))
+    );
+    assert_eq!(
+        map.get("Second"),
+        Some(&root.join("vendor/O'Brien, café/Second.php"))
+    );
+    assert_eq!(map.get("Third"), Some(&root.join("last/Third.php")));
+}
+#[test]
+fn malformed_list_is_ignored_without_partially_scanning_prefixes() {
+    let tmp = tempfile::tempdir().unwrap();
+    let root = tmp.path();
+    write(
+        root,
+        "safe/ShouldNotLoad.php",
+        "<?php class ShouldNotLoad {}\n",
+    );
+    write(root, "valid/Control.php", "<?php class Control {}\n");
+    write(
+        root,
+        "vendor/composer/autoload_namespaces.php",
+        r#"<?php return array(
+ 'Bad_' => array($baseDir . '/safe', $baseDir . '/unclosed),
+ 'Expression_' => array($baseDir . '/safe' . '/other'),
+ 'Good_' => array($baseDir . '/valid'),
+);"#,
+    );
+    let map = parse_autoload_namespaces(root, "vendor");
+    assert!(
+        !map.contains_key("ShouldNotLoad"),
+        "invalid entry must not partially populate the index"
+    );
+    assert_eq!(map.get("Control"), Some(&root.join("valid/Control.php")));
+}

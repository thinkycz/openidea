+// This intentionally accepts only a complete, single-line literal expression.
+// Comment markers inside the string are data, not statement terminators.
+fn parse_literal_require_once(line: &str) -> Option<String> {
+    let rest = line.trim().strip_prefix("require_once")?;
+    let mut rest = rest.trim_start();
+    let parenthesized = rest.starts_with('(');
+    if parenthesized {
+        rest = rest[1..].trim_start();
+    }
+    let from_dir_const = if let Some(after) = rest.strip_prefix("__DIR__") {
+        rest = after.trim_start().strip_prefix('.')?.trim_start();
+        true
+    } else {
+        false
+    };
+    let quote = rest.chars().next()?;
+    if quote != '\'' && quote != '"' {
+        return None;
+    }
+    let mut end = None;
+    let mut escaped = false;
+    for (offset, ch) in rest[1..].char_indices() {
+        if escaped {
+            escaped = false;
+        } else if ch == '\\' {
+            escaped = true;
+        } else if ch == quote {
+            end = Some(offset + 1);
+            break;
+        }
+    }
+    let end = end?;
+    let body = &rest[1..end];
+    let path = if quote == '\'' {
+        unescape_php_single_quoted(body)
+    } else {
+        // Double-quoted PHP strings can contain interpolation and numerous
+        // escape forms. Accept only forms whose static value is unambiguous.
+        let mut out = String::new();
+        let mut chars = body.chars();
+        while let Some(ch) = chars.next() {
+            match ch {
+                '$' => return None,
+                '\\' => match chars.next()? {
+                    '\\' => out.push('\\'),
+                    '"' => out.push('"'),
+                    '$' => out.push('$'),
+                    'n' | 'r' | 't' | 'v' | 'e' | 'f' | 'x' | 'u' | '0'..='7' => return None,
+                    ch => {
+                        out.push('\\');
+                        out.push(ch);
+                    }
+                },
+                _ => out.push(ch),
+            }
+        }
+        out
+    };
+    rest = rest[end + 1..].trim_start();
+    if parenthesized {
+        rest = rest.strip_prefix(')')?.trim_start();
+    }
+    if let Some(after) = rest.strip_prefix(';') {
+        rest = after.trim_start();
+        while let Some(comment) = rest.strip_prefix("/*") {
+            let Some((_, after)) = comment.split_once("*/") else {
+                // The remainder of this line belongs to a multiline comment.
+                rest = "";
+                break;
+            };
+            rest = after.trim_start();
+        }
+        if !rest.is_empty() && !rest.starts_with("//") && !rest.starts_with('#') {
+            return None;
+        }
+    } else if !rest.is_empty() {
+        return None;
+    }
+    let path = if from_dir_const {
+        path.trim_start_matches('/').to_string()
+    } else {
+        path
+    };
+    (!path.is_empty()).then_some(path)
 }
 

+use phpantom_lsp::composer::{extract_require_once_paths, extract_require_once_paths_from_php};
+
+#[test]
+fn require_once_trailing_comments_and_comment_markers_in_literals() {
+    let source = concat!(
+        "require_once __DIR__ . '/extra.php'; // shared\n",
+        "require_once(\"dir/#literal.php\"); # note\n",
+        "require_once 'dir//literal.php'; /* note */\n",
+        "require_once('dir/*literal*/.php'); /* one */ /* two */\n",
+        "require_once 'plain.php';\n",
+        "require_once __DIR__ . '/O\\'Brien.php'; // quoted\n",
+    );
+    assert_eq!(
+        extract_require_once_paths(source),
+        vec![
+            "extra.php",
+            "dir/#literal.php",
+            "dir//literal.php",
+            "dir/*literal*/.php",
+            "plain.php",
+            "O'Brien.php"
+        ]
+    );
+}
+
+#[test]
+fn require_once_refuses_dynamic_or_malformed_statements() {
+    let source = concat!(
+        "require_once 'prefix' . $suffix; // dynamic\n",
+        "require_once('prefix' . '/suffix'); // dynamic\n",
+        "require_once \"$variable.php\"; // interpolated\n",
+        "require_once 'x.php' // missing semicolon\n",
+        "require_once('x.php'; // missing parenthesis\n",
+        "require_once_suffix 'x.php'; // not the keyword\n",
+        "require_once 'unterminated; // not a comment\n",
+    );
+    assert!(extract_require_once_paths(source).is_empty());
+}
+
+#[test]
+fn ignores_require_lines_in_multiline_comments_strings_and_heredocs() {
+    let source = concat!(
+        "/* begin\n",
+        "require_once 'comment.php'; // not executable\n",
+        "*/\n",
+        "$s = 'quoted\n",
+        "require_once \"string.php\"; // not executable\n",
+        "end';\n",
+        "$text = <<<DOC\n",
+        "require_once 'heredoc.php'; // not executable\n",
+        "DOC;\n",
+        "$text = <<<'RAW'\n",
+        "require_once 'nowdoc.php'; // not executable\n",
+        "    RAW;\n",
+        "require_once 'real.php'; /* open\n",
+        "require_once 'nested.php'; // inside comment\n",
+        "close */\n",
+        "require_once \"dir/unknown\\q.php\"; // valid literal unknown escape\n",
+    );
+    assert_eq!(
+        extract_require_once_paths(source),
+        vec!["real.php", "dir/unknown\\q.php"]
+    );
+}
+
+#[test]
+fn heredoc_label_prefix_is_not_terminator() {
+    let source = concat!(
+        "$s = <<<DOC\n",
+        "DOC_suffix\n",
+        "require_once 'inside.php'; // still inside\n",
+        "DOC;\n",
+        "require_once 'outside.php'; // discovered\n",
+    );
+    assert_eq!(extract_require_once_paths(source), vec!["outside.php"]);
+}
+
+#[test]
+fn mixed_html_and_php_only_discovers_actual_php() {
+    let source = concat!(
+        "Bob's template\n",
+        "require_once 'html.php'; // plain HTML\n",
+        "<?php\n",
+        "require_once'real.php'; // compact\n",
+        "?>\n",
+        "require_once 'html2.php'; // HTML again\n",
+        "<?php\n",
+        "require_once 'second.php'; other_function();\n",
+        "?>\n",
+    );
+    assert_eq!(
+        extract_require_once_paths_from_php(source),
+        vec!["real.php", "second.php"]
+    );
+    assert!(
+        extract_require_once_paths_from_php("Bob's HTML\nrequire_once 'not-php.php';\n").is_empty()
+    );
+}
+
+#[test]
+fn close_tag_terminates_require_and_later_lexical_error_keeps_prefix() {
+    let source = "<?php\nrequire_once 'before.php';\nrequire_once 'closing.php' ?>\n<?php\n$broken = 'unterminated";
+    assert_eq!(
+        extract_require_once_paths_from_php(source),
+        vec!["before.php", "closing.php"]
+    );
+}
+
+#[test]
+fn close_tag_ends_php_line_comment_and_terminates_require() {
+    let source = "<?php\nrequire_once 'line.php' // comment ?>\nHTML\n<?php\nrequire_once 'hash.php' # comment ?>";
+    assert_eq!(
+        extract_require_once_paths_from_php(source),
+        vec!["line.php", "hash.php"]
+    );
+}
+
+#[test]
+fn line_comment_before_multiline_dynamic_expression_is_not_a_terminator() {
+    let source = "<?php\nrequire_once 'prefix' // keep reading\n . $suffix ?>";
+    assert!(extract_require_once_paths_from_php(source).is_empty());
+}
+
+#[test]
+fn close_tag_after_consecutive_line_comments_terminates_require() {
+    let source = "<?php require_once 'x.php' // first\n // second ?>";
+    assert_eq!(extract_require_once_paths_from_php(source), vec!["x.php"]);
+}

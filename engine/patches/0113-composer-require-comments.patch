+use crate::common::{complete_labels_at_opened, create_psr4_workspace, open_document};
+use tower_lsp::{LanguageServer, lsp_types::*};
+
+#[tokio::test]
+async fn autoload_helper_require_once_with_comment_supports_completion_and_definition() {
+    for bootstrap in [
+        "<?php\nrequire_once __DIR__ . '/extra.php'; // shared helpers\n",
+        "<?php\nrequire_once __DIR__ . '/extra.php';\n",
+        "<?php\nrequire_once __DIR__ . '/extra.php' ?>\n",
+        "<?php\nrequire_once __DIR__ . '/extra.php';\n$broken = 'unfinished",
+        "<?php\nrequire_once __DIR__ . '/extra.php';\n/* unfinished",
+        "<?php\nrequire_once __DIR__ . '/extra.php';\n$broken = <<<DOC\nunfinished",
+        "Bob's HTML\nrequire_once 'fake.php';\n<?php\nrequire_once __DIR__ . '/extra.php'; // mixed template\n?>\n",
+    ] {
+        let source = "<?php\ncommented_helper_\ncommented_helper_function();\nhtml_fake_helper_\nhtml_fake_helper_function();\n";
+        let (backend, dir) = create_psr4_workspace(
+            r#"{"name":"fixture/require-comments","autoload":{"files":["bootstrap.php"]}}"#,
+            &[
+                (".phpantom.toml", "[indexing]\nstrategy = \"none\"\n"),
+                (
+                    "vendor/composer/autoload_files.php",
+                    "<?php\n$vendorDir = dirname(__DIR__);\n$baseDir = dirname($vendorDir);\nreturn array(\n    'fixture' => $baseDir . '/bootstrap.php',\n);\n",
+                ),
+                ("bootstrap.php", bootstrap),
+                (
+                    "extra.php",
+                    "<?php\nfunction commented_helper_function(): string { return 'ok'; }\n",
+                ),
+                (
+                    "fake.php",
+                    "<?php\nfunction html_fake_helper_function(): string { return 'fake'; }\n",
+                ),
+            ],
+        );
+        backend.initialized(InitializedParams {}).await;
+        let uri = Url::from_file_path(dir.path().join("consumer.php")).unwrap();
+        open_document(&backend, &uri, "php", source).await;
+        let labels =
+            complete_labels_at_opened(&backend, &uri, 1, "commented_helper_".len() as u32).await;
+        assert!(
+            labels
+                .iter()
+                .any(|label| label.starts_with("commented_helper_function")),
+            "helper must complete: {labels:?}"
+        );
+        let fake_labels =
+            complete_labels_at_opened(&backend, &uri, 3, "html_fake_helper_".len() as u32).await;
+        assert!(
+            !fake_labels
+                .iter()
+                .any(|label| label.starts_with("html_fake_helper_function")),
+            "HTML must not index fake helper: {fake_labels:?}"
+        );
+        let fake_result = backend
+            .goto_definition(GotoDefinitionParams {
+                text_document_position_params: TextDocumentPositionParams {
+                    text_document: TextDocumentIdentifier { uri: uri.clone() },
+                    position: Position::new(4, 8),
+                },
+                work_done_progress_params: WorkDoneProgressParams::default(),
+                partial_result_params: PartialResultParams::default(),
+            })
+            .await
+            .unwrap();
+        assert!(
+            fake_result.is_none(),
+            "HTML must not resolve fake helper: {fake_result:?}"
+        );
+        let result = backend
+            .goto_definition(GotoDefinitionParams {
+                text_document_position_params: TextDocumentPositionParams {
+                    text_document: TextDocumentIdentifier { uri },
+                    position: Position::new(2, 5),
+                },
+                work_done_progress_params: WorkDoneProgressParams::default(),
+                partial_result_params: PartialResultParams::default(),
+            })
+            .await
+            .unwrap()
+            .expect("helper definition");
+        let locations = match result {
+            GotoDefinitionResponse::Scalar(location) => vec![location],
+            GotoDefinitionResponse::Array(locations) => locations,
+            GotoDefinitionResponse::Link(links) => links
+                .into_iter()
+                .map(|link| Location {
+                    uri: link.target_uri,
+                    range: link.target_selection_range,
+                })
+                .collect(),
+        };
+        let expected = Url::from_file_path(dir.path().join("extra.php")).unwrap();
+        assert!(
+            locations.iter().any(|location| location.uri == expected),
+            "definition must target required helper: {locations:?}"
+        );
+    }
+}

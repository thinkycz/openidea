+
+// The lexer remains authoritative. This byte search only proves where its
+// final possible keyword can occur; matches inside strings/comments are harmless.
+fn last_possible_require_once(content: &str) -> Option<usize> {
+    let bytes = content.as_bytes();
+    memchr::memchr_iter(b'_', bytes)
+        .rev()
+        .find_map(|underscore| {
+            let start = underscore.checked_sub(7)?;
+            let end = underscore.checked_add(5)?;
+            let candidate = bytes.get(start..end)?;
+            candidate
+                .eq_ignore_ascii_case(b"require_once")
+                .then_some(start)
+        })
 }
 
 fn extract_literal_requires(content: &str, tagged: bool) -> Vec<String> {
+    if content.len() > u32::MAX as usize {
+        return Vec::new();
+    }
+    let Some(last_keyword) = last_possible_require_once(content) else {
+        return Vec::new();
+    };
+    extract_literal_requires_inner(content, tagged, Some(last_keyword))
+}

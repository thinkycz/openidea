+    let (backend, dir) = create_psr4_workspace(COMPOSER_JSON, &[("lang/en.json", text)]);
+    let uri = Url::from_file_path(dir.path().join("lang/en.json")).unwrap();
+    crate::common::open_document(&backend, &uri, "json", text).await;
+    assert!(
+        !backend
+            .global_functions()
+            .read()
+            .contains_key("openstorm_translation_fake")
+    );
+    backend
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier { uri, version: 2 },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: text.replace(
+                    "openstorm_translation_fake",
+                    "openstorm_translation_updated",
+                ),
+            }],
+        })
+        .await;
+    assert!(
+        !backend
+            .global_functions()
+            .read()
+            .contains_key("openstorm_translation_updated")
+    );

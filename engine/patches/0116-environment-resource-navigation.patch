+/// Find PHP/Blade callers from a root dotenv declaration without indexing its value.
+pub(crate) fn find_env_declaration_references(
+    backend: &Backend,
+    uri: &str,
+    content: &str,
+    position: Position,
+    include_declaration: bool,
+) -> Option<Vec<Location>> {
+    if !crate::resource_navigation::is_dotenv_document(uri) {
+        return None;
+    }
+    let path = Url::parse(uri).ok()?.to_file_path().ok()?;
+    let root = backend.workspace.workspace_root.read().clone()?;
+    if path.parent() != Some(root.as_path()) {
+        return None;
+    }
+    let line = content.lines().nth(position.line as usize)?;
+    let key = declared_key(line)?;
+    let body = line.trim_start();
+    let body = body.strip_prefix("export ").unwrap_or(body).trim_start();
+    let start = line.len() - body.len();
+    let offset =
+        crate::text_position::position_to_offset(line, Position::new(0, position.character))
+            as usize;
+    if offset < start || offset > start + key.len() {
+        return None;
+    }
+    let kind = crate::symbol_map::LaravelStringKind::Env;
+    let snapshot = backend.user_file_symbol_maps_for_reference_keys(&[
+        crate::reference_index::ReferenceIndexKey::LaravelString {
+            kind,
+            key: key.into(),
+        },
+    ]);
+    Some(super::string_keys::find_laravel_string_key_references(
+        backend,
+        &kind,
+        key,
+        uri,
+        &snapshot,
+        include_declaration,
+    ))
+}

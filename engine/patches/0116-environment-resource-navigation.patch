+#[tokio::test]
+async fn dotenv_declaration_usages_and_unsaved_keys_are_data_only() {
+    let environment = "OPENSTORM_DEMO_LABEL=sample\nOPENSTORM_DEMO_MODE=local\n";
+    let (backend, dir, caller_uri, php) = workspace(
+        &[(".env", environment)],
+        "env('OPENSTORM_DEMO_LABEL'); env('OPENSTORM_DEMO_MODE');",
+    )
+    .await;
+    let env_uri = Url::from_file_path(dir.path().join(".env")).unwrap();
+    crate::common::open_document(&backend, &env_uri, "dotenv", environment).await;
+    let references =
+        crate::common::find_references(&backend, &env_uri, Position::new(0, 5), false).await;
+    assert!(references.iter().any(|location| location.uri == caller_uri));
+    assert!(references.iter().all(|location| location.uri != env_uri));
+    let value_references =
+        crate::common::find_references(&backend, &env_uri, Position::new(0, 24), false).await;
+    assert!(value_references.is_empty());
+    let updated = "# 😀\r\n\r\n  export OPENSTORM_DEMO_MODE=local # <?php function openstorm_env_fake(): void {} ?>\r\n";
+    backend
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: env_uri.clone(),
+                version: 2,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: updated.into(),
+            }],
+        })
+        .await;
+    let after = definitions_at(&backend, &caller_uri, &php, "OPENSTORM_DEMO_MODE").await;
+    assert!(after.iter().any(|location| location.range.start.line == 2));
+    assert!(
+        !backend
+            .global_functions()
+            .read()
+            .contains_key("openstorm_env_fake")
+    );
+    let labels = env_completion_labels(&backend, &caller_uri, &php).await;
+    assert!(!labels.iter().any(|label| label == "OPENSTORM_DEMO_LABEL"));
+    assert!(labels.iter().any(|label| label == "OPENSTORM_DEMO_MODE"));
+    let updated_refs =
+        crate::common::find_references(&backend, &env_uri, Position::new(2, 15), true).await;
+    assert!(
+        updated_refs
+            .iter()
+            .any(|location| location.uri == caller_uri)
+    );
+    assert!(
+        updated_refs
+            .iter()
+            .any(|location| location.uri == env_uri && location.range.start.line == 2)
+    );
+    let extra_uri = Url::from_file_path(dir.path().join(".env.testing")).unwrap();
+    crate::common::open_document(
+        &backend,
+        &extra_uri,
+        "dotenv",
+        "OPENSTORM_DEMO_LABEL=sample\n",
+    )
+    .await;
+    let labels = env_completion_labels(&backend, &caller_uri, &php).await;
+    assert!(labels.iter().any(|label| label == "OPENSTORM_DEMO_LABEL"));
+    backend
+        .did_close(DidCloseTextDocumentParams {
+            text_document: TextDocumentIdentifier { uri: extra_uri },
+        })
+        .await;
+    let labels = env_completion_labels(&backend, &caller_uri, &php).await;
+    assert!(!labels.iter().any(|label| label == "OPENSTORM_DEMO_LABEL"));
+    assert_eq!(
+        std::fs::read_to_string(dir.path().join(".env")).unwrap(),
+        environment
+    );
+    backend
+        .did_close(DidCloseTextDocumentParams {
+            text_document: TextDocumentIdentifier { uri: env_uri },
+        })
+        .await;
+    let labels = env_completion_labels(&backend, &caller_uri, &php).await;
+    assert!(labels.iter().any(|label| label == "OPENSTORM_DEMO_LABEL"));
+}

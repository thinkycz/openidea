+/// Dotenv values are data and must never enter the PHP symbol parser.
+pub(crate) fn is_dotenv_document(uri: &str) -> bool {
+    let name = uri
+        .split(['?', '#'])
+        .next()
+        .unwrap_or(uri)
+        .rsplit('/')
+        .next()
+        .unwrap_or(uri);
+    name == ".env" || name.starts_with(".env.")
+}

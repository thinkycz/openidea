+#[test]
+fn unfinished_echo_cursor_precedes_generated_terminator() {
+    for text in [
+        "{{ $item->na",
+        "{!! $item->na",
+        "😀 {{ $item->na",
+        "😀 {!! $item->na",
+    ] {
+        let (php, map) = preprocess(text);
+        let end = tower_lsp::lsp_types::Position::new(0, text.encode_utf16().count() as u32);
+        let mapped = map.blade_to_php(end);
+        let line = php.lines().nth(mapped.line as usize).unwrap();
+        let prefix: String = line
+            .chars()
+            .scan(0usize, |count, c| {
+                *count += c.len_utf16();
+                Some((*count <= mapped.character as usize).then_some(c))
+            })
+            .flatten()
+            .collect();
+        assert!(
+            prefix.ends_with("$item->na"),
+            "cursor must precede generated suffix: {prefix:?}"
+        );
+        assert_eq!(map.php_to_blade(mapped), end);
+        let suffix_end =
+            tower_lsp::lsp_types::Position::new(mapped.line, line.encode_utf16().count() as u32);
+        assert_eq!(
+            map.php_to_blade(suffix_end),
+            end,
+            "generated suffix must still map to visible end"
+        );
+    }
+}

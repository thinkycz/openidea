+#[tokio::test]
+async fn unfinished_echo_member_completion_keeps_original_edit_ranges() {
+    let composer = r#"{"autoload":{"psr-4":{"App\\":"app/"}}}"#;
+    let (backend, _dir) = create_psr4_workspace(
+        composer,
+        &[(
+            "app/Item.php",
+            "<?php namespace App; class Item { public string $name; public int $price; }",
+        )],
+    );
+    for (index, expression) in [
+        "{{ $item->na",
+        "{!! $item->na",
+        "😀 {{ $item->na",
+        "😀 {!! $item->na",
+    ]
+    .iter()
+    .enumerate()
+    {
+        let uri = workspace_uri(
+            &backend,
+            &format!("resources/views/unfinished{index}.blade.php"),
+        );
+        let template = format!("@php $item = new \\App\\Item(); @endphp\n{expression}");
+        open_document(&backend, &uri, "blade", &template).await;
+        let column = expression.encode_utf16().count() as u32;
+        let items = complete_typed(&backend, &uri, 1, column).await;
+        let item = items
+            .iter()
+            .find(|i| i.label == "name")
+            .unwrap_or_else(|| panic!("{expression}: {:?}", labels(&items)));
+        let edit = match item.text_edit.as_ref().expect("member text edit") {
+            CompletionTextEdit::Edit(edit) => edit,
+            other => panic!("expected plain edit: {other:?}"),
+        };
+        assert_eq!(edit.range.start, Position::new(1, column - 2));
+        assert_eq!(edit.range.end, Position::new(1, column));
+        assert_eq!(edit.new_text, "name");
+    }
+}

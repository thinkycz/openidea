+fn rule_value_is_literal(expr: &Expression<'_>) -> bool {
+    match expr {
+        Expression::Literal(literal::Literal::String(_)) => true,
+        Expression::Array(arr) => rule_list_is_literal(arr.elements.iter()),
+        Expression::LegacyArray(arr) => rule_list_is_literal(arr.elements.iter()),
+        _ => false,
+    }
+}
+
+fn rule_list_is_literal<'a>(elements: impl Iterator<Item = &'a ArrayElement<'a>>) -> bool {
+    elements.into_iter().all(|element| {
+        matches!(element,
+            ArrayElement::Value(value)
+                if matches!(value.value, Expression::Literal(literal::Literal::String(_)))
+        )
+    })
 }
 

+//! Documentation for input keys recovered from Laravel validation rules.
+
+use crate::Backend;
+use tower_lsp::lsp_types::{Hover, Position};
+
+use super::{inline_code, make_hover};
+
+impl Backend {
+    /// Show the governing rules and their exact declaration without executing PHP.
+    pub(super) fn try_request_field_hover(
+        &self,
+        uri: &str,
+        content: &str,
+        position: Position,
+    ) -> Option<Hover> {
+        let field =
+            crate::virtual_members::laravel::resolve_request_field(self, uri, content, position)?;
+        let mut detail = format!("**Request input** {}", inline_code(&field.name));
+        if field.rules.is_empty() {
+            detail.push_str("\n\nSee the rule declaration for details.");
+        } else if field.literal_value {
+            detail.push_str(&format!(
+                "\n\n**Validation rules:** {}",
+                inline_code(&field.rules)
+            ));
+        } else {
+            detail.push_str(&format!(
+                "\n\n**Rule expression (not evaluated):** {}",
+                inline_code(&field.rules)
+            ));
+        }
+        if !field.complete {
+            detail.push_str("\n\nRule information may be incomplete.");
+        }
+        let file = field.location.uri.path().rsplit('/').next().unwrap_or("");
+        detail.push_str(&format!(
+            "\n\nDefined in [{}](<{}#L{}>)",
+            inline_code(file),
+            field.location.uri,
+            field.location.range.start.line + 1,
+        ));
+        let mut hover = make_hover(detail);
+        hover.range = Some(field.range);
+        Some(hover)
+    }
+}

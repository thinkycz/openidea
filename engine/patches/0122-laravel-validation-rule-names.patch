+//! Complete a Laravel validation rule name, leaving its parameters intact.
+use crate::virtual_members::laravel::validation_names::{rule_catalog, rule_name_at};
+use crate::{Backend, types::FileContext};
+use tower_lsp::lsp_types::*;
+impl Backend {
+    /// Complete only the current rule token, preserving its parameters and imports.
+    pub(crate) fn try_validation_rule_completion(
+        &self,
+        content: &str,
+        position: Position,
+        ctx: &FileContext,
+    ) -> Option<CompletionResponse> {
+        let site = rule_name_at(self, content, position, ctx)?;
+        let entries = rule_catalog(self)?;
+        let prefix = site.prefix.to_ascii_lowercase();
+        let items = entries
+            .into_iter()
+            .filter(|e| e.name.starts_with(&prefix))
+            .map(|e| CompletionItem {
+                label: e.name.clone(),
+                kind: Some(CompletionItemKind::VALUE),
+                detail: Some("Laravel validation rule".into()),
+                documentation: e.method.description.as_ref().map(|value| {
+                    Documentation::MarkupContent(MarkupContent {
+                        kind: MarkupKind::Markdown,
+                        value: value.clone(),
+                    })
+                }),
+                text_edit: Some(CompletionTextEdit::Edit(TextEdit {
+                    range: site.range,
+                    new_text: e.name,
+                })),
+                ..Default::default()
+            })
+            .collect();
+        // Runtime extensions may add names not present in installed source.
+        Some(CompletionResponse::List(CompletionList {
+            is_incomplete: true,
+            items,
+        }))
+    }
+}

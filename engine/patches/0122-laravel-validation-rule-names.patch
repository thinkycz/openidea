diff --git a/tests/integration/laravel_validation_names.rs b/tests/integration/laravel_validation_names.rs
new file mode 100644
--- /dev/null
+++ b/tests/integration/laravel_validation_names.rs
@@ -0,0 +1,243 @@
+//! Rule names must come from installed validation source and a proven rule site.
+use crate::common::{
+    apply_edits, complete_at_opened, create_psr4_workspace, definition_locations,
+    goto_definition_at, hover_text_at, item_labels, open_php_at, split_cursor,
+};
+use tower_lsp::LanguageServer;
+use tower_lsp::lsp_types::*;
+
+const COMPOSER: &str = r#"{"require":{"laravel/framework":"*"},"autoload":{"psr-4":{"App\\":"src/","Illuminate\\":"vendor/illuminate/"}}}"#;
+const TRAIT: &str = "<?php namespace Illuminate\\Validation\\Concerns; trait ValidatesAttributes {
+/** The value must be supplied. */ public function validateRequired($attribute,$value): bool { return true; }
+/** The value must not exceed its limit. */ public function validateMax($attribute,$value,$parameters): bool { return true; }
+public function validateInteger($attribute,$value): bool { return true; }
+public function validateBoolean($attribute,$value): bool { return true; }
+protected function validateInternal() {} public static function validateStaticHelper() {} }";
+const PREFIX: &str = "<?php\nnamespace App;\nuse Illuminate\\Foundation\\Http\\FormRequest;\nuse Illuminate\\Http\\Request;\nuse Illuminate\\Support\\Facades\\Validator as V;\n";
+
+async fn opened(
+    body: &str,
+) -> (
+    phpantom_lsp::Backend,
+    tempfile::TempDir,
+    Url,
+    Position,
+    String,
+) {
+    let (source, at) = split_cursor(&format!("{PREFIX}{body}"));
+    let files = [
+        (
+            "vendor/illuminate/Foundation/Http/FormRequest.php",
+            "<?php namespace Illuminate\\Foundation\\Http; class FormRequest extends \\Illuminate\\Http\\Request {}",
+        ),
+        (
+            "vendor/illuminate/Http/Request.php",
+            "<?php namespace Illuminate\\Http; class Request { public function validate(array $rules): array { return []; } public function validateWithBag($bag,array $rules): array { return []; } }",
+        ),
+        (
+            "vendor/illuminate/Support/Facades/Validator.php",
+            "<?php namespace Illuminate\\Support\\Facades; class Validator { public static function make($data,array $rules) {} public static function validate($data,array $rules) {} }",
+        ),
+        (
+            "vendor/illuminate/Foundation/Validation/ValidatesRequests.php",
+            "<?php namespace Illuminate\\Foundation\\Validation; trait ValidatesRequests { public function validate($request,array $rules): array { return []; } public function validateWithBag($bag,$request,array $rules): array { return []; } }",
+        ),
+        (
+            "vendor/illuminate/Contracts/Validation/Factory.php",
+            "<?php namespace Illuminate\\Contracts\\Validation; interface Factory { public function make($data,array $rules); }",
+        ),
+        (
+            "vendor/illuminate/Validation/Validator.php",
+            "<?php namespace Illuminate\\Validation; class Validator { public function setRules(array $rules) {} public function addRules(array $rules) {} }",
+        ),
+        (
+            "vendor/illuminate/Validation/Concerns/ValidatesAttributes.php",
+            TRAIT,
+        ),
+        ("src/Probe.php", source.as_str()),
+    ];
+    let (backend, dir) = create_psr4_workspace(COMPOSER, &files);
+    let uri = open_php_at(&backend, &dir, "src/Probe.php", &source).await;
+    (backend, dir, uri, at, source)
+}
+
+#[tokio::test]
+async fn validation_names_complete_literal_pipe_array_legacy_and_merged_rules() {
+    for expression in [
+        "['title'=>'string|req§']",
+        "['title'=>['string','req§']]",
+        "array('title'=>'req§')",
+        "array_merge(parent::rules(), ['title'=>'req§'])",
+        "['title'=>'§']",
+    ] {
+        let body = format!(
+            "class Probe extends FormRequest {{ public function rules(): array {{ return {expression}; }} }}"
+        );
+        let (backend, _dir, uri, at, _) = opened(&body).await;
+        let labels = item_labels(complete_at_opened(&backend, &uri, at.line, at.character).await);
+        assert!(
+            labels.contains(&"required".into()),
+            "{expression}: {labels:?}"
+        );
+        assert!(
+            !labels.contains(&"internal".into()) && !labels.contains(&"static_helper".into()),
+            "helpers are not validation rules: {labels:?}"
+        );
+    }
+}
+
+#[tokio::test]
+async fn validation_names_prove_inline_receiver_and_named_rules_argument() {
+    for body in [
+        "function probe(?Request $r) { $r?->validate(['title'=>'req§']); }",
+        "function probe(Request $r) { $r->validate(['title'=>'req§']); }",
+        "function probe(Request $r) { $r->validateWithBag('bag', rules: ['title'=>'req§']); }",
+        "function probe() { V::make(rules: ['title'=>'req§'], data: []); }",
+        "function probe() { V::make([], ['title'=>'req§'], messages: []); }",
+        "function probe() { V::validate([], ['title'=>'req§']); }",
+        "class Probe { use \\Illuminate\\Foundation\\Validation\\ValidatesRequests; public function probe(Request $r) { $this->validate($r, ['title'=>'req§']); } }",
+        "class Probe { use \\Illuminate\\Foundation\\Validation\\ValidatesRequests; public function probe(Request $r) { $this->validateWithBag('bag', $r, ['title'=>'req§']); } }",
+        "function probe(\\Illuminate\\Contracts\\Validation\\Factory $f) { $f->make([], ['title'=>'req§']); }",
+        "function probe(\\Illuminate\\Validation\\Validator $v) { $v->setRules(['title'=>'req§']); }",
+    ] {
+        let (backend, _dir, uri, at, _) = opened(body).await;
+        let labels = item_labels(complete_at_opened(&backend, &uri, at.line, at.character).await);
+        assert!(labels.contains(&"required".into()), "{body}: {labels:?}");
+    }
+}
+
+#[tokio::test]
+async fn validation_names_refuse_other_arrays_parameter_payloads_and_ambiguous_receivers() {
+    for body in [
+        "function ordinary() { return ['title'=>'req§']; }",
+        "class Probe { public function rules() { return ['title'=>'req§']; } }",
+        "class Probe extends FormRequest { public function messages() { return ['title'=>'req§']; } }",
+        "class Probe extends FormRequest { public function rules() { return ['title'=>'min:req§']; } }",
+        "class Probe extends FormRequest { public function rules() { return ['title'=>['regex:/a|req§/']]; } }",
+        "class Fake { public function validate(array $rules) {} } function probe(Fake $r) { $r->validate(['title'=>'req§']); }",
+        "class Fake { public function validate(array $rules) {} } function probe(Request|Fake $r) { $r->validate(['title'=>'req§']); }",
+        "function probe(Request|UnknownReceiver $r) { $r->validate(['title'=>'req§']); }",
+        "function probe(Request|int $r) { $r->validate(['title'=>'req§']); }",
+        "class Probe extends FormRequest { public function rules() { return ['title'=>'required','req§'=>'string']; } }",
+    ] {
+        let (backend, _dir, uri, at, _) = opened(body).await;
+        let labels = item_labels(complete_at_opened(&backend, &uri, at.line, at.character).await);
+        assert!(!labels.contains(&"required".into()), "{body}: {labels:?}");
+    }
+}
+
+#[tokio::test]
+async fn validation_names_replace_only_name_with_unicode_and_preserve_parameters() {
+    let body = "class Probe extends FormRequest { public function rules() { /* 😀 */ return ['title'=>['ma§:12','required']]; } }";
+    let (backend, _dir, uri, at, source) = opened(body).await;
+    let items = complete_at_opened(&backend, &uri, at.line, at.character).await;
+    let item = items
+        .iter()
+        .find(|i| i.label == "max")
+        .expect("max rule from installed source");
+    let Some(CompletionTextEdit::Edit(edit)) = &item.text_edit else {
+        panic!("a precise edit is required")
+    };
+    assert_eq!(
+        edit.range,
+        Range::new(Position::new(at.line, at.character - 2), at)
+    );
+    assert_eq!(
+        apply_edits(&source, std::slice::from_ref(edit)),
+        source.replace("'ma:12'", "'max:12'")
+    );
+}
+
+#[tokio::test]
+async fn validation_names_hover_and_definition_retain_rule_token_origin() {
+    let body = "class Probe extends FormRequest { public function rules() { /* 😀 */ return ['title'=>'string|ma§x:12']; } }";
+    let (backend, _dir, uri, at, _) = opened(body).await;
+    let hover = hover_text_at(&backend, &uri, at.line, at.character)
+        .await
+        .unwrap();
+    assert!(
+        hover.contains("max")
+            && hover.contains("must not exceed")
+            && hover.contains("Rule declaration"),
+        "{hover}"
+    );
+    let locations =
+        definition_locations(goto_definition_at(&backend, &uri, at.line, at.character).await);
+    let location = locations.first().expect("rule definition");
+    let source = std::fs::read_to_string(location.uri.to_file_path().unwrap()).unwrap();
+    assert!(
+        source
+            .lines()
+            .nth(location.range.start.line as usize)
+            .unwrap()
+            .contains("function validateMax(")
+    );
+}
+
+#[tokio::test]
+async fn validation_names_laravel_int_bool_aliases_resolve_to_installed_methods() {
+    for (alias, method) in [("in§t", "validateInteger"), ("bo§ol", "validateBoolean")] {
+        let body = format!(
+            "class Probe extends FormRequest {{ public function rules() {{ return ['title'=>'{alias}']; }} }}"
+        );
+        let (backend, _dir, uri, at, _) = opened(&body).await;
+        let locations =
+            definition_locations(goto_definition_at(&backend, &uri, at.line, at.character).await);
+        let location = locations.first().expect("Laravel's normalized rule alias");
+        let source = std::fs::read_to_string(location.uri.to_file_path().unwrap()).unwrap();
+        assert!(
+            source
+                .lines()
+                .nth(location.range.start.line as usize)
+                .unwrap()
+                .contains(method)
+        );
+    }
+}
+
+#[tokio::test]
+async fn validation_names_follow_unsaved_installed_trait_and_restore_after_close() {
+    let body = "class Probe extends FormRequest { public function rules() { return ['title'=>'fresh§']; } }";
+    let (backend, dir, uri, at, _) = opened(body).await;
+    let file = "vendor/illuminate/Validation/Concerns/ValidatesAttributes.php";
+    let changed=TRAIT.replacen("protected function validateInternal", "public function validateFreshRule($attribute,$value): bool { return true; } protected function validateInternal",1);
+    let trait_uri = open_php_at(&backend, &dir, file, &changed).await;
+    let labels = item_labels(complete_at_opened(&backend, &uri, at.line, at.character).await);
+    assert!(labels.contains(&"fresh_rule".into()), "{labels:?}");
+    backend
+        .did_close(DidCloseTextDocumentParams {
+            text_document: TextDocumentIdentifier { uri: trait_uri },
+        })
+        .await;
+    let labels = item_labels(complete_at_opened(&backend, &uri, at.line, at.character).await);
+    assert!(
+        !labels.contains(&"fresh_rule".into()),
+        "closed overlay must restore disk methods: {labels:?}"
+    );
+    assert_eq!(
+        std::fs::read_to_string(dir.path().join(file)).unwrap(),
+        TRAIT
+    );
+}
+
+#[tokio::test]
+async fn validation_names_complete_unclosed_rule_string() {
+    for body in [
+        "class Probe extends FormRequest { public function rules() { return ['title'=>'string|req§",
+        "function probe(Request $r) { $r->validate(['title'=>'req§",
+        "function probe() { V::make(rules: ['title'=>'req§",
+    ] {
+        let (backend, _dir, uri, at, _) = opened(body).await;
+        let labels = item_labels(complete_at_opened(&backend, &uri, at.line, at.character).await);
+        assert!(
+            labels.contains(&"required".into()),
+            "completion while typing an unclosed rule: {body}: {labels:?}"
+        );
+    }
+    let (backend, _dir, uri, at, _) = opened("function ordinary() { return ['title'=>'req§").await;
+    let labels = item_labels(complete_at_opened(&backend, &uri, at.line, at.character).await);
+    assert!(
+        !labels.contains(&"required".into()),
+        "repair must not invent a validation context"
+    );
+}

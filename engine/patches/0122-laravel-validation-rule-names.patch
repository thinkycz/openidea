@@ -0,0 +1,499 @@
+//! Rule-name sites and the installed framework's validation methods.
+use std::sync::Arc;
+
+use mago_allocator::LocalArena;
+use mago_database::file::FileId;
+use mago_span::HasSpan;
+use mago_syntax::cst::*;
+use tower_lsp::lsp_types::{Position, Range};
+
+use crate::Backend;
+use crate::atom::bytes_to_str;
+use crate::class_lookup::find_class_at_offset;
+use crate::completion::source::code_context::code_context_at;
+use crate::php_type::TypeKind;
+use crate::text_position::{offset_to_position, position_to_offset};
+use crate::type_engine::resolver::{CtxLoaders, resolve_target_classes};
+use crate::types::{
+    AccessKind, ClassInfo, FileContext, MAX_INHERITANCE_DEPTH, MethodInfo, Visibility,
+};
+
+use super::helpers::{camel_to_snake, walks_parent_chain};
+use super::validation_rules::{is_form_request, is_request_like};
+
+pub(crate) const RULE_TRAIT: &str = "Illuminate\\Validation\\Concerns\\ValidatesAttributes";
+
+/// The current rule name, excluding surrounding pipes, quotes and parameters.
+pub(crate) struct RuleNameSite<'a> {
+    /// The complete name under the caret.
+    pub name: &'a str,
+    /// The typed prefix preceding the caret.
+    pub prefix: &'a str,
+    /// The name-only replacement range in UTF-16 coordinates.
+    pub range: Range,
+}
+
+/// One public built-in rule, retaining the installed source's documentation.
+pub(crate) struct RuleNameEntry {
+    /// Laravel's snake-case rule spelling.
+    pub name: String,
+    /// The installed validator method and its documentation.
+    pub method: Arc<MethodInfo>,
+}
+
+/// Normalize Laravel's short scalar aliases before looking up their methods.
+pub(crate) fn canonical_rule_name(name: &str) -> &str {
+    if name.eq_ignore_ascii_case("int") {
+        "integer"
+    } else if name.eq_ignore_ascii_case("bool") {
+        "boolean"
+    } else {
+        name
+    }
+}
+
+/// Read the built-in rule catalog from the project's installed framework.
+pub(crate) fn rule_catalog(backend: &Backend) -> Option<Vec<RuleNameEntry>> {
+    let class = backend.find_or_load_class(RULE_TRAIT)?;
+    let mut entries: Vec<_> = class
+        .methods
+        .iter()
+        .filter_map(|method| {
+            if method.visibility != Visibility::Public || method.is_static {
+                return None;
+            }
+            let suffix = method.name.strip_prefix("validate")?;
+            if suffix.is_empty() {
+                return None;
+            }
+            Some(RuleNameEntry {
+                name: camel_to_snake(suffix),
+                method: Arc::clone(method),
+            })
+        })
+        .collect();
+    entries.sort_by(|a, b| a.name.cmp(&b.name));
+    entries.dedup_by(|a, b| a.name == b.name);
+    Some(entries)
+}
+
+/// Locate a literal rule token only in a statically proven validation context.
+pub(crate) fn rule_name_at<'a>(
+    backend: &Backend,
+    content: &'a str,
+    position: Position,
+    ctx: &FileContext,
+) -> Option<RuleNameSite<'a>> {
+    let cursor = position_to_offset(content, position) as usize;
+    let code = code_context_at(content, cursor)?;
+    let (quote, _) = code.open_string?;
+    // Ordinary string arguments cannot be rule values. Avoid an AST walk for
+    // hover/completion on those frequently queried sites.
+    if !code.open_brackets.iter().any(|b| {
+        b.byte == b'[' || (b.byte == b'(' && content[..b.code_before].trim_end().ends_with("array"))
+    }) {
+        return None;
+    }
+    // Mago drops the containing statement/class for an unclosed literal.
+    // For typing at EOF only, close its lexical delimiters in a private parse
+    // buffer. Never publish these synthetic bytes or put them in an edit.
+    let repaired = if cursor == content.len() {
+        let mut value = content.to_owned();
+        value.push(code.open_string?.1);
+        let mut terminated = false;
+        for bracket in code.open_brackets.iter().rev() {
+            match bracket.byte {
+                b'[' => value.push(']'),
+                b'(' => value.push(')'),
+                b'{' => {
+                    if !terminated {
+                        value.push(';');
+                        terminated = true;
+                    }
+                    value.push('}');
+                }
+                _ => return None,
+            }
+        }
+        if !terminated {
+            value.push(';');
+        }
+        Some(value)
+    } else {
+        None
+    };
+    let recovered_classes;
+    let classes = if let Some(source) = repaired.as_ref() {
+        let (mut parsed, blocks) =
+            Backend::parse_php_classes_by_block(source, Some(backend.php_version()), false, false);
+        Backend::resolve_parent_class_names_by_block(
+            &mut parsed,
+            &blocks,
+            &ctx.use_map,
+            &ctx.namespace,
+        );
+        recovered_classes = parsed
+            .into_iter()
+            .map(|(class, _, _)| Arc::new(class))
+            .collect::<Vec<_>>();
+        &recovered_classes
+    } else {
+        &ctx.classes
+    };
+    let class_loader = backend.class_loader(ctx);
+    let class = find_class_at_offset(classes, cursor as u32);
+    let form_request = class.is_some_and(|c| is_form_request(c, &class_loader));
+    let arena = LocalArena::new();
+    let program = mago_syntax::parser::parse_file_content(
+        &arena,
+        FileId::new(b"rules.php"),
+        repaired.as_deref().unwrap_or(content).as_bytes(),
+    );
+    let search = RuleSearch {
+        backend,
+        content,
+        parse_content: repaired.as_deref().unwrap_or(content),
+        ctx,
+        classes,
+        cursor: cursor as u32,
+        quote,
+        form_request,
+    };
+    let (start, end, pipe_list) = search.walk(Node::Program(program), false)?;
+    let value = content.get(start..end)?;
+    let local = cursor.checked_sub(start)?;
+    if local > value.len() {
+        return None;
+    }
+    let segment_start = if pipe_list {
+        value[..local].rfind('|').map_or(0, |p| p + 1)
+    } else {
+        0
+    };
+    let segment_end = if pipe_list {
+        value[segment_start..]
+            .find('|')
+            .map_or(value.len(), |p| segment_start + p)
+    } else {
+        value.len()
+    };
+    let name_end = value[segment_start..segment_end]
+        .bytes()
+        .position(|c| !(c.is_ascii_alphanumeric() || c == b'_'))
+        .map_or(segment_end, |n| segment_start + n);
+    if local < segment_start || local > name_end {
+        return None;
+    }
+    Some(RuleNameSite {
+        name: &value[segment_start..name_end],
+        prefix: &value[segment_start..local],
+        range: Range::new(
+            offset_to_position(content, start + segment_start),
+            offset_to_position(content, start + name_end),
+        ),
+    })
+}
+
+struct RuleSearch<'a> {
+    backend: &'a Backend,
+    content: &'a str,
+    parse_content: &'a str,
+    ctx: &'a FileContext,
+    classes: &'a [Arc<ClassInfo>],
+    cursor: u32,
+    quote: usize,
+    form_request: bool,
+}
+
+impl RuleSearch<'_> {
+    fn walk(&self, node: Node<'_, '_>, in_rules: bool) -> Option<(usize, usize, bool)> {
+        let span = node.span();
+        if self.quote < span.start.offset as usize || self.quote > span.end.offset as usize {
+            return None;
+        }
+        let in_rules = match node {
+            Node::Method(m) => {
+                self.form_request && bytes_to_str(m.name.value).eq_ignore_ascii_case("rules")
+            }
+            Node::Closure(_) | Node::ArrowFunction(_) | Node::Function(_) => false,
+            _ => in_rules,
+        };
+        let rules = match node {
+            Node::Return(ret) if in_rules => ret.value,
+            Node::MethodCall(call) => {
+                self.call_argument(call.object, &call.method, &call.argument_list, false)
+            }
+            Node::NullSafeMethodCall(call) => {
+                self.call_argument(call.object, &call.method, &call.argument_list, false)
+            }
+            Node::StaticMethodCall(call) => {
+                self.call_argument(call.class, &call.method, &call.argument_list, true)
+            }
+            _ => None,
+        };
+        if let Some(rules) = rules
+            && let Some(site) = rule_value_site(rules, self.content, self.quote)
+        {
+            return Some(site);
+        }
+        let mut found = None;
+        node.visit_children(|child| {
+            if found.is_none() {
+                found = self.walk(child, in_rules);
+            }
+        });
+        found
+    }
+
+    fn call_argument<'ast, 'arena>(
+        &self,
+        receiver: &Expression<'arena>,
+        method: &ClassLikeMemberSelector<'arena>,
+        arguments: &'ast ArgumentList<'arena>,
+        is_static: bool,
+    ) -> Option<&'ast Expression<'arena>> {
+        let ClassLikeMemberSelector::Identifier(ident) = method else {
+            return None;
+        };
+        let method = bytes_to_str(ident.value);
+        if ![
+            "validate",
+            "validateWithBag",
+            "validateWith",
+            "make",
+            "setRules",
+            "addRules",
+        ]
+        .iter()
+        .any(|n| method.eq_ignore_ascii_case(n))
+        {
+            return None;
+        }
+        let span = receiver.span();
+        let subject = self
+            .content
+            .get(span.start.offset as usize..span.end.offset as usize)?;
+        let class_loader = self.backend.class_loader(self.ctx);
+        let function_loader = self.backend.function_loader(self.ctx);
+        let macro_this = self.backend.laravel_macro_this_resolver(&class_loader);
+        let rctx = self.backend.resolution_ctx_at(
+            find_class_at_offset(self.classes, self.cursor),
+            self.classes,
+            self.parse_content,
+            self.cursor,
+            CtxLoaders::new(&class_loader, &function_loader, &macro_this),
+        );
+        let access = if is_static {
+            AccessKind::DoubleColon
+        } else {
+            AccessKind::Arrow
+        };
+        let mut indices = Vec::new();
+        for target in resolve_target_classes(subject, access, &rctx) {
+            let Some(class) = target.class_info else {
+                if target.type_string.is_null() {
+                    continue;
+                }
+                return None;
+            };
+            // One loaded class may carry a union hint with unresolved or
+            // scalar peers. ClassInfo alone is not proof of that whole union.
+            if let TypeKind::Union(members) = target.type_string.kind()
+                && members.iter().any(|member| {
+                    !member.is_null()
+                        && member.base_name().is_none_or(|name| {
+                            class_loader(name.trim_start_matches('\\'))
+                                .is_none_or(|peer| peer.fqn() != class.fqn())
+                        })
+                })
+            {
+                return None;
+            }
+            let index = if is_static
+                && class
+                    .fqn()
+                    .eq_ignore_ascii_case("Illuminate\\Support\\Facades\\Validator")
+            {
+                if method.eq_ignore_ascii_case("make") || method.eq_ignore_ascii_case("validate") {
+                    Some(1)
+                } else {
+                    None
+                }
+            } else if !is_static && is_request_like(&class, &class_loader) {
+                if method.eq_ignore_ascii_case("validate") {
+                    Some(0)
+                } else if method.eq_ignore_ascii_case("validateWithBag") {
+                    Some(1)
+                } else {
+                    None
+                }
+            } else if !is_static && has_validation_trait(&class, &class_loader, 0) {
+                if method.eq_ignore_ascii_case("validate") {
+                    Some(1)
+                } else if method.eq_ignore_ascii_case("validateWithBag") {
+                    Some(2)
+                } else if method.eq_ignore_ascii_case("validateWith") {
+                    Some(0)
+                } else {
+                    None
+                }
+            } else if !is_static && class_family(&class, &class_loader, is_factory) {
+                if method.eq_ignore_ascii_case("make") || method.eq_ignore_ascii_case("validate") {
+                    Some(1)
+                } else {
+                    None
+                }
+            } else if !is_static && class_family(&class, &class_loader, is_validator) {
+                if method.eq_ignore_ascii_case("setRules")
+                    || method.eq_ignore_ascii_case("addRules")
+                {
+                    Some(0)
+                } else {
+                    None
+                }
+            } else {
+                None
+            };
+            // A union with a non-validation receiver is ambiguous.
+            indices.push(index?);
+        }
+        let index = *indices.first()?;
+        if indices.iter().any(|i| *i != index) {
+            return None;
+        }
+        let name = if method.eq_ignore_ascii_case("validateWith") {
+            "validator"
+        } else {
+            "rules"
+        };
+        rule_argument(arguments, index, name)
+    }
+}
+
+fn rule_argument<'ast, 'arena>(
+    args: &'ast ArgumentList<'arena>,
+    index: usize,
+    name: &str,
+) -> Option<&'ast Expression<'arena>> {
+    for (ordinal, argument) in args.arguments.iter().enumerate() {
+        match argument {
+            Argument::Named(named) if bytes_to_str(named.name.value).eq_ignore_ascii_case(name) => {
+                return Some(named.value);
+            }
+            Argument::Positional(positional) if ordinal == index => return Some(positional.value),
+            _ => {}
+        }
+    }
+    None
+}
+
+fn class_family(
+    class: &ClassInfo,
+    loader: &dyn Fn(&str) -> Option<Arc<ClassInfo>>,
+    predicate: fn(&str) -> bool,
+) -> bool {
+    predicate(&class.fqn()) || walks_parent_chain(class, loader, predicate)
+}
+fn is_factory(name: &str) -> bool {
+    [
+        "Illuminate\\Validation\\Factory",
+        "Illuminate\\Contracts\\Validation\\Factory",
+    ]
+    .iter()
+    .any(|n| name.eq_ignore_ascii_case(n))
+}
+fn is_validator(name: &str) -> bool {
+    [
+        "Illuminate\\Validation\\Validator",
+        "Illuminate\\Contracts\\Validation\\Validator",
+    ]
+    .iter()
+    .any(|n| name.eq_ignore_ascii_case(n))
+}
+fn has_validation_trait(
+    class: &ClassInfo,
+    loader: &dyn Fn(&str) -> Option<Arc<ClassInfo>>,
+    depth: u32,
+) -> bool {
+    if depth > MAX_INHERITANCE_DEPTH {
+        return false;
+    }
+    class.used_traits.iter().any(|name| {
+        name.eq_ignore_ascii_case("Illuminate\\Foundation\\Validation\\ValidatesRequests")
+            || loader(name).is_some_and(|c| has_validation_trait(&c, loader, depth + 1))
+    }) || class
+        .parent_class
+        .as_ref()
+        .and_then(|p| loader(p))
+        .is_some_and(|c| has_validation_trait(&c, loader, depth + 1))
+}
+
+fn rule_value_site(
+    expr: &Expression<'_>,
+    content: &str,
+    quote: usize,
+) -> Option<(usize, usize, bool)> {
+    match expr {
+        Expression::Parenthesized(p) => rule_value_site(p.expression, content, quote),
+        Expression::Array(a) => rule_elements(a.elements.iter(), content, quote),
+        Expression::LegacyArray(a) => rule_elements(a.elements.iter(), content, quote),
+        Expression::Call(Call::Function(call)) if matches!(call.function,Expression::Identifier(i) if i.value().eq_ignore_ascii_case(b"array_merge")) => {
+            call.argument_list
+                .arguments
+                .iter()
+                .find_map(|a| rule_value_site(a.value(), content, quote))
+        }
+        _ => None,
+    }
+}
+fn rule_elements<'a>(
+    elements: impl Iterator<Item = &'a ArrayElement<'a>>,
+    content: &str,
+    quote: usize,
+) -> Option<(usize, usize, bool)> {
+    for element in elements {
+        let ArrayElement::KeyValue(kv) = element else {
+            continue;
+        };
+        if !matches!(kv.key, Expression::Literal(literal::Literal::String(_))) {
+            continue;
+        }
+        if let Some((s, e)) = literal_site(kv.value, content, quote) {
+            return Some((s, e, true));
+        }
+        let values = match kv.value {
+            Expression::Array(a) => Some(a.elements.iter()),
+            Expression::LegacyArray(a) => Some(a.elements.iter()),
+            _ => None,
+        };
+        if let Some(values) = values {
+            for value in values {
+                if let ArrayElement::Value(v) = value
+                    && let Some((s, e)) = literal_site(v.value, content, quote)
+                {
+                    return Some((s, e, false));
+                }
+            }
+        }
+    }
+    None
+}
+fn literal_site(expr: &Expression<'_>, content: &str, quote: usize) -> Option<(usize, usize)> {
+    let Expression::Literal(literal::Literal::String(s)) = expr else {
+        return None;
+    };
+    let start = s.span.start.offset as usize;
+    let end = (s.span.end.offset as usize).min(content.len());
+    if start != quote || end <= start {
+        return None;
+    }
+    if end >= start + 2 && content.as_bytes().get(start) == content.as_bytes().get(end - 1) {
+        Some((start + 1, end - 1))
+    } else if end == content.len() {
+        // The private parse buffer supplied the closing quote; the original
+        // token ends at EOF, so that synthetic quote is outside the edit.
+        Some((start + 1, end))
+    } else {
+        None
+    }
+}

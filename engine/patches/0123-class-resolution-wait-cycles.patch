+#[test]
+fn concurrent_mixin_cycle_does_not_wait_for_the_pending_escape_hatch() {
+    assert_concurrent_mixin_cycle(2);
+}
+
+#[test]
+fn concurrent_mixin_cycle_detects_transitive_wait_owners() {
+    assert_concurrent_mixin_cycle(3);
+}
+
+fn assert_concurrent_mixin_cycle(count: usize) {
+    use std::cell::Cell;
+    use std::sync::Barrier;
+    use std::time::{Duration, Instant};
+    let classes = Arc::new(
+        (0..count)
+            .map(|index| {
+                let mut class = make_class(&format!("Cycle\\Node{index}"));
+                class.mixins = vec![atom(&format!("Cycle\\Node{}", (index + 1) % count))];
+                class
+                    .methods
+                    .push(Arc::new(make_method(&format!("from{index}"), Some("void"))));
+                class.rebuild_method_index();
+                Arc::new(class)
+            })
+            .collect::<Vec<_>>(),
+    );
+    let cache = new_resolved_class_cache();
+    let gate = Arc::new(Barrier::new(count));
+    let start = Instant::now();
+    let workers = (0..count)
+        .map(|index| {
+            let classes = Arc::clone(&classes);
+            let cache = Arc::clone(&cache);
+            let gate = Arc::clone(&gate);
+            std::thread::spawn(move || {
+                let first = Cell::new(true);
+                let other = classes[(index + 1) % count].fqn();
+                let loader = |name: &str| {
+                    let name = name.trim_start_matches('\\');
+                    if name == other.as_str() && first.replace(false) {
+                        gate.wait();
+                    }
+                    classes
+                        .iter()
+                        .find(|class| class.fqn().as_str() == name)
+                        .cloned()
+                };
+                resolve_class_fully_cached(&classes[index], &loader, &cache)
+            })
+        })
+        .collect::<Vec<_>>();
+    let results = workers
+        .into_iter()
+        .map(|worker| worker.join().unwrap())
+        .collect::<Vec<_>>();
+    let elapsed = start.elapsed();
+    for class in results {
+        for index in 0..count {
+            let name = format!("from{index}");
+            assert!(
+                class
+                    .methods
+                    .iter()
+                    .any(|method| method.name.as_str() == name.as_str())
+            );
+        }
+    }
+    eprintln!("{count}-owner mixin cycle: {elapsed:?}");
+    assert!(
+        elapsed < Duration::from_secs(1),
+        "a real dependency cycle must not wait for the five-second escape hatch: {elapsed:?}"
+    );
+}

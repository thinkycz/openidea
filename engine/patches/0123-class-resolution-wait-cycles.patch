+/// Removes a wait edge when the synchronous wait completes or unwinds.
+struct PendingWaitGuard<'a> {
+    cache: &'a ResolvedClassCache,
+}
+
+impl Drop for PendingWaitGuard<'_> {
+    fn drop(&mut self) {
+        self.cache.write().end_pending_wait();
+    }
+}

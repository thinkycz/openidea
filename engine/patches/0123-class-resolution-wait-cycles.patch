+    /// Register a pending wait unless it would participate in a dependency cycle.
+    /// Edges retain keys rather than owner IDs, so released/replaced claims
+    /// cannot leave a stale owner relationship in the graph.
+    pub(crate) fn begin_pending_wait(&mut self, key: &ResolvedClassCacheKey) -> bool {
+        let current = std::thread::current().id();
+        self.waiting.insert(current, key.clone());
+        let mut thread = current;
+        let mut seen = HashSet::new();
+        while seen.insert(thread) {
+            let Some(waited_key) = self.waiting.get(&thread) else {
+                return true;
+            };
+            let Some(owner) = self.pending.get(waited_key) else {
+                return true;
+            };
+            thread = *owner;
+        }
+        self.waiting.remove(&current);
+        false
+    }
+
+    /// Remove this thread's pending wait on completion or unwinding.
+    pub(crate) fn end_pending_wait(&mut self) {
+        self.waiting.remove(&std::thread::current().id());
+    }

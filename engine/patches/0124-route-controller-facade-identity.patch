+#[tokio::test]
+async fn controller_group_alias_and_fqn_have_navigation_and_completion() {
+    for (import, facade) in [
+        (
+            "use Illuminate\\Support\\Facades\\Route as Routes;",
+            "Routes",
+        ),
+        (
+            "use Illuminate\\Support\\Facades\\{Route as Routes};",
+            "Routes",
+        ),
+        ("", "\\Illuminate\\Support\\Facades\\Route"),
+    ] {
+        let backend = create_test_backend();
+        let uri = Url::parse("file:///routes.php").unwrap();
+        let text = format!(
+            "<?php\nnamespace App;\n{import}\nclass InvoiceController {{ public function showInvoice() {{}} }}\n{facade}::controller(InvoiceController::class)->group(function () {{\n    {facade}::get('/invoice', 'showInvoice');\n}});\n"
+        );
+        open_php(&backend, &uri, &text).await;
+        let col = text.lines().nth(5).unwrap().find("showInvoice").unwrap() as u32;
+        let target = goto_def(&backend, &uri, 5, col + 2).await;
+        assert!(target.is_some(), "{facade} definition: {target:?}");
+        let items = complete_at(&backend, &uri, &text, 5, col + 2).await;
+        assert!(
+            method_labels(&items)
+                .iter()
+                .any(|name| name == "showInvoice"),
+            "{facade} completion: {items:?}"
+        );
+    }
+}
+
+#[tokio::test]
+async fn controller_group_does_not_borrow_laravel_actions_for_other_classes() {
+    for (import, facade) in [
+        ("use Acme\\Route;", "Route"),
+        ("use Acme\\Route as Routes;", "Routes"),
+        ("", "Route"),
+    ] {
+        let backend = create_test_backend();
+        let uri = Url::parse("file:///routes.php").unwrap();
+        let text = format!(
+            "<?php\nnamespace App;\n{import}\nclass InvoiceController {{ public function showInvoice() {{}} }}\n{facade}::controller(InvoiceController::class)->group(function () {{\n    {facade}::get('/invoice', 'showInvoice');\n}});\n"
+        );
+        open_php(&backend, &uri, &text).await;
+        let col = text.lines().nth(5).unwrap().find("showInvoice").unwrap() as u32;
+        let target = goto_def(&backend, &uri, 5, col + 2).await;
+        assert!(
+            target.is_none(),
+            "non-Laravel {facade} definition: {target:?}"
+        );
+        let items = complete_at(&backend, &uri, &text, 5, col + 2).await;
+        assert!(
+            !method_labels(&items)
+                .iter()
+                .any(|name| name == "showInvoice"),
+            "non-Laravel {facade} completion: {items:?}"
+        );
+    }
+}

+#[tokio::test]
+async fn quoted_controller_action_completion_commits_whole_name_with_utf16_ranges() {
+    use crate::common::{apply_edits, position_after};
+    for (existing, prefix_len) in [
+        ("showInvoice", 0),
+        ("showInvoice", 1),
+        ("showInvoice", 2),
+        ("showInvoice", 11),
+        ("showInvoiceExtra", 2),
+        ("showInvoicé", 2),
+    ] {
+        let backend = create_test_backend();
+        let uri = Url::parse("file:///route-action.php").unwrap();
+        let text = format!(
+            "<?php\nuse Illuminate\\Support\\Facades\\Route as Routes;\nclass InvoiceController {{ public function showInvoice() {{}} }}\nRoutes::controller(InvoiceController::class)->group(function () {{\n    Routes::get('/😀/invoice', '{existing}');\n}});\n"
+        );
+        let at = position_after(&text, &format!(", '{}", &existing[..prefix_len]));
+        let items = complete_at(&backend, &uri, &text, at.line, at.character).await;
+        let item = items
+            .into_iter()
+            .find(|i| i.filter_text.as_deref() == Some("showInvoice"))
+            .expect("controller method candidate");
+        // Sole-candidate insertion follows the client's normal prefix-only Enter
+        // behavior unless the provider supplies a replacement edit for this atom.
+        let resolved = backend.completion_resolve(item.clone()).await.unwrap();
+        for item in [item, resolved] {
+            let edit = match item.text_edit {
+                Some(CompletionTextEdit::Edit(edit)) => edit,
+                Some(CompletionTextEdit::InsertAndReplace(edit)) => TextEdit {
+                    range: edit.insert,
+                    new_text: edit.new_text,
+                },
+                None => TextEdit {
+                    range: Range::new(
+                        {
+                            let mut start = at;
+                            start.character -= prefix_len as u32;
+                            start
+                        },
+                        at,
+                    ),
+                    new_text: item.insert_text.unwrap_or(item.label),
+                },
+            };
+            let updated = apply_edits(&text, &[edit]);
+            let expected = text.replace(&format!("'{existing}'"), "'showInvoice'");
+            assert_eq!(
+                updated, expected,
+                "commit at {at:?} must preserve the quote, URI and controller group without duplicating the suffix"
+            );
+        }
+    }
+}

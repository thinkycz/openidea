+    /// Route names affect sibling declarations and route callers even when no
+    /// PHP class/function signature changed. Only inspect open semantic maps;
+    /// route discovery and external tools stay off this publication path.
+    pub(crate) fn open_files_affected_by_route_sources<'a>(
+        &self,
+        changed_uris: impl Iterator<Item = &'a str>,
+        excluded: &HashSet<&str>,
+    ) -> Vec<String> {
+        let mut changed_uris = changed_uris.peekable();
+        if changed_uris.peek().is_none() || !self.resolved_class_cache.read().is_laravel() {
+            return Vec::new();
+        }
+        let known = self.laravel_string_key_cache.read().routes.clone();
+        let is_route_source = |uri: &str| {
+            uri.contains("/routes/")
+                || known
+                    .as_ref()
+                    .is_some_and(|routes| routes.sources.contains_key(uri))
+                || tower_lsp::lsp_types::Url::parse(uri)
+                    .ok()
+                    .and_then(|url| url.to_file_path().ok())
+                    .is_some_and(|path| {
+                        self.laravel_provider_resources
+                            .read()
+                            .route_files
+                            .contains(&path)
+                    })
+        };
+        if !changed_uris.any(is_route_source) {
+            return Vec::new();
+        }
+        // Explicit provider/include sources need the same invalidation as a
+        // conventional routes/ file. Keep the old provenance for target selection.
+        self.laravel_string_key_cache.write().routes = None;
+        let open: Vec<_> = self.open_files.read().keys().cloned().collect();
+        open.into_iter()
+            .filter(|uri| !excluded.contains(uri.as_str()))
+            .filter(|uri| {
+                is_route_source(uri)
+                    || self.symbol_maps.read().get(uri).is_some_and(|map| {
+                        map.spans.iter().any(|span| {
+                            matches!(
+                                span.kind,
+                                crate::symbol_map::SymbolKind::LaravelStringKey {
+                                    kind: crate::symbol_map::LaravelStringKind::Route,
+                                    ..
+                                }
+                            )
+                        })
+                    })
+            })
+            .collect()
     }
 

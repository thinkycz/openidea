+#[tokio::test]
+async fn unsaved_route_changes_republish_unchanged_sibling_duplicate_diagnostics() {
+    let (_directory, root) = projects();
+    let project = root.join("apps/a");
+    write(
+        &project,
+        "composer.json",
+        crate::common::LARAVEL_SRC_COMPOSER,
+    );
+    let first = "<?php\nuse Illuminate\\Support\\Facades\\Route as Routes;\nRoutes::get('/a/😀', 'show')->name('shared');\n";
+    let original = "<?php\nuse Illuminate\\Support\\Facades\\Route as Routes;\nRoutes::get('/b', 'show')->name('shared');\n";
+    write(&project, "routes/web.php", first);
+    write(&project, "routes/api.php", original);
+    let first_uri = Url::from_file_path(project.join("routes/web.php")).unwrap();
+    let other_uri = Url::from_file_path(project.join("routes/api.php")).unwrap();
+    let mut wire = Wire::start(&root).await;
+    wire.open(&first_uri, 1, first).await;
+    wire.open(&other_uri, 1, original).await;
+    let has_duplicate = |p: &Value| {
+        p["diagnostics"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .any(|d| d["code"].as_str() == Some("duplicate_laravel_route"))
+    };
+    let initial = wire.publication(&first_uri, 1, Some(true), 0).await;
+    assert!(
+        has_duplicate(&initial),
+        "initial sibling warning: {initial}"
+    );
+    eprintln!("initial unchanged sibling warning published");
+    let mut sequence = envelope(&initial, 1, 1);
+    let initial_other = wire.publication(&other_uri, 1, Some(true), 0).await;
+    assert!(has_duplicate(&initial_other));
+    eprintln!("both initial duplicate warnings published");
+    for (version, changed, expected) in [
+        (2, original.replace("'shared'", "'unique'"), false),
+        (
+            3,
+            original.replacen("<?php\n", "<?php\n// moved 😀\n", 1),
+            true,
+        ),
+        (4, "<?php\n".to_owned(), false),
+    ] {
+        let since = wire.seen.len();
+        wire.change(&other_uri, version, &changed).await;
+        wire.barrier(&other_uri).await;
+        let edited = wire
+            .publication(&other_uri, version, Some(true), since)
+            .await;
+        assert_eq!(
+            has_duplicate(&edited),
+            expected,
+            "edited version {version}: {edited}"
+        );
+        eprintln!("edited version {version} complete; awaiting unchanged sibling");
+        let sibling = wire.publication(&first_uri, 1, Some(true), since).await;
+        assert_eq!(
+            has_duplicate(&sibling),
+            expected,
+            "unchanged sibling at edit {version}: {sibling}"
+        );
+        if version == 3 {
+            let warning = sibling["diagnostics"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .find(|d| d["code"].as_str() == Some("duplicate_laravel_route"))
+                .unwrap();
+            assert_eq!(
+                warning["relatedInformation"][0]["location"]["range"]["start"]["line"],
+                3
+            );
+        }
+        let next_sequence = envelope(&sibling, 1, 1);
+        assert!(
+            next_sequence > sequence,
+            "sibling refresh must advance its publication sequence"
+        );
+        sequence = next_sequence;
+        assert_eq!(
+            fs::read_to_string(project.join("routes/api.php")).unwrap(),
+            original
+        );
+    }
+    let since = wire.seen.len();
+    wire.notify(
+        "textDocument/didClose",
+        json!({"textDocument":{"uri":other_uri}}),
+    )
+    .await;
+    wire.barrier(&first_uri).await;
+    let restored = wire.publication(&first_uri, 1, Some(true), since).await;
+    assert!(
+        has_duplicate(&restored),
+        "closing overlay must restore the disk registration: {restored}"
+    );
+    let since = wire.seen.len();
+    wire.open(&other_uri, 1, &original.replace("'shared'", "'unique'"))
+        .await;
+    let reopened = wire.publication(&other_uri, 1, Some(true), since).await;
+    assert!(!has_duplicate(&reopened));
+    let opening = reopened["phpantomDocumentOpen"].as_u64().unwrap();
+    assert!(opening > initial_other["phpantomDocumentOpen"].as_u64().unwrap());
+    envelope(&reopened, 1, opening);
+
+    let sibling = wire.publication(&first_uri, 1, Some(true), since).await;
+    assert!(
+        !has_duplicate(&sibling),
+        "reopened overlay must refresh the unchanged sibling: {sibling}"
+    );
+    assert_eq!(
+        fs::read_to_string(project.join("routes/api.php")).unwrap(),
+        original
+    );
+    wire.finish().await;
+}

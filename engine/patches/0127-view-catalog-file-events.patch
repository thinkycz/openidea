 impl crate::Backend {
+    /// Check one structural file batch against current configured and registered
+    /// roots. Refresh config roots once, including directories created since the
+    /// last scan, without mutating the catalog before publication.
+    pub(crate) fn view_template_structure_changed(&self, paths: &[PathBuf]) -> bool {
+        if paths.is_empty() {
+            return false;
+        }
+        let Some(root) = self.workspace.workspace_root.read().clone() else {
+            return false;
+        };
+        let config_uri = crate::util::path_to_uri(&root.join("config/view.php"));
+        let config = self.get_file_content_arc(&config_uri);
+        let mut roots = view_paths_from_config(config.as_deref().map(String::as_str), &root);
+        // A removed directory no longer appears in fresh discovery, but its
+        // cached paths still have to be retired.
+        if let Some(cached) = self.laravel_string_key_cache.read().view_roots.as_ref() {
+            roots.extend(cached.iter().map(|root| root.path.clone()));
+            roots.extend(cached.iter().filter_map(|root| root.canonical.clone()));
+        }
+        roots.extend(
+            self.laravel_provider_resources
+                .read()
+                .view_dirs
+                .iter()
+                .map(|dir| dir.path.clone()),
+        );
+        roots.sort_unstable();
+        roots.dedup();
+        let canonical: Vec<_> = roots
+            .iter()
+            .filter_map(|root| root.canonicalize().ok())
+            .collect();
+        roots.extend(canonical);
+        let covered = |path: &Path| roots.iter().any(|root| path.starts_with(root));
+        paths
+            .iter()
+            .any(|path| covered(path) || covered(&canonical_path_for_comparison(path)))
+    }

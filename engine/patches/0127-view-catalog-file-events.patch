+        let config = root.join("config/view.php");
+        let original = "<?php return ['paths' => [base_path('themes/current')]];";
+        let alternate = original.replace("themes/current", "themes/alternate");
+        std::fs::write(&config, original).unwrap();
+        for (name, text) in [
+            ("themes/current/current-only.blade.php", "current"),
+            ("themes/alternate/alternate-only.blade.php", "alternate"),
+            ("resources/views/default-only.blade.php", "default"),
+        ] {
+            std::fs::write(root.join(name), text).unwrap();
+        }
+        let backend = Backend::new_test_with_workspace(root.clone(), Vec::new());
+        backend.resolved_class_cache.write().set_laravel(true);
+        let uri = Url::from_file_path(&config).unwrap();
+        assert_eq!(backend.blade_view_names(), ["current-only"]);
+        assert!(
+            !backend.parsed_uris.read().contains(uri.as_str()),
+            "configuration must remain cold"
+        );
+        let event = |typ| DidChangeWatchedFilesParams {
+            changes: vec![FileEvent {
+                uri: uri.clone(),
+                typ,
+            }],
+        };
+        std::fs::write(&config, &alternate).unwrap();
+        backend.apply_watched_file_changes(&event(FileChangeType::CHANGED), &root);
+        assert_eq!(backend.blade_view_names(), ["alternate-only"]);
+        std::fs::remove_file(&config).unwrap();
+        backend.apply_watched_file_changes(&event(FileChangeType::DELETED), &root);
+        assert_eq!(backend.blade_view_names(), ["default-only"]);
+        std::fs::write(&config, original).unwrap();
+        backend.apply_watched_file_changes(&event(FileChangeType::CREATED), &root);
+        assert_eq!(backend.blade_view_names(), ["current-only"]);
+
+        backend

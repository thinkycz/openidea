+    /// The real Laravel data lookup uses array-key presence, not null-coalescing,
+    /// and rendered data precedes the stack of still-open component tags.
+    #[tokio::test]
+    async fn aware_uses_component_data_presence_precedence_and_caller_alternatives() {
+        type AwareCase<'a> = (
+            &'a str,
+            &'a str,
+            &'a str,
+            &'a str,
+            &'a [&'a str],
+            &'a [&'a str],
+        );
+        let cases: &[AwareCase<'_>] = &[
+            (
+                "<x-parent :person=\"new \\App\\Item()\" />",
+                "@props(['person'])\n<x-leaf />",
+                "<div />",
+                "@aware(['person'])",
+                &["Item"],
+                &["mixed", "null"],
+            ),
+            (
+                "<x-parent :person=\"null\" />",
+                "<x-leaf />",
+                "<div />",
+                "@aware(['person' => 5])",
+                &["null"],
+                &["5"],
+            ),
+            (
+                "<x-parent :person=\"false\" />",
+                "<x-leaf />",
+                "<div />",
+                "@aware(['person' => 5])",
+                &["false"],
+                &["5"],
+            ),
+            (
+                "<x-parent />",
+                "@props(['person' => 7])\n<x-leaf />",
+                "<div />",
+                "@aware(['person' => 5])",
+                &["5"],
+                &["7"],
+            ),
+            (
+                "<x-parent />",
+                "<x-leaf />",
+                "<div />",
+                "@aware(['person'])",
+                &["null"],
+                &["mixed"],
+            ),
+            (
+                "<x-parent :person=\"new \\App\\Item()\" />",
+                "<x-leaf :person=\"false\" />",
+                "<div />",
+                "@aware(['person' => 5])",
+                &["false"],
+                &["Item", "5"],
+            ),
+            (
+                "<x-parent person=\"outer\"><x-leaf /></x-parent>",
+                "<div />",
+                "<div />",
+                "@aware(['person'])",
+                &["outer"],
+                &["mixed"],
+            ),
+            (
+                "<x-parent person=\"outer\" />",
+                "<x-middle person=\"near\"><x-leaf /></x-middle>",
+                "<div />",
+                "@aware(['person'])",
+                &["outer"],
+                &["near"],
+            ),
+            (
+                "<x-parent person=\"outer\" />",
+                "<x-middle person=\"near\"><x-leaf :person=\"false\" /></x-middle>",
+                "<div />",
+                "@aware(['person'])",
+                &["false"],
+                &["outer", "near"],
+            ),
+            (
+                "<x-parent person=\"outer\" />",
+                "<x-middle />",
+                "<x-leaf />",
+                "@aware(['person'])",
+                &["outer"],
+                &["mixed"],
+            ),
+            (
+                "<x-parent person=\"outer\" /><x-parent />",
+                "@props(['person' => 7])\n<x-leaf />",
+                "<div />",
+                "@aware(['person' => 5])",
+                &["outer", "5"],
+                &["7"],
+            ),
+            (
+                "<x-parent :person=\"null\" /><x-parent :person=\"false\" />",
+                "<x-leaf />",
+                "<div />",
+                "@aware(['person' => 5])",
+                &["null", "false"],
+                &["5"],
+            ),
+            (
+                "<x-parent person=\"outer\" />",
+                "<x-leaf />",
+                "<div />",
+                "@php /** @var int $person */ @endphp\n@aware(['person'])",
+                &["int"],
+                &["outer"],
+            ),
+            (
+                "@include('components.leaf', ['person' => new \\App\\Item()])",
+                "<div />",
+                "<div />",
+                "@aware(['person' => 5])",
+                &["5"],
+                &["Item"],
+            ),
+            (
+                "<x-parent person=\"outer\" />",
+                "@include('components.leaf')",
+                "<div />",
+                "@aware(['person'])",
+                &["outer"],
+                &["mixed"],
+            ),
+            (
+                "<x-parent person=\"outer\" /><x-parent person=\"stack\"><x-leaf /></x-parent>",
+                "@props(['person'])\n<x-leaf />",
+                "<div />",
+                "@aware(['person' => 5])",
+                &["outer", "stack"],
+                &["5"],
+            ),
+            (
+                "<x-unknown><x-leaf /></x-unknown>",
+                "<div />",
+                "<div />",
+                "@aware(['person' => 5])",
+                &["mixed"],
+                &["Item"],
+            ),
+        ];
+        for &(page, parent, middle, declaration, expected, absent) in cases {
+            let leaf = format!("{declaration}\n{{{{ $person }}}}\n");
+            let (backend, _dir) = create_psr4_workspace(
+                APP_PSR4_COMPOSER,
+                &[
+                    ("app/Item.php", ITEM_CLASS),
+                    ("resources/views/page.blade.php", page),
+                    ("resources/views/components/parent.blade.php", parent),
+                    ("resources/views/components/middle.blade.php", middle),
+                    ("resources/views/components/leaf.blade.php", &leaf),
+                ],
+            );
+            for (path, text) in [
+                ("resources/views/page.blade.php", page),
+                ("resources/views/components/parent.blade.php", parent),
+                ("resources/views/components/middle.blade.php", middle),
+                ("resources/views/components/leaf.blade.php", leaf.as_str()),
+            ] {
+                open_document(&backend, &workspace_uri(&backend, path), "blade", text).await;
+            }
+            let uri = workspace_uri(&backend, "resources/views/components/leaf.blade.php");
+            let hover = hover_type(&backend, &uri, declaration.lines().count() as u32, 4).await;
+            assert!(
+                expected.iter().all(|ty| hover.contains(ty))
+                    && absent.iter().all(|ty| !hover.contains(ty)),
+                "page={page:?} parent={parent:?} middle={middle:?} declaration={declaration:?}: expected={expected:?}, absent={absent:?}, got={hover}"
+            );
+        }
+    }

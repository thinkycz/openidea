+/// Data from still-open tag ancestors, outermost to nearest. Slots are syntax,
+/// not components that push data, and self-closing tags cannot enclose a call.
+fn component_ancestor_data(inputs: &[ConsumableComponentInput], offset: usize) -> ComponentData {

+    #[tokio::test]
+    async fn aware_class_component_data_is_not_proven_absent_from_its_attribute_bag() {
+        use crate::common::{BLADE_COMPONENT_COMPOSER, ILLUMINATE_COMPONENT_STUB};
+        let class = "<?php namespace App\\View\\Components; class ParentCard extends \\Illuminate\\View\\Component { public function __construct(public \\App\\Item $person) {} public function render() { return view('components.parent-card'); } }";
+        let page = "<x-parent-card :person=\"new \\App\\Item()\" />";
+        let parent = "<x-leaf />";
+        let leaf = "@aware(['person' => 5])\n{{ $person }}\n";
+        let (backend, _dir) = create_psr4_workspace(
+            BLADE_COMPONENT_COMPOSER,
+            &[
+                (
+                    "stubs/Illuminate/View/Component.php",
+                    ILLUMINATE_COMPONENT_STUB,
+                ),
+                ("app/Item.php", ITEM_CLASS),
+                ("app/View/Components/ParentCard.php", class),
+                ("resources/views/page.blade.php", page),
+                ("resources/views/components/parent-card.blade.php", parent),
+                ("resources/views/components/leaf.blade.php", leaf),
+            ],
+        );
+        open_document(
+            &backend,
+            &workspace_uri(&backend, "app/View/Components/ParentCard.php"),
+            "php",
+            class,
+        )
+        .await;
+        for (path, text) in [
+            ("resources/views/page.blade.php", page),
+            ("resources/views/components/parent-card.blade.php", parent),
+            ("resources/views/components/leaf.blade.php", leaf),
+        ] {
+            open_document(&backend, &workspace_uri(&backend, path), "blade", text).await;
+        }
+        let hover = hover_type(
+            &backend,
+            &workspace_uri(&backend, "resources/views/components/leaf.blade.php"),
+            1,
+            4,
+        )
+        .await;
+        // Class-backed data is currently conservative. A future exact exposure
+        // model may prove Item; neither result may assert the key is absent.
+        assert!(
+            hover.contains("mixed") || hover.contains("Item"),
+            "class render data must not become only the aware default: {hover}"
+        );
+    }

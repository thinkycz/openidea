@@ -0,0 +1,344 @@
+//! The two data channels used by Laravel's getConsumableComponentData.
+//!
+//! Rendered component data takes precedence over still-open component tags.
+//! Presence is independent of nullability: a supplied null prevents a default.
+//! Template-local @props defaults never enter either channel.
+
+use std::collections::{BTreeMap, BTreeSet};
+
+use crate::php_type::PhpType;
+
+use super::call_site_inference::join_call_site_types;
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct Binding {
+    ty: PhpType,
+    definite: bool,
+}
+
+/// An abstract data array, including whether unreadable keys may exist.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct ComponentData {
+    bindings: BTreeMap<String, Binding>,
+    complete: bool,
+}
+
+impl Default for ComponentData {
+    fn default() -> Self {
+        Self {
+            bindings: BTreeMap::new(),
+            complete: true,
+        }
+    }
+}
+
+/// A missing key differs from a key whose value happens to include null.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) enum ConsumableValue {
+    Absent,
+    Present(PhpType),
+    MaybePresent(PhpType),
+}
+
+impl ComponentData {
+    /// Known keys at one render site. Later duplicate keys win as in PHP.
+    pub(crate) fn supplied(values: impl IntoIterator<Item = (String, PhpType)>) -> Self {
+        Self {
+            bindings: values
+                .into_iter()
+                .map(|(name, ty)| {
+                    (
+                        name,
+                        Binding {
+                            ty: ty.simplified(),
+                            definite: true,
+                        },
+                    )
+                })
+                .collect(),
+            complete: true,
+        }
+    }
+
+    /// A data source whose possible keys or values cannot be read statically.
+    pub(crate) fn unknown() -> Self {
+        Self {
+            complete: false,
+            ..Self::default()
+        }
+    }
+
+    /// Resolve presence without applying a consumer's local default.
+    pub(crate) fn lookup(&self, name: &str) -> ConsumableValue {
+        match self.bindings.get(name) {
+            Some(binding) if binding.definite => ConsumableValue::Present(binding.ty.clone()),
+            Some(binding) => ConsumableValue::MaybePresent(binding.ty.clone()),
+            None if self.complete => ConsumableValue::Absent,
+            None => ConsumableValue::MaybePresent(PhpType::mixed()),
+        }
+    }
+
+    /// Resolve one newer key without rebuilding every unrelated entry.
+    fn lookup_over(&self, older: &Self, name: &str) -> ConsumableValue {
+        match self.lookup(name) {
+            value @ ConsumableValue::Present(_) => value,
+            ConsumableValue::Absent => older.lookup(name),
+            ConsumableValue::MaybePresent(ty) => match older.lookup(name) {
+                ConsumableValue::Absent => ConsumableValue::MaybePresent(ty),
+                ConsumableValue::Present(previous) => {
+                    ConsumableValue::Present(join_call_site_types(vec![previous, ty]).simplified())
+                }
+                ConsumableValue::MaybePresent(previous) => ConsumableValue::MaybePresent(
+                    join_call_site_types(vec![previous, ty]).simplified(),
+                ),
+            },
+        }
+    }
+
+    /// PHP array_merge semantics: newer supplied values override older ones.
+    pub(crate) fn overlay(&self, newer: &Self) -> Self {
+        let keys: BTreeSet<_> = self
+            .bindings
+            .keys()
+            .chain(newer.bindings.keys())
+            .cloned()
+            .collect();
+        let bindings = keys
+            .into_iter()
+            .filter_map(|name| {
+                let binding = match newer.lookup_over(self, &name) {
+                    ConsumableValue::Present(ty) => Binding { ty, definite: true },
+                    ConsumableValue::MaybePresent(ty) => Binding {
+                        ty,
+                        definite: false,
+                    },
+                    ConsumableValue::Absent => return None,
+                };
+                Some((name, binding))
+            })
+            .collect();
+        Self {
+            bindings,
+            complete: self.complete && newer.complete,
+        }
+    }
+}
+
+/// One possible caller's two correlated data channels.
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+struct ContextFrame {
+    current: ComponentData,
+    open: ComponentData,
+}
+
+/// Context inherited through view rendering, independent of local variables.
+/// Retain caller alternatives: merging the two channels independently would
+/// invent missing-key paths and apply defaults even when every caller supplies
+/// the key in one channel or the other.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct ConsumableContext {
+    frames: Vec<ContextFrame>,
+}
+
+impl Default for ConsumableContext {
+    fn default() -> Self {
+        Self {
+            frames: vec![ContextFrame::default()],
+        }
+    }
+}
+
+impl ConsumableContext {
+    /// Enter a component rendered inside a template's still-open tag ancestors.
+    pub(crate) fn enter(&self, ancestors: &ComponentData, supplied: &ComponentData) -> Self {
+        Self {
+            frames: self
+                .frames
+                .iter()
+                .map(|frame| ContextFrame {
+                    current: frame.current.overlay(supplied),
+                    open: frame.open.overlay(ancestors),
+                })
+                .collect(),
+        }
+    }
+
+    /// Current rendered data wins over even a nearer still-open component.
+    pub(crate) fn lookup(&self, name: &str) -> ConsumableValue {
+        let mut values = Vec::new();
+        let mut definite = true;
+        for frame in &self.frames {
+            match frame.current.lookup_over(&frame.open, name) {
+                ConsumableValue::Present(ty) => values.push(ty),
+                ConsumableValue::MaybePresent(ty) => {
+                    values.push(ty);
+                    definite = false;
+                }
+                ConsumableValue::Absent => definite = false,
+            }
+        }
+        if values.is_empty() {
+            ConsumableValue::Absent
+        } else {
+            let ty = join_call_site_types(values).simplified();
+            if definite {
+                ConsumableValue::Present(ty)
+            } else {
+                ConsumableValue::MaybePresent(ty)
+            }
+        }
+    }
+
+    /// Canonically ordered distinct caller contexts, without an iteration cap.
+    pub(crate) fn alternatives(sites: &[Self]) -> Self {
+        let mut frames: Vec<_> = sites
+            .iter()
+            .flat_map(|site| site.frames.iter().cloned())
+            .collect();
+        if frames.is_empty() {
+            return Self::default();
+        }
+        // BTreeMap fields and canonical type unions make this key stable across
+        // source/index traversal orders; allocate one key per retained frame.
+        frames.sort_by_cached_key(|frame| format!("{frame:?}"));
+        frames.dedup();
+        Self { frames }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn data(ty: &str) -> ComponentData {
+        ComponentData::supplied([("person".into(), PhpType::parse(ty))])
+    }
+
+    #[test]
+    fn null_false_and_nullable_values_are_present_not_missing() {
+        for ty in ["null", "false", "\\App\\User|null"] {
+            assert_eq!(
+                data(ty).lookup("person"),
+                ConsumableValue::Present(PhpType::parse(ty))
+            );
+        }
+        assert_eq!(
+            ComponentData::default().lookup("person"),
+            ConsumableValue::Absent
+        );
+    }
+
+    #[test]
+    fn nearest_open_tag_wins_until_rendered_data_supplies_the_key() {
+        let context =
+            ConsumableContext::default().enter(&data("\\App\\User"), &ComponentData::default());
+        let context = context.enter(&data("\\App\\Other"), &ComponentData::default());
+        assert_eq!(
+            context.lookup("person"),
+            ConsumableValue::Present(PhpType::parse("\\App\\Other"))
+        );
+        let rendered = context.enter(&ComponentData::default(), &data("null"));
+        assert_eq!(
+            rendered.lookup("person"),
+            ConsumableValue::Present(PhpType::parse("null"))
+        );
+    }
+
+    #[test]
+    fn rendered_parent_overrides_nearer_open_tag_but_child_data_overrides_both() {
+        let parent =
+            ConsumableContext::default().enter(&ComponentData::default(), &data("\\App\\User"));
+        let child = parent.enter(&data("\\App\\Other"), &ComponentData::default());
+        assert_eq!(
+            child.lookup("person"),
+            ConsumableValue::Present(PhpType::parse("\\App\\User"))
+        );
+        let child = parent.enter(&data("\\App\\Other"), &data("false"));
+        assert_eq!(
+            child.lookup("person"),
+            ConsumableValue::Present(PhpType::parse("false"))
+        );
+    }
+
+    #[test]
+    fn optional_caller_key_keeps_absence_distinct_from_null() {
+        let nullable = ConsumableContext::default().enter(&ComponentData::default(), &data("null"));
+        let optional = ConsumableContext::alternatives(&[nullable, ConsumableContext::default()]);
+        assert_eq!(
+            optional.lookup("person"),
+            ConsumableValue::MaybePresent(PhpType::parse("null"))
+        );
+        let fallback = optional.enter(&data("\\App\\User"), &ComponentData::default());
+        let ConsumableValue::Present(ty) = fallback.lookup("person") else {
+            panic!("open fallback supplies every absent key")
+        };
+        assert!(ty.equivalent(&PhpType::parse("\\App\\User|null")), "{ty}");
+    }
+
+    #[test]
+    fn unknown_data_cannot_assert_absence_or_an_older_value() {
+        assert_eq!(
+            ComponentData::unknown().lookup("person"),
+            ConsumableValue::MaybePresent(PhpType::mixed())
+        );
+        assert_eq!(
+            data("\\App\\User")
+                .overlay(&ComponentData::unknown())
+                .lookup("person"),
+            ConsumableValue::Present(PhpType::mixed())
+        );
+        assert_eq!(
+            ComponentData::unknown()
+                .overlay(&data("false"))
+                .lookup("person"),
+            ConsumableValue::Present(PhpType::parse("false"))
+        );
+    }
+
+    #[test]
+    fn alternative_order_and_duplicate_contexts_are_stable() {
+        let a = ConsumableContext::default().enter(&ComponentData::default(), &data("\\App\\User"));
+        let b = ConsumableContext::default().enter(&data("null"), &ComponentData::default());
+        let merged = ConsumableContext::alternatives(&[a.clone(), b.clone()]);
+        assert_eq!(merged, ConsumableContext::alternatives(&[b, a.clone(), a]));
+        let ConsumableValue::Present(ty) = merged.lookup("person") else {
+            panic!("every caller supplies the key in one of the channels")
+        };
+        assert!(ty.equivalent(&PhpType::parse("\\App\\User|null")), "{ty}");
+    }
+
+    #[test]
+    fn mixed_inside_a_supplied_union_does_not_retain_a_concrete_model() {
+        assert_eq!(
+            data("\\App\\User|mixed").lookup("person"),
+            ConsumableValue::Present(PhpType::mixed())
+        );
+    }
+
+    #[test]
+    fn correlated_channels_do_not_reintroduce_a_masked_parent_value() {
+        let a = ConsumableContext::default().enter(&data("\\App\\Masked"), &data("\\App\\User"));
+        let b =
+            ConsumableContext::default().enter(&data("\\App\\Other"), &ComponentData::default());
+        let merged = ConsumableContext::alternatives(&[a, b]);
+        let ConsumableValue::Present(ty) = merged.lookup("person") else {
+            panic!("every caller supplies a value")
+        };
+        assert!(
+            ty.equivalent(&PhpType::parse("\\App\\User|\\App\\Other")),
+            "{ty}"
+        );
+    }
+
+    #[test]
+    fn duplicate_supplied_key_uses_the_last_value() {
+        let values = ComponentData::supplied([
+            ("person".into(), PhpType::parse("null")),
+            ("person".into(), PhpType::parse("false")),
+        ]);
+        assert_eq!(
+            values.lookup("person"),
+            ConsumableValue::Present(PhpType::parse("false"))
+        );
+    }
+}

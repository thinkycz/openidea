+/// Skip a Blade echo while respecting PHP strings, comments and nested scopes.
+/// Its expression is emitted by the streaming preprocessor, not as HTML attrs.
+fn attribute_echo_end(bytes: &[u8], start: usize) -> usize {
+    use crate::text_scan::{find_matching_forward_bytes, skip_php_comment, skip_string_forward};
+    let (open, close) = crate::blade::signature::echo_delimiters(bytes, start);
+    let mut at = start + open.len();
+    while at < bytes.len() {
+        if bytes[at..].starts_with(close.as_bytes()) {
+            return at + close.len();
+        }
+        if let Some(end) = skip_php_comment(bytes, at) {
+            at = end;
+            continue;
+        }
+        match bytes[at] {
+            b'\'' | b'"' => {
+                at = skip_string_forward(bytes, at);
+                continue;
+            }
+            open @ (b'(' | b'[' | b'{') => {
+                let close = match open {
+                    b'(' => b')',
+                    b'[' => b']',
+                    _ => b'}',
+                };
+                let Some(end) = find_matching_forward_bytes(bytes, at, open, close) else {
+                    return bytes.len();
+                };
+                at = end + 1;
+                continue;
+            }
+            _ => at += 1,
+        }
+    }
+    bytes.len()
 }
 

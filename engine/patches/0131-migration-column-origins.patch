+#[tokio::test]
+async fn schema_columns_do_not_override_declared_or_documented_properties() {
+    use crate::common::{definition_locations, goto_definition_at, open_php};
+    for declaration in [
+        "class User extends Model { public string $email; }",
+        "/** @property string $email */\nclass User extends Model {}",
+        "/** @property bool $email */\nclass User extends Model { public string $email; }",
+    ] {
+        let (backend, dir, uri) = workspace(
+            &[(
+                "2024_01_01_000000_create_users_table.php",
+                migration(CREATE_USERS),
+            )],
+            USER_CONSUMER,
+        )
+        .await;
+        let model_uri = Url::from_file_path(dir.path().join("app/Models/User.php")).unwrap();
+        open_php(
+            &backend,
+            &model_uri,
+            &USER_MODEL_PHP.replace("class User extends Model {}", declaration),
+        )
+        .await;
+        let cursor = position_of(USER_CONSUMER, "email;");
+        let targets = definition_locations(
+            goto_definition_at(&backend, &uri, cursor.line, cursor.character).await,
+        );
+        assert!(
+            targets.iter().any(|target| target.uri == model_uri),
+            "own declaration {declaration} must win: {targets:?}"
+        );
+        assert!(
+            !targets
+                .iter()
+                .any(|target| target.uri.path().contains("/migrations/"))
+        );
+        if declaration.contains("public string $email") {
+            let model = USER_MODEL_PHP.replace("class User extends Model {}", declaration);
+            assert_eq!(targets[0].range.start, position_of(&model, "email; }"));
+        }
+    }
+}

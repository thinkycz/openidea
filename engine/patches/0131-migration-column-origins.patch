+/// Find the parsed migration declaration for a model schema column.
+pub(crate) fn model_schema_column_definition(
+    class: &ClassInfo,
+    class_loader: &dyn Fn(&str) -> Option<Arc<ClassInfo>>,
+    cache: Option<&ResolvedClassCache>,
+    column: &str,
+) -> Option<database_schema::MigrationColumnDefinition> {
+    let effective =
+        crate::virtual_members::resolve_class_fully_maybe_cached(class, class_loader, cache);
+    let Some(PropertySource::DatabaseColumn { column: source, .. }) =
+        &effective.get_property(column)?.source
+    else {
+        return None;
+    };
+    cache?
+        .read()
+        .schema_index()
+        .table(&source.connection, &source.table)?
+        .column(&source.column)?
+        .definition
+        .clone()
+}

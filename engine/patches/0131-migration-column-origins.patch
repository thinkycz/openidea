+#[tokio::test]
+async fn model_phpdoc_origins_are_scoped_to_the_declaring_class() {
+    use crate::common::{definition_locations, goto_definition_at, open_php};
+    let prefix = "<?php\nnamespace App\\Models;\nuse Illuminate\\Database\\Eloquent\\Model;\n/** @property string $email */\nclass Decoy extends Model {}\n";
+    let comment = "/** @property string $email */\n";
+    let expected = tower_lsp::lsp_types::Position::new(
+        prefix.bytes().filter(|byte| *byte == b'\n').count() as u32,
+        comment[..comment.find("$email").unwrap() + 1]
+            .encode_utf16()
+            .count() as u32,
+    );
+    for between in [
+        "",
+        "#[Marker('/** @property string $email */')]\n",
+        "// /** @property string $email */\n",
+    ] {
+        let (backend, dir, uri) = workspace(
+            &[(
+                "2024_01_01_000000_create_users_table.php",
+                migration(CREATE_USERS),
+            )],
+            USER_CONSUMER,
+        )
+        .await;
+        let source = format!("{prefix}{comment}{between}class User extends Model {{}}\n");
+        let model = Url::from_file_path(dir.path().join("app/Models/User.php")).unwrap();
+        open_php(&backend, &model, &source).await;
+        let cursor = position_of(USER_CONSUMER, "email;");
+        let targets = definition_locations(
+            goto_definition_at(&backend, &uri, cursor.line, cursor.character).await,
+        );
+        assert_eq!(targets.len(), 1, "{between}: {targets:?}");
+        assert_eq!(targets[0].uri, model);
+        assert_eq!(targets[0].range.start, expected, "{between}");
+    }

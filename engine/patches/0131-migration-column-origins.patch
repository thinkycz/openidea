+#[tokio::test]
+async fn column_definitions_link_to_migrations_not_later_indexes() {
+    use crate::common::{definition_locations, goto_definition_at};
+    let source = migration(&CREATE_USERS.replace(
+        "$table->string('email')",
+        "$tag = '😀'; $table->string('email')",
+    ));
+    let (backend, dir, uri) = workspace(
+        &[("2024_01_01_000000_create_users_table.php", source.clone())],
+        USER_CONSUMER,
+    )
+    .await;
+    for name in ["email", "email_verified_at", "is_active"] {
+        let cursor = position_of(USER_CONSUMER, &format!("{name};"));
+        let targets = definition_locations(
+            goto_definition_at(&backend, &uri, cursor.line, cursor.character).await,
+        );
+        assert_eq!(targets.len(), 1, "{name}: {targets:?}");
+        assert_eq!(
+            targets[0].uri.to_file_path().unwrap(),
+            dir.path()
+                .join("database/migrations/2024_01_01_000000_create_users_table.php")
+        );
+        let expected = position_of(&source, &format!("'{name}'"));
+        assert_eq!(targets[0].range.start.line, expected.line);
+        assert_eq!(targets[0].range.start.character, expected.character + 1);
+    }

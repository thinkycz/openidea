+#[tokio::test]
+async fn unsaved_migration_columns_update_navigation_and_close_restores_disk() {
+    use crate::common::{definition_locations, goto_definition_at, open_php};
+    use tower_lsp::{LanguageServer, lsp_types::*};
+    let original = migration(CREATE_USERS);
+    let name = "2024_01_01_000000_create_users_table.php";
+    let (backend, dir, uri) = workspace(&[(name, original.clone())], USER_CONSUMER).await;
+    let migration_uri =
+        Url::from_file_path(dir.path().join("database/migrations").join(name)).unwrap();
+    let changed = original
+        .replace("<?php\n", "<?php\n// 😀 unsaved\n")
+        .replace("'email'", "'contact_email'");
+    open_php(&backend, &migration_uri, &changed).await;
+    let consumer = USER_CONSUMER.replace("$user->email;", "$user->contact_email;");
+    backend
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: uri.clone(),
+                version: 2,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: consumer.clone(),
+            }],
+        })
+        .await;
+    let cursor = position_of(&consumer, "contact_email;");
+    let targets = definition_locations(
+        goto_definition_at(&backend, &uri, cursor.line, cursor.character).await,
+    );
+    assert_eq!(
+        targets.len(),
+        1,
+        "unsaved column must navigate: {targets:?}"
+    );
+    let expected = position_of(&changed, "'contact_email'");
+    assert_eq!(
+        targets[0].range.start,
+        Position::new(expected.line, expected.character + 1)
+    );
+    let docs = hover_member(&backend, &uri, &consumer, "$user->contact_email;").await;
+    assert!(docs.contains("type: `VARCHAR`"), "{docs}");
+    assert_eq!(
+        std::fs::read_to_string(migration_uri.to_file_path().unwrap()).unwrap(),
+        original
+    );
+    backend
+        .did_change_watched_files(DidChangeWatchedFilesParams {
+            changes: vec![FileEvent {
+                uri: migration_uri.clone(),
+                typ: FileChangeType::CHANGED,
+            }],
+        })
+        .await;
+    let watched = definition_locations(
+        goto_definition_at(&backend, &uri, cursor.line, cursor.character).await,
+    );
+    assert_eq!(
+        watched.len(),
+        1,
+        "watch must retain the unsaved column: {watched:?}"
+    );
+    assert_eq!(watched[0].range.start, targets[0].range.start);
+    backend
+        .did_change_configuration(DidChangeConfigurationParams {
+            settings: serde_json::json!({}),
+        })
+        .await;
+    let configured = definition_locations(
+        goto_definition_at(&backend, &uri, cursor.line, cursor.character).await,
+    );
+    assert_eq!(
+        configured.len(),
+        1,
+        "config reload must retain overlay: {configured:?}"
+    );
+    assert_eq!(configured[0].range.start, targets[0].range.start);
+
+    for (version, text) in [
+        (2, "<?php\n$broken = <<<UNFINISHED\n".to_string()),
+        (3, changed.clone()),
+    ] {
+        backend
+            .did_change(DidChangeTextDocumentParams {
+                text_document: VersionedTextDocumentIdentifier {
+                    uri: migration_uri.clone(),
+                    version,
+                },
+                content_changes: vec![TextDocumentContentChangeEvent {
+                    range: None,
+                    range_length: None,
+                    text,
+                }],
+            })
+            .await;
+        let current = definition_locations(
+            goto_definition_at(&backend, &uri, cursor.line, cursor.character).await,
+        );
+        if version == 2 {
+            assert!(
+                current.is_empty(),
+                "partial source must not retain stale migration offsets: {current:?}"
+            );
+        } else {
+            assert_eq!(current.len(), 1);
+            assert_eq!(current[0].range.start, targets[0].range.start);
+        }
+    }
+    backend
+        .did_close(DidCloseTextDocumentParams {
+            text_document: TextDocumentIdentifier { uri: migration_uri },
+        })
+        .await;
+    backend
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: uri.clone(),
+                version: 3,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: USER_CONSUMER.into(),
+            }],
+        })
+        .await;
+    let cursor = position_of(USER_CONSUMER, "email;");
+    let targets = definition_locations(
+        goto_definition_at(&backend, &uri, cursor.line, cursor.character).await,
+    );
+    assert_eq!(targets.len(), 1);
+    let expected = position_of(&original, "'email'");
+    assert_eq!(
+        targets[0].range.start,
+        Position::new(expected.line, expected.character + 1)
+    );
+}

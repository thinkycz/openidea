+// Container registrations are applied in order, even across inheritance.
+foreach ([
+    [
+        [App\Providers\BaseDemoServiceProvider::class, App\Providers\DemoServiceProvider::class],
+        App\Support\BakeryService::class,
+    ],
+    [
+        [App\Providers\DemoServiceProvider::class, App\Providers\BaseDemoServiceProvider::class],
+        App\Support\PlainOven::class,
+    ],
+] as [$providers, $expected]) {
+    $application = new class extends \Illuminate\Foundation\Application {
+        // Keep the real registration API without booting an application.
+        public function __construct() {}
+    };
+    foreach ($providers as $provider) {
+        $application->register($provider);
+    }
+    check('Last registered provider resolves pastry.oven to ' . $expected,
+        get_class($application->make('pastry.oven')) === $expected);
+}

+#[tokio::test]
+async fn provider_rebinding_refreshes_cached_facade_methods() {
+    use crate::common::{complete_labels_at_opened, open_document, position_after};
+
+    let composer = r#"{"require":{"laravel/framework":"^12.0"},"autoload":{"psr-4":{"App\\":"src/","Illuminate\\":"vendor/illuminate/"}}}"#;
+    let provider = "<?php namespace App; class Provider { public function register(): void { $this->app->singleton('service', CurrentService::class); $this->app->alias('service', 'service.alias'); } }";
+    let replacement = provider.replace("CurrentService::class", "AlternateService::class");
+    let consumer = "<?php\nnamespace App;\n$label = '😀'; ServiceFacade::deliver();\nAliasFacade::deliver();\n";
+    let (backend, dir) = create_psr4_workspace(
+        composer,
+        &[
+            (
+                "bootstrap/providers.php",
+                "<?php return [App\\Provider::class];",
+            ),
+            (
+                "vendor/illuminate/Foundation/Application.php",
+                "<?php namespace Illuminate\\Foundation; class Application { public function registerCoreContainerAliases() {} }",
+            ),
+            (
+                "vendor/illuminate/Support/Facades/Facade.php",
+                "<?php namespace Illuminate\\Support\\Facades; abstract class Facade {}",
+            ),
+            ("src/Provider.php", provider),
+            (
+                "src/CurrentService.php",
+                "<?php namespace App; class CurrentService { public function deliver(): string { return ''; } }",
+            ),
+            (
+                "src/AlternateService.php",
+                "<?php namespace App; class AlternateService { public function deliver(): int { return 2; } public function alternateOnly(): bool { return true; } }",
+            ),
+            (
+                "src/ServiceFacade.php",
+                "<?php namespace App; class ServiceFacade extends \\Illuminate\\Support\\Facades\\Facade { protected static function getFacadeAccessor(): string { return 'service'; } }",
+            ),
+            (
+                "src/AliasFacade.php",
+                "<?php namespace App; class AliasFacade extends \\Illuminate\\Support\\Facades\\Facade { protected static function getFacadeAccessor(): string { return 'service.alias'; } }",
+            ),
+            ("src/Consumer.php", consumer),
+        ],
+    );
+    backend.initialized(InitializedParams {}).await;
+    let uri = Url::from_file_path(dir.path().join("src/Consumer.php")).unwrap();
+    let provider_uri = Url::from_file_path(dir.path().join("src/Provider.php")).unwrap();
+    open_document(&backend, &uri, "php", consumer).await;
+    for (version, changed) in [(0, false), (1, true), (2, false), (3, true), (4, false)] {
+        match version {
+            0 => {}
+            1 => open_document(&backend, &provider_uri, "php", &replacement).await,
+            4 => {
+                backend
+                    .did_close(DidCloseTextDocumentParams {
+                        text_document: TextDocumentIdentifier {
+                            uri: provider_uri.clone(),
+                        },
+                    })
+                    .await
+            }
+            _ => {
+                backend
+                    .did_change(DidChangeTextDocumentParams {
+                        text_document: VersionedTextDocumentIdentifier {
+                            uri: provider_uri.clone(),
+                            version,
+                        },
+                        content_changes: vec![TextDocumentContentChangeEvent {
+                            range: None,
+                            range_length: None,
+                            text: if changed {
+                                replacement.clone()
+                            } else {
+                                provider.to_string()
+                            },
+                        }],
+                    })
+                    .await
+            }
+        }
+        for facade in ["ServiceFacade", "AliasFacade"] {
+            let pos = position_after(consumer, &format!("{facade}::"));
+            let hover = backend
+                .handle_hover(uri.as_str(), consumer, pos)
+                .expect("facade method hover");
+            let HoverContents::Markup(markup) = hover.contents else {
+                panic!("expected markup")
+            };
+            let expected = if changed { "int" } else { "string" };
+            assert!(
+                markup.value.contains(&format!("deliver(): {expected}")),
+                "version{version}/{facade}: stale facade hover {}",
+                markup.value
+            );
+            assert_eq!(hover.range.unwrap().start, pos, "UTF16 after emoji");
+            let labels = complete_labels_at_opened(&backend, &uri, pos.line, pos.character).await;
+            assert!(labels.iter().any(|label| label.starts_with("deliver")));
+            assert_eq!(
+                labels
+                    .iter()
+                    .any(|label| label.starts_with("alternateOnly")),
+                changed,
+                "version{version}/{facade}: {labels:?}"
+            );
+        }
+    }
+    assert_eq!(
+        std::fs::read_to_string(dir.path().join("src/Provider.php")).unwrap(),
+        provider
+    );
+}

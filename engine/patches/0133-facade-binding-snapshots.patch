+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn retired_member_completion_build_cannot_restore_old_candidates() {
+        let backend = Backend::new_test();
+        let generation = backend.resolved_class_cache.read().generation();
+        let old = vec![CompletionItem {
+            label: "oldMethod".into(),
+            ..Default::default()
+        }];
+        backend.cache_member_completion_if_current(generation, "facade", &old);
+        assert_eq!(
+            backend.member_completion_cache.lock()["facade"][0].label,
+            "oldMethod"
+        );
+
+        backend.clear_resolved_class_cache();
+        assert!(backend.member_completion_cache.lock().is_empty());
+        // Finish a candidate build that started before the registry changed.
+        backend.cache_member_completion_if_current(generation, "facade", &old);
+        assert!(backend.member_completion_cache.lock().is_empty());
+
+        let current = backend.resolved_class_cache.read().generation();
+        let fresh = vec![CompletionItem {
+            label: "newMethod".into(),
+            ..Default::default()
+        }];
+        backend.cache_member_completion_if_current(current, "facade", &fresh);
+        assert_eq!(
+            backend.member_completion_cache.lock()["facade"][0].label,
+            "newMethod"
+        );
+    }
+}

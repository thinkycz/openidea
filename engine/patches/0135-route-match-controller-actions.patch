+#[tokio::test]
+async fn match_route_controller_nested_group_keeps_inner_owner_and_type() {
+    use crate::common::position_after;
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///route-match-nested.php").unwrap();
+    let text = "<?php\nuse Illuminate\\Support\\Facades\\Route as Routes;\nclass Outer { public function showInvoice(): string {return 'outer';} }\nclass Inner { public function showInvoice(): int {return 1;} }\nRoutes::controller(Outer::class)->group(function () {\n Routes::controller(Inner::class)->group(function () {\n  Routes::match(['get'], '/😀/{id}', 'showInvoice');\n });\n});\n";
+    open_php(&backend, &uri, text).await;
+    let at = position_after(text, "'showIn");
+    let expected = position_after(text, "class Inner { public function ");
+    let target = goto_def(&backend, &uri, at.line, at.character).await;
+    assert!(
+        matches!(target,Some(GotoDefinitionResponse::Scalar(ref l)) if l.range.start==expected),
+        "wrong nested owner: {target:?}"
+    );
+    let hover = backend
+        .hover(HoverParams {
+            text_document_position_params: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier { uri: uri.clone() },
+                position: at,
+            },
+            work_done_progress_params: Default::default(),
+        })
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(
+        matches!(hover.contents,HoverContents::Markup(ref m) if m.value.contains("showInvoice(): int")),
+        "inner hover: {hover:?}"
+    );
+    let refs = backend
+        .references(ReferenceParams {
+            text_document_position: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier { uri: uri.clone() },
+                position: at,
+            },
+            context: ReferenceContext {
+                include_declaration: true,
+            },
+            work_done_progress_params: Default::default(),
+            partial_result_params: Default::default(),
+        })
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(refs.len(), 2, "inner declaration/action only: {refs:?}");
+}

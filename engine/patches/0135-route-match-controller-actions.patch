+#[tokio::test]
+async fn match_route_controller_action_navigation_and_completion() {
+    use crate::common::position_after;
+    for arguments in [
+        "['get', 'post'], '/😀/{id}', 'showInvoice'",
+        "action: 'showInvoice', uri: '/😀/{id}', methods: ['get', 'post']",
+    ] {
+        let backend = create_test_backend();
+        let uri = Url::parse("file:///route-match.php").unwrap();
+        let text = format!(
+            "<?php\nuse Illuminate\\Support\\Facades\\Route as Routes;\nclass Ctrl {{ public function showInvoice(): string {{ return 'ok'; }} }}\nRoutes::controller(Ctrl::class)->group(function () {{\n Routes::match({arguments})->name('invoice');\n}});\n"
+        );
+        open_php(&backend, &uri, &text).await;
+        let at = position_after(&text, "'showIn");
+        let target = goto_def(&backend, &uri, at.line, at.character).await;
+        let expected = position_after(&text, "function ");
+        assert!(
+            matches!(target,Some(GotoDefinitionResponse::Scalar(ref l)) if l.uri==uri && l.range.start==expected),
+            "match action target: {target:?}"
+        );
+        let items = complete_at(&backend, &uri, &text, at.line, at.character).await;
+        assert!(
+            method_labels(&items).iter().any(|m| m == "showInvoice"),
+            "match action candidate: {items:?}"
+        );
+    }
+}

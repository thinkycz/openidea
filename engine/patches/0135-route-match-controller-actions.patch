+/// Select only an unambiguous action of a supported Route facade call.
+/// Named actions may be reordered; argument unpacking can hide duplicates.
+pub(crate) fn laravel_route_action_argument<'a>(
+    expr: &Expression<'a>,
+    resolved_names: Option<&crate::names::OwnedResolvedNames>,
+) -> Option<&'a Expression<'a>> {
+    let Expression::Call(Call::StaticMethod(call)) = expr else {
+        return None;
+    };
+    let ClassLikeMemberSelector::Identifier(method) = &call.method else {
+        return None;
+    };
+    let name = bytes_to_str(method.value).to_ascii_lowercase();
+    let index = if name == "match" {
+        2
+    } else if ROUTE_HTTP_METHODS.contains(&name.as_str()) {
+        1
+    } else {
+        return None;
+    };
+    if !chain_roots_at_route_facade(expr, resolved_names) {
+        return None;
+    }
+    let mut action = None;
+    let mut named = false;
+    for argument in call.argument_list.arguments.iter() {
+        match argument {
+            Argument::Positional(p) if p.ellipsis.is_some() => return None,
+            Argument::Named(n) => {
+                named = true;
+                if bytes_to_str(n.name.value) == "action" {
+                    if action.is_some() {
+                        return None;
+                    }
+                    action = Some(n.value);
+                }
+            }
+            _ => {}
+        }
+    }
+    if named {
+        return action;
+    }
+    call.argument_list
+        .arguments
+        .iter()
+        .nth(index)
+        .map(|argument| argument.value())

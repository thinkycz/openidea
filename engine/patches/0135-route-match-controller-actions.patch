+#[tokio::test]
+async fn match_route_controller_action_excludes_uri_foreign_and_unpacked_contexts() {
+    use crate::common::position_after;
+    for (import, body) in [
+        (
+            "use Illuminate\\Support\\Facades\\Route as Routes;",
+            "Routes::controller(Ctrl::class)->group(function () { Routes::match(['get'], 'showInvoice', 'other'); });",
+        ),
+        (
+            "use Acme\\Route as Routes;",
+            "Routes::controller(Ctrl::class)->group(function () { Routes::match(['get'], '/', 'showInvoice'); });",
+        ),
+        (
+            "use Illuminate\\Support\\Facades\\Route as Routes;",
+            "Routes::match(['get'], '/', 'showInvoice');",
+        ),
+        (
+            "use Illuminate\\Support\\Facades\\Route as Routes;",
+            "Routes::controller(Ctrl::class)->group(function () { Routes::match(...$args, action: 'showInvoice'); });",
+        ),
+        (
+            "use Illuminate\\Support\\Facades\\Route as Routes; use Acme\\Fake;",
+            "Routes::controller(Ctrl::class)->group(function () { Fake::match(['get'], '/', 'showInvoice'); });",
+        ),
+        (
+            "use Illuminate\\Support\\Facades\\Route as Routes;",
+            "Routes::controller(Ctrl::class)->group(function () { Routes::match(action: 'showInvoice', action: 'showInvoice', methods: ['get'], uri: '/'); });",
+        ),
+    ] {
+        let backend = create_test_backend();
+        let uri = Url::parse("file:///route-match-negative.php").unwrap();
+        let text = format!(
+            "<?php\n{import}\nclass Ctrl {{ public function showInvoice() {{}} }}\n{body}\n"
+        );
+        open_php(&backend, &uri, &text).await;
+        let at = position_after(&text, "'showIn");
+        assert!(
+            goto_def(&backend, &uri, at.line, at.character)
+                .await
+                .is_none(),
+            "unsupported match context inferred: {body}"
+        );
+        let items = complete_at(&backend, &uri, &text, at.line, at.character).await;
+        assert!(
+            !method_labels(&items).iter().any(|m| m == "showInvoice"),
+            "unsupported match completion: {body}"
+        );
+    }
+}

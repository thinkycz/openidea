+/// Preserve the existing fast path for ordinary second arguments. Other
+/// supported argument layouts are selected by their AST identity, never by
+/// counting commas in method arrays, named arguments or nested expressions.
+fn detect_ast_route_controller_context(
+    content: &str,
+    cursor_offset: usize,
+    quote_pos: usize,
+    prefix: String,
+    resolved_names: Option<&crate::names::OwnedResolvedNames>,
+) -> Option<LaravelRouteControllerContext> {
+    let before = content[..quote_pos].trim_end();
+    if !before.ends_with(',') && !before.ends_with(':') {
+        return None;
+    }
+    let mut action = false;
+    crate::virtual_members::laravel::walk_all_php_expressions(content, &mut |expr| {
+        if let Some(Expression::Literal(literal::Literal::String(value))) =
+            crate::symbol_map::extraction::laravel::laravel_route_action_argument(
+                expr,
+                resolved_names,
+            )
+            && value.span.start.offset as usize == quote_pos
+            && cursor_offset < value.span.end.offset as usize
+        {
+            action = true;
+            return ControlFlow::Break(());
+        }
+        ControlFlow::Continue(())
+    });
+    if !action {
+        return None;
+    }
+    let controller =
+        find_enclosing_controller_class(content, cursor_offset as u32, resolved_names)?;
+    Some(route_controller_context(
+        content,
+        cursor_offset,
+        quote_pos,
+        prefix,
+        controller,
+    ))
+}

+#[tokio::test]
+async fn workbench_routes_named_uri_arguments_preserve_metadata_and_group_prefix() {
+    for registration in [
+        "Routes::match(action: 'show', methods: ['get'], uri: '/😀/{invoice}/{tab?}')",
+        "Routes::match(['get'], action: 'show', uri: '/😀/{invoice}/{tab?}')",
+        "Routes::get(action: 'show', uri: '/😀/{invoice}/{tab?}')",
+        "Routes::get('/😀/{invoice}/{tab?}', action: 'show')",
+        "Routes::middleware('auth')->post(action: 'show', uri: '/😀/{invoice}/{tab?}')",
+        "Routes::view(view: 'invoices.show', uri: '/😀/{invoice}/{tab?}')",
+        "Routes::redirect(destination: '/other/{wrong}', uri: '/😀/{invoice}/{tab?}')",
+        "Routes::permanentRedirect(destination: '/other/{wrong}', uri: '/😀/{invoice}/{tab?}')",
+    ] {
+        let backend = create_test_backend();
+        let uri = Url::parse("file:///app/routes/web.php").unwrap();
+        let source = format!(
+            "<?php\nuse Illuminate\\Support\\Facades\\Route as Routes;\nRoutes::prefix('billing')->group(function () {{ {registration}->name('invoice'); }});\n"
+        );
+        open_php(&backend, &uri, &source).await;
+        backend.update_ast(uri.as_str(), &source);
+        let reply = backend
+            .workbench_routes(RouteQuery::default())
+            .await
+            .unwrap();
+        let entry = reply
+            .routes
+            .iter()
+            .find(|r| r.name == "invoice")
+            .expect("named route retained");
+        assert_eq!(entry.uri, "billing/😀/{invoice}/{tab?}", "{registration}");
+        assert_eq!(
+            entry.parameters.as_deref(),
+            Some(["invoice".to_string(), "tab".to_string()].as_slice()),
+            "{registration}"
+        );
+    }
+}

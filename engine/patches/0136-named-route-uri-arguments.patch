+#[tokio::test]
+async fn workbench_routes_ambiguous_or_missing_named_uri_does_not_use_action() {
+    for registration in [
+        "Route::get(action: 'fake/{wrong}')",
+        "Route::match(methods: ['get'], action: 'fake/{wrong}')",
+        "Route::get(...$args, uri: '/fake/{wrong}')",
+        "Route::match(['get'], ...$args, uri: '/fake/{wrong}')",
+        "Route::get(uri: '/first/{wrong}', uri: '/second/{wrong}', action: 'show')",
+        "Route::get('/first/{wrong}', uri: '/second/{wrong}', action: 'show')",
+    ] {
+        let backend = create_test_backend();
+        let uri = Url::parse("file:///app/routes/web.php").unwrap();
+        let source = format!("<?php\n{registration}->name('unknown');\n");
+        open_php(&backend, &uri, &source).await;
+        backend.update_ast(uri.as_str(), &source);
+        let reply = backend
+            .workbench_routes(RouteQuery::default())
+            .await
+            .unwrap();
+        if let Some(entry) = reply.routes.iter().find(|r| r.name == "unknown") {
+            assert_eq!(
+                entry.uri, "",
+                "ambiguous URI must remain unknown: {registration}"
+            );
+            assert!(
+                entry.parameters.as_ref().is_none_or(|p| p.is_empty()),
+                "{registration}"
+            );
+        }
+    }
+}

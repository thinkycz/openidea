+#[tokio::test]
+async fn fluent_route_controller_actions_refuse_unknown_receivers_and_owner_overrides() {
+    use crate::common::position_after;
+    for call in [
+        "Fake::middleware('auth')->get('/x', 'showInvoice')",
+        "Routes::customRegistrar()->get('/x', 'showInvoice')",
+        "Routes::get('/first', 'other')->get('/x', 'showInvoice')",
+        "Routes::middleware('auth')->get('showInvoice', 'other')",
+        "Routes::middleware('auth')->get(...$args, action: 'showInvoice')",
+        "Routes::middleware('auth')->get(action: 'showInvoice', action: 'showInvoice', uri: '/x')",
+        "Routes::controller(Inner::class)->get('/x', 'showInvoice')",
+        "Routes::namespace('Other')->get('/x', 'showInvoice')",
+        "Routes::middleware('auth')->get('/x', 'other', action: 'showInvoice')",
+        "Routes::middleware('auth')->get(uri: '/x', 'showInvoice')",
+        "$registrar->get('/x', 'showInvoice')",
+    ] {
+        let backend = create_test_backend();
+        let uri = Url::parse("file:///route-fluent-negative.php").unwrap();
+        let text = format!(
+            "<?php\nuse Illuminate\\Support\\Facades\\Route as Routes;\nuse Acme\\Route as Fake;\nclass Ctrl {{ public function showInvoice() {{}} }}\nclass Inner {{ public function showInvoice() {{}} }}\nRoutes::controller(Ctrl::class)->group(function () {{ {call}; }});\n"
+        );
+        open_php(&backend, &uri, &text).await;
+        let at = position_after(&text, "'showIn");
+        assert!(
+            goto_def(&backend, &uri, at.line, at.character)
+                .await
+                .is_none(),
+            "unsupported fluent target {call}"
+        );
+        let items = complete_at(&backend, &uri, &text, at.line, at.character).await;
+        assert!(
+            !method_labels(&items).iter().any(|m| m == "showInvoice"),
+            "unsupported fluent completion {call}: {items:?}"
+        );
+    }

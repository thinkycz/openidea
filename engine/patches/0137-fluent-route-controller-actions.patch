+// Registrar modifiers preserve the controller inherited from a group.
+(function (): void {
+    $router = new \Illuminate\Routing\Router(new \Illuminate\Events\Dispatcher());
+    $controller = \App\Http\Controllers\BakeryController::class;
+    $router->controller($controller)->group(function () use ($router): void {
+        $router->middleware('auth')->get('/fluent-bakeries', 'index')->name('fluent.index');
+        $router->prefix('admin')->match(['get', 'post'], '/fluent-bakeries/{bakery}', 'show')->name('fluent.show');
+    });
+    $routes = [];
+    foreach ($router->getRoutes() as $route) {
+        $routes[$route->getName()] = $route;
+    }
+    check('Fluent controller group registers both routes', count($routes) === 2);
+    check('Middleware registrar keeps the grouped controller',
+        ($routes['fluent.index'] ?? null)?->getActionName() === $controller . '@index');
+    check('Prefix match registrar keeps the grouped controller',
+        ($routes['fluent.show'] ?? null)?->getActionName() === $controller . '@show');
+    check('Fluent match keeps its prefix and parameter',
+        ($routes['fluent.show'] ?? null)?->uri() === 'admin/fluent-bakeries/{bakery}');
+    check('Fluent get keeps its middleware',
+        in_array('auth', ($routes['fluent.index'] ?? null)?->middleware() ?? [], true));
+})();

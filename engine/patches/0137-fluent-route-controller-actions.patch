+/// Only known RouteRegistrar attributes preserve the enclosing controller.
+/// Controller/namespace overrides and user macros need separate owner analysis.
+fn route_controller_registrar_chain(
+    expr: &Expression<'_>,
+    resolved_names: Option<&crate::names::OwnedResolvedNames>,
+) -> bool {
+    if !chain_roots_at_route_facade(expr, resolved_names) {
+        return false;
+    }
+    const MODIFIERS: &[&[u8]] = &[
+        b"as",
+        b"can",
+        b"domain",
+        b"metadata",
+        b"middleware",
+        b"missing",
+        b"name",
+        b"prefix",
+        b"scopeBindings",
+        b"where",
+        b"withoutMiddleware",
+        b"withoutScopedBindings",
+    ];
+    let mut current = expr;
+    for _ in 0..crate::symbol_map::laravel_resources::FACADE_CHAIN_DEPTH {
+        let (method, receiver) = match current {
+            Expression::Call(Call::Method(call)) => (&call.method, Some(call.object)),
+            Expression::Call(Call::StaticMethod(call)) => (&call.method, None),
+            _ => return false,
+        };
+        let ClassLikeMemberSelector::Identifier(method) = method else {
+            return false;
+        };
+        if !MODIFIERS.contains(&method.value) {
+            return false;
+        }
+        match receiver {
+            Some(receiver) => current = receiver,
+            None => return true,
+        }
+    }
+    false
 }
 

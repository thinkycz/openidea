+#[tokio::test]
+async fn fluent_route_controller_actions_follow_supported_registrar_chains() {
+    use crate::common::position_after;
+    for call in [
+        "Routes::middleware('auth')->get('/😀/{id}', 'showInvoice')",
+        "Routes::prefix('billing')->middleware(['auth'])->match(['get', 'post'], '/😀/{id}', 'showInvoice')",
+        "Routes::domain('example.test')->where(['id' => '[0-9]+'])->post(action: 'showInvoice', uri: '/😀/{id}')",
+        "Routes::name('billing.')->withoutMiddleware('guest')->match(action: 'showInvoice', methods: ['get'], uri: '/😀/{id}')",
+        "Routes::scopeBindings()->get('/😀/{id}', 'showInvoice')",
+    ] {
+        let backend = create_test_backend();
+        let uri = Url::parse("file:///route-fluent.php").unwrap();
+        let text = format!(
+            "<?php\nuse Illuminate\\Support\\Facades\\Route as Routes;\nclass Ctrl {{ public function showInvoice(): string {{ return 'ok'; }} }}\nRoutes::controller(Ctrl::class)->group(function () {{\n {call}->name('invoice');\n}});\n"
+        );
+        open_php(&backend, &uri, &text).await;
+        let at = position_after(&text, "'showIn");
+        let target = goto_def(&backend, &uri, at.line, at.character).await;
+        let expected = position_after(&text, "function ");
+        assert!(
+            matches!(target,Some(GotoDefinitionResponse::Scalar(ref l)) if l.uri==uri && l.range.start==expected),
+            "fluent action target {call}: {target:?}"
+        );
+        let items = complete_at(&backend, &uri, &text, at.line, at.character).await;
+        assert!(
+            method_labels(&items).iter().any(|m| m == "showInvoice"),
+            "fluent candidate {call}: {items:?}"
+        );
+        let hover = backend
+            .hover(HoverParams {
+                text_document_position_params: TextDocumentPositionParams {
+                    text_document: TextDocumentIdentifier { uri: uri.clone() },
+                    position: at,
+                },
+                work_done_progress_params: Default::default(),
+            })
+            .await;
+        let hover = hover.unwrap().expect("fluent action hover");
+        assert!(
+            matches!(hover.contents, HoverContents::Markup(ref m) if m.value.contains("showInvoice(): string")),
+            "fluent hover {call}: {hover:?}"
+        );
+    }
+}

+    let uri = Url::parse("file:///group-controller-hierarchy.php").unwrap();
+    let text = "<?php\nuse Illuminate\\Support\\Facades\\Route as Routes;\nclass Inner { public function showInvoice(): void {} }\nfunction invokeKnownController(Inner $controller): void { $controller->showInvoice(); }\nfunction registerRoutes(): void { Routes::controller('Inner')->group(function () { Routes::get('/invoice', 'showInvoice'); }); }\n";
+    open_php(&backend, &uri, text).await;
+    let at = position_after(text, "public function ");
+    let items = backend
+        .prepare_call_hierarchy(CallHierarchyPrepareParams {
+            text_document_position_params: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier { uri: uri.clone() },
+                position: at,
+            },
+            work_done_progress_params: Default::default(),
+        })
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(items.len(), 1);
+    let callers = backend
+        .incoming_calls(CallHierarchyIncomingCallsParams {
+            item: items.into_iter().next().unwrap(),
+            work_done_progress_params: Default::default(),
+            partial_result_params: Default::default(),
+        })
+        .await
+        .unwrap()
+        .unwrap_or_default();
+    assert_eq!(callers.len(), 1, "registration not invocation: {callers:?}");
+    assert_eq!(callers[0].from.name, "invokeKnownController");
+}

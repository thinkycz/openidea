+#[tokio::test]
+async fn per_registration_controller_attributes_keep_the_enclosing_group_owner() {
+    use crate::common::position_after;
+    for binding in [
+        "Inner::class",
+        "$picked",
+        "null",
+        "controller: Inner::class",
+    ] {
+        let backend = create_test_backend();
+        let uri = Url::parse("file:///group-leaf-attribute.php").unwrap();
+        let text = format!(
+            "<?php\nuse Illuminate\\Support\\Facades\\Route as Routes;\nclass Outer {{ public function showInvoice(): string {{return 'outer';}} }}\nclass Inner {{ public function showInvoice(): bool {{return true;}} }}\nRoutes::controller(Outer::class)->group(function () {{ Routes::controller({binding})->get('/😀', 'showInvoice'); }});\n"
+        );
+        open_php(&backend, &uri, &text).await;
+        let at = position_after(&text, "'showIn");
+        let expected = position_after(&text, "class Outer { public function ");
+        let target = goto_def(&backend, &uri, at.line, at.character).await;
+        assert!(
+            matches!(target,Some(GotoDefinitionResponse::Scalar(ref l)) if l.uri==uri && l.range.start==expected),
+            "leaf attribute must retain outer {binding}: {target:?}"
+        );
+        let items = complete_at(&backend, &uri, &text, at.line, at.character).await;
+        assert!(
+            method_labels(&items).iter().any(|m| m == "showInvoice"),
+            "leaf completion {binding}: {items:?}"
+        );
+    }
+}

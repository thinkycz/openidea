+#[tokio::test]
+async fn controller_groups_resolve_runtime_class_strings_and_lexical_class_constants() {
+    use crate::common::position_after;
+    for class in [
+        "Inner::class",
+        "Alias::class",
+        "Relative\\Inner::class",
+        "\\Demo\\Inner::class",
+        "'Demo\\Inner'",
+        "'\\Demo\\Inner'",
+    ] {
+        for nested in [false, true] {
+            let backend = create_test_backend();
+            let uri = Url::parse("file:///group-controller-binding.php").unwrap();
+            let group = format!(
+                "Routes::controller({class})->group(function () {{ Routes::get('/😀', 'showInvoice'); }});"
+            );
+            let body = if nested {
+                format!("Routes::controller(Outer::class)->group(function () {{ {group} }});")
+            } else {
+                group
+            };
+            let text = format!(
+                "<?php\nnamespace Demo;\nuse Illuminate\\Support\\Facades\\Route as Routes; use Demo\\Inner as Alias; use Demo as Relative;\nclass Outer {{ public function showInvoice(): string {{return 'outer';}} }}\nclass Inner {{ public function showInvoice(): bool {{return true;}} }}\n{body}\n"
+            );
+            open_php(&backend, &uri, &text).await;
+            let at = position_after(&text, "'showIn");
+            let expected = position_after(&text, "class Inner { public function ");
+            let target = goto_def(&backend, &uri, at.line, at.character).await;
+            assert!(
+                matches!(target,Some(GotoDefinitionResponse::Scalar(ref l)) if l.uri==uri && l.range.start==expected),
+                "group {class} nested={nested}: {target:?}"
+            );
+            let items = complete_at(&backend, &uri, &text, at.line, at.character).await;
+            assert!(
+                method_labels(&items).iter().any(|m| m == "showInvoice"),
+                "group completion {class}: {items:?}"
+            );
+            let hover = backend
+                .hover(HoverParams {
+                    text_document_position_params: TextDocumentPositionParams {
+                        text_document: TextDocumentIdentifier { uri: uri.clone() },
+                        position: at,
+                    },
+                    work_done_progress_params: Default::default(),
+                })
+                .await
+                .unwrap()
+                .unwrap();
+            assert!(
+                matches!(hover.contents, HoverContents::Markup(ref m) if m.value.contains("showInvoice(): bool")),
+                "group type {class}: {hover:?}"
+            );
+        }
+    }
+}

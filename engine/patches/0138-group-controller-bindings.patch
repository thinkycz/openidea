+// The group stack supplies controllers; a leaf registrar attribute does not.
+(function (): void {
+    $router = new \Illuminate\Routing\Router(new \Illuminate\Events\Dispatcher());
+    $main = \App\Http\Controllers\BakeryController::class;
+    $alternate = \App\Http\Controllers\AlternateBakeryController::class;
+    $router->controller('App\Http\Controllers\BakeryController')->group(function () use ($router): void {
+        $router->get('/string-bakeries', 'index')->name('binding.string');
+    });
+    $router->controller($main)->group(function () use ($router, $alternate): void {
+        $router->controller($alternate)->get('/leaf-controller', 'index')->name('binding.leaf');
+        $router->controller('App\Http\Controllers\AlternateBakeryController')->group(function () use ($router): void {
+            $router->get('/nested-string', 'index')->name('binding.nested');
+        });
+    });
+    $router->controller('MissingEarlierController')->controller($alternate)->group(function () use ($router): void {
+        $router->get('/last-group', 'index')->name('binding.last');
+    });
+    $routes = [];
+    foreach ($router->getRoutes() as $route) { $routes[$route->getName()] = $route; }

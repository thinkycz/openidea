+// Arrow callbacks retain the same group stack as ordinary closures.
+(function (): void {
+    $router = new \Illuminate\Routing\Router(new \Illuminate\Events\Dispatcher());
+    $main = \App\Http\Controllers\BakeryController::class;
+    $alternate = \App\Http\Controllers\AlternateBakeryController::class;
+    $router->controller($main)->group(fn () => $router->get('/arrow', 'index')->name('arrow.main'));
+    $router->controller($main)->group(function () use ($router, $alternate): void {
+        $router->controller($alternate)->group(static fn () => $router->get('/arrow-preview', 'index')->name('arrow.inner'));
+    });
+    $router->controller($main)->group(fn () => $router->prefix('inherited')->group(fn () =>
+        $router->get('/arrow-inherited', 'index')->name('arrow.inherited')));
+    $routes = [];
+    foreach ($router->getRoutes() as $route) { $routes[$route->getName()] = $route->getActionName(); }
+    check('Arrow controller groups register three routes', count($routes) === 3);
+    check('Top-level arrow group selects its controller', ($routes['arrow.main'] ?? null) === $main . '@index');
+    check('Nested arrow group selects its own controller', ($routes['arrow.inner'] ?? null) === $alternate . '@index');
+    check('Controller-free nested arrow group inherits its parent', ($routes['arrow.inherited'] ?? null) === $main . '@index');
+})();

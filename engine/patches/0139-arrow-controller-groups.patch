+#[tokio::test]
+async fn unknown_arrow_controller_groups_do_not_complete_the_outer_owner() {
+    use crate::common::position_after;
+    for binding in ["$picked", "...$picked", "controller: Inner::class"] {
+        let backend = create_test_backend();
+        let uri = Url::parse("file:///unknown-arrow-controller.php").unwrap();
+        let text = format!(
+            "<?php\nuse Illuminate\\Support\\Facades\\Route as Routes;\nclass Outer {{public function showInvoice(): string {{return 'outer';}}}}\nclass Inner {{public function showInvoice(): bool {{return true;}}}}\nRoutes::controller(Outer::class)->group(function () {{ Routes::controller({binding})->group(fn () => Routes::get('/x', 'showInvoice')); }});\n"
+        );
+        open_php(&backend, &uri, &text).await;
+        let at = position_after(&text, "'showIn");
+        assert!(
+            goto_def(&backend, &uri, at.line, at.character)
+                .await
+                .is_none(),
+            "unknown arrow target {binding}"
+        );
+        let items = complete_at(&backend, &uri, &text, at.line, at.character).await;
+        assert!(
+            !method_labels(&items).iter().any(|m| m == "showInvoice"),
+            "unknown arrow borrowed parent {binding}: {items:?}"
+        );
+    }
+}
+
+#[tokio::test]
+async fn arrow_groups_without_a_controller_inherit_the_enclosing_owner() {
+    use crate::common::position_after;
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///inherited-arrow-controller.php").unwrap();
+    let text = "<?php\nuse Illuminate\\Support\\Facades\\Route as Routes;\nclass Outer {public function showInvoice(): string {return 'outer';}}\nRoutes::controller(Outer::class)->group(fn () => Routes::prefix('invoices')->group(fn () => Routes::get('/x', 'showInvoice')));\n";
+    open_php(&backend, &uri, text).await;
+    let at = position_after(text, "'showIn");
+    assert!(
+        goto_def(&backend, &uri, at.line, at.character)
+            .await
+            .is_some()
+    );
+    let items = complete_at(&backend, &uri, text, at.line, at.character).await;
+    assert!(
+        method_labels(&items).iter().any(|m| m == "showInvoice"),
+        "missing inherited arrow completion: {items:?}"
+    );
+}

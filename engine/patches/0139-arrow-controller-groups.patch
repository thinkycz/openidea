+#[tokio::test]
+async fn arrow_controller_groups_complete_the_same_owner_as_definitions() {
+    use crate::common::position_after;
+    for class in ["Inner::class", "'Demo\\Inner'"] {
+        for callback in ["fn () =>", "static fn (): mixed =>"] {
+            for nested in [false, true] {
+                let backend = create_test_backend();
+                let uri = Url::parse("file:///arrow-controller.php").unwrap();
+                let group = format!(
+                    "Routes::controller({class})->group({callback} Routes::middleware('auth')->get('/😀', 'showInvoice')); "
+                );
+                let body = if nested {
+                    format!("Routes::controller(Outer::class)->group(function () {{ {group} }});")
+                } else {
+                    group
+                };
+                let text = format!(
+                    "<?php\nnamespace Demo;\nuse Illuminate\\Support\\Facades\\Route as Routes;\nclass Outer {{ public function showInvoice(): string {{return 'outer';}} }}\nclass Inner {{ public function showInvoice(): bool {{return true;}} }}\n{body}\n"
+                );
+                open_php(&backend, &uri, &text).await;
+                let at = position_after(&text, "'showIn");
+                let expected = position_after(&text, "class Inner { public function ");
+                let target = goto_def(&backend, &uri, at.line, at.character).await;
+                assert!(
+                    matches!(target,Some(GotoDefinitionResponse::Scalar(ref l)) if l.uri==uri && l.range.start==expected),
+                    "arrow definition {class}/{callback}/{nested}: {target:?}"
+                );
+                let items = complete_at(&backend, &uri, &text, at.line, at.character).await;
+                let item = items
+                    .iter()
+                    .find(|i| i.insert_text.as_deref() == Some("showInvoice"))
+                    .unwrap_or_else(|| {
+                        panic!("missing arrow completion {class}/{callback}/{nested}: {items:?}")
+                    });
+                assert!(
+                    item.detail.as_deref().is_some_and(|s| s.contains("bool")),
+                    "wrong arrow owner: {item:?}"
+                );
+                let hover = backend
+                    .hover(HoverParams {
+                        text_document_position_params: TextDocumentPositionParams {
+                            text_document: TextDocumentIdentifier { uri: uri.clone() },
+                            position: at,
+                        },
+                        work_done_progress_params: Default::default(),
+                    })
+                    .await
+                    .unwrap()
+                    .expect("arrow hover");
+                assert!(
+                    matches!(hover.contents,HoverContents::Markup(ref m) if m.value.contains("showInvoice(): bool")),
+                    "arrow hover {hover:?}"
+                );
+            }
+        }
+    }
+}

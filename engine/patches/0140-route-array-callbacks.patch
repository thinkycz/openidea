+#[tokio::test]
+async fn returned_route_arrays_preserve_main_and_nested_controller_owners() {
+    use crate::common::position_after;
+    for template in [
+        "[ACTION]",
+        "array(ACTION)",
+        "['invoice' => ACTION]",
+        "[...[ACTION]]",
+        "([ACTION])",
+    ] {
+        let backend = create_test_backend();
+        let uri = Url::parse("file:///array-route-group.php").unwrap();
+        let body=template.replace("ACTION", "Routes::get('/😀/main', 'showInvoice'), Routes::controller(Inner::class)->group(fn () => [Routes::get('/nested', 'showInvoice')])");
+        let text = format!(
+            "<?php\nuse Illuminate\\Support\\Facades\\Route as Routes;\nclass Outer {{public function showInvoice(): string {{return 'outer';}}}}\nclass Inner {{public function showInvoice(): bool {{return true;}}}}\nRoutes::controller(Outer::class)->group(fn () => {body});\n"
+        );
+        open_php(&backend, &uri, &text).await;
+        for (needle, owner, ty) in [
+            ("'/😀/main', 'showIn", "Outer", "string"),
+            ("'/nested', 'showIn", "Inner", "bool"),
+        ] {
+            let at = position_after(&text, needle);
+            let expected = position_after(&text, &format!("class {owner} {{public function "));
+            let target = goto_def(&backend, &uri, at.line, at.character).await;
+            assert!(
+                matches!(target,Some(GotoDefinitionResponse::Scalar(ref l)) if l.uri==uri && l.range.start==expected),
+                "array owner {template}/{owner}: {target:?}"
+            );
+            let hover = backend
+                .hover(HoverParams {
+                    text_document_position_params: TextDocumentPositionParams {
+                        text_document: TextDocumentIdentifier { uri: uri.clone() },
+                        position: at,
+                    },
+                    work_done_progress_params: Default::default(),
+                })
+                .await
+                .unwrap()
+                .expect("array action hover");
+            assert!(
+                matches!(hover.contents,HoverContents::Markup(ref m) if m.value.contains(&format!("showInvoice(): {ty}"))),
+                "array hover {hover:?}"
+            );
+            let items = complete_at(&backend, &uri, &text, at.line, at.character).await;
+            assert!(
+                items
+                    .iter()
+                    .any(|i| i.insert_text.as_deref() == Some("showInvoice")
+                        && i.detail.as_deref().is_some_and(|d| d.contains(ty))),
+                "array completion {items:?}"
+            );
+        }
+    }

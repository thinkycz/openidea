+fn laravel_route_scan_array_element(
+    element: &ArrayElement<'_>,
+    controller: &str,
+    content: &str,
+    spans: &mut Vec<SymbolSpan>,
+    resolved_names: Option<&crate::names::OwnedResolvedNames>,
+) {
+    let value = match element {
+        ArrayElement::KeyValue(element) => element.value,
+        ArrayElement::Value(element) => element.value,
+        ArrayElement::Variadic(element) => element.value,
+        ArrayElement::Missing(_) => return,
+    };
+    laravel_route_scan_expr(value, controller, content, spans, resolved_names);

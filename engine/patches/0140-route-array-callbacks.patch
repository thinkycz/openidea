+#[tokio::test]
+async fn ordinary_group_closures_follow_returned_array_registrations_without_entering_delayed_callbacks()
+ {
+    use crate::common::position_after;
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///closure-array-route.php").unwrap();
+    let text = "<?php\nuse Illuminate\\Support\\Facades\\Route as Routes;\nclass Outer {public function showInvoice(): string {return 'outer';}}\nRoutes::controller(Outer::class)->group(function () {return [Routes::get('/eager', 'showInvoice'), fn () => Routes::get('/delayed', 'showInvoice'), function () {Routes::get('/closure', 'showInvoice');}, Routes::controller($unknown)->group(fn () => [Routes::get('/unknown', 'showInvoice')])];});\n";
+    open_php(&backend, &uri, text).await;
+    let at = position_after(text, "'/eager', 'showIn");
+    assert!(
+        goto_def(&backend, &uri, at.line, at.character)
+            .await
+            .is_some(),
+        "eager registration missing"
+    );
+    for needle in [
+        "'/delayed', 'showIn",
+        "'/closure', 'showIn",
+        "'/unknown', 'showIn",
+    ] {
+        let at = position_after(text, needle);
+        assert!(
+            goto_def(&backend, &uri, at.line, at.character)
+                .await
+                .is_none(),
+            "array traversal crossed callback/unknown boundary {needle}"
+        );
+    }
+}

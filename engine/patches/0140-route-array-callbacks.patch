+// Array values execute their route registrations while the group stack is active.
+(function (): void {
+    $router = new \Illuminate\Routing\Router(new \Illuminate\Events\Dispatcher());
+    $main = \App\Http\Controllers\BakeryController::class;
+    $alternate = \App\Http\Controllers\AlternateBakeryController::class;
+    $router->controller($main)->group(fn () => [
+        $router->get('/array', 'index')->name('array.index'),
+        $router->match(['get'], '/array/{bakery}', 'show')->name('array.show'),
+    ]);
+    $router->controller($main)->group(function () use ($router, $alternate): array {
+        return array(
+            $router->controller($alternate)->group(fn () => array($router->get('/array-preview', 'index')->name('array.inner'))),
+            $router->prefix('inherited')->group(fn () => [$router->get('/array-inherited', 'index')->name('array.inherited')]),
+        );
+    });
+    $routes = [];
+    foreach ($router->getRoutes() as $route) { $routes[$route->getName()] = $route->getActionName(); }
+    check('Array controller callbacks register four routes', count($routes) === 4);
+    check('Short array index keeps its grouped controller', ($routes['array.index'] ?? null) === $main . '@index');
+    check('Short array match keeps its grouped controller', ($routes['array.show'] ?? null) === $main . '@show');
+    check('Nested legacy array selects its own controller', ($routes['array.inner'] ?? null) === $alternate . '@index');
+    check('Array callback without a new controller inherits the parent', ($routes['array.inherited'] ?? null) === $main . '@index');
+})();

+// Namespace attributes are checked against the actual Laravel router.
+(function (): void {
+$r = new Illuminate\Routing\Router(new Illuminate\Events\Dispatcher());
+$full = App\Http\Controllers\BakeryController::class;
+$r->group(['namespace'=>'App\Http\Controllers','controller'=>'BakeryController'], fn () => $r->get('/attr', 'index')->name('attr'));
+$r->namespace('App\Http\Controllers')->group(fn () => $r->controller('BakeryController')->group(fn () => $r->get('/inherit', 'index')->name('inherit')));
+$r->namespace('App\Http')->group(fn () => $r->namespace('Controllers')->controller('BakeryController')->group(fn () => $r->get('/relative', 'index')->name('relative')));
+$r->namespace('Unrelated')->group(fn () => $r->namespace('\App\Http\Controllers')->controller('BakeryController')->group(fn () => $r->get('/reset', 'index')->name('reset')));
+$r->namespace('App\Http\Controllers')->controller($full)->group(fn () => $r->get('/constant', 'index')->name('constant'));
+$r->namespace('Other')->controller(chr(92) . $full)->group(fn () => $r->get('/rooted', 'index')->name('rooted'));
+$r->namespace('Other')->controller($full)->group(fn () => $r->get('/mangled', 'index')->name('mangled'));
+$actual = [];
+foreach ($r->getRoutes() as $route) { $actual[$route->getName()]=$route->getActionName(); }

+//! Laravel registration context, folded once from already parsed callback scopes.
+use super::laravel::{
+    LaravelRouteGroup, RouteControllerRef, RouteNamespaceRef, laravel_route_controller_group,
+    laravel_route_scan_group_body,
+};
+use super::{OwnedResolvedNames, SymbolSpan};
+use mago_span::HasSpan;
+use mago_syntax::cst::*;
+use mago_syntax::walker::Walker;
+use std::collections::HashSet;
+
+#[derive(Clone)]
+struct Binding {
+    controller: Option<Option<RouteControllerRef>>,
+    namespace: Option<Option<RouteNamespaceRef>>,
+    invalid: bool,
+}
+impl Binding {
+    fn from_group(group: &LaravelRouteGroup<'_>) -> Self {
+        Self {
+            controller: group.controller.clone(),
+            namespace: group.namespace.clone(),
+            invalid: group.callback.is_none(),
+        }
+    }
+}
+struct Pending {
+    start: u32,
+    end: u32,
+    binding: Option<Binding>,
+}
+#[derive(Default)]
+struct Collected {
+    groups: Vec<Pending>,
+    scopes: Vec<(u32, u32)>,
+}
+struct Collector<'a> {
+    names: Option<&'a OwnedResolvedNames>,
+}
+
+fn callbacks(expr: &Expression<'_>, visit: &mut impl FnMut(&Expression<'_>)) {
+    let expr = crate::parser::unwrap_parens(expr);
+    let elements = match expr {
+        Expression::Array(a) => Some(&a.elements),
+        Expression::LegacyArray(a) => Some(&a.elements),
+        _ => None,
+    };
+    if let Some(elements) = elements {
+        for element in elements.iter() {
+            let value = match element {
+                ArrayElement::KeyValue(e) => e.value,
+                ArrayElement::Value(e) => e.value,
+                ArrayElement::Variadic(e) => e.value,
+                ArrayElement::Missing(_) => continue,
+            };
+            callbacks(value, visit);
+        }
+    } else if matches!(expr, Expression::Closure(_) | Expression::ArrowFunction(_)) {
+        visit(expr);
+    }
+}
+fn callback_range(expr: &Expression<'_>) -> (u32, u32) {
+    match expr {
+        Expression::Closure(c) => (
+            c.body.left_brace.start.offset,
+            c.body.right_brace.end.offset,
+        ),
+        _ => {
+            let span = expr.span();
+            (span.start.offset, span.end.offset)
+        }
+    }
+}
+impl<'ast, 'arena> Walker<'ast, 'arena, Collected> for Collector<'_> {
+    fn walk_in_expression(&self, node: &'ast Expression<'arena>, out: &mut Collected) {
+        let Expression::Call(call) = node else { return };
+        let Some(group) = laravel_route_controller_group(call, self.names) else {
+            return;
+        };
+        let binding = Binding::from_group(&group);
+        if let Some(callback) = group.callback {
+            callbacks(callback, &mut |expr| {
+                let (start, end) = callback_range(expr);
+                out.groups.push(Pending {
+                    start,
+                    end,
+                    binding: Some(binding.clone()),
+                });
+            });
+        } else {
+            let span = group.arguments.span();
+            out.groups.push(Pending {
+                start: span.start.offset,
+                end: span.end.offset,
+                binding: Some(binding),
+            });
+        }
+    }
+    fn walk_in_closure(&self, node: &'ast Closure<'arena>, out: &mut Collected) {
+        out.scopes.push((
+            node.body.left_brace.start.offset,
+            node.body.right_brace.end.offset,
+        ));
+    }
+    fn walk_in_arrow_function(&self, node: &'ast ArrowFunction<'arena>, out: &mut Collected) {
+        let span = node.span();
+        out.scopes.push((span.start.offset, span.end.offset));
+    }
+    fn walk_in_function(&self, node: &'ast Function<'arena>, out: &mut Collected) {
+        out.scopes.push((
+            node.body.left_brace.start.offset,
+            node.body.right_brace.end.offset,
+        ));
+    }
+    fn walk_in_method(&self, node: &'ast Method<'arena>, out: &mut Collected) {
+        if let MethodBody::Concrete(body) = &node.body {
+            out.scopes
+                .push((body.left_brace.start.offset, body.right_brace.end.offset));
+        }
+    }
+}
+
+#[derive(Clone)]
+struct Frame {
+    controller: Option<RouteControllerRef>,
+    namespace: Result<Option<String>, ()>,
+    invalid: bool,
+}
+impl Default for Frame {
+    fn default() -> Self {
+        Self {
+            controller: None,
+            namespace: Ok(None),
+            invalid: false,
+        }
+    }
+}
+impl Frame {
+    fn apply(&mut self, binding: Option<&Binding>) {
+        let Some(binding) = binding else {
+            self.controller = None;
+            self.namespace = match &self.namespace {
+                Ok(None) => Ok(None),
+                Ok(Some(ns)) if ns.is_empty() => Ok(None),
+                _ => Err(()),
+            };
+            return;
+        };
+        self.invalid |= binding.invalid;
+        if let Some(controller) = &binding.controller {
+            self.controller = controller.clone();
+        }
+        if let Some(namespace) = &binding.namespace {
+            self.namespace = match namespace {
+                None => Err(()),
+                Some(ns) if ns.rooted => Ok(Some(ns.value.clone())),
+                Some(ns) => match &self.namespace {
+                    Ok(Some(old)) => Ok(Some(format!(
+                        "{}\\{}",
+                        old.trim_matches('\\'),
+                        ns.value.trim_matches('\\')
+                    ))),
+                    Ok(None) => Ok(Some(ns.value.clone())),
+                    Err(()) => Err(()),
+                },
+            };
+        }
+    }
+    fn owner(&self) -> Option<String> {
+        if self.invalid {
+            return None;
+        }
+        let controller = self.controller.as_ref()?;
+        let namespace = self.namespace.as_ref().ok()?;
+        let Some(namespace) = namespace else {
+            return Some(controller.subject.clone());
+        };
+        if namespace.is_empty() || controller.rooted {
+            return Some(controller.subject.clone());
+        }
+        let runtime = controller.runtime.as_deref()?;
+        let name = if runtime.starts_with(namespace) {
+            runtime.to_owned()
+        } else {
+            format!("{namespace}\\{runtime}")
+        };
+        if name.contains("::") || !super::expressions::valid_literal_callable_target(&name) {
+            return None;
+        }
+        Some(format!("\\{}", name.trim_start_matches('\\')))
+    }
+}
+struct Region {
+    start: u32,
+    end: u32,
+    parent: Option<usize>,
+    owner: Option<String>,
+}
+#[derive(Default)]
+pub(crate) struct RouteGroupContexts {
+    regions: Vec<Region>,
+}
+impl RouteGroupContexts {
+    pub(crate) fn collect(
+        program: &Program<'_>,
+        content: &str,
+        names: Option<&OwnedResolvedNames>,
+    ) -> Self {
+        if !content
+            .as_bytes()
+            .windows(5)
+            .any(|s| s.eq_ignore_ascii_case(b"group"))
+        {
+            return Self::default();
+        }
+        let mut collected = Collected::default();
+        Collector { names }.walk_program(program, &mut collected);
+        if collected.groups.is_empty() {
+            return Self::default();
+        }
+        let invoked: HashSet<_> = collected.groups.iter().map(|r| (r.start, r.end)).collect();
+        collected.groups.extend(
+            collected
+                .scopes
+                .into_iter()
+                .filter(|range| !invoked.contains(range))
+                .map(|(start, end)| Pending {
+                    start,
+                    end,
+                    binding: None,
+                }),
+        );
+        collected
+            .groups
+            .sort_by_key(|r| (r.start, std::cmp::Reverse(r.end)));
+        let mut regions: Vec<Region> = Vec::with_capacity(collected.groups.len());
+        let mut frames: Vec<Frame> = Vec::with_capacity(collected.groups.len());
+        let mut stack: Vec<usize> = Vec::new();
+        for pending in collected.groups {
+            while stack
+                .last()
+                .is_some_and(|p| regions[*p].end <= pending.start)
+            {
+                stack.pop();
+            }
+            let parent = stack.last().copied();
+            let mut frame = parent.map_or_else(Frame::default, |p| frames[p].clone());
+            frame.apply(pending.binding.as_ref());
+            let index = regions.len();
+            regions.push(Region {
+                start: pending.start,
+                end: pending.end,
+                parent,
+                owner: frame.owner(),
+            });
+            frames.push(frame);
+            stack.push(index);
+        }
+        Self { regions }
+    }
+    pub(crate) fn owner_at(&self, offset: u32) -> Option<&str> {
+        let mut index = self
+            .regions
+            .partition_point(|r| r.start <= offset)
+            .checked_sub(1)?;
+        loop {
+            let region = &self.regions[index];
+            if offset < region.end {
+                return region.owner.as_deref();
+            }
+            index = region.parent?;
+        }
+    }
+}
+
+struct Emitter<'a> {
+    content: &'a str,
+    names: Option<&'a OwnedResolvedNames>,
+    contexts: &'a RouteGroupContexts,
+}
+impl<'ast, 'arena> Walker<'ast, 'arena, (Vec<SymbolSpan>, Vec<(u32, u32)>)> for Emitter<'_> {
+    fn walk_in_expression(
+        &self,
+        node: &'ast Expression<'arena>,
+        out: &mut (Vec<SymbolSpan>, Vec<(u32, u32)>),
+    ) {
+        let Expression::Call(call) = node else { return };
+        let Some(group) = laravel_route_controller_group(call, self.names) else {
+            return;
+        };
+        let Some(callback) = group.callback else {
+            return;
+        };
+        callbacks(callback, &mut |expr| {
+            let (start, _) = callback_range(expr);
+            let Some(controller) = self.contexts.owner_at(start) else {
+                return;
+            };
+            let first = out.0.len();
+            laravel_route_scan_group_body(expr, controller, self.content, &mut out.0, self.names);
+            out.1
+                .extend(out.0[first..].iter().map(|s| (s.start, s.end)));
+        });
+    }
+}
+pub(super) fn emit(
+    program: &Program<'_>,
+    content: &str,
+    names: Option<&OwnedResolvedNames>,
+    spans: &mut Vec<SymbolSpan>,
+    non_invoked: &mut Vec<(u32, u32)>,
+) {
+    let contexts = RouteGroupContexts::collect(program, content, names);
+    if contexts.regions.is_empty() {
+        return;
+    }
+    let mut out = (Vec::new(), Vec::new());
+    Emitter {
+        content,
+        names,
+        contexts: &contexts,
+    }
+    .walk_program(program, &mut out);
+    spans.extend(out.0);
+    non_invoked.extend(out.1);
+}

+foreach (['attr','inherit','relative','reset','constant'] as $name) { check('Namespace group ' . $name . ' resolves the controller', $actual[$name] === $full . '@index'); }
+check('Rooted controller bypasses a namespace prefix', $actual['rooted'] === chr(92) . $full . '@index');
+check('Class constant runtime name still receives a mismatched namespace prefix', $actual['mangled'] === 'Other' . chr(92) . $full . '@index');

+/// A literal controller action with an editable, unescaped method suffix.
+pub(crate) struct ExplicitRouteAction<'a> {
+    /// Runtime controller spelling before namespace qualification.
+    pub controller: RouteControllerRef,
+    /// Method spelling shared by runtime lookup and source edits.
+    pub method: &'a str,
+    /// Source byte offset of the method suffix.
+    pub start: u32,
+    /// Exclusive source byte offset before the closing quote.
+    pub end: u32,
+}
+
+/// Decode a registered literal action without treating URI strings as handlers.
+pub(crate) fn laravel_explicit_route_action<'a>(
+    expr: &Expression<'_>,
+    names: Option<&crate::names::OwnedResolvedNames>,
+    content: &'a str,
+) -> Option<ExplicitRouteAction<'a>> {
+    let Expression::Literal(literal::Literal::String(value)) =
+        laravel_route_action_argument(expr, names)?
+    else {
+        return None;
+    };
+    let decoded = value.value.and_then(literal_bytes_to_str)?;
+    let (class, decoded_method) = decoded.rsplit_once('@')?;
+    let controller = laravel_runtime_controller_ref(class)?;
+    let end = value.span.end.offset.checked_sub(1)?;
+    let raw = content.get(value.span.start.offset as usize + 1..end as usize)?;
+    let (_, method) = raw.rsplit_once('@')?;
+    // Refuse escaped method spellings: an edit must cover exactly the runtime name.
+    if method != decoded_method
+        || !method
+            .chars()
+            .all(|c| c.is_ascii_alphanumeric() || c == '_')
+        || method.chars().next().is_some_and(|c| c.is_ascii_digit())
+    {
+        return None;
+    }
+    Some(ExplicitRouteAction {
+        controller,
+        method,
+        start: end - method.len() as u32,
+        end,
+    })
+}
+
+fn laravel_runtime_controller_ref(name: &str) -> Option<RouteControllerRef> {
+    if name.contains("::") || !super::expressions::valid_literal_callable_target(name) {
+        return None;
+    }
+    let rooted = name.starts_with('\\');
+    let name = name.strip_prefix('\\').unwrap_or(name);
+    if ["self", "parent", "static"]
+        .iter()
+        .any(|keyword| name.eq_ignore_ascii_case(keyword))
+    {
+        return None;
+    }
+    Some(RouteControllerRef {
+        subject: format!("\\{name}"),
+        runtime: Some(name.to_owned()),
+        rooted,
+    })
+}
+

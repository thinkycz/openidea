+fn detect_explicit_route_action_context(
+    content: &str,
+    cursor_offset: usize,
+    resolved_names: Option<&crate::names::OwnedResolvedNames>,
+) -> Option<LaravelRouteControllerContext> {
+    let mut action = None;
+    crate::virtual_members::laravel::walk_all_php_expressions(content, &mut |expr| {
+        if let Some(candidate) =
+            crate::symbol_map::extraction::laravel::laravel_explicit_route_action(
+                expr,
+                resolved_names,
+                content,
+            )
+            && cursor_offset >= candidate.start as usize
+            && cursor_offset <= candidate.end as usize
+        {
+            action = Some(candidate);
+            return ControlFlow::Break(());
+        }
+        ControlFlow::Continue(())
+    });
+    let action = action?;
+    let controller = crate::parser::with_parsed_program(
+        content,
+        "laravel_explicit_action_context",
+        |program, _| {
+            crate::symbol_map::extraction::laravel_route_context::RouteGroupContexts::collect(
+                program,
+                content,
+                resolved_names,
+            )
+            .explicit_owner_at(action.start, &action.controller)
+        },
+    )?;
+    Some(LaravelRouteControllerContext {
+        controller_class: controller,
+        prefix: content
+            .get(action.start as usize..cursor_offset)?
+            .to_owned(),
+        replace_range: Range::new(
+            offset_to_position(content, action.start as usize),
+            offset_to_position(content, action.end as usize),
+        ),
+    })
+}

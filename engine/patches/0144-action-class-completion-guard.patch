+/// Method-name completion may only replace a whole bare action literal.
+/// Inspect the registered argument, including decoded escapes, so class names
+/// before a runtime `@` never fall through to the enclosing group's methods.
+fn is_bare_route_action_literal(
+    content: &str,
+    quote_pos: usize,
+    resolved_names: Option<&crate::names::OwnedResolvedNames>,
+) -> bool {
+    let mut bare = false;
+    crate::virtual_members::laravel::walk_all_php_expressions(content, &mut |expr| {
+        if let Some(Expression::Literal(literal::Literal::String(value))) =
+            crate::symbol_map::extraction::laravel::laravel_route_action_argument(
+                expr,
+                resolved_names,
+            )
+            && value.span.start.offset as usize == quote_pos
+        {
+            bare = value.value.is_some_and(|bytes| !bytes.contains(&b'@'));
+            return ControlFlow::Break(());
+        }
+        ControlFlow::Continue(())
+    });
+    bare
 }
 

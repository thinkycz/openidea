+async fn assert_action_class_part_keeps_group_methods_out(action: &str, needle: &str, named: bool) {
+    use crate::common::position_after;
+    let call = if named {
+        format!("Routes::match(action: {action}, methods: ['get'], uri: '/😀/named')")
+    } else {
+        format!("Routes::get('/😀/class', {action})")
+    };
+    let text = format!(
+        "<?php\nnamespace Demo; use Illuminate\\Support\\Facades\\Route as Routes; class Outer {{public function InvoiceControllerMistake(): string {{return 'wrong';}} public function DemoMistake(): string {{return 'wrong';}}}} class InvoiceController {{public function showInvoice(): bool {{return true;}}}} Routes::namespace('Demo')->controller(Outer::class)->group(fn () => {call});"
+    );
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///action-class-part.php").unwrap();
+    open_php(&backend, &uri, &text).await;
+    let at = position_after(&text, needle);
+    let items = complete_at(&backend, &uri, &text, at.line, at.character).await;
+    assert!(
+        !items.iter().any(|i| matches!(
+            i.insert_text.as_deref(),
+            Some("InvoiceControllerMistake" | "DemoMistake" | "showInvoice")
+        )),
+        "group method offered in class position: {action}, {needle}, {items:?}"
+    );
+}

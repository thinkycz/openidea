+impl crate::Backend {
+    /// Runtime route strings must never reach the PHP import rewriter. Their
+    /// namespaces and escapes need a dedicated, all-target rewrite plan.
+    pub(super) fn reject_runtime_controller_class_rename(&self, fqn: &str) -> Result<(), String> {
+        let target = crate::util::strip_fqn_prefix(fqn);
+        let keys = crate::references::class_candidate_keys(target, crate::util::short_name(target));
+        if self.user_file_symbol_maps_for_reference_keys(&keys).iter().any(|(_, map)| {
+            map.spans.iter().any(|span| matches!(&span.kind,
+                crate::symbol_map::SymbolKind::ClassReference { name, context: crate::symbol_map::ClassRefContext::RuntimeControllerString, .. }
+                if crate::util::strip_fqn_prefix(name).eq_ignore_ascii_case(target)))
+        }) {
+            return Err("Class edits involving runtime controller strings require a quoting-aware rewrite; no edits were produced.".into());
+        }
+        Ok(())
+    }
+}

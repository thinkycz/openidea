+async fn assert_runtime_action_class(text: &str, needle: &str, declaration: &str) {
+    use crate::common::position_after;
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///runtime-action-class.php").unwrap();
+    open_php(&backend, &uri, text).await;
+    let at = position_after(text, needle);
+    let expected = position_after(text, declaration);
+    let target = goto_def(&backend, &uri, at.line, at.character).await;
+    assert!(
+        matches!(target,Some(GotoDefinitionResponse::Scalar(ref l)) if l.uri==uri && l.range.start==expected),
+        "runtime class target {needle}: {target:?}"
+    );
+    let hover = backend
+        .hover(HoverParams {
+            text_document_position_params: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier { uri: uri.clone() },
+                position: at,
+            },
+            work_done_progress_params: Default::default(),
+        })
+        .await
+        .unwrap()
+        .expect("runtime class hover");
+    assert!(
+        matches!(hover.contents,HoverContents::Markup(ref m) if m.value.contains("class InvoiceController") && m.value.contains("namespace App;")),
+        "runtime class hover {hover:?}"
+    );
+}
+fn runtime_action_class_fixture(calls: &str) -> String {
+    format!(

+    .iter()
+    .map(|n| position_after(&text, n))
+    .collect();
+    expected.sort_by_key(|p| (p.line, p.character));
+    assert_eq!(actual, expected, "all class references, no method suffixes");
+    let ctor = position_after(&text, "public function ");
+    let item = backend
+        .prepare_call_hierarchy(CallHierarchyPrepareParams {
+            text_document_position_params: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier { uri: uri.clone() },
+                position: ctor,
+            },
+            work_done_progress_params: Default::default(),
+        })
+        .await
+        .unwrap()
+        .unwrap()
+        .remove(0);
+    let callers = backend
+        .incoming_calls(CallHierarchyIncomingCallsParams {
+            item,
+            work_done_progress_params: Default::default(),
+            partial_result_params: Default::default(),
+        })
+        .await
+        .unwrap()
+        .unwrap_or_default();
+    assert_eq!(
+        callers.len(),
+        1,
+        "runtime strings must not instantiate controllers: {callers:?}"
+    );
+    assert_eq!(callers[0].from.name, "instantiateController");

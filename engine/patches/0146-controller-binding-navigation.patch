+#[tokio::test]
+async fn group_binding_preserves_unknown_namespace_information_without_borrowing_an_owner() {
+    use crate::common::position_after;
+    let text = runtime_action_class_fixture(
+        "Routes::namespace('App')->controller('InvoiceController')->group(function () {Routes::get('/known','showInvoice');Routes::namespace($selected)->group(fn () => Routes::get('/unknown','showInvoice'));});",
+    );
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///partial-runtime-controller.php").unwrap();
+    open_php(&backend, &uri, &text).await;
+    let at = position_after(&text, "controller('In");
+    let hover = backend
+        .hover(HoverParams {
+            text_document_position_params: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier { uri: uri.clone() },
+                position: at,
+            },
+            work_done_progress_params: Default::default(),
+        })
+        .await
+        .unwrap()
+        .expect("partial binding hover");
+    assert!(
+        matches!(hover.contents,HoverContents::Markup(ref m) if m.value.contains("namespace App;") && m.value.contains("unresolved")),
+        "unknown context must remain visible: {hover:?}"
+    );
+    let unknown = position_after(&text, "'/unknown','sh");
+    assert!(
+        goto_def(&backend, &uri, unknown.line, unknown.character)
+            .await
+            .is_none()

+#[tokio::test]
+async fn group_controller_class_strings_follow_runtime_namespaces_and_literal_escapes() {
+    for (call, needle) in [
+        (
+            "Routes::controller('App\\InvoiceController')->group(fn () => Routes::get('/direct', 'showInvoice'));",
+            "controller('Ap",
+        ),
+        (
+            "Routes::namespace('App')->controller('InvoiceController')->group(fn () => Routes::get('/short', 'showInvoice'));",
+            "controller('In",
+        ),
+        (
+            "Routes::group(routes:fn () => Routes::get('/attrs', 'showInvoice'), attributes:['namespace'=>'App', 'controller'=>'InvoiceController']);",
+            "'controller'=>'In",
+        ),
+        (
+            "Routes::controller(\"App\\\\Inv\\x6ficeController\")->group(fn () => Routes::get('/encoded', 'showInvoice'));",
+            "controller(\"Ap",
+        ),
+        (
+            "Routes::namespace($selected)->controller('\\App\\InvoiceController')->group(fn () => Routes::get('/rooted', 'showInvoice'));",
+            "controller('\\Ap",
+        ),
+    ] {
+        assert_runtime_action_class(
+            &runtime_action_class_fixture(call),
+            needle,
+            "namespace App {",
+        )
+        .await;
+    }
+}

+#[tokio::test]
+async fn one_controller_binding_navigates_to_every_registered_namespace_target() {
+    use crate::common::position_after;
+    let text = runtime_action_class_fixture(
+        "Routes::namespace('App')->controller('InvoiceController')->group(function () { Routes::get('/main', 'showInvoice'); Routes::namespace('Other')->group(fn () => Routes::get('/other', 'showInvoice')); });",
+    );
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///multiple-runtime-controllers.php").unwrap();
+    open_php(&backend, &uri, &text).await;
+    let at = position_after(&text, "controller('In");
+    let result = goto_def(&backend, &uri, at.line, at.character).await;
+    let Some(GotoDefinitionResponse::Array(locations)) = result else {
+        panic!("binding must retain both targets: {result:?}")
+    };
+    let mut actual: Vec<_> = locations
+        .iter()
+        .map(|l| {
+            assert_eq!(l.uri, uri);
+            l.range.start
+        })
+        .collect();
+    actual.sort_by_key(|p| (p.line, p.character));
+    let mut expected = vec![
+        position_after(&text, "namespace App {"),
+        position_after(&text, "namespace App\\Other {"),
+    ];
+    expected.sort_by_key(|p| (p.line, p.character));
+    assert_eq!(actual, expected);
+    let hover = backend
+        .hover(HoverParams {
+            text_document_position_params: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier { uri: uri.clone() },
+                position: at,
+            },
+            work_done_progress_params: Default::default(),
+        })
+        .await
+        .unwrap()
+        .expect("multiple controller hover");
+    assert!(
+        matches!(hover.contents,HoverContents::Markup(ref m) if m.value.contains("namespace App;") && m.value.contains("namespace App\\Other;")),
+        "{hover:?}"
+    );
+    let types = backend
+        .goto_type_definition(tower_lsp::lsp_types::request::GotoTypeDefinitionParams {
+            text_document_position_params: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier { uri: uri.clone() },
+                position: at,
+            },
+            work_done_progress_params: Default::default(),
+            partial_result_params: Default::default(),
+        })
+        .await
+        .unwrap();
+    let Some(GotoDefinitionResponse::Array(types)) = types else {
+        panic!("binding type targets: {types:?}")
+    };
+    let mut lines: Vec<_> = types
+        .iter()
+        .map(|l| {
+            assert_eq!(l.uri, uri);
+            l.range.start.line
+        })
+        .collect();
+    lines.sort();
+    assert_eq!(lines, vec![1, 2]);
+    let highlights = backend
+        .handle_document_highlight(uri.as_str(), &text, at)
+        .unwrap();
+    assert_eq!(
+        highlights.len(),
+        4,
+        "highlight the two declarations, alias import and one shared binding: {highlights:?}"
+    );
+}

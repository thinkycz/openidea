+//! Quoting-aware short-name edits for statically proven runtime controller strings.
+use crate::Backend;
+use crate::symbol_map::{ClassRefContext, SymbolKind, SymbolSpan};
+use crate::text_position::offset_to_position;
+use crate::util::{short_name, strip_fqn_prefix};
+use tower_lsp::lsp_types::{Range, TextEdit};
+
+/// One source-verified runtime class spelling and its unchanged quote style.
+pub(super) struct RuntimeControllerSite {
+    /// The reference file containing the literal.
+    pub uri: String,
+    /// Only the class interior, excluding quotes and the method suffix.
+    pub range: Range,
+    spelling: String,
+    quote: char,
+}
+
+impl RuntimeControllerSite {
+    /// Encode a renamed short class name without applying PHP import aliases.
+    pub(super) fn edit(&self, new_short_name: &str) -> TextEdit {
+        let prefix = self
+            .spelling
+            .rfind('\\')
+            .map_or("", |i| &self.spelling[..=i]);
+        let mut encoded = String::with_capacity(
+            prefix
+                .len()
+                .saturating_mul(2)
+                .saturating_add(new_short_name.len()),
+        );
+        for ch in prefix.chars().chain(new_short_name.chars()) {
+            if ch == '\\' || ch == self.quote || (self.quote == '"' && ch == '$') {
+                encoded.push('\\');
+            }
+            encoded.push(ch);
+        }
+        TextEdit {
+            range: self.range,
+            new_text: encoded,
+        }
+    }
+}
+
+/// Whether this symbol uses Laravel runtime class spelling rather than PHP imports.
+pub(super) fn is_runtime_class(kind: &SymbolKind) -> bool {
+    matches!(
+        kind,
+        SymbolKind::ClassReference {
+            context: ClassRefContext::RuntimeControllerString,
+            ..
+        } | SymbolKind::RuntimeControllerBinding { .. }
+    )
+}
+
+/// The AST's full source fingerprint must be checked by the caller. Decode only
+/// the class interior; quotes and an explicit @method suffix stay outside edits.
+pub(super) fn runtime_spelling(content: &str, span: &SymbolSpan) -> Option<(String, char)> {
+    let (identity, runtime_name) = match &span.kind {
+        SymbolKind::ClassReference {
+            name,
+            context: ClassRefContext::RuntimeControllerString,
+            ..
+        } => (name.as_str(), None),
+        SymbolKind::RuntimeControllerBinding {
+            runtime_name,
+            targets,
+            incomplete: false,
+        } if targets.len() == 1 => (targets[0].as_str(), Some(runtime_name.as_str())),
+        _ => return None,
+    };
+    let start = span.start as usize;
+    let end = span.end as usize;
+    let quote = *content.as_bytes().get(start.checked_sub(1)?)? as char;
+    if !matches!(quote, '\'' | '"')
+        || !matches!(
+            content.as_bytes().get(end),
+            Some(b'@') | Some(b'\'') | Some(b'"')
+        )
+    {
+        return None;
+    }
+    if content.as_bytes().get(end) != Some(&b'@')
+        && content.as_bytes().get(end).copied() != Some(quote as u8)
+    {
+        return None;
+    }
+    let raw = content.get(start..end)?;
+    let literal = format!("{quote}{raw}{quote}");
+    let decoded = crate::text_scan::decode_php_string_literal(&literal)?.into_owned();
+    let body = strip_fqn_prefix(&decoded);
+    let target = strip_fqn_prefix(identity);
+    let qualified_suffix = target.len().checked_sub(body.len()).is_some_and(|start| {
+        start > 0
+            && target.as_bytes().get(start - 1) == Some(&b'\\')
+            && target
+                .get(start..)
+                .is_some_and(|suffix| suffix.eq_ignore_ascii_case(body))
+    });
+    if !short_name(body).eq_ignore_ascii_case(short_name(target))
+        || (decoded.starts_with('\\') && !body.eq_ignore_ascii_case(target))
+        || (!body.eq_ignore_ascii_case(target) && !qualified_suffix)
+        || runtime_name.is_some_and(|name| !strip_fqn_prefix(name).eq_ignore_ascii_case(body))
+    {
+        return None;
+    }
+    Some((decoded, quote))
+}
+
+impl Backend {
+    /// Validate the entire affected runtime reference set before producing any edit.
+    /// A shared/unknown binding cannot be safely changed for just one class.
+    pub(super) fn runtime_controller_sites(
+        &self,
+        fqn: &str,
+    ) -> Result<Vec<RuntimeControllerSite>, String> {
+        let target = strip_fqn_prefix(fqn);
+        let keys = crate::references::class_candidate_keys(target, short_name(target));
+        let mut sites = Vec::new();
+        for (uri, map) in self.user_file_symbol_maps_for_reference_keys(&keys) {
+            let mut content = None;
+            let mut source_verified = false;
+            for span in &map.spans {
+                let affected = match &span.kind {
+                    SymbolKind::ClassReference {
+                        name,
+                        context: ClassRefContext::RuntimeControllerString,
+                        ..
+                    } => strip_fqn_prefix(name).eq_ignore_ascii_case(target),
+                    SymbolKind::RuntimeControllerBinding {
+                        runtime_name,
+                        targets,
+                        incomplete,
+                    } => {
+                        targets
+                            .iter()
+                            .any(|name| strip_fqn_prefix(name).eq_ignore_ascii_case(target))
+                            || (*incomplete
+                                && short_name(runtime_name)
+                                    .eq_ignore_ascii_case(short_name(target)))
+                    }
+                    _ => false,
+                };
+                if !affected {
+                    continue;
+                }
+                let content = content
+                    .get_or_insert_with(|| self.reference_file_content_arc(&uri))
+                    .as_deref()
+                    .ok_or(
+                        "Could not read a runtime controller reference; no edits were produced.",
+                    )?;
+                if !source_verified {
+                    if !map.matches_source_fingerprint(content) {
+                        return Err(
+                            "A runtime controller source changed; request a new rename.".into()
+                        );
+                    }
+                    source_verified = true;
+                }
+                let (spelling,quote)=runtime_spelling(content,span).ok_or("A runtime controller binding is ambiguous, unresolved or cannot be safely quoted; no edits were produced.")?;
+                sites.push(RuntimeControllerSite {
+                    uri: uri.to_string(),
+                    range: Range::new(
+                        offset_to_position(content, span.start as usize),
+                        offset_to_position(content, span.end as usize),
+                    ),
+                    spelling,
+                    quote,
+                });
+            }
+        }
+        Ok(sites)
+    }
+
+    /// Refuse an unsafe runtime reference anywhere in the affected class set.
+    pub(super) fn reject_runtime_controller_class_rename(&self, fqn: &str) -> Result<(), String> {
+        self.runtime_controller_sites(fqn).map(|_| ())
+    }
+}

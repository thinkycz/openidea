+async fn runtime_controller_class_rename_entry_matches_declaration_plan() {
+    use crate::common::position_after;
+    for call in [
+        r#"Routes::get('/direct', 'App\InvoiceController@showInvoice');"#,
+        r#"Routes::namespace('App')->group(fn () => Routes::get('/short', 'InvoiceController@showInvoice'));"#,
+        r#"Routes::get('/escaped', "App\\Inv\x6ficeController@showInvoice");"#,
+        r#"Routes::get('/unicode', "\u{41}pp\\InvoiceController@showInvoice");"#,
+        r#"Routes::get('/octal', "\101pp\\InvoiceController@showInvoice");"#,
+        r#"Routes::namespace($selected)->controller('\App\InvoiceController')->group(fn () => Routes::get('/rooted', 'showInvoice'));"#,
+        r#"Routes::namespace('App')->controller('InvoiceController')->group(fn () => Routes::get('/bound', 'showInvoice'));"#,
+        r#"Routes::group(['namespace'=>'App','controller'=>'InvoiceController'],fn () => Routes::get('/attrs','showInvoice'));"#,
+    ] {
+        let text = runtime_action_class_fixture(call);
+        let backend = create_test_backend();
+        let uri = Url::parse("file:///runtime-rename-entry.php").unwrap();
+        open_php(&backend, &uri, &text).await;
+        let at = position_after(&text, &call[..call.rfind("Controller").unwrap() + 3]);
+        let prepared = backend
+            .prepare_rename(TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier { uri: uri.clone() },
+                position: at,
+            })
+            .await
+            .unwrap()
+            .expect("single-target runtime class must offer Rename");
+        let PrepareRenameResponse::RangeWithPlaceholder { range, placeholder } = prepared else {
+            panic!("rename placeholder")
+        };
+        assert_eq!(placeholder, "App\\InvoiceController");
+        let raw = text
+            .lines()
+            .nth(range.start.line as usize)
+            .unwrap()
+            .chars()
+            .skip(range.start.character as usize)
+            .take((range.end.character - range.start.character) as usize)
+            .collect::<String>();
+        assert!(
+            !raw.contains('@') && !raw.contains('\'') && !raw.contains('"'),
+            "class range excludes quotes and method: {raw}"
+        );
+        for new_name in [
+            "ReceiptController",
+            "App\\ReceiptController",
+            "InvoiceController",
+            "App\\InvoiceController",
+        ] {
+            let mut plans = Vec::new();
+            for position in [at, position_after(&text, "namespace App {class ")] {
+                plans.push(
+                    backend
+                        .rename(RenameParams {
+                            text_document_position: TextDocumentPositionParams {
+                                text_document: TextDocumentIdentifier { uri: uri.clone() },
+                                position,
+                            },
+                            new_name: new_name.into(),
+                            work_done_progress_params: Default::default(),
+                        })
+                        .await
+                        .unwrap(),
+                );
+            }
+            assert_eq!(
+                plans[0], plans[1],
+                "runtime entry must reuse declaration plan: {call}, {new_name}"
+            );
+        }
+    }

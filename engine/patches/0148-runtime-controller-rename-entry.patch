 impl Backend {
+    /// Resolve a verified literal entry to the ordinary PHP declaration rename path.
+    pub(super) fn runtime_controller_rename_declaration(
+        &self,
+        uri: &str,
+        content: &str,
+        span: &SymbolSpan,
+    ) -> Result<(String, String, tower_lsp::lsp_types::Position), String> {
+        let invalid = "The runtime controller binding is stale, ambiguous or unresolved; no edits were produced.";
+        let map = self.symbol_maps.read().get(uri).cloned().ok_or(invalid)?;
+        if !map.matches_source_fingerprint(content) {
+            return Err(invalid.into());
+        }
+        let source_span = map
+            .spans
+            .iter()
+            .find(|site| {
+                site.start == span.start && site.end == span.end && is_runtime_class(&site.kind)
+            })
+            .ok_or(invalid)?;
+        runtime_spelling(content, source_span).ok_or(invalid)?;
+        let target = match &source_span.kind {
+            SymbolKind::ClassReference { name, .. } => name.as_str(),
+            SymbolKind::RuntimeControllerBinding {
+                targets,
+                incomplete: false,
+                ..
+            } if targets.len() == 1 => targets[0].as_str(),
+            _ => return Err(invalid.into()),
+        };
+        self.runtime_controller_sites(target)?;
+        self.class_rename_declaration_site(target)
+            .map_err(|reason| format!("Runtime controller class cannot be renamed: {reason}"))
+    }
+

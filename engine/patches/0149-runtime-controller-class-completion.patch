+#[tokio::test]
+async fn runtime_controller_class_completion_uses_rooted_names_without_php_imports() {
+    use crate::common::{apply_edits, position_after};
+    for (call, needle, expected) in [
+        (
+            r#"Routes::get('/😀/direct', 'App\InvOLD@showInvoice');"#,
+            r#"'/😀/direct', 'App\In"#,
+            r#"Routes::get('/😀/direct', '\\App\\InvoiceController@showInvoice');"#,
+        ),
+        (
+            r#"Routes::namespace('App')->group(fn () => Routes::get('/short', 'InvOLD@showInvoice'));"#,
+            r#"'/short', 'In"#,
+            r#"Routes::namespace('App')->group(fn () => Routes::get('/short', '\\App\\InvoiceController@showInvoice'));"#,
+        ),
+        (
+            r#"Routes::namespace('App')->group(fn () => Routes::get('/full', 'App\InvOLD@showInvoice'));"#,
+            r#"'/full', 'App\In"#,
+            r#"Routes::namespace('App')->group(fn () => Routes::get('/full', '\\App\\InvoiceController@showInvoice'));"#,
+        ),
+        (
+            r#"Routes::get('/hex', "App\\Inv\x4fLD@showInvoice");"#,
+            r#"'/hex', "App\\Inv"#,
+            r#"Routes::get('/hex', "\\App\\InvoiceController@showInvoice");"#,
+        ),
+        (
+            r#"Routes::get('/unicode', "\u{41}pp\\InvOLD@showInvoice");"#,
+            r#"'/unicode', "\u{41}pp\\In"#,
+            r#"Routes::get('/unicode', "\\App\\InvoiceController@showInvoice");"#,
+        ),
+        (
+            r#"Routes::namespace($selected)->controller('\App\InvOLD')->group(fn () => Routes::get('/rooted', 'showInvoice'));"#,
+            r#"controller('\App\In"#,
+            r#"Routes::namespace($selected)->controller('\\App\\InvoiceController')->group(fn () => Routes::get('/rooted', 'showInvoice'));"#,
+        ),
+        (
+            r#"Routes::namespace('App')->controller('InvOLD')->group(fn () => Routes::get('/bound', 'showInvoice'));"#,
+            r#"controller('In"#,
+            r#"Routes::namespace('App')->controller('\\App\\InvoiceController')->group(fn () => Routes::get('/bound', 'showInvoice'));"#,
+        ),
+        (
+            r#"Routes::group(['namespace'=>'App','controller'=>'InvOLD'],fn () => Routes::get('/attrs','showInvoice'));"#,
+            r#"'controller'=>'In"#,
+            r#"Routes::group(['namespace'=>'App','controller'=>'\\App\\InvoiceController'],fn () => Routes::get('/attrs','showInvoice'));"#,
+        ),
+    ] {
+        let text = runtime_action_class_fixture(call);
+        let backend = create_test_backend();
+        let uri = Url::parse("file:///runtime-class-completion.php").unwrap();
+        open_php(&backend, &uri, &text).await;
+        let at = position_after(&text, needle);
+        let items = complete_at(&backend, &uri, &text, at.line, at.character).await;
+        let item = items
+            .into_iter()
+            .find(|item| {
+                item.kind == Some(CompletionItemKind::CLASS)
+                    && item.detail.as_deref() == Some("App\\InvoiceController")
+            })
+            .expect("runtime class completion must offer the actual controller");
+        assert!(
+            item.additional_text_edits
+                .as_ref()
+                .is_none_or(Vec::is_empty),
+            "runtime strings must not add PHP imports"
+        );
+        assert!(item.insert_text_format.is_none());
+        assert!(
+            item.filter_text.as_deref().is_some_and(|text| {
+                text.ends_with("InvoiceController") && !text.contains("OLD")
+            }),
+            "filtering must follow the candidate, not the replaced suffix"
+        );
+        let Some(CompletionTextEdit::Edit(edit)) = &item.text_edit else {
+            panic!("runtime class completion requires a full class-interior edit: {item:?}")
+        };
+        assert_eq!(
+            apply_edits(&text, std::slice::from_ref(edit)),
+            runtime_action_class_fixture(expected),
+            "quotes/suffix/aliases/UTF16 must survive: {call}"
+        );
+        let resolved = backend.completion_resolve(item.clone()).await.unwrap();
+        assert_eq!(resolved.text_edit, item.text_edit);
+        assert_eq!(resolved.additional_text_edits, item.additional_text_edits);
+        assert!(
+            resolved.documentation.is_some(),
+            "controller documentation must resolve"
+        );
+    }
+}

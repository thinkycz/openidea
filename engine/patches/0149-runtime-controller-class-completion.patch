+#[tokio::test]
+async fn runtime_controller_class_completion_retains_catalog_limit() {
+    use crate::common::position_after;
+    let mut text = runtime_action_class_fixture(
+        "Routes::namespace('App')->controller('COLD')->group(fn () => Routes::get('/limit','showInvoice')); ",
+    );
+    text.push_str("namespace App {");
+    for n in 0..104 {
+        text.push_str(&format!("class C{n:03} {{}}"));
+    }
+    text.push('}');
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///runtime-class-completion-limit.php").unwrap();
+    open_php(&backend, &uri, &text).await;
+    let at = position_after(&text, "controller('C");
+    let response = backend
+        .completion(CompletionParams {
+            text_document_position: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier { uri },
+                position: at,
+            },
+            work_done_progress_params: Default::default(),
+            partial_result_params: Default::default(),
+            context: None,
+        })
+        .await
+        .unwrap();
+    let Some(CompletionResponse::List(list)) = response else {
+        panic!("runtime class catalog must retain its list metadata")
+    };
+    assert!(list.is_incomplete);
+    assert_eq!(list.items.len(), 100);
+    assert!(list.items.iter().all(|item| {
+        item.kind == Some(CompletionItemKind::CLASS)
+            && item
+                .additional_text_edits
+                .as_ref()
+                .is_none_or(Vec::is_empty)
+    }));
+}

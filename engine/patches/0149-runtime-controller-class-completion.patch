+#[tokio::test]
+async fn runtime_controller_class_completion_tracks_unsaved_candidate_declarations() {
+    use crate::common::position_after;
+    let text = runtime_action_class_fixture(
+        "Routes::namespace('App')->controller('InvOLD')->group(fn () => Routes::get('/unsaved','showInvoice')); ",
+    );
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///runtime-class-completion-caller.php").unwrap();
+    let dependency = Url::parse("file:///runtime-class-completion-dependency.php").unwrap();
+    open_php(&backend, &uri, &text).await;
+    let at = position_after(&text, "controller('In");
+    for name in ["InvoiceDraftController", "InvoicePublishedController"] {
+        let source = format!(
+            "<?php namespace App; class {name} {{public function showInvoice(): bool {{return true;}}}}"
+        );
+        open_php(&backend, &dependency, &source).await;
+        let items = complete_at(&backend, &uri, &text, at.line, at.character).await;
+        assert!(
+            items
+                .iter()
+                .any(|item| item.detail.as_deref() == Some(&format!("App\\{name}"))),
+            "unsaved class must enter the runtime catalog"
+        );
+        if name == "InvoicePublishedController" {
+            assert!(
+                !items
+                    .iter()
+                    .any(|item| item.detail.as_deref() == Some("App\\InvoiceDraftController")),
+                "retired unsaved class must leave the catalog"
+            );
+        }
+    }
+}

+#[tokio::test]
+async fn runtime_controller_class_completion_retains_ambiguous_and_unknown_context() {
+    use crate::common::position_after;
+    for call in [
+        r#"Routes::namespace('App')->controller('InvOLD')->group(function () {Routes::get('/main','showInvoice');Routes::namespace('Other')->group(fn () => Routes::get('/other','showInvoice'));});"#,
+        r#"Routes::namespace($selected)->controller('InvOLD')->group(fn () => Routes::get('/unknown','showInvoice'));"#,
+    ] {
+        let text = runtime_action_class_fixture(call);
+        let backend = create_test_backend();
+        let uri = Url::parse("file:///runtime-class-completion-incomplete.php").unwrap();
+        open_php(&backend, &uri, &text).await;
+        let at = position_after(&text, "controller('In");
+        let response = backend
+            .completion(CompletionParams {
+                text_document_position: TextDocumentPositionParams {
+                    text_document: TextDocumentIdentifier { uri },
+                    position: at,
+                },
+                work_done_progress_params: Default::default(),
+                partial_result_params: Default::default(),
+                context: None,
+            })
+            .await
+            .unwrap();
+        assert!(
+            matches!(response,Some(CompletionResponse::List(ref list)) if list.items.is_empty()&&list.is_incomplete),
+            "unknown/ambiguous runtime context must remain incomplete: {response:?}"
+        );
+    }
+}

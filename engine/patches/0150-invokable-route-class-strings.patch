+#[tokio::test]
+async fn invokable_route_class_references_include_literals_and_no_constructor_calls() {
+    use crate::common::position_after;
+    let text = invokable_action_class_fixture(
+        "Routes::get('/one','App\\InvoiceController'); Routes::namespace('App')->group(fn () => Routes::get('/two','InvoiceController')); function instantiateInvokable() {new \\App\\InvoiceController();}",
+    );
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///invokable-references.php").unwrap();
+    open_php(&backend, &uri, &text).await;
+    let declaration = position_after(&text, "namespace App {class ");
+    let refs = backend
+        .references(ReferenceParams {
+            text_document_position: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier { uri: uri.clone() },
+                position: declaration,
+            },
+            context: ReferenceContext {
+                include_declaration: true,
+            },
+            work_done_progress_params: Default::default(),
+            partial_result_params: Default::default(),
+        })
+        .await
+        .unwrap()
+        .unwrap();
+    let mut actual: Vec<_> = refs.iter().map(|l| l.range.start).collect();
+    actual.sort_by_key(|p| (p.line, p.character));
+    let mut expected: Vec<_> = ["namespace App {class ", "'/one','", "'/two','", "new "]
+        .iter()
+        .map(|n| position_after(&text, n))
+        .collect();
+    expected.sort_by_key(|p| (p.line, p.character));
+    assert_eq!(
+        actual, expected,
+        "invokable strings must be class references"
+    );
+    let mut ctor = position_after(&text, "public function __construct");
+    ctor.character -= "__construct".len() as u32;
+    let item = backend
+        .prepare_call_hierarchy(CallHierarchyPrepareParams {
+            text_document_position_params: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier { uri: uri.clone() },
+                position: ctor,
+            },
+            work_done_progress_params: Default::default(),
+        })
+        .await
+        .unwrap()
+        .unwrap()
+        .remove(0);
+    let callers = backend
+        .incoming_calls(CallHierarchyIncomingCallsParams {
+            item,
+            work_done_progress_params: Default::default(),
+            partial_result_params: Default::default(),
+        })
+        .await
+        .unwrap()
+        .unwrap_or_default();
+    assert_eq!(
+        callers.len(),
+        1,
+        "registration is not constructor execution"
+    );
+    assert_eq!(callers[0].from.name, "instantiateInvokable");
+}

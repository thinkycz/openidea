+#[tokio::test]
+async fn invokable_class_detection_preserves_bare_group_methods_and_ignores_other_literals() {
+    use crate::common::position_after;
+    let text = invokable_action_class_fixture(
+        "Routes::controller(\\App\\InvoiceController::class)->group(fn () => Routes::get('/group','showInvoice')); Routes::get('/App/InvoiceController',fn () => true); class LocalRoutes {public static function get($uri,$action) {}} LocalRoutes::get('/not-framework','App\\InvoiceController');",
+    );
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///invokable-controls.php").unwrap();
+    open_php(&backend, &uri, &text).await;
+    let action = position_after(&text, "'/group','show");
+    let target = goto_def(&backend, &uri, action.line, action.character).await;
+    assert!(
+        matches!(target,Some(GotoDefinitionResponse::Scalar(ref l)) if l.range.start=={let mut declaration=position_after(&text, "public function showInvoice"); declaration.character -= "showInvoice".len() as u32; declaration})
+    );
+    for needle in ["'/App/Invoice", "'/not-framework','App\\In"] {
+        let at = position_after(&text, needle);
+        let result = goto_def(&backend, &uri, at.line, at.character).await;
+        assert!(
+            result.is_none()
+                || matches!(result,Some(GotoDefinitionResponse::Array(ref rows)) if rows.is_empty()),
+            "non-action literal must not become a class reference: {result:?}"
+        );
+    }
+}

+/// A registered class-string action without an explicit method suffix.
+pub(crate) struct InvokableRouteClass {
+    pub controller: RouteControllerRef,
+    pub start: u32,
+    pub end: u32,
+}
+
+pub(crate) fn laravel_invokable_route_class(
+    expr: &Expression<'_>,
+    names: Option<&crate::names::OwnedResolvedNames>,
+    content: &str,
+) -> Option<InvokableRouteClass> {
+    let Expression::Literal(literal::Literal::String(value)) =
+        laravel_route_action_argument(expr, names)?
+    else {
+        return None;
+    };
+    let decoded = value.value.and_then(literal_bytes_to_str)?;
+    if decoded.contains('@') {
+        return None;
+    }
+    let controller = laravel_runtime_controller_ref(decoded)?;
+    let start = value.span.start.offset.checked_add(1)?;
+    let end = value.span.end.offset.checked_sub(1)?;
+    let quote = *content.as_bytes().get(value.span.start.offset as usize)?;
+    if !matches!(quote, b'\'' | b'"') || content.as_bytes().get(end as usize) != Some(&quote) {
+        return None;
+    }
+    Some(InvokableRouteClass {
+        controller,
+        start,
+        end,
+    })
+}

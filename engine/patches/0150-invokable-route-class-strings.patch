+#[tokio::test]
+async fn invokable_route_class_strings_complete_only_the_full_class_interior() {
+    use crate::common::{apply_edits, position_after};
+    for (call, needle, expected) in [
+        (
+            r#"Routes::get('/😀/direct','App\InvOLD');"#,
+            r#"'/😀/direct','App\In"#,
+            r#"Routes::get('/😀/direct','\\App\\InvoiceController');"#,
+        ),
+        (
+            r#"Routes::namespace('App')->group(fn () => Routes::get('/short','InvOLD'));"#,
+            r#"'/short','In"#,
+            r#"Routes::namespace('App')->group(fn () => Routes::get('/short','\\App\\InvoiceController'));"#,
+        ),
+        (
+            r#"Routes::get('/hex',"App\\Inv\x4fLD");"#,
+            r#"'/hex',"App\\Inv"#,
+            r#"Routes::get('/hex',"\\App\\InvoiceController");"#,
+        ),
+    ] {
+        let text = invokable_action_class_fixture(call);
+        let backend = create_test_backend();
+        let uri = Url::parse("file:///invokable-completion.php").unwrap();
+        open_php(&backend, &uri, &text).await;
+        let at = position_after(&text, needle);
+        let items = complete_at(&backend, &uri, &text, at.line, at.character).await;
+        let item = items
+            .into_iter()
+            .find(|i| i.detail.as_deref() == Some("App\\InvoiceController"))
+            .expect("invokable runtime class must complete");
+        assert!(
+            item.additional_text_edits
+                .as_ref()
+                .is_none_or(Vec::is_empty)
+        );
+        assert!(item.insert_text_format.is_none());
+        let Some(CompletionTextEdit::Edit(edit)) = &item.text_edit else {
+            panic!("invokable class needs an explicit full-interior edit")
+        };
+        assert_eq!(
+            apply_edits(&text, std::slice::from_ref(edit)),
+            invokable_action_class_fixture(expected)
+        );
+        let resolved = backend.completion_resolve(item.clone()).await.unwrap();
+        assert_eq!(resolved.text_edit, item.text_edit);
+        assert_eq!(resolved.additional_text_edits, item.additional_text_edits);
+    }
+}

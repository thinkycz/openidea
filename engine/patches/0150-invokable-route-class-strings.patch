+#[tokio::test]
+async fn invokable_route_class_strings_navigate_hover_and_rename_without_php_imports() {
+    use crate::common::{apply_edits, position_after};
+    for (call, needle) in [
+        (
+            r#"Routes::get('/😀/direct','App\InvoiceController');"#,
+            r#"'/😀/direct','App\In"#,
+        ),
+        (
+            r#"Routes::match(action:'App\InvoiceController',methods:['post'],uri:'/named');"#,
+            r#"action:'App\In"#,
+        ),
+        (
+            r#"Routes::namespace('App')->group(fn () => Routes::get('/relative','InvoiceController'));"#,
+            r#"'/relative','In"#,
+        ),
+        (
+            r#"Routes::namespace($selected)->group(fn () => Routes::get('/rooted','\App\InvoiceController'));"#,
+            r#"'/rooted','\App\In"#,
+        ),
+        (
+            r#"Routes::get('/encoded',"\u{41}pp\\InvoiceController");"#,
+            r#"'/encoded',"\u{41}pp\\In"#,
+        ),
+        (
+            r#"Routes::controller(\App\Other\InvoiceController::class)->group(fn () => Routes::get('/override','\App\InvoiceController'));"#,
+            r#"'/override','\App\In"#,
+        ),
+        (
+            r#"Routes::namespace('App')->controller(\App\Other\InvoiceController::class)->group(fn () => Routes::get('/qualified','App\InvoiceController'));"#,
+            r#"'/qualified','App\In"#,
+        ),
+    ] {
+        let text = invokable_action_class_fixture(call);
+        assert_runtime_action_class(&text, needle, "namespace App {").await;
+        let backend = create_test_backend();
+        let uri = Url::parse("file:///invokable-rename.php").unwrap();
+        open_php(&backend, &uri, &text).await;
+        let at = position_after(&text, needle);
+        let result = backend
+            .rename(RenameParams {
+                text_document_position: TextDocumentPositionParams {
+                    text_document: TextDocumentIdentifier { uri: uri.clone() },
+                    position: at,
+                },
+                new_name: "ReceiptController".into(),
+                work_done_progress_params: Default::default(),
+            })
+            .await
+            .unwrap();
+        let edits = result.unwrap().changes.unwrap().remove(&uri).unwrap();
+        let edited = apply_edits(&text, &edits);
+        assert!(
+            !edited.contains("InvoiceController');") && !edited.contains("InvoiceController\");"),
+            "invokable class starter must rename the literal: {edited}"
+        );
+        assert!(edited.contains("class ReceiptController"));
+        assert!(edited.contains("function __invoke()"));
+        assert!(
+            edited.contains("use App\\Other\\InvoiceController as InvoiceController;"),
+            "runtime class rename must retain unrelated PHP aliases"
+        );
+    }
+}

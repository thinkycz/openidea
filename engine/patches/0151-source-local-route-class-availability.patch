+async fn available_class_target(
+    backend: &phpantom_lsp::Backend,
+    uri: &Url,
+    text: &str,
+    needle: &str,
+) -> Position {
+    use crate::common::position_after;
+    let at = position_after(text, needle);
+    match goto_def(backend, uri, at.line, at.character).await {
+        Some(GotoDefinitionResponse::Scalar(location)) => {
+            assert_eq!(&location.uri, uri);
+            location.range.start
+        }
+        Some(GotoDefinitionResponse::Array(mut locations)) if locations.len() == 1 => {
+            let location = locations.remove(0);
+            assert_eq!(&location.uri, uri);
+            location.range.start
+        }
+        other => panic!("available invokable class must have one definition: {other:?}"),
+    }
+}

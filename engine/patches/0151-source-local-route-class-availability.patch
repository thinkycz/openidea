+// Prior unconditional declarations prove Laravel's raw class_exists lookup.
+fn local_class_declarations(program: &Program<'_>) -> BTreeMap<String, u32> {
+    fn scan<'arena>(
+        statements: &Sequence<'arena, Statement<'arena>>,
+        namespace: &str,
+        classes: &mut BTreeMap<String, u32>,
+    ) {
+        for statement in statements.iter() {
+            let name = match statement {
+                Statement::Namespace(namespace) => {
+                    let name = namespace
+                        .name
+                        .as_ref()
+                        .map_or("", |name| super::bytes_to_str(name.value()));
+                    scan(
+                        namespace.statements(),
+                        name.trim_start_matches('\\'),
+                        classes,
+                    );
+                    continue;
+                }
+                Statement::Block(block) => {
+                    scan(&block.statements, namespace, classes);
+                    continue;
+                }
+                Statement::Class(class) => class.name.value,
+                Statement::Enum(enumeration) => enumeration.name.value,
+                _ => continue,
+            };
+            let name = super::bytes_to_str(name);
+            let fqn = if namespace.is_empty() {
+                name.to_owned()
+            } else {
+                format!("{namespace}\\{name}")
+            };
+            let end = statement.span().end.offset;
+            classes
+                .entry(fqn.to_ascii_lowercase())
+                .and_modify(|previous| *previous = (*previous).min(end))
+                .or_insert(end);
+        }
+    }
+    let mut classes = BTreeMap::new();
+    scan(&program.statements, "", &mut classes);
+    classes
+}

+#[tokio::test]
+async fn available_global_invokable_class_overrides_the_same_named_group_method() {
+    use crate::common::{apply_edits, position_after};
+    let text = available_route_class_fixture(
+        "Routes::controller(\\App\\GroupController::class)->group(fn()=>Routes::get('/😀/bare','InvoiceController'));",
+        true,
+    );
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///available-global.php").unwrap();
+    open_php(&backend, &uri, &text).await;
+    assert_eq!(
+        available_class_target(&backend, &uri, &text, "'/😀/bare','In").await,
+        position_after(&text, "namespace {"),
+        "preloaded global class wins over group method"
+    );
+    let literal = position_after(&text, "'/😀/bare','In");
+    let hover = backend
+        .hover(HoverParams {
+            text_document_position_params: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier { uri: uri.clone() },
+                position: literal,
+            },
+            work_done_progress_params: Default::default(),
+        })
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(
+        matches!(hover.contents,HoverContents::Markup(ref m) if m.value.contains("class InvoiceController")),
+        "available class hover: {hover:?}"
+    );
+    for (position, count) in [
+        (position_after(&text, "namespace {class "), 2),
+        (
+            position_after(&text, "class GroupController {public function "),
+            1,
+        ),
+    ] {
+        let refs = backend
+            .references(ReferenceParams {
+                text_document_position: TextDocumentPositionParams {
+                    text_document: TextDocumentIdentifier { uri: uri.clone() },
+                    position,
+                },
+                context: ReferenceContext {
+                    include_declaration: true,
+                },
+                work_done_progress_params: Default::default(),
+                partial_result_params: Default::default(),
+            })
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(
+            refs.len(),
+            count,
+            "class and method roles must not overlap: {refs:?}"
+        );
+    }
+    let completion = backend
+        .completion(CompletionParams {
+            text_document_position: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier { uri: uri.clone() },
+                position: literal,
+            },
+            work_done_progress_params: Default::default(),
+            partial_result_params: Default::default(),
+            context: None,
+        })
+        .await
+        .unwrap()
+        .unwrap();
+    let items = match completion {
+        CompletionResponse::Array(items) => items,
+        CompletionResponse::List(list) => list.items,
+    };
+    assert!(
+        items
+            .iter()
+            .any(|item| item.kind == Some(CompletionItemKind::CLASS)
+                && item.label == "InvoiceController"),
+        "available class must offer class completion: {items:?}"
+    );
+    assert!(
+        !items
+            .iter()
+            .any(|item| item.kind == Some(CompletionItemKind::METHOD)),
+        "available class must not borrow group method completion"
+    );
+    let prepared = backend
+        .prepare_rename(TextDocumentPositionParams {
+            text_document: TextDocumentIdentifier { uri: uri.clone() },
+            position: literal,
+        })
+        .await
+        .unwrap();
+    assert!(prepared.is_some());
+    let edit = backend
+        .rename(RenameParams {
+            text_document_position: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier { uri: uri.clone() },
+                position: literal,
+            },
+            new_name: "ReceiptController".into(),
+            work_done_progress_params: Default::default(),
+        })
+        .await
+        .unwrap()
+        .unwrap();
+    let edits = edit.changes.unwrap().remove(&uri).unwrap();
+    let changed = apply_edits(&text, &edits);
+    assert!(changed.contains("namespace {class ReceiptController"));
+    assert!(changed.contains("'/😀/bare','ReceiptController'"));
+    assert!(changed.contains("class GroupController {public function InvoiceController"));
+    assert!(changed.contains("use App\\InvoiceController as InvoiceController;"));
+}

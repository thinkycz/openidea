+#[tokio::test]
+async fn available_class_with_namespace_rewrite_navigates_but_refuses_dependency_renames() {
+    use crate::common::position_after;
+    for (call, needle, declaration) in [
+        (
+            "Routes::namespace('App')->controller('GroupController')->group(fn()=>Routes::get('/relative','InvoiceController'));",
+            "'/relative','In",
+            "namespace App {",
+        ),
+        (
+            "Routes::namespace('Prefix')->controller(\\App\\GroupController::class)->group(fn()=>Routes::get('/qualified','App\\InvoiceController'));",
+            "'/qualified','App\\In",
+            "namespace Prefix\\App {",
+        ),
+    ] {
+        let text = available_route_class_fixture(call, true);
+        let backend = create_test_backend();
+        let uri = Url::parse("file:///available-namespace.php").unwrap();
+        open_php(&backend, &uri, &text).await;
+        assert_eq!(
+            available_class_target(&backend, &uri, &text, needle).await,
+            position_after(&text, declaration),
+            "availability check precedes group namespace qualification"
+        );
+        let literal = position_after(&text, needle);
+        assert!(
+            backend
+                .prepare_rename(TextDocumentPositionParams {
+                    text_document: TextDocumentIdentifier { uri: uri.clone() },
+                    position: literal
+                })
+                .await
+                .unwrap()
+                .is_none(),
+            "dependent class spelling must not offer a partial rewrite"
+        );
+        for position in [
+            position_after(&text, "namespace {class "),
+            position_after(&text, "namespace App {class "),
+            position_after(&text, "namespace Prefix\\App {class "),
+        ] {
+            // Only the raw availability class and actual target are affected.
+            let affected = if call.contains("/relative") {
+                position != position_after(&text, "namespace Prefix\\App {class ")
+            } else {
+                position != position_after(&text, "namespace {class ")
+            };
+            if !affected {
+                continue;
+            }
+            let result = backend
+                .rename(RenameParams {
+                    text_document_position: TextDocumentPositionParams {
+                        text_document: TextDocumentIdentifier { uri: uri.clone() },
+                        position,
+                    },
+                    new_name: "ReceiptController".into(),
+                    work_done_progress_params: Default::default(),
+                })
+                .await;
+            assert!(
+                matches!(result,Err(ref e) if e.message.to_ascii_lowercase().contains("runtime controller")),
+                "availability-dependent rename must refuse partial edits: {result:?}"
+            );
+        }
+    }
+}

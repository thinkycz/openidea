+#[cfg(test)]
+mod incremental_population_tests {
+    use super::*;
+    #[test]
+    fn incremental_enum_population_keeps_cold_stub_load_on_merge_thread() {
+        const CHILD: &str = "OPENSTORM_ENUM_MERGE_CHILD";
+        if std::env::var_os(CHILD).is_some() {
+            let backend = Backend::new_test_with_full_stubs();
+            let uri = "file:///incremental-enum.php";
+            backend.update_ast(uri, "<?php class InvoiceController {public function __invoke(): string {return 'global';}}");
+            let class = backend.find_or_load_class("InvoiceController").unwrap();
+            crate::virtual_members::resolve_class_fully_cached(
+                &class,
+                &|name| backend.find_or_load_class(name),
+                &backend.resolved_class_cache,
+            );
+            backend.update_ast(uri, "<?php enum InvoiceController {case Loaded;}");
+            let class = backend.find_or_load_class("InvoiceController").unwrap();
+            assert_eq!(class.kind, crate::types::ClassLikeKind::Enum);
+            return;
+        }
+        let mut child = std::process::Command::new(std::env::current_exe().unwrap())
+            .args(["--exact", "parser::ast_update::incremental_population_tests::incremental_enum_population_keeps_cold_stub_load_on_merge_thread", "--nocapture"])
+            .env(CHILD, "1")
+            .spawn().unwrap();
+        let deadline = std::time::Instant::now() + std::time::Duration::from_secs(10);
+        loop {
+            if let Some(status) = child.try_wait().unwrap() {
+                assert!(
+                    status.success(),
+                    "cold enum population child failed: {status}"
+                );
+                break;
+            }
+            if std::time::Instant::now() >= deadline {
+                child.kill().unwrap();
+                child.wait().unwrap();
+                panic!("incremental enum population deadlocked while loading a cold builtin");
+            }
+            std::thread::sleep(std::time::Duration::from_millis(10));
+        }
+    }
+}

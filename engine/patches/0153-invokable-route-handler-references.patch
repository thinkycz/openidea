+async fn implicit_invokable_handler_references_keep_class_semantics_and_owner_scope() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///implicit-handlers.php").unwrap();
+    let text = implicit_handler_fixture();
+    open_php(&backend, &uri, text).await;
+    let refs = implicit_method_refs(
+        &backend,
+        &uri,
+        text,
+        "class BaseInvoice {\n public function ",
+    )
+    .await;
+    let mut actual: Vec<_> = refs.iter().map(|l| l.range.start).collect();
+    actual.sort_by_key(|p| (p.line, p.character));
+    let mut expected: Vec<_> = [
+        "'/😀/literal','",
+        "'/constant',",
+        "'/namespace','",
+        "'/group-constant',",
+        "Routes::match(action:",
+        "'/paren',(",
+    ]
+    .iter()
+    .map(|p| crate::common::position_after(text, p))
+    .collect();
+    expected.sort_by_key(|p| (p.line, p.character));
+    assert_eq!(
+        actual, expected,
+        "implicit __invoke references must include exactly the six inherited handler associations"
+    );
+    let other =
+        implicit_method_refs(&backend, &uri, text, "class Other {\n public function ").await;
+    assert_eq!(other.len(), 1);
+    assert_eq!(
+        other[0].range.start,
+        crate::common::position_after(text, "'/other',")
+    );
+    let prefixed = implicit_method_refs(
+        &backend,
+        &uri,
+        text,
+        "namespace Other\\App {\nclass Invoice {public function ",
+    )
+    .await;
+    assert_eq!(prefixed.len(), 1);
+    assert_eq!(
+        prefixed[0].range.start,
+        crate::common::position_after(text, "'/prefixed',")
+    );
+    let pos = crate::common::position_after(text, "'/constant',In");
+    let target = goto_def(&backend, &uri, pos.line, pos.character)
+        .await
+        .unwrap();
+    let loc = match target {
+        GotoDefinitionResponse::Scalar(l) => l,
+        other => panic!("expected ordinary class navigation: {other:?}"),
+    };
+    assert_eq!(
+        loc.range.start,
+        crate::common::position_after(text, " public function show():string {return 'show';}\n}\n")
+    );
+}

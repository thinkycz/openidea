+async fn implicit_handler_lens(
+    backend: &phpantom_lsp::Backend,
+    uri: &Url,
+    text: &str,
+    prefix: &str,
+) -> String {
+    let line = crate::common::position_after(text, prefix).line;
+    let lenses = backend
+        .code_lens(CodeLensParams {
+            text_document: TextDocumentIdentifier { uri: uri.clone() },
+            work_done_progress_params: Default::default(),
+            partial_result_params: Default::default(),
+        })
+        .await
+        .unwrap()
+        .unwrap();
+    let lens = lenses
+        .into_iter()
+        .find(|l| {
+            l.range.start.line == line
+                && (l
+                    .data
+                    .as_ref()
+                    .is_some_and(|d| d["kind"] == "phpMemberReferences")
+                    || l.command.as_ref().is_some_and(|c| {
+                        c.title.ends_with("reference") || c.title.ends_with("references")
+                    }))
+        })
+        .expect("implicit handler declaration lens");
+    backend
+        .code_lens_resolve(lens)
+        .await
+        .unwrap()
+        .command
+        .unwrap()
+        .title
+}

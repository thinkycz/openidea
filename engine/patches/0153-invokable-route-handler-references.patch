+#[cfg(test)]
+mod invokable_source_revision_tests {
+    use super::*;
+
+    #[test]
+    fn same_length_namespace_edits_cannot_reuse_implicit_handler_roles() {
+        let backend = Backend::new_test();
+        let class_uri = "file:///handler-classes.php";
+        let route_uri = "file:///handler-routes.php";
+        let classes = "<?php namespace App {class Invoice {public function __invoke(){}}} namespace Other\\App {class Invoice {public function __invoke(){}}} namespace Third\\App {class Invoice {public function __invoke(){}}}";
+        let routes = "<?php namespace Harness; use Illuminate\\Support\\Facades\\Route; Route::namespace('Other')->group(fn()=>Route::get('/case',\\App\\Invoice::class));";
+        backend
+            .open_files
+            .write()
+            .insert(class_uri.into(), Arc::new(classes.into()));
+        backend.update_ast(class_uri, classes);
+        backend
+            .open_files
+            .write()
+            .insert(route_uri.into(), Arc::new(routes.into()));
+        backend.update_ast(route_uri, routes);
+        let other = classes.find("namespace Other").unwrap();
+        let method = other + classes[other..].find("__invoke").unwrap();
+        assert_eq!(
+            backend
+                .member_declaration_references(class_uri, method as u32, "__invoke", false)
+                .len(),
+            1
+        );
+        let third = classes.find("namespace Third").unwrap();
+        let declaration = third + classes[third..].find("class ").unwrap() + "class ".len();
+        let position = offset_to_position(classes, declaration);
+        assert!(
+            backend
+                .handle_rename(class_uri, classes, position, "Receipt")
+                .unwrap()
+                .is_some()
+        );
+        let changed = routes.replace("'Other'", "'Third'");
+        assert_eq!(routes.len(), changed.len());
+        // Model a retained map while its producer has not published the new role.
+        backend
+            .open_files
+            .write()
+            .insert(route_uri.into(), Arc::new(changed));
+        assert!(
+            backend
+                .member_declaration_references(class_uri, method as u32, "__invoke", false)
+                .is_empty(),
+            "a stale namespace must not credit the old handler"
+        );
+        assert!(
+            backend
+                .handle_rename(class_uri, classes, position, "Receipt")
+                .is_err(),
+            "a retained handler map must not allow a partial class rename"
+        );
+    }

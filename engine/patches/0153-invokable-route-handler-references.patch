+#[tokio::test]
+async fn implicit_invokable_handler_class_rename_refuses_prefix_dependent_constants() {
+    for unknown in [false, true] {
+        let backend = create_test_backend();
+        let uri = Url::parse("file:///implicit-class-dependency.php").unwrap();
+        let text = if unknown {
+            implicit_handler_fixture().replace(
+                "Routes::namespace('Other')",
+                "$registrationNamespace='Other'; Routes::namespace($registrationNamespace)",
+            )
+        } else {
+            implicit_handler_fixture().into()
+        };
+        open_php(&backend, &uri, &text).await;
+        for prefix in [
+            " public function show():string {return 'show';}\n}\nclass ",
+            "namespace Other\\App {\nclass ",
+        ] {
+            let result = backend
+                .rename(RenameParams {
+                    text_document_position: TextDocumentPositionParams {
+                        text_document: TextDocumentIdentifier { uri: uri.clone() },
+                        position: crate::common::position_after(&text, prefix),
+                    },
+                    new_name: "ReceiptController".into(),
+                    work_done_progress_params: Default::default(),
+                })
+                .await;
+            assert!(
+                result.is_err(),
+                "namespace-dependent class constant rename must refuse partial source/final edits: unknown={unknown} {prefix} {result:?}"
+            );
+        }
+    }
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///implicit-safe-constant.php").unwrap();
+    let text = implicit_handler_fixture().replace(
+        "Routes::namespace('Other')->group(fn()=>Routes::get('/prefixed',InvoiceAlias::class));\n",
+        "",
+    );
+    open_php(&backend, &uri, &text).await;
+    let edit = backend
+        .rename(RenameParams {
+            text_document_position: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier { uri: uri.clone() },
+                position: crate::common::position_after(
+                    &text,
+                    " public function show():string {return 'show';}\n}\nclass ",
+                ),
+            },
+            new_name: "ReceiptController".into(),
+            work_done_progress_params: Default::default(),
+        })
+        .await
+        .unwrap()
+        .unwrap();
+    let edited = crate::common::apply_edits(&text, &edit.changes.unwrap().remove(&uri).unwrap());
+    assert!(edited.contains("class ReceiptController extends BaseInvoice"));
+    assert!(edited.contains("use App\\ReceiptController as InvoiceAlias;"));
+    assert!(edited.contains("InvoiceAlias::class"));
+    assert!(edited.contains("namespace Other\\App {\nclass Invoice"));
+    assert_eq!(
+        edited.matches("function __invoke").count(),
+        text.matches("function __invoke").count()
+    );
+}

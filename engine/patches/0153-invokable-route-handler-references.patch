+#[tokio::test]
+async fn implicit_invokable_handler_rename_refuses_even_when_class_spells_magic_method() {
+    let backend = create_test_backend();
+    let uri = Url::parse("file:///implicit-magic-rename.php").unwrap();
+    let text = "<?php class __invoke {public function __invoke():string{return 'ok';}} Route::get('/magic','__invoke');";
+    open_php(&backend, &uri, text).await;
+    let result = backend
+        .rename(RenameParams {
+            text_document_position: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier { uri: uri.clone() },
+                position: crate::common::position_after(text, "public function "),
+            },
+            new_name: "dispatch".into(),
+            work_done_progress_params: Default::default(),
+        })
+        .await;
+    assert!(
+        result.is_err(),
+        "implicit magic-handler rename must refuse a partial contract change: {result:?}"
+    );
+    let edit = backend
+        .rename(RenameParams {
+            text_document_position: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier { uri: uri.clone() },
+                position: crate::common::position_after(text, "class "),
+            },
+            new_name: "ReceiptController".into(),
+            work_done_progress_params: Default::default(),
+        })
+        .await
+        .unwrap()
+        .unwrap();
+    let edits = edit.changes.unwrap().remove(&uri).unwrap();
+    assert_eq!(
+        crate::common::apply_edits(text, &edits),
+        text.replacen("class __invoke", "class ReceiptController", 1)
+            .replace("'/magic','__invoke'", "'/magic','ReceiptController'")
+    );
+    let ordinary_uri = Url::parse("file:///ordinary-invoke-function.php").unwrap();
+    let ordinary = "<?php function __invoke():string{return 'ordinary';} __invoke();";
+    open_php(&backend, &ordinary_uri, ordinary).await;
+    let edit = backend
+        .rename(RenameParams {
+            text_document_position: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier {
+                    uri: ordinary_uri.clone(),
+                },
+                position: crate::common::position_after(ordinary, "function "),
+            },
+            new_name: "handle".into(),
+            work_done_progress_params: Default::default(),
+        })
+        .await
+        .unwrap()
+        .unwrap();
+    let mut files = edit.changes.unwrap();
+    assert_eq!(files.len(), 1);
+    assert_eq!(
+        crate::common::apply_edits(ordinary, &files.remove(&ordinary_uri).unwrap()),
+        ordinary.replace("__invoke", "handle")
+    );
+}

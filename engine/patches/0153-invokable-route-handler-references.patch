+#[tokio::test]
+async fn implicit_invokable_handler_counts_rebind_without_changing_member_totals() {
+    let text = implicit_handler_fixture();
+    let (backend, dir) = crate::common::create_psr4_workspace(
+        r#"{"autoload":{"classmap":["handlers.php"]}}"#,
+        &[("handlers.php", text)],
+    );
+    let uri = Url::from_file_path(dir.path().join("handlers.php")).unwrap();
+    open_php(&backend, &uri, text).await;
+    let base = "class BaseInvoice {\n public function ";
+    let _ = implicit_method_refs(&backend, &uri, text, base).await;
+    let other = "class Other {\n public function ";
+    let unused = "class Unused {\n public function ";
+    assert_eq!(
+        implicit_handler_lens(&backend, &uri, text, base).await,
+        "6 references"
+    );
+    assert_eq!(
+        implicit_handler_lens(&backend, &uri, text, other).await,
+        "1 reference"
+    );
+    assert_eq!(
+        implicit_handler_lens(&backend, &uri, text, unused).await,
+        "0 references"
+    );
+    let changed = text
+        .replace(
+            "'/😀/literal','App\\Invoice'",
+            "'/😀/literal','App\\Unused'",
+        )
+        .replace(
+            "'/constant',InvoiceAlias::class",
+            "'/constant',\\App\\Other::class",
+        );
+    assert_ne!(changed, text);
+    backend
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: uri.clone(),
+                version: 2,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: changed.clone(),
+            }],
+        })
+        .await;
+    assert_eq!(
+        implicit_method_refs(&backend, &uri, &changed, base)
+            .await
+            .len(),
+        4
+    );
+    assert_eq!(
+        implicit_method_refs(&backend, &uri, &changed, other)
+            .await
+            .len(),
+        2
+    );
+    assert_eq!(
+        implicit_handler_lens(&backend, &uri, &changed, base).await,
+        "4 references"
+    );
+    assert_eq!(
+        implicit_handler_lens(&backend, &uri, &changed, other).await,
+        "2 references"
+    );
+    assert_eq!(
+        implicit_method_refs(&backend, &uri, &changed, unused)
+            .await
+            .len(),
+        1
+    );
+    assert_eq!(
+        implicit_handler_lens(&backend, &uri, &changed, unused).await,
+        "1 reference"
+    );
+}

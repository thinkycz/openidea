+//! Version-bound navigation to an invokable Laravel route handler.
+use crate::{Backend, project_router::ProjectRouter, workbench_rename::ExpectedSource};
+use serde::{Deserialize, Serialize};
+use tower_lsp::{
+    jsonrpc::{Error, ErrorCode, Result},
+    lsp_types::{Location, Position},
+};
+
+/// Separate handler navigation leaves ordinary PHP class definitions unchanged.
+pub const METHOD: &str = "phpWorkbench/routeHandler";
+/// Advertised only by servers implementing the checked source contract.
+pub const CAPABILITY: &str = "phpWorkbenchRouteHandler";
+
+/// An open source snapshot and a UTF-16 caret position within it.
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct RouteHandlerParams {
+    /// Exact editor-owned source; aliases must use the preferred authority.
+    pub expected_source: ExpectedSource,
+    /// Caret within or immediately after the controller token or literal.
+    pub position: Position,
+}
+/// Unresolved runtime associations retain their incomplete provenance.
+#[derive(Clone, Debug, Serialize)]
+pub struct RouteHandlerReply {
+    /// Source verified before and after semantic lookup.
+    pub source: ExpectedSource,
+    /// Real __invoke declarations, including inherited or trait implementations.
+    pub locations: Vec<Location>,
+    /// A runtime association could not be fully established statically.
+    pub incomplete: bool,
+}
+fn changed() -> Error {
+    Error {
+        code: ErrorCode::ServerError(-32801),
+        message: "Route handler source changed or is not open".into(),
+        data: None,
+    }
+}
+impl RouteHandlerParams {
+    fn validate(&self) -> Result<()> {
+        let source = &self.expected_source;
+        if source.uri.as_str().len() > 1024 * 1024
+            || source.uri.scheme() != "file"
+            || source.uri.query().is_some()
+            || source.uri.fragment().is_some()
+            || !source.uri.to_file_path().is_ok_and(|p| p.is_absolute())
+        {
+            return Err(Error::invalid_params(
+                "Expected an absolute local source URI",
+            ));
+        }
+        if source.sha256_utf8.len() != 64
+            || !source.sha256_utf8.bytes().all(|b| b.is_ascii_hexdigit())
+        {
+            return Err(Error::invalid_params(
+                "sha256Utf8 must contain exactly 64 hexadecimal digits",
+            ));
+        }
+        Ok(())
+    }
+}
+impl ProjectRouter {
+    /// Select the consuming Composer graph and retain normal cancellation routing.
+    pub async fn workbench_route_handler(
+        &self,
+        params: RouteHandlerParams,
+    ) -> Result<RouteHandlerReply> {
+        params.validate()?;
+        let _request = self.request_guard().await;
+        let project = self.project_for(&params.expected_source.uri).await?;
+        project.backend.workbench_route_handler(params).await
+    }
+}
+impl Backend {
+    /// Read existing static dispatch associations under the current semantic gate.
+    pub async fn workbench_route_handler(
+        &self,
+        params: RouteHandlerParams,
+    ) -> Result<RouteHandlerReply> {
+        params.validate()?;
+        let backend = self.clone_for_blocking();
+        crate::server::run_blocking_cancel_safe("route_handler", move || {
+            crate::workbench_rename::authority_path(&params.expected_source.uri)
+                .map_err(|_| changed())?;
+            backend.with_prepared_current_semantics(|| {
+                let expected = std::slice::from_ref(&params.expected_source);
+                backend
+                    .verify_rename_sources(expected)
+                    .map_err(|_| changed())?;
+                let uri = params.expected_source.uri.as_str();
+                let content = backend
+                    .open_files
+                    .read()
+                    .get(uri)
+                    .cloned()
+                    .ok_or_else(changed)?;
+                let offset =
+                    crate::text_position::position_to_byte_offset(&content, params.position);
+                if crate::text_position::offset_to_position(&content, offset) != params.position {
+                    return Err(Error::invalid_params(
+                        "Expected an exact UTF-16 source position",
+                    ));
+                }
+                let mut reply = RouteHandlerReply {
+                    source: params.expected_source.clone(),
+                    locations: Vec::new(),
+                    incomplete: false,
+                };
+                if !backend.resolved_class_cache.read().is_laravel() || backend.is_blade_file(uri) {
+                    return Ok(reply);
+                }
+                let map = backend.symbol_map_for(uri).ok_or_else(changed)?;
+                if !map.matches_source_fingerprint(&content) {
+                    return Err(changed());
+                }
+                for action in map.laravel_invokable_actions.iter().filter(|action| {
+                    action.start as usize <= offset && offset <= (action.end as usize)
+                }) {
+                    reply.incomplete |= action.incomplete;
+                    let location = action.target.and_then(|target| {
+                        backend.real_method_declaration_location(&target, "__invoke")
+                    });
+                    if let Some(location) = location {
+                        reply.locations.push(location);
+                    } else {
+                        reply.incomplete = true;
+                    }
+                }
+                reply.locations.sort_by(|a, b| {
+                    (
+                        a.uri.as_str(),
+                        a.range.start.line,
+                        a.range.start.character,
+                        a.range.end.line,
+                        a.range.end.character,
+                    )
+                        .cmp(&(
+                            b.uri.as_str(),
+                            b.range.start.line,
+                            b.range.start.character,
+                            b.range.end.line,
+                            b.range.end.character,
+                        ))
+                });
+                reply.locations.dedup();
+                backend
+                    .verify_rename_sources(expected)
+                    .map_err(|_| changed())?;
+                Ok(reply)
+            })
+        })
+        .await
+        .ok_or_else(Error::internal_error)?
+    }
+}

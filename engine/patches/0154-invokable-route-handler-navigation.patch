+#[tokio::test]
+async fn route_handler_query_selects_real_methods_and_trait_aliases_not_properties_or_docblocks() {
+    let text = r#"<?php
+namespace App;
+use Illuminate\Support\Facades\Route;
+class ParentHandler {public function __invoke():void {}}
+class ChildHandler extends ParentHandler {public $__invoke;}
+trait Handles {public function run():void {}}
+class TraitHandler {use Handles {run as __invoke;}}
+/** @method void __invoke() */
+class VirtualHandler {}
+class PropertyHandler {public $__invoke;}
+Route::get('/child', ChildHandler::class);
+Route::get('/trait', TraitHandler::class);
+Route::get('/virtual', VirtualHandler::class);
+Route::get('/property', PropertyHandler::class);
+"#;
+    let (backend, _dir, uri) = handler_workspace(text).await;
+    for (needle, declaration) in [
+        ("'/child', Ch", "class ParentHandler {public function "),
+        ("'/trait', Tr", "trait Handles {public function "),
+    ] {
+        let reply = backend
+            .workbench_route_handler(handler_query(&uri, text, 1, needle))
+            .await
+            .unwrap();
+        assert_eq!(reply.locations.len(), 1, "{reply:?}");
+        assert_eq!(
+            reply.locations[0].range.start,
+            crate::common::position_after(text, declaration)
+        );
+        assert!(!reply.incomplete);
+    }
+    for needle in ["'/virtual', Vi", "'/property', Pr"] {
+        let reply = backend
+            .workbench_route_handler(handler_query(&uri, text, 1, needle))
+            .await
+            .unwrap();
+        assert!(reply.locations.is_empty());
+        assert!(
+            reply.incomplete,
+            "an indexed association without a real method remains incomplete"

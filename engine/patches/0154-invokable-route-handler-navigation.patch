+    /// Follow actual method ancestry without accepting a property or virtual mixin.
+    pub(crate) fn real_method_declaration_location(
+        &self,
+        class_fqn: &str,
+        member_name: &str,
+    ) -> Option<Location> {
+        let class = self.find_or_load_class(class_fqn)?;
+        let loader = |name: &str| self.find_or_load_class(name);
+        let effective = crate::inheritance::resolve_class_with_inheritance(&class, &loader);
+        let method = effective.get_method(member_name)?;
+        if method.is_virtual || method.is_abstract {
+            return None;
+        }
+        if let Some((name, owner, fqn)) =
+            Self::aliased_method_implementation(&class, member_name, &loader)
+        {
+            return self.member_position_location(&fqn, "", "", &owner, &name, MemberKind::Method);
+        }
+        let declares = |candidate: &ClassInfo| {
+            candidate.methods.iter().any(|m| {
+                !m.is_virtual
+                    && m.name.eq_ignore_ascii_case(member_name)
+                    && m.name_offset == method.name_offset
+            })
+        };
+        let (owner, fqn) = if declares(&class) {
+            (Arc::unwrap_or_clone(class.clone()), class.fqn().to_string())
+        } else {
+            let (fqn, owner) = crate::inheritance::find_declaring_member_ancestor(
+                &class,
+                Some(member_name),
+                &loader,
+                &declares,
+            )?;
+            (Arc::unwrap_or_clone(owner), fqn.to_string())
+        };
+        self.member_position_location(&fqn, "", "", &owner, member_name, MemberKind::Method)
     }
 

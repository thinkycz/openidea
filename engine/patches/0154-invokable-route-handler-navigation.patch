+#[tokio::test]
+async fn route_handler_query_resolves_implicit_owners_without_replacing_php_navigation() {
+    let text = implicit_handler_fixture();
+    let (backend, _dir, uri) = handler_workspace(text).await;
+    let before = goto_def(
+        &backend,
+        &uri,
+        crate::common::position_after(text, "'/constant',In").line,
+        crate::common::position_after(text, "'/constant',In").character,
+    )
+    .await;
+    for needle in [
+        "'/😀/literal','App",
+        "'/constant',In",
+        "'/constant',InvoiceAlias",
+        "'/namespace','In",
+        "'/group-constant',In",
+        "Routes::match(action:In",
+        "'/paren',(In",
+    ] {
+        let params = handler_query(&uri, text, 1, needle);
+        let reply = backend
+            .workbench_route_handler(params.clone())
+            .await
+            .unwrap();
+        assert!(!reply.incomplete, "{needle}");
+        assert_eq!(reply.source.uri, uri);
+        assert_eq!(reply.source.version, 1);
+        assert_eq!(reply.source.sha256_utf8, params.expected_source.sha256_utf8);
+        assert_eq!(reply.locations.len(), 1, "{needle}: {reply:?}");
+        assert_eq!(reply.locations[0].uri, uri);
+        assert_eq!(
+            reply.locations[0].range.start,
+            crate::common::position_after(text, "class BaseInvoice {\n public function ")
+        );
+    }
+    let after = goto_def(
+        &backend,
+        &uri,
+        crate::common::position_after(text, "'/constant',In").line,
+        crate::common::position_after(text, "'/constant',In").character,
+    )
+    .await;
+    assert_eq!(before, after, "ordinary PHP navigation stays unchanged");
+    for needle in ["$metadata=In", "'/group-method','In", "'/explicit','App"] {
+        let reply = backend
+            .workbench_route_handler(handler_query(&uri, text, 1, needle))
+            .await
+            .unwrap();
+        assert!(reply.locations.is_empty(), "{needle}: {reply:?}");
+        assert!(!reply.incomplete);
+    }
+}

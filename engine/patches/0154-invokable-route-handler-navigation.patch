+fn handler_query(
+    uri: &Url,
+    text: &str,
+    version: i32,
+    needle: &str,
+) -> phpantom_lsp::workbench_route_handler::RouteHandlerParams {
+    use sha2::{Digest, Sha256};
+    phpantom_lsp::workbench_route_handler::RouteHandlerParams {
+        expected_source: phpantom_lsp::workbench_rename::ExpectedSource {
+            uri: uri.clone(),
+            version,
+            sha256_utf8: format!("{:x}", Sha256::digest(text.as_bytes())),
+        },
+        position: crate::common::position_after(text, needle),
+    }
+}
+async fn handler_workspace(text: &str) -> (phpantom_lsp::Backend, tempfile::TempDir, Url) {
+    crate::common::create_initialized_psr4_workspace(
+        crate::common::LARAVEL_SRC_COMPOSER,
+        &[("src/Routes.php", text)],
+        "src/Routes.php",
+    )
+    .await
+}

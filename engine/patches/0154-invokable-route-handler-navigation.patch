+// Invokable controller registrations keep their implementation separate from
+// ordinary class navigation.
+(function (): void {
+    $previous = \Illuminate\Support\Facades\Route::getFacadeRoot();
+    $router = new \Illuminate\Routing\Router(new \Illuminate\Events\Dispatcher());
+    \Illuminate\Support\Facades\Route::swap($router);
+    try {
+        $class = \App\Http\Controllers\InvokableBakeryController::class;
+        $route = \Illuminate\Support\Facades\Route::get('/invokable-bakery', $class);
+        $route->bind(\Illuminate\Http\Request::create('/invokable-bakery'));
+        check('An invokable route dispatches to its magic method', $route->getAction('uses') === $class . '@__invoke');
+        check('The controller is callable as an object', is_callable(new $class()));
+        check('The route executes the declared handler', $route->run() === 'Invokable bakery.');
+        check('The handler implementation belongs to the controller source',
+            (new \ReflectionMethod($class, '__invoke'))->getFileName() === __DIR__ . '/app/Http/Controllers/InvokableBakeryController.php');
+    } finally {
+        if ($previous !== null) { \Illuminate\Support\Facades\Route::swap($previous); }
+        else { \Illuminate\Support\Facades\Route::clearResolvedInstance('router'); }
+    }
+})();
+

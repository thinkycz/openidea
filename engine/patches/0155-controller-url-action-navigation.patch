+//! Runtime controller literals in Laravel URL-building calls, not invocations.
+use super::laravel::{explicit_controller_action, laravel_helper_name, laravel_route_method_span};
+use super::{ExtractionCtx, SymbolKind, SymbolSpan};
+use crate::symbol_map::{ClassRefContext, LaravelStringDependency};
+use mago_span::HasSpan;
+use mago_syntax::cst::*;
+
+#[derive(Clone, Copy)]
+enum ActionSignature {
+    Helper,
+    Url,
+    Redirect,
+}
+impl ActionSignature {
+    fn role(self) -> &'static [u8] {
+        if matches!(self, Self::Helper) {
+            b"name"
+        } else {
+            b"action"
+        }
+    }
+    fn named(self, name: &[u8]) -> bool {
+        let names: &[&[u8]] = match self {
+            Self::Helper => &[b"name", b"parameters", b"absolute"],
+            Self::Url => &[b"action", b"parameters", b"absolute"],
+            Self::Redirect => &[b"action", b"parameters", b"status", b"headers"],
+        };
+        names.contains(&name)
+    }
+}
+
+fn function_guard(
+    ident: &Identifier<'_>,
+    names: Option<&crate::names::OwnedResolvedNames>,
+) -> LaravelStringDependency {
+    match LaravelStringDependency::controller_url_helper(
+        names
+            .and_then(|n| n.get(ident.span().start.offset))
+            .unwrap_or_else(|| super::bytes_to_str(ident.value())),
+    ) {
+        Some(LaravelStringDependency::Function(name)) => {
+            LaravelStringDependency::LaravelFunction(name)
+        }
+        _ => LaravelStringDependency::Laravel,
+    }
+}
+fn receiver_guard(
+    object: &Expression<'_>,
+    method: &ClassLikeMemberSelector<'_>,
+    names: Option<&crate::names::OwnedResolvedNames>,
+) -> Option<(LaravelStringDependency, ActionSignature)> {
+    let ClassLikeMemberSelector::Identifier(method) = method else {
+        return None;
+    };
+    if !method.value.eq_ignore_ascii_case(b"action")
+        && !method.value.eq_ignore_ascii_case(b"redirectToAction")
+    {
+        return None;
+    }
+    let Expression::Call(Call::Function(call)) = crate::parser::unwrap_parens(object) else {
+        return None;
+    };
+    if !call.argument_list.arguments.is_empty() {
+        return None;
+    }
+    let Expression::Identifier(ident) = call.function else {
+        return None;
+    };
+    let name = laravel_helper_name(
+        super::bytes_to_str(ident.value()),
+        ident.span().start.offset,
+        names,
+    );
+    let valid = if method.value.eq_ignore_ascii_case(b"action") {
+        name.eq_ignore_ascii_case("url") || name.eq_ignore_ascii_case("redirect")
+    } else {
+        method.value.eq_ignore_ascii_case(b"redirectToAction")
+            && name.eq_ignore_ascii_case("response")
+    };
+    valid.then(|| {
+        (
+            function_guard(ident, names),
+            if name.eq_ignore_ascii_case("url") {
+                ActionSignature::Url
+            } else {
+                ActionSignature::Redirect
+            },
+        )
+    })
+}
+fn context<'a>(
+    call: &'a Call<'a>,
+    names: Option<&crate::names::OwnedResolvedNames>,
+) -> Option<(
+    &'a ArgumentList<'a>,
+    LaravelStringDependency,
+    ActionSignature,
+)> {
+    match call {
+        Call::Function(call) => {
+            let Expression::Identifier(ident) = call.function else {
+                return None;
+            };
+            let name = laravel_helper_name(
+                super::bytes_to_str(ident.value()),
+                ident.span().start.offset,
+                names,
+            );
+            name.eq_ignore_ascii_case("action").then(|| {
+                (
+                    &call.argument_list,
+                    function_guard(ident, names),
+                    ActionSignature::Helper,
+                )
+            })
+        }
+        Call::Method(call) => receiver_guard(call.object, &call.method, names)
+            .map(|(guard, signature)| (&call.argument_list, guard, signature)),
+        Call::NullSafeMethod(call) => receiver_guard(call.object, &call.method, names)
+            .map(|(guard, signature)| (&call.argument_list, guard, signature)),
+        Call::StaticMethod(call) => {
+            let ClassLikeMemberSelector::Identifier(method) = &call.method else {
+                return None;
+            };
+            if !method.value.eq_ignore_ascii_case(b"action")
+                && !method.value.eq_ignore_ascii_case(b"redirectToAction")
+            {
+                return None;
+            }
+            let Expression::Identifier(ident) = call.class else {
+                return None;
+            };
+            let raw = super::bytes_to_str(ident.value());
+            let name = names
+                .and_then(|n| n.get(ident.span().start.offset))
+                .unwrap_or(raw)
+                .trim_start_matches('\\');
+            let valid = if method.value.eq_ignore_ascii_case(b"action") {
+                [
+                    "URL",
+                    "Redirect",
+                    "Illuminate\\Support\\Facades\\URL",
+                    "Illuminate\\Support\\Facades\\Redirect",
+                ]
+                .iter()
+                .any(|f| name.eq_ignore_ascii_case(f))
+            } else {
+                method.value.eq_ignore_ascii_case(b"redirectToAction")
+                    && ["Response", "Illuminate\\Support\\Facades\\Response"]
+                        .iter()
+                        .any(|f| name.eq_ignore_ascii_case(f))
+            };
+            if !valid {
+                return None;
+            }
+            let guard = match LaravelStringDependency::root_facade(name) {
+                Some(LaravelStringDependency::Class(name)) => {
+                    LaravelStringDependency::LaravelClass(name)
+                }
+                _ => LaravelStringDependency::Laravel,
+            };
+            Some((
+                &call.argument_list,
+                guard,
+                if name.eq_ignore_ascii_case("URL")
+                    || name.eq_ignore_ascii_case("Illuminate\\Support\\Facades\\URL")
+                {
+                    ActionSignature::Url
+                } else {
+                    ActionSignature::Redirect
+                },
+            ))
+        }
+    }
+}
+fn emit_argument<'a>(
+    expr: &'a Expression<'a>,
+    ambiguous: bool,
+    guard: LaravelStringDependency,
+    ctx: &mut ExtractionCtx<'a>,
+) {
+    let expr = crate::parser::unwrap_parens(expr);
+    let Some(action) = explicit_controller_action(expr, ctx.content) else {
+        let Expression::Literal(literal::Literal::String(value)) = expr else {
+            return;
+        };
+        let Some(decoded) = value.value.and_then(super::literal_bytes_to_str) else {
+            return;
+        };
+        let Some((class, _method)) = decoded.rsplit_once('@') else {
+            return;
+        };
+        let Some(controller) = super::laravel::laravel_runtime_controller_ref(class) else {
+            return;
+        };
+        let first = ctx.spans.len();
+        ctx.spans.push(SymbolSpan {
+            start: value.span.start.offset + 1,
+            end: value.span.end.offset - 1,
+            kind: SymbolKind::RuntimeControllerBinding {
+                runtime_name: crate::atom::atom(controller.subject.trim_start_matches('\\')),
+                targets: Box::new([]),
+                incomplete: true,
+            },
+        });
+        ctx.defer_laravel_spans_since(first, guard);
+        return;
+    };
+    let first = ctx.spans.len();
+    let complete = action.controller.rooted && !ambiguous;
+    let name = crate::atom::atom(action.controller.subject.trim_start_matches('\\'));
+    let kind = if complete {
+        SymbolKind::ClassReference {
+            name,
+            is_fqn: true,
+            context: ClassRefContext::RuntimeControllerString,
+        }
+    } else {
+        SymbolKind::RuntimeControllerBinding {
+            runtime_name: name,
+            targets: Box::new([]),
+            incomplete: true,
+        }
+    };
+    ctx.spans.push(SymbolSpan {
+        start: action.class_start,
+        end: action.class_end,
+        kind,
+    });
+    if complete && !action.method.is_empty() {
+        ctx.spans.push(laravel_route_method_span(
+            &action.controller.subject,
+            action.method,
+            action.start,
+            action.end,
+        ));
+        ctx.non_invoked_callable_spans
+            .push((action.start, action.end));
+    }
+    ctx.defer_laravel_spans_since(first, guard);
+}
+pub(super) fn emit<'a>(call: &'a Call<'a>, ctx: &mut ExtractionCtx<'a>) {
+    let Some((arguments, guard, signature)) = context(call, ctx.resolved_names) else {
+        return;
+    };
+    let mut selected = None;
+    let mut ambiguous = false;
+    let mut named_seen = false;
+    for (index, arg) in arguments.arguments.iter().enumerate() {
+        let value = match arg {
+            Argument::Positional(p) => {
+                ambiguous |= p.ellipsis.is_some() || named_seen;
+                (index == 0 && p.ellipsis.is_none()).then_some(p.value)
+            }
+            Argument::Named(n) => {
+                named_seen = true;
+                ambiguous |= !signature.named(n.name.value);
+                (n.name.value == signature.role()).then_some(n.value)
+            }
+        };
+        if let Some(value) = value {
+            ambiguous |= selected.is_some();
+            selected = Some(value);
+        }
+    }
+    if !ambiguous {
+        if let Some(value) = selected {
+            emit_argument(value, false, guard, ctx);
+        }
+    } else {
+        // Preserve identifiable ambiguous references so refactors cannot skip them.
+        for (index, arg) in arguments.arguments.iter().enumerate() {
+            let value = match arg {
+                Argument::Positional(p) if index == 0 && p.ellipsis.is_none() => Some(p.value),
+                Argument::Named(n) if n.name.value == signature.role() => Some(n.value),
+                _ => None,
+            };
+            if let Some(value) = value {
+                emit_argument(value, true, guard, ctx);
+            }
+        }
+    }
+}

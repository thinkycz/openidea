+#[tokio::test]
+async fn controller_url_completion_empty_suffix_and_no_match_preserve_context() {
+    for (suffix, expected) in [("", true), ("notAMethod", false)] {
+        let call = format!("\\action('\\App\\Invoice@{suffix}');");
+        let text = controller_url_fixture(&call);
+        let (backend, _dir, uri) = handler_workspace(&text).await;
+        let needle = &call[..call.find('@').unwrap() + 1 + suffix.len()];
+        let response = controller_url_completion(&backend, &uri, &text, needle).await;
+        let CompletionResponse::List(list) = response else {
+            panic!("known URL context must return completeness: {response:?}")
+        };
+        assert!(
+            !list.is_incomplete,
+            "known controller method set is complete"
+        );
+        assert_eq!(
+            list.items
+                .iter()
+                .any(|i| i.filter_text.as_deref() == Some("show")),
+            expected
+        );
+        assert!(
+            list.items
+                .iter()
+                .all(|i| i.kind == Some(CompletionItemKind::METHOD))
+        );
+    }
+}

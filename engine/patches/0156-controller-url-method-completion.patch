+                    targets,
+                    incomplete: false,
+                    ..
+                } if targets.len() == 1 => Some(targets[0].as_str()),
+                _ => None,
+            };
+            result = Some(match identity {
+                Some(identity) => {
+                    RuntimeControllerMethodContext::Resolved(LaravelRouteControllerContext {
+                        controller_class: format!("\\{}", identity.trim_start_matches('\\')),
+                        prefix: content[action.start as usize..offset as usize].to_owned(),

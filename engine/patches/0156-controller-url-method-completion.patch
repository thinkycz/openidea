+#[tokio::test]
+async fn controller_url_completion_unicode_methods_commit_and_navigate_with_utf16_ranges() {
+    let call = r#"$note='😀'; \action('\App\Invoice@shøOLD');"#;
+    let text = controller_url_fixture(call).replace(
+        "class Invoice {",
+        "class Invoice {public function shøw():string{return 'unicode';}",
+    );
+    let (backend, _dir, uri) = handler_workspace(&text).await;
+    let items = controller_url_items(
+        controller_url_completion(&backend, &uri, &text, r#"\action('\App\Invoice@shø"#).await,
+    );
+    let item = items
+        .iter()
+        .find(|i| i.filter_text.as_deref() == Some("shøw"))
+        .expect("Unicode method completion");
+    let Some(CompletionTextEdit::Edit(edit)) = &item.text_edit else {
+        panic!("Unicode method needs an exact edit")
+    };
+    let updated = crate::common::apply_edits(&text, std::slice::from_ref(edit));
+    assert_eq!(updated, text.replace("@shøOLD", "@shøw"));
+    backend
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: uri.clone(),
+                version: 2,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: updated.clone(),
+            }],
+        })
+        .await;
+    let at = crate::common::position_after(&updated, r#"\action('\App\Invoice@shø"#);
+    let target = goto_def(&backend, &uri, at.line, at.character).await;
+    assert!(
+        matches!(target,Some(GotoDefinitionResponse::Scalar(ref l)) if l.uri==uri && l.range.start==crate::common::position_after(&updated,"class Invoice {public function ")),
+        "committed Unicode method must navigate: {target:?}"
+    );
+}

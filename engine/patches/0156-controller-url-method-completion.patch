+#[tokio::test]
+async fn controller_url_completion_tracks_unsaved_inherited_members_without_caller_edits() {
+    let caller = r"<?php namespace App; \action('\App\Invoice@sh');";
+    let invoice = "<?php namespace App; class Invoice extends Base {}";
+    let base = "<?php namespace App; class Base {public function showBase():string{return 'base';} protected function secret(){}}";
+    let other =
+        "<?php namespace App; class Other {public function showOther():string{return 'other';}}";
+    let (backend, dir, uri) = crate::common::create_initialized_psr4_workspace(
+        crate::common::LARAVEL_SRC_COMPOSER,
+        &[
+            ("src/Links.php", caller),
+            ("src/Invoice.php", invoice),
+            ("src/Base.php", base),
+            ("src/Other.php", other),
+        ],
+        "src/Links.php",
+    )
+    .await;
+    let declaration = Url::from_file_path(dir.path().join("src/Invoice.php")).unwrap();
+    open_php(&backend, &declaration, invoice).await;
+    for (version, parent, expected, absent) in [
+        (1, "Base", "showBase", "showOther"),
+        (2, "Other", "showOther", "showBase"),
+        (3, "Base", "showBase", "showOther"),
+    ] {
+        if version > 1 {
+            backend
+                .did_change(DidChangeTextDocumentParams {
+                    text_document: VersionedTextDocumentIdentifier {
+                        uri: declaration.clone(),
+                        version,
+                    },
+                    content_changes: vec![TextDocumentContentChangeEvent {
+                        range: None,
+                        range_length: None,
+                        text: invoice.replace("Base", parent),
+                    }],
+                })
+                .await;
+        }
+        let items = controller_url_items(
+            controller_url_completion(&backend, &uri, caller, r"\action('\App\Invoice@sh").await,
+        );
+        let labels = method_labels(&items);
+        assert!(
+            labels.iter().any(|name| name == expected),
+            "{parent}: {labels:?}"
+        );
+        assert!(
+            !labels.iter().any(|name| name == absent || name == "secret"),
+            "{parent}: {labels:?}"
+        );
+    }
+    assert_eq!(
+        std::fs::read_to_string(dir.path().join("src/Invoice.php")).unwrap(),
+        invoice
+    );
+}

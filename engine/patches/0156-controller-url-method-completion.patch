+#[tokio::test]
+async fn controller_url_completion_commits_methods_for_helpers_facades_aliases_and_named_roles() {
+    for call in [
+        r#"$note='😀'; \action('\App\Invoice@shOLD');"#,
+        r#"controller_url(parameters:[], name:"\\App\\Invoice@shOLD", absolute:false);"#,
+        r#"(\url())->action(action:'\App\Invoice@shOLD');"#,
+        r#"\url()?->action(action:'\App\Invoice@shOLD');"#,
+        r#"\redirect()->action(action:'\App\Invoice@shOLD', headers:[]);"#,
+        r#"redirector()->action(parameters:[], action:'\App\Invoice@shOLD', status:303);"#,
+        r#"\response()->redirectToAction(action:'\App\Invoice@shOLD');"#,
+        r#"URL::action(absolute:false, action:'\App\Invoice@shOLD');"#,
+        r#"Redirect::action(headers:[], action:'\App\Invoice@shOLD');"#,
+        r#"Response::redirectToAction(parameters:[], action:'\App\Invoice@shOLD');"#,
+        r#"Route::namespace('Wrong')->controller(\Vendor\Other::class)->group(fn()=>\action('\App\Invoice@shOLD'));"#,
+    ] {
+        let text = controller_url_fixture(call);
+        let (backend, _dir, uri) = handler_workspace(&text).await;
+        let needle = &call[..call.find("@shOLD").unwrap() + 3];
+        let items =
+            controller_url_items(controller_url_completion(&backend, &uri, &text, needle).await);
+        let item = items
+            .iter()
+            .find(|i| i.filter_text.as_deref() == Some("show"))
+            .expect("URL methods must complete");
+        let item = backend.completion_resolve(item.clone()).await.unwrap();
+        assert!(
+            item.command.is_none(),
+            "{call}: no parameter-hint command in a literal"
+        );
+        assert_eq!(item.kind, Some(CompletionItemKind::METHOD), "{call}");
+        assert!(
+            item.additional_text_edits
+                .as_ref()
+                .is_none_or(Vec::is_empty),
+            "{call}: no PHP imports"
+        );
+        assert!(item.insert_text_format.is_none(), "{call}: no call snippet");
+        let Some(CompletionTextEdit::Edit(edit)) = &item.text_edit else {
+            panic!("explicit method edit required: {item:?}")
+        };
+        assert_eq!(edit.new_text, "show");
+        let updated = crate::common::apply_edits(&text, std::slice::from_ref(edit));
+        assert_eq!(
+            updated,
+            text.replacen("@shOLD", "@show", 1),
+            "{call}: must remove the entire suffix"
+        );
+    }
+}

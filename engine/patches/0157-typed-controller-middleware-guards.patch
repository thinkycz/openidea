+const CONTROLLER_MIDDLEWARE: &str = r#"<?php
+namespace Illuminate\Routing { class Controller { public function middleware($middleware) {} } }
+namespace App {
+use Illuminate\Routing\Controller as FrameworkController;
+class BaseController extends FrameworkController {}
+class GuardController extends BaseController {
+    public function __construct() {
+        $this->middleware('auth:a');
+        $this->middleware(middleware: ['auth:web,admin', 'auth:missing']);
+        $this->middleware(['named' => 'auth:admin']);
+        $this->middleware(middleware:'auth:');
+    }
+}
+class ForeignController { public function middleware($middleware) {} public function run() {
+    $this->middleware('auth:foreign'); $this->middleware('auth:admin');

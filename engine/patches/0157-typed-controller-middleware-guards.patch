+#[tokio::test]
+async fn typed_controller_middleware_edits_full_suffix_in_utf16_coordinates() {
+    let source = CONTROLLER_MIDDLEWARE.replace(
+        "$this->middleware('auth:a');",
+        "$label = '🐘'; $this->middleware('auth:adminTail');",
+    );
+    let (backend, _dir, uri) = open_workspace(&source).await;
+    let offset = source.find("auth:ad").unwrap() + "auth:ad".len();
+    let before = &source[..offset];
+    let position = Position::new(
+        before.bytes().filter(|b| *b == b'\n').count() as u32,
+        before.rsplit('\n').next().unwrap().encode_utf16().count() as u32,
+    );
+    let mut items = completion_items(&backend, &uri, position).await;
+    assert_eq!(items.len(), 1);
+    let item = items.pop().unwrap();
+    assert_eq!(item.label, "admin");
+    assert!(
+        item.additional_text_edits
+            .as_ref()
+            .is_none_or(Vec::is_empty)
+    );
+    assert!(item.command.is_none());
+    let Some(CompletionTextEdit::Edit(edit)) = item.text_edit else {
+        panic!("expected edit")
+    };
+    let start = crate::common::lsp_pos_to_offset(&source, edit.range.start);
+    let end = crate::common::lsp_pos_to_offset(&source, edit.range.end);
+    assert_eq!(&source[start..end], "adminTail");
+    assert_eq!(
+        crate::common::apply_edits(&source, &[edit]),
+        source.replace("adminTail", "admin")
+    );
+}

+#[tokio::test]
+async fn typed_controller_middleware_completes_only_guard_segments() {
+    let (backend, _dir, uri) = open_workspace(CONTROLLER_MIDDLEWARE).await;
+    for (prefix, expected) in [
+        ("middleware('auth:a", vec!["admin"]),
+        ("middleware: ['auth:web,a", vec!["admin"]),
+        ("['named' => 'auth:ad", vec!["admin"]),
+        ("middleware(middleware:'auth:", vec!["admin", "web"]),
+    ] {
+        let items = completion_items(
+            &backend,
+            &uri,
+            position_after(CONTROLLER_MIDDLEWARE, prefix),
+        )
+        .await;
+        let labels: Vec<_> = items.iter().map(|item| item.label.as_str()).collect();
+        assert_eq!(labels, expected, "{prefix}");
+        for item in items {
+            let Some(CompletionTextEdit::Edit(edit)) = item.text_edit else {
+                panic!("guard completion needs an edit")
+            };
+            assert!(!text_in_range(CONTROLLER_MIDDLEWARE, edit.range).contains("auth:"));
+            assert!(!text_in_range(CONTROLLER_MIDDLEWARE, edit.range).contains(','));
+        }
+    }
+}

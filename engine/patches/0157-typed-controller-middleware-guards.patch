+                .into_iter()
+                .collect()
+        );
+        for item in items {
+            let escaped = match (item.label.as_str(), quote) {
+                ("ad'min", '\'') => r"ad\'min",
+                ("ad'min", _) => "ad'min",
+                ("ad$min", '"') => r"ad\$min",
+                ("ad$min", _) => "ad$min",
+                (r"ad\min", _) => r"ad\\min",
+                ("admin", _) => "admin",
+                _ => panic!("unexpected guard"),

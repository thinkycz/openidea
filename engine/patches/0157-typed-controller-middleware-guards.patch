+/// Auth guards on `$this` need the shared receiver type before publication.
+pub(super) fn record_controller_guard_sites(
+    argument_list: &ArgumentList<'_>,
+    content: &str,
+    sites: &mut Vec<ViewReceiverSite>,
+) {
+    let mut spans = Vec::new();
+    try_emit_can_middleware_spans(argument_list, true, content, &mut spans);
+    for span in spans {
+        if let SymbolKind::LaravelStringKey {
+            kind:
+                crate::symbol_map::LaravelStringKind::ConfigResource(
+                    crate::symbol_map::LaravelConfigResource::AuthGuard,
+                ),
+            key,
+            is_optional,
+            ..
+        } = span.kind
+        {
+            sites.push(ViewReceiverSite {
+                start: span.start,
+                end: span.end,
+                key,
+                is_optional,
+                receiver: ViewReceiverClass::ControllerGuard,
+            });
+        }
+    }

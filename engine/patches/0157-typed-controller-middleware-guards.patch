+async fn typed_controller_middleware_refreshes_unsaved_parent_types() {
+    let source = r#"<?php
+namespace Illuminate\Routing { class Controller { public function middleware($middleware) {} } }
+namespace App { class Consumer extends ExternalBase {
+    public function boot() { $this->middleware('auth:admin'); }
+} }
+"#;
+    let parent =
+        "<?php namespace App; class ExternalBase extends \\Illuminate\\Routing\\Controller {}";
+    let foreign =
+        "<?php namespace App; class ExternalBase { public function middleware($middleware) {} }";
+    let mut files = workspace_files(source);
+    files.push(("app/ExternalBase.php", parent));
+    let (backend, dir) = create_psr4_workspace(COMPOSER_JSON, &files);
+    backend.initialized(InitializedParams {}).await;
+    let uri = Url::from_file_path(dir.path().join("app/NamedResourceConsumer.php")).unwrap();
+    let parent_uri = Url::from_file_path(dir.path().join("app/ExternalBase.php")).unwrap();
+    for (file, content) in [(&uri, source), (&parent_uri, parent)] {
+        backend
+            .did_open(DidOpenTextDocumentParams {
+                text_document: TextDocumentItem {
+                    uri: file.clone(),
+                    language_id: "php".into(),
+                    version: 1,
+                    text: content.into(),
+                },
+            })
+            .await;
+    }
+    let position = position_after(source, "auth:adm");
+    for (version, content, expected) in [(1, parent, true), (2, foreign, false), (3, parent, true)]
+    {
+        if version > 1 {
+            backend
+                .did_change(DidChangeTextDocumentParams {
+                    text_document: VersionedTextDocumentIdentifier {
+                        uri: parent_uri.clone(),
+                        version,
+                    },
+                    content_changes: vec![TextDocumentContentChangeEvent {
+                        range: None,
+                        range_length: None,
+                        text: content.into(),
+                    }],
+                })
+                .await;
+        }
+        let labels: Vec<_> = completion_items(&backend, &uri, position)
+            .await
+            .into_iter()
+            .map(|item| item.label)
+            .collect();
+        assert_eq!(
+            labels,
+            if expected { vec!["admin"] } else { vec![] },
+            "parent version {version}"
+        );
+        assert_eq!(
+            backend
+                .handle_hover(uri.as_str(), source, position)
+                .is_some(),
+            expected,
+            "cached typed span at version {version}"
+        );
+    }
+    assert_eq!(
+        std::fs::read_to_string(dir.path().join("app/ExternalBase.php")).unwrap(),
+        parent
+    );
+}

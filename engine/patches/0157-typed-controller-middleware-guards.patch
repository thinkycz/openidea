+        if count >= 4096 {
+            return None;
+        }
+        if ch == quote || ch == ',' {
+            return Some(cursor + index);
+        }
+        if !(ch.is_alphanumeric() || matches!(ch, '_' | '-' | '.' | ':' | ' ')) {
+            return None;
+        }
+    }
+    Some(content.len())

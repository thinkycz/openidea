 /// `\u{...}` escape encodes a code point PHP itself would reject
 /// (out of range, or a surrogate half).
 pub(crate) fn decode_php_string_literal(raw: &str) -> Option<Cow<'_, str>> {
+    decode_php_string_literal_with_chunks(raw, |_, _| {})
+}
+
+/// A decoded literal with compact source ranges for literal and escaped runs.
+pub(crate) struct DecodedPhpString<'a> {
+    value: Cow<'a, str>,
+    chunks: Vec<(std::ops::Range<usize>, std::ops::Range<usize>)>,
+}
+
+impl DecodedPhpString<'_> {
+    /// The decoded runtime value.
+    pub(crate) fn value(&self) -> &str {
+        &self.value
+    }
+
+    /// Map a nonempty runtime byte range back into the quoted source literal.
+    pub(crate) fn source_range(
+        &self,
+        range: std::ops::Range<usize>,
+    ) -> Option<std::ops::Range<usize>> {
+        if range.is_empty() || range.end > self.value.len() {
+            return None;
+        }
+        let first = self.chunks.get(
+            self.chunks
+                .partition_point(|(decoded, _)| decoded.end <= range.start),
+        )?;
+        let last = self.chunks.get(
+            self.chunks
+                .partition_point(|(decoded, _)| decoded.end < range.end),
+        )?;
+        let start = if first.0.len() == first.1.len() {
+            first.1.start + range.start - first.0.start
+        } else {
+            first.1.start
+        };
+        let end = if last.0.len() == last.1.len() {
+            last.1.start + range.end - last.0.start
+        } else {
+            last.1.end
+        };
+        Some(start..end)
+    }
+}
+
+/// Decode once, coalescing ordinary text instead of allocating a map per byte.
+pub(crate) fn decode_php_string_literal_spans(raw: &str) -> Option<DecodedPhpString<'_>> {
+    let mut chunks: Vec<(std::ops::Range<usize>, std::ops::Range<usize>)> = Vec::new();
+    let value = decode_php_string_literal_with_chunks(raw, |decoded, source| {
+        if let Some(last) = chunks.last_mut()
+            && last.0.len() == last.1.len()
+            && decoded.len() == source.len()
+            && last.0.end == decoded.start
+            && last.1.end == source.start
+        {
+            last.0.end = decoded.end;
+            last.1.end = source.end;
+        } else {
+            chunks.push((decoded, source));
+        }
+    })?;
+    Some(DecodedPhpString { value, chunks })
+}

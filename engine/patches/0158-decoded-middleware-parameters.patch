+#[tokio::test]
+async fn encoded_controller_guard_spans_refresh_after_same_length_body_changes() {
+    let original = r#"<?php
+namespace Illuminate\Routing {class Controller {public function middleware($middleware) {}}}
+namespace App {class GuardController extends \Illuminate\Routing\Controller {
+public function boot() {$this->middleware("auth:ad\x6din");}
+}}
+"#;
+    let (backend, _dir, uri) = open_workspace(original).await;
+    for (index, source, key) in [
+        (0, original.to_string(), "admin"),
+        (1, original.replace(r#"\x6d"#, r#"\x78"#), "adxin"),
+        (2, original.to_string(), "admin"),
+    ] {
+        if index > 0 {
+            backend
+                .did_change(DidChangeTextDocumentParams {
+                    text_document: VersionedTextDocumentIdentifier {
+                        uri: uri.clone(),
+                        version: index + 1,
+                    },
+                    content_changes: vec![TextDocumentContentChangeEvent {
+                        range: None,
+                        range_length: None,
+                        text: source.clone(),
+                    }],
+                })
+                .await;
+        }
+        let position = position_after(&source, "auth:ad");
+        let hover = backend
+            .handle_hover(uri.as_str(), &source, position)
+            .unwrap();
+        assert!(hover_text(hover).contains(key));
+        let definition = backend
+            .goto_definition(GotoDefinitionParams {
+                text_document_position_params: TextDocumentPositionParams {
+                    text_document: TextDocumentIdentifier { uri: uri.clone() },
+                    position,
+                },
+                work_done_progress_params: Default::default(),
+                partial_result_params: Default::default(),
+            })
+            .await
+            .unwrap();
+        assert_eq!(definition.is_some(), key == "admin");
+    }
+}

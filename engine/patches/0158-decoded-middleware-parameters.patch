+#[tokio::test]
+async fn encoded_middleware_parameters_share_route_guard_and_ability_identity() {
+    let source = r#"<?php
+use Illuminate\Support\Facades\Route;
+use Illuminate\Support\Facades\Gate;
+Gate::define('publish',fn()=>true);
+Route::get('/test',fn()=>null)->middleware(["auth\x3aad\155in", "can:pu\x62lish", "auth:mis\163ing"]);
+"#;
+    let (backend, _dir, uri) = open_workspace(source).await;
+    for (prefix, key, raw, count) in [
+        (r#"ad\155"#, "admin", r#"ad\155in"#, 2),
+        (r#"pu\x62"#, "publish", r#"pu\x62lish"#, 2),
+    ] {
+        let position = position_after(source, prefix);
+        let hover = backend
+            .handle_hover(uri.as_str(), source, position)
+            .unwrap();
+        assert!(hover_text(hover).contains(key));
+        let refs = backend
+            .find_references(uri.as_str(), source, position, true)
+            .unwrap();
+        assert_eq!(refs.len(), count, "{refs:?}");
+        assert!(
+            refs.iter()
+                .any(|reference| reference.uri == uri
+                    && text_in_range(source, reference.range) == raw)
+        );
+    }
+    let mut diagnostics = Vec::new();
+    backend.collect_slow_diagnostics(uri.as_str(), source, &mut diagnostics);
+    let missing = diagnostics
+        .iter()
+        .find(|diagnostic| {
+            diagnostic.message.contains("missing") && diagnostic.message.contains("guard")
+        })
+        .expect("diagnostic uses decoded guard name");
+    assert_eq!(text_in_range(source, missing.range), r#"mis\163ing"#);
+    assert!(
+        !diagnostics
+            .iter()
+            .any(|diagnostic| diagnostic.message.contains("ad\\155in")
+                || diagnostic.message.contains("pu\\x62lish"))
+    );
+}

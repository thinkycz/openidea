+#[tokio::test]
+async fn encoded_guard_literals_keep_dynamic_and_foreign_boundaries() {
+    let source = r#"<?php
+namespace Illuminate\Routing {class Controller {public function middleware($middleware) {}}}
+namespace App {
+class Foreign {public function middleware($middleware) {} public function boot() {
+$this->middleware("auth:ad\x6din");
+}}
+class StaticController extends \Illuminate\Routing\Controller {public static function boot() {
+$this->middleware("auth:ad\x6din");
+}}
+class GuardController extends \Illuminate\Routing\Controller {public function boot() {
+$this->middleware('auth:ad\x6din');
+$guard='admin';$this->middleware("auth:$guard");
+}}
+}
+"#;
+    let (backend, dir, uri) = open_workspace(source).await;
+    let config_uri = Url::from_file_path(dir.path().join("config/auth.php")).unwrap();
+    let refs = backend
+        .find_references(
+            config_uri.as_str(),
+            AUTH_CONFIG,
+            position_of_config_key(AUTH_CONFIG, "admin"),
+            true,
+        )
+        .unwrap();
+    assert_eq!(refs.len(), 1, "no decoded admin caller exists: {refs:?}");
+    let mut diagnostics = Vec::new();
+    backend.collect_slow_diagnostics(uri.as_str(), source, &mut diagnostics);
+    let guards: Vec<_> = diagnostics
+        .iter()
+        .filter(|diagnostic| diagnostic.message.contains("guard"))
+        .collect();
+    assert_eq!(
+        guards.len(),
+        1,
+        "only the literal single-quoted key is invalid: {guards:?}"
+    );
+    assert_eq!(text_in_range(source, guards[0].range), r#"ad\x6din"#);

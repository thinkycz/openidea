+#[test]
+fn decoded_literal_ranges_cover_php_escapes_and_unicode() {
+    for (raw, expected, range, source) in [
+        (
+            r#""auth:ad\x6din,web""#,
+            "auth:admin,web",
+            5..10,
+            r#"ad\x6din"#,
+        ),
+        (
+            r#""auth\x3aweb\054ad\u{6d}in""#,
+            "auth:web,admin",
+            9..14,
+            r#"ad\u{6d}in"#,
+        ),
+        (r#"'auth:it\'s,web'"#, "auth:it's,web", 5..9, r#"it\'s"#),
+        (
+            r#""auth:\xF0\x9F\x98\x80,web""#,
+            "auth:😀,web",
+            5..9,
+            r#"\xF0\x9F\x98\x80"#,
+        ),
+        (
+            r#""auth:\u{1f600},web""#,
+            "auth:😀,web",
+            5..9,
+            r#"\u{1f600}"#,
+        ),
+        (
+            r#"'auth:ad\x6din'"#,
+            r#"auth:ad\x6din"#,
+            5..13,
+            r#"ad\x6din"#,
+        ),
+        (r#""auth:cash\$,web""#, "auth:cash$,web", 5..10, r#"cash\$"#),
+    ] {
+        let decoded = super::decode_php_string_literal_spans(raw).unwrap();
+        assert_eq!(decoded.value(), expected, "{raw}");
+        assert_eq!(&raw[decoded.source_range(range).unwrap()], source, "{raw}");
+        assert!(decoded.source_range(0..0).is_none());
+        assert!(decoded.source_range(0..expected.len() + 1).is_none());
+    }
+    for invalid in [r#""\u{d800}""#, r#""\u{110000}""#, r#""\xff""#] {
+        assert!(
+            super::decode_php_string_literal_spans(invalid).is_none(),
+            "{invalid}"
+        );
+    }
+}
+
+#[test]
+fn decoded_literal_source_map_coalesces_long_ordinary_runs() {
+    let raw = format!("\"{}\\x6d{}\"", "a".repeat(8192), "b".repeat(8192));
+    let decoded = super::decode_php_string_literal_spans(&raw).unwrap();
+    assert_eq!(decoded.chunks.len(), 3);
+    assert_eq!(&raw[decoded.source_range(8191..8194).unwrap()], "a\\x6db");
+}

+#[tokio::test]
+async fn encoded_controller_middleware_guards_navigate_with_raw_source_ranges() {
+    let source = r#"<?php
+namespace Illuminate\Routing { class Controller { public function middleware($middleware) {} } }
+namespace App {
+class GuardController extends \Illuminate\Routing\Controller {
+ public function boot() {
+  $this->middleware("auth:ad\x6din,web");
+  $this->middleware("auth\x3aweb\054ad\u{6d}in");
+ }
+}
+}
+"#;
+    let (backend, _dir, uri) = open_workspace(source).await;
+    for (prefix, raw) in [
+        (r#"auth:ad\x6d"#, r#"ad\x6din"#),
+        (r#"\054ad\u{6d}"#, r#"ad\u{6d}in"#),
+    ] {
+        let position = position_after(source, prefix);
+        let hover = backend
+            .handle_hover(uri.as_str(), source, position)
+            .expect("encoded guard must hover by its runtime name");
+        assert!(hover_text(hover).contains("admin"));
+        let definition = backend
+            .goto_definition(GotoDefinitionParams {
+                text_document_position_params: TextDocumentPositionParams {
+                    text_document: TextDocumentIdentifier { uri: uri.clone() },
+                    position,
+                },
+                work_done_progress_params: Default::default(),
+                partial_result_params: Default::default(),
+            })
+            .await
+            .unwrap()
+            .expect("encoded guard must navigate");
+        let location = definition_location(definition);
+        assert!(location.uri.path().ends_with("/config/auth.php"));
+        assert_eq!(
+            location.range.start,
+            position_of_config_key(AUTH_CONFIG, "admin")
+        );
+        let refs = backend
+            .find_references(uri.as_str(), source, position, true)
+            .expect("encoded guards share references");
+        assert_eq!(
+            refs.len(),
+            3,
+            "declaration plus both decoded uses: {refs:?}"
+        );
+        assert!(
+            refs.iter()
+                .any(|reference| reference.uri == uri
+                    && text_in_range(source, reference.range) == raw)
+        );
+    }
+}

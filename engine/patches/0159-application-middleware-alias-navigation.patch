+//! Static application middleware registrations, without booting the framework.
+use crate::{
+    Backend,
+    symbol_map::{LaravelStringKind, SymbolKind},
+};
+use tower_lsp::lsp_types::{Location, Url};
+
+pub(crate) struct MiddlewareAliasDefinition {
+    pub location: Location,
+    pub target: Option<String>,
+}
+
+impl Backend {
+    pub(crate) fn is_bootstrap_middleware_uri(&self, uri: &str) -> bool {
+        self.workspace
+            .workspace_root
+            .read()
+            .as_ref()
+            .is_some_and(|root| crate::util::path_to_uri(&root.join("bootstrap/app.php")) == uri)
+    }
+
+    /// Read only registrations whose shared type resolution confirms Middleware.
+    /// Multiple static sites stay separate; runtime overrides are not executed.
+    pub(crate) fn middleware_alias_registrations(
+        &self,
+        name: &str,
+    ) -> Vec<MiddlewareAliasDefinition> {
+        if !self.resolved_class_cache.read().is_laravel() {
+            return Vec::new();
+        }
+        let Some(root) = self.workspace.workspace_root.read().clone() else {
+            return Vec::new();
+        };
+        let path = root.join("bootstrap/app.php");
+        let uri = crate::util::path_to_uri(&path);
+        let Some(content) = self.get_file_content(&uri) else {
+            return Vec::new();
+        };
+        if self
+            .symbol_map_for(&uri)
+            .is_none_or(|map| !map.matches_source(&content))
+        {
+            // An open buffer belongs to the editor publisher; never overwrite it
+            // from a lazy read while its new metadata is being admitted.
+            if self.open_files.read().contains_key(&uri) {
+                return Vec::new();
+            }
+            let ticket = self.index_source_ticket(&uri);
+            // The ticket must predate the read whose symbols it admits.
+            if self.get_file_content(&uri).as_deref() != Some(content.as_str()) {
+                self.release_index_source_ticket(&uri, &ticket);
+                return Vec::new();
+            }
+            let parsed = self.parse_ast_index_update_for_ticket(&uri, &content, ticket);
+            self.apply_ast_index_parse_results_batch(vec![parsed]);
+        }
+        let Some(map) = self
+            .symbol_map_for(&uri)
+            .filter(|map| map.matches_source(&content))
+        else {
+            return Vec::new();
+        };
+        if !map
+            .middleware_alias_targets
+            .iter()
+            .any(|target| target.name == name)
+        {
+            return Vec::new();
+        }
+        let confirmed = self.typed_receiver_view_spans_for(&uri, &map);
+        let Ok(url) = Url::parse(&uri) else {
+            return Vec::new();
+        };
+        map.middleware_alias_targets
+            .iter()
+            .filter(|target| {
+                target.name == name
+                    && confirmed.iter().any(|span| {
+                        span.start == target.start
+                            && matches!(
+                                span.kind,
+                                SymbolKind::LaravelStringKey {
+                                    kind: LaravelStringKind::MiddlewareAlias,
+                                    is_write: true,
+                                    ..
+                                }
+                            )
+                    })
+            })
+            .map(|target| MiddlewareAliasDefinition {
+                location: crate::definition::point_location(
+                    url.clone(),
+                    crate::text_position::offset_to_position(&content, target.start as usize),
+                ),
+                target: target.target.clone(),
+            })
+            .collect()
+    }
+
+    pub(crate) fn middleware_alias_detail(&self, name: &str) -> String {
+        let registrations = self.middleware_alias_registrations(name);
+        if registrations.is_empty() {
+            return "No statically resolved application alias registration".into();
+        }
+        let mut targets: Vec<_> = registrations
+            .iter()
+            .filter_map(|site| site.target.as_deref())
+            .collect();
+        targets.sort_unstable();
+        targets.dedup();
+        let mut detail = "Application registrations in `bootstrap/app.php`".to_string();
+        if targets.is_empty() {
+            detail.push_str("\n\nTarget is not statically resolved");
+        } else {
+            detail.push_str(&format!(
+                "\n\nRegistered targets: `{}`",
+                targets.join("`, `")
+            ));
+        }
+        if !targets.is_empty() && registrations.iter().any(|site| site.target.is_none()) {
+            detail.push_str("\n\nSome registration targets are not statically resolved");
+        }
+        if registrations.len() > 1 {
+            detail
+                .push_str("\n\nMultiple static registrations; runtime overrides are not evaluated");
+        }
+        detail
+    }
+}

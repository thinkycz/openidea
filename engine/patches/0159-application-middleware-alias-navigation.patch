+/// Record alias keys without trusting the receiver's variable spelling.
+pub(super) fn record_middleware_alias_declarations(
+    argument_list: &ArgumentList<'_>,
+    content: &str,
+    names: Option<&OwnedResolvedNames>,
+    sites: &mut Vec<ViewReceiverSite>,
+    targets: &mut Vec<crate::symbol_map::MiddlewareAliasTarget>,
+) {
+    let Some(argument) = argument_expr_for_parameter(argument_list, "aliases") else {
+        return;
+    };
+    let Some(elements) = crate::parser::array_literal_elements(argument) else {
+        return;
+    };
+    for element in elements.iter() {
+        let ArrayElement::KeyValue(element) = element else {
+            continue;
+        };
+        let Some((name, start, end)) =
+            crate::virtual_members::laravel::helpers::resolved_string_literal(element.key, content)
+        else {
+            continue;
+        };
+        if name.is_empty() {
+            continue;
+        }
+        let target = if matches!(
+            element.value,
+            Expression::Literal(literal::Literal::String(_))
+        ) {
+            crate::virtual_members::laravel::helpers::resolved_string_literal(
+                element.value,
+                content,
+            )
+            .and_then(|(value, _, _)| laravel_runtime_controller_ref(value))
+            .and_then(|value| value.runtime)
+        } else {
+            laravel_route_controller_value(element.value, names).and_then(|value| value.runtime)
+        };
+        targets.push(crate::symbol_map::MiddlewareAliasTarget {
+            name: name.to_string(),
+            start: start as u32,
+            target,
+        });
+        sites.push(ViewReceiverSite {
+            start: start as u32,
+            end: end as u32,
+            key: name.to_string(),
+            is_optional: false,
+            receiver: ViewReceiverClass::MiddlewareAliasDeclaration,
+        });
     }
 }
 

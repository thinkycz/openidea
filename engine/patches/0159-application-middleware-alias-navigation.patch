+#[tokio::test]
+async fn middleware_alias_rename_is_refused_until_all_registration_forms_are_supported() {
+    let (backend, _dir, uri, bootstrap_uri) = workspace(BOOTSTRAP, SOURCE).await;
+    open_document(&backend, &bootstrap_uri, "php", BOOTSTRAP).await;
+    for (file, text, needle) in [
+        (&uri, SOURCE, "middleware('aud"),
+        (&bootstrap_uri, BOOTSTRAP, "alias(['aud"),
+    ] {
+        let p = position_after(text, needle);
+        assert!(
+            crate::common::prepare_rename(&backend, file, p.line, p.character)
+                .await
+                .is_none()
+        );
+        let result =
+            crate::common::rename_result(&backend, file, p.line, p.character, "reviewed").await;
+        assert!(!matches!(result, Ok(Some(_))), "{result:?}");
+    }
+}

+//! Application middleware registrations through public LSP handlers.
+use crate::common::{
+    create_psr4_workspace, definition_locations, find_references, goto_definition_at,
+    hover_text_at, open_document, position_after,
+};
+use phpantom_lsp::Backend;
+use tower_lsp::{LanguageServer, lsp_types::*};
+
+const SOURCE: &str = r#"<?php
+use Illuminate\Support\Facades\Route;
+Route::get('/audit',fn()=>null)->middleware('audited:strict');
+"#;
+const BOOTSTRAP: &str = r#"<?php
+use Illuminate\Foundation\Application;
+use Illuminate\Foundation\Configuration\Middleware as Stack;
+use App\Http\Middleware\Audit as AuditAlias;
+return Application::configure(basePath: dirname(__DIR__))
+    ->withMiddleware(function (Stack $pipeline): void {
+        $pipeline->alias(['audited' => AuditAlias::class]);
+    })->create();
+"#;
+const COMPOSER: &str = r#"{"require":{"laravel/framework":"^13.0"},"autoload":{"psr-4":{"App\\":"app/","Illuminate\\":"framework/"}}}"#;
+
+async fn workspace(bootstrap: &str, source: &str) -> (Backend, tempfile::TempDir, Url, Url) {
+    workspace_with_composer(COMPOSER, bootstrap, source).await
+}
+async fn workspace_with_composer(
+    composer: &str,
+    bootstrap: &str,
+    source: &str,
+) -> (Backend, tempfile::TempDir, Url, Url) {
+    let files = [
+        ("routes/web.php", source),
+        ("bootstrap/app.php", bootstrap),
+        (
+            "framework/Foundation/Configuration/Middleware.php",
+            "<?php namespace Illuminate\\Foundation\\Configuration; class Middleware {public function alias(array $aliases): static {return $this;}}",
+        ),
+        (
+            "framework/Foundation/Application.php",
+            "<?php namespace Illuminate\\Foundation; class Application {public static function configure(?string $basePath = null): \\Illuminate\\Foundation\\Configuration\\ApplicationBuilder {return new \\Illuminate\\Foundation\\Configuration\\ApplicationBuilder;} }",
+        ),
+        (
+            "framework/Foundation/Configuration/ApplicationBuilder.php",
+            "<?php namespace Illuminate\\Foundation\\Configuration; class ApplicationBuilder {public function withMiddleware(?callable $callback = null): static {return $this;} public function create(): \\Illuminate\\Foundation\\Application {return new \\Illuminate\\Foundation\\Application;}}",
+        ),
+        (
+            "framework/Routing/Controller.php",
+            "<?php namespace Illuminate\\Routing; class Controller {protected function middleware($middleware): static {return $this;}}",
+        ),
+        (
+            "app/Http/Middleware/Audit.php",
+            "<?php namespace App\\Http\\Middleware; class Audit {}",
+        ),
+        (
+            "app/Http/Middleware/Trace.php",
+            "<?php namespace App\\Http\\Middleware; class Trace {}",
+        ),
+    ];
+    let (backend, dir) = create_psr4_workspace(composer, &files);
+    backend.initialized(InitializedParams {}).await;
+    let uri = Url::from_file_path(dir.path().join("routes/web.php")).unwrap();
+    let bootstrap_uri = Url::from_file_path(dir.path().join("bootstrap/app.php")).unwrap();
+    open_document(&backend, &uri, "php", source).await;
+    (backend, dir, uri, bootstrap_uri)
+}
+async fn definitions(backend: &Backend, uri: &Url, source: &str, needle: &str) -> Vec<Location> {
+    let p = position_after(source, needle);
+    definition_locations(goto_definition_at(backend, uri, p.line, p.character).await)
+}
+async fn hover(backend: &Backend, uri: &Url, source: &str, needle: &str) -> String {
+    let p = position_after(source, needle);
+    hover_text_at(backend, uri, p.line, p.character)
+        .await
+        .unwrap_or_default()
+}
+async fn change(backend: &Backend, uri: &Url, content: &str, version: i32) {
+    backend
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: uri.clone(),
+                version,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: content.into(),
+            }],
+        })
+        .await;
+}
+
+#[tokio::test]
+async fn middleware_alias_cold_bootstrap_navigation_and_hover() {
+    let (backend, _dir, uri, bootstrap_uri) = workspace(BOOTSTRAP, SOURCE).await;
+    let locations = definitions(&backend, &uri, SOURCE, "middleware('aud").await;
+    assert_eq!(locations.len(), 1, "{locations:?}");
+    assert_eq!(locations[0].uri, bootstrap_uri);
+    assert_eq!(
+        locations[0].range.start,
+        position_after(BOOTSTRAP, "alias(['")
+    );
+    let text = hover(&backend, &uri, SOURCE, "middleware('aud").await;
+    assert!(text.contains("App\\Http\\Middleware\\Audit"), "{text}");
+}
+
+#[tokio::test]
+async fn middleware_alias_unsaved_same_length_target_and_key_changes() {
+    let (backend, _dir, uri, bootstrap_uri) = workspace(BOOTSTRAP, SOURCE).await;
+    assert!(
+        hover(&backend, &uri, SOURCE, "middleware('aud")
+            .await
+            .contains("Middleware\\Audit")
+    );
+    open_document(&backend, &bootstrap_uri, "php", BOOTSTRAP).await;
+    let changed = BOOTSTRAP.replace("Middleware\\Audit as", "Middleware\\Trace as");
+    assert_eq!(changed.len(), BOOTSTRAP.len());
+    change(&backend, &bootstrap_uri, &changed, 2).await;
+    let text = hover(&backend, &uri, SOURCE, "middleware('aud").await;
+    assert!(
+        text.contains("Middleware\\Trace") && !text.contains("Middleware\\Audit"),
+        "{text}"
+    );
+    let renamed = changed.replace("'audited'", "'auditor'");
+    change(&backend, &bootstrap_uri, &renamed, 3).await;
+    assert!(
+        definitions(&backend, &uri, SOURCE, "middleware('aud")
+            .await
+            .is_empty()
+    );
+    change(&backend, &bootstrap_uri, BOOTSTRAP, 4).await;
+    assert_eq!(
+        definitions(&backend, &uri, SOURCE, "middleware('aud")
+            .await
+            .len(),
+        1
+    );
+}
+
+#[tokio::test]
+async fn middleware_alias_typed_receivers_reassignment_and_bootstrap_ownership() {
+    let changed = BOOTSTRAP.replace(
+        "$pipeline->alias",
+        "$pipeline = new \\stdClass; $pipeline->alias",
+    );
+    let (backend, dir, uri, bootstrap_uri) = workspace(&changed, SOURCE).await;
+    assert!(
+        definitions(&backend, &uri, SOURCE, "middleware('aud")
+            .await
+            .is_empty()
+    );
+    open_document(&backend, &bootstrap_uri, "php", BOOTSTRAP).await;
+    assert_eq!(
+        definitions(&backend, &uri, SOURCE, "middleware('aud")
+            .await
+            .len(),
+        1
+    );
+    let other_uri = Url::from_file_path(dir.path().join("app/Other.php")).unwrap();
+    let other = BOOTSTRAP.replace("'audited'", "'outside'");
+    open_document(&backend, &other_uri, "php", &other).await;
+    let caller = SOURCE.replace("audited:strict", "outside:strict");
+    change(&backend, &uri, &caller, 2).await;
+    assert!(
+        definitions(&backend, &uri, &caller, "middleware('out")
+            .await
+            .is_empty()
+    );
+}
+
+#[tokio::test]
+async fn middleware_alias_controller_inheritance_excludes_foreign_and_static_this() {
+    let source = r#"<?php
+class Base extends \Illuminate\Routing\Controller {}
+class Page extends Base {public function boot() {$this->middleware('audited:strict');}}
+class Foreign {public function middleware($value) {} public function boot() {$this->middleware('audited');}}
+class StaticPage extends Base {public static function boot() {$this->middleware('audited');}}
+"#;
+    let (backend, _dir, uri, _) = workspace(BOOTSTRAP, source).await;
+    assert_eq!(
+        definitions(&backend, &uri, source, "middleware('aud")
+            .await
+            .len(),
+        1
+    );
+    let foreign = "class Foreign {public function middleware($value) {} public function boot() {$this->middleware('aud";
+    assert!(
+        definitions(&backend, &uri, source, foreign)
+            .await
+            .is_empty()
+    );
+    let static_this =
+        "class StaticPage extends Base {public static function boot() {$this->middleware('aud";
+    assert!(
+        definitions(&backend, &uri, source, static_this)
+            .await
+            .is_empty()
+    );
+}
+
+#[tokio::test]
+async fn middleware_alias_named_array_arguments_and_legacy_declaration_array() {
+    let bootstrap = BOOTSTRAP.replace(
+        "alias(['audited' => AuditAlias::class])",
+        "alias(aliases: array('audited' => AuditAlias::class))",
+    );
+    let source = r#"<?php
+use Illuminate\Support\Facades\Route;
+Route::middleware(middleware: ['audited:strict', 'auth:admin']);
+Route::get('/audit',fn()=>null)->middleware(middleware: 'audited:soft');
+"#;
+    let (backend, _dir, uri, _) = workspace(&bootstrap, source).await;
+    for needle in ["middleware: ['aud", "middleware: 'aud"] {
+        assert_eq!(
+            definitions(&backend, &uri, source, needle).await.len(),
+            1,
+            "{needle}"
+        );
+    }
+}
+
+#[tokio::test]
+async fn middleware_alias_multiple_sites_and_unresolved_targets_remain_explicit() {
+    let bootstrap = BOOTSTRAP.replace("$pipeline->alias(['audited' => AuditAlias::class]);", "$pipeline->alias(['audited' => AuditAlias::class]);\n        $pipeline->alias(['audited' => $runtimeTarget]);");
+    let (backend, dir, uri, _) = workspace(&bootstrap, SOURCE).await;
+    assert_eq!(
+        definitions(&backend, &uri, SOURCE, "middleware('aud")
+            .await
+            .len(),
+        2
+    );
+    let text = hover(&backend, &uri, SOURCE, "middleware('aud").await;
+    assert!(
+        text.contains("Multiple static registrations; runtime overrides are not evaluated"),
+        "{text}"
+    );
+    assert!(
+        text.contains("Some registration targets are not statically resolved"),
+        "{text}"
+    );
+    let bootstrap_uri = Url::from_file_path(dir.path().join("bootstrap/app.php")).unwrap();
+    let dynamic = BOOTSTRAP.replace("AuditAlias::class", "$runtimeTarget");
+    open_document(&backend, &bootstrap_uri, "php", &dynamic).await;
+    assert_eq!(
+        definitions(&backend, &uri, SOURCE, "middleware('aud")
+            .await
+            .len(),
+        1
+    );
+    assert!(
+        hover(&backend, &uri, SOURCE, "middleware('aud")
+            .await
+            .contains("not statically resolved")
+    );
+    change(
+        &backend,
+        &bootstrap_uri,
+        &BOOTSTRAP.replace("['audited' => AuditAlias::class]", "$aliases"),
+        2,
+    )
+    .await;
+    assert!(
+        definitions(&backend, &uri, SOURCE, "middleware('aud")
+            .await
+            .is_empty()
+    );
+}
+
+#[tokio::test]
+async fn middleware_alias_decoded_unicode_source_ranges_and_references() {
+    let bootstrap = BOOTSTRAP.replace(
+        "$pipeline->alias(['audited'",
+        "/* 😀 */ $pipeline->alias([\"au\\x64ited\"",
+    );
+    let source = r#"<?php
+use Illuminate\Support\Facades\Route;
+/* 😀 */ Route::middleware("au\x64ited:strict");
+Route::get('/audit',fn()=>null)->middleware('audited:soft');
+"#;
+    let (backend, _dir, uri, bootstrap_uri) = workspace(&bootstrap, source).await;
+    let locations = definitions(&backend, &uri, source, "middleware(\"au").await;
+    assert_eq!(locations.len(), 1, "{locations:?}");
+    assert_eq!(
+        locations[0].range.start,
+        position_after(&bootstrap, "alias([\"")
+    );
+    assert_eq!(locations[0].uri, bootstrap_uri);
+    let refs = find_references(
+        &backend,
+        &uri,
+        position_after(source, "middleware(\"au"),
+        false,
+    )
+    .await;
+    assert_eq!(refs.len(), 2, "{refs:?}");
+    let raw = refs.iter().find(|x| x.range.start.line == 2).unwrap();
+    assert_eq!(raw.range.start, position_after(source, "middleware(\""));
+    assert_eq!(
+        raw.range.end,
+        position_after(source, r#"middleware("au\x64ited"#)
+    );
+    let refs = find_references(
+        &backend,
+        &uri,
+        position_after(source, "middleware(\"au"),
+        true,
+    )
+    .await;
+    assert_eq!(refs.len(), 3, "{refs:?}");
+    open_document(&backend, &bootstrap_uri, "php", &bootstrap).await;
+    let from_declaration = find_references(
+        &backend,
+        &bootstrap_uri,
+        position_after(&bootstrap, "alias([\"au"),
+        false,
+    )
+    .await;
+    assert_eq!(from_declaration.len(), 2, "{from_declaration:?}");
+}
+
+#[tokio::test]
+async fn middleware_alias_deleted_bootstrap_has_no_phantom_target_and_recovers() {
+    let (backend, dir, uri, bootstrap_uri) = workspace(BOOTSTRAP, SOURCE).await;
+    assert_eq!(
+        definitions(&backend, &uri, SOURCE, "middleware('aud")
+            .await
+            .len(),
+        1
+    );
+    std::fs::remove_file(dir.path().join("bootstrap/app.php")).unwrap();
+    backend
+        .did_change_watched_files(DidChangeWatchedFilesParams {
+            changes: vec![FileEvent {
+                uri: bootstrap_uri.clone(),
+                typ: FileChangeType::DELETED,
+            }],
+        })
+        .await;
+    assert!(
+        definitions(&backend, &uri, SOURCE, "middleware('aud")
+            .await
+            .is_empty()
+    );
+    std::fs::write(dir.path().join("bootstrap/app.php"), BOOTSTRAP).unwrap();
+    backend
+        .did_change_watched_files(DidChangeWatchedFilesParams {
+            changes: vec![FileEvent {
+                uri: bootstrap_uri,
+                typ: FileChangeType::CREATED,
+            }],
+        })
+        .await;
+    assert_eq!(
+        definitions(&backend, &uri, SOURCE, "middleware('aud")
+            .await
+            .len(),
+        1
+    );
+}

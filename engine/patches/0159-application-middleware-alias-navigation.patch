+#[tokio::test]
+async fn typed_callback_scope_survives_a_later_fluent_call() {
+    use crate::common::{
+        definition_locations, goto_definition_at, hover_text_at, open_document, position_after,
+    };
+    for (callback, suffix) in [
+        (
+            "function(Payload $value) {$value->display();}",
+            "->finish()",
+        ),
+        (
+            "function(Payload $value) {$value->display();}",
+            "?->finish()",
+        ),
+        ("fn(Payload $value) => $value->display()", "->finish()"),
+    ] {
+        let backend = create_test_backend();
+        let uri = Url::parse("file:///fluent_callback.php").unwrap();
+        let source = format!(
+            "<?php\nclass Payload {{public function display(): string {{return 'ok';}}}}\nclass Builder {{public function tap(callable $callback): static {{return $this;}} public function finish(): static {{return $this;}}}}\nreturn (new Builder())->tap({callback}){suffix};\n"
+        );
+        open_document(&backend, &uri, "php", &source).await;
+        let position = position_after(&source, "$value->dis");
+        let result = definition_locations(
+            goto_definition_at(&backend, &uri, position.line, position.character).await,
+        );
+        assert_eq!(result.len(), 1, "{callback}{suffix}: {result:?}");
+        assert_eq!(result[0].range.start.line, 1);
+        let text = hover_text_at(&backend, &uri, position.line, position.character)
+            .await
+            .unwrap_or_default();
+        assert!(text.contains("display"), "{text}");
+    }
+}

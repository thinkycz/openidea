+            "namespace App\\To",
+            "namespace App\\Tools",
+            "namespace App\\Lib",
+        ),
+        (
+            "<?php /* 😀 namespace App\\Tools; */ namespace App\\Tools {class Thing {}} namespace Other {class Keep {}}",
+            "*/ namespace App\\To",
+            "*/ namespace App\\Tools",
+            "*/ namespace App\\Lib",
+        ),
+        (
+            "<?php\nnamespace\nApp\\Tools;\nclass Thing {}",
+            "\nApp\\To",
+            "\nApp\\Tools",
+            "\nApp\\Lib",
+        ),
+    ] {
+        let backend = create_test_backend();
+        let uri = Url::parse("file:///namespace_inline.php").unwrap();
+        let consumer = Url::parse("file:///namespace_consumer.php").unwrap();
+        let other = "<?php\nuse App\\Tools\\Thing;\nnew Thing;";
+        open_php(&backend, &uri, text).await;

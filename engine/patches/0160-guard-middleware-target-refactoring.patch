+async fn settled_target_rename(
+    backend: &Backend,
+    uri: &Url,
+    source: &str,
+    needle: &str,
+    new_name: &str,
+) -> Result<Option<WorkspaceEdit>, String> {
+    let at = position_after(source, needle);
+    for _ in 0..3 {
+        let result =
+            crate::common::rename_result(backend, uri, at.line, at.character, new_name).await;
+        if result
+            .as_ref()
+            .is_err_and(|message| message.contains("changed"))
+        {
+            continue;
+        }
+        return result;
+    }
+    panic!("rename did not settle against unchanged source");
+}

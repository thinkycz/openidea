+//! Refuse transformations that would strand known middleware class strings.
+use crate::{Backend, util::strip_fqn_prefix};
+
+const REFUSAL: &str = "Class or namespace changes involving a literal middleware target are not supported; no edits were produced.";
+
+impl Backend {
+    pub(super) fn reject_middleware_target_class_rename(&self, fqn: &str) -> Result<(), String> {
+        let fqn = strip_fqn_prefix(fqn);
+        if self
+            .middleware_alias_string_targets()?
+            .iter()
+            .any(|target| target.eq_ignore_ascii_case(fqn))
+        {
+            return Err(REFUSAL.into());
+        }
+        Ok(())
+    }
+
+    pub(super) fn reject_middleware_target_namespace_rename(
+        &self,
+        prefix: &str,
+    ) -> Result<(), String> {
+        let prefix = strip_fqn_prefix(prefix);
+        if self
+            .middleware_alias_string_targets()?
+            .iter()
+            .any(|target| {
+                target
+                    .get(..prefix.len())
+                    .is_some_and(|head| head.eq_ignore_ascii_case(prefix))
+                    && target.as_bytes().get(prefix.len()) == Some(&b'\\')
+            })
+        {
+            return Err(REFUSAL.into());
+        }
+        Ok(())
+    }
+}

+/// Route exclusions require a routing receiver, not a same-named test-case method.
+/// Match PHP's binding on the concrete route method or magic registrar path.
+fn route_exclusion_argument<'a>(
+    arguments: &ArgumentList<'a>,
+) -> Option<(&'a Expression<'a>, RouteMiddlewareReceiver)> {
+    if arguments.arguments.iter().any(|argument| {
+        matches!(argument, Argument::Positional(positional) if positional.ellipsis.is_some())
+    }) {
+        return None;
+    }
+    let mut arguments = arguments.arguments.iter();
+    match arguments.next()? {
+        Argument::Positional(positional) => {
+            let receiver = if arguments.any(|argument| matches!(argument, Argument::Named(_))) {
+                // Magic calls keep their positional value; a concrete method
+                // has no second named parameter and would reject the call.
+                RouteMiddlewareReceiver::Magic
+            } else {
+                RouteMiddlewareReceiver::Any
+            };
+            Some((positional.value, receiver))
+        }
+        Argument::Named(named)
+            if named.name.value == b"middleware" && arguments.next().is_none() =>
+        {
+            Some((named.value, RouteMiddlewareReceiver::Concrete))
+        }
+        Argument::Named(_) => None,
+    }
+}
+
+/// The facade dispatches this method through Router's positional-only magic path.
+pub(super) fn try_emit_route_facade_exclusion_spans(
+    method_name: &str,
+    arguments: &ArgumentList<'_>,
+    content: &str,
+    spans: &mut Vec<SymbolSpan>,
+) {
+    if method_name != "withoutMiddleware" {
+        return;
+    }
+    let Some((value, receiver)) = route_exclusion_argument(arguments) else {
+        return;
+    };
+    if receiver != RouteMiddlewareReceiver::Concrete {
+        emit_middleware_argument_spans(value, true, content, spans);
+    }
+}

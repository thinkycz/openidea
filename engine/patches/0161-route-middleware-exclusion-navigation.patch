+/// Follow only the receiver chain, not unrelated arguments or closure bodies.
+fn receiver_uses_this(expression: &Expression<'_>) -> bool {
+    match crate::parser::unwrap_parens(expression) {
+        Expression::Variable(Variable::Direct(variable)) => variable.name == b"$this",
+        Expression::Access(Access::Property(access)) => receiver_uses_this(access.object),
+        Expression::Access(Access::NullSafeProperty(access)) => receiver_uses_this(access.object),
+        Expression::Call(Call::Method(call)) => receiver_uses_this(call.object),
+        Expression::Call(Call::NullSafeMethod(call)) => receiver_uses_this(call.object),
+        Expression::ArrayAccess(access) => receiver_uses_this(access.array),
+        _ => false,
     }
 }
 

+/// Every alternative must belong to the accepted family; an unrelated branch
+/// cannot borrow another alternative's middleware semantics.
+fn matches_receiver_family(
+    ty: &crate::php_type::PhpType,
+    family: &[&str],
+    class_loader: &dyn Fn(&str) -> Option<Arc<ClassInfo>>,
+) -> bool {
+    if let crate::php_type::TypeKind::Union(members) = ty.kind() {
+        return members
+            .iter()
+            .all(|member| matches_receiver_family(member, family, class_loader));
+    }
+    family
+        .iter()
+        .any(|fqn| crate::class_lookup::is_subtype_of_named(ty, fqn, class_loader))
 }
 

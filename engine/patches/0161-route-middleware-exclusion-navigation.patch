+async fn exclusion_workspace(source: &str) -> (Backend, tempfile::TempDir, Url, Url) {
+    let (backend, dir, uri, boot) = workspace(BOOTSTRAP, source).await;
+    for (file, text) in [
+        (
+            "framework/Routing/Router.php",
+            "<?php namespace Illuminate\\Routing; /** @method \\Illuminate\\Routing\\RouteRegistrar withoutMiddleware(array|string $middleware) */ class Router {public function __call(string $method, array $arguments): RouteRegistrar {return new RouteRegistrar;}}",
+        ),
+        (
+            "framework/Support/Facades/Route.php",
+            "<?php namespace Illuminate\\Support\\Facades; class Route {public static function get($uri, $action): \\Illuminate\\Routing\\Route {return new \\Illuminate\\Routing\\Route;} public static function prefix($prefix): \\Illuminate\\Routing\\RouteRegistrar {return new \\Illuminate\\Routing\\RouteRegistrar;}}",
+        ),
+        (
+            "framework/Routing/Route.php",
+            "<?php namespace Illuminate\\Routing; class Route {public function withoutMiddleware($middleware): static {return $this;}}",
+        ),
+        (
+            "framework/Routing/RouteRegistrar.php",
+            "<?php namespace Illuminate\\Routing; /** @method \\Illuminate\\Routing\\RouteRegistrar withoutMiddleware(array|string $middleware) */ class RouteRegistrar {public function __call(string $method, array $arguments): static {return $this;}}",
+        ),
+        (
+            "framework/Routing/PendingResourceRegistration.php",
+            "<?php namespace Illuminate\\Routing; class PendingResourceRegistration {public function withoutMiddleware($middleware): static {return $this;}}",
+        ),
+        (
+            "framework/Routing/PendingSingletonResourceRegistration.php",
+            "<?php namespace Illuminate\\Routing; class PendingSingletonResourceRegistration {public function withoutMiddleware($middleware): static {return $this;}}",
+        ),
+        (
+            "config/auth.php",
+            "<?php return ['guards'=>['admin'=>[], 'staff'=>[]]];",
+        ),
+    ] {
+        let path = dir.path().join(file);
+        std::fs::create_dir_all(path.parent().unwrap()).unwrap();
+        std::fs::write(&path, text).unwrap();
+        open_document(&backend, &Url::from_file_path(path).unwrap(), "php", text).await;
+    }
+    (backend, dir, uri, boot)
+}

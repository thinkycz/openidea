+/// The resource method binds its route-method selector before the middleware.
+fn resource_exclusion_argument<'a>(arguments: &ArgumentList<'a>) -> Option<&'a Expression<'a>> {
+    let mut methods = None;
+    let mut middleware = None;
+    let mut named_seen = false;
+    for (index, argument) in arguments.arguments.iter().enumerate() {
+        let (slot, value) = match argument {
+            Argument::Positional(positional) => {
+                if positional.ellipsis.is_some() || named_seen {
+                    return None;
+                }
+                let slot = match index {
+                    0 => &mut methods,
+                    1 => &mut middleware,
+                    _ => continue,
+                };
+                (slot, positional.value)
+            }
+            Argument::Named(named) => {
+                named_seen = true;
+                let slot = match named.name.value {
+                    b"methods" => &mut methods,
+                    b"middleware" => &mut middleware,
+                    _ => return None,
+                };
+                (slot, named.value)
+            }
+        };
+        if slot.replace(value).is_some() {
+            return None;
+        }
+    }
+    methods.and(middleware)
+}

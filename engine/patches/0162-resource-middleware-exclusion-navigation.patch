+#[tokio::test]
+async fn resource_exclusions_refresh_concrete_origins_and_same_length_registration_edits() {
+    let source = r#"<?php
+function remove(\App\ResourceChild $resource) {$resource->withoutMiddlewareFor('show', 'audited');}
+"#;
+    let (backend, dir, uri, boot) = exclusion_workspace(source).await;
+    let path = Url::from_file_path(dir.path().join("app/ResourceChild.php")).unwrap();
+    let inherited = "<?php namespace App; class ResourceChild extends \\Illuminate\\Routing\\PendingResourceRegistration {}";
+    let custom = "<?php namespace App; class ResourceChild extends \\Illuminate\\Routing\\PendingResourceRegistration {public function withoutMiddlewareFor($methods,$middleware): static {return $this;}}";
+    let needle = "withoutMiddlewareFor('show', 'aud";
+    assert!(definitions(&backend, &uri, source, needle).await.is_empty());
+    std::fs::write(dir.path().join("app/ResourceChild.php"), inherited).unwrap();
+    open_document(&backend, &path, "php", inherited).await;
+    assert_eq!(definitions(&backend, &uri, source, needle).await.len(), 1);
+    change(&backend, &path, custom, 2).await;
+    assert!(
+        definitions(&backend, &uri, source, needle).await.is_empty(),
+        "unsaved override retires resource semantics"
+    );
+    change(&backend, &path, inherited, 3).await;
+    assert_eq!(definitions(&backend, &uri, source, needle).await.len(), 1);
+    let target = BOOTSTRAP.replace("Middleware\\Audit as", "Middleware\\Trace as");
+    assert_eq!(target.len(), BOOTSTRAP.len());
+    open_document(&backend, &boot, "php", BOOTSTRAP).await;
+    change(&backend, &boot, &target, 2).await;
+    assert!(
+        hover(&backend, &uri, source, needle)
+            .await
+            .contains("Middleware\\Trace")
+    );
+    let changed_key = target.replace("'audited'", "'missing'");
+    assert_eq!(changed_key.len(), target.len());
+    change(&backend, &boot, &changed_key, 3).await;
+    assert!(definitions(&backend, &uri, source, needle).await.is_empty());
+}

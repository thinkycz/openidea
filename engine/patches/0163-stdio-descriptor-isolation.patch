@@ -0,0 +1,160 @@
+//! The stdio server must not keep unrelated parent streams alive.
+#![cfg(target_os = "macos")]
+
+use std::io::{BufRead, BufReader, Read, Write};
+use std::os::fd::AsFd;
+use std::process::{Child, ChildStdin, Command, Stdio};
+use std::sync::mpsc::{self, Receiver};
+use std::time::{Duration, Instant};
+
+use serde_json::{Value, json};
+
+struct Server {
+    child: Child,
+    stdin: Option<ChildStdin>,
+    messages: Receiver<Value>,
+}
+
+impl Server {
+    fn send(&mut self, value: Value) {
+        let bytes = serde_json::to_vec(&value).unwrap();
+        let input = self.stdin.as_mut().unwrap();
+        write!(input, "Content-Length: {}\r\n\r\n", bytes.len()).unwrap();
+        input.write_all(&bytes).unwrap();
+        input.flush().unwrap();
+    }
+
+    fn response(&mut self, id: u64) -> Value {
+        let deadline = Instant::now() + Duration::from_secs(15);
+        loop {
+            let message = self
+                .messages
+                .recv_timeout(deadline.saturating_duration_since(Instant::now()))
+                .unwrap();
+            if message.get("method").is_some()
+                && let Some(server_id) = message.get("id")
+            {
+                self.send(json!({"jsonrpc":"2.0","id":server_id,"result":null}));
+                continue;
+            }
+            if message.get("id").and_then(Value::as_u64) == Some(id) {
+                assert!(message.get("error").is_none(), "{message}");
+                return message;
+            }
+        }
+    }
+}
+
+impl Drop for Server {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}
+
+fn check_descriptor_release(sparse: bool) {
+    let root = tempfile::tempdir().unwrap();
+    std::fs::write(root.path().join("composer.json"), "{}").unwrap();
+    let (mut reader, writer) = std::io::pipe().unwrap();
+    let inherited = if sparse {
+        rustix::io::fcntl_dupfd_cloexec(writer.as_fd(), 128).unwrap()
+    } else {
+        rustix::io::dup(writer.as_fd()).unwrap()
+    };
+    drop(writer);
+    rustix::io::fcntl_setfd(&inherited, rustix::io::FdFlags::empty()).unwrap();
+    let binary = std::env::var_os("OPENSTORM_FD_TEST_BIN")
+        .map(std::path::PathBuf::from)
+        .unwrap_or_else(|| env!("CARGO_BIN_EXE_phpantom_lsp").into());
+    let mut child = Command::new(binary)
+        .args(["--stdio", "--no-project-tools"])
+        .current_dir(root.path())
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .spawn()
+        .unwrap();
+    drop(inherited);
+    let stdout = child.stdout.take().unwrap();
+    let (sender, messages) = mpsc::channel();
+    std::thread::spawn(move || {
+        let mut output = BufReader::new(stdout);
+        loop {
+            let mut length = None;
+            loop {
+                let mut header = String::new();
+                if output.read_line(&mut header).unwrap_or(0) == 0 {
+                    return;
+                }
+                if header == "\r\n" {
+                    break;
+                }
+                if let Some(value) = header.strip_prefix("Content-Length:") {
+                    length = value.trim().parse::<usize>().ok();
+                }
+            }
+            let mut body = vec![0; length.expect("LSP content length")];
+            if output.read_exact(&mut body).is_err() {
+                return;
+            }
+            if sender.send(serde_json::from_slice(&body).unwrap()).is_err() {
+                return;
+            }
+        }
+    });
+    let stdin = child.stdin.take();
+    let mut server = Server {
+        child,
+        stdin,
+        messages,
+    };
+    server.send(
+        json!({"jsonrpc":"2.0","id":1,"method":"initialize","params":{
+            "processId":null,
+            "rootUri":tower_lsp::lsp_types::Url::from_directory_path(root.path()).unwrap(),
+            "capabilities":{"workspace":{"didChangeWatchedFiles":{"dynamicRegistration":true},"didChangeConfiguration":{"dynamicRegistration":true}}}
+        }}),
+    );
+    let initialized = server.response(1);
+    assert!(initialized["result"]["capabilities"].is_object());
+    server.send(json!({"jsonrpc":"2.0","method":"initialized","params":{}}));
+    assert!(server.child.try_wait().unwrap().is_none());
+    let flags = rustix::fs::fcntl_getfl(&reader).unwrap();
+    rustix::fs::fcntl_setfl(&reader, flags | rustix::fs::OFlags::NONBLOCK).unwrap();
+    let deadline = Instant::now() + Duration::from_secs(2);
+    loop {
+        match reader.read(&mut [0]) {
+            Ok(0) => break,
+            Err(error)
+                if error.kind() == std::io::ErrorKind::WouldBlock && Instant::now() < deadline =>
+            {
+                std::thread::sleep(Duration::from_millis(5));
+            }
+            result => panic!("stdio server retained unrelated descriptor: {result:?}"),
+        }
+    }
+    assert!(server.child.try_wait().unwrap().is_none());
+    server.send(json!({"jsonrpc":"2.0","id":2,"method":"shutdown"}));
+    server.response(2);
+    server.send(json!({"jsonrpc":"2.0","method":"exit"}));
+    drop(server.stdin.take());
+    let deadline = Instant::now() + Duration::from_secs(5);
+    loop {
+        if let Some(status) = server.child.try_wait().unwrap() {
+            assert!(status.success(), "{status}");
+            break;
+        }
+        assert!(Instant::now() < deadline, "stdio server did not exit");
+        std::thread::sleep(Duration::from_millis(10));
+    }
+}
+
+#[test]
+fn stdio_server_releases_foreign_pipe_while_protocol_remains_live() {
+    check_descriptor_release(false);
+}
+
+#[test]
+fn stdio_server_releases_sparse_foreign_descriptor() {
+    check_descriptor_release(true);
+}

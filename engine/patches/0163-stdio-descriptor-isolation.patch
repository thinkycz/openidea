--- /dev/null
+++ b/src/startup.rs
@@ -0,0 +1,37 @@
+//! Descriptor ownership at the macOS stdio server boundary.
+use std::os::fd::{AsRawFd, BorrowedFd};
+
+/// Release descriptors outside the standard LSP transport.
+///
+/// # Safety
+/// Call once during process startup, before spawning threads or opening any
+/// application-owned descriptors. Only stdin, stdout and stderr may be owned.
+pub(super) unsafe fn close_inherited_descriptors() -> rustix::io::Result<()> {
+    let fd = rustix::fs::open(
+        "/dev/fd",
+        rustix::fs::OFlags::RDONLY | rustix::fs::OFlags::DIRECTORY | rustix::fs::OFlags::CLOEXEC,
+        rustix::fs::Mode::empty(),
+    )?;
+    let mut directory = rustix::fs::Dir::new(fd)?;
+    let directory_fd = directory.fd()?.as_raw_fd();
+    let mut inherited = Vec::new();
+    for entry in directory.by_ref() {
+        let entry = entry?;
+        if let Ok(name) = entry.file_name().to_str()
+            && let Ok(fd) = name.parse::<i32>()
+            && fd > 2
+            && fd != directory_fd
+        {
+            inherited.push(fd);
+        }
+    }
+    for fd in inherited {
+        // The directory remains open. Before threads start, every other
+        // descriptor in this snapshot is still live and has no Rust owner.
+        let flags = rustix::io::fcntl_getfd(unsafe { BorrowedFd::borrow_raw(fd) })?;
+        if !flags.contains(rustix::io::FdFlags::CLOEXEC) {
+            unsafe { rustix::io::try_close(fd)? };
+        }
+    }
+    Ok(())
+}

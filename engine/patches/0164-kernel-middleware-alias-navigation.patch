+#[tokio::test]
+async fn kernel_alias_maps_require_kernel_ancestry_and_instance_property() {
+    for source in [
+        KERNEL.replace("extends BaseKernel", ""),
+        KERNEL.replace("class Kernel extends BaseKernel", "trait Kernel"),
+        KERNEL.replace(
+            "protected $middlewareAliases",
+            "protected static $middlewareAliases",
+        ),
+        KERNEL.replace("middlewareAliases", "middlewarealiases"),
+        KERNEL.replace(
+            "Illuminate\\Foundation\\Http\\Kernel as",
+            "Missing\\UnknownKernel as",
+        ),
+    ] {
+        let (backend, _dir, uri, _) = kernel_workspace(&source).await;
+        assert!(
+            definitions(&backend, &uri, SOURCE, "middleware('aud")
+                .await
+                .is_empty(),
+            "foreign Kernel map: {source}"
+        );

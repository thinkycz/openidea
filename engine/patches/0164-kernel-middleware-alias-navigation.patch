+const KERNEL: &str = r#"<?php
+namespace App\Http;
+use Illuminate\Foundation\Http\Kernel as BaseKernel;
+use App\Http\Middleware\Audit as AuditAlias;
+class Kernel extends BaseKernel {
+    protected $middlewareAliases = [/* 😀 */ "au\x64ited" => AuditAlias::class];
+}
+"#;
+
+#[tokio::test]
+async fn kernel_alias_maps_navigate_hover_and_track_unsaved_registration() {
+    for property in ["middlewareAliases", "routeMiddleware"] {
+        let source = KERNEL.replace("middlewareAliases", property);
+        let (backend, dir, uri, kernel_uri) = kernel_workspace(&source).await;
+        let found = definitions(&backend, &uri, SOURCE, "middleware('aud").await;
+        assert_eq!(
+            found.len(),
+            1,
+            "Kernel alias definition: {property}: {found:?}"
+        );
+        assert_eq!(found[0].uri, kernel_uri);
+        assert_eq!(found[0].range.start, position_after(&source, "\""));
+        assert!(
+            hover(&backend, &uri, SOURCE, "middleware('aud")
+                .await
+                .contains("App\\Http\\Middleware\\Audit")
+        );
+        let detail = hover(&backend, &uri, SOURCE, "middleware('aud").await;
+        assert!(detail.contains("app/Http/Kernel.php"), "{detail}");
+        assert!(!detail.contains("bootstrap/app.php"), "{detail}");
+        let refs = find_references(
+            &backend,
+            &uri,
+            position_after(SOURCE, "middleware('aud"),
+            true,
+        )
+        .await;
+        let registration = refs
+            .iter()
+            .find(|location| location.uri == kernel_uri)
+            .expect("Kernel declaration reference");
+        assert_eq!(
+            registration.range.end.character - registration.range.start.character,
+            10
+        );
+        open_document(&backend, &kernel_uri, "php", &source).await;
+        for (file, text, needle) in [
+            (&uri, SOURCE, "middleware('aud"),
+            (&kernel_uri, source.as_str(), "\"au"),
+        ] {
+            let at = position_after(text, needle);
+            assert!(
+                crate::common::prepare_rename(&backend, file, at.line, at.character)
+                    .await
+                    .is_none()
+            );
+            let result =
+                crate::common::rename_result(&backend, file, at.line, at.character, "reviewed")
+                    .await;
+            assert!(
+                result
+                    .as_ref()
+                    .is_err_and(|message| message.contains("Middleware alias rename")),
+                "{result:?}"
+            );
+        }
+        let changed = source.replace("Middleware\\Audit as", "Middleware\\Trace as");
+        change(&backend, &kernel_uri, &changed, 2).await;
+        assert!(
+            hover(&backend, &uri, SOURCE, "middleware('aud")
+                .await
+                .contains("App\\Http\\Middleware\\Trace")
+        );
+        change(
+            &backend,
+            &kernel_uri,
+            &changed.replace(r"au\x64ited", "different"),
+            3,
+        )
+        .await;
+        assert!(
+            definitions(&backend, &uri, SOURCE, "middleware('aud")
+                .await
+                .is_empty()
+        );
+        assert_eq!(
+            std::fs::read_to_string(dir.path().join("app/Http/Kernel.php")).unwrap(),
+            source
+        );
+    }
+}

+async fn kernel_alias_target_literals_and_dynamic_maps_refuse_partial_class_rename() {
+    for (initializer, expected) in [
+        (
+            r"['audited' => 'App\Http\Middleware\Audit']",
+            "literal middleware target",
+        ),
+        ("ALIASES", "targets are not fully resolved"),
+        (
+            "['audited' => AliasTargets::AUDIT]",
+            "targets are not fully resolved",
+        ),
+    ] {
+        let source = KERNEL.replace(
+            r#"[/* 😀 */ "au\x64ited" => AuditAlias::class]"#,
+            initializer,
+        );
+        let (backend, dir, _, _) = kernel_workspace(&source).await;
+        let file = dir.path().join("app/Http/Middleware/Audit.php");
+        let text = std::fs::read_to_string(&file).unwrap();
+        let uri = Url::from_file_path(file).unwrap();
+        open_document(&backend, &uri, "php", &text).await;
+        let result = settled_target_rename(&backend, &uri, &text, "class Aud", "Auditor").await;
+        assert!(
+            result
+                .as_ref()
+                .is_err_and(|message| message.contains(expected)),
+            "unsafe Kernel target rename: {initializer}: {result:?}"
+        );
+    }
+}

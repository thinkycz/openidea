+#[tokio::test]
+async fn kernel_alias_parent_publication_refreshes_unchanged_callers() {
+    let source = KERNEL.replace(
+        "Illuminate\\Foundation\\Http\\Kernel as",
+        "App\\Http\\KernelBase as",
+    );
+    let parent = "<?php namespace App\\Http; class KernelBase extends \\Illuminate\\Foundation\\Http\\Kernel {}";
+    let (backend, dir, uri, _) =
+        kernel_workspace_extra(&source, &[("app/Http/KernelBase.php", parent)]).await;
+    assert_eq!(
+        definitions(&backend, &uri, SOURCE, "middleware('aud")
+            .await
+            .len(),
+        1
+    );
+    let path = dir.path().join("app/Http/KernelBase.php");
+    let parent_uri = Url::from_file_path(&path).unwrap();
+    open_document(&backend, &parent_uri, "php", parent).await;
+    change(
+        &backend,
+        &parent_uri,
+        "<?php namespace App\\Http; class KernelBase {}",
+        2,
+    )
+    .await;
+    assert!(
+        definitions(&backend, &uri, SOURCE, "middleware('aud")
+            .await
+            .is_empty()
+    );
+    change(&backend, &parent_uri, parent, 3).await;
+    assert_eq!(
+        definitions(&backend, &uri, SOURCE, "middleware('aud")
+            .await
+            .len(),
+        1
+    );
+    assert_eq!(std::fs::read_to_string(path).unwrap(), parent);
+}

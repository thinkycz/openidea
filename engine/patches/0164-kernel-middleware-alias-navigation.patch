+    open_document(&backend, &uri, "php", &source).await;
+    let result = settled_target_rename(&backend, &uri, &source, "class Aud", "Auditor").await;
+    let edit = result
+        .expect("named class target must remain renameable")
+        .expect("class edits");
+    assert!(

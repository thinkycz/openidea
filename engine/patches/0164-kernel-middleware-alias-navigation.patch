+#[tokio::test]
+async fn kernel_alias_multiple_static_maps_do_not_invent_override_order() {
+    let source = KERNEL.replace("protected $middlewareAliases", "protected $routeMiddleware = ['audited' => \\App\\Http\\Middleware\\Trace::class]; protected $middlewareAliases");
+    let (backend, _dir, uri, _) = kernel_workspace_extra(&source, &[
+        ("bootstrap/app.php", BOOTSTRAP),
+        ("framework/Foundation/Configuration/Middleware.php", "<?php namespace Illuminate\\Foundation\\Configuration; class Middleware {public function alias(array $aliases): static {return $this;}}"),
+        ("framework/Foundation/Application.php", "<?php namespace Illuminate\\Foundation; class Application {public static function configure(?string $basePath=null): \\Illuminate\\Foundation\\Configuration\\ApplicationBuilder {return new \\Illuminate\\Foundation\\Configuration\\ApplicationBuilder;}}"),
+        ("framework/Foundation/Configuration/ApplicationBuilder.php", "<?php namespace Illuminate\\Foundation\\Configuration; class ApplicationBuilder {public function withMiddleware(?callable $callback=null): static {return $this;} public function create(): \\Illuminate\\Foundation\\Application {return new \\Illuminate\\Foundation\\Application;}}"),
+    ]).await;
+    assert_eq!(
+        definitions(&backend, &uri, SOURCE, "middleware('aud")
+            .await
+            .len(),
+        3
+    );
+    let text = hover(&backend, &uri, SOURCE, "middleware('aud").await;
+    assert!(
+        text.contains("Audit")
+            && text.contains("Trace")
+            && text.contains("app/Http/Kernel.php")
+            && text.contains("bootstrap/app.php")
+            && text.contains("Multiple static registrations"),
+        "{text}"
+    );
+}

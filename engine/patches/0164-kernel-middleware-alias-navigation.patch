+async fn kernel_workspace(kernel: &str) -> (Backend, tempfile::TempDir, Url, Url) {
+    kernel_workspace_extra(kernel, &[]).await
+}
+
+async fn kernel_workspace_extra(
+    kernel: &str,
+    extra: &[(&str, &str)],
+) -> (Backend, tempfile::TempDir, Url, Url) {
+    let composer = COMPOSER.replace("^13.0", "^10.0");
+    let mut files = vec![
+        ("routes/web.php", SOURCE),
+        ("app/Http/Kernel.php", kernel),
+        (
+            "framework/Foundation/Http/Kernel.php",
+            "<?php namespace Illuminate\\Foundation\\Http; class Kernel {}",
+        ),
+        (
+            "app/Http/Middleware/Audit.php",
+            "<?php namespace App\\Http\\Middleware; class Audit {}",
+        ),
+        (
+            "app/Http/Middleware/Trace.php",
+            "<?php namespace App\\Http\\Middleware; class Trace {}",
+        ),
+    ];
+    files.extend_from_slice(extra);
+    let (backend, dir) = create_psr4_workspace(&composer, &files);
+    backend.initialized(InitializedParams {}).await;
+    let uri = Url::from_file_path(dir.path().join("routes/web.php")).unwrap();
+    let kernel_uri = Url::from_file_path(dir.path().join("app/Http/Kernel.php")).unwrap();
+    open_document(&backend, &uri, "php", SOURCE).await;
+    (backend, dir, uri, kernel_uri)
+}

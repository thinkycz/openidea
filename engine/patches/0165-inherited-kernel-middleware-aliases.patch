+const INHERITED_KERNEL: &str = "<?php namespace App\\Http; class Kernel extends ParentKernel {}";
+const ALIAS_PARENT: &str = r#"<?php
+namespace App\Http;
+use App\Http\Middleware\Audit as AuditAlias;
+class ParentKernel extends \Illuminate\Foundation\Http\Kernel {
+    protected $middlewareAliases = [/* 😀 */ "au\x64ited" => AuditAlias::class];
+}
+"#;
+
+#[tokio::test]
+async fn inherited_kernel_parent_navigation_ranges_and_dirty_sources() {
+    for property in ["middlewareAliases", "routeMiddleware"] {
+        let parent = ALIAS_PARENT.replace("middlewareAliases", property);
+        let (backend, dir, caller, _) =
+            kernel_workspace_extra(INHERITED_KERNEL, &[("app/Http/ParentKernel.php", &parent)])
+                .await;
+        let uri = Url::from_file_path(dir.path().join("app/Http/ParentKernel.php")).unwrap();
+        let found = definitions(&backend, &caller, SOURCE, "middleware('aud").await;
+        assert_eq!(found.len(), 1, "inherited Kernel definition: {found:?}");
+        assert_eq!(found[0].uri, uri);
+        assert_eq!(found[0].range.start, position_after(&parent, "\""));
+        let detail = hover(&backend, &caller, SOURCE, "middleware('aud").await;
+        assert!(
+            detail.contains("App\\Http\\Middleware\\Audit")
+                && detail.contains("app/Http/ParentKernel.php"),
+            "{detail}"
+        );
+        let refs = find_references(
+            &backend,
+            &caller,
+            position_after(SOURCE, "middleware('aud"),
+            true,
+        )
+        .await;
+        let declaration = refs.iter().find(|location| location.uri == uri).unwrap();
+        assert_eq!(
+            declaration.range.end.character - declaration.range.start.character,
+            10
+        );
+        open_document(&backend, &uri, "php", &parent).await;
+        let changed = parent.replace("Middleware\\Audit as", "Middleware\\Trace as");
+        assert_eq!(parent.len(), changed.len());
+        change(&backend, &uri, &changed, 2).await;
+        assert!(
+            hover(&backend, &caller, SOURCE, "middleware('aud")
+                .await
+                .contains("Middleware\\Trace")
+        );
+        change(
+            &backend,
+            &uri,
+            &changed.replace(r"au\x64ited", "different"),
+            3,
+        )
+        .await;
+        assert!(
+            definitions(&backend, &caller, SOURCE, "middleware('aud")
+                .await
+                .is_empty()
+        );
+        assert_eq!(
+            std::fs::read_to_string(dir.path().join("app/Http/ParentKernel.php")).unwrap(),
+            parent
+        );
+    }
+}

+#[tokio::test]
+async fn inherited_kernel_nested_trait_owns_navigation_and_refreshes_composition() {
+    let root = r"<?php namespace App\Http; class Kernel extends \Illuminate\Foundation\Http\Kernel {use AliasOuter;}";
+    let outer = r"<?php namespace App\Http; trait AliasOuter {use AliasInner;}";
+    let inner = ALIAS_PARENT.replace(
+        "class ParentKernel extends \\Illuminate\\Foundation\\Http\\Kernel",
+        "trait AliasInner",
+    );
+    let (backend, dir, caller, kernel) = kernel_workspace_extra(
+        root,
+        &[
+            ("app/Http/AliasOuter.php", outer),
+            ("app/Http/AliasInner.php", &inner),
+        ],
+    )
+    .await;
+    let uri = Url::from_file_path(dir.path().join("app/Http/AliasInner.php")).unwrap();
+    let found = definitions(&backend, &caller, SOURCE, "middleware('aud").await;
+    assert_eq!(found.len(), 1, "trait Kernel definition: {found:?}");
+    assert_eq!(found[0].uri, uri);
+    assert!(
+        hover(&backend, &caller, SOURCE, "middleware('aud")
+            .await
+            .contains("app/Http/AliasInner.php")
+    );
+    open_document(&backend, &uri, "php", &inner).await;
+    change(
+        &backend,
+        &uri,
+        &inner.replace("Middleware\\Audit as", "Middleware\\Trace as"),
+        2,
+    )
+    .await;
+    assert!(
+        hover(&backend, &caller, SOURCE, "middleware('aud")
+            .await
+            .contains("Middleware\\Trace")
+    );
+    open_document(&backend, &kernel, "php", root).await;
+    change(&backend, &kernel, &root.replace("use AliasOuter;", ""), 2).await;
+    assert!(
+        definitions(&backend, &caller, SOURCE, "middleware('aud")
+            .await
+            .is_empty()
+    );
+    change(&backend, &kernel, root, 3).await;
+    assert_eq!(
+        definitions(&backend, &caller, SOURCE, "middleware('aud")
+            .await
+            .len(),
+        1
+    );
+    assert_eq!(
+        std::fs::read_to_string(dir.path().join("app/Http/AliasInner.php")).unwrap(),
+        inner
+    );
+}

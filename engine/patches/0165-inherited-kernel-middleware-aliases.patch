+//! Effective HTTP Kernel alias-property ownership through shared inheritance.
+use crate::{
+    Backend,
+    types::{ClassInfo, ClassLikeKind, MAX_INHERITANCE_DEPTH, MAX_TRAIT_DEPTH, Visibility},
+};
+use std::{
+    cell::{Cell, RefCell},
+    collections::{HashMap, HashSet},
+    sync::Arc,
+};
+
+pub(crate) struct KernelAliasOrigin {
+    pub uri: String,
+    pub declaration_offset: u32,
+}
+
+pub(crate) struct KernelAliasSources {
+    pub origins: Vec<KernelAliasOrigin>,
+    pub complete: bool,
+}
+
+fn identity(name: &str) -> String {
+    name.trim_start_matches('\\').to_ascii_lowercase()
+}
+
+fn complete_graph(
+    root: &ClassInfo,
+    loaded: &HashMap<String, Arc<ClassInfo>>,
+    traits: bool,
+) -> bool {
+    fn visit(
+        name: String,
+        loaded: &HashMap<String, Arc<ClassInfo>>,
+        active: &mut HashSet<String>,
+        done: &mut HashSet<String>,
+        depth: u32,
+        traits: bool,
+    ) -> bool {
+        if done.contains(&name) {
+            return true;
+        }
+        if depth > MAX_INHERITANCE_DEPTH + MAX_TRAIT_DEPTH || !active.insert(name.clone()) {
+            return false;
+        }
+        let Some(class) = loaded.get(&name) else {
+            return false;
+        };
+        for next in class
+            .parent_class
+            .iter()
+            .chain(class.used_traits.iter().filter(|_| traits))
+        {
+            if !visit(identity(next), loaded, active, done, depth + 1, traits) {
+                return false;
+            }
+        }
+        active.remove(&name);
+        done.insert(name);
+        true
+    }
+    visit(
+        identity(&root.fqn()),
+        loaded,
+        &mut HashSet::new(),
+        &mut HashSet::new(),
+        0,
+        traits,
+    )
+}
+
+fn trait_property_overlaps(
+    scope: &ClassInfo,
+    name: &str,
+    loader: &dyn Fn(&str) -> Option<Arc<ClassInfo>>,
+) -> bool {
+    let declares = |candidate: &ClassInfo| {
+        candidate
+            .get_property(name)
+            .is_some_and(|property| !property.is_virtual)
+    };
+    if crate::inheritance::find_declaring_trait(&scope.used_traits, loader, &declares).is_none() {
+        return false;
+    }
+    declares(scope)
+        || crate::inheritance::ancestors(scope, loader).any(|(_, parent)| {
+            declares(&parent)
+                || crate::inheritance::find_declaring_trait(&parent.used_traits, loader, &declares)
+                    .is_some()
+        })
+}
+
+fn trait_property_origins(
+    owner: Arc<ClassInfo>,
+    name: &str,
+    scopes: Vec<Arc<ClassInfo>>,
+    loader: &dyn Fn(&str) -> Option<Arc<ClassInfo>>,
+) -> Vec<Arc<ClassInfo>> {
+    let mut selected = vec![owner];
+    if selected[0].kind != ClassLikeKind::Trait {
+        return selected;
+    }
+    let owner_name = selected[0].fqn();
+    for scope in scopes {
+        if scope.get_property(name).is_some_and(|p| !p.is_virtual) {
+            continue;
+        }
+        let mut origins = Vec::new();
+        for used in &scope.used_traits {
+            if let Some((_, declared)) = crate::inheritance::find_declaring_trait(
+                std::slice::from_ref(used),
+                loader,
+                &|candidate| candidate.get_property(name).is_some_and(|p| !p.is_virtual),
+            ) {
+                origins.push(declared);
+            }
+        }
+        if origins
+            .iter()
+            .any(|candidate| candidate.fqn() == owner_name)
+        {
+            for origin in origins {
+                if !selected
+                    .iter()
+                    .any(|candidate| candidate.fqn() == origin.fqn())
+                {
+                    selected.push(origin);
+                }
+            }
+        }
+    }
+    selected
+}
+
+impl Backend {
+    fn kernel_source_syntax_valid(&self, uri: &str, content: &str) -> bool {
+        if self
+            .symbol_map_for(uri)
+            .is_some_and(|map| map.matches_source(content))
+        {
+            !self
+                .parse_errors
+                .read()
+                .get(uri)
+                .is_some_and(|errors| !errors.is_empty())
+        } else {
+            crate::parser::with_parsed_program(content, "kernel_alias_source", |program, _| {
+                program.errors.is_empty()
+            })
+        }
+    }
+
+    fn kernel_graph_sources_valid(
+        &self,
+        uri: &str,
+        content: &str,
+        root: &ClassInfo,
+        classes: Vec<Arc<ClassInfo>>,
+    ) -> bool {
+        let mut checked = HashSet::new();
+        for class in classes {
+            if !checked.insert(class.fqn()) {
+                continue;
+            }
+            let Some(source_uri) = (if class.fqn() == root.fqn() {
+                Some(uri.to_string())
+            } else {
+                self.find_class_file_uri_for_fqn(&class.fqn())
+            }) else {
+                return false;
+            };
+            if source_uri == uri {
+                if !self.kernel_source_syntax_valid(uri, content) {
+                    return false;
+                }
+            } else {
+                let Some(source) = self.get_file_content(&source_uri) else {
+                    return false;
+                };
+                if !self.kernel_source_syntax_valid(&source_uri, &source) {
+                    return false;
+                }
+            }
+        }
+        true
+    }
+
+    pub(crate) fn kernel_alias_sources(&self) -> Option<KernelAliasSources> {
+        let _foreign_scope = crate::type_engine::variable::forward_walk::suspend_diagnostic_scope();
+        let mut sources = KernelAliasSources {
+            origins: Vec::new(),
+            complete: true,
+        };
+        let Some(root) = self.workspace.workspace_root.read().clone() else {
+            return Some(sources);
+        };
+        let path = root.join("app/Http/Kernel.php");
+        let uri = crate::util::path_to_uri(&path);
+        let Some(content) = self.get_file_content(&uri) else {
+            return (!path.try_exists().unwrap_or(true)).then_some(sources);
+        };
+        sources.complete = self.kernel_source_syntax_valid(&uri, &content);
+        let context = self.source_file_context(&content);
+        let loaders = self.class_loaders(&context);
+        for class in &context.classes {
+            if class.kind != ClassLikeKind::Class {
+                continue;
+            }
+            let loaded = RefCell::new(HashMap::new());
+            loaded
+                .borrow_mut()
+                .insert(identity(&class.fqn()), Arc::clone(class));
+            let missing = Cell::new(false);
+            let base_loader = loaders.at(class.keyword_offset);
+            let loader = |name: &str| {
+                let value = base_loader(name);
+                if let Some(value) = &value {
+                    let mut entries = loaded.borrow_mut();
+                    entries.insert(identity(name), Arc::clone(value));
+                    entries.insert(identity(&value.fqn()), Arc::clone(value));
+                } else {
+                    missing.set(true);
+                }
+                value
+            };
+            if !crate::class_lookup::is_subtype_of(
+                class,
+                "Illuminate\\Foundation\\Http\\Kernel",
+                &loader,
+            ) {
+                if missing.get() || !complete_graph(class, &loaded.borrow(), false) {
+                    sources.complete = false;
+                }
+                continue;
+            }
+            let effective = crate::inheritance::resolve_class_with_inheritance(class, &loader);
+            let graph_complete = !missing.get()
+                && complete_graph(class, &loaded.borrow(), true)
+                && self.kernel_graph_sources_valid(
+                    &uri,
+                    &content,
+                    class,
+                    loaded.borrow().values().cloned().collect(),
+                );
+            sources.complete &= graph_complete;
+            // PHP requires overlapping trait properties to have compatible declarations
+            // and defaults. Do not authorize edits without proving that compatibility.
+            let scopes: Vec<_> = loaded.borrow().values().cloned().collect();
+            sources.complete &= !scopes.iter().any(|scope| {
+                ["middlewareAliases", "routeMiddleware"]
+                    .iter()
+                    .any(|name| trait_property_overlaps(scope, name, &loader))
+            });
+            for name in ["middlewareAliases", "routeMiddleware"] {
+                let Some(property) = effective.get_property(name) else {
+                    continue;
+                };
+                if property.is_virtual
+                    || property.is_static
+                    || property.visibility == Visibility::Private
+                    || property.name_offset == 0
+                {
+                    sources.complete = false;
+                    continue;
+                }
+                let declares = |candidate: &ClassInfo| {
+                    candidate.get_property(name).is_some_and(|p| {
+                        !p.is_virtual
+                            && p.name_offset == property.name_offset
+                            && p.source == property.source
+                    })
+                };
+                let own = declares(class);
+                let owner = if own {
+                    Arc::clone(class)
+                } else {
+                    let Some((_, owner)) =
+                        crate::inheritance::find_declaring_ancestor(class, &loader, &declares)
+                    else {
+                        sources.complete = false;
+                        continue;
+                    };
+                    owner
+                };
+                // Unknown higher-priority declarations cannot authorize inherited navigation.
+                if !own && !graph_complete {
+                    continue;
+                }
+                let snapshot = loaded.borrow().values().cloned().collect();
+                let owners = trait_property_origins(owner, name, snapshot, &loader);
+                if owners.len() > 1 {
+                    sources.complete = false;
+                }
+                for owner in owners {
+                    if !matches!(owner.kind, ClassLikeKind::Class | ClassLikeKind::Trait) {
+                        sources.complete = false;
+                        continue;
+                    }
+                    let offset = owner
+                        .get_property(name)
+                        .map_or(0, |property| property.name_offset);
+                    let owner_uri = if own {
+                        Some(uri.clone())
+                    } else {
+                        self.find_class_file_uri_for_fqn(&owner.fqn())
+                    };
+                    let Some(owner_uri) = owner_uri else {
+                        sources.complete = false;
+                        continue;
+                    };
+                    if offset == 0 {
+                        sources.complete = false;
+                        continue;
+                    }
+                    if !sources.origins.iter().any(|origin| {
+                        origin.uri == owner_uri && origin.declaration_offset == offset
+                    }) {
+                        sources.origins.push(KernelAliasOrigin {
+                            uri: owner_uri,
+                            declaration_offset: offset,
+                        });
+                    }
+                }
+            }
+        }
+        Some(sources)
+    }
+
+    pub(crate) fn confirmed_kernel_alias_site(
+        &self,
+        uri: &str,
+        map: &crate::symbol_map::SymbolMap,
+        site: &crate::symbol_map::ViewReceiverSite,
+        writer: bool,
+        sources: &KernelAliasSources,
+    ) -> bool {
+        if writer && !sources.complete {
+            return false;
+        }
+        map.middleware_alias_targets.iter().any(|target| {
+            target.receiver
+                == crate::symbol_map::ViewReceiverClass::KernelMiddlewareAliasDeclaration
+                && if writer {
+                    target
+                        .target_value_span
+                        .is_some_and(|span| span.0 == site.start)
+                } else {
+                    target.start == site.start
+                }
+                && target.declaration_offset.is_some_and(|offset| {
+                    sources
+                        .origins
+                        .iter()
+                        .any(|origin| origin.uri == uri && origin.declaration_offset == offset)
+                })
+        })
+    }
+}

+                initialization_options: Some(json!({"phpLanguageLevel":"8.1"})),
+                ..Default::default()
+            })
+            .await
+            .unwrap();
+        for worker in [
+            backend.clone_for_blocking(),
+            backend.clone_for_diagnostic_worker(),
+        ] {
+            assert_eq!(worker.client_language_level(), Some(PhpVersion::new(8, 1)));
+            assert!(std::sync::Arc::ptr_eq(
+                &backend.workspace.client_language_level,
+                &worker.workspace.client_language_level
+            ));
+        }
+    }

+#[tokio::test]
+async fn client_language_level_survives_global_profile_version_and_extension_refresh() {
+    let f = Fixture::new_with_options(
+        "[php]\nversion='8.4'\nextensions=['core','standard']\n",
+        "",
+        true,
+        "[php]\nversion='8.5'\n",
+        Some(serde_json::json!({"phpLanguageLevel":"8.1"})),
+    )
+    .await;
+    let mut seen = Inputs::new();
+    assert!(!f.apply(&mut seen).await);
+    let before = f.router.state.contexts.read()[0].id;
+    assert_eq!(f.target().await.php_version, "8.1");
+    std::fs::write(
+        &f.global,
+        "[php]\nversion='8.5'\nextensions=['core','standard']\n",
+    )
+    .unwrap();
+    assert!(!f.apply(&mut seen).await);
+    assert_eq!(
+        f.router.state.contexts.read()[0].id,
+        before,
+        "shadowed saved version must not replace the applied service"
+    );
+    assert_eq!(f.target().await.php_version, "8.1");
+    std::fs::write(&f.global, "[php]\nversion='8.4'\nextensions=['core']\n").unwrap();
+    assert!(!f.apply(&mut seen).await);
+    assert_ne!(
+        f.router.state.contexts.read()[0].id,
+        before,
+        "extension changes still rebuild the target"
+    );
+    for context in f.router.state.contexts.read().iter() {
+        assert_eq!(
+            context.backend.php_version(),
+            crate::types::PhpVersion::new(8, 1)
+        );
+    }
+    let target = f.target().await;
+    assert_eq!(target.php_version, "8.1");
+    assert_eq!(target.extensions, Some(vec!["core".into()]));
+    f.router.shutdown().await.unwrap();
+}

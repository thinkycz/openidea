+/// Initialization option advertised for an explicit editor language-level selection.
+pub(crate) const CLIENT_LEVEL_CAPABILITY: &str = "phpWorkbenchLanguageLevel";
+
+/// One literal editor selection. Auto keeps the existing saved/Composer policy.
+pub(crate) fn client_language_level(
+    options: Option<&serde_json::Value>,
+) -> Result<Option<PhpVersion>> {
+    let value = options.and_then(|options| options.get("phpLanguageLevel"));
+    let Some(value) = value.filter(|value| !value.is_null()) else {
+        return Ok(None);
+    };
+    let invalid = || {
+        Error::invalid_params(
+            "phpLanguageLevel must be one PHP version (X.Y or X.Y.Z), or empty for Auto",
+        )
+    };
+    let text = value.as_str().ok_or_else(invalid)?.trim();
+    if text.is_empty() {
+        return Ok(None);
+    }
+    if text.len() > 32 {
+        return Err(invalid());
+    }
+    let mut parts = text.split('.');
+    let component = |value: Option<&str>| {
+        value
+            .filter(|part| !part.is_empty() && part.bytes().all(|byte| byte.is_ascii_digit()))
+            .and_then(|part| part.parse::<u8>().ok())
+            .ok_or_else(invalid)
+    };
+    let major = component(parts.next())?;
+    let minor = component(parts.next())?;
+    let patch_valid = parts.next().is_none_or(|patch| {
+        !patch.is_empty()
+            && patch.bytes().all(|byte| byte.is_ascii_digit())
+            && patch.parse::<u32>().is_ok()
+    });
+    if major == 0 || !patch_valid || parts.next().is_some() {
+        return Err(invalid());
+    }
+    Ok(Some(PhpVersion::new(major, minor)))
 }
 

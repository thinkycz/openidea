+#[cfg(test)]
+mod client_language_level_tests {
+    use super::*;
+    use serde_json::json;
+    #[test]
+    fn client_language_level_literals_auto_and_invalid_are_distinct() {
+        for value in [serde_json::Value::Null, json!(""), json!("  ")] {
+            assert_eq!(
+                client_language_level(Some(&json!({"phpLanguageLevel":value}))).unwrap(),
+                None
+            );
+        }
+        assert_eq!(client_language_level(None).unwrap(), None);
+        for value in ["8.1", "8.1.99", " 8.1.0 "] {
+            assert_eq!(
+                client_language_level(Some(&json!({"phpLanguageLevel":value}))).unwrap(),
+                Some(PhpVersion::new(8, 1))
+            );
+        }
+        for value in [
+            json!(true),
+            json!(81),
+            json!([]),
+            json!({}),
+            json!("^8.1"),
+            json!("8"),
+            json!("8.1.2.3"),
+            json!("8.-1"),
+            json!("0.1"),
+            json!("8.1 \n secret-value"),
+            json!("8.1.4294967296"),
+        ] {
+            let error =
+                client_language_level(Some(&json!({"phpLanguageLevel":value}))).unwrap_err();
+            assert_eq!(error.code, tower_lsp::jsonrpc::ErrorCode::InvalidParams);
+            assert!(!error.message.contains("secret-value"));
+        }
+    }
+    #[tokio::test]
+    async fn client_language_level_worker_clones_share_initialized_choice() {
+        let backend = Backend::new_test();
+        backend

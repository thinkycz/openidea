+//! Bootstrap HTTP Kernel bindings, resolved without executing application code.
+use std::{collections::HashMap, ops::ControlFlow};
+
+use mago_span::HasSpan;
+use mago_syntax::cst::*;
+
+use super::{
+    const_eval::{Scope, const_string},
+    provider_resources::{class_string_fqn, resolved_class_fqn},
+};
+use crate::type_engine::resolver::{Loaders, VarResolutionCtx};
+use crate::{Backend, atom::bytes_to_str, types::ClassInfo};
+
+const CONTRACT: &str = "Illuminate\\Contracts\\Http\\Kernel";
+const APPLICATION: &str = "Illuminate\\Foundation\\Application";
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum KernelRoot {
+    Conventional,
+    Bound(String),
+}
+
+#[derive(Default)]
+pub(crate) struct KernelSelection {
+    pub roots: Vec<KernelRoot>,
+    pub complete: bool,
+}
+impl KernelSelection {
+    fn conventional(complete: bool) -> Self {
+        Self {
+            roots: vec![KernelRoot::Conventional],
+            complete,
+        }
+    }
+    fn uncertain(&mut self, target: Option<String>) {
+        self.complete = false;
+        if let Some(target) = target {
+            let root = KernelRoot::Bound(target);
+            if !self.roots.contains(&root) {
+                self.roots.push(root);
+            }
+        }
+    }
+}
+
+#[derive(Default)]
+struct TopLevel {
+    direct: HashMap<(u32, u32), bool>,
+    returned: Option<(Option<String>, u32)>,
+    limit: Option<u32>,
+    certain: bool,
+}
+fn unwrapped<'a>(mut expr: &'a Expression<'a>) -> &'a Expression<'a> {
+    while let Expression::Parenthesized(inner) = expr {
+        expr = inner.expression;
+    }
+    expr
+}
+fn variable(expr: &Expression<'_>) -> Option<String> {
+    match unwrapped(expr) {
+        Expression::Variable(Variable::Direct(var)) => Some(bytes_to_str(var.name).to_owned()),
+        _ => None,
+    }
+}
+fn span(expr: &Expression<'_>) -> (u32, u32) {
+    (expr.span().start.offset, expr.span().end.offset)
+}
+impl TopLevel {
+    fn statements<'a>(&mut self, statements: impl Iterator<Item = &'a Statement<'a>>) {
+        for statement in statements {
+            if self.returned.is_some() {
+                break;
+            }
+            match statement {
+                Statement::Namespace(ns) => self.statements(ns.statements().iter()),
+                Statement::Block(block) => self.statements(block.statements.iter()),
+                Statement::Declare(declare) => match &declare.body {
+                    DeclareBody::Statement(statement) => {
+                        self.statements(std::iter::once(*statement))
+                    }
+                    DeclareBody::ColonDelimited(body) => self.statements(body.statements.iter()),
+                },
+                Statement::Expression(statement) => {
+                    self.direct
+                        .insert(span(unwrapped(statement.expression)), self.certain);
+                }
+                Statement::Return(ret) => {
+                    self.returned = Some((ret.value.and_then(variable), ret.span().start.offset));
+                    self.limit = Some(ret.span().end.offset);
+                }
+                Statement::OpeningTag(_)
+                | Statement::ClosingTag(_)
+                | Statement::Inline(_)
+                | Statement::Use(_)
+                | Statement::Class(_)
+                | Statement::Interface(_)
+                | Statement::Trait(_)
+                | Statement::Enum(_)
+                | Statement::Function(_)
+                | Statement::Constant(_)
+                | Statement::Noop(_) => {}
+                _ => self.certain = false,
+            }
+        }
+    }
+}
+fn in_callable(node: Node<'_, '_>, at: u32) -> bool {
+    let span = node.span();
+    if at < span.start.offset || at >= span.end.offset {
+        return false;
+    }
+    if matches!(
+        node,
+        Node::Function(_) | Node::Method(_) | Node::Closure(_) | Node::ArrowFunction(_)
+    ) {
+        return true;
+    }
+    let mut found = false;
+    node.visit_children(|child| {
+        if !found {
+            found = in_callable(child, at);
+        }
+    });
+    found
+}
+
+struct AssignmentSite {
+    name: String,
+    at: u32,
+    origin: u32,
+    alias: Option<String>,
+    certain: bool,
+}
+fn origin(name: &str, before: u32, sites: &[AssignmentSite], depth: usize) -> Option<u32> {
+    if depth > 64 || depth > sites.len() {
+        return None;
+    }
+    let site = sites
+        .iter()
+        .filter(|site| site.name == name && site.at < before)
+        .max_by_key(|site| site.at)?;
+    if !site.certain {
+        return None;
+    }
+    match &site.alias {
+        Some(alias) => origin(alias, site.at, sites, depth + 1),
+        None => Some(site.origin),
+    }
+}
+struct BindingCall {
+    receiver: Option<String>,
+    at: u32,
+    target: Option<String>,
+    certain: bool,
+    proven: bool,
+}
+fn argument<'a>(
+    args: &'a ArgumentList<'a>,
+    index: usize,
+    name: &[u8],
+) -> Option<&'a Expression<'a>> {
+    let mut value = None;
+    for (position, arg) in args.arguments.iter().enumerate() {
+        let candidate = match arg {
+            Argument::Positional(arg) => {
+                if arg.ellipsis.is_some() {
+                    return None;
+                }
+                (position == index).then_some(arg.value)
+            }
+            Argument::Named(arg) => (arg.name.value == name).then_some(arg.value),
+        };
+        if let Some(candidate) = candidate {
+            if value.is_some() {
+                return None;
+            }
+            value = Some(candidate);
+        }
+    }
+    value
+}
+
+impl Backend {
+    /// Follow bootstrap bindings of the returned Application, preserving uncertain alternatives.
+    pub(crate) fn bootstrap_kernel_selection(&self) -> KernelSelection {
+        let Some(root) = self.workspace.workspace_root.read().clone() else {
+            return KernelSelection::conventional(true);
+        };
+        let path = root.join("bootstrap/app.php");
+        let uri = crate::util::path_to_uri(&path);
+        let Some(content) = self.get_file_content(&uri) else {
+            return KernelSelection::conventional(!path.try_exists().unwrap_or(true));
+        };
+        let _parse = crate::parser::with_parse_cache(&content);
+        let context = self.source_file_context(&content);
+        let Some(names) = context.resolved_names.as_deref() else {
+            return KernelSelection::conventional(false);
+        };
+        let classes = self.class_loaders(&context);
+        let functions = self.function_loaders(&context);
+        let default_class = ClassInfo::default();
+        crate::parser::with_parsed_program(&content, "kernel_binding", |program, content| {
+            let mut top = TopLevel {
+                certain: true,
+                ..Default::default()
+            };
+            top.statements(program.statements.iter());
+            let mut assignments = Vec::new();
+            let mut calls = Vec::new();
+            super::helpers::walk_program_expressions(program, &mut |expr| {
+                let at = expr.span().start.offset;
+                if top.limit.is_some_and(|limit| at >= limit) {
+                    return ControlFlow::Continue(());
+                }
+                if !in_callable(Node::Program(program), at)
+                    && let Expression::Assignment(assign) = expr
+                    && let Some(name) = variable(assign.lhs)
+                {
+                    assignments.push(AssignmentSite {
+                        name,
+                        at,
+                        origin: assign.rhs.span().start.offset,
+                        alias: variable(assign.rhs),
+                        certain: top.direct.get(&span(expr)).copied().unwrap_or(false)
+                            && matches!(assign.operator, AssignmentOperator::Assign(_)),
+                    });
+                }
+                let Expression::Call(Call::Method(call)) = expr else {
+                    return ControlFlow::Continue(());
+                };
+                let ClassLikeMemberSelector::Identifier(method) = &call.method else {
+                    return ControlFlow::Continue(());
+                };
+                let method = method.value.to_ascii_lowercase();
+                if ![
+                    b"bind".as_slice(),
+                    b"singleton",
+                    b"scoped",
+                    b"instance",
+                    b"bindif",
+                    b"singletonif",
+                    b"scopedif",
+                    b"extend",
+                ]
+                .contains(&method.as_slice())
+                {
+                    return ControlFlow::Continue(());
+                }
+                let key = argument(&call.argument_list, 0, b"abstract").and_then(|expr| {
+                    class_string_fqn(unwrapped(expr), names)
+                        .or_else(|| const_string(expr, content, &Scope::default()))
+                });
+                if key.as_deref().is_some_and(|key| key != CONTRACT) {
+                    return ControlFlow::Continue(());
+                }
+                let class_loader = classes.at(call.object.span().start.offset);
+                let function_loader = functions.at(at);
+                let function_loader = |name: &str, offset: u32| function_loader(name, offset);
+                let current = crate::class_lookup::find_class_at_offset(&context.classes, at)
+                    .unwrap_or(&default_class);
+                let ctx = VarResolutionCtx {
+                    backend: Some(self),
+                    loaders: Loaders::with_function(Some(&function_loader)),
+                    resolved_class_cache: Some(&self.resolved_class_cache),
+                    ..VarResolutionCtx::new(
+                        "",
+                        current,
+                        &context.classes,
+                        content,
+                        at,
+                        class_loader,
+                    )
+                };
+                let ty = crate::type_engine::variable::foreach_resolution::resolve_expression_type(
+                    call.object,
+                    &ctx,
+                );
+                let proven = ty.as_ref().is_some_and(|ty| {
+                    crate::class_lookup::is_subtype_of_named(ty, APPLICATION, class_loader)
+                });
+                if !proven
+                    && ty
+                        .as_ref()
+                        .and_then(|ty| ty.base_name())
+                        .and_then(class_loader)
+                        .is_some()
+                {
+                    return ControlFlow::Continue(());
+                }
+                let value = argument(
+                    &call.argument_list,
+                    1,
+                    if method == b"instance" {
+                        b"instance"
+                    } else {
+                        b"concrete"
+                    },
+                );
+                let target = value.and_then(|value| {
+                    let value = unwrapped(value);
+                    if method == b"instance" {
+                        if let Expression::Instantiation(inst) = value
+                            && let Expression::Identifier(id) = inst.class
+                        {
+                            return resolved_class_fqn(id, names);
+                        }
+                        return None;
+                    }
+                    class_string_fqn(value, names)
+                        .or_else(|| const_string(value, content, &Scope::default()))
+                });
+                calls.push(BindingCall {
+                    receiver: (!in_callable(Node::Program(program), at))
+                        .then(|| variable(call.object))
+                        .flatten(),
+                    at,
+                    target,
+                    certain: top.direct.get(&span(expr)).copied().unwrap_or(false)
+                        && key.as_deref() == Some(CONTRACT)
+                        && [b"bind".as_slice(), b"singleton", b"scoped", b"instance"]
+                            .contains(&method.as_slice()),
+                    proven,
+                });
+                ControlFlow::Continue(())
+            });
+            let returned = top.returned.as_ref().and_then(|(name, at)| {
+                name.as_deref()
+                    .and_then(|name| origin(name, *at, &assignments, 0))
+            });
+            calls.sort_by_key(|call| call.at);
+            let mut selection = KernelSelection::conventional(program.errors.is_empty());
+            for call in calls {
+                let owner = call
+                    .receiver
+                    .as_deref()
+                    .and_then(|name| origin(name, call.at, &assignments, 0));
+                if owner.is_some() && returned.is_some() && owner != returned {
+                    continue;
+                }
+                if owner.is_some() && owner == returned && call.certain && !call.proven {
+                    selection.roots.clear();
+                    selection.complete = false;
+                    continue;
+                }
+                if owner.is_none() || returned.is_none() || !call.proven || !call.certain {
+                    selection.uncertain(call.target);
+                } else {
+                    selection.roots = call.target.map(KernelRoot::Bound).into_iter().collect();
+                    selection.complete =
+                        !selection.roots.is_empty() && program.errors.is_empty() && top.certain;
+                }
+            }
+            selection
+        })
+    }
+}

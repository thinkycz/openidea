+#[tokio::test]
+async fn bound_kernel_bootstrap_checked_rename_updates_the_selected_import() {
+    let (backend, dir, _, conventional) = bound_kernel_workspace(BOUND_BOOTSTRAP, &[]).await;
+    let path = dir.path().join("app/Http/Middleware/Trace.php");

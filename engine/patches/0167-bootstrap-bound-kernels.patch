+#[tokio::test]
+async fn bound_kernel_bootstrap_unknown_targets_cannot_restore_conventional_origins() {
+    for target in [
+        "$unknown",
+        "fn()=>new ProjectKernel",
+        "\\App\\Runtime\\MissingKernel::class",
+    ] {
+        let bootstrap = BOUND_BOOTSTRAP.replace("ProjectKernel::class", target);
+        let (backend, dir, route, _) = bound_kernel_workspace(&bootstrap, &[]).await;
+        assert!(
+            definitions(&backend, &route, SOURCE, "middleware('aud")
+                .await
+                .is_empty(),
+            "{target}"
+        );
+        let path = dir.path().join("app/Http/Middleware/Trace.php");
+        let text = std::fs::read_to_string(&path).unwrap();
+        let uri = Url::from_file_path(path).unwrap();
+        open_document(&backend, &uri, "php", &text).await;
+        let result = settled_target_rename(&backend, &uri, &text, "class Tra", "Traced").await;
+        assert!(
+            result.is_err(),
+            "unresolved active Kernel cannot authorize edits: {result:?}"
+        );
+    }
+}

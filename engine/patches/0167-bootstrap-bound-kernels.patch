+#[tokio::test]
+async fn bound_kernel_bootstrap_dirty_switch_retires_inactive_receiver_caches() {
+    let next = SITE_KERNEL
+        .replace("SiteKernel", "NextKernel")
+        .replace("Middleware\\Trace", "Middleware\\Audit");
+    let (backend, dir, route, conventional) =
+        bound_kernel_workspace(BOUND_BOOTSTRAP, &[("app/Runtime/NextKernel.php", &next)]).await;
+    let next_uri = Url::from_file_path(dir.path().join("app/Runtime/NextKernel.php")).unwrap();
+    open_document(&backend, &next_uri, "php", &next).await;
+    let _ = hover(&backend, &next_uri, &next, "\"au").await;
+    assert_bound_kernel(&backend, dir.path(), &route, "app/Runtime/SiteKernel.php").await;
+    let bootstrap_uri = Url::from_file_path(dir.path().join("bootstrap/app.php")).unwrap();
+    open_document(&backend, &bootstrap_uri, "php", BOUND_BOOTSTRAP).await;
+    let changed = BOUND_BOOTSTRAP.replace("SiteKernel as", "NextKernel as");
+    assert_eq!(changed.len(), BOUND_BOOTSTRAP.len());
+    backend
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: bootstrap_uri.clone(),
+                version: 2,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: changed,
+            }],
+        })
+        .await;
+    assert_bound_kernel(&backend, dir.path(), &route, "app/Runtime/NextKernel.php").await;
+    let refs = find_references(
+        &backend,
+        &route,
+        position_after(SOURCE, "middleware('aud"),
+        true,
+    )
+    .await;
+    assert!(
+        !refs.iter().any(|reference| reference.uri == conventional
+            || reference.uri.path().ends_with("SiteKernel.php")),
+        "{refs:?}"
+    );
+    backend
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: bootstrap_uri,
+                version: 3,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: BOUND_BOOTSTRAP.into(),
+            }],
+        })
+        .await;
+    assert_bound_kernel(&backend, dir.path(), &route, "app/Runtime/SiteKernel.php").await;
+    assert_eq!(
+        std::fs::read_to_string(dir.path().join("bootstrap/app.php")).unwrap(),
+        BOUND_BOOTSTRAP
+    );
+}

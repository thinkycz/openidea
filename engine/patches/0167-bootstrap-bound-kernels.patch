+#[tokio::test]
+async fn bound_kernel_bootstrap_tracks_object_aliases_and_ignores_other_applications() {
+    for prefix in [
+        "$alias=$app; $alias->singleton(HttpKernel::class,ProjectKernel::class);",
+        "$other=new \\Illuminate\\Foundation\\Application; $other->singleton(HttpKernel::class,\\App\\Http\\Kernel::class); $app->singleton(HttpKernel::class,ProjectKernel::class);",
+        "$app->singleton(HttpKernel::class,\\App\\Http\\Kernel::class); $app=new \\Illuminate\\Foundation\\Application; $app->singleton(HttpKernel::class,ProjectKernel::class);",
+        "$app->singleton(HttpKernel::class,ProjectKernel::class); $other=new \\Illuminate\\Foundation\\Application; $other->singleton(HttpKernel::class,\\App\\Http\\Kernel::class);",
+    ] {
+        let bootstrap = BOUND_BOOTSTRAP.replace(
+            "$app->singleton(HttpKernel::class, ProjectKernel::class);",
+            prefix,
+        );
+        let (backend, dir, route, _) = bound_kernel_workspace(&bootstrap, &[]).await;
+        assert_bound_kernel(&backend, dir.path(), &route, "app/Runtime/SiteKernel.php").await;
+    }
+}

+const BOUND_BOOTSTRAP: &str = r#"<?php
+use Illuminate\Contracts\Http\Kernel as HttpKernel;
+use App\Runtime\SiteKernel as ProjectKernel;
+$app = new \Illuminate\Foundation\Application;
+$app->singleton(HttpKernel::class, ProjectKernel::class);
+return $app;
+"#;
+const SITE_KERNEL: &str = r#"<?php
+namespace App\Runtime;
+use App\Http\Middleware\Trace as BoundTarget;
+class SiteKernel extends \Illuminate\Foundation\Http\Kernel {
+    protected $middlewareAliases = [/* 😀 */ "au\x64ited" => BoundTarget::class];
+}
+"#;
+
+async fn bound_kernel_workspace(
+    bootstrap: &str,
+    extra: &[(&str, &str)],
+) -> (Backend, tempfile::TempDir, Url, Url) {
+    let arena = mago_allocator::LocalArena::new();
+    let parsed = mago_syntax::parser::parse_file_content(
+        &arena,
+        mago_database::file::FileId::new(b"bootstrap.php"),
+        bootstrap.as_bytes(),
+    );
+    assert!(
+        parsed.errors.is_empty(),
+        "bootstrap fixture syntax: {:?}\n{bootstrap}",
+        parsed.errors
+    );
+    let mut files = vec![
+        ("bootstrap/app.php", bootstrap),
+        ("app/Runtime/SiteKernel.php", SITE_KERNEL),
+        (
+            "framework/Contracts/Http/Kernel.php",
+            "<?php namespace Illuminate\\Contracts\\Http; interface Kernel {}",
+        ),
+        (
+            "framework/Foundation/Application.php",
+            "<?php namespace Illuminate\\Foundation; class Application {public function bind($abstract,$concrete=null,$shared=false): void {} public function singleton($abstract,$concrete=null): void {} public function scoped($abstract,$concrete=null): void {} public function instance($abstract,$instance): object {return $instance;}}",
+        ),
+    ];
+    files.extend_from_slice(extra);
+    kernel_workspace_extra(KERNEL, &files).await
+}
+
+async fn assert_bound_kernel(
+    backend: &Backend,
+    dir: &std::path::Path,
+    route: &Url,
+    relative: &str,
+) {
+    let found = definitions(backend, route, SOURCE, "middleware('aud").await;
+    assert_eq!(found.len(), 1, "bound Kernel alias: {found:?}");
+    assert_eq!(
+        found[0].uri,
+        Url::from_file_path(dir.join(relative)).unwrap()
+    );
+    let detail = hover(backend, route, SOURCE, "middleware('aud").await;
+    assert!(detail.contains(relative), "{detail}");
+}
+
+#[tokio::test]
+async fn bound_kernel_bootstrap_literal_bindings_select_only_the_bound_declaration() {
+    for call in [
+        "$app->bind(HttpKernel::class, ProjectKernel::class);",
+        "$app->singleton(HttpKernel::class, ProjectKernel::class);",
+        "$app->scoped(concrete: ProjectKernel::class, abstract: HttpKernel::class);",
+        "$app->instance(HttpKernel::class, new ProjectKernel);",
+        "$app->singleton('Illuminate\\\\Contracts\\\\Http\\\\Kernel', 'App\\\\Runtime\\\\SiteKernel');",
+    ] {
+        let bootstrap = BOUND_BOOTSTRAP.replace(
+            "$app->singleton(HttpKernel::class, ProjectKernel::class);",
+            call,
+        );
+        let (backend, dir, route, conventional) = bound_kernel_workspace(&bootstrap, &[]).await;
+        assert_bound_kernel(&backend, dir.path(), &route, "app/Runtime/SiteKernel.php").await;
+        let detail = hover(&backend, &route, SOURCE, "middleware('aud").await;
+        assert!(
+            detail.contains("Middleware\\Trace") && !detail.contains("Middleware\\Audit"),
+            "{detail}"
+        );
+        let references = find_references(
+            &backend,
+            &route,
+            position_after(SOURCE, "middleware('aud"),
+            true,
+        )
+        .await;
+        assert!(
+            !references
+                .iter()
+                .any(|reference| reference.uri == conventional),
+            "{references:?}"
+        );
+        let selected = references
+            .iter()
+            .find(|reference| reference.uri.path().ends_with("SiteKernel.php"))
+            .unwrap();
+        assert_eq!(
+            selected.range.end.character - selected.range.start.character,
+            10
+        );
+    }
+}

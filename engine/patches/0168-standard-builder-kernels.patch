+#[tokio::test]
+async fn builder_kernel_factory_uses_the_registered_framework_kernel() {
+    for bootstrap in [
+        r"<?php return \Illuminate\Foundation\Application::configure()->create();",
+        r"<?php use Illuminate\Foundation\Application as App; $application=App::configure()->create(); return $application;",
+        r"<?php $application=(\Illuminate\Foundation\Application::configure()->create()); $alias=$application; return $alias;",

+//! Initial HTTP Kernel registration by Laravel's standard application builder.
+use mago_syntax::cst::*;
+
+use super::kernel_binding::{KernelRoot, KernelSelection, argument, unwrapped};
+use super::provider_resources::{class_string_fqn, resolved_class_fqn};
+use crate::{Backend, names::OwnedResolvedNames};
+
+const APPLICATION: &str = "Illuminate\\Foundation\\Application";
+const BUILDER: &str = "Illuminate\\Foundation\\Configuration\\ApplicationBuilder";
+const CONTRACT: &str = "Illuminate\\Contracts\\Http\\Kernel";
+
+fn class_at<'ast, 'arena>(node: Node<'ast, 'arena>, offset: u32) -> Option<&'ast Class<'arena>> {
+    if let Node::Class(class) = node
+        && class.class.span.start.offset == offset
+    {
+        return Some(class);
+    }
+    let mut found = None;
+    node.visit_children(|child| {
+        if found.is_none() {
+            found = class_at(child, offset);
+        }
+    });
+    found
+}
+fn method<'a>(class: &'a Class<'a>, name: &[u8]) -> Option<&'a Block<'a>> {
+    class.members.iter().find_map(|member| match member {
+        ClassLikeMember::Method(method) if method.name.value.eq_ignore_ascii_case(name) => {
+            match &method.body {
+                MethodBody::Concrete(body) => Some(body),
+                _ => None,
+            }
+        }
+        _ => None,
+    })
+}
+fn is_variable(expr: &Expression<'_>, name: &[u8]) -> bool {
+    matches!(unwrapped(expr), Expression::Variable(Variable::Direct(variable)) if variable.name==name)
+}
+fn app_property(expr: &Expression<'_>) -> bool {
+    matches!(unwrapped(expr), Expression::Access(Access::Property(property)) if is_variable(property.object,b"$this") && matches!(&property.property,ClassLikeMemberSelector::Identifier(name) if name.value==b"app"))
+}
+fn configure_returns_builder(expr: &Expression<'_>, names: &OwnedResolvedNames) -> bool {
+    let mut current = unwrapped(expr);
+    let mut kernels = false;
+    while let Expression::Call(Call::Method(call)) = current {
+        let ClassLikeMemberSelector::Identifier(name) = &call.method else {
+            return false;
+        };
+        if ![
+            b"withkernels".as_slice(),
+            b"withevents",
+            b"withcommands",
+            b"withproviders",
+        ]
+        .iter()
+        .any(|known| name.value.eq_ignore_ascii_case(known))
+            || !call.argument_list.arguments.is_empty()
+        {
+            return false;
+        }
+        kernels |= name.value.eq_ignore_ascii_case(b"withKernels");
+        current = unwrapped(call.object);
+    }
+    let Expression::Instantiation(instance) = current else {
+        return false;
+    };
+    if !kernels {
+        return false;
+    }
+    match unwrapped(instance.class) {
+        Expression::Identifier(name) => {
+            resolved_class_fqn(name, names).is_some_and(|name| name.eq_ignore_ascii_case(BUILDER))
+        }
+        Expression::Access(Access::StaticProperty(property)) => {
+            matches!(
+                unwrapped(property.class),
+                Expression::Static(_) | Expression::Self_(_)
+            ) && matches!(&property.property,Variable::Direct(name) if name.name==b"$applicationBuilder")
+        }
+        _ => false,
+    }
+}
+
+impl Backend {
+    pub(super) fn configured_kernel_factory(
+        &self,
+        expr: &Expression<'_>,
+        names: &OwnedResolvedNames,
+    ) -> Option<KernelSelection> {
+        let Expression::Call(Call::Method(create)) = unwrapped(expr) else {
+            return None;
+        };
+        if !matches!(&create.method,ClassLikeMemberSelector::Identifier(name) if name.value.eq_ignore_ascii_case(b"create"))
+        {
+            return None;
+        }
+        let mut known = create.argument_list.arguments.is_empty();
+        let mut current = unwrapped(create.object);
+        while let Expression::Call(Call::Method(call)) = current {
+            known &= matches!(&call.method,ClassLikeMemberSelector::Identifier(name) if [b"withkernels".as_slice(),b"withevents",b"withcommands",b"withproviders",b"withrouting",b"withmiddleware",b"withexceptions",b"withbindings",b"withsingletons",b"withscopedsingletons",b"registered",b"withschedule",b"withcommandrouting"].iter().any(|known|name.value.eq_ignore_ascii_case(known)));
+            current = unwrapped(call.object);
+        }
+        let Expression::Call(Call::StaticMethod(configure)) = current else {
+            return Some(KernelSelection::default());
+        };
+        if !matches!(&configure.method,ClassLikeMemberSelector::Identifier(name) if name.value.eq_ignore_ascii_case(b"configure"))
+        {
+            return None;
+        }
+        let Expression::Identifier(class) = unwrapped(configure.class) else {
+            return None;
+        };
+        let fqn = resolved_class_fqn(class, names)?;
+        if !fqn.eq_ignore_ascii_case(APPLICATION) || !known {
+            return Some(KernelSelection::default());
+        }
+        Some(self.standard_builder_kernel())
+    }
+
+    fn standard_builder_kernel(&self) -> KernelSelection {
+        let Some(application) = self.find_or_load_class(APPLICATION) else {
+            return KernelSelection::default();
+        };
+        let Some(uri) = self.find_class_file_uri_for_fqn(APPLICATION) else {
+            return KernelSelection::default();
+        };
+        let Some(source) = self.get_file_content(&uri) else {
+            return KernelSelection::default();
+        };
+        let _parse = crate::parser::with_parse_cache(&source);
+        let context = self.source_file_context(&source);
+        let Some(names) = context.resolved_names.as_deref() else {
+            return KernelSelection::default();
+        };
+        let offset = context
+            .classes
+            .iter()
+            .find(|class| class.fqn().eq_ignore_ascii_case(&application.fqn()))
+            .map(|class| class.keyword_offset);
+        let valid = crate::parser::with_parsed_program(
+            &source,
+            "application_kernel_builder",
+            |program, _| {
+                let Some(class) =
+                    offset.and_then(|offset| class_at(Node::Program(program), offset))
+                else {
+                    return false;
+                };
+                if !program.errors.is_empty() {
+                    return false;
+                }
+                let mut builder = None;
+                for member in class.members.iter() {
+                    if let ClassLikeMember::Property(Property::Plain(property)) = member {
+                        for item in property.items.iter() {
+                            if let PropertyItem::Concrete(property) = item
+                                && property.variable.name == b"$applicationBuilder"
+                            {
+                                if builder.is_some() {
+                                    return false;
+                                }
+                                builder = class_string_fqn(unwrapped(property.value), names);
+                            }
+                        }
+                    }
+                }
+                if !builder.is_some_and(|builder| builder.eq_ignore_ascii_case(BUILDER)) {
+                    return false;
+                }
+                let Some(body) = method(class, b"configure") else {
+                    return false;
+                };
+                let mut returned = false;
+                for statement in body.statements.iter() {
+                    match statement {
+                        Statement::Expression(statement)
+                            if !returned
+                                && matches!(unwrapped(statement.expression),Expression::Assignment(assignment) if is_variable(assignment.lhs,b"$basePath")) =>
+                            {}
+                        Statement::Return(statement) if !returned => {
+                            returned = statement
+                                .value
+                                .is_some_and(|expr| configure_returns_builder(expr, names));
+                            if !returned {
+                                return false;
+                            }
+                        }
+                        Statement::Noop(_) => {}
+                        _ => return false,
+                    }
+                }
+                returned
+            },
+        );
+        if !valid {
+            return KernelSelection::default();
+        }
+        let Some(_builder) = self.find_or_load_class(BUILDER) else {
+            return KernelSelection::default();
+        };
+        let Some(uri) = self.find_class_file_uri_for_fqn(BUILDER) else {
+            return KernelSelection::default();
+        };
+        let Some(source) = self.get_file_content(&uri) else {
+            return KernelSelection::default();
+        };
+        let _parse = crate::parser::with_parse_cache(&source);
+        let context = self.source_file_context(&source);
+        let Some(names) = context.resolved_names.as_deref() else {
+            return KernelSelection::default();
+        };
+        let offset = context
+            .classes
+            .iter()
+            .find(|class| class.fqn().eq_ignore_ascii_case(BUILDER))
+            .map(|class| class.keyword_offset);
+        crate::parser::with_parsed_program(
+            &source,
+            "builder_kernel_registration",
+            |program, content| {
+                let Some(class) =
+                    offset.and_then(|offset| class_at(Node::Program(program), offset))
+                else {
+                    return KernelSelection::default();
+                };
+                let Some(create) = method(class, b"create") else {
+                    return KernelSelection::default();
+                };
+                if create.statements.len() != 1
+                    || !matches!(create.statements.iter().next(),Some(Statement::Return(statement)) if statement.value.is_some_and(app_property))
+                {
+                    return KernelSelection::default();
+                }
+                let Some(body) = method(class, b"withKernels") else {
+                    return KernelSelection::default();
+                };
+                let mut selection = KernelSelection::default();
+                let mut returned = false;
+                let mut complete = program.errors.is_empty();
+                for statement in body.statements.iter() {
+                    match statement {
+                        Statement::Expression(statement) if !returned => {
+                            let Expression::Call(Call::Method(call)) =
+                                unwrapped(statement.expression)
+                            else {
+                                complete = false;
+                                continue;
+                            };
+                            if !app_property(call.object)
+                                || !matches!(&call.method,ClassLikeMemberSelector::Identifier(name) if [b"singleton".as_slice(),b"bind",b"scoped"].iter().any(|known|name.value.eq_ignore_ascii_case(known)))
+                            {
+                                complete = false;
+                                continue;
+                            }
+                            let key =
+                                argument(&call.argument_list, 0, b"abstract").and_then(|expr| {
+                                    class_string_fqn(unwrapped(expr), names).or_else(|| {
+                                        super::const_eval::const_string(
+                                            expr,
+                                            content,
+                                            &super::const_eval::Scope::default(),
+                                        )
+                                    })
+                                });
+                            match key.as_deref() {
+                                Some(CONTRACT) => {
+                                    selection.roots = argument(&call.argument_list, 1, b"concrete")
+                                        .and_then(|expr| {
+                                            class_string_fqn(unwrapped(expr), names).or_else(|| {
+                                                super::const_eval::const_string(
+                                                    expr,
+                                                    content,
+                                                    &super::const_eval::Scope::default(),
+                                                )
+                                            })
+                                        })
+                                        .map(KernelRoot::Bound)
+                                        .into_iter()
+                                        .collect();
+                                }
+                                Some(_) => {}
+                                None => complete = false,
+                            }
+                        }
+                        Statement::Return(statement) if !returned => {
+                            returned = statement
+                                .value
+                                .is_some_and(|expr| is_variable(expr, b"$this"));
+                            if !returned {
+                                complete = false;
+                            }
+                        }
+                        Statement::Noop(_) => {}
+                        _ => complete = false,
+                    }
+                }
+                selection.complete = complete && returned && !selection.roots.is_empty();
+                selection
+            },
+        )
+    }
+}

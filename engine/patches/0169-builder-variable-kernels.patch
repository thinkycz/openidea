+#[tokio::test]
+async fn builder_variable_factory_unresolved_results_keep_plans_incomplete() {
+    let prefix = r"<?php $builder=\Illuminate\Foundation\Application::configure();";
+    let mut aliases = format!("{prefix} $app=$builder->create();");
+    let mut previous = "$app".to_owned();
+    for index in 0..80 {
+        let next = format!("$alias{index}");
+        aliases.push_str(&format!("{next}={previous};"));
+        previous = next;
+    }
+    aliases.push_str(&format!("return {previous};"));
+    let captured = format!(
+        "{prefix} $capture={} $builder; return $builder->create();",
+        "fn()=>".repeat(70)
+    );
+    for bootstrap in [
+        aliases,
+        captured,
+        format!("{prefix} return $builder;"),
+        r"<?php return \Illuminate\Foundation\Application::configure();".to_owned(),
+    ] {
+        let (backend, dir, _, _) = builder_kernel_workspace(&bootstrap).await;
+        let target = Url::from_file_path(dir.path().join("app/Http/Middleware/Trace.php")).unwrap();
+        let text = "<?php namespace App\\Http\\Middleware; class Trace {}";

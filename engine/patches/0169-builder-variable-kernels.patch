+fn builder_touches<'ast, 'arena>(
+    node: Node<'ast, 'arena>,
+    touches: &mut Vec<BuilderTouch<'arena>>,
+    depth: usize,
+) -> bool {
+    if depth >= 64 {
+        return false;
+    }
+    let mut pending = vec![node];
+    let mut complete = true;
+    while let Some(node) = pending.pop() {
+        match node {
+            Node::Function(_)
+            | Node::Method(_)
+            | Node::Class(_)
+            | Node::Trait(_)
+            | Node::Interface(_)
+            | Node::Enum(_) => continue,
+            Node::Closure(closure) => {
+                if let Some(captures) = &closure.use_clause {
+                    for capture in captures.variables.iter() {
+                        let variable = &capture.variable;
+                        touches.push(BuilderTouch {
+                            name: bytes_to_str(variable.name),
+                            range: (variable.span.start.offset, variable.span.end.offset),
+                        });
+                    }
+                }
+                continue;
+            }
+            Node::ArrowFunction(arrow) => {
+                let mut captures = Vec::new();
+                complete &=
+                    builder_touches(Node::Expression(arrow.expression), &mut captures, depth + 1);
+                touches.extend(captures.into_iter().filter(|capture| {
+                    !arrow
+                        .parameter_list
+                        .parameters
+                        .iter()
+                        .any(|parameter| bytes_to_str(parameter.variable.name) == capture.name)
+                }));
+                continue;
+            }
+            Node::DirectVariable(variable) => touches.push(BuilderTouch {
+                name: bytes_to_str(variable.name),
+                range: (variable.span.start.offset, variable.span.end.offset),
+            }),
+            _ => {}
+        }
+        node.visit_children(|child| pending.push(child));
+    }
+    complete
+}
+fn allowed_builder_uses(expr: &Expression<'_>, allowed: &mut HashSet<(u32, u32)>) {
+    let mut current = unwrapped(expr);
+    loop {
+        match current {
+            Expression::Variable(Variable::Direct(variable)) => {
+                allowed.insert((variable.span.start.offset, variable.span.end.offset));
+                break;
+            }
+            Expression::Assignment(assignment)
+                if matches!(assignment.operator, AssignmentOperator::Assign(_))
+                    && variable(assignment.lhs).is_some() =>
+            {
+                allowed.insert(span(unwrapped(assignment.lhs)));
+                current = unwrapped(assignment.rhs);
+            }
+            Expression::Call(Call::Method(call)) => current = unwrapped(call.object),
+            _ => break,
+        }
+    }
+}

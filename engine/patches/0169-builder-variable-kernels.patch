+// Each create() returns the same application held by its proven builder.
+fn application_origin(name: &str, before: u32, sites: &[AssignmentSite]) -> Option<u32> {
+    let source = origin(name, before, sites, 0, false)?;
+    let site = sites.iter().find(|site| site.origin == source)?;
+    match site.factory_builder.as_deref() {
+        Some(builder) => builder_site(builder, site.value_span.0, sites).map(|site| site.origin),
+        None => Some(source),
+    }
+}
+struct BuilderContext<'a> {
+    sites: &'a [AssignmentSite],
+    effects: &'a [BuilderEffect],

+#[tokio::test]
+async fn builder_variable_factory_dirty_alias_changes_retire_and_restore_ownership() {
+    let bootstrap = r"<?php $builder=\Illuminate\Foundation\Application::configure(); $alias=$builder; return $alias->create();";
+    let (backend, dir, caller, conventional) = builder_kernel_workspace(bootstrap).await;
+    let declaration =
+        Url::from_file_path(dir.path().join("framework/Foundation/Http/Kernel.php")).unwrap();
+    let path = dir.path().join("bootstrap/app.php");
+    let uri = Url::from_file_path(&path).unwrap();
+    open_document(&backend, &uri, "php", bootstrap).await;
+    assert_eq!(
+        definitions(&backend, &caller, SOURCE, "middleware('aud").await[0].uri,
+        declaration
+    );
+    let unknown = bootstrap.replace("$alias=$builder;", r"$alias=new \stdClass;");
+    change(&backend, &uri, &unknown, 2).await;
+    assert!(
+        definitions(&backend, &caller, SOURCE, "middleware('aud")
+            .await
+            .is_empty()
+    );
+    let restored = bootstrap.replace("$alias=$builder;", "$alias=$builder->withMiddleware();");
+    change(&backend, &uri, &restored, 3).await;
+    assert_eq!(
+        definitions(&backend, &caller, SOURCE, "middleware('aud").await[0].uri,
+        declaration
+    );
+    let refs = find_references(
+        &backend,
+        &caller,
+        position_after(SOURCE, "middleware('aud"),
+        true,
+    )
+    .await;
+    assert!(refs.iter().any(|location| location.uri == declaration));
+    assert!(!refs.iter().any(|location| location.uri == conventional));
+    assert_eq!(std::fs::read_to_string(path).unwrap(), bootstrap);
+}

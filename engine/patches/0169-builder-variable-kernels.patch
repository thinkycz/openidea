+    allowed: &'a HashSet<(u32, u32)>,
+    limit: u32,
+    complete: bool,
+}
+impl BuilderContext<'_> {
+    fn factory(&self, name: &str, range: (u32, u32)) -> Option<KernelSelection> {
+        let Self {
+            sites,
+            effects,
+            touches,
+            allowed,
+            limit,
+            complete,
+        } = self;
+        let source = builder_site(name, range.0, sites)?;
+        let mut selection = source.builder.clone()?;
+        selection.complete &= *complete;
+        // Receiver-chain calls finish before create; later builder mutations remain opaque.
+        let first_create_end = effects
+            .iter()
+            .filter(|effect| {
+                effect.creates
+                    && builder_site(&effect.receiver, effect.at, sites)
+                        .is_some_and(|site| site.origin == source.origin)
+            })
+            .map(|effect| effect.end)
+            .min()
+            .unwrap_or(range.1);
+        for effect in *effects {
+            if effect.at < *limit
+                && builder_site(&effect.receiver, effect.at, sites)
+                    .is_some_and(|site| site.origin == source.origin)
+                && (!effect.known || (effect.at >= first_create_end && !effect.creates))
+            {
+                selection.complete = false;
+            }
+        }
+        if touches.iter().any(|touch| {
+            touch.range.0 < *limit
+                && !allowed.contains(&touch.range)
+                && builder_site(touch.name, touch.range.0, sites)
+                    .is_some_and(|site| site.origin == source.origin)
+        }) {
+            selection.complete = false;
+        }
+        Some(selection)
+    }
+}

+                        .argument_list
+                        .arguments
+                        .iter()
+                        .all(|arg| pure_argument(arg.value()))
+                {
+                    return false;
+                }
+                current = unwrapped(call.object);
+            }
+            Expression::Variable(Variable::Direct(_)) => return true,
+            Expression::Call(Call::StaticMethod(call)) => {
+                return matches!(&call.method,ClassLikeMemberSelector::Identifier(name) if name.value.eq_ignore_ascii_case(b"configure"));
+            }
+            _ => return false,
+        }
+    }
+    false
+}

+//! Initial HTTP Kernel effects of a provider registered by the returned application.
+use super::{
+    const_eval::{Scope, const_string},
+    kernel_binding::{CONTRACT, TopLevel, argument, in_callable, pure_argument, unwrapped},
+    kernel_middleware::{complete_graph, trait_property_overlaps},
+    provider_resources::class_string_fqn,
+};
+use crate::{
+    Backend,
+    names::OwnedResolvedNames,
+    types::{ClassInfo, ClassLikeKind, Visibility},
+};
+use mago_span::HasSpan;
+use mago_syntax::cst::*;
+use std::{
+    cell::{Cell, RefCell},
+    collections::{HashMap, HashSet},
+    ops::ControlFlow,
+    sync::Arc,
+};
+
+const PROVIDER: &str = "Illuminate\\Support\\ServiceProvider";
+#[derive(Clone, Default)]
+pub(super) struct ProviderKernelEffects {
+    pub class: String,
+    pub targets: Vec<String>,
+    pub complete: bool,
+}
+fn class_value(expr: &Expression<'_>, content: &str, names: &OwnedResolvedNames) -> Option<String> {
+    class_string_fqn(unwrapped(expr), names)
+        .or_else(|| const_string(unwrapped(expr), content, &Scope::default()))
+}
+fn provider_app(expr: &Expression<'_>) -> bool {
+    matches!(unwrapped(expr), Expression::Access(Access::Property(p))
+        if matches!(unwrapped(p.object),Expression::Variable(Variable::Direct(v)) if v.name==b"$this")
+        && matches!(&p.property,ClassLikeMemberSelector::Identifier(n) if n.value==b"app"))
+}
+fn binding_call(
+    expr: &Expression<'_>,
+    content: &str,
+    names: &OwnedResolvedNames,
+) -> Option<(Option<String>, bool)> {
+    let Expression::Call(Call::Method(call)) = unwrapped(expr) else {
+        return None;
+    };
+    if !provider_app(call.object) {
+        return None;
+    }
+    let ClassLikeMemberSelector::Identifier(name) = &call.method else {
+        return None;
+    };
+    let name = name.value.to_ascii_lowercase();
+    if ![
+        b"bind".as_slice(),
+        b"singleton",
+        b"scoped",
+        b"bindif",
+        b"singletonif",
+        b"scopedif",
+    ]
+    .contains(&name.as_slice())
+    {
+        return None;
+    }
+    let plain = [b"bind".as_slice(), b"singleton", b"scoped"].contains(&name.as_slice());
+    let valid = call.argument_list.arguments.len()
+        <= if name == b"bind" || name == b"bindif" {
+            3
+        } else {
+            2
+        }
+        && call.argument_list.arguments.iter().all(|arg| match arg {
+            Argument::Positional(p) => p.ellipsis.is_none(),
+            Argument::Named(n) => {
+                [b"abstract".as_slice(), b"concrete"].contains(&n.name.value)
+                    || ((name == b"bind" || name == b"bindif") && n.name.value == b"shared")
+            }
+        });
+    let key =
+        argument(&call.argument_list, 0, b"abstract").and_then(|e| class_value(e, content, names));
+    let value =
+        argument(&call.argument_list, 1, b"concrete").and_then(|e| class_value(e, content, names));
+    let shared = argument(&call.argument_list, 2, b"shared");
+    let shared_valid = shared.is_none_or(|e| {
+        matches!(
+            unwrapped(e),
+            Expression::Literal(Literal::True(_) | Literal::False(_))
+        )
+    });
+    match key {
+        Some(key) if key != CONTRACT => Some((None, valid && value.is_some() && shared_valid)),
+        Some(_) => Some((
+            value.clone(),
+            valid && plain && value.is_some() && shared_valid,
+        )),
+        None => Some((value, false)),
+    }
+}
+fn scan_register(
+    block: &Block<'_>,
+    content: &str,
+    names: &OwnedResolvedNames,
+    effects: &mut ProviderKernelEffects,
+) {
+    let mut top = TopLevel::new();
+    top.statements(block.statements.iter());
+    let mut matched = HashSet::new();
+    let mut bindings = Vec::new();
+    super::helpers::walk_block_expressions(block, &mut |expr| {
+        let at = expr.span().start.offset;
+        if top.limit.is_some_and(|limit| at >= limit) || in_callable(Node::Block(block), at) {
+            return ControlFlow::Continue(());
+        }
+        let Some((target, complete)) = binding_call(expr, content, names) else {
+            return ControlFlow::Continue(());
+        };
+        let range = (
+            unwrapped(expr).span().start.offset,
+            unwrapped(expr).span().end.offset,
+        );
+        if top.direct.contains_key(&range) {
+            matched.insert(range);
+        }
+        effects.complete &= complete && top.direct.get(&range) == Some(&true);
+        if let Some(target) = target {
+            bindings.push((at, target));
+        }
+        ControlFlow::Continue(())
+    });
+    effects.complete &= top.certain
+        && top.return_value.is_none()
+        && top.direct.keys().all(|range| matched.contains(range));
+    bindings.sort_by_key(|b| b.0);
+    effects.targets.extend(bindings.into_iter().map(|b| b.1));
+}
+fn register_body(
+    node: Node<'_, '_>,
+    offset: u32,
+    content: &str,
+    names: &OwnedResolvedNames,
+    effects: &mut ProviderKernelEffects,
+) -> bool {
+    let mut pending = vec![node];
+    let mut remaining = 16_384;
+    while let Some(node) = pending.pop() {
+        if remaining == 0 {
+            return false;
+        }
+        remaining -= 1;
+        if let Node::Method(method) = node
+            && method.name.span.start.offset == offset
+        {
+            if let MethodBody::Concrete(block) = &method.body {
+                effects.complete &= method.parameter_list.parameters.iter().all(|parameter| {
+                    parameter
+                        .default_value
+                        .as_ref()
+                        .is_none_or(|default| pure_argument(default.value))
+                });
+                scan_register(block, content, names, effects);
+                return true;
+            }
+            return false;
+        }
+        node.visit_children(|child| pending.push(child));
+    }
+    false
+}
+fn property_map(
+    node: Node<'_, '_>,
+    offset: u32,
+    content: &str,
+    names: &OwnedResolvedNames,
+    singletons: bool,
+    effects: &mut ProviderKernelEffects,
+) -> bool {
+    let mut pending = vec![node];
+    let mut remaining = 16_384;
+    while let Some(node) = pending.pop() {
+        if remaining == 0 {
+            return false;
+        }
+        remaining -= 1;
+        if matches!(node, Node::HookedProperty(_)) {
+            continue;
+        }
+        if let Node::PropertyItem(PropertyItem::Concrete(item)) = node
+            && item.variable.span.start.offset == offset
+        {
+            let Expression::Array(array) = unwrapped(item.value) else {
+                return false;
+            };
+            for element in array.elements.iter() {
+                let (mut key, value) = match element {
+                    ArrayElement::KeyValue(kv) => {
+                        (class_value(kv.key, content, names), Some(kv.value))
+                    }
+                    ArrayElement::Value(v) if singletons => {
+                        (class_value(v.value, content, names), Some(v.value))
+                    }
+                    _ => {
+                        effects.complete = false;
+                        continue;
+                    }
+                };
+                if singletons
+                    && key
+                        .as_ref()
+                        .is_some_and(|k| k.parse::<i64>().is_ok_and(|n| n.to_string() == *k))
+                {
+                    key = value.and_then(|v| class_value(v, content, names));
+                }
+                let Some(key) = key else {
+                    effects.complete = false;
+                    continue;
+                };
+                let value = value.and_then(|v| class_value(v, content, names));
+                if key == CONTRACT {
+                    if let Some(value) = value {
+                        effects.targets.push(value);
+                    } else {
+                        effects.complete = false;
+                    }
+                } else if value.is_none() {
+                    effects.complete = false;
+                }
+            }
+            return true;
+        }
+        node.visit_children(|child| pending.push(child));
+    }
+    false
+}
+fn property_defaults_pure(member: &ClassLikeMember<'_>) -> bool {
+    let item_pure = |item: &PropertyItem<'_>| match item {
+        PropertyItem::Concrete(item) => pure_argument(item.value),
+        PropertyItem::Abstract(_) => true,
+    };
+    match member {
+        ClassLikeMember::Property(Property::Plain(property)) => {
+            property.items.iter().all(item_pure)
+        }
+        ClassLikeMember::Property(Property::Hooked(property)) => item_pure(&property.item),
+        ClassLikeMember::Constant(constant) => {
+            constant.items.iter().all(|item| pure_argument(item.value))
+        }
+        _ => true,
+    }
+}
+fn declarations_only(statement: &Statement<'_>, allowed: &HashSet<u32>, depth: usize) -> bool {
+    if depth >= 64 {
+        return false;
+    }
+    match statement {
+        Statement::Namespace(ns) => ns
+            .statements()
+            .iter()
+            .all(|s| declarations_only(s, allowed, depth + 1)),
+        Statement::Block(block) => block
+            .statements
+            .iter()
+            .all(|s| declarations_only(s, allowed, depth + 1)),
+        Statement::Class(class) => {
+            allowed.contains(&class.left_brace.start.offset)
+                && class.members.iter().all(property_defaults_pure)
+        }
+        Statement::Trait(class) => {
+            allowed.contains(&class.left_brace.start.offset)
+                && class.members.iter().all(property_defaults_pure)
+        }
+        Statement::Interface(class) => {
+            allowed.contains(&class.left_brace.start.offset)
+                && class.members.iter().all(property_defaults_pure)
+        }
+        Statement::Enum(class) => {
+            allowed.contains(&class.left_brace.start.offset)
+                && class.members.iter().all(property_defaults_pure)
+        }
+        Statement::Constant(constant) => {
+            constant.items.iter().all(|item| pure_argument(item.value))
+        }
+        Statement::Function(_)
+        | Statement::OpeningTag(_)
+        | Statement::ClosingTag(_)
+        | Statement::Use(_)
+        | Statement::Noop(_) => true,
+        Statement::Declare(declare) => match &declare.body {
+            DeclareBody::Statement(s) => declarations_only(s, allowed, depth + 1),
+            DeclareBody::ColonDelimited(body) => body
+                .statements
+                .iter()
+                .all(|s| declarations_only(s, allowed, depth + 1)),
+        },
+        _ => false,
+    }
+}

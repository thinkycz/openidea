+impl Backend {
+    pub(super) fn immediate_provider_kernel(&self, name: &str) -> ProviderKernelEffects {
+        use crate::inheritance::ancestry::{MethodOrigin, resolve_concrete_method_origin};
+        let Some(class) = self.find_or_load_class(name) else {
+            return ProviderKernelEffects::default();
+        };
+        let loaded = RefCell::new(HashMap::<String, Arc<ClassInfo>>::from([(
+            class.fqn().to_ascii_lowercase(),
+            Arc::clone(&class),
+        )]));
+        let missing = Cell::new(false);
+        let loader = |name: &str| {
+            let value = self.find_or_load_class(name);
+            if let Some(value) = &value {
+                loaded
+                    .borrow_mut()
+                    .insert(value.fqn().to_ascii_lowercase(), Arc::clone(value));
+            } else {
+                missing.set(true);
+            }
+            value
+        };
+        let mut effects = ProviderKernelEffects {
+            class: class.fqn().to_string(),
+            targets: Vec::new(),
+            complete: class.kind == ClassLikeKind::Class
+                && !class.is_abstract
+                && crate::class_lookup::is_subtype_of(&class, PROVIDER, &loader),
+        };
+        let effective = crate::inheritance::resolve_class_with_inheritance(&class, &loader);
+        effects.complete &= loaded.borrow().values().all(|c| {
+            c.fqn().eq_ignore_ascii_case(PROVIDER)
+                || c.get_property("app").is_none_or(|p| p.is_virtual)
+        });
+        let constructor = resolve_concrete_method_origin(&class, "__construct", &loader);
+        effects.complete &= matches!(constructor,MethodOrigin::Known{owner,..} if owner.fqn().eq_ignore_ascii_case(PROVIDER));
+        let method = resolve_concrete_method_origin(&class, "register", &loader);
+        if let MethodOrigin::Known { owner, method } = method {
+            effects.complete &= effective.get_method("register").is_some_and(|m| {
+                !m.is_static
+                    && m.visibility == Visibility::Public
+                    && m.parameters
+                        .iter()
+                        .all(|p| p.default_value.is_some() || p.is_variadic)
+            });
+            if !owner.fqn().eq_ignore_ascii_case(PROVIDER) {
+                if let Some(uri) = self.find_class_file_uri_for_fqn(&owner.fqn())
+                    && let Some(content) = self.get_file_content(&uri)
+                {
+                    let _parse = crate::parser::with_parse_cache(&content);
+                    let context = self.source_file_context(&content);
+                    if let Some(names) = context.resolved_names.as_deref() {
+                        let valid = crate::parser::with_parsed_program(
+                            &content,
+                            "provider_kernel_register",
+                            |program, content| {
+                                let found = register_body(
+                                    Node::Program(program),
+                                    method.name_offset,
+                                    content,
+                                    names,
+                                    &mut effects,
+                                );
+                                found && program.errors.is_empty()
+                            },
+                        );
+                        effects.complete &= valid;
+                    } else {
+                        effects.complete = false;
+                    }
+                } else {
+                    effects.complete = false;
+                }
+            }
+        } else {
+            effects.complete = false;
+        }
+        for name in ["bindings", "singletons"] {
+            let Some(property) = effective.get_property(name).filter(|p| !p.is_virtual) else {
+                effects.complete &= !loaded
+                    .borrow()
+                    .values()
+                    .any(|c| c.get_property(name).is_some_and(|p| !p.is_virtual));
+                continue;
+            };
+            let declares = |c: &ClassInfo| {
+                c.get_property(name).is_some_and(|p| {
+                    !p.is_virtual
+                        && p.name_offset == property.name_offset
+                        && p.source == property.source
+                })
+            };
+            let owner = if declares(&class) {
+                Some(Arc::clone(&class))
+            } else {
+                crate::inheritance::find_declaring_ancestor(&class, &loader, &declares)
+                    .map(|(_, c)| c)
+            };
+            effects.complete &= !property.is_static
+                && property.visibility == Visibility::Public
+                && property.name_offset != 0;
+            let scopes: Vec<_> = loaded.borrow().values().cloned().collect();
+            effects.complete &= !scopes
+                .iter()
+                .any(|c| trait_property_overlaps(c, name, &loader));
+            effects.complete &= scopes
+                .iter()
+                .filter(|c| {
+                    c.kind == ClassLikeKind::Trait
+                        && c.get_property(name).is_some_and(|p| !p.is_virtual)
+                })
+                .count()
+                < 2;
+            if let Some(owner) = owner
+                && let Some(uri) = self.find_class_file_uri_for_fqn(&owner.fqn())
+                && let Some(content) = self.get_file_content(&uri)
+            {
+                let _parse = crate::parser::with_parse_cache(&content);
+                let context = self.source_file_context(&content);
+                if let Some(names) = context.resolved_names.as_deref() {
+                    let valid = crate::parser::with_parsed_program(
+                        &content,
+                        "provider_kernel_property",
+                        |program, content| {
+                            let found = property_map(
+                                Node::Program(program),
+                                property.name_offset,
+                                content,
+                                names,
+                                name == "singletons",
+                                &mut effects,
+                            );
+                            found && program.errors.is_empty()
+                        },
+                    );
+                    effects.complete &= valid;
+                } else {
+                    effects.complete = false;
+                }
+            } else {
+                effects.complete = false;
+            }
+        }
+        effects.complete &= !missing.get() && complete_graph(&class, &loaded.borrow(), true);
+        let scopes: Vec<_> = loaded.borrow().values().cloned().collect();
+        let known: HashSet<_> = scopes
+            .iter()
+            .map(|c| c.fqn().to_ascii_lowercase())
+            .collect();
+        let mut checked = HashSet::new();
+        for scope in &scopes {
+            let Some(uri) = self.find_class_file_uri_for_fqn(&scope.fqn()) else {
+                effects.complete = false;
+                continue;
+            };
+            if !checked.insert(uri.clone()) {
+                continue;
+            }
+            let Some(content) = self.get_file_content(&uri) else {
+                effects.complete = false;
+                continue;
+            };
+            let _parse = crate::parser::with_parse_cache(&content);
+            let context = self.source_file_context(&content);
+            let allowed: HashSet<_> = context
+                .classes
+                .iter()
+                .filter(|c| {
+                    known.contains(&c.fqn().to_ascii_lowercase())
+                        || (c.kind == ClassLikeKind::Class
+                            && c.parent_class.is_none()
+                            && c.interfaces.is_empty()
+                            && c.used_traits.is_empty())
+                })
+                .map(|c| c.start_offset)
+                .collect();
+            effects.complete &= crate::parser::with_parsed_program(
+                &content,
+                "provider_kernel_loading",
+                |program, _| {
+                    program.errors.is_empty()
+                        && program
+                            .statements
+                            .iter()
+                            .all(|s| declarations_only(s, &allowed, 0))
+                },
+            );
+        }
+        if let Some(uri) = self.find_class_file_uri_for_fqn(&class.fqn())
+            && let Some(content) = self.get_file_content(&uri)
+        {
+            effects.complete &= self.middleware_graph_sources_valid(
+                &uri,
+                &content,
+                &class,
+                loaded.borrow().values().cloned().collect(),
+            );
+        } else {
+            effects.complete = false;
+        }
+        effects
+    }
+}

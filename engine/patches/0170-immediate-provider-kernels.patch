+        let target=Url::from_file_path(dir.path().join("app/Http/Middleware/Trace.php")).unwrap();let text=std::fs::read_to_string(target.to_file_path().unwrap()).unwrap();open_document(&backend,&target,"php",&text).await;
+        let edit=settled_target_rename(&backend,&target,&text,"class Trac","Traced").await;

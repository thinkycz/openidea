+fn pure_argument_depth(expr: &Expression<'_>, depth: usize) -> bool {
+    if depth >= 64 {
+        return false;
+    }
+    match unwrapped(expr) {
+        Expression::Literal(_)
+        | Expression::Variable(Variable::Direct(_))
+        | Expression::Closure(_)
+        | Expression::ArrowFunction(_)
+        | Expression::Identifier(_)
+        | Expression::MagicConstant(_) => true,
+        Expression::Access(Access::ClassConstant(access)) => {
+            matches!(&access.constant,ClassLikeConstantSelector::Identifier(name) if name.value.eq_ignore_ascii_case(b"class"))
+                && matches!(unwrapped(access.class), Expression::Identifier(_))
+        }
+        Expression::Array(array) => array.elements.iter().all(|element| match element {
+            ArrayElement::KeyValue(kv) => {
+                pure_argument_depth(kv.key, depth + 1) && pure_argument_depth(kv.value, depth + 1)
+            }
+            ArrayElement::Value(v) => pure_argument_depth(v.value, depth + 1),
+            _ => false,
+        }),
+        Expression::Binary(binary) => {
+            !matches!(unwrapped(binary.lhs), Expression::Variable(_))
+                && !matches!(unwrapped(binary.rhs), Expression::Variable(_))
+                && pure_argument_depth(binary.lhs, depth + 1)
+                && pure_argument_depth(binary.rhs, depth + 1)
+        }
+        _ => false,
+    }
+}
+fn pure_builder_chain(expr: &Expression<'_>) -> bool {
+    let mut current = unwrapped(expr);
+    for _ in 0..64 {

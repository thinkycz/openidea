+async fn immediate_provider_kernel_unknown_effects_and_force_values_never_authorize_edits() {
+    for provider in [
+        IMMEDIATE_PROVIDER.replace("public function register()",r"public function __construct($app){parent::__construct($app);}public function register()"),
+        IMMEDIATE_PROVIDER.replace("$this->app->singleton(HttpKernel::class, SelectedKernel::class);",r"if ($unknown) {$this->app->singleton(HttpKernel::class, SelectedKernel::class);}"),
+        IMMEDIATE_PROVIDER.replace("$this->app->singleton(HttpKernel::class, SelectedKernel::class);",r"$this->app=new \stdClass;$this->app->singleton(HttpKernel::class, SelectedKernel::class);"),
+        IMMEDIATE_PROVIDER.replace("SelectedKernel::class);","fn()=>new SelectedKernel);"),
+        IMMEDIATE_PROVIDER.replace("public function register(): void", "public function register()").replace("SelectedKernel::class);","SelectedKernel::class);return mutate($this->app);"),
+        IMMEDIATE_PROVIDER.replace("public function register()",r"public $bindings = [HttpKernel::class=>SelectedKernel::class] {get => [];} public function register()"),
+    ] {
+        let (backend,dir,route,_)=immediate_provider_workspace(&provider,PROVIDER_BOOTSTRAP).await;
+        let detail=hover(&backend,&route,SOURCE,"middleware('aud").await;

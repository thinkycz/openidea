+#[tokio::test]
+async fn immediate_provider_kernel_parameter_defaults_cannot_hide_lifecycle_execution() {
+    for (parameters, complete) in [
+        (
+            "$options=[],string $label='Kernel',?string $scope=null",
+            true,
+        ),
+        (r"$phase=new DefaultPhase", false),
+    ] {
+        let provider = IMMEDIATE_PROVIDER.replace(
+            "function register()",
+            &format!("function register({parameters})"),
+        ) + r" class DefaultPhase {public function __construct(){}}";
+        let (backend, dir, route, _) =
+            immediate_provider_workspace(&provider, PROVIDER_BOOTSTRAP).await;
+        let detail = hover(&backend, &route, SOURCE, "middleware('aud").await;

+    immediate_provider_workspace_extra(provider, bootstrap, &[]).await
+}
+async fn immediate_provider_workspace_extra(
+    provider: &str,
+    bootstrap: &str,
+    extra: &[(&str, &str)],
+) -> (Backend, tempfile::TempDir, Url, Url) {
+    let mut files = vec![
+        ("framework/Support/ServiceProvider.php", SERVICE_PROVIDER),
+        ("app/Providers/KernelProvider.php", provider),
+    ];
+    files.extend_from_slice(extra);
+    bound_kernel_workspace(bootstrap, &files).await
+}

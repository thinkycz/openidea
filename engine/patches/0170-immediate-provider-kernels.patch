+#[tokio::test]
+async fn immediate_provider_kernel_unmodeled_bootstrap_execution_refuses_complete_edits() {
+    let helper = r"<?php function bootBeforeProvider($app):void {$app->boot();} function setupProject():void {} function existingApplication(): \Illuminate\Foundation\Application {return new \Illuminate\Foundation\Application;}";
+    for effect in [
+        "bootBeforeProvider($app);",
+        "require_once __DIR__.'/../app/helper.php';bootBeforeProvider($app);",
+        "$app->unknownPhase();",
+        "setupProject();",
+        "$app=existingApplication();",
+        "$escaped=[$app];",
+        "$callback=function()use($app){};",
+    ] {
+        let bootstrap =
+            PROVIDER_BOOTSTRAP.replace("$app->register(", &format!("{effect}$app->register("));
+        let (backend, dir, route, _) = immediate_provider_workspace_extra(
+            IMMEDIATE_PROVIDER,
+            &bootstrap,
+            &[("app/helper.php", helper)],
+        )
+        .await;
+        let detail = hover(&backend, &route, SOURCE, "middleware('aud").await;
+        assert!(
+            detail.contains("incomplete"),
+            "unmodeled bootstrap must keep provider selection incomplete: {effect}\n{detail}"
+        );
+        let target = Url::from_file_path(dir.path().join("app/Http/Middleware/Trace.php")).unwrap();
+        let text = std::fs::read_to_string(target.to_file_path().unwrap()).unwrap();
+        open_document(&backend, &target, "php", &text).await;
+        let edit = settled_target_rename(&backend, &target, &text, "class Trac", "Traced").await;
+        assert!(
+            edit.as_ref().is_err_and(|m| m.contains("middleware")),
+            "{effect}: {edit:?}"
+        );
+    }
+}

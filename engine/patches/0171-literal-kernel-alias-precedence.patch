+#[tokio::test]
+async fn kernel_alias_literal_property_precedence_matches_standard_runtime() {
+    let source = KERNEL.replace(
+        "\n}",
+        "\nprotected $routeMiddleware = ['audited' => \\App\\Http\\Middleware\\Trace::class];\n}",
+    );
+    let (backend, _dir, caller, kernel) = kernel_workspace_extra(
+        &source,
+        &[("framework/Foundation/Http/Kernel.php", ORDERED_KERNEL_BASE)],
+    )
+    .await;
+    let found = definitions(&backend, &caller, SOURCE, "middleware('aud").await;
+    assert_eq!(
+        found.len(),
+        1,
+        "standard Kernel must select modern alias over legacy: {found:?}"
+    );
+    assert_eq!(found[0].uri, kernel);
+    assert_eq!(found[0].range.start, position_after(&source, "/* 😀 */ \""));
+    let detail = hover(&backend, &caller, SOURCE, "middleware('aud").await;
+    assert!(
+        detail.contains("Middleware\\Audit")
+            && !detail.contains("Middleware\\Trace")
+            && !detail.contains("incomplete"),
+        "{detail}"
+    );
+    let refs = find_references(
+        &backend,
+        &caller,
+        position_after(SOURCE, "middleware('aud"),
+        true,
+    )
+    .await;
+    assert_eq!(
+        refs.len(),
+        2,
+        "only effective declaration and caller are alias references: {refs:?}"
+    );
+}

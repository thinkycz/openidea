+const ORDERED_KERNEL_BASE: &str = r"<?php namespace Illuminate\Foundation\Http;
+class Kernel {
+ public function __construct() {}
+ protected function syncMiddlewareToRouter() {}
+ public function getMiddlewareAliases() {return array_merge($this->routeMiddleware,$this->middlewareAliases);}

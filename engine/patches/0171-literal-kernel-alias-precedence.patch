+    pub(super) fn kernel_alias_choice(
+        &self,
+        sources: &KernelAliasSources,
+        name: &str,
+    ) -> KernelAliasChoice {
+        let mut choice = KernelAliasChoice {
+            active: HashSet::new(),
+            uncertain: HashSet::new(),
+            complete: true,
+        };
+        let mut offsets: HashMap<&str, HashSet<u32>> = HashMap::new();
+        let mut groups: HashMap<&str, Vec<&KernelAliasOrigin>> = HashMap::new();
+        for origin in &sources.origins {
+            offsets
+                .entry(&origin.uri)
+                .or_default()
+                .insert(origin.declaration_offset);
+            groups.entry(&origin.root).or_default().push(origin);
+        }
+        let maps: HashMap<_, _> = offsets
+            .into_iter()
+            .map(|(uri, offsets)| {
+                let parsed = self
+                    .get_file_content(uri)
+                    .map(|content| literal_alias_maps(&content, &offsets));
+                (uri, parsed)
+            })
+            .collect();
+        for origins in groups.values() {
+            let mut selected: HashMap<&str, (String, u32)> = HashMap::new();
+            let mut properties = HashSet::new();
+            let mut complete = true;
+            for origin in origins {
+                if !properties.insert(origin.property) {
+                    complete = false;
+                }
+                let keys = maps
+                    .get(origin.uri.as_str())
+                    .and_then(Option::as_ref)
+                    .and_then(|maps| maps.get(&origin.declaration_offset))
+                    .and_then(Option::as_ref);
+                if let Some(keys) = keys {
+                    if let Some(offset) = keys.get(name) {
+                        selected.insert(origin.property, (origin.uri.clone(), *offset));
+                    }
+                } else {
+                    complete = false;
+                }
+            }
+            if !complete {
+                choice.complete = false;
+                choice.uncertain.extend(
+                    origins
+                        .iter()
+                        .map(|origin| (origin.uri.clone(), origin.declaration_offset)),
+                );
+                continue;
+            }
+            let modern = selected.remove("middlewareAliases");
+            let legacy = selected.remove("routeMiddleware");
+            if modern.is_some()
+                && legacy.is_some()
+                && !origins.iter().all(|origin| origin.ordering_proven)
+            {
+                choice.complete = false;
+                choice.active.extend(modern.into_iter().chain(legacy));
+            } else {
+                choice.active.extend(modern.or(legacy));
+            }
+        }
+        choice

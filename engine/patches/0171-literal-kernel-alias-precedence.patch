+#[tokio::test]
+async fn kernel_alias_modern_parent_and_trait_maps_override_own_legacy_and_refresh_dirty_sources() {
+    for is_trait in [false, true] {
+        let parent = KERNEL.replace(
+            "class Kernel extends BaseKernel",
+            "class AliasParent extends BaseKernel",
+        );
+        let parent = if is_trait {
+            parent.replace("class AliasParent extends BaseKernel", "trait AliasParent")
+        } else {
+            parent
+        };
+        let declaration = "app/Http/AliasParent.php";
+        let root = if is_trait {
+            r"<?php namespace App\Http;class Kernel extends \Illuminate\Foundation\Http\Kernel {use AliasParent;protected $routeMiddleware=['audited'=>\App\Http\Middleware\Trace::class];}"
+        } else {
+            r"<?php namespace App\Http;class Kernel extends AliasParent {protected $routeMiddleware=['audited'=>\App\Http\Middleware\Trace::class];}"
+        };
+        let (backend, dir, caller, kernel) = kernel_workspace_extra(
+            root,
+            &[
+                ("framework/Foundation/Http/Kernel.php", ORDERED_KERNEL_BASE),
+                (declaration, &parent),
+            ],
+        )
+        .await;
+        let found = definitions(&backend, &caller, SOURCE, "middleware('aud").await;
+        assert_eq!(
+            found.len(),
+            1,
+            "modern property priority is separate from class ownership: {found:?}"
+        );
+        assert_eq!(
+            found[0].uri,
+            Url::from_file_path(dir.path().join(declaration)).unwrap()
+        );
+        open_document(&backend, &kernel, "php", root).await;
+        let changed = root.replace(
+            "protected $routeMiddleware",
+            "protected $middlewareAliases=[];protected $routeMiddleware",
+        );
+        change(&backend, &kernel, &changed, 2).await;
+        let found = definitions(&backend, &caller, SOURCE, "middleware('aud").await;
+        assert_eq!(
+            found.len(),
+            1,
+            "empty own modern map exposes legacy: {found:?}"
+        );
+        assert_eq!(found[0].uri, kernel);
+        assert!(
+            hover(&backend, &caller, SOURCE, "middleware('aud")
+                .await
+                .contains("Middleware\\Trace")
+        );
+        change(&backend, &kernel, root, 3).await;
+        assert_eq!(
+            definitions(&backend, &caller, SOURCE, "middleware('aud")
+                .await
+                .len(),
+            1
+        );
+        assert!(
+            hover(&backend, &caller, SOURCE, "middleware('aud")
+                .await
+                .contains("Middleware\\Audit")
+        );
+    }
+}

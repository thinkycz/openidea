+fn literal_alias_keys(
+    expression: &mago_syntax::cst::Expression<'_>,
+    content: &str,
+    depth: usize,
+    remaining: &mut usize,
+) -> Option<AliasKeys> {
+    use mago_syntax::cst::ArrayElement;
+    if depth >= 64 {
+        return None;
+    }
+    let mut keys = HashMap::new();
+    for element in
+        crate::parser::array_literal_elements(crate::parser::unwrap_parens(expression))?.iter()
+    {
+        *remaining = remaining.checked_sub(1)?;
+        match element {
+            ArrayElement::KeyValue(pair) => {
+                let (name, start, _) = super::helpers::resolved_string_literal(
+                    crate::parser::unwrap_parens(pair.key),
+                    content,
+                )?;
+                // array_merge renumbers integer keys, including canonical integer strings.
+                if name.is_empty()
+                    || name
+                        .parse::<i64>()
+                        .is_ok_and(|number| number.to_string() == name)
+                {
+                    return None;
+                }
+                keys.insert(name.to_owned(), start as u32);
+            }
+            ArrayElement::Variadic(spread) => {
+                keys.extend(literal_alias_keys(
+                    spread.value,
+                    content,
+                    depth + 1,
+                    remaining,
+                )?);
+            }
+            _ => return None,
+        }
+    }
+    Some(keys)
+}
+
+fn literal_alias_maps(content: &str, offsets: &HashSet<u32>) -> HashMap<u32, Option<AliasKeys>> {
+    use mago_syntax::cst::{Node, PropertyItem};
+    crate::parser::with_parsed_program(content, "kernel_alias_priority", |program, _| {
+        let mut maps: HashMap<_, _> = offsets.iter().map(|offset| (*offset, None)).collect();
+        if !program.errors.is_empty() {
+            return maps;
+        }
+        let mut pending = vec![Node::Program(program)];
+        let mut remaining = 16_384;
+        while let Some(node) = pending.pop() {
+            if remaining == 0 {
+                break;
+            }
+            remaining -= 1;
+            if matches!(node, Node::HookedProperty(_) | Node::Method(_)) {
+                continue;
+            }
+            if let Node::PropertyItem(PropertyItem::Concrete(item)) = node
+                && offsets.contains(&item.variable.span.start.offset)
+            {
+                maps.insert(
+                    item.variable.span.start.offset,
+                    literal_alias_keys(item.value, content, 0, &mut 4096),
+                );
+                continue;
+            }
+            node.visit_children(|child| pending.push(child));
+        }
+        maps
+    })
 }
 

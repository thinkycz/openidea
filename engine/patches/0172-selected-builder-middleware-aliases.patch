+//! Ordered literal Middleware::alias callbacks of the selected standard builder.
+use super::{
+    kernel_binding::{argument, unwrapped},
+    provider_resources::resolved_class_fqn,
+};
+use crate::{Backend, names::OwnedResolvedNames};
+use mago_span::HasSpan;
+use mago_syntax::cst::*;
+use std::collections::HashMap;
+
+const BUILDER: &str = "Illuminate\\Foundation\\Configuration\\ApplicationBuilder";
+const MIDDLEWARE: &str = "Illuminate\\Foundation\\Configuration\\Middleware";
+
+#[derive(Clone, Default)]
+pub(super) struct MiddlewareConfiguration {
+    pub sites: Vec<MiddlewareSite>,
+    pub source_hash: Option<[u8; 32]>,
+}
+
+#[derive(Clone)]
+pub(super) struct MiddlewareSite {
+    pub end: u32,
+    pub callback: Option<(u32, u32)>,
+    pub valid: bool,
+}
+impl MiddlewareSite {
+    pub fn of(call: &MethodCall<'_>) -> Option<Self> {
+        if !matches!(&call.method,ClassLikeMemberSelector::Identifier(name) if name.value.eq_ignore_ascii_case(b"withMiddleware"))
+        {
+            return None;
+        }
+        let valid = call.argument_list.arguments.len() <= 1
+            && call.argument_list.arguments.iter().all(|arg| match arg {
+                Argument::Positional(arg) => arg.ellipsis.is_none(),
+                Argument::Named(arg) => arg.name.value == b"callback",
+            });
+        Some(Self {
+            end: call.span().end.offset,
+            callback: argument(&call.argument_list, 0, b"callback")
+                .map(|expr| (expr.span().start.offset, expr.span().end.offset)),
+            valid,
+        })
+    }
+}
+pub(super) enum MiddlewareOrder {
+    Absent,
+    Unknown,
+    Opaque,
+    Callbacks(Vec<HashMap<String, u32>>),
+}
+fn parameter<'arena>(
+    params: &FunctionLikeParameterList<'arena>,
+    names: &OwnedResolvedNames,
+) -> Option<&'arena [u8]> {
+    if params.parameters.len() != 1 {
+        return None;
+    }
+    let param = params.parameters.iter().next()?;
+    if param.default_value.is_some()
+        || param.ampersand.is_some()
+        || param.ellipsis.is_some()
+        || !param.attribute_lists.is_empty()
+    {
+        return None;
+    }
+    let Hint::Identifier(hint) = param.hint.as_ref()? else {
+        return None;
+    };
+    resolved_class_fqn(hint, names).filter(|name| name.eq_ignore_ascii_case(MIDDLEWARE))?;
+    Some(param.variable.name)
+}
+fn alias_call(
+    expr: &Expression<'_>,
+    receiver: &[u8],
+    content: &str,
+    keys_remaining: &mut usize,
+) -> Option<HashMap<String, u32>> {
+    let Expression::Call(Call::Method(call)) = unwrapped(expr) else {
+        return None;
+    };
+    if !matches!(unwrapped(call.object),Expression::Variable(Variable::Direct(variable)) if variable.name==receiver)
+        || !matches!(&call.method,ClassLikeMemberSelector::Identifier(name) if name.value.eq_ignore_ascii_case(b"alias"))
+        || call.argument_list.arguments.len() != 1
+    {
+        return None;
+    }
+    super::kernel_middleware::literal_alias_keys(
+        argument(&call.argument_list, 0, b"aliases")?,
+        content,
+        0,
+        keys_remaining,
+    )
+}
+fn callback_keys(
+    expr: &Expression<'_>,
+    content: &str,
+    names: &OwnedResolvedNames,
+    keys_remaining: &mut usize,
+    statements_remaining: &mut usize,
+) -> Option<HashMap<String, u32>> {
+    match unwrapped(expr) {
+        Expression::Literal(Literal::Null(_)) => Some(HashMap::new()),
+        Expression::ArrowFunction(arrow) => alias_call(
+            arrow.expression,
+            parameter(&arrow.parameter_list, names)?,
+            content,
+            keys_remaining,
+        ),
+        Expression::Closure(closure) => {
+            if closure.use_clause.is_some()
+                || !closure.attribute_lists.is_empty()
+                || closure.ampersand.is_some()
+            {
+                return None;
+            }
+            let receiver = parameter(&closure.parameter_list, names)?;
+            let mut keys = HashMap::new();
+            if closure.body.statements.len() > 4096 {
+                return None;
+            }
+            for statement in closure.body.statements.iter() {
+                *statements_remaining = statements_remaining.checked_sub(1)?;
+                match statement {
+                    Statement::Noop(_) => {}
+                    Statement::Expression(statement) => keys.extend(alias_call(
+                        statement.expression,
+                        receiver,
+                        content,
+                        keys_remaining,
+                    )?),
+                    Statement::Return(statement) => {
+                        if let Some(value) = statement.value {
+                            keys.extend(alias_call(value, receiver, content, keys_remaining)?);
+                        }
+                        break;
+                    }
+                    _ => return None,
+                }
+            }
+            Some(keys)
+        }
+        _ => None,
+    }
+}
+impl Backend {
+    pub(super) fn bootstrap_middleware_order(
+        &self,
+        sites: &[MiddlewareSite],
+        complete: bool,
+        source_hash: Option<[u8; 32]>,
+    ) -> MiddlewareOrder {
+        if sites.is_empty() {
+            return MiddlewareOrder::Absent;
+        }
+        if !complete || sites.len() > 4096 || sites.iter().any(|site| !site.valid) {
+            return MiddlewareOrder::Opaque;
+        }
+        let Some(builder) = self.find_or_load_class(BUILDER) else {
+            return MiddlewareOrder::Opaque;
+        };
+        let loader = |name: &str| self.find_or_load_class(name);
+        use crate::inheritance::ancestry::{MethodOrigin, resolve_concrete_method_origin};
+        if !matches!(resolve_concrete_method_origin(&builder,"withMiddleware",&loader),MethodOrigin::Known{owner,..} if owner.fqn().eq_ignore_ascii_case(BUILDER))
+        {
+            return MiddlewareOrder::Opaque;
+        }
+        let Some(root) = self.workspace.workspace_root.read().clone() else {
+            return MiddlewareOrder::Opaque;
+        };
+        let uri = crate::util::path_to_uri(&root.join("bootstrap/app.php"));
+        let Some(content) = self.get_file_content(&uri) else {
+            return MiddlewareOrder::Opaque;
+        };
+        if source_hash != Some(crate::symbol_map::AnonymousCallable::source_hash(&content)) {
+            return MiddlewareOrder::Opaque;
+        }
+        let context = self.source_file_context(&content);
+        let Some(names) = context.resolved_names.as_deref() else {
+            return MiddlewareOrder::Opaque;
+        };
+        let result = crate::parser::with_parsed_program(
+            &content,
+            "builder_middleware_callbacks",
+            |program, content| {
+                if !program.errors.is_empty() {
+                    return None;
+                }
+                let wanted: std::collections::HashSet<_> =
+                    sites.iter().filter_map(|site| site.callback).collect();
+                let mut found = HashMap::new();
+                let mut opaque = false;
+                let mut pending = vec![Node::Program(program)];
+                let mut remaining = 16384usize;
+                let mut keys_remaining = 4096usize;
+                let mut statements_remaining = 4096usize;
+                while let Some(node) = pending.pop() {
+                    let Some(next) = remaining.checked_sub(1) else {
+                        return Some(MiddlewareOrder::Opaque);
+                    };
+                    remaining = next;
+                    if let Node::Expression(expr) = node {
+                        let key = (expr.span().start.offset, expr.span().end.offset);
+                        if wanted.contains(&key) {
+                            opaque |= !matches!(
+                                unwrapped(expr),
+                                Expression::Closure(_)
+                                    | Expression::ArrowFunction(_)
+                                    | Expression::Literal(Literal::Null(_))
+                            );
+                            found.insert(
+                                key,
+                                callback_keys(
+                                    expr,
+                                    content,
+                                    names,
+                                    &mut keys_remaining,
+                                    &mut statements_remaining,
+                                ),
+                            );
+                        }
+                    }
+                    node.visit_children(|child| pending.push(child));
+                }
+                if opaque || found.len() != wanted.len() {
+                    return Some(MiddlewareOrder::Opaque);
+                }
+                let mut ordered: Vec<_> = sites.iter().collect();
+                ordered.sort_by_key(|site| site.end);
+                ordered.dedup_by_key(|site| site.end);
+                ordered
+                    .into_iter()
+                    .map(|site| match site.callback {
+                        None => Some(HashMap::new()),
+                        Some(span) => found.remove(&span).flatten(),
+                    })
+                    .collect::<Option<Vec<_>>>()
+                    .map(MiddlewareOrder::Callbacks)
+            },
+        );
+        match result {
+            Some(order) => order,
+            None => MiddlewareOrder::Unknown,
+        }
+    }
+}

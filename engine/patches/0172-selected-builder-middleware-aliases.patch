+#[tokio::test]
+async fn builder_callback_dynamic_or_conditional_configuration_keeps_incomplete_results_and_physical_guards()
+ {
+    for callback in [
+        ORDERED_CALLBACK.replace("$stack->alias([", "$stack->alias($extra+["),
+        ORDERED_CALLBACK.replace("$stack->alias", "if($condition) $stack->alias"),
+        ORDERED_CALLBACK.replace("$stack->alias", "sideEffect();$stack->alias"),
+        ORDERED_CALLBACK.replace("$stack) {", "$stack) use($extra) {"),
+        "$callback".into(),
+    ] {
+        let bootstrap = format!(
+            "<?php return \\Illuminate\\Foundation\\Application::configure()->withMiddleware({callback})->create();"
+        );
+        let (backend, dir, route, _) = ordered_callback_workspace(&bootstrap, false).await;
+        let detail = hover(&backend, &route, SOURCE, "middleware('aud").await;
+        assert!(detail.contains("incomplete"), "{callback}: {detail}");
+        let target = Url::from_file_path(dir.path().join("app/Http/Middleware/Trace.php")).unwrap();
+        let text = std::fs::read_to_string(target.to_file_path().unwrap()).unwrap();
+        open_document(&backend, &target, "php", &text).await;
+        let result = settled_target_rename(&backend, &target, &text, "class Trac", "Traced").await;
+        if callback == "$callback" || callback.contains("$extra+[") {
+            assert!(
+                result
+                    .as_ref()
+                    .is_err_and(|message| message.contains("middleware")),
+                "{callback}: {result:?}"
+            );
+        } else {
+            assert!(
+                result.is_ok_and(|edit| edit.is_some()),
+                "known physical class references remain renameable: {callback}"
+            );
+        }
+    }
+}

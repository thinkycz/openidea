+#[tokio::test]
+async fn builder_callback_alias_overrides_kernel_property_through_selected_builder_identity() {
+    for bootstrap in [
+        format!(
+            "<?php return \\Illuminate\\Foundation\\Application::configure()->withMiddleware({ORDERED_CALLBACK})->create();"
+        ),
+        format!(
+            "<?php $builder=\\Illuminate\\Foundation\\Application::configure();$builder->withMiddleware({ORDERED_CALLBACK});return $builder->create();"
+        ),
+        format!(
+            "<?php $builder=\\Illuminate\\Foundation\\Application::configure();$alias=$builder->withMiddleware({ORDERED_CALLBACK});$app=$alias->create();return $app;"
+        ),
+    ] {
+        let (backend, dir, route, _) = ordered_callback_workspace(&bootstrap, false).await;
+        let found = definitions(&backend, &route, SOURCE, "middleware('aud").await;
+        assert_eq!(
+            found.len(),
+            1,
+            "scheduled callback must override the Kernel property: {found:?}"
+        );
+        assert_eq!(
+            found[0].uri,
+            Url::from_file_path(dir.path().join("bootstrap/app.php")).unwrap()
+        );
+        assert_eq!(
+            found[0].range.start,
+            position_after(&bootstrap, "/* 😀 */ '")
+        );
+        let detail = hover(&backend, &route, SOURCE, "middleware('aud").await;
+        assert!(
+            detail.contains("Middleware\\Audit")
+                && !detail.contains("Middleware\\Trace")
+                && !detail.contains("incomplete"),
+            "{detail}"
+        );
+        let refs = find_references(
+            &backend,
+            &route,
+            position_after(SOURCE, "middleware('aud"),
+            true,
+        )
+        .await;
+        assert_eq!(
+            refs.len(),
+            2,
+            "effective declaration plus route reference: {refs:?}"
+        );
+    }
+}

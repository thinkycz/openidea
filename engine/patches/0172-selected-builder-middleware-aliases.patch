+    }"#;
+    let bootstrap = format!(
+        "<?php return \\Illuminate\\Foundation\\Application::configure()->withMiddleware({first})->withMiddleware({callback})->create();"
+    );
+    let (backend, dir, route, _) = ordered_callback_workspace(&bootstrap, false).await;
+    let file = Url::from_file_path(dir.path().join("bootstrap/app.php")).unwrap();
+    let assert_winner = |locations: Vec<Location>| {
+        assert_eq!(locations.len(), 1, "{locations:?}");
+        assert_eq!(locations[0].uri, file);
+        assert_eq!(
+            locations[0].range.start,
+            position_after(&bootstrap, "/* 😀 winner */ \"")
+        );
+    };
+    assert_winner(definitions(&backend, &route, SOURCE, "middleware('aud").await);
+    let changed = bootstrap.replace("Middleware\\Audit::class", "Middleware\\Trace::class");
+    open_document(&backend, &file, "php", &bootstrap).await;
+    change(&backend, &file, &changed, 2).await;
+    assert_winner(definitions(&backend, &route, SOURCE, "middleware('aud").await);
+    let detail = hover(&backend, &route, SOURCE, "middleware('aud").await;
+    assert!(
+        detail.contains("Middleware\\Trace")
+            && !detail.contains("Middleware\\Audit")
+            && !detail.contains("incomplete"),
+        "{detail}"
+    );
+    change(&backend, &file, &bootstrap, 3).await;
+    assert_winner(definitions(&backend, &route, SOURCE, "middleware('aud").await);
+    assert!(
+        hover(&backend, &route, SOURCE, "middleware('aud")
+            .await
+            .contains("Middleware\\Audit")
+    );
+    assert_eq!(
+        std::fs::read_to_string(file.to_file_path().unwrap()).unwrap(),
+        bootstrap
+    );
+}

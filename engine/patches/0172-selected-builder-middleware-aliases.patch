+    let kernel=ORDERED_KERNEL_BASE.replace("\n}", &format!("\n protected $middlewareAliases=['audited'=>\\App\\Http\\Middleware\\Trace::class];\n protected $routeMiddleware={};\n public function setMiddlewareAliases(array $aliases) {{$this->middlewareAliases=$aliases;$this->syncMiddlewareToRouter();return $this;}}\n}}",if legacy {"['audited'=>\\App\\Http\\Middleware\\Trace::class]"}else{"[]"}));
+    bound_kernel_workspace(
+        bootstrap,
+        &[
+            ("framework/Foundation/Application.php", FACTORY_APPLICATION),
+            (
+                "framework/Foundation/Configuration/ApplicationBuilder.php",
+                FACTORY_BUILDER,
+            ),
+            (
+                "framework/Foundation/Configuration/Middleware.php",
+                CALLBACK_MIDDLEWARE,
+            ),
+            ("framework/Foundation/Http/Kernel.php", &kernel),
+        ],
+    )
+    .await
+}
+const ORDERED_CALLBACK: &str = r"function(\Illuminate\Foundation\Configuration\Middleware $stack) {$stack->alias([/* 😀 */ 'audited'=>\App\Http\Middleware\Audit::class]);}";

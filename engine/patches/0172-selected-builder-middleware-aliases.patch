+#[tokio::test]
+async fn builder_callback_last_literal_key_and_last_callback_keep_utf16_ranges_and_dirty_refresh() {
+    let first = ORDERED_CALLBACK.replace("Middleware\\Audit::class", "Middleware\\Trace::class");
+    let callback = r#"function(\Illuminate\Foundation\Configuration\Middleware $stack) {
+        $stack->alias(['audited'=>\App\Http\Middleware\Trace::class]);

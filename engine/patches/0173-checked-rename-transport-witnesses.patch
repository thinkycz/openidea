+//! Transport witnesses include documents outside the selected Composer graph.
+use std::{collections::HashSet, path::PathBuf, sync::Arc};
+
+use sha2::{Digest, Sha256};
+use tower_lsp::{
+    jsonrpc::{Error, Result},
+    lsp_types::*,
+};
+
+use super::{ProjectContext, ProjectRouter};
+use crate::workbench_rename::{ExpectedSource, RenameCheckedParams, authority_path, modified};
+
+struct Sources {
+    local: Vec<ExpectedSource>,
+    foreign: HashSet<PathBuf>,
+    foreign_contexts: HashSet<u64>,
+}
+
+impl ProjectRouter {
+    async fn checked_rename_sources(
+        &self,
+        params: &RenameCheckedParams,
+        project: &Arc<ProjectContext>,
+    ) -> Result<Sources> {
+        let state = Arc::clone(&self.state);
+        let project = Arc::clone(project);
+        let params = params.clone();
+        let sources =
+            crate::server::run_blocking_cancel_safe("rename_checked_sources", move || {
+                params.validate()?;
+                let documents = state.documents.read();
+                let routing = state.document_routing.read();
+                let mut local = Vec::new();
+                let mut foreign = HashSet::new();
+                let mut foreign_contexts = HashSet::new();
+                for expected in params.expected_sources {
+                    let uri = expected.uri.as_str();
+                    let document = documents.get(uri).ok_or_else(modified)?;
+                    if document.version != expected.version
+                        || state
+                            .sources
+                            .preferred(uri)
+                            .is_some_and(|active| active != uri)
+                        || !format!("{:x}", Sha256::digest(document.text.as_bytes()))
+                            .eq_ignore_ascii_case(&expected.sha256_utf8)
+                    {
+                        return Err(modified());
+                    }
+                    let consumers = routing.get(uri).ok_or_else(modified)?;
+                    if consumers.consumers.contains(&project.id)
+                        || project.backend.open_files.read().contains_key(uri)
+                    {
+                        local.push(expected);
+                    } else {
+                        foreign.insert(authority_path(&expected.uri)?);
+                        foreign_contexts.extend(&consumers.consumers);
+                    }
+                }
+                Ok(Sources {
+                    local,
+                    foreign,
+                    foreign_contexts,
+                })
+            })
+            .await
+            .ok_or_else(Error::internal_error)??;
+        Ok(sources)
+    }
+
+    /// Attest every supplied transport source and retain selected-graph semantics.
+    pub async fn workbench_rename_checked(
+        &self,
+        params: RenameCheckedParams,
+    ) -> Result<Option<WorkspaceEdit>> {
+        let _gate = self.request_guard().await;
+        let project = self
+            .project_for(&params.rename.text_document_position.text_document.uri)
+            .await?;
+        let before = self.checked_rename_sources(&params, &project).await?;
+        let mut local = params.clone();
+        local.expected_sources = before.local;
+        let reply = project.backend.workbench_rename_checked(local).await?;
+        let after = self.checked_rename_sources(&params, &project).await?;
+        if let Some(edit) = &reply {
+            let mut foreign = before.foreign;
+            foreign.extend(after.foreign);
+            let mut foreign_contexts = before.foreign_contexts;
+            foreign_contexts.extend(after.foreign_contexts);
+            let contexts: Vec<_> = self
+                .state
+                .contexts
+                .read()
+                .iter()
+                .filter(|context| foreign_contexts.contains(&context.id))
+                .cloned()
+                .collect();
+            let edit = edit.clone();
+            crate::server::run_blocking_cancel_safe("rename_checked_targets", move || {
+                check_foreign_targets(&edit, &foreign)?;
+                check_targets(&edit, |uri| {
+                    if contexts.iter().any(|context| context.consumes(uri)) {
+                        Err(Error {
+                            code: tower_lsp::jsonrpc::ErrorCode::InvalidRequest,
+                            message: "Checked PHP rename requires references from another Composer project".into(),
+                            data: None,
+                        })
+                    } else {
+                        Ok(())
+                    }
+                })
+            })
+            .await
+            .ok_or_else(Error::internal_error)??;
+        }
+        Ok(reply)
+    }
+}
+
+fn check_foreign_targets(edit: &WorkspaceEdit, foreign: &HashSet<PathBuf>) -> Result<()> {
+    if foreign.is_empty() {
+        return Ok(());
+    }
+    let check = |uri: &Url| {
+        if foreign.contains(&authority_path(uri)?) {
+            Err(modified())
+        } else {
+            Ok(())
+        }
+    };
+    check_targets(edit, check)
+}
+
+fn check_targets(edit: &WorkspaceEdit, check: impl Fn(&Url) -> Result<()>) -> Result<()> {
+    if let Some(changes) = &edit.changes {
+        for uri in changes.keys() {
+            check(uri)?;
+        }
+    }
+    match &edit.document_changes {
+        Some(DocumentChanges::Edits(edits)) => {
+            for edit in edits {
+                check(&edit.text_document.uri)?;
+            }
+        }
+        Some(DocumentChanges::Operations(operations)) => {
+            for operation in operations {
+                match operation {
+                    DocumentChangeOperation::Edit(edit) => check(&edit.text_document.uri)?,
+                    DocumentChangeOperation::Op(ResourceOp::Create(create)) => check(&create.uri)?,
+                    DocumentChangeOperation::Op(ResourceOp::Delete(delete)) => check(&delete.uri)?,
+                    DocumentChangeOperation::Op(ResourceOp::Rename(rename)) => {
+                        check(&rename.old_uri)?;
+                        check(&rename.new_uri)?;
+                    }
+                }
+            }
+        }
+        None => {}
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn foreign_targets_cannot_borrow_a_transport_only_witness() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("Foreign.php");
+        std::fs::write(&path, "<?php").unwrap();
+        let uri = Url::from_file_path(&path).unwrap();
+        let foreign = HashSet::from([path.canonicalize().unwrap()]);
+        let edit = WorkspaceEdit {
+            changes: Some([(uri.clone(), Vec::new())].into_iter().collect()),
+            ..Default::default()
+        };
+        assert_eq!(
+            check_foreign_targets(&edit, &foreign).unwrap_err().code,
+            tower_lsp::jsonrpc::ErrorCode::ServerError(-32801)
+        );
+        let local = Url::from_file_path(dir.path().join("Local.php")).unwrap();
+        let edit = WorkspaceEdit {
+            document_changes: Some(DocumentChanges::Operations(vec![
+                DocumentChangeOperation::Op(ResourceOp::Rename(RenameFile {
+                    old_uri: local,
+                    new_uri: uri,
+                    options: None,
+                    annotation_id: None,
+                })),
+            ])),
+            ..Default::default()
+        };
+        assert!(check_foreign_targets(&edit, &foreign).is_err());
+        assert!(check_foreign_targets(&WorkspaceEdit::default(), &foreign).is_ok());
+    }
+}

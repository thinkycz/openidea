+#[tokio::test]
+async fn compatible_kernel_trait_defaults_preserve_complete_navigation_and_all_rename_inputs() {
+    let kernel = r"<?php namespace App\Http;
+use App\Http\Middleware\Audit as Selected;
+class Kernel extends \Illuminate\Foundation\Http\Kernel {
+    use AliasDefaults;
+    protected $middlewareAliases = ['audited' => Selected::class];
+}";
+    let defaults = r#"<?php namespace App\Http;
+use App\Http\Middleware\Audit as Shared;
+trait AliasDefaults {
+    protected $middlewareAliases = ["au\x64ited" => Shared::class];
+}"#;
+    let (backend, dir, caller, kernel_uri) =
+        kernel_workspace_extra(kernel, &[("app/Http/AliasDefaults.php", defaults)]).await;
+    let detail = hover(&backend, &caller, SOURCE, "middleware('aud").await;
+    assert!(
+        !detail.contains("incomplete") && detail.contains("Middleware\\Audit"),
+        "{detail}"
+    );
+    let locations = definitions(&backend, &caller, SOURCE, "middleware('aud").await;
+    assert_eq!(locations.len(), 1, "{locations:?}");
+    assert_eq!(locations[0].uri, kernel_uri);
+    let target = Url::from_file_path(dir.path().join("app/Http/Middleware/Audit.php")).unwrap();
+    let target_text = std::fs::read_to_string(target.to_file_path().unwrap()).unwrap();
+    open_document(&backend, &target, "php", &target_text).await;
+    let edit = settled_target_rename(&backend, &target, &target_text, "class Aud", "Auditor")
+        .await
+        .unwrap()
+        .unwrap();
+    let defaults_uri = Url::from_file_path(dir.path().join("app/Http/AliasDefaults.php")).unwrap();
+    let changed = crate::common::apply_edits(
+        defaults,
+        &crate::common::edits_for_uri(&edit, &defaults_uri),
+    );
+    assert!(
+        changed.contains("Middleware\\Auditor as Shared"),
+        "{changed}"
+    );
+    let changed_kernel =
+        crate::common::apply_edits(kernel, &crate::common::edits_for_uri(&edit, &kernel_uri));
+    assert!(
+        changed_kernel.contains("Middleware\\Auditor as Selected"),
+        "{changed_kernel}"
+    );
+
+    open_document(&backend, &defaults_uri, "php", defaults).await;
+    let literal = defaults.replace("Shared::class", "'App\\\\Http\\\\Middleware\\\\Audit'");
+    change(&backend, &defaults_uri, &literal, 2).await;
+    let detail = hover(&backend, &caller, SOURCE, "middleware('aud").await;
+    assert!(!detail.contains("incomplete"), "{detail}");
+    assert!(
+        settled_target_rename(&backend, &target, &target_text, "class Aud", "Auditor")
+            .await
+            .as_ref()
+            .is_err_and(|message| message.contains("literal middleware"))
+    );
+    let incompatible = defaults.replace("Middleware\\Audit", "Middleware\\Trace");
+    change(&backend, &defaults_uri, &incompatible, 3).await;

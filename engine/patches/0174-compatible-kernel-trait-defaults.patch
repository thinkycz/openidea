+    change(&backend, &defaults_uri, defaults, 4).await;
+    let detail = hover(&backend, &caller, SOURCE, "middleware('aud").await;
+    assert!(!detail.contains("incomplete"), "{detail}");
+    assert_eq!(
+        std::fs::read_to_string(defaults_uri.to_file_path().unwrap()).unwrap(),
+        defaults
+    );
+}

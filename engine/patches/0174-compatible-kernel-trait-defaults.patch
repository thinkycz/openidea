+//! PHP compatibility proof for composed HTTP Kernel alias properties.
+use crate::{
+    Backend,
+    names::OwnedResolvedNames,
+    types::{ClassInfo, ClassLikeKind, MAX_TRAIT_DEPTH, PropertyInfo, Visibility},
+};
+use mago_span::HasSpan;
+use mago_syntax::cst::{
+    Access, ArrayElement, ClassLikeConstantSelector, Expression, Modifier, Node, Property,
+    PropertyItem,
+};
+use std::{
+    collections::{HashMap, HashSet},
+    sync::Arc,
+};
+
+type AliasDefault = Vec<(String, String)>;
+
+// PHP replaces a repeated string key without moving its original position.
+fn insert_value(
+    values: &mut AliasDefault,
+    indices: &mut HashMap<String, usize>,
+    key: String,
+    value: String,
+) {
+    if let Some(index) = indices.get(&key) {
+        values[*index].1 = value;
+    } else {
+        indices.insert(key.clone(), values.len());
+        values.push((key, value));
+    }
+}
+
+fn literal_default(
+    expression: &Expression<'_>,
+    content: &str,
+    names: &OwnedResolvedNames,
+    depth: u32,
+    remaining: &mut usize,
+) -> Option<AliasDefault> {
+    if depth >= MAX_TRAIT_DEPTH {
+        return None;
+    }
+    let mut values: AliasDefault = Vec::new();
+    let mut indices = HashMap::new();
+    for element in
+        crate::parser::array_literal_elements(crate::parser::unwrap_parens(expression))?.iter()
+    {
+        *remaining = remaining.checked_sub(1)?;
+        match element {
+            ArrayElement::KeyValue(pair) => {
+                let (key, _, _) = super::helpers::resolved_string_literal(
+                    crate::parser::unwrap_parens(pair.key),
+                    content,
+                )?;
+                if key.is_empty()
+                    || key
+                        .parse::<i64>()
+                        .is_ok_and(|value| value.to_string() == key)
+                {
+                    return None;
+                }
+                let value = crate::parser::unwrap_parens(pair.value);
+                let target = if let Some((text, _, _)) =
+                    super::helpers::resolved_string_literal(value, content)
+                {
+                    text.to_owned()
+                } else if let Expression::Access(Access::ClassConstant(class)) = value {
+                    if !matches!(&class.constant, ClassLikeConstantSelector::Identifier(name) if name.value.eq_ignore_ascii_case(b"class"))
+                    {
+                        return None;
+                    }
+                    let qualifier = crate::parser::unwrap_parens(class.class);
+                    if !matches!(qualifier, Expression::Identifier(_)) {
+                        return None;
+                    }
+                    let text = names
+                        .get(qualifier.span().start.offset)?
+                        .trim_start_matches('\\');
+                    if ["self", "static", "parent"]
+                        .iter()
+                        .any(|keyword| text.eq_ignore_ascii_case(keyword))
+                    {
+                        return None;
+                    }
+                    text.to_owned()
+                } else {
+                    return None;
+                };
+                insert_value(&mut values, &mut indices, key.to_owned(), target);
+            }
+            ArrayElement::Variadic(spread) => {
+                for (key, value) in
+                    literal_default(spread.value, content, names, depth + 1, remaining)?
+                {
+                    insert_value(&mut values, &mut indices, key, value);
+                }
+            }
+            _ => return None,
+        }
+    }
+    Some(values)
+}
+
+struct TraitWalk {
+    active: HashSet<crate::atom::Atom>,
+    done: HashSet<crate::atom::Atom>,
+    remaining: usize,
+}
+
+fn declarations(
+    scope: &ClassInfo,
+    name: &str,
+    loader: &dyn Fn(&str) -> Option<Arc<ClassInfo>>,
+    depth: u32,
+    walk: &mut TraitWalk,
+    result: &mut Vec<Arc<ClassInfo>>,
+) -> Option<()> {
+    if depth >= MAX_TRAIT_DEPTH {
+        return None;
+    }
+    for used in &scope.used_traits {
+        walk.remaining = walk.remaining.checked_sub(1)?;
+        let used = loader(used)?;
+        if walk.done.contains(&used.fqn()) {
+            continue;
+        }
+        if used.kind != ClassLikeKind::Trait || !walk.active.insert(used.fqn()) {
+            return None;
+        }
+        if used
+            .get_property(name)
+            .is_some_and(|property| !property.is_virtual)
+            && !result.iter().any(|previous| previous.fqn() == used.fqn())
+        {
+            result.push(Arc::clone(&used));
+        }
+        declarations(&used, name, loader, depth + 1, walk, result)?;
+        walk.active.remove(&used.fqn());
+        walk.done.insert(used.fqn());
+    }
+    Some(())
+}
+
+fn same_declaration(left: &PropertyInfo, right: &PropertyInfo) -> bool {
+    !left.is_virtual
+        && !right.is_virtual
+        && !left.is_static
+        && !right.is_static
+        && !left.is_readonly
+        && !right.is_readonly
+        && left.visibility == right.visibility
+        && left.native_type_hint == right.native_type_hint
+}
+
+impl Backend {
+    fn kernel_property_default(&self, owner: &ClassInfo, name: &str) -> Option<AliasDefault> {
+        if owner.is_readonly
+            || owner
+                .properties
+                .iter()
+                .filter(|property| !property.is_virtual && property.name.as_str() == name)
+                .count()
+                != 1
+        {
+            return None;
+        }
+        let property = owner.get_property(name)?;
+        let uri = self.find_class_file_uri_for_fqn(&owner.fqn())?;
+        let content = self.get_file_content(&uri)?;
+        let context = self.source_file_context(&content);
+        let current = context
+            .classes
+            .iter()
+            .find(|class| class.fqn() == owner.fqn())?;
+        let current_property = current.get_property(name)?;
+        if current.kind != owner.kind
+            || current.is_readonly
+            || current.keyword_offset != owner.keyword_offset
+            || current_property.name_offset != property.name_offset
+            || current_property.source != property.source
+            || !same_declaration(current_property, property)
+        {
+            return None;
+        }
+        let names = context.resolved_names.as_deref()?;
+        crate::parser::with_parsed_program(&content, "kernel_trait_default", |program, content| {
+            if !program.errors.is_empty() {
+                return None;
+            }
+            let mut pending = vec![Node::Program(program)];
+            let mut remaining = 16_384usize;
+            while let Some(node) = pending.pop() {
+                remaining = remaining.checked_sub(1)?;
+                if let Node::Property(Property::Plain(plain)) = node {
+                    for item in plain.items.iter() {
+                        if item.variable().span.start.offset != property.name_offset {
+                            continue;
+                        }
+                        if plain.modifiers.iter().any(|modifier| {
+                            !matches!(
+                                modifier,
+                                Modifier::Public(_) | Modifier::Protected(_) | Modifier::Private(_)
+                            )
+                        }) {
+                            return None;
+                        }
+                        let PropertyItem::Concrete(item) = item else {
+                            return None;
+                        };
+                        return literal_default(item.value, content, names, 0, &mut 4096);
+                    }
+                }
+                if !matches!(node, Node::Method(_) | Node::HookedProperty(_)) {
+                    node.visit_children(|child| pending.push(child));
+                }
+            }
+            None
+        })
+    }
+
+    pub(super) fn compatible_kernel_property_origins(
+        &self,
+        scopes: &[Arc<ClassInfo>],
+        loader: &dyn Fn(&str) -> Option<Arc<ClassInfo>>,
+    ) -> Option<Vec<(Arc<ClassInfo>, &'static str)>> {
+        let mut physical = Vec::new();
+        for scope in scopes {
+            for name in ["middlewareAliases", "routeMiddleware"] {
+                let mut group = Vec::new();
+                declarations(
+                    scope,
+                    name,
+                    loader,
+                    0,
+                    &mut TraitWalk {
+                        active: HashSet::new(),
+                        done: HashSet::new(),
+                        remaining: 16_384,
+                    },
+                    &mut group,
+                )?;
+                if group.is_empty() {
+                    continue;
+                }
+                let declares = |candidate: &ClassInfo| {
+                    candidate
+                        .get_property(name)
+                        .is_some_and(|property| !property.is_virtual)
+                };
+                let inherited =
+                    crate::inheritance::ancestors(scope, loader).find_map(|(_, parent)| {
+                        let owner = if declares(&parent) {
+                            Some(parent)
+                        } else {
+                            crate::inheritance::find_declaring_trait(
+                                &parent.used_traits,
+                                loader,
+                                &declares,
+                            )
+                            .map(|(_, owner)| owner)
+                        }?;
+                        (owner.get_property(name)?.visibility != Visibility::Private)
+                            .then_some(owner)
+                    });
+                if declares(scope) {
+                    if let Some(parent) = inherited {
+                        let own = scope.get_property(name)?;
+                        let inherited = parent.get_property(name)?;
+                        // A class may change its parent's default, but not its native type or storage.
+                        if own.native_type_hint != inherited.native_type_hint
+                            || own.is_static != inherited.is_static
+                            || own.is_readonly != inherited.is_readonly
+                            || (inherited.visibility == Visibility::Public
+                                && own.visibility != Visibility::Public)
+                        {
+                            return None;
+                        }
+                        self.kernel_property_default(&parent, name)?;
+                    }
+                    group.push(Arc::clone(scope));
+                } else if let Some(inherited) = inherited {
+                    group.push(inherited);
+                }
+                if group.len() < 2 {
+                    continue;
+                }
+                let first = group[0].get_property(name)?;
+                let default = self.kernel_property_default(&group[0], name)?;
+                for owner in &group {
+                    if !same_declaration(first, owner.get_property(name)?)
+                        || self.kernel_property_default(owner, name)? != default
+                    {
+                        return None;
+                    }
+                }
+                for owner in group {
+                    if !physical
+                        .iter()
+                        .any(|(previous, previous_name): &(Arc<ClassInfo>, &str)| {
+                            *previous_name == name && previous.fqn() == owner.fqn()
+                        })
+                    {
+                        physical.push((owner, name));
+                    }
+                }
+            }
+        }
+        // Shadowed properties remain transformation inputs: a private parent or
+        // overridden default can still contain a literal target that cannot be edited.
+        for scope in scopes {
+            for name in ["middlewareAliases", "routeMiddleware"] {
+                if scope
+                    .get_property(name)
+                    .is_some_and(|property| !property.is_virtual && !property.is_static)
+                    && !physical.iter().any(|(owner, previous_name)| {
+                        *previous_name == name && owner.fqn() == scope.fqn()
+                    })
+                {
+                    physical.push((Arc::clone(scope), name));
+                }
+            }
+        }
+        Some(physical)
+    }
+}

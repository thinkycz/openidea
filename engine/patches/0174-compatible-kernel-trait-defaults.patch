+#[tokio::test]
+async fn kernel_trait_compatibility_uses_php_array_values_order_and_declaration_flags() {
+    let kernel = r"<?php namespace App\Http;
+use App\Http\Middleware\Audit as Selected;
+class Kernel extends \Illuminate\Foundation\Http\Kernel {
+    use AliasDefaults;
+    protected $middlewareAliases = ['audited'=>Selected::class, 'other'=>'other'];
+}";
+    for (property, expected_complete) in [
+        (
+            r"protected $middlewareAliases = ['audited'=>\App\Http\Middleware\Trace::class, ...['audited'=>\App\Http\Middleware\Audit::class], 'other'=>'other'];",
+            true,
+        ),
+        (
+            r"protected $middlewareAliases = ['other'=>'other', 'audited'=>\App\Http\Middleware\Audit::class];",
+            false,
+        ),
+        (
+            r"protected $middlewareAliases = ['audited'=>\App\Http\Middleware\Audit::class, 'other'=>1];",
+            false,
+        ),
+        (
+            r"public $middlewareAliases = ['audited'=>\App\Http\Middleware\Audit::class, 'other'=>'other'];",
+            false,
+        ),
+        (
+            r"protected array $middlewareAliases = ['audited'=>\App\Http\Middleware\Audit::class, 'other'=>'other'];",
+            false,
+        ),
+        (
+            r"protected $middlewareAliases = ['audited'=>self::class, 'other'=>'other'];",
+            false,
+        ),
+        (r"protected $middlewareAliases = DEFAULT_ALIASES;", false),
+        (
+            r"protected $middlewareAliases = ['audited'=>\App\Other\Audit::class, 'other'=>'other'];",
+            false,
+        ),
+    ] {
+        let defaults = format!("<?php namespace App\\Http; trait AliasDefaults {{{property}}}");
+        let (backend, _dir, caller, _) =
+            kernel_workspace_extra(kernel, &[("app/Http/AliasDefaults.php", &defaults)]).await;
+        let detail = hover(&backend, &caller, SOURCE, "middleware('aud").await;
+        assert_eq!(
+            !detail.contains("incomplete"),
+            expected_complete,
+            "{property}: {detail}"
+        );
+    }

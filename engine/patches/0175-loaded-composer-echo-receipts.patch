+async fn composer_project_contexts_foreign_manifest_consumer_keeps_conservative_reload() {
+    let fixture = projects_with_distinct_php_targets();
+    let manifest = fixture.path("a", "composer.json");
+    let mut package: serde_json::Value =
+        serde_json::from_slice(&fs::read(&manifest).unwrap()).unwrap();
+    package["autoload"]["psr-4"]["Shared\\"] = serde_json::json!("../b/");
+    fs::write(&manifest, package.to_string()).unwrap();
+    let router = full_stub_router(&fixture).await;
+    let a = fixture.path("a", "builtin.php");
+    let b = fixture.path("b", "builtin.php");
+    let a_source = open(&router, &a).await;
+    let b_source = open(&router, &b).await;
+    let a_uri = datetime_definition(&router, &a, &a_source).await;
+    let b_uri = datetime_definition(&router, &b, &b_source).await;
+    router
+        .did_change_watched_files(DidChangeWatchedFilesParams {
+            changes: vec![FileEvent {
+                uri: Url::from_file_path(fixture.path("b", "composer.json")).unwrap(),
+                typ: FileChangeType::CHANGED,
+            }],
+        })
+        .await;
+    for uri in [&a_uri, &b_uri] {
+        assert!(
+            router
+                .workbench_builtin(BuiltinQuery {
+                    uri: uri.to_string()
+                })
+                .await
+                .is_err(),
+            "one root's receipt cannot stand in for another consuming graph: {uri}"
+        );
+    }
+    router.shutdown().await.unwrap();

+#[cfg(unix)]
+#[tokio::test]
+async fn composer_project_contexts_equal_bytes_replacement_still_retires_builtin_identity() {
+    let fixture = projects_with_distinct_php_targets();
+    let router = full_stub_router(&fixture).await;
+    let a = fixture.path("a", "builtin.php");
+    let source = open(&router, &a).await;
+    let old = datetime_definition(&router, &a, &source).await;
+    let manifest = fixture.path("a", "composer.json");
+    let replacement = fixture.path("a", "replacement.json");
+    fs::write(&replacement, fs::read(&manifest).unwrap()).unwrap();
+    fs::rename(&replacement, &manifest).unwrap();
+    router
+        .did_change_watched_files(DidChangeWatchedFilesParams {
+            changes: vec![FileEvent {
+                uri: Url::from_file_path(&manifest).unwrap(),
+                typ: FileChangeType::CHANGED,
+            }],
+        })
+        .await;
+    assert!(
+        router
+            .workbench_builtin(BuiltinQuery {
+                uri: old.to_string()
+            })
+            .await
+            .is_err(),
+        "equal content must not conceal replacement of the loaded input"
+    );
+    let fresh = datetime_definition(&router, &a, &source).await;
+    assert_ne!(fresh, old);
+    router
+        .did_change_watched_files(DidChangeWatchedFilesParams {
+            changes: vec![FileEvent {
+                uri: Url::from_file_path(&manifest).unwrap(),
+                typ: FileChangeType::CHANGED,
+            }],
+        })
+        .await;
+    assert!(
+        router
+            .workbench_builtin(BuiltinQuery {
+                uri: fresh.to_string()
+            })
+            .await
+            .is_ok(),
+        "the new exact loaded state can subsequently be recognized"
+    );
+    router.shutdown().await.unwrap();
+}

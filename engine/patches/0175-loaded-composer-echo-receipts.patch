+    let f = Fixture::new("# initial global profile\n", "").await;
+    let mut seen = Inputs::new();
+    f.apply(&mut seen).await;
+    assert_eq!(f.target().await.php_version, "8.2");
+    std::fs::write(&f.global, "# changed global profile\n").unwrap();
+    let composer = f.root.join("composer.json");
+    std::fs::write(
+        &composer,
+        r#"{"name":"owned/global-target","require":{"php":"^8.5"}}"#,
+    )
+    .unwrap();
+    let hook = Arc::new(TestHook {
+        stage: 0,
+        entered: tokio::sync::Notify::new(),
+        release: tokio::sync::Notify::new(),
+    });
+    *f.router.state.test_global_hook.lock() = Some(Arc::clone(&hook));
+    let state = Arc::clone(&f.router.state);
+    let job = tokio::spawn(async move {
+        let router = ProjectRouter {
+            state,
+            owns_supervisor: false,
+        };
+        let gate = Arc::clone(&router.state.gate);
+        let _guard = gate.write().await;
+        let retry = router.reconcile_global_locked(&mut seen).await;
+        (retry, seen)
+    });
+    tokio::time::timeout(Duration::from_secs(10), hook.entered.notified())
+        .await

+    for (uri, version) in [(&a_uri, "8.2"), (&b_uri, "8.4")] {
+        let document = router
+            .workbench_builtin(BuiltinQuery {
+                uri: uri.to_string(),
+            })
+            .await
+            .expect("an echo of the exact loaded manifest must not retire a builtin owner");
+        assert_eq!(document.uri, uri.as_str());
+        assert!(document.content.contains("class DateTime"));
+        assert_eq!(
+            router
+                .workbench_active_target(ProjectTargetQuery {
+                    uri: Some(uri.clone())
+                })
+                .await
+                .unwrap()
+                .php_version,
+            version
+        );
+    }
+    assert_eq!(datetime_definition(&router, &a, &a_source).await, a_uri);
+    assert_eq!(datetime_definition(&router, &b, &b_source).await, b_uri);
+
+    let index = fixture.path("a", "index.php");
+    let index_source = open(&router, &index).await;
+    assert_members(&router, &index, &index_source, "fromA", &["fromB"]).await;
+    let service = fixture.path("a", "src/Service.php");
+    fs::write(
+        &service,
+        fs::read_to_string(&service)
+            .unwrap()
+            .replace("fromA", "freshA"),
+    )
+    .unwrap();
+    router
+        .did_change_watched_files(DidChangeWatchedFilesParams {
+            changes: vec![
+                FileEvent {
+                    uri: Url::from_file_path(fixture.path("a", "composer.json")).unwrap(),
+                    typ: FileChangeType::CHANGED,
+                },
+                FileEvent {
+                    uri: Url::from_file_path(&service).unwrap(),
+                    typ: FileChangeType::CHANGED,
+                },
+            ],
+        })
+        .await;
+    assert_members(
+        &router,
+        &index,
+        &index_source,
+        "freshA",
+        &["fromA", "fromB"],
+    )
+    .await;
+    assert!(
+        router
+            .workbench_builtin(BuiltinQuery {
+                uri: a_uri.to_string()
+            })
+            .await
+            .is_ok(),
+        "an echo must not consume an unrelated PHP change or rebuild its owner"
+    );
+
+    let manifest = fixture.path("a", "composer.json");
+    let mut package: serde_json::Value =
+        serde_json::from_slice(&fs::read(&manifest).unwrap()).unwrap();
+    package["config"] = serde_json::json!({"platform":{"php":"8.3.0"}});
+    fs::write(&manifest, package.to_string()).unwrap();
+    router
+        .did_change_watched_files(DidChangeWatchedFilesParams {
+            changes: vec![FileEvent {
+                uri: Url::from_file_path(&manifest).unwrap(),
+                typ: FileChangeType::CHANGED,
+            }],
+        })
+        .await;
+    for uri in [&a_uri, &b_uri] {
+        assert!(
+            router
+                .workbench_builtin(BuiltinQuery {
+                    uri: uri.to_string()
+                })
+                .await
+                .is_err(),
+            "actual metadata changes must still retire the old graph: {uri}"
+        );
+    }
+    let fresh = datetime_definition(&router, &a, &a_source).await;
+    assert_ne!(fresh, a_uri);
+    assert_eq!(
+        router
+            .workbench_active_target(ProjectTargetQuery { uri: Some(fresh) })
+            .await
+            .unwrap()
+            .php_version,
+        "8.3"
+    );
+    router.shutdown().await.unwrap();
+}

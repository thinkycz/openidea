+//! Receipts for the exact manifest bytes consumed during startup.
+use std::fs::File;
+use std::io::Read;
+use std::path::Path;
+
+#[cfg(unix)]
+use sha2::{Digest, Sha256};
+#[cfg(unix)]
+use std::{fs::Metadata, os::unix::fs::MetadataExt, path::PathBuf};
+
+use super::ComposerPackage;
+
+#[cfg(unix)]
+const LIMIT: u64 = 1024 * 1024;
+
+#[cfg(unix)]
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct FileStamp {
+    device: u64,
+    inode: u64,
+    mode: u32,
+    len: u64,
+    modified: (i64, i64),
+    changed: (i64, i64),
+}
+
+#[cfg(unix)]
+impl FileStamp {
+    fn new(metadata: &Metadata) -> Option<Self> {
+        (metadata.is_file() && metadata.len() <= LIMIT).then(|| Self {
+            device: metadata.dev(),
+            inode: metadata.ino(),
+            mode: metadata.mode(),
+            len: metadata.len(),
+            modified: (metadata.mtime(), metadata.mtime_nsec()),
+            changed: (metadata.ctime(), metadata.ctime_nsec()),
+        })
+    }
+}
+
+#[cfg(unix)]
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct ComposerInputReceipt {
+    path: PathBuf,
+    stamp: FileStamp,
+    digest: [u8; 32],
+}
+
+#[cfg(not(unix))]
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) enum ComposerInputReceipt {}
+
+impl ComposerInputReceipt {
+    pub(crate) fn matches_current(&self, root: &Path) -> bool {
+        #[cfg(unix)]
+        {
+            if identity(&root.join("composer.json"))
+                != Some((self.path.clone(), self.stamp.clone()))
+            {
+                return false;
+            }
+            read_with(root, |file, content| {
+                file.take(LIMIT + 1).read_to_string(content)
+            })
+            .and_then(|(_, receipt)| receipt)
+            .as_ref()
+                == Some(self)
+        }
+        #[cfg(not(unix))]
+        {
+            let _ = root;
+            false
+        }
+    }
+}
+
+#[cfg(unix)]
+fn identity(path: &Path) -> Option<(PathBuf, FileStamp)> {
+    let canonical = path.canonicalize().ok()?;
+    if canonical != path {
+        return None;
+    }
+    let stamp = FileStamp::new(&std::fs::symlink_metadata(path).ok()?)?;
+    Some((canonical, stamp))
+}
+
+#[cfg(unix)]
+fn open_regular_input(path: &Path) -> std::io::Result<File> {
+    use rustix::fs::{Mode, OFlags};
+    // A substituted FIFO must not block open; the descriptor type is checked next.
+    rustix::fs::open(
+        path,
+        OFlags::RDONLY | OFlags::NONBLOCK | OFlags::CLOEXEC,
+        Mode::empty(),
+    )
+    .map(File::from)
+    .map_err(Into::into)
+}
+
+#[cfg(not(unix))]
+fn open_regular_input(path: &Path) -> std::io::Result<File> {
+    if !std::fs::metadata(path)?.is_file() {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            "manifest is not a regular file",
+        ));
+    }
+    File::open(path)
+}
+
+/// Missing proof does not prevent parsing ordinary manifests, including large ones.
+pub(crate) fn read_composer_package_with_receipt(
+    root: &Path,
+) -> Option<(ComposerPackage, Option<ComposerInputReceipt>)> {
+    read_with(root, |file, content| {
+        let length = file.metadata()?.len();
+        file.take(length.saturating_add(1)).read_to_string(content)
+    })
+}
+
+fn read_with(
+    root: &Path,
+    read: impl FnOnce(&mut File, &mut String) -> std::io::Result<usize>,
+) -> Option<(ComposerPackage, Option<ComposerInputReceipt>)> {
+    let path = root.join("composer.json");
+    #[cfg(unix)]
+    let before = identity(&path);
+    let mut file = open_regular_input(&path).ok()?;
+    if !file.metadata().ok()?.is_file() {
+        return None;
+    }
+    let mut content = String::new();
+    read(&mut file, &mut content).ok()?;
+    let package = content.parse::<ComposerPackage>().ok()?;
+    #[cfg(unix)]
+    let receipt = (|| {
+        let (path_before, stamp) = before?;
+        if stamp.len != content.len() as u64
+            || FileStamp::new(&file.metadata().ok()?).as_ref() != Some(&stamp)
+            || identity(&path) != Some((path_before.clone(), stamp.clone()))
+        {
+            return None;
+        }
+        Some(ComposerInputReceipt {
+            path: path_before,
+            stamp,
+            digest: Sha256::digest(content.as_bytes()).into(),
+        })
+    })();
+    #[cfg(not(unix))]
+    let receipt = None;
+    Some((package, receipt))
+}
+
+#[cfg(all(test, unix))]
+mod tests {
+    use super::*;
+
+    const JSON: &str = r#"{"require":{"php":"^8.2"}}"#;
+
+    fn fixture() -> (tempfile::TempDir, PathBuf) {
+        let temp = tempfile::tempdir().unwrap();
+        let root = temp.path().canonicalize().unwrap();
+        std::fs::write(root.join("composer.json"), JSON).unwrap();
+        (temp, root)
+    }
+
+    #[test]
+    fn receipt_matches_the_actual_parsed_input_and_unchanged_file() {
+        let (_temp, root) = fixture();
+        let (package, receipt) = read_composer_package_with_receipt(&root).unwrap();
+        assert_eq!(package.require.get("php").map(String::as_str), Some("^8.2"));
+        let receipt = receipt.unwrap();
+        assert_eq!(
+            receipt.digest,
+            <[u8; 32]>::from(Sha256::digest(JSON.as_bytes()))
+        );
+        assert!(receipt.matches_current(&root));
+    }
+
+    #[test]
+    fn replacement_deletion_and_changed_bytes_do_not_match() {
+        let (_temp, root) = fixture();
+        let receipt = read_composer_package_with_receipt(&root)
+            .unwrap()
+            .1
+            .unwrap();
+        let replacement = root.join("replacement.json");
+        std::fs::write(&replacement, JSON).unwrap();
+        std::fs::rename(&replacement, root.join("composer.json")).unwrap();
+        assert!(
+            !receipt.matches_current(&root),
+            "equal bytes cannot hide a new inode"
+        );
+        let fresh = read_composer_package_with_receipt(&root)
+            .unwrap()
+            .1
+            .unwrap();
+        std::fs::write(root.join("composer.json"), r#"{"require":{"php":"^8.4"}}"#).unwrap();
+        assert!(!fresh.matches_current(&root));
+        std::fs::remove_file(root.join("composer.json")).unwrap();
+        assert!(!fresh.matches_current(&root));
+    }
+
+    #[test]
+    fn a_change_during_read_keeps_old_parsed_bytes_but_withdraws_the_receipt() {
+        let (_temp, root) = fixture();
+        let (package, receipt) = read_with(&root, |file, content| {
+            let count = file.read_to_string(content)?;
+            std::fs::write(root.join("composer.json"), r#"{"require":{"php":"^8.4"}}"#)?;
+            Ok(count)
+        })
+        .unwrap();
+        assert_eq!(package.require.get("php").map(String::as_str), Some("^8.2"));
+        assert!(
+            receipt.is_none(),
+            "later file state must not label earlier consumed bytes"
+        );
+        let (current, receipt) = read_composer_package_with_receipt(&root).unwrap();
+        assert_eq!(current.require.get("php").map(String::as_str), Some("^8.4"));
+        assert!(receipt.unwrap().matches_current(&root));
+    }
+
+    #[test]
+    fn a_nonregular_manifest_is_refused_before_invoking_the_reader() {
+        let (_temp, root) = fixture();
+        std::fs::remove_file(root.join("composer.json")).unwrap();
+        std::fs::create_dir(root.join("composer.json")).unwrap();
+        let result = read_with(&root, |_, _| panic!("nonregular input reached the reader"));
+        assert!(result.is_none());
+    }
+
+    #[test]
+    fn fifo_replacement_cannot_block_receipt_or_startup_reads() {
+        let (_temp, root) = fixture();
+        let receipt = read_composer_package_with_receipt(&root)
+            .unwrap()
+            .1
+            .unwrap();
+        let path = root.join("composer.json");
+        std::fs::remove_file(&path).unwrap();
+        assert!(
+            std::process::Command::new("/usr/bin/mkfifo")
+                .arg(&path)
+                .status()
+                .unwrap()
+                .success()
+        );
+        assert!(!receipt.matches_current(&root));
+        assert!(read_composer_package_with_receipt(&root).is_none());
+    }
+
+    #[test]
+    fn uncertain_inputs_keep_parsing_but_have_no_receipt() {
+        let (_temp, root) = fixture();
+        let alias = root.join("alias");
+        std::os::unix::fs::symlink(&root, &alias).unwrap();
+        assert!(
+            read_composer_package_with_receipt(&alias)
+                .unwrap()
+                .1
+                .is_none()
+        );
+        let manifest = root.join("composer.json");
+        std::fs::rename(&manifest, root.join("real.json")).unwrap();
+        std::os::unix::fs::symlink(root.join("real.json"), &manifest).unwrap();
+        let (package, receipt) = read_composer_package_with_receipt(&root).unwrap();
+        assert_eq!(package.require.get("php").map(String::as_str), Some("^8.2"));
+        assert!(receipt.is_none());
+        std::fs::remove_file(&manifest).unwrap();
+        std::fs::write(
+            &manifest,
+            serde_json::json!({"description":"x".repeat(LIMIT as usize+1)}).to_string(),
+        )
+        .unwrap();
+        assert!(
+            read_composer_package_with_receipt(&root)
+                .unwrap()
+                .1
+                .is_none()
+        );
+        std::fs::write(&manifest, "{broken").unwrap();
+        assert!(read_composer_package_with_receipt(&root).is_none());
+    }
+}

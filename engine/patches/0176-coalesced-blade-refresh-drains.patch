diff --git a/src/blade/refresh_drain.rs b/src/blade/refresh_drain.rs
new file mode 100644
index 000000000..29fd302c8
--- /dev/null
+++ b/src/blade/refresh_drain.rs
@@ -0,0 +1,212 @@
+//! Coalesce overlapping passes while each caller retains its publication guard.
+use parking_lot::{Condvar, Mutex};
+use std::sync::Arc;
+
+/// Admission shared by all workers for one backend. No source payloads are retained.
+#[derive(Default)]
+pub(crate) struct RefreshDrain {
+    state: Mutex<State>,
+}
+#[derive(Default)]
+struct State {
+    active: Option<Arc<Completion>>,
+    requested: bool,
+}
+#[derive(Default)]
+struct Completion {
+    done: Mutex<Option<bool>>,
+    changed: Condvar,
+}
+/// A producer or a caller joining an existing flight.
+pub(crate) enum Admission<'a> {
+    Leader(Flight<'a>),
+    Joined(Joined),
+}
+/// Owns a flight until completion or unwinding.
+pub(crate) struct Flight<'a> {
+    drain: &'a RefreshDrain,
+    completion: Arc<Completion>,
+    finished: bool,
+}
+/// A waiter that keeps its own notification publication alive.
+pub(crate) struct Joined(Arc<Completion>);
+impl RefreshDrain {
+    /// Observes whether another caller has joined the active flight.
+    #[cfg(test)]
+    pub(crate) fn requested_for_test(&self) -> bool {
+        self.state.lock().requested
+    }
+
+    /// Starts a producer or requests a followup from the current one.
+    pub(crate) fn enter(&self) -> Admission<'_> {
+        let mut state = self.state.lock();
+        if let Some(completion) = state.active.clone() {
+            state.requested = true;
+            return Admission::Joined(Joined(completion));
+        }
+        let completion = Arc::default();
+        state.active = Some(Arc::clone(&completion));
+        state.requested = false;
+        Admission::Leader(Flight {
+            drain: self,
+            completion,
+            finished: false,
+        })
+    }
+}
+impl Flight<'_> {
+    /// Returns true once the flight completes; joins or newer inputs need another pass.
+    pub(crate) fn finish_pass(&mut self, repeat: bool) -> bool {
+        let mut state = self.drain.state.lock();
+        let requested = std::mem::take(&mut state.requested);
+        if repeat || requested {
+            return false;
+        }
+        state.active = None;
+        self.finished = true;
+        *self.completion.done.lock() = Some(true);
+        self.completion.changed.notify_all();
+        true
+    }
+}
+impl Drop for Flight<'_> {
+    fn drop(&mut self) {
+        if !self.finished {
+            let mut state = self.drain.state.lock();
+            state.active = None;
+            state.requested = false;
+            *self.completion.done.lock() = Some(false);
+            self.completion.changed.notify_all();
+        }
+    }
+}
+impl Joined {
+    /// Waits for completion; false means the producer aborted and work needs recovery.
+    pub(crate) fn wait(self) -> bool {
+        let mut done = self.0.done.lock();
+        while done.is_none() {
+            self.0.changed.wait(&mut done);
+        }
+        done.unwrap()
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn overlapping_refreshes_join_and_request_one_followup() {
+        let drain = RefreshDrain::default();
+        let Admission::Leader(mut first) = drain.enter() else {
+            panic!("first admission");
+        };
+        let Admission::Joined(second) = drain.enter() else {
+            panic!("overlapping caller started a duplicate drain");
+        };
+        let Admission::Joined(third) = drain.enter() else {
+            panic!("third caller started a duplicate drain");
+        };
+        assert!(
+            !first.finish_pass(false),
+            "joined requests need one followup pass"
+        );
+        assert!(
+            first.finish_pass(false),
+            "joins coalesce instead of one pass per caller"
+        );
+        assert!(second.wait() && third.wait());
+        assert!(matches!(drain.enter(), Admission::Leader(_)));
+    }
+    #[test]
+    fn changed_inputs_require_a_followup_without_another_caller() {
+        let drain = RefreshDrain::default();
+        let Admission::Leader(mut first) = drain.enter() else {
+            panic!("leader");
+        };
+        assert!(!first.finish_pass(true));
+        assert!(first.finish_pass(false));
+    }
+    #[test]
+    fn aborted_flight_releases_joiners_for_recovery() {
+        let drain = RefreshDrain::default();
+        let Admission::Leader(first) = drain.enter() else {
+            panic!("leader");
+        };
+        let Admission::Joined(waiter) = drain.enter() else {
+            panic!("join");
+        };
+        drop(first);
+        assert!(!waiter.wait(), "aborted work must not look completed");
+        let Admission::Leader(mut next) = drain.enter() else {
+            panic!("replacement leader");
+        };
+        assert!(
+            next.finish_pass(false),
+            "aborted join requests cannot leak into new flight"
+        );
+    }
+    #[test]
+    fn independent_project_drains_do_not_share_admission() {
+        let a = RefreshDrain::default();
+        let b = RefreshDrain::default();
+        let Admission::Leader(_a) = a.enter() else {
+            panic!("a");
+        };
+        let Admission::Leader(_b) = b.enter() else {
+            panic!("b");
+        };
+    }
+    #[test]
+    fn joiner_waits_for_completion_on_another_thread() {
+        let drain = RefreshDrain::default();
+        let Admission::Leader(mut first) = drain.enter() else {
+            panic!("leader");
+        };
+        let Admission::Joined(waiter) = drain.enter() else {
+            panic!("join");
+        };
+        let (ready_tx, ready_rx) = std::sync::mpsc::sync_channel(0);
+        let worker = std::thread::spawn(move || {
+            ready_tx.send(()).unwrap();
+            waiter.wait()
+        });
+        ready_rx.recv().unwrap();
+        assert!(!first.finish_pass(false));
+        assert!(first.finish_pass(false));
+        assert!(worker.join().unwrap());
+    }
+    #[test]
+    fn input_change_and_join_share_one_followup_pass() {
+        let drain = RefreshDrain::default();
+        let Admission::Leader(mut first) = drain.enter() else {
+            panic!("leader");
+        };
+        let Admission::Joined(joined) = drain.enter() else {
+            panic!("join");
+        };
+        assert!(!first.finish_pass(true));
+        assert!(
+            first.finish_pass(false),
+            "input change must consume the joined request in the same followup"
+        );
+        assert!(joined.wait());
+    }
+
+    #[test]
+    fn dropping_completed_flight_cannot_abort_a_newer_flight() {
+        let drain = RefreshDrain::default();
+        let Admission::Leader(mut first) = drain.enter() else {
+            panic!("leader");
+        };
+        assert!(first.finish_pass(false));
+        let Admission::Leader(mut newer) = drain.enter() else {
+            panic!("new leader");
+        };
+        drop(first);
+        let Admission::Joined(joined) = drain.enter() else {
+            panic!("completed drop cleared newer admission");
+        };
+        assert!(!newer.finish_pass(false));
+        assert!(newer.finish_pass(false));
+        assert!(joined.wait());
+    }
+}

+fn named_view_controller(body: &str) -> String {
+    controller("NamedViewController", body).replace("namespace App;\n", "namespace App;\nuse Illuminate\\Support\\Facades\\{View, Route, Response};\nuse function view as render_view;\n")
+}
+
+#[tokio::test]
+async fn named_view_arguments_navigate_the_declared_view_parameter() {
+    for body in [
+        "view(data: ['item' => new Item], view: 'shop');",
+        "render_view(data: ['item' => new Item], view: 'shop');",
+        "view(data: ['item' => new Item], view: 'shop')->with('title', 'sample');",
+        "view(view: 'shop', data: ['item' => new Item]);",
+        "View::make(data: ['item' => new Item], view: 'shop');",
+        "View::first(data: ['item' => new Item], views: ['shop']);",
+        "View::renderWhen(data: ['item' => new Item], view: 'shop', condition: true);",
+        "view()->make(data: ['item' => new Item], view: 'shop');",
+        "Route::view(data: ['item' => new Item], view: 'shop', uri: '/shop');",
+        "Response::view(data: ['item' => new Item], view: 'shop');",
+    ] {
+        let source = named_view_controller(body);
+        let (backend, _dir) = create_psr4_workspace(
+            LARAVEL_APP_COMPOSER,
+            &[
+                ("app/Item.php", ITEM_CLASS),
+                ("app/NamedViewController.php", &source),
+                ("resources/views/shop.blade.php", "{{ $item->name }}\n"),
+            ],
+        );
+        backend.initialized(InitializedParams {}).await;
+        let uri = open_php_file(&backend, "app/NamedViewController.php").await;
+        let found = definitions_at(&backend, &uri, &source, "'shop'").await;
+        assert!(
+            found.iter().any(|target| target
+                .uri
+                .as_str()
+                .ends_with("/resources/views/shop.blade.php")),
+            "{body}: {found:?}"
+        );
+        let blade = open_blade_template(&backend, "resources/views/shop.blade.php").await;
+        let labels = crate::common::complete_labels_at_opened(&backend, &blade, 0, 10).await;
+        assert!(
+            labels.iter().any(|label| label == "price"),
+            "named data must reach the selected view: {body}: {labels:?}"
+        );
+    }
+}
+

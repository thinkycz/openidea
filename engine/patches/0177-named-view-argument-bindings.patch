+/// Bind one known parameter without constructing or resolving a signature.
+/// The outer `None` refuses unpacking, duplicate bindings and positional
+/// arguments after named ones; `Some(None)` means the parameter was omitted.
+pub(crate) fn argument_for_slot<'a>(
+    arguments: &ArgumentList<'a>,
+    index: usize,
+    name: &str,
+) -> Option<Option<&'a Expression<'a>>> {
+    let mut value = None;
+    let mut positional = 0;
+    let mut named_seen = false;
+    for argument in arguments.arguments.iter() {
+        let selected = match argument {
+            Argument::Positional(argument) => {
+                if named_seen || argument.ellipsis.is_some() {
+                    return None;
+                }
+                let selected = (positional == index).then_some(argument.value);
+                positional += 1;
+                selected
+            }
+            Argument::Named(argument) => {
+                named_seen = true;
+                (bytes_to_str(argument.name.value) == name).then_some(argument.value)
+            }
+        };
+        if let Some(selected) = selected
+            && value.replace(selected).is_some()
+        {
+            return None;
+        }
+    }
+    Some(value)
+}

+#[tokio::test]
+async fn named_view_arguments_do_not_borrow_strings_from_other_parameters() {
+    for body in [
+        "view(data: 'shop', view: 'missing');",
+        "View::make(data: 'shop', view: 'missing');",
+        "view(View: 'shop');",
+        "view('shop', view: 'other');",
+        "view(...['view' => 'shop']);",
+        "unrelated(view: 'shop');",
+    ] {
+        let source = named_view_controller(body);
+        let (backend, _dir) = create_psr4_workspace(
+            LARAVEL_APP_COMPOSER,
+            &[
+                ("app/NamedViewController.php", &source),
+                ("resources/views/shop.blade.php", "<p>Shop</p>\n"),
+            ],
+        );
+        backend.initialized(InitializedParams {}).await;
+        let uri = open_php_file(&backend, "app/NamedViewController.php").await;
+        let found = definitions_at(&backend, &uri, &source, "'shop'").await;
+        assert!(
+            !found.iter().any(|target| target
+                .uri
+                .as_str()
+                .ends_with("/resources/views/shop.blade.php")),
+            "non-view or wrong-case parameter must not name a view: {body}: {found:?}"
+        );
+    }
+}

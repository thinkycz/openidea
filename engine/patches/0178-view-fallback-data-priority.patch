+#[tokio::test]
+async fn named_view_arguments_typed_factory_uses_first_views_parameter() {
+    let mut composer: serde_json::Value = serde_json::from_str(LARAVEL_APP_COMPOSER).unwrap();
+    composer["autoload"]["psr-4"]["Illuminate\\Contracts\\View\\"] = "framework/".into();
+    let composer = composer.to_string();
+    let source = "<?php namespace App; use Illuminate\\Contracts\\View\\Factory; function render(Factory $factory, Item $item): mixed { return $factory->first(mergeData: [], views: ['shop'], data: ['item' => $item]); }";
+    let (backend, _dir) = create_psr4_workspace(
+        &composer,
+        &[
+            ("app/Item.php", ITEM_CLASS),
+            (
+                "framework/Factory.php",
+                "<?php namespace Illuminate\\Contracts\\View; interface Factory { public function first(array $views, array $data = [], array $mergeData = []): mixed; }",
+            ),
+            ("app/NamedViewController.php", source),
+            ("resources/views/shop.blade.php", "{{ $item->name }}\n"),
+        ],
+    );
+    backend.initialized(InitializedParams {}).await;
+    let uri = open_php_file(&backend, "app/NamedViewController.php").await;
+    let found = definitions_at(&backend, &uri, source, "'shop'").await;
+    assert!(
+        found.iter().any(|target| target
+            .uri
+            .as_str()
+            .ends_with("/resources/views/shop.blade.php")),
+        "typed first() named views: {found:?}"
+    );
+    let blade = open_blade_template(&backend, "resources/views/shop.blade.php").await;
+    let labels = crate::common::complete_labels_at_opened(&backend, &blade, 0, 10).await;
+    assert!(
+        labels.iter().any(|label| label == "price"),
+        "typed factory named data: {labels:?}"
+    );
+}

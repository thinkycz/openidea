+#[tokio::test]
+async fn named_view_arguments_keep_merge_data_below_explicit_and_chained_data() {
+    for (body, expected, forbidden) in [
+        (
+            "view(view: 'shop', mergeData: ['item' => new Item]);",
+            "price",
+            "otherOnly",
+        ),
+        (
+            "View::make(view: 'shop', mergeData: ['item' => new Item]);",
+            "price",
+            "otherOnly",
+        ),
+        (
+            "view(view: 'shop', data: ['item' => new Item], mergeData: ['item' => new Other]);",
+            "price",
+            "otherOnly",
+        ),
+        (
+            "view(mergeData: ['item' => new Other], view: 'shop', data: ['item' => new Item]);",
+            "price",
+            "otherOnly",
+        ),
+        (
+            "View::first(mergeData: ['item' => new Other], views: ['shop'], data: ['item' => new Item]);",
+            "price",
+            "otherOnly",
+        ),
+        (
+            "view()->make(mergeData: ['item' => new Other], data: ['item' => new Item], view: 'shop');",
+            "price",
+            "otherOnly",
+        ),
+        (
+            "view(mergeData: ['item' => new Item], view: 'shop', data: [])->with('item', new Other);",
+            "otherOnly",
+            "price",
+        ),
+    ] {
+        let source = named_view_controller(body);
+        let (backend, _dir) = create_psr4_workspace(
+            LARAVEL_APP_COMPOSER,
+            &[
+                ("app/Item.php", ITEM_CLASS),
+                (
+                    "app/Other.php",
+                    "<?php namespace App; class Other { public string $name = ''; public int $otherOnly = 1; }",
+                ),
+                ("app/NamedViewController.php", &source),
+                ("resources/views/shop.blade.php", "{{ $item->name }}\n"),
+            ],
+        );
+        backend.initialized(InitializedParams {}).await;
+        open_php_file(&backend, "app/NamedViewController.php").await;
+        let blade = open_blade_template(&backend, "resources/views/shop.blade.php").await;
+        let labels = crate::common::complete_labels_at_opened(&backend, &blade, 0, 10).await;
+        assert!(
+            labels.iter().any(|label| label == expected)
+                && !labels.iter().any(|label| label == forbidden),
+            "factory runtime data precedence: {body}: {labels:?}"
+        );
+    }
+}
+
+#[tokio::test]
+async fn named_view_arguments_render_each_keeps_item_and_empty_templates_separate() {
+    for body in [
+        "View::renderEach(view: 'rows', data: [new Item], iterator: 'row', empty: 'empty');",
+        "View::renderEach(empty: 'empty', iterator: 'row', data: [new Item], view: 'rows');",
+        "view()->renderEach(empty: 'empty', data: [new Item], view: 'rows', iterator: 'row');",
+    ] {
+        let source = named_view_controller(body);
+        let (backend, _dir) = create_psr4_workspace(
+            LARAVEL_APP_COMPOSER,
+            &[
+                ("app/Item.php", ITEM_CLASS),
+                ("app/NamedViewController.php", &source),
+                ("resources/views/rows.blade.php", "{{ $row->name }}\n"),
+                ("resources/views/empty.blade.php", "<p>No rows</p>\n"),
+            ],
+        );
+        backend.initialized(InitializedParams {}).await;
+        let uri = open_php_file(&backend, "app/NamedViewController.php").await;
+        for (name, suffix) in [
+            ("'rows'", "/resources/views/rows.blade.php"),
+            ("'empty'", "/resources/views/empty.blade.php"),
+        ] {
+            let found = definitions_at(&backend, &uri, &source, name).await;
+            assert!(
+                found
+                    .iter()
+                    .any(|target| target.uri.as_str().ends_with(suffix)),
+                "{body}: {name}: {found:?}"
+            );
+        }
+        let blade = open_blade_template(&backend, "resources/views/rows.blade.php").await;
+        let labels = crate::common::complete_labels_at_opened(&backend, &blade, 0, 9).await;
+        assert!(
+            labels.iter().any(|label| label == "price"),
+            "named iterator data: {body}: {labels:?}"
+        );
+    }
+}

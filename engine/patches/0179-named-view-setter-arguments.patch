diff --git a/tests/integration/laravel_view_names.rs b/tests/integration/laravel_view_names.rs
index 2701d7a65cba672e57c6cb6dffbfd80de4fc42ce..3a798fb546d3a490d5bdcbae9f53dfc16c389b7b 100644
--- a/tests/integration/laravel_view_names.rs
+++ b/tests/integration/laravel_view_names.rs
@@ -1425,3 +1425,69 @@ async fn named_view_arguments_typed_factory_uses_first_views_parameter() {
         "typed factory named data: {labels:?}"
     );
 }
+
+#[tokio::test]
+async fn named_view_arguments_with_binds_key_and_value_and_preserves_priority() {
+    for body in [
+        "view('shop')->with(value: new Item, key: 'item');",
+        "view('shop')->with(key: 'item', value: new Item);",
+        "view('shop')->with('item', value: new Item);",
+        "view('shop')->with(key: ['item' => new Item]);",
+        "view('shop')->with(value: new Other, key: ['item' => new Item]);",
+        "view('shop')->with(['item' => new Item], new Other);",
+        "view('shop')->WITH(value: new Item, key: 'item');",
+        "view('shop', ['item' => new Other])->with(value: new Item, key: 'item');",
+        "view('shop')->with('item', new Other)->with(value: new Item, key: 'item');",
+    ] {
+        let source = named_view_controller(body);
+        let (backend, _dir) = create_psr4_workspace(
+            LARAVEL_APP_COMPOSER,
+            &[
+                ("app/Item.php", ITEM_CLASS),
+                (
+                    "app/Other.php",
+                    "<?php namespace App; class Other { public int $otherOnly = 1; }",
+                ),
+                ("app/NamedViewController.php", &source),
+                ("resources/views/shop.blade.php", "{{ $item->name }}\n"),
+            ],
+        );
+        backend.initialized(InitializedParams {}).await;
+        open_php_file(&backend, "app/NamedViewController.php").await;
+        let blade = open_blade_template(&backend, "resources/views/shop.blade.php").await;
+        let labels = crate::common::complete_labels_at_opened(&backend, &blade, 0, 10).await;
+        assert!(
+            labels.iter().any(|label| label == "price")
+                && !labels.iter().any(|label| label == "otherOnly"),
+            "with parameter binding and final-write priority: {body}: {labels:?}"
+        );
+    }
+}
+
+#[tokio::test]
+async fn named_view_arguments_with_refuses_ambiguous_bindings() {
+    for body in [
+        "view('shop')->with(Key: 'item', value: new Item);",
+        "view('shop')->with(key: 'item', key: 'other', value: new Item);",
+        "view('shop')->with('item', key: 'other', value: new Item);",
+        "view('shop')->with(...['key' => 'item', 'value' => new Item]);",
+    ] {
+        let source = named_view_controller(body);
+        let (backend, _dir) = create_psr4_workspace(
+            LARAVEL_APP_COMPOSER,
+            &[
+                ("app/Item.php", ITEM_CLASS),
+                ("app/NamedViewController.php", &source),
+                ("resources/views/shop.blade.php", "{{ $item->name }}\n"),
+            ],
+        );
+        backend.initialized(InitializedParams {}).await;
+        open_php_file(&backend, "app/NamedViewController.php").await;
+        let blade = open_blade_template(&backend, "resources/views/shop.blade.php").await;
+        let labels = crate::common::complete_labels_at_opened(&backend, &blade, 0, 10).await;
+        assert!(
+            !labels.iter().any(|label| label == "price"),
+            "ambiguous with arguments must not invent a model: {body}: {labels:?}"
+        );
+    }
+}

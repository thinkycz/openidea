+#[tokio::test]
+async fn leaf_namespace_attributes_keep_group_action_semantics() {
+    use crate::common::{apply_edits, position_after};
+    for call in [
+        "Routes::namespace('Decoy')->get('/invoice', 'showInvoice')",
+        "Routes::namespace('\\\\Decoy')->get('/invoice', 'showInvoice')",
+        "Routes::namespace(null)->get('/invoice', 'showInvoice')",
+        "Routes::namespace('')->get('/invoice', 'showInvoice')",
+        "Routes::middleware('web')->namespace('First')->controller(Inner::class)->namespace('Last')->post('/invoice', 'showInvoice')",
+        "Routes::namespace('Decoy')->match(action: 'showInvoice', methods: ['get'], uri: '/invoice')",
+    ] {
+        let backend = create_test_backend();
+        let uri = Url::parse("file:///leaf-namespace-actions.php").unwrap();
+        let text = format!(
+            "<?php\nuse Illuminate\\Support\\Facades\\Route as Routes;\nclass Outer {{public function showInvoice(): string {{return 'outer';}}}}\nclass Inner {{public function showInvoice(): bool {{return true;}}}}\nRoutes::controller(Outer::class)->group(function () {{ /* 😀 */ {call}; }});\n"
+        );
+        open_php(&backend, &uri, &text).await;
+        let at = position_after(&text, "'showIn");
+        let declaration = position_after(&text, "class Outer {public function ");
+        let target = goto_def(&backend, &uri, at.line, at.character).await;
+        assert!(
+            matches!(target, Some(GotoDefinitionResponse::Scalar(ref location)) if location.uri == uri && location.range.start == declaration),
+            "leaf namespace must retain group action target {call}: {target:?}"
+        );
+        let completion = complete_at(&backend, &uri, &text, at.line, at.character).await;
+        assert!(
+            method_labels(&completion)
+                .iter()
+                .any(|name| name == "showInvoice"),
+            "leaf namespace completion {call}"
+        );
+        let context = TextDocumentPositionParams {
+            text_document: TextDocumentIdentifier { uri: uri.clone() },
+            position: at,
+        };
+        let hover = backend
+            .hover(HoverParams {
+                text_document_position_params: context.clone(),
+                work_done_progress_params: Default::default(),
+            })
+            .await
+            .unwrap()
+            .unwrap();
+        assert!(
+            matches!(hover.contents, HoverContents::Markup(ref markup) if markup.value.contains("showInvoice(): string")),
+            "leaf namespace hover {call}: {hover:?}"
+        );
+        let references = backend
+            .references(ReferenceParams {
+                text_document_position: context.clone(),
+                context: ReferenceContext {
+                    include_declaration: true,
+                },
+                work_done_progress_params: Default::default(),
+                partial_result_params: Default::default(),
+            })
+            .await
+            .unwrap()
+            .unwrap();
+        let mut actual: Vec<_> = references
+            .iter()
+            .map(|location| {
+                assert_eq!(location.uri, uri);
+                location.range.start
+            })
+            .collect();
+        actual.sort_by_key(|position| (position.line, position.character));
+        assert_eq!(
+            actual,
+            [declaration, {
+                let mut action = at;
+                action.character -= 6;
+                action
+            }],
+            "leaf namespace references {call}"
+        );
+        let edit = backend
+            .rename(RenameParams {
+                text_document_position: context,
+                new_name: "renderInvoice".into(),
+                work_done_progress_params: Default::default(),
+            })
+            .await
+            .unwrap()
+            .unwrap();
+        let changes = edit.changes.unwrap();
+        assert_eq!(changes.len(), 1);
+        let edits = &changes[&uri];
+        assert_eq!(edits.len(), 2, "leaf namespace rename {call}: {edits:?}");
+        assert_eq!(
+            apply_edits(&text, edits),
+            text.replacen("function showInvoice", "function renderInvoice", 1)
+                .replace("'showInvoice'", "'renderInvoice'"),
+            "leaf namespace rename preserves unrelated controller {call}"
+        );
+    }
+}

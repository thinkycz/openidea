+#[tokio::test]
+async fn leaf_namespace_attributes_do_not_invent_an_ungrouped_controller() {
+    use crate::common::position_after;
+    for call in [
+        "Routes::namespace('Decoy')->get('/x', 'showInvoice')",
+        "Routes::namespace(null)->get('/x', 'showInvoice')",
+        "Routes::controller(Outer::class)->namespace('Decoy')->get('/x', 'showInvoice')",
+    ] {
+        let backend = create_test_backend();
+        let uri = Url::parse("file:///ungrouped-namespace-action.php").unwrap();
+        let text = format!(
+            "<?php\nuse Illuminate\\Support\\Facades\\Route as Routes;\nclass Outer {{public function showInvoice(): string {{return 'outer';}}}}\n{call};\n"
+        );
+        open_php(&backend, &uri, &text).await;
+        let at = position_after(&text, "'showIn");
+        assert!(
+            goto_def(&backend, &uri, at.line, at.character)
+                .await
+                .is_none(),
+            "ungrouped namespace must not invent a method owner {call}"
+        );
+        let completion = complete_at(&backend, &uri, &text, at.line, at.character).await;
+        assert!(
+            !method_labels(&completion)
+                .iter()
+                .any(|name| name == "showInvoice"),
+            "ungrouped namespace completion {call}"
+        );
+    }
+}

+async fn translation_argument_identity_case(marked: &str, detail: &str, expected: &[&str]) {
+    use crate::common::{complete_at_opened, position_after};
+    let cursor = marked.find('|').unwrap();
+    let content = marked.replacen('|', "", 1);
+    let (backend, _dir, uri) = create_initialized_psr4_workspace(
+        r#"{"require":{"laravel/framework":"13.37.0"},"autoload":{"psr-4":{"App\\":"app/"}}}"#,
+        &[
+            ("app/Demo.php", &content),
+            (
+                "lang/en/messages.php",
+                "<?php return ['hello'=>'Hello :name :count'];",
+            ),
+            (
+                "lang/fr/messages.php",
+                "<?php return ['hello'=>'Bonjour :name :count'];",
+            ),
+        ],
+        "app/Demo.php",
+    )
+    .await;
+    let at = position_after(&content, &content[..cursor]);
+    let items = complete_at_opened(&backend, &uri, at.line, at.character).await;
+    let relevant: Vec<_> = items
+        .iter()
+        .filter(|item| item.detail.as_deref() == Some(detail))
+        .collect();
+    let mut labels: Vec<_> = relevant.iter().map(|item| item.label.as_str()).collect();
+    labels.sort_unstable();
+    assert_eq!(
+        labels, expected,
+        "translation argument callable identity: {marked}; all items: {items:?}"
+    );
+    let start = content[..cursor].rfind('\'').unwrap() + 1;
+    let end = start + content[start..].find('\'').unwrap();
+    for item in relevant {
+        let Some(CompletionTextEdit::Edit(edit)) = &item.text_edit else {
+            panic!("translation argument must use a text edit")
+        };
+        assert_eq!(
+            edit.range,
+            Range::new(
+                position_after(&content, &content[..start]),
+                position_after(&content, &content[..end])
+            ),
+            "UTF-16 full-token range after emoji: {marked}"
+        );
+        assert_eq!(edit.new_text, item.label);
+        assert!(
+            item.additional_text_edits
+                .as_ref()
+                .is_none_or(Vec::is_empty)
+        );
+    }
+}
+
+#[tokio::test]
+async fn translation_argument_completion_follows_imported_helper_identity() {
+    translation_argument_identity_case(r###"<?php namespace App\Case0; use function trans as localize; /* 😀 */ return localize('messages.hello', [], 'e|n');"###, "Translation locale", &["en"]).await;
+    translation_argument_identity_case(r###"<?php namespace App\Case1; use function trans as localize; /* 😀 */ return localize('messages.hello', ['n|ame'=>'Ada']);"###, "Translation placeholder", &["name"]).await;
+    translation_argument_identity_case(r###"<?php namespace App\Case2; use function trans_choice as choose; /* 😀 */ return choose('messages.hello', 2, [], 'e|n');"###, "Translation locale", &["en"]).await;
+    translation_argument_identity_case(r###"<?php namespace App\Case3; use function trans_choice as choose; /* 😀 */ return choose('messages.hello', 2, ['n|ame'=>'Ada']);"###, "Translation placeholder", &["name"]).await;
+    translation_argument_identity_case(r###"<?php namespace App\Case4; use Illuminate\Support\Facades\Lang as L; /* 😀 */ return L::get('messages.hello', [], 'e|n');"###, "Translation locale", &["en"]).await;
+    translation_argument_identity_case(
+        r###"<?php namespace App\Case8; /* 😀 */ return trans('messages.hello', [], 'e|n');"###,
+        "Translation locale",
+        &["en"],
+    )
+    .await;
+}
+
+#[tokio::test]
+async fn translation_argument_completion_rejects_foreign_helper_and_facade_identity() {
+    translation_argument_identity_case(r###"<?php namespace App\Case5; function trans($key,$replace=[],$locale=null){return 'foreign';} /* 😀 */ return trans('messages.hello', [], 'e|n');"###, "Translation locale", &[]).await;
+    translation_argument_identity_case(r###"<?php namespace Foreign {function trans($key,$replace=[],$locale=null){return 'foreign';}} namespace App\Case6 {use function Foreign\trans; /* 😀 */ return trans('messages.hello', [], 'e|n');}"###, "Translation locale", &[]).await;
+    translation_argument_identity_case(r###"<?php namespace App\Case7; class Lang {public static function get($key,$replace=[],$locale=null){return 'foreign';}} /* 😀 */ return Lang::get('messages.hello', [], 'e|n');"###, "Translation locale", &[]).await;

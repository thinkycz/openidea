+    for bracket in code.open_brackets.iter().rev() {
+        match bracket.byte {
+            b'(' => repaired.push(')'),
+            b'[' => repaired.push(']'),
+            b'{' => {
+                if !repaired.ends_with([';', '}']) {
+                    repaired.push(';');
+                }
+                repaired.push('}');
             }
+            _ => return None,
         }
-        None

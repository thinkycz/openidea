+fn receiver_span(content: &str, method_end: usize) -> Option<(usize, usize, Option<String>)> {
+    fn find(node: Node<'_, '_>, end: usize) -> Option<(usize, usize)> {
+        let span = node.span();
+        if end < span.start.offset as usize || end > span.end.offset as usize {
+            return None;
+        }
+        let receiver = match node {
+            Node::MethodCall(call) => Some((call.object, &call.method)),
+            Node::NullSafeMethodCall(call) => Some((call.object, &call.method)),
+            _ => None,
+        };
+        if let Some((object, ClassLikeMemberSelector::Identifier(name))) = receiver
+            && name.span().end.offset as usize == end
+        {
+            let span = object.span();
+            return Some((span.start.offset as usize, span.end.offset as usize));
+        }
+        let mut found = None;
+        node.visit_children(|child| {
+            if found.is_none() {
+                found = find(child, end);
+            }
+        });
+        found
+    }
+    let found =
+        crate::parser::with_parsed_program(content, "laravel_key_receiver", |program, _| {
+            find(Node::Program(program), method_end)
+        });
+    if let Some((start, end)) = found {
+        return Some((start, end, None));
+    }
+    // An unfinished argument may hide the whole call from the parser. Close
+    // only the prefix through the member name; its original offsets stay valid.

+async fn typed_translation_case(marked: &str, detail: &str, expected: &[&str], key: bool) {
+    use crate::common::{complete_at_opened, position_after};
+    let offset = marked.find("<caret>").unwrap();
+    let content = marked.replacen("<caret>", "", 1);
+    let offset = if key {
+        content
+            .find("'messages.hello'")
+            .map(|start| start + "'mess".len())
+            .unwrap_or(offset)
+    } else {
+        offset
+    };
+    let contract = r#"<?php namespace Illuminate\Contracts\Translation; interface Translator { public function get($key, array $replace=[], $locale=null); public function choice($key,$number,array $replace=[],$locale=null); }"#;
+    let concrete = r#"<?php namespace Illuminate\Translation; class Translator implements \Illuminate\Contracts\Translation\Translator { public function get($key,array $replace=[],$locale=null,$fallback=true) {return $key;} public function choice($key,$number,array $replace=[],$locale=null) {return $key;} public function has($key,$locale=null,$fallback=true) {return true;} public function hasForLocale($key,$locale=null) {return true;} }"#;
+    let (backend, _dir, uri) = create_initialized_psr4_workspace(
+        r#"{"require":{"laravel/framework":"13.37.0"},"autoload":{"psr-4":{"App\\":"app/","Illuminate\\":"framework/"}}}"#,
+        &[
+            ("app/Demo.php", &content),
+            ("framework/Contracts/Translation/Translator.php", contract),
+            ("framework/Translation/Translator.php", concrete),
+            ("lang/en/messages.php", "<?php return ['hello'=>'Hello :name :count'];"),
+            ("lang/fr/messages.php", "<?php return ['hello'=>'Bonjour :name :count'];"),
+        ], "app/Demo.php").await;
+    let at = position_after(&content, &content[..offset]);
+    let items = complete_at_opened(&backend, &uri, at.line, at.character).await;
+    let mut labels: Vec<_> = items
+        .iter()
+        .filter(|x| {
+            if key {
+                x.label == "messages.hello"
+            } else {
+                x.detail.as_deref() == Some(detail)
+            }
+        })
+        .map(|x| x.label.as_str())
+        .collect();
+    labels.sort_unstable();
+    assert_eq!(
+        labels, expected,
+        "typed translation receiver: {marked}; key={key}; items={items:?}"
+    );
+    if !key {
+        let start = content[..offset].rfind('\'').unwrap() + 1;
+        let end = start + content[start..].find('\'').unwrap_or(content.len() - start);
+        for item in items.iter().filter(|x| x.detail.as_deref() == Some(detail)) {
+            let Some(CompletionTextEdit::Edit(edit)) = &item.text_edit else {
+                panic!("typed argument text edit required")
+            };
+            assert_eq!(
+                edit.range,
+                Range::new(
+                    position_after(&content, &content[..start]),
+                    position_after(&content, &content[..end])
+                ),
+                "UTF-16 full-token edit"
+            );
+            assert_eq!(edit.new_text, item.label);
+            assert!(
+                item.additional_text_edits
+                    .as_ref()
+                    .is_none_or(Vec::is_empty)
+            );
+        }
+    }
+}

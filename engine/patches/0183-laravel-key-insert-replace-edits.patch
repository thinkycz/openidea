+#[test]
+fn quoted_key_edits_keep_insert_and_full_token_replace_ranges() {
+    for marked in [
+        "<?php /* 😀 */ config('app.na|me');",
+        "<?php /* 😀 */ config(\"app.na|me.old\");",
+        "<?php /* 😀 */ config('app.na|me\\'old');",
+        "<?php /* 😀 */ config('app.na|me😀.old');",
+    ] {
+        let cursor = marked.find('|').unwrap();
+        let content = marked.replacen('|', "", 1);
+        let start = content[..cursor].rfind(['\'', '"']).unwrap() + 1;
+        let end = content.rfind(['\'', '"']).unwrap();
+        let at = crate::text_position::offset_to_position(&content, cursor);
+        let insert = Range::new(
+            crate::text_position::offset_to_position(&content, start),
+            at,
+        );
+        let replace = Range::new(
+            insert.start,
+            crate::text_position::offset_to_position(&content, end),
+        );
+        for modern in [false, true] {
+            let result = string_key_response(
+                vec!["app.name".into()],
+                CompletionItemKind::VALUE,
+                &content,
+                start,
+                at,
+                None,
+                modern,
+            )
+            .unwrap();
+            let items = completion_response_items(result);
+            let edit = items[0].text_edit.as_ref().unwrap();
+            let (range, inserted) = match edit {
+                CompletionTextEdit::InsertAndReplace(edit) => {
+                    assert!(modern);
+                    assert_eq!(edit.insert, insert);
+                    assert_eq!(edit.replace, replace);
+                    (edit.replace, edit.new_text.as_str())
+                }
+                CompletionTextEdit::Edit(edit) => {
+                    assert!(!modern);
+                    assert_eq!(edit.range, replace);
+                    (edit.range, edit.new_text.as_str())
+                }
+            };
+            assert_eq!(range, replace, "whole quoted key after UTF-16 emoji");
+            let from = crate::text_position::position_to_offset(&content, range.start) as usize;
+            let to = crate::text_position::position_to_offset(&content, range.end) as usize;
+            assert_eq!(
+                format!("{}{}{}", &content[..from], inserted, &content[to..]),
+                format!("{}app.name{}", &content[..start], &content[end..])
+            );
+        }
+    }
+}
+
+#[test]
+fn quoted_key_edits_keep_open_end_segment_and_interpolation_boundaries() {
+    for (marked, explicit) in [
+        ("<?php config('app.na|", None),
+        ("<?php config(\"app.na|me.$suffix\");", None),
+        ("<?php config('app.na|me\n.other');", None),
+        ("<?php config('app.na|me,other');", Some(',')),
+    ] {
+        let cursor = marked.find('|').unwrap();
+        let content = marked.replacen('|', "", 1);
+        let start = content[..cursor].rfind(['\'', '"']).unwrap() + 1;
+        let at = crate::text_position::offset_to_position(&content, cursor);
+        let replacement = explicit.map(|byte| (content.find(byte).unwrap(), '\''));
+        let result = string_key_response(
+            vec!["app.name".into()],
+            CompletionItemKind::VALUE,
+            &content,
+            start,
+            at,
+            replacement,
+            true,
+        )
+        .unwrap();
+        let items = completion_response_items(result);
+        let Some(CompletionTextEdit::Edit(edit)) = &items[0].text_edit else {
+            panic!("keep explicit or unsupported ranges")
+        };
+        assert_eq!(
+            edit.range.end,
+            replacement
+                .map(|(end, _)| crate::text_position::offset_to_position(&content, end))
+                .unwrap_or(at)
+        );
+    }
+}
+
+#[tokio::test]
+async fn insert_replace_capability_is_negotiated_and_survives_blocking_clones() {
+    use std::sync::atomic::Ordering;
+    for advertised in [None, Some(false), Some(true)] {
+        let backend = crate::Backend::new_test();
+        let mut capabilities = serde_json::json!({});
+        if let Some(value) = advertised {
+            capabilities = serde_json::json!({"textDocument":{"completion":{"completionItem":{"insertReplaceSupport":value}}}});
+        }
+        backend
+            .on_initialize(InitializeParams {
+                capabilities: serde_json::from_value(capabilities).unwrap(),
+                ..Default::default()
+            })
+            .await
+            .unwrap();
+        assert_eq!(
+            backend.supports_insert_replace.load(Ordering::Acquire),
+            advertised.unwrap_or(false)
+        );
+        assert_eq!(
+            backend
+                .clone_for_blocking()
+                .supports_insert_replace
+                .load(Ordering::Acquire),
+            advertised.unwrap_or(false)
+        );
+    }
+}

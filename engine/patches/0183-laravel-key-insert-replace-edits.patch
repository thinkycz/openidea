+fn quoted_key_end(content: &str, start: usize, cursor: Position) -> Option<Position> {
+    let bytes = content.as_bytes();
+    let quote = *bytes.get(start.checked_sub(1)?)?;
+    if !matches!(quote, b'\'' | b'"') {
+        return None;
+    }
+    let offset = crate::text_position::position_to_offset(content, cursor) as usize;
+    let end = (offset..bytes.len())
+        .find(|index| bytes[*index] == quote && context::is_unescaped(bytes, *index))?;
+    if quote == b'"'
+        && (start..end).any(|index| bytes[index] == b'$' && context::is_unescaped(bytes, index))
+    {
+        return None;
+    }
+    let start_position = crate::text_position::offset_to_position(content, start);
+    let end_position = crate::text_position::offset_to_position(content, end);
+    (start_position.line == cursor.line && end_position.line == cursor.line).then_some(end_position)
+}

+/// Defer a translation key until the receiver's type proves its callable role.
+pub(super) fn record_translation_receiver_sites(
+    method: &'static str,
+    arguments: &ArgumentList<'_>,
+    content: &str,
+    sites: &mut Vec<ViewReceiverSite>,
+) {
+    let mut spans = Vec::new();
+    try_emit_laravel_string_span(
+        crate::symbol_map::LaravelStringKind::Trans,
+        arguments,
+        content,
+        &mut spans,
+    );
+    for span in spans {
+        if let SymbolKind::LaravelStringKey {
+            key, is_optional, ..
+        } = span.kind
+        {
+            sites.push(ViewReceiverSite {
+                start: span.start,
+                end: span.end,
+                key,
+                is_optional,
+                receiver: ViewReceiverClass::Translation(method),
+            });
+        }
+    }
+}

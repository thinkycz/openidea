+    r###"function render(?Text $text) { /* 😀 */ return $text?->get('messages.hello'); }"###,
+    r###"function render(?Text $text) { /* 😀 */ return $text->get('messages.hello'); }"###,
+    r###"function render(Text|Contract $text) { /* 😀 */ return $text->get('messages.hello'); }"###,
+    r###"function render(Contract|Text $text) { /* 😀 */ return $text->get('messages.hello'); }"###,
+    r###"function render(Text $text) { /* 😀 */ return $text /* receiver */ -> GET('messages.hello'); }"###,
+    r###"function render(Text $text) { /* 😀 */ return $translated = $text->get('messages.hello'); }"###,
+    r###"class Holder { public function __construct(private Text $text) {} public function render() { /* 😀 */ return $this->text->get('messages.hello'); } }"###,
+    r###"function render(Text $text) { /* 😀 */ return $text->has('messages.hello'); }"###,
+    r###"function render(Text $text) { /* 😀 */ return $text->hasForLocale(locale:'en', key:'messages.hello'); }"###,
+    r###"function render(Contract $text) { /* 😀 */ return $text->choice(number:2, key:'messages.hello'); }"###,
+];
+const TYPED_TRANSLATION_NEGATIVE: &[&str] = &[
+    r###"function render(Foreign $text) { /* 😀 */ return $text->get('messages.hello'); }"###,
+    r###"function render(Text|Foreign $text) { /* 😀 */ return $text->get('messages.hello'); }"###,
+    r###"function render(Foreign|Text $text) { /* 😀 */ return $text->get('messages.hello'); }"###,
+    r###"function render(Text|int $text) { /* 😀 */ return $text->get('messages.hello'); }"###,
+    r###"function render(object $text) { /* 😀 */ return $text->get('messages.hello'); }"###,
+    r###"function render(Contract $text) { /* 😀 */ return $text->has('messages.hello'); }"###,
+    r###"function render(Text $text) { $text = new Foreign; /* 😀 */ return $text->get('messages.hello'); }"###,
+];
+
+async fn typed_translation_workspace(
+    body: &str,
+) -> (phpantom_lsp::Backend, tempfile::TempDir, Url, String) {
+    let source = format!("{TYPED_TRANSLATOR_PRELUDE}{body}");
+    let composer = r#"{"require":{"laravel/framework":"13.37.0"},"autoload":{"psr-4":{"App\\":"app/","Illuminate\\":"framework/"}}}"#;
+    let (backend, dir, uri) = create_initialized_psr4_workspace(
+        composer,
+        &[
+            (
+                "framework/Contracts/Translation/Translator.php",
+                TYPED_TRANSLATOR_CONTRACT,
+            ),
+            (
+                "framework/Translation/Translator.php",
+                TYPED_TRANSLATOR_CLASS,
+            ),
+            (
+                "lang/en/messages.php",
+                "<?php /* 😀 */ return ['hello'=>'Hello'];",
+            ),
+            ("lang/fr/messages.php", "<?php return ['hello'=>'Bonjour'];"),
+            ("app/Typed.php", &source),
+        ],
+        "app/Typed.php",
+    )
+    .await;
+    (backend, dir, uri, source)
+}
+
+#[tokio::test]
+async fn typed_translation_keys_navigate_and_hover_valid_receivers() {
+    for body in TYPED_TRANSLATION_POSITIVE {
+        let (backend, _dir, uri, source) = typed_translation_workspace(body).await;
+        let targets = definitions_at(&backend, &uri, &source, "messages.hello").await;
+        assert_eq!(
+            targets.len(),
+            2,
+            "typed translation must navigate to both locales: {body}; {targets:?}"
+        );
+        let en = location_in(&targets, "/lang/en/messages.php").unwrap();
+        let fr = location_in(&targets, "/lang/fr/messages.php").unwrap();
+        assert_eq!(
+            en.range,
+            Range::new(Position::new(0, 24), Position::new(0, 29)),
+            "UTF-16 declaration after emoji"
+        );
+        assert_eq!(
+            fr.range,
+            Range::new(Position::new(0, 15), Position::new(0, 20))
+        );
+        let hover = hover_on(&backend, &uri, &source, "messages.hello").await;
+        assert!(
+            hover.contains("Hello")
+                && hover.contains("Bonjour")
+                && hover.contains("lang/en/messages.php"),
+            "typed translation hover: {body}; {hover}"
+        );
+        assert!(trans_diagnostics(&backend, &uri, &source).is_empty());
+    }
+}
+
+#[tokio::test]
+async fn typed_translation_keys_refuse_foreign_ambiguous_or_missing_methods() {
+    for body in TYPED_TRANSLATION_NEGATIVE {
+        let (backend, _dir, uri, source) = typed_translation_workspace(body).await;
+        assert!(
+            definitions_at(&backend, &uri, &source, "messages.hello")
+                .await
+                .is_empty(),
+            "foreign/uncertain receiver must not borrow Laravel navigation: {body}"
+        );
+        let mut position = position_of(&source, "messages.hello");
+        position.character += 2;
+        let hover = backend
+            .hover(HoverParams {
+                text_document_position_params: TextDocumentPositionParams {
+                    text_document: TextDocumentIdentifier { uri: uri.clone() },
+                    position,
+                },
+                work_done_progress_params: Default::default(),
+            })
+            .await
+            .unwrap();
+        assert!(
+            hover.is_none(),
+            "foreign/uncertain receiver must not borrow Laravel hover: {body}"
+        );
+        assert!(trans_diagnostics(&backend, &uri, &source).is_empty());
+    }
+}

+#[tokio::test]
+async fn typed_translation_keys_follow_dirty_receiver_reassignment() {
+    let (backend, dir, uri, source) =
+        typed_translation_workspace(TYPED_TRANSLATION_POSITIVE[0]).await;
+    assert_eq!(
+        definitions_at(&backend, &uri, &source, "messages.hello")
+            .await
+            .len(),
+        2
+    );
+    let dirty = source.replace("return $text->", "$text = new Foreign; return $text->");
+    backend
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: uri.clone(),
+                version: 2,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: dirty.clone(),
+            }],
+        })
+        .await;
+    assert!(
+        definitions_at(&backend, &uri, &dirty, "messages.hello")
+            .await
+            .is_empty(),
+        "dirty reassignment must retire cached translation identity"
+    );
+    backend
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: uri.clone(),
+                version: 3,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: source.clone(),
+            }],
+        })
+        .await;
+    assert_eq!(
+        definitions_at(&backend, &uri, &source, "messages.hello")
+            .await
+            .len(),
+        2
+    );
+    assert_eq!(
+        std::fs::read_to_string(dir.path().join("app/Typed.php")).unwrap(),
+        source
+    );
+}

+#[tokio::test]
+async fn typed_translation_keys_references_include_valid_callers_only() {
+    let body = "function render(Text $text, Contract $contract, Text|Foreign $uncertain, Foreign $foreign) { /* 😀 */ $text->get('messages.hello'); $contract->choice('messages.hello', 2); $uncertain->get('messages.hello'); $foreign->get('messages.hello'); }";
+    let (backend, _dir, uri, source) = typed_translation_workspace(body).await;
+    let mut position = position_of(&source, "messages.hello");
+    position.character += 2;
+    let refs = backend
+        .references(ReferenceParams {
+            text_document_position: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier { uri: uri.clone() },
+                position,
+            },
+            context: ReferenceContext {
+                include_declaration: true,
+            },
+            work_done_progress_params: Default::default(),
+            partial_result_params: Default::default(),
+        })
+        .await
+        .unwrap()
+        .unwrap_or_default();
+    assert_eq!(
+        refs.len(),
+        4,
+        "two typed callers and two locale declarations, no ambiguous/foreign leaks: {refs:?}"
+    );
+    let callers: Vec<_> = refs.iter().filter(|x| x.uri == uri).collect();
+    assert_eq!(callers.len(), 2);
+    let offsets: Vec<_> = source
+        .match_indices("messages.hello")
+        .map(|(i, _)| Position::new(0, source[..i].encode_utf16().count() as u32))
+        .collect();
+    let mut found: Vec<_> = callers.iter().map(|x| x.range.start).collect();
+    found.sort();
+    assert_eq!(found, offsets[..2]);
+}

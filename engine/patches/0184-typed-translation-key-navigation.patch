+#[tokio::test]
+async fn typed_translation_keys_diagnose_only_proven_missing_keys() {
+    let body = "function render(Text $text, Foreign $foreign, Text|Foreign $uncertain) { /* 😀 */ $text->get('messages.absent'); $foreign->get('messages.foreign'); $uncertain->get('messages.uncertain'); }";
+    let (backend, _dir, uri, source) = typed_translation_workspace(body).await;
+    let messages = trans_diagnostics(&backend, &uri, &source);
+    assert_eq!(
+        messages.len(),
+        1,
+        "only the proven translator call is a missing key: {messages:?}"
+    );
+    assert!(messages[0].contains("messages.absent"));
+}

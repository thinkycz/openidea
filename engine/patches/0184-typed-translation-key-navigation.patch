@@ -2588,3 +2588,68 @@ function storedUnknownBranch(bool $condition, callable $unknown): void {
         "an unconditional unknown write must remove the old closure origin"
     );
 }
+
+#[test]
+fn source_owned_variable_memo_restores_after_reused_buffer_and_unwind() {
+    let alpha = Arc::new(make_class("Alpha"));
+    let omega = Arc::new(make_class("Omega"));
+    let classes = vec![Arc::clone(&alpha), Arc::clone(&omega)];
+    let loader = |name: &str| match name {
+        "Alpha" => Some(Arc::clone(&alpha)),
+        "Omega" => Some(Arc::clone(&omega)),
+        _ => None,
+    };
+    let current = ClassInfo::default();
+    for unwind in [false, true] {
+        let mut source =
+            "<?php class Alpha {} class Omega {} $value = new Alpha(); $value;".to_string();
+        let pointer = source.as_ptr();
+        let length = source.len();
+        let position = source.rfind("$value;").unwrap() as u32;
+        let resolve = |source: &str| {
+            ResolvedType::types_joined(&super::resolve_variable_types(
+                "$value",
+                &current,
+                &classes,
+                source,
+                position,
+                &loader,
+                None,
+                Loaders::default(),
+            ))
+            .to_string()
+        };
+        let _outer = super::with_var_type_memo();
+        assert_eq!(
+            resolve(&source),
+            "Alpha",
+            "outer source owns its original answer"
+        );
+        let name = source.find("new Alpha").unwrap() + 4;
+        source.replace_range(name..name + 5, "Omega");
+        assert_eq!(
+            source.as_ptr(),
+            pointer,
+            "deterministic same-allocation source reuse"
+        );
+        assert_eq!(source.len(), length);
+        let outcome = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            let _foreign = super::with_isolated_var_type_memo();
+            assert_eq!(
+                resolve(&source),
+                "Omega",
+                "a different source at the same address must not inherit variable types"
+            );
+            if unwind {
+                panic!("owned source unwind sentinel");
+            }
+        }));
+        assert_eq!(outcome.is_err(), unwind);
+        source.replace_range(name..name + 5, "Alpha");
+        assert_eq!(
+            resolve(&source),
+            "Alpha",
+            "foreign pass must restore the outer source's memo even after unwind"
+        );
+    }
+}

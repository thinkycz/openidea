+#[cfg(test)]
+mod startup_demand_tests {
+    use super::*;
+    use crate::symbol_map::{LaravelStringKind, SymbolKind};
+
+    const FACTORY: &str = r"<?php namespace Illuminate\Contracts\View; interface Factory {public function make($view, array $data=[]): mixed;}";
+    const TRANSLATOR: &str = r"<?php namespace Illuminate\Contracts\Translation; interface Translator {public function get($key, array $replace=[], $locale=null);}";
+    const TRANSLATOR_URI: &str = "file:///view-demand/Translator.php";
+    const URI: &str = "file:///view-demand/caller.php";
+    const SOURCE: &str = r"<?php /* 😀 */ namespace App;
+use Illuminate\Contracts\View\Factory;
+use Illuminate\Contracts\Translation\Translator;
+function page(Factory $views) {return $views->make('demand-page');}
+function label(Translator $text) {return $text->get('messages.hello');}
+";
+
+    fn publish(backend: &Backend, uri: &str, source: &str, version: i32) -> Arc<String> {
+        let source = Arc::new(source.to_owned());
+        backend.diag.documents.lock().open(uri, version, &source);
+        backend
+            .open_files
+            .write()
+            .insert(uri.to_owned(), Arc::clone(&source));
+        backend.update_ast(uri, &source);
+        source
+    }
+
+    fn fixture() -> Backend {
+        let backend = Backend::new_test();
+        backend.resolved_class_cache.write().set_laravel(true);
+        publish(&backend, "file:///view-demand/Factory.php", FACTORY, 1);
+        publish(&backend, TRANSLATOR_URI, TRANSLATOR, 1);
+        publish(&backend, URI, SOURCE, 1);
+        backend
+    }
+
+    fn keys(backend: &Backend) -> Vec<String> {
+        let map = backend.symbol_map_for(URI).unwrap();
+        let spans = backend.typed_receiver_view_spans_for(URI, &map);
+        let content = backend.open_files.read().get(URI).unwrap().clone();
+        let mut keys: Vec<_> = spans
+            .iter()
+            .map(|span| {
+                let SymbolKind::LaravelStringKey { kind, key, .. } = &span.kind else {
+                    panic!("real key span required")
+                };
+                assert_eq!(&content[span.start as usize..span.end as usize], key);
+                format!(
+                    "{}:{key}",
+                    match kind {
+                        LaravelStringKind::View => "view",
+                        LaravelStringKind::Trans => "trans",
+                        _ => panic!("unexpected key kind"),
+                    }
+                )
+            })
+            .collect();
+        keys.sort();
+        keys
+    }
+
+    fn startup(backend: &Backend) {
+        let content = backend.open_files.read().get(URI).unwrap().clone();
+        assert!(
+            backend.parse_blade_dependency_snapshot(URI, &content),
+            "real accepted caller dependency snapshot"
+        );
+    }
+
+    #[test]
+    fn startup_keeps_unrelated_translation_receiver_resolution_lazy() {
+        let backend = fixture();
+        let key = (
+            crate::atom::atom("Illuminate\\Contracts\\Translation\\Translator"),
+            Vec::new(),
+        );
+        assert!(!backend.resolved_class_cache.read().contains_key(&key));
+        startup(&backend);
+        assert!(
+            !backend.resolved_class_cache.read().contains_key(&key),
+            "view dependency startup must not resolve an unrelated translation receiver"
+        );
+        assert_eq!(keys(&backend), ["trans:messages.hello", "view:demand-page"]);
+        assert!(
+            backend.resolved_class_cache.read().contains_key(&key),
+            "a real translation query must still resolve its receiver"
+        );
+    }
+
+    #[test]
+    fn startup_and_full_key_queries_keep_both_kinds_in_either_order() {
+        for full_first in [false, true] {
+            let backend = fixture();
+            if full_first {
+                assert_eq!(keys(&backend), ["trans:messages.hello", "view:demand-page"]);
+            }
+            startup(&backend);
+            assert_eq!(keys(&backend), ["trans:messages.hello", "view:demand-page"]);
+            startup(&backend);
+            assert_eq!(keys(&backend), ["trans:messages.hello", "view:demand-page"]);
+        }
+    }
+
+    #[test]
+    fn demand_caches_follow_same_length_dependency_and_caller_changes() {
+        let backend = fixture();
+        startup(&backend);
+        assert_eq!(keys(&backend), ["trans:messages.hello", "view:demand-page"]);
+        let missing = TRANSLATOR.replace("function get(", "function put(");
+        assert_eq!(missing.len(), TRANSLATOR.len());
+        publish(&backend, TRANSLATOR_URI, &missing, 2);
+        startup(&backend);
+        assert_eq!(keys(&backend), ["view:demand-page"]);
+        publish(&backend, TRANSLATOR_URI, TRANSLATOR, 3);
+        startup(&backend);
+        assert_eq!(keys(&backend), ["trans:messages.hello", "view:demand-page"]);
+        let changed = SOURCE.replace("messages.hello", "messages.other");
+        assert_eq!(changed.len(), SOURCE.len());
+        publish(&backend, URI, &changed, 2);
+        startup(&backend);
+        assert_eq!(keys(&backend), ["trans:messages.other", "view:demand-page"]);
+        publish(&backend, URI, SOURCE, 3);
+        startup(&backend);
+        assert_eq!(keys(&backend), ["trans:messages.hello", "view:demand-page"]);
+    }
+}

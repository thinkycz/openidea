+#[tokio::test]
+async fn translation_catalog_origin_php_roots_groups_and_utf16_ranges() {
+    let english = "<?php /* 😀 */ return ['hello'=>'Hello', 'group'=>['child'=>'Child']];";
+    let french = "<?php return ['hello'=>'Bonjour'];";
+    let template = "😀 {{ __('messages.hello') }}";
+    let (backend, dir, uri, source) = workspace(
+        LARAVEL_APP_COMPOSER,
+        &[
+            ("lang/en/messages.php", english),
+            ("resources/lang/fr/messages.php", french),
+            ("resources/views/page.blade.php", template),
+        ],
+        "__('messages.hello'); trans('messages.hello'); __('messages.group'); __('messages.group.child');",
+    ).await;
+    let blade = open_blade_template(&backend, "resources/views/page.blade.php").await;
+    for include_declaration in [false, true] {
+        let callers = crate::common::find_references(
+            &backend,
+            &uri,
+            position_of(&source, "messages.hello"),
+            include_declaration,
+        )
+        .await;
+        assert_eq!(
+            callers.len(),
+            if include_declaration { 5 } else { 3 },
+            "{callers:?}"
+        );
+        let at = position_of(template, "messages.hello");
+        assert!(callers.contains(&Location::new(
+            blade.clone(),
+            Range::new(at, Position::new(at.line, at.character + 14))
+        )));
+        for (path, text) in [
+            ("lang/en/messages.php", english),
+            ("resources/lang/fr/messages.php", french),
+        ] {
+            let declaration_uri = Url::from_file_path(dir.path().join(path)).unwrap();
+            let found = crate::common::find_references(
+                &backend,
+                &declaration_uri,
+                position_of(text, "hello"),
+                include_declaration,
+            )
+            .await;
+            assert_eq!(
+                found, callers,
+                "{path}: declaration and caller must identify the same translation"
+            );
+            if include_declaration {
+                let at = position_of(text, "hello");
+                assert!(found.contains(&Location::new(
+                    declaration_uri,
+                    Range::new(at, Position::new(at.line, at.character + 5))
+                )));
+            }
+        }
+    }
+    let en = Url::from_file_path(dir.path().join("lang/en/messages.php")).unwrap();
+    for (needle, key) in [
+        ("group", "messages.group'"),
+        ("child", "messages.group.child"),
+    ] {
+        let expected =
+            crate::common::find_references(&backend, &uri, position_of(&source, key), true).await;
+        assert_eq!(expected.len(), 2, "{key}: {expected:?}");
+        assert_eq!(
+            crate::common::find_references(&backend, &en, position_of(english, needle), true).await,
+            expected
+        );
+    }
+    assert!(
+        crate::common::find_references(&backend, &en, position_of(english, "Hello"), true)
+            .await
+            .is_empty()
+    );
+}

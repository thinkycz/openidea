+#[tokio::test]
+async fn translation_catalog_origin_custom_json_roots_follow_dirty_provider_selection() {
+    let provider = BILLING_PROVIDER.replace(
+        "$this->loadTranslationsFrom(__DIR__.'/../lang', 'billing');",
+        "$this->loadJsonTranslationsFrom(__DIR__.'/../json');",
+    );
+    let json = r#"{"Greeting 😀":"Welcome"}"#;
+    let (backend, dir, uri, source) = workspace(
+        PACKAGE_COMPOSER,
+        &[
+            ("bootstrap/providers.php", PACKAGE_PROVIDER_LIST),
+            ("packages/billing/src/BillingServiceProvider.php", &provider),
+            ("packages/billing/json/en.json", json),
+            ("packages/billing/alternate/en.json", json),
+        ],
+        "__('Greeting 😀');",
+    )
+    .await;
+    let active = Url::from_file_path(dir.path().join("packages/billing/json/en.json")).unwrap();
+    let alternate =
+        Url::from_file_path(dir.path().join("packages/billing/alternate/en.json")).unwrap();
+    for target in [&active, &alternate] {
+        crate::common::open_document(&backend, target, "json", json).await;
+    }
+    let expected =
+        crate::common::find_references(&backend, &uri, position_of(&source, "Greeting"), true)
+            .await;
+    assert_eq!(expected.len(), 2, "{expected:?}");
+    assert_eq!(
+        crate::common::find_references(&backend, &active, position_of(json, "Greeting"), true)
+            .await,
+        expected
+    );
+    assert!(
+        crate::common::find_references(&backend, &alternate, position_of(json, "Greeting"), true)
+            .await
+            .is_empty()
+    );
+    let provider_uri = Url::from_file_path(
+        dir.path()
+            .join("packages/billing/src/BillingServiceProvider.php"),
+    )
+    .unwrap();
+    crate::common::open_php(&backend, &provider_uri, &provider).await;
+    backend
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: provider_uri.clone(),
+                version: 2,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: provider.replace("../json", "../alternate"),
+            }],
+        })
+        .await;
+    let expected_alternate =
+        crate::common::find_references(&backend, &uri, position_of(&source, "Greeting"), true)
+            .await;
+    assert_eq!(expected_alternate.len(), 2);
+    assert!(
+        expected_alternate
+            .iter()
+            .any(|location| location.uri == alternate)
+    );
+    assert_eq!(
+        crate::common::find_references(&backend, &alternate, position_of(json, "Greeting"), true)
+            .await,
+        expected_alternate
+    );
+    assert!(
+        crate::common::find_references(&backend, &active, position_of(json, "Greeting"), true)
+            .await
+            .is_empty()
+    );
+    backend
+        .did_close(DidCloseTextDocumentParams {
+            text_document: TextDocumentIdentifier { uri: provider_uri },
+        })
+        .await;
+    assert_eq!(
+        crate::common::find_references(&backend, &active, position_of(json, "Greeting"), true)
+            .await,
+        expected
+    );
+    assert!(
+        crate::common::find_references(&backend, &alternate, position_of(json, "Greeting"), true)
+            .await
+            .is_empty()
+    );
+    assert_eq!(
+        std::fs::read_to_string(
+            dir.path()
+                .join("packages/billing/src/BillingServiceProvider.php")
+        )
+        .unwrap(),
+        provider
+    );
+}

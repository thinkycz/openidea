+#[tokio::test]
+async fn translation_catalog_origin_follows_dirty_keys_callers_and_unsaved_files() {
+    let initial = "<?php /* 😀 */ return ['saved'=>'Saved'];";
+    let (backend, dir, uri, source) = workspace(
+        LARAVEL_APP_COMPOSER,
+        &[("lang/en/messages.php", initial)],
+        "__('messages.saved'); __('messages.other'); __('draft.saved');",
+    )
+    .await;
+    let en = Url::from_file_path(dir.path().join("lang/en/messages.php")).unwrap();
+    crate::common::open_php(&backend, &en, initial).await;
+    assert_eq!(
+        crate::common::find_references(&backend, &en, position_of(initial, "saved"), false)
+            .await
+            .len(),
+        1
+    );
+    let dirty = initial.replace("'saved'", "'other'");
+    backend
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: en.clone(),
+                version: 2,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: dirty.clone(),
+            }],
+        })
+        .await;
+    let expected = crate::common::find_references(
+        &backend,
+        &uri,
+        position_of(&source, "messages.other"),
+        false,
+    )
+    .await;
+    assert_eq!(expected.len(), 1);
+    assert_eq!(
+        crate::common::find_references(&backend, &en, position_of(&dirty, "other"), false).await,
+        expected
+    );
+    backend
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: uri.clone(),
+                version: 2,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: source.replace("messages.saved", "messages.other"),
+            }],
+        })
+        .await;
+    assert_eq!(
+        crate::common::find_references(&backend, &en, position_of(&dirty, "other"), false)
+            .await
+            .len(),
+        2
+    );
+    backend
+        .did_close(DidCloseTextDocumentParams {
+            text_document: TextDocumentIdentifier { uri: uri.clone() },
+        })
+        .await;
+    assert_eq!(
+        crate::common::find_references(&backend, &en, position_of(&dirty, "other"), false).await,
+        expected
+    );
+    backend
+        .did_close(DidCloseTextDocumentParams {
+            text_document: TextDocumentIdentifier { uri: en.clone() },
+        })
+        .await;
+    let original = crate::common::find_references(
+        &backend,
+        &uri,
+        position_of(&source, "messages.saved"),
+        false,
+    )
+    .await;
+    assert_eq!(
+        crate::common::find_references(&backend, &en, position_of(initial, "saved"), false).await,
+        original
+    );
+    let draft_path = dir.path().join("lang/en/draft.php");
+    let draft = Url::from_file_path(&draft_path).unwrap();
+    crate::common::open_php(&backend, &draft, initial).await;
+    assert_eq!(
+        crate::common::find_references(&backend, &draft, position_of(initial, "saved"), true)
+            .await
+            .len(),
+        2
+    );
+    backend
+        .did_close(DidCloseTextDocumentParams {
+            text_document: TextDocumentIdentifier { uri: draft },
+        })
+        .await;
+    assert!(!draft_path.exists());
+    assert_eq!(
+        std::fs::read_to_string(dir.path().join("lang/en/messages.php")).unwrap(),
+        initial
+    );
+    assert_eq!(
+        std::fs::read_to_string(dir.path().join("app/Demo.php")).unwrap(),
+        source
+    );
+}

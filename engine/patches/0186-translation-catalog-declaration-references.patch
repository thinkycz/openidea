+                expected.push(location);
+            }
+        }
+    }
+    assert_eq!(expected.len(), 3);
+    let declaration =
+        Url::from_file_path(dir.path().join("packages/billing/lang/en/invoice.php")).unwrap();
+    for include_declaration in [false, true] {
+        let found = crate::common::find_references(
+            &backend,
+            &declaration,
+            position_of(BILLING_INVOICE, "total"),
+            include_declaration,
+        )
+        .await;
+        assert_eq!(
+            found.len(),
+            if include_declaration { 3 } else { 2 },
+            "{found:?}"
+        );
+        assert!(found.iter().all(|location| expected.contains(location)));
+        assert!(include_declaration || found.iter().all(|location| location.uri == uri));
+    }
+}

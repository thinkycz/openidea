+#[tokio::test]
+async fn translation_catalog_origin_unsaved_registered_php_and_json_files() {
+    let provider = BILLING_PROVIDER.replace(
+        "$this->loadTranslationsFrom(__DIR__.'/../lang', 'billing');",
+        "$this->loadTranslationsFrom(__DIR__.'/../lang', 'billing');\n        $this->loadTranslationsFrom(__DIR__.'/../lang', 'bakery');\n        $this->loadJsonTranslationsFrom(__DIR__.'/../json');",
+    );
+    let (backend, dir, uri, source) = workspace(
+        PACKAGE_COMPOSER,
+        &[
+            ("bootstrap/providers.php", PACKAGE_PROVIDER_LIST),
+            ("packages/billing/src/BillingServiceProvider.php", &provider),
+            ("lang/en/messages.php", "<?php return ['control'=>'Existing'];"),
+            ("lang/en.json", r#"{"Control":"Existing"}"#),
+            ("packages/billing/lang/en/invoice.php", BILLING_INVOICE),
+            ("packages/billing/json/en.json", r#"{"Control":"Existing"}"#),
+        ],
+        "__('messages.draft'); __('billing::invoice.draft'); __('bakery::invoice.draft'); __('New app draft 😀'); __('New package draft 😀');",
+    ).await;
+    let drafts = [
+        (
+            "lang/fr/messages.php",
+            "<?php /* 😀 */ return ['draft'=>'New line'];",
+            "draft",
+            "php",
+            2,
+        ),
+        (
+            "packages/billing/lang/fr/invoice.php",
+            "<?php /* 😀 */ return ['draft'=>'New line'];",
+            "draft",
+            "php",
+            3,
+        ),
+        (
+            "lang/fr.json",
+            r#"{"New app draft 😀":"New line"}"#,
+            "New app draft",
+            "json",
+            2,
+        ),
+        (
+            "packages/billing/json/fr.json",
+            r#"{"New package draft 😀":"New line"}"#,
+            "New package draft",
+            "json",
+            2,
+        ),
+    ];
+    for (path, text, _, language, _) in drafts {
+        let target = Url::from_file_path(dir.path().join(path)).unwrap();
+        crate::common::open_document(&backend, &target, language, text).await;
+        assert!(!dir.path().join(path).exists());
+    }
+    for (path, text, needle, _, count) in drafts {
+        let target = Url::from_file_path(dir.path().join(path)).unwrap();
+        let found =
+            crate::common::find_references(&backend, &target, position_of(text, needle), true)
+                .await;
+        assert_eq!(found.len(), count, "{path}: {found:?}");
+        assert!(found.iter().any(|location| location.uri == target));
+        assert!(
+            found
+                .iter()
+                .all(|location| location.uri == target || location.uri == uri)
+        );
+    }
+    let keys = [
+        ("messages.draft", "lang/fr/messages.php"),
+        (
+            "billing::invoice.draft",
+            "packages/billing/lang/fr/invoice.php",
+        ),
+        (
+            "bakery::invoice.draft",
+            "packages/billing/lang/fr/invoice.php",
+        ),
+        ("New app draft 😀", "lang/fr.json"),
+        ("New package draft 😀", "packages/billing/json/fr.json"),
+    ];
+    for (key, path) in keys {
+        let definitions = definitions_at(&backend, &uri, &source, key).await;
+        assert_eq!(definitions.len(), 1, "{key}: {definitions:?}");
+        assert_eq!(
+            definitions[0].uri,
+            Url::from_file_path(dir.path().join(path)).unwrap()
+        );
+        assert_eq!(
+            crate::common::find_references(&backend, &uri, position_of(&source, key), true)
+                .await
+                .len(),
+            2
+        );
+    }
+    for (path, _, _, _, _) in drafts {
+        let target = Url::from_file_path(dir.path().join(path)).unwrap();
+        backend
+            .did_close(DidCloseTextDocumentParams {
+                text_document: TextDocumentIdentifier { uri: target },
+            })
+            .await;
+        assert!(!dir.path().join(path).exists());
+    }
+    for (key, _) in keys {
+        assert!(
+            definitions_at(&backend, &uri, &source, key)
+                .await
+                .is_empty(),
+            "{key}"
+        );
+        assert_eq!(
+            crate::common::find_references(&backend, &uri, position_of(&source, key), true)
+                .await
+                .len(),
+            1
+        );
+    }
+    assert_eq!(
+        std::fs::read_to_string(dir.path().join("app/Demo.php")).unwrap(),
+        source
+    );
+}

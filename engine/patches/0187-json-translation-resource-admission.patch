+#[tokio::test]
+async fn json_resource_admission_tracks_dirty_provider_selection_and_discard() {
+    let provider = BILLING_PROVIDER.replace(
+        "$this->loadTranslationsFrom(__DIR__.'/../lang', 'billing');",
+        "$this->loadJsonTranslationsFrom(__DIR__.'/../json');",
+    );
+    let (backend, dir, uri, _) = workspace(
+        PACKAGE_COMPOSER,
+        &[
+            ("bootstrap/providers.php", PACKAGE_PROVIDER_LIST),
+            ("packages/billing/src/BillingServiceProvider.php", &provider),
+        ],
+        "",
+    )
+    .await;
+    let active = Url::from_file_path(dir.path().join("packages/billing/json/fr.json")).unwrap();
+    let alternate =
+        Url::from_file_path(dir.path().join("packages/billing/alternate/fr.json")).unwrap();
+    let provider_uri = Url::from_file_path(
+        dir.path()
+            .join("packages/billing/src/BillingServiceProvider.php"),
+    )
+    .unwrap();
+    for phase in 0..3 {
+        if phase == 1 {
+            crate::common::open_php(&backend, &provider_uri, &provider).await;
+            backend
+                .did_change(DidChangeTextDocumentParams {
+                    text_document: VersionedTextDocumentIdentifier {
+                        uri: provider_uri.clone(),
+                        version: 2,
+                    },
+                    content_changes: vec![TextDocumentContentChangeEvent {
+                        range: None,
+                        range_length: None,
+                        text: provider.replace("../json", "../alternate"),
+                    }],
+                })
+                .await;
+        } else if phase == 2 {
+            backend
+                .did_close(DidCloseTextDocumentParams {
+                    text_document: TextDocumentIdentifier {
+                        uri: provider_uri.clone(),
+                    },
+                })
+                .await;
+        }
+        for (target, registered) in [(&active, phase != 1), (&alternate, phase == 1)] {
+            let expected = registered.then(|| {
+                Url::from_directory_path(target.to_file_path().unwrap().parent().unwrap()).unwrap()
+            });
+            assert_eq!(
+                query_json_resource(&backend, &uri, target)
+                    .await
+                    .unwrap()
+                    .root_uri,
+                expected,
+                "dirty provider decisions must use the preferred resource directory URI"
+            );
+        }
+        assert!(!dir.path().join("packages/billing/json").exists());
+        assert!(!dir.path().join("packages/billing/alternate").exists());
+    }
+    assert_eq!(
+        std::fs::read_to_string(provider_uri.to_file_path().unwrap()).unwrap(),
+        provider
+    );
+}

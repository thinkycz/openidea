+#[tokio::test]
+async fn json_resource_admission_keeps_nested_psr4_consumers_current_without_sibling_leakage() {
+    use phpantom_lsp::ProjectRouter;
+    use phpantom_lsp::workbench_translation_resources::TranslationResourceQuery;
+    let directory = tempfile::tempdir().unwrap();
+    let root = directory.path().canonicalize().unwrap();
+    let provider = BILLING_PROVIDER.replace(
+        "$this->loadTranslationsFrom(__DIR__.'/../lang', 'billing');",
+        "$this->loadJsonTranslationsFrom(__DIR__.'/../json');",
+    );
+    for (path, text) in [
+        ("composer.json", PACKAGE_COMPOSER),
+        ("app/Demo.php", "<?php"),
+        ("bootstrap/providers.php", PACKAGE_PROVIDER_LIST),
+        (
+            "packages/billing/composer.json",
+            r#"{"name":"acme/billing","autoload":{"psr-4":{"Acme\\Billing\\":"src/"}}}"#,
+        ),
+        (
+            "packages/billing/src/BillingServiceProvider.php",
+            provider.as_str(),
+        ),
+        ("other/composer.json", LARAVEL_APP_COMPOSER),
+        ("other/app/Demo.php", "<?php"),
+    ] {
+        let path = root.join(path);
+        std::fs::create_dir_all(path.parent().unwrap()).unwrap();
+        std::fs::write(path, text).unwrap();
+    }
+    let router = std::sync::Arc::new(ProjectRouter::new_test());
+    router
+        .initialize(InitializeParams {
+            root_uri: Some(Url::from_directory_path(&root).unwrap()),
+            workspace_folders: Some(vec![WorkspaceFolder {
+                uri: Url::from_directory_path(&root).unwrap(),
+                name: "nested-provider".into(),
+            }]),
+            ..InitializeParams::default()
+        })
+        .await
+        .unwrap();
+    router.initialized(InitializedParams {}).await;
+    let worker = std::sync::Arc::clone(&router);
+    let outcome = tokio::spawn(async move {
+        let router = worker;
+        let project = Url::from_file_path(root.join("app/Demo.php")).unwrap();
+        let sibling = Url::from_file_path(root.join("other/app/Demo.php")).unwrap();
+        let active = Url::from_file_path(root.join("packages/billing/json/fr.json")).unwrap();
+        let alternate =
+            Url::from_file_path(root.join("packages/billing/alternate/fr.json")).unwrap();
+        let provider_uri =
+            Url::from_file_path(root.join("packages/billing/src/BillingServiceProvider.php"))
+                .unwrap();
+        let initial = router
+            .workbench_json_translation_resource(TranslationResourceQuery {
+                project_uri: project.clone(),
+                resource_uri: active.clone(),
+            })
+            .await
+            .unwrap();
+        assert!(
+            initial.root_uri.is_some(),
+            "declared consuming graph must discover the provider before any buffer is opened"
+        );
+        router
+            .did_open(DidOpenTextDocumentParams {
+                text_document: TextDocumentItem {
+                    uri: provider_uri.clone(),
+                    language_id: "php".into(),
+                    version: 1,
+                    text: provider.clone(),
+                },
+            })
+            .await;
+        router
+            .did_change(DidChangeTextDocumentParams {
+                text_document: VersionedTextDocumentIdentifier {
+                    uri: provider_uri.clone(),
+                    version: 2,
+                },
+                content_changes: vec![TextDocumentContentChangeEvent {
+                    range: None,
+                    range_length: None,
+                    text: provider.replace("../json", "../alternate"),
+                }],
+            })
+            .await;
+        for (target, expected) in [(&alternate, true), (&active, false)] {
+            let reply = router
+                .workbench_json_translation_resource(TranslationResourceQuery {
+                    project_uri: project.clone(),
+                    resource_uri: target.clone(),
+                })
+                .await
+                .unwrap();
+            assert_eq!(
+                reply.root_uri,
+                expected.then(|| Url::from_directory_path(
+                    target.to_file_path().unwrap().parent().unwrap()
+                )
+                .unwrap()),
+                "nested Composer PSR-4 consumers must receive dirty provider buffers"
+            );
+            let unrelated = router
+                .workbench_json_translation_resource(TranslationResourceQuery {
+                    project_uri: sibling.clone(),
+                    resource_uri: target.clone(),
+                })
+                .await
+                .unwrap();
+            assert!(
+                unrelated.root_uri.is_none(),
+                "a sibling Composer project must not inherit this provider"
+            );
+        }
+        router
+            .did_close(DidCloseTextDocumentParams {
+                text_document: TextDocumentIdentifier {
+                    uri: provider_uri.clone(),
+                },
+            })
+            .await;
+        for (target, expected) in [(&active, true), (&alternate, false)] {
+            let reply = router
+                .workbench_json_translation_resource(TranslationResourceQuery {
+                    project_uri: project.clone(),
+                    resource_uri: target.clone(),
+                })
+                .await
+                .unwrap();
+            assert_eq!(
+                reply.root_uri,
+                expected.then(|| Url::from_directory_path(
+                    target.to_file_path().unwrap().parent().unwrap()
+                )
+                .unwrap()),
+                "discard must restore the consuming project's registered roots"
+            );
+        }
+        assert_eq!(
+            std::fs::read_to_string(provider_uri.to_file_path().unwrap()).unwrap(),
+            provider
+        );
+        assert!(
+            !active.to_file_path().unwrap().exists() && !alternate.to_file_path().unwrap().exists()
+        );
+    })
+    .await;
+    router.shutdown().await.unwrap();
+    if let Err(error) = outcome {
+        if error.is_panic() {
+            std::panic::resume_unwind(error.into_panic());
+        }
+        panic!("router regression task was cancelled: {error}");
+    }
+}

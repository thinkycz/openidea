+    let oversized =
+        Url::from_file_path(dir.path().join(format!("{}.json", "x".repeat(1_048_577)))).unwrap();
+    assert!(
+        query_json_resource(&backend, &uri, &oversized)
+            .await
+            .is_err()
+    );
+    let request = serde_json::json!({"projectUri":uri,"resourceUri":resource,"text":"must not transmit contents"});
+    assert!(
+        serde_json::from_value::<
+            phpantom_lsp::workbench_translation_resources::TranslationResourceQuery,
+        >(request)
+        .is_err()

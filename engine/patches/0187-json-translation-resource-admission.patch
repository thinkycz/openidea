diff --git a/src/workbench_translation_resources.rs b/src/workbench_translation_resources.rs
new file mode 100644
index 0000000000000000000000000000000000000000..957c0ebedb4cc996f08e1b341f18b865ff130134
--- /dev/null
+++ b/src/workbench_translation_resources.rs
@@ -0,0 +1,176 @@
+//! Content-free admission for a JSON translation overlay.
+use std::path::PathBuf;
+
+use crate::{Backend, project_router::ProjectRouter};
+use serde::{Deserialize, Serialize};
+use tower_lsp::{
+    jsonrpc::{Error, Result},
+    lsp_types::Url,
+};
+
+/// Query a resource before forwarding its contents to the PHP server.
+pub const METHOD: &str = "phpWorkbench/jsonTranslationResource";
+/// The server can classify registered resources without a didOpen notification.
+pub const CAPABILITY: &str = "phpWorkbenchJsonTranslationResource";
+
+/// The consuming PHP project and a proposed JSON locale file.
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct TranslationResourceQuery {
+    /// Existing PHP project document or Composer manifest selecting the graph.
+    pub project_uri: Url,
+    /// Preferred physical spelling; the file and parent directories may be new.
+    pub resource_uri: Url,
+}
+
+/// A current static registration decision; no file content is returned.
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct TranslationResourceReply {
+    /// Echo of the project selector used for this request.
+    pub project_uri: Url,
+    /// Echo of the exact proposed resource authority.
+    pub resource_uri: Url,
+    /// Direct JSON locale directory, or null when not statically registered.
+    pub root_uri: Option<Url>,
+}
+
+fn local_path(uri: &Url) -> Result<PathBuf> {
+    if uri.as_str().len() > 1024 * 1024
+        || uri.scheme() != "file"
+        || uri.query().is_some()
+        || uri.fragment().is_some()
+    {
+        return Err(Error::invalid_params("Expected a bounded local file URI"));
+    }
+    let path = uri
+        .to_file_path()
+        .map_err(|_| Error::invalid_params("Expected a local file URI"))?;
+    if !path.is_absolute() || path.to_str().is_none_or(|p| p.contains('\0')) {
+        return Err(Error::invalid_params("Expected an absolute local path"));
+    }
+    if Url::from_file_path(&path).ok().as_ref() != Some(uri) {
+        return Err(Error::invalid_params("Expected an unambiguous file URI"));
+    }
+    Ok(path)
+}
+
+fn local_authority(uri: &Url) -> Result<PathBuf> {
+    let path = local_path(uri)?;
+    let mut ancestor = path.as_path();
+    let mut missing = Vec::new();
+    let physical = loop {
+        match std::fs::symlink_metadata(ancestor) {
+            Ok(_) => {
+                break ancestor
+                    .canonicalize()
+                    .map_err(|_| Error::invalid_params("Unresolvable file authority"))?;
+            }
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+                missing.push(
+                    ancestor
+                        .file_name()
+                        .ok_or_else(|| Error::invalid_params("Missing file authority"))?
+                        .to_owned(),
+                );
+                ancestor = ancestor
+                    .parent()
+                    .ok_or_else(|| Error::invalid_params("Missing file authority"))?;
+            }
+            Err(_) => return Err(Error::invalid_params("Unreadable file authority")),
+        }
+    };
+    let physical = missing
+        .into_iter()
+        .rev()
+        .fold(physical, |path, part| path.join(part));
+    if physical != path || Url::from_file_path(&physical).ok().as_ref() != Some(uri) {
+        return Err(Error::invalid_params("Use the preferred physical file URI"));
+    }
+    Ok(path)
+}
+
+impl TranslationResourceQuery {
+    fn validate(&self) -> Result<PathBuf> {
+        let project = local_path(&self.project_uri)?;
+        if !(project.extension().is_some_and(|ext| ext == "php")
+            || project
+                .file_name()
+                .is_some_and(|name| name == "composer.json"))
+        {
+            return Err(Error::invalid_params(
+                "Select a PHP project document or Composer manifest",
+            ));
+        }
+        let resource = local_path(&self.resource_uri)?;
+        if resource.extension().is_none_or(|ext| ext != "json")
+            || resource.file_stem().is_none_or(|name| name.is_empty())
+        {
+            return Err(Error::invalid_params("Expected a JSON locale file"));
+        }
+        Ok(resource)
+    }
+
+    fn validate_authority(&self) -> Result<PathBuf> {
+        self.validate()?;
+        if !local_authority(&self.project_uri)?.is_file() {
+            return Err(Error::invalid_params(
+                "Select an existing PHP project document or Composer manifest",
+            ));
+        }
+        let resource = local_authority(&self.resource_uri)?;
+        if std::fs::metadata(&resource).is_ok_and(|metadata| !metadata.is_file()) {
+            return Err(Error::invalid_params("Expected a regular JSON locale file"));
+        }
+        Ok(resource)
+    }
+}
+
+impl ProjectRouter {
+    /// Use the caller's Composer context, including package-provider registrations.
+    pub async fn workbench_json_translation_resource(
+        &self,
+        query: TranslationResourceQuery,
+    ) -> Result<TranslationResourceReply> {
+        query.validate()?;
+        let _request = self.request_guard().await;
+        self.project_for(&query.project_uri)
+            .await?
+            .backend
+            .workbench_json_translation_resource(query)
+            .await
+    }
+}
+
+impl Backend {
+    /// Classify only current static registrations, without running framework code.
+    pub async fn workbench_json_translation_resource(
+        &self,
+        query: TranslationResourceQuery,
+    ) -> Result<TranslationResourceReply> {
+        let path = query.validate()?;
+        let backend = self.clone_for_blocking();
+        crate::server::run_blocking_cancel_safe("json_translation_resource", move || {
+            backend.with_prepared_current_semantics(|| {
+                // Revalidate after preparation, including external alias changes.
+                let current = query.validate_authority()?;
+                if current != path {
+                    return Err(Error::invalid_params("Resource authority changed"));
+                }
+                let root = if backend.resolved_class_cache.read().is_laravel() {
+                    backend.json_translation_resource_root(&path)
+                } else {
+                    None
+                };
+                let root_uri = root.and_then(|path| Url::from_directory_path(path).ok());
+                Ok(TranslationResourceReply {
+                    project_uri: query.project_uri.clone(),
+                    resource_uri: query.resource_uri.clone(),
+                    root_uri,
+                })
+            })
+        })
+        .await
+        .ok_or_else(Error::internal_error)?
+    }
+}

+                .await
+                .unwrap_err()
+                .code,
+            tower_lsp::jsonrpc::ErrorCode::InvalidParams,
+            "{target}"
+        );
+    }
+    let directory = dir.path().join("lang/directory.json");
+    std::fs::create_dir_all(&directory).unwrap();
+    assert!(
+        query_json_resource(&backend, &uri, &Url::from_file_path(directory).unwrap())
+            .await
+            .is_err()
+    );
+    for project in [
+        Url::parse("untitled:project.php").unwrap(),
+        Url::from_file_path(dir.path().join("missing.php")).unwrap(),
+        resource.clone(),
+    ] {
+        assert!(
+            query_json_resource(&backend, &project, &resource)
+                .await
+                .is_err()
+        );

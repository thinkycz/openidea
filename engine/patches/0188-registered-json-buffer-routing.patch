+async fn registered_json_buffer_case(mode: &str) {
+    use phpantom_lsp::{ProjectRouter, workbench_translation_resources::TranslationResourceQuery};
+    let directory = tempfile::tempdir().unwrap();
+    let root = directory.path().canonicalize().unwrap();
+    let provider = BILLING_PROVIDER.replace(
+        "$this->loadTranslationsFrom(__DIR__.'/../lang', 'billing');",
+        "$this->loadJsonTranslationsFrom(__DIR__.'/../json');",
+    );
+    let caller = "<?php /* 😀 */ __('Greeting 😀'); __('New draft 😀');";
+    let json = r#"{"Greeting 😀":"Welcome"}"#;
+    let draft = r#"{"New draft 😀":"Bonjour"}"#;
+    for (path, text) in [
+        ("composer.json", PACKAGE_COMPOSER),
+        ("app/Demo.php", caller),
+        ("bootstrap/providers.php", PACKAGE_PROVIDER_LIST),
+        (
+            "packages/billing/composer.json",
+            r#"{"name":"acme/billing","autoload":{"psr-4":{"Acme\\Billing\\":"src/"}}}"#,
+        ),
+        (
+            "packages/billing/src/BillingServiceProvider.php",
+            provider.as_str(),
+        ),
+        ("packages/billing/json/en.json", json),
+        ("other/composer.json", LARAVEL_APP_COMPOSER),
+        ("other/app/Demo.php", caller),
+    ] {
+        let path = root.join(path);
+        std::fs::create_dir_all(path.parent().unwrap()).unwrap();
+        std::fs::write(path, text).unwrap();
+    }
+    let router = std::sync::Arc::new(ProjectRouter::new_test());
+    router
+        .initialize(InitializeParams {
+            root_uri: Some(Url::from_directory_path(&root).unwrap()),
+            workspace_folders: Some(vec![WorkspaceFolder {
+                uri: Url::from_directory_path(&root).unwrap(),
+                name: "registered-json".into(),
+            }]),
+            ..Default::default()
+        })
+        .await
+        .unwrap();
+    router.initialized(InitializedParams {}).await;
+    let worker = std::sync::Arc::clone(&router);
+    let mode = mode.to_owned();
+    let outcome = tokio::spawn(async move {
+        let project = Url::from_file_path(root.join("app/Demo.php")).unwrap();
+        let sibling = Url::from_file_path(root.join("other/app/Demo.php")).unwrap();
+        let catalog = Url::from_file_path(root.join("packages/billing/json/en.json")).unwrap();
+        let new = Url::from_file_path(root.join("packages/billing/json/fr.json")).unwrap();
+        let selected = if mode == "unsaved" { &new } else { &catalog };
+        let selected_text = if mode == "unsaved" { draft } else { json };
+        let key = if mode == "unsaved" {
+            "New draft 😀"
+        } else {
+            "Greeting 😀"
+        };
+        let registration = worker
+            .workbench_json_translation_resource(TranslationResourceQuery {
+                project_uri: project.clone(),
+                resource_uri: selected.clone(),
+            })
+            .await
+            .unwrap();
+        assert!(registration.root_uri.is_some());
+        for uri in [&project, &sibling] {
+            worker
+                .did_open(DidOpenTextDocumentParams {
+                    text_document: TextDocumentItem {
+                        uri: uri.clone(),
+                        language_id: "php".into(),
+                        version: 1,
+                        text: caller.into(),
+                    },
+                })
+                .await;
+        }
+        let references = |uri: Url, text: &str| ReferenceParams {
+            text_document_position: TextDocumentPositionParams {
+                text_document: TextDocumentIdentifier { uri },
+                position: position_of(text, key),
+            },
+            context: ReferenceContext {
+                include_declaration: true,
+            },
+            work_done_progress_params: Default::default(),
+            partial_result_params: Default::default(),
+        };
+        let location = |uri: Url, text: &str| {
+            let start = position_of(text, key);
+            Location::new(
+                uri,
+                Range::new(
+                    start,
+                    Position::new(
+                        start.line,
+                        start.character + key.encode_utf16().count() as u32,
+                    ),
+                ),
+            )
+        };
+        let mut expected = vec![
+            location(project.clone(), caller),
+            location(selected.clone(), selected_text),
+        ];
+        expected.sort_by(|a, b| a.uri.as_str().cmp(b.uri.as_str()));
+        if mode == "origin" {
+            let found = worker
+                .references(references(selected.clone(), selected_text))
+                .await
+                .unwrap()
+                .unwrap_or_default();
+            assert_eq!(
+                found, expected,
+                "closed catalog origin must select its registered Laravel consumer"
+            );
+        }
+        worker
+            .did_open(DidOpenTextDocumentParams {
+                text_document: TextDocumentItem {
+                    uri: selected.clone(),
+                    language_id: "json".into(),
+                    version: 1,
+                    text: selected_text.into(),
+                },
+            })
+            .await;
+        if mode == "dirty" || mode == "reload" {
+            worker
+                .did_change(DidChangeTextDocumentParams {
+                    text_document: VersionedTextDocumentIdentifier {
+                        uri: selected.clone(),
+                        version: 2,
+                    },
+                    content_changes: vec![TextDocumentContentChangeEvent {
+                        range: None,
+                        range_length: None,
+                        text: r#"{"Moved 😀":"Changed"}"#.into(),
+                    }],
+                })
+                .await;
+            let found = worker
+                .references(references(project.clone(), caller))
+                .await
+                .unwrap()
+                .unwrap_or_default();
+            assert_eq!(
+                found,
+                vec![location(project.clone(), caller)],
+                "dirty JSON removes the old declaration in the consuming app"
+            );
+            if mode == "reload" {
+                let manifest = root.join("composer.json");
+                let mut composer: serde_json::Value =
+                    serde_json::from_str(PACKAGE_COMPOSER).unwrap();
+                composer["description"] = "disposable resource replay control".into();
+                std::fs::write(&manifest, serde_json::to_string(&composer).unwrap()).unwrap();
+                let event = || DidChangeWatchedFilesParams {
+                    changes: vec![FileEvent {
+                        uri: Url::from_file_path(&manifest).unwrap(),
+                        typ: FileChangeType::CHANGED,
+                    }],
+                };
+                worker.did_change_watched_files(event()).await;
+                let found = worker
+                    .references(references(project.clone(), caller))
+                    .await
+                    .unwrap()
+                    .unwrap_or_default();
+                assert_eq!(
+                    found,
+                    vec![location(project.clone(), caller)],
+                    "project reload must preserve a dirty registered catalog"
+                );
+                worker
+                    .did_change(DidChangeTextDocumentParams {
+                        text_document: VersionedTextDocumentIdentifier {
+                            uri: selected.clone(),
+                            version: 3,
+                        },
+                        content_changes: vec![TextDocumentContentChangeEvent {
+                            range: None,
+                            range_length: None,
+                            text: draft.into(),
+                        }],
+                    })
+                    .await;
+                let params = || ReferenceParams {
+                    text_document_position: TextDocumentPositionParams {
+                        text_document: TextDocumentIdentifier {
+                            uri: project.clone(),
+                        },
+                        position: position_of(caller, "New draft 😀"),
+                    },
+                    context: ReferenceContext {
+                        include_declaration: true,
+                    },
+                    work_done_progress_params: Default::default(),
+                    partial_result_params: Default::default(),
+                };
+                let loc = |uri: Url, text: &str| {
+                    let start = position_of(text, "New draft 😀");
+                    Location::new(
+                        uri,
+                        Range::new(
+                            start,
+                            Position::new(
+                                start.line,
+                                start.character + "New draft 😀".encode_utf16().count() as u32,
+                            ),
+                        ),
+                    )
+                };
+                let wanted = vec![loc(project.clone(), caller), loc(selected.clone(), draft)];
+                assert_eq!(
+                    worker
+                        .references(params())
+                        .await
+                        .unwrap()
+                        .unwrap_or_default(),
+                    wanted,
+                    "next edit after reload must reach every consumer"
+                );
+                std::fs::write(&manifest, PACKAGE_COMPOSER).unwrap();
+                worker.did_change_watched_files(event()).await;
+                assert_eq!(
+                    worker
+                        .references(params())
+                        .await
+                        .unwrap()
+                        .unwrap_or_default(),
+                    wanted,
+                    "restoring project configuration must retain the current overlay"
+                );
+            }
+        } else {
+            for (uri, text) in [(selected, selected_text), (&project, caller)] {
+                let found = worker
+                    .references(references(uri.clone(), text))
+                    .await
+                    .unwrap()
+                    .unwrap_or_default();
+                assert_eq!(
+                    found, expected,
+                    "registered origins and callers must share exact UTF-16 locations"
+                );
+            }
+        }
+        let unrelated = worker
+            .references(references(sibling.clone(), caller))
+            .await
+            .unwrap()
+            .unwrap_or_default();
+        assert_eq!(
+            unrelated,
+            vec![location(sibling.clone(), caller)],
+            "sibling app must not consume this JSON overlay"
+        );
+        worker
+            .did_close(DidCloseTextDocumentParams {
+                text_document: TextDocumentIdentifier {
+                    uri: selected.clone(),
+                },
+            })
+            .await;
+        let found = worker
+            .references(references(project.clone(), caller))
+            .await
+            .unwrap()
+            .unwrap_or_default();
+        assert_eq!(
+            found,
+            if mode == "unsaved" {
+                vec![location(project.clone(), caller)]
+            } else {
+                expected
+            },
+            "discard restores disk or retires a never-saved catalog"
+        );
+        assert!(!new.to_file_path().unwrap().exists());
+        assert_eq!(
+            std::fs::read_to_string(catalog.to_file_path().unwrap()).unwrap(),
+            json
+        );
+    })
+    .await;
+    router.shutdown().await.unwrap();
+    if let Err(error) = outcome {
+        if error.is_panic() {
+            std::panic::resume_unwind(error.into_panic());
+        }
+        panic!("registered JSON test task failed: {error}");
+    }
+}

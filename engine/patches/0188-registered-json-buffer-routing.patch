+#[test]
+fn registered_json_buffers_json_values_do_not_receive_php_diagnostics() {
+    let backend = phpantom_lsp::Backend::new_test();
+    let php = "<?php missingFunction208(); ?>";
+    let json = r#"{"example":"<?php missingFunction208(); ?>"}"#;
+    serde_json::from_str::<serde_json::Value>(json).unwrap();
+    let mut control = Vec::new();
+    backend.update_ast("file:///project/app/Control.php", php);
+    backend.collect_slow_diagnostics("file:///project/app/Control.php", php, &mut control);
+    assert!(control.iter().any(
+        |diagnostic| diagnostic.code == Some(NumberOrString::String("unknown_function".into()))
+    ));
+    let mut diagnostics = Vec::new();
+    // A previously cached PHP classification cannot authorize findings for JSON.
+    backend.update_ast("file:///project/packages/billing/json/en.json", json);
+    backend.collect_slow_diagnostics(
+        "file:///project/packages/billing/json/en.json",
+        json,
+        &mut diagnostics,
+    );
+    assert!(
+        diagnostics.is_empty(),
+        "valid JSON text must not receive PHP findings: {diagnostics:?}"
+    );
+}

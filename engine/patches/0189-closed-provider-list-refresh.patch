+#[tokio::test]
+async fn closed_provider_lists_retire_and_restore_json_registration_after_watched_changes() {
+    let provider = BILLING_PROVIDER.replace(
+        "$this->loadTranslationsFrom(__DIR__.'/../lang', 'billing');",
+        "$this->loadJsonTranslationsFrom(__DIR__.'/../json');",
+    );
+    for (relative, registered, empty) in [
+        (
+            "bootstrap/providers.php",
+            PACKAGE_PROVIDER_LIST,
+            "<?php return [];",
+        ),
+        (
+            "config/app.php",
+            "<?php return ['providers' => [Acme\\Billing\\BillingServiceProvider::class]];",
+            "<?php return ['providers' => []];",
+        ),
+    ] {
+        let (backend, dir, uri, _) = workspace(
+            PACKAGE_COMPOSER,
+            &[
+                (relative, registered),
+                ("packages/billing/src/BillingServiceProvider.php", &provider),
+            ],
+            "",
+        )
+        .await;
+        let path = dir.path().join(relative);
+        let list = Url::from_file_path(&path).unwrap();
+        let target = Url::from_file_path(dir.path().join("packages/billing/json/en.json")).unwrap();
+        assert!(
+            query_json_resource(&backend, &uri, &target)
+                .await
+                .unwrap()
+                .root_uri
+                .is_some()
+        );
+        for (text, typ, expected) in [
+            (Some(empty), FileChangeType::CHANGED, false),
+            (Some(registered), FileChangeType::CHANGED, true),
+            (None, FileChangeType::DELETED, false),
+            (Some(registered), FileChangeType::CREATED, true),
+        ] {
+            if let Some(text) = text {
+                std::fs::write(&path, text).unwrap();
+            } else {
+                std::fs::remove_file(&path).unwrap();
+            }
+            backend
+                .did_change_watched_files(DidChangeWatchedFilesParams {
+                    changes: vec![FileEvent {
+                        uri: list.clone(),
+                        typ,
+                    }],
+                })
+                .await;
+            assert_eq!(
+                query_json_resource(&backend, &uri, &target)
+                    .await
+                    .unwrap()
+                    .root_uri
+                    .is_some(),
+                expected,
+                "{relative}: {typ:?}"
+            );
+        }
+        crate::common::open_php(&backend, &list, registered).await;
+        std::fs::write(&path, empty).unwrap();
+        backend
+            .did_change_watched_files(DidChangeWatchedFilesParams {
+                changes: vec![FileEvent {
+                    uri: list.clone(),
+                    typ: FileChangeType::CHANGED,
+                }],
+            })
+            .await;
+        assert!(
+            query_json_resource(&backend, &uri, &target)
+                .await
+                .unwrap()
+                .root_uri
+                .is_some(),
+            "open editor owns {relative}"
+        );
+        backend
+            .did_close(DidCloseTextDocumentParams {
+                text_document: TextDocumentIdentifier { uri: list },
+            })
+            .await;
+        assert!(
+            query_json_resource(&backend, &uri, &target)
+                .await
+                .unwrap()
+                .root_uri
+                .is_none()
+        );
+        assert!(!target.to_file_path().unwrap().exists());
+    }
+}

+fn bounded_provider_name(name: &str) -> bool {
+    !name.is_empty()
+        && name.len() <= 4096
+        && name.split('\\').all(|part| {
+            !part.is_empty()
+                && !part.as_bytes()[0].is_ascii_digit()
+                && part
+                    .bytes()
+                    .all(|byte| byte >= 0x80 || byte.is_ascii_alphanumeric() || byte == b'_')
+        })
+}
 

+use phpantom_lsp::{ProjectRouter, workbench_translation_resources::TranslationResourceQuery};
+use sha2::{Digest, Sha256};
+use tower_lsp::{LanguageServer, lsp_types::*};
+
+const PROVIDER: &str = "<?php namespace Shared; class Provider {public function boot(): void {$this->loadJsonTranslationsFrom(__DIR__.'/../json');}}";
+
+#[tokio::test]
+async fn provider_sources_identify_external_registered_code_without_sending_contents() {
+    let temp = tempfile::tempdir().unwrap();
+    let root = temp.path().canonicalize().unwrap();
+    let app = root.join("app");
+    let provider = root.join("shared/src/Provider.php");
+    for (path, text) in [
+        (
+            app.join("composer.json"),
+            r#"{"require":{"laravel/framework":"^13.0"},"autoload":{"psr-4":{"Shared\\":"../shared/src/"}}}"#,
+        ),
+        (
+            app.join("bootstrap/providers.php"),
+            "<?php return [Shared\\Provider::class, Missing\\Provider::class];",
+        ),
+        (provider.clone(), PROVIDER),
+    ] {
+        std::fs::create_dir_all(path.parent().unwrap()).unwrap();
+        std::fs::write(path, text).unwrap();
+    }
+    let router = ProjectRouter::new_test();
+    let init = router
+        .initialize(InitializeParams {
+            root_uri: Some(Url::from_directory_path(&app).unwrap()),
+            workspace_folders: Some(vec![WorkspaceFolder {
+                uri: Url::from_directory_path(&app).unwrap(),
+                name: "consumer".into(),
+            }]),
+            ..Default::default()
+        })
+        .await
+        .unwrap();
+    router.initialized(InitializedParams {}).await;
+    let project = Url::from_file_path(app.join("composer.json")).unwrap();
+    let resource = Url::from_file_path(root.join("shared/json/fr.json")).unwrap();
+    let reply = router
+        .workbench_json_translation_resource(TranslationResourceQuery {
+            project_uri: project.clone(),
+            resource_uri: resource.clone(),
+        })
+        .await
+        .unwrap();
+    assert!(reply.root_uri.is_some());
+    let value = serde_json::to_value(&reply).unwrap();
+    let sources = value["providerSources"]["providers"]
+        .as_array()
+        .expect("provider-source metadata is required");
+    assert_eq!(sources.len(), 1);
+    assert_eq!(sources[0]["className"], "Shared\\Provider");
+    assert_eq!(
+        sources[0]["uri"],
+        Url::from_file_path(&provider).unwrap().as_str()
+    );
+    assert_eq!(
+        sources[0]["sha256"],
+        format!("{:x}", Sha256::digest(PROVIDER.as_bytes()))
+    );
+    assert!(sources[0].get("text").is_none());
+    assert_eq!(
+        value["providerSources"]["unresolved"],
+        serde_json::json!(["Missing\\Provider"])
+    );
+    assert_eq!(value["providerSources"]["limited"], false);
+    assert_eq!(
+        init.capabilities.experimental.unwrap()["phpWorkbenchProviderSources"],
+        true
+    );
+    let dirty = PROVIDER.replace("../json", "../alternate");
+    router
+        .did_open(DidOpenTextDocumentParams {
+            text_document: TextDocumentItem {
+                uri: Url::from_file_path(&provider).unwrap(),
+                language_id: "php".into(),
+                version: 1,
+                text: dirty.clone(),
+            },
+        })
+        .await;
+    let negative = router
+        .workbench_json_translation_resource(TranslationResourceQuery {
+            project_uri: project.clone(),
+            resource_uri: resource.clone(),
+        })
+        .await
+        .unwrap();
+    assert!(negative.root_uri.is_none());
+    let negative = serde_json::to_value(negative).unwrap();
+    assert_eq!(
+        negative["providerSources"]["providers"][0]["sha256"],
+        format!("{:x}", Sha256::digest(dirty.as_bytes()))
+    );
+    assert_eq!(std::fs::read_to_string(&provider).unwrap(), PROVIDER);
+    assert!(!resource.to_file_path().unwrap().exists());
+    router.shutdown().await.unwrap();
+}
+
+#[tokio::test]
+async fn provider_sources_bound_known_names_and_report_truncation_for_negative_resources() {
+    let temp = tempfile::tempdir().unwrap();
+    let app = temp.path().canonicalize().unwrap();
+    std::fs::create_dir(app.join("bootstrap")).unwrap();
+    std::fs::write(
+        app.join("composer.json"),
+        r#"{"require":{"laravel/framework":"^13.0"}}"#,
+    )
+    .unwrap();
+    let names = (0..513)
+        .map(|i| format!("Missing\\Provider{i}::class"))
+        .collect::<Vec<_>>()
+        .join(",");
+    std::fs::write(
+        app.join("bootstrap/providers.php"),
+        format!("<?php return [{names}];"),
+    )
+    .unwrap();
+    let router = ProjectRouter::new_test();
+    router
+        .initialize(InitializeParams {
+            root_uri: Some(Url::from_directory_path(&app).unwrap()),
+            ..Default::default()
+        })
+        .await
+        .unwrap();
+    router.initialized(InitializedParams {}).await;
+    let reply = router
+        .workbench_json_translation_resource(TranslationResourceQuery {
+            project_uri: Url::from_file_path(app.join("composer.json")).unwrap(),
+            resource_uri: Url::from_file_path(app.join("absent/fr.json")).unwrap(),
+        })
+        .await
+        .unwrap();
+    assert!(reply.root_uri.is_none());
+    assert!(reply.provider_sources.providers.is_empty());
+    assert_eq!(reply.provider_sources.unresolved.len(), 512);
+    assert!(reply.provider_sources.limited);
+    router.shutdown().await.unwrap();
+}
+
+#[tokio::test]
+async fn provider_sources_bound_unique_source_hashing_without_requiring_json_registrations() {
+    let temp = tempfile::tempdir().unwrap();
+    let app = temp.path().canonicalize().unwrap();
+    std::fs::create_dir(app.join("bootstrap")).unwrap();
+    std::fs::create_dir(app.join("src")).unwrap();
+    std::fs::write(
+        app.join("composer.json"),
+        r#"{"require":{"laravel/framework":"^13.0"},"autoload":{"psr-4":{"App\\":"src/"}}}"#,
+    )
+    .unwrap();
+    let mut names = Vec::new();
+    for i in 0..9 {
+        let mut text = format!("<?php namespace App; class Provider{i} {{}} /*");
+        text.extend(std::iter::repeat_n('x', 1_048_576 - text.len() - 2));
+        text.push_str("*/");
+        std::fs::write(app.join(format!("src/Provider{i}.php")), text).unwrap();
+        names.push(format!("App\\Provider{i}::class"));
+    }
+    std::fs::write(
+        app.join("bootstrap/providers.php"),
+        format!("<?php return [{}];", names.join(",")),
+    )
+    .unwrap();
+    let router = ProjectRouter::new_test();
+    router
+        .initialize(InitializeParams {
+            root_uri: Some(Url::from_directory_path(&app).unwrap()),
+            ..Default::default()
+        })
+        .await
+        .unwrap();
+    router.initialized(InitializedParams {}).await;
+    let reply = router
+        .workbench_json_translation_resource(TranslationResourceQuery {
+            project_uri: Url::from_file_path(app.join("composer.json")).unwrap(),
+            resource_uri: Url::from_file_path(app.join("absent/fr.json")).unwrap(),
+        })
+        .await
+        .unwrap();
+    assert!(reply.root_uri.is_none());
+    assert_eq!(reply.provider_sources.providers.len(), 8);
+    assert_eq!(reply.provider_sources.unresolved.len(), 1);
+    assert!(reply.provider_sources.limited);
+    router.shutdown().await.unwrap();
+}

 impl Backend {
+    fn known_provider_sources(&self) -> ProviderSources {
+        let mut result = ProviderSources::default();
+        if !self.resolved_class_cache.read().is_laravel() {
+            return result;
+        }
+        let providers = self.laravel_providers();
+        let mut seen = std::collections::HashSet::new();
+        let mut hashes = std::collections::HashMap::<Url, String>::new();
+        let mut bytes = 0usize;
+        for (index, fqn) in providers.fqns().enumerate() {
+            if index >= MAX_PROVIDERS {
+                result.limited = true;
+                break;
+            }
+            if !seen.insert(fqn.to_ascii_lowercase()) {
+                continue;
+            }
+            if !bounded_provider_name(fqn) {
+                result.limited = true;
+                continue;
+            }
+            let resolved = (|| {
+                let original = self.resolve_class_uri(fqn)?;
+                let path = Url::parse(&original)
+                    .ok()?
+                    .to_file_path()
+                    .ok()?
+                    .canonicalize()
+                    .ok()?;
+                let metadata = std::fs::metadata(&path).ok()?;
+                if !metadata.is_file() || metadata.len() > MAX_PROVIDER_BYTES {
+                    return None;
+                }
+                let uri = Url::from_file_path(path).ok()?;
+                if uri.as_str().len() > 16_384 {
+                    return None;
+                }
+                let sha256 = if let Some(hash) = hashes.get(&uri) {
+                    hash.clone()
+                } else {
+                    let content = self.get_file_content(&original)?;
+                    if content.len() as u64 > MAX_PROVIDER_BYTES
+                        || bytes.saturating_add(content.len()) > MAX_PROVIDER_TOTAL_BYTES
+                    {
+                        result.limited = true;
+                        return None;
+                    }
+                    bytes += content.len();
+                    let hash = format!("{:x}", Sha256::digest(content.as_bytes()));
+                    hashes.insert(uri.clone(), hash.clone());
+                    hash
+                };
+                Some(ProviderSource {
+                    class_name: fqn.to_owned(),
+                    uri,
+                    sha256,
+                })
+            })();
+            if let Some(source) = resolved {
+                result.providers.push(source);
+            } else {
+                result.unresolved.push(fqn.to_owned());
+            }
+        }
+        result
+    }

+#[tokio::test]
+async fn provider_reopen_withdrawal_does_not_restore_cached_disk_translations() {
+    let temp = tempfile::tempdir().unwrap();
+    let root = temp.path().canonicalize().unwrap();
+    let app = root.join("app");
+    let source = root.join("shared/src/Provider.php");
+    let caller = app.join("Caller.php");
+    let caller_text = "<?php __('Greeting');";
+    for (path, text) in [
+        (
+            app.join("composer.json"),
+            r#"{"require":{"laravel/framework":"^13.0"},"autoload":{"psr-4":{"Shared\\":"../shared/src/"}}}"#,
+        ),
+        (
+            app.join("bootstrap/providers.php"),
+            "<?php return [Shared\\Provider::class];",
+        ),
+        (
+            root.join("shared/composer.json"),
+            r#"{"name":"fixture/shared","autoload":{"psr-4":{"Shared\\":"src/"}}}"#,
+        ),
+        (source.clone(), PROVIDER),
+        (
+            root.join("shared/json/en.json"),
+            r#"{"Greeting":"Disk original"}"#,
+        ),
+        (
+            root.join("shared/alternate/en.json"),
+            r#"{"Greeting":"Disk alternate"}"#,
+        ),
+        (caller.clone(), caller_text),
+    ] {
+        std::fs::create_dir_all(path.parent().unwrap()).unwrap();
+        std::fs::write(path, text).unwrap();
+    }
+    let router = ProjectRouter::new_test_with_full_stubs();
+    router
+        .initialize(InitializeParams {
+            root_uri: Some(Url::from_directory_path(&app).unwrap()),
+            ..Default::default()
+        })
+        .await
+        .unwrap();
+    router.initialized(InitializedParams {}).await;
+    router
+        .did_open(DidOpenTextDocumentParams {
+            text_document: TextDocumentItem {
+                uri: Url::from_file_path(&caller).unwrap(),
+                language_id: "php".into(),
+                version: 1,
+                text: caller_text.into(),
+            },
+        })
+        .await;
+    let query = TranslationResourceQuery {
+        project_uri: Url::from_file_path(app.join("composer.json")).unwrap(),
+        resource_uri: Url::from_file_path(root.join("shared/json/en.json")).unwrap(),
+    };
+    assert!(
+        router
+            .workbench_json_translation_resource(query.clone())
+            .await
+            .unwrap()
+            .root_uri
+            .is_some()
+    );
+    let hover = || HoverParams {
+        text_document_position_params: TextDocumentPositionParams {
+            text_document: TextDocumentIdentifier {
+                uri: Url::from_file_path(&caller).unwrap(),
+            },
+            position: Position::new(0, 12),
+        },
+        work_done_progress_params: Default::default(),
+    };
+    let initial = format!("{:?}", router.hover(hover()).await.unwrap());
+    assert!(
+        initial.contains("Disk original"),
+        "fixture must recognize the translation helper: {initial}"
+    );
+    router
+        .did_open(DidOpenTextDocumentParams {
+            text_document: TextDocumentItem {
+                uri: Url::from_file_path(&source).unwrap(),
+                language_id: "php".into(),
+                version: 1,
+                text: PROVIDER.replace("../json", "../alternate"),
+            },
+        })
+        .await;
+    assert!(
+        router
+            .workbench_json_translation_resource(query.clone())
+            .await
+            .unwrap()
+            .root_uri
+            .is_none()
+    );
+    assert!(format!("{:?}", router.hover(hover()).await.unwrap()).contains("Disk alternate"));
+    router
+        .did_close(DidCloseTextDocumentParams {
+            text_document: TextDocumentIdentifier {
+                uri: Url::from_file_path(&source).unwrap(),
+            },
+        })
+        .await;
+    assert!(
+        router
+            .workbench_json_translation_resource(query.clone())
+            .await
+            .unwrap()
+            .root_uri
+            .is_some()
+    );
+    assert!(format!("{:?}", router.hover(hover()).await.unwrap()).contains("Disk original"));
+    router
+        .did_open(DidOpenTextDocumentParams {
+            text_document: TextDocumentItem {
+                uri: Url::from_file_path(&source).unwrap(),
+                language_id: "php".into(),
+                version: 2,
+                text: "<?php namespace Shared; class Other {}".into(),
+            },
+        })
+        .await;
+    let receipt = router
+        .workbench_json_translation_resource(query.clone())
+        .await
+        .unwrap();
+    assert!(
+        receipt.root_uri.is_none(),
+        "removed provider class must withdraw its catalog root: {receipt:?}"
+    );
+    let result = format!("{:?}", router.hover(hover()).await.unwrap());
+    assert!(
+        !result.contains("Disk original") && !result.contains("Disk alternate"),
+        "removed provider must not resurrect cached disk values: {result}"
+    );
+    router
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: Url::from_file_path(&source).unwrap(),
+                version: 3,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: PROVIDER.replace("class Provider", "class Other"),
+            }],
+        })
+        .await;
+    assert!(
+        router
+            .workbench_json_translation_resource(query.clone())
+            .await
+            .unwrap()
+            .root_uri
+            .is_none(),
+        "another class's boot method cannot register resources for the removed provider"
+    );
+    router
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: Url::from_file_path(&source).unwrap(),
+                version: 4,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: PROVIDER.into(),
+            }],
+        })
+        .await;
+    assert!(
+        router
+            .workbench_json_translation_resource(query.clone())
+            .await
+            .unwrap()
+            .root_uri
+            .is_some()
+    );
+    assert!(format!("{:?}", router.hover(hover()).await.unwrap()).contains("Disk original"));
+    router.shutdown().await.unwrap();
+}

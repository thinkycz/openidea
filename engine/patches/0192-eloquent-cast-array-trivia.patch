+#[tokio::test]
+async fn cast_array_trivia_preserves_property_and_method_sources() {
+    for (open, close) in [("[", "]"), ("array(", ")")] {
+        let php = format!(
+            r#"<?php
+class Bakery extends \Illuminate\Database\Eloquent\Model {{
+    protected $casts = {open}
+        /* 😀 'fake' => 'object', [ {{ */ 'legacy' /* key */ => /* value */ 'boolean',
+        'shared' => 'float' /* end, 'fake2' => 'object' */,
+        // 'fake3' => 'object',
+        'quality=>name' => 'string',
+    {close};
+    protected function casts(): array {{
+        return {open}
+            # 'fake4' => 'object',
+            /* 😀 field */ 'quality' => /* typed */ 'bool' /* trailing */,
+            'shared' /* key */ => 'integer',
+        {close};
+    }}
+}}
+"#
+        );
+        let backend = create_test_backend();
+        let classes = backend.parse_php(&php);
+        assert_eq!(classes.len(), 1);
+        let metadata = classes[0].laravel().unwrap();
+        assert_eq!(
+            metadata.casts_definitions,
+            vec![
+                ("legacy".to_owned(), "boolean".to_owned()),
+                ("shared".to_owned(), "integer".to_owned()),
+                ("quality=>name".to_owned(), "string".to_owned()),
+                ("quality".to_owned(), "bool".to_owned()),
+            ],
+            "comments are trivia and method casts override properties for {open}"
+        );
+        let sources = metadata.cast_sources.as_ref().unwrap();
+        assert_eq!(sources.property.len(), 3);
+        assert_eq!(sources.method.len(), 2);
+    }
+}

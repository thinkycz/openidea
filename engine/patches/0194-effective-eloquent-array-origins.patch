+fn eloquent_member_entry(
+    members: &[ClassLikeMember<'_>],
+    content: &str,
+    name: &str,
+) -> Option<usize> {
+    let mut property_cast = None;
+    let mut method_cast = None;
+    let mut fallback = None;
+    for member in members {
+        match member {
+            ClassLikeMember::Property(Property::Plain(property)) => {
+                for item in property.items.iter() {
+                    let PropertyItem::Concrete(item) = item else {
+                        continue;
+                    };
+                    let variable = item.variable.name;
+                    if variable == b"$casts" {
+                        property_cast = literal_array_entry(item.value, content, name, true);
+                    } else if [
+                        b"$dates".as_slice(),
+                        b"$attributes",
+                        b"$fillable",
+                        b"$guarded",
+                        b"$hidden",
+                        b"$visible",
+                        b"$appends",
+                    ]
+                    .contains(&variable)
+                    {
+                        fallback = fallback.or_else(|| {
+                            literal_array_entry(
+                                item.value,
+                                content,
+                                name,
+                                variable == b"$attributes",
+                            )
                         });
                     }
-                    if let Some(col) = line.find(&double_pattern) {
-                        return Some(Position {
-                            line: line_idx as u32,
-                            character: line[..col + 1].encode_utf16().count() as u32,
-                        });
-                    }
-
-                    // A line ending with `];` or just `];` closes the array.
-                    if trimmed == "];" || trimmed.ends_with("];") {
-                        in_target_property = false;
-                    }
                 }
             }
-            byte_offset += line_len;
-        }
-        None
-    }
+            ClassLikeMember::Method(method) if method.name.value.eq_ignore_ascii_case(b"casts") => {
+                if let MethodBody::Concrete(body) = &method.body {
+                    method_cast = body
+                        .statements
+                        .iter()
+                        .find_map(|statement| match statement {
+                            Statement::Return(return_) => return_.value,
+                            _ => None,
+                        })
+                        .and_then(|value| literal_array_entry(value, content, name, true));
+                }
+            }
+            _ => {}
+        }
+    }
+    // Laravel merges casts() over $casts regardless of declaration order.
+    method_cast.or(property_cast).or(fallback)
 }
+
+fn literal_array_entry(
+    expr: &Expression<'_>,
+    content: &str,
+    name: &str,
+    keyed: bool,
+) -> Option<usize> {
+    let elements = crate::parser::array_literal_elements(crate::parser::unwrap_parens(expr))?;
+    let mut found = None;
+    for element in elements.iter() {
+        if matches!(
+            element,
+            ArrayElement::Variadic(_) | ArrayElement::Missing(_)
+        ) {
+            continue;
+        }
+        let literal = if keyed {
+            crate::parser::array_element_key(element)
+        } else {
+            crate::parser::array_element_value(element)
+        };
+        let Some((key, start, _)) = literal.and_then(|value| {
+            crate::virtual_members::laravel::helpers::resolved_string_literal(
+                crate::parser::unwrap_parens(value),
+                content,
+            )
+        }) else {
+            continue;
+        };
+        if key == name && (keyed || found.is_none()) {
+            found = Some(start);
+        }
+    }
+    found
+}

+#[tokio::test]
+async fn effective_eloquent_literal_cast_duplicates_keep_last_runtime_value() {
+    for (open, close) in [("[", "]"), ("array(", ")")] {
+        for declaration in [
+            format!("protected $casts = {open}'quality' => 'float', 'quality' => 'bool'{close};"),
+            format!(
+                "protected function casts(): array {{ return {open}'quality' => 'float', 'quality' => 'bool'{close}; }}"
+            ),
+        ] {
+            let php = format!(
+                "<?php class Bakery extends \\Illuminate\\Database\\Eloquent\\Model {{ {declaration} }}"
+            );
+            let backend = create_test_backend();
+            let classes = backend.parse_php(&php);
+            assert_eq!(
+                classes[0].laravel().unwrap().casts_definitions,
+                vec![("quality".to_owned(), "bool".to_owned())]
+            );
+        }
+    }
+}

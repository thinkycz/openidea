+fn eloquent_node_entry(
+    node: Node<'_, '_>,
+    content: &str,
+    name: &str,
+    class_range: Option<(usize, usize)>,
+) -> Option<usize> {
+    let bounds = match node {
+        Node::Class(c) => Some((
+            c.left_brace.start.offset as usize,
+            c.right_brace.end.offset as usize,
+        )),
+        Node::AnonymousClass(c) => Some((
+            c.left_brace.start.offset as usize,
+            c.right_brace.end.offset as usize,
+        )),
+        Node::Trait(c) => Some((
+            c.left_brace.start.offset as usize,
+            c.right_brace.end.offset as usize,
+        )),
+        Node::Enum(c) => Some((
+            c.left_brace.start.offset as usize,
+            c.right_brace.end.offset as usize,
+        )),
+        _ => None,
+    };
+    if let Some(bounds) = bounds {
+        if class_range.is_none_or(|range| range == bounds) {
+            return eloquent_member_entry(crate::parser::class_like_members(node)?, content, name);
+        }
+        if class_range.is_some_and(|range| range.0 < bounds.0 || range.1 > bounds.1) {
+            return None;
+        }
+    }
+    let mut found = None;
+    node.visit_children(|child| {
+        if found.is_none() {
+            found = eloquent_node_entry(child, content, name, class_range);
+        }
+    });
+    found
+}

+#[tokio::test]
+async fn effective_eloquent_cast_origins_follow_literals_precedence_and_byte_bounds() {
+    let cases = [
+        (
+            "comment",
+            "protected function casts(): array { return [/* 😀 'quality' => 'float' */ /* effective */ 'quality' => 'bool']; }",
+        ),
+        (
+            "method last",
+            "protected $casts = ['quality' => 'float']; protected function casts(): array { return [/* effective */ 'quality' => 'bool']; }",
+        ),
+        (
+            "method first",
+            "protected function casts(): array { return [/* effective */ 'quality' => 'bool']; } protected $casts = ['quality' => 'float'];",
+        ),
+        (
+            "method duplicate",
+            "protected function casts(): array { return ['quality' => 'float', /* effective */ 'quality' => 'bool']; }",
+        ),
+        (
+            "property duplicate",
+            "protected $casts = ['quality' => 'float', /* effective */ 'quality' => 'bool'];",
+        ),
+        (
+            "legacy",
+            "protected function casts(): array { return array(/* effective */ 'quality' => 'bool'); }",
+        ),
+        (
+            "decoded",
+            "protected function casts(): array { return [/* effective */ \"qual\\x69ty\" => \"bool\"]; }",
+        ),
+        (
+            "CRLF",
+            "protected function casts(): array { return [/* effective */ 'quality' => 'bool']; }",
+        ),
+    ];
+    for (label, body) in cases {
+        let preamble = if label == "CRLF" {
+            "// preamble\n".repeat(100)
+        } else {
+            String::new()
+        };
+        let php = format!(
+            "<?php\n{preamble}namespace App\\Models;\nclass Decoy extends \\Illuminate\\Database\\Eloquent\\Model {{ protected $casts = ['quality' => 'float']; }}\nclass User extends \\Illuminate\\Database\\Eloquent\\Model {{\n    {body}\n}}\nclass Other extends \\Illuminate\\Database\\Eloquent\\Model {{ protected $casts = ['quality' => 'string']; }}\n"
+        );
+        let php = if label == "CRLF" {
+            php.replace('\n', "\r\n")
+        } else {
+            php
+        };
+        let caller = "<?php\n$user = new \\App\\Models\\User();\n$user->quality;\n";
+        let (backend, dir) =
+            make_workspace(&[("src/Models/User.php", &php), ("src/Probe.php", caller)]);
+        let response = open_and_goto_definition(&backend, &dir, "src/Probe.php", caller, 2, 8)
+            .await
+            .expect(label);
+        let location = match response {
+            GotoDefinitionResponse::Scalar(location) => location,
+            GotoDefinitionResponse::Array(mut locations) => {
+                assert_eq!(locations.len(), 1, "{label}");
+                locations.pop().unwrap()
+            }
+            other => panic!("{label}: unexpected {other:?}"),
+        };
+        let marker = "/* effective */ ";
+        let prefix = &php[..php.find(marker).unwrap() + marker.len() + 1];
+        let point = Position::new(
+            prefix.bytes().filter(|b| *b == b'\n').count() as u32,
+            prefix.rsplit('\n').next().unwrap().encode_utf16().count() as u32,
+        );
+        assert_eq!(
+            location.uri,
+            Url::from_file_path(dir.path().join("src/Models/User.php")).unwrap(),
+            "{label}"
+        );
+        assert_eq!(location.range, Range::new(point, point), "{label}");
+        let uri = Url::from_file_path(dir.path().join("src/Probe.php")).unwrap();
+        let hover = crate::common::hover_at(&backend, uri.as_str(), caller, 2, 8).expect(label);
+        assert!(
+            crate::common::hover_text(&hover).contains("**var** `bool`"),
+            "{label}: {hover:?}"
+        );
+    }
+    let php = "<?php namespace App\\Models; class User extends \\Illuminate\\Database\\Eloquent\\Model { protected $casts = [/* 'quality' => 'bool' */ 'other' => 'bool']; }";
+    let caller = "<?php (new \\App\\Models\\User())->quality;";
+    let (backend, dir) = make_workspace(&[("src/Models/User.php", php), ("src/Probe.php", caller)]);
+    assert!(
+        open_and_goto_definition(&backend, &dir, "src/Probe.php", caller, 0, 35)
+            .await
+            .is_none(),
+        "comment-only key is not a declaration"
+    );
+}

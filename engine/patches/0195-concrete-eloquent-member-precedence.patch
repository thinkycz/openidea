+    /// Framework conventions cannot replace a physical member of the requested kind.
+    pub(in crate::definition) fn find_physical_member_declaration(
+        class: &ClassInfo,
+        member_name: &str,
+        access_hint: MemberAccessHint,
+        class_loader: &dyn Fn(&str) -> Option<Arc<ClassInfo>>,
+    ) -> Option<(ClassInfo, String, MemberKind)> {
+        let kind = match access_hint {
+            MemberAccessHint::MethodCall => MemberKind::Method,
+            MemberAccessHint::PropertyAccess => MemberKind::Property,
+            MemberAccessHint::Unknown => return None,
+        };
+        let declares = |candidate: &ClassInfo| match kind {
+            MemberKind::Method => candidate.methods.iter().any(|method| {
+                !method.is_virtual
+                    && method.name_offset > 0
+                    && method.name.eq_ignore_ascii_case(member_name)
+            }),
+            MemberKind::Property => candidate.properties.iter().any(|property| {
+                !property.is_virtual && property.name_offset > 0 && property.name == member_name
+            }),
+            MemberKind::Constant => false,
+        };
+        if declares(class) {
+            return Some((class.clone(), class.fqn().to_string(), kind));
+        }
+        // Trait method precedence never excludes a same-named property.
+        let method_name = (kind == MemberKind::Method).then_some(member_name);
+        crate::inheritance::find_declaring_member_ancestor(
+            class,
+            method_name,
+            class_loader,
+            &declares,
+        )
+        .map(|(fqn, owner)| (Arc::unwrap_or_clone(owner), fqn.to_string(), kind))
+    }

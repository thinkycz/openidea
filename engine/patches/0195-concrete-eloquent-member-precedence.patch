+#[tokio::test]
+async fn concrete_eloquent_members_precede_virtual_conventions_by_access_kind() {
+    let cases = [
+        (
+            "method",
+            "",
+            "public function /* target */ quality(): int { return 7; }",
+            "quality",
+            true,
+        ),
+        (
+            "property",
+            "",
+            "public string /* target */ $quality = 'real';",
+            "quality",
+            false,
+        ),
+        (
+            "both method",
+            "",
+            "public string $quality = 'real'; public function /* target */ quality(): int { return 7; }",
+            "quality",
+            true,
+        ),
+        (
+            "both property CRLF",
+            "",
+            "public string /* target */ $quality = 'real'; public function quality(): int { return 7; }",
+            "quality",
+            false,
+        ),
+        (
+            "timestamp property",
+            "",
+            "public string /* target */ $created_at = 'real';",
+            "created_at",
+            false,
+        ),
+        (
+            "timestamp method",
+            "",
+            "public function /* target */ created_at(): int { return 7; }",
+            "created_at",
+            true,
+        ),
+        (
+            "parent method",
+            "class Base extends \\Illuminate\\Database\\Eloquent\\Model { public function /* target */ quality(): int { return 7; } }",
+            "public string $quality = 'child';",
+            "quality",
+            true,
+        ),
+        (
+            "parent property",
+            "class Base extends \\Illuminate\\Database\\Eloquent\\Model { public string /* target */ $quality = 'parent'; }",
+            "public function quality(): int { return 7; }",
+            "quality",
+            false,
+        ),
+        (
+            "trait method",
+            "trait Value { public function /* target */ quality(): int { return 7; } }",
+            "use Value; public string $quality = 'own';",
+            "quality",
+            true,
+        ),
+        (
+            "trait property",
+            "trait Value { public string /* target */ $quality = 'trait'; }",
+            "use Value; public function quality(): int { return 7; }",
+            "quality",
+            false,
+        ),
+        (
+            "trait precedence",
+            "trait First { public function quality(): int { return 1; } }|trait Value { public function /* target */ quality(): int { return 7; } }",
+            "use First, Value { Value::quality insteadof First; }",
+            "quality",
+            true,
+        ),
+        (
+            "trait property beside excluded method",
+            "trait First { public string /* target */ $quality = 'trait'; public function quality(): int { return 1; } }|trait Value { public function quality(): int { return 7; } }",
+            "use First, Value { Value::quality insteadof First; }",
+            "quality",
+            false,
+        ),
+        (
+            "trait alias",
+            "trait Value { public function /* target */ quality(): int { return 7; } }",
+            "use Value { quality as aliasQuality; }",
+            "aliasQuality",
+            true,
+        ),
+    ];
+    for (label, preamble, body, name, method) in cases {
+        let parent = if label.starts_with("parent ") {
+            "Base"
+        } else {
+            "\\Illuminate\\Database\\Eloquent\\Model"
+        };
+        let php = format!(
+            "<?php\nnamespace App\\Models;\nclass User extends {parent} {{\n    protected $casts = ['quality' => 'bool', 'aliasQuality' => 'bool', 'created_at' => 'datetime'];\n    /* 😀 */ {body}\n}}\n"
+        );
+        let php = if label.ends_with("CRLF") {
+            php.replace('\n', "\r\n")
+        } else {
+            php
+        };
+        let caller = format!(
+            "<?php\n$user = new \\App\\Models\\User();\n/* 😀 */ $user->{name}{};\n",
+            if method { "()" } else { "" }
+        );
+        let mut files = vec![
+            ("src/Models/User.php".to_string(), php.clone()),
+            ("src/Probe.php".to_string(), caller.clone()),
+        ];
+        for declaration in preamble.split('|').filter(|value| !value.is_empty()) {
+            let class_name = declaration.split_whitespace().nth(1).unwrap();
+            files.push((
+                format!("src/Models/{class_name}.php"),
+                format!("<?php\nnamespace App\\Models;\n{declaration}\n"),
+            ));
+        }
+        let borrowed: Vec<_> = files
+            .iter()
+            .map(|(path, source)| (path.as_str(), source.as_str()))
+            .collect();
+        let (backend, dir) = make_workspace(&borrowed);
+        let prefix = &caller[..caller.find("->").unwrap() + 2];
+        let col = prefix.rsplit('\n').next().unwrap().encode_utf16().count() as u32;
+        let response = open_and_goto_definition(&backend, &dir, "src/Probe.php", &caller, 2, col)
+            .await
+            .expect(label);
+        let location = match response {
+            GotoDefinitionResponse::Scalar(location) => location,
+            GotoDefinitionResponse::Array(mut locations) => {
+                assert_eq!(locations.len(), 1, "{label}");
+                locations.pop().unwrap()
+            }
+            other => panic!("{label}: {other:?}"),
+        };
+        let marker = "/* target */ ";
+        let (target_path, target_source) = files
+            .iter()
+            .find(|(_, source)| source.contains(marker))
+            .unwrap();
+        let prefix = &target_source
+            [..target_source.find(marker).unwrap() + marker.len() + usize::from(!method)];
+        let point = Position::new(
+            prefix.bytes().filter(|b| *b == b'\n').count() as u32,
+            prefix.rsplit('\n').next().unwrap().encode_utf16().count() as u32,
+        );
+        assert_eq!(
+            location.uri,
+            Url::from_file_path(dir.path().join(target_path)).unwrap(),
+            "{label}"
+        );
+        assert_eq!(location.range, Range::new(point, point), "{label}");
+    }
+}

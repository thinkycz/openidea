+#[tokio::test]
+async fn concrete_eloquent_member_lookup_keeps_virtual_properties_but_not_fake_calls() {
+    let php = "<?php namespace App\\Models; class User extends \\Illuminate\\Database\\Eloquent\\Model { protected $casts = ['quality' => 'bool']; }";
+    for name in ["quality", "created_at"] {
+        let caller = format!("<?php\n$user = new \\App\\Models\\User();\n$user->{name}();\n");
+        let (backend, dir) =
+            make_workspace(&[("src/Models/User.php", php), ("src/Probe.php", &caller)]);
+        assert!(
+            open_and_goto_definition(&backend, &dir, "src/Probe.php", &caller, 2, 7)
+                .await
+                .is_none(),
+            "{name}() must not navigate to a virtual property"
+        );
+    }
+    for (name, method) in [("quality", false), ("whereQuality", true)] {
+        let caller = format!(
+            "<?php\n$user = new \\App\\Models\\User();\n$user->{name}{};\n",
+            if method { "()" } else { "" }
+        );
+        let (backend, dir) =
+            make_workspace(&[("src/Models/User.php", php), ("src/Probe.php", &caller)]);
+        let response = open_and_goto_definition(&backend, &dir, "src/Probe.php", &caller, 2, 7)
+            .await
+            .expect("virtual field and derived query method stay navigable");
+        assert_eq!(
+            definition_uri(&response),
+            &Url::from_file_path(dir.path().join("src/Models/User.php")).unwrap()
+        );
+        let col = php.find("'quality'").unwrap() as u32 + 1;
+        assert_eq!(definition_line(&response), 0);
+        match response {
+            GotoDefinitionResponse::Scalar(location) => assert_eq!(
+                location.range,
+                Range::new(Position::new(0, col), Position::new(0, col))
+            ),
+            GotoDefinitionResponse::Array(locations) => {
+                assert_eq!(locations.len(), 1);
+                assert_eq!(
+                    locations[0].range,
+                    Range::new(Position::new(0, col), Position::new(0, col))
+                );
+            }
+            other => panic!("unexpected {other:?}"),
+        }
+    }
+}

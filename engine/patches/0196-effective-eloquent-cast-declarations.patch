+#[tokio::test]
+async fn virtual_eloquent_casts_preserve_accessor_and_mutator_declaration_priority() {
+    for (property, name, signature, body) in [
+        (
+            "quality",
+            "getQualityAttribute",
+            "getQualityAttribute(): string",
+            "return 'real';",
+        ),
+        (
+            "quality",
+            "setQualityAttribute",
+            "setQualityAttribute($value): void",
+            "$this->attributes['quality'] = $value;",
+        ),
+        (
+            "qualityLabel",
+            "getQualityLabelAttribute",
+            "getQualityLabelAttribute(): string",
+            "return 'real';",
+        ),
+        (
+            "qualityLabel",
+            "setQualityLabelAttribute",
+            "setQualityLabelAttribute($value): void",
+            "$this->attributes['qualityLabel'] = $value;",
+        ),
+    ] {
+        let model = format!(
+            "<?php namespace App\\Models; class Bakery extends \\Illuminate\\Database\\Eloquent\\Model {{ protected $casts = ['{property}' => 'bool']; public function {signature} {{ {body} }} }}"
+        );
+        let caller = format!(
+            "<?php\n$bakery = new \\App\\Models\\Bakery();\n/* 😀 read */ $bakery->{property};\n/* 😀 write */ $bakery->{property} = '1';\n"
+        );
+        let (backend, dir) = make_workspace(&[
+            ("src/Models/Bakery.php", model.as_str()),
+            ("src/Probe.php", caller.as_str()),
+        ]);
+        for line in [2, 3] {
+            let text = caller.lines().nth(line as usize).unwrap();
+            let column = text[..text.find(property).unwrap()].encode_utf16().count() as u32;
+            let response =
+                open_and_goto_definition(&backend, &dir, "src/Probe.php", &caller, line, column)
+                    .await
+                    .unwrap();
+            let location = match response {
+                GotoDefinitionResponse::Scalar(location) => location,
+                GotoDefinitionResponse::Array(mut locations) => {
+                    assert_eq!(locations.len(), 1);
+                    locations.pop().unwrap()
+                }
+                other => panic!("{other:?}"),
+            };
+            let column = model[..model.find(name).unwrap()].encode_utf16().count() as u32;
+            assert_eq!(
+                location.uri,
+                Url::from_file_path(dir.path().join("src/Models/Bakery.php")).unwrap()
+            );
+            assert_eq!(
+                location.range,
+                Range::new(Position::new(0, column), Position::new(0, column)),
+                "{name} line={line}"
+            );
+        }
+    }

+    fn eloquent_cast_declaration_location(
+        &self,
+        class: &ClassInfo,
+        uri: &str,
+        content: &str,
+        name: &str,
+        loader: &dyn Fn(&str) -> Option<Arc<ClassInfo>>,
+    ) -> Option<Location> {
+        if !extends_eloquent_model(class, loader) {
+            return None;
+        }
+        let resolved = crate::virtual_members::resolve_class_fully_cached(
+            class,
+            loader,
+            &self.resolved_class_cache,
+        );
+        if !matches!(
+            resolved.get_property(name)?.source,
+            Some(PropertySource::Cast { mutator: None, .. })
+        ) || !resolved
+            .laravel()?
+            .casts_definitions
+            .iter()
+            .any(|(key, _)| key == name)
+        {
+            return None;
+        }
+        if accessor_method_candidates(name).iter().any(|candidate| {
+            Self::find_declaring_class(class, candidate, loader)
+                .is_some_and(|(owner, _)| is_accessor_or_mutator_method(&owner, candidate))
+        }) {
+            return None;
+        }
+        // casts() overlays $casts, whose declaration is inherited independently.
+        for hint in [
+            MemberAccessHint::MethodCall,
+            MemberAccessHint::PropertyAccess,
+        ] {
+            let Some((owner, fqn, kind)) =
+                Self::find_physical_member_declaration(class, "casts", hint, loader)
+            else {
+                continue;
+            };
+            let Some((target, source)) = self.find_class_file_content(&fqn, uri, content) else {
+                continue;
+            };
+            let Some(position) = Self::find_eloquent_cast_entry(
+                &source,
+                name,
+                (owner.start_offset as usize, owner.end_offset as usize),
+                kind,
+            ) else {
+                continue;
+            };
+            return Some(point_location(
+                crate::util::declaration_uri(&target)?,
+                position,
+            ));
+        }
+        None
+    }

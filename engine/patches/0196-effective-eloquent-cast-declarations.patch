+#[tokio::test]
+async fn virtual_eloquent_casts_keep_effective_owners_beside_trait_methods() {
+    #[derive(serde::Deserialize)]
+    struct Case {
+        name: String,
+        model: String,
+        base: String,
+        target: String,
+        value: Option<String>,
+    }
+    let cases: Vec<Case> =
+        serde_json::from_str(include_str!("fixtures/eloquent_virtual_casts.json")).unwrap();
+    let caller = "<?php\nuse App\\Models\\Bakery as Bread;\n$bakery = new Bread();\n/* 😀 property */ $bakery->quality;\n/* 😀 method */ $bakery->quality();\n";
+    for case in cases {
+        for crlf in [false, true] {
+            let mut files = vec![("src/Probe.php".to_owned(), caller.to_owned())];
+            for (name, body) in [
+                ("Bakery", case.model.as_str()),
+                ("Base", case.base.as_str()),
+                (
+                    "Value",
+                    case.value
+                        .as_deref()
+                        .unwrap_or("trait Value { public function quality(): int { return 7; } }"),
+                ),
+            ] {
+                let source = format!("<?php\nnamespace App\\Models;\n/* 😀 owner */ {body}\n");
+                files.push((
+                    format!("src/Models/{name}.php"),
+                    if crlf {
+                        source.replace('\n', "\r\n")
+                    } else {
+                        source
+                    },
+                ));
+            }
+            let borrowed: Vec<_> = files
+                .iter()
+                .map(|(path, text)| (path.as_str(), text.as_str()))
+                .collect();
+            let (backend, dir) = make_workspace(&borrowed);
+            for property in [true, false] {
+                let site = if property {
+                    "->quality;"
+                } else {
+                    "->quality()"
+                };
+                let prefix = &caller[..caller.find(site).unwrap() + 2];
+                let cursor = Position::new(
+                    prefix.bytes().filter(|b| *b == b'\n').count() as u32,
+                    prefix.rsplit('\n').next().unwrap().encode_utf16().count() as u32,
+                );
+                let response = open_and_goto_definition(
+                    &backend,
+                    &dir,
+                    "src/Probe.php",
+                    caller,
+                    cursor.line,
+                    cursor.character,
+                )
+                .await
+                .expect(&case.name);
+                let location = match response {
+                    GotoDefinitionResponse::Scalar(location) => location,
+                    GotoDefinitionResponse::Array(mut locations) => {
+                        assert_eq!(locations.len(), 1, "{} property={property}", case.name);
+                        locations.pop().unwrap()
+                    }
+                    other => panic!("{}: {other:?}", case.name),
+                };
+                let target = if property {
+                    case.target.replacen("app/", "src/", 1)
+                } else {
+                    "src/Models/Value.php".to_owned()
+                };
+                let source = &files.iter().find(|(path, _)| path == &target).unwrap().1;
+                let offset = if property {
+                    source.find("/* target */ ").unwrap() + "/* target */ ".len() + 1
+                } else {
+                    source.find("quality(): int").unwrap()
+                };
+                let prefix = &source[..offset];
+                let point = Position::new(
+                    prefix.bytes().filter(|b| *b == b'\n').count() as u32,
+                    prefix.rsplit('\n').next().unwrap().encode_utf16().count() as u32,
+                );
+                assert_eq!(
+                    location.uri,
+                    Url::from_file_path(dir.path().join(target)).unwrap(),
+                    "{} property={property} CRLF={crlf}",
+                    case.name
+                );
+                assert_eq!(
+                    location.range,
+                    Range::new(point, point),
+                    "{} property={property} CRLF={crlf}",
+                    case.name
+                );
+            }
+        }
+    }
+}

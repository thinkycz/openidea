+#[test]
+fn trait_casts_follow_effective_method_and_property_declarations() {
+    let source = concat!(
+        "<?php\n",
+        "namespace Illuminate\\Database\\Eloquent { class Model {} }\n",
+        "namespace {\n",
+        "trait BoolCasts { protected function casts(): array { return ['quality' => 'bool']; } }\n",
+        "trait EmptyCasts { protected function casts(): array { return []; } }\n",
+        "trait NestedCasts { use BoolCasts; }\n",
+        "class OwnProperty extends \\Illuminate\\Database\\Eloquent\\Model { use BoolCasts; protected $casts = ['quality' => 'float']; }\n",
+        "class OwnMethod extends OwnProperty { protected function casts(): array { return ['quality' => 'int']; } }\n",
+        "class Inherited extends OwnProperty {}\n",
+        "class Nested extends \\Illuminate\\Database\\Eloquent\\Model { use NestedCasts; protected $casts = ['quality' => 'float']; }\n",
+        "class EmptyMethod extends OwnProperty { use EmptyCasts; }\n",
+        "class Selected extends \\Illuminate\\Database\\Eloquent\\Model { use EmptyCasts, BoolCasts { BoolCasts::casts insteadof EmptyCasts; } protected $casts = ['quality' => 'float']; }\n",
+        "}\n",
+    );
+    let (mut parsed, blocks) =
+        crate::Backend::parse_php_classes_by_block(source, None, false, false);
+    crate::Backend::resolve_parent_class_names_by_block(
+        &mut parsed,
+        &blocks,
+        &HashMap::new(),
+        &None,
+    );
+    let models: HashMap<_, _> = parsed
+        .into_iter()
+        .map(|(class, _, _)| (class.fqn().to_string(), Arc::new(class)))
+        .collect();
+    let loader = |name: &str| models.get(name).cloned();
+    assert!(extends_eloquent_model(&models["OwnProperty"], &loader));
+    assert!(
+        models["BoolCasts"].laravel().is_some(),
+        "trait casts reach metadata"
+    );
+    for (name, expected) in [
+        ("OwnProperty", "bool"),
+        ("OwnMethod", "int"),
+        ("Inherited", "bool"),
+        ("Nested", "bool"),
+        ("EmptyMethod", "float"),
+        ("Selected", "bool"),
+    ] {
+        let class = inherited_private_trait_resolved(&models, name);
+        assert_eq!(
+            class.laravel().unwrap().casts_definitions,
+            vec![("quality".into(), expected.into())],
+            "{name} selects effective casts() independently of $casts"
+        );
+    }
+}

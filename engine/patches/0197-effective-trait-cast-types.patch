+
+pub(crate) fn extract_cast_metadata<'a>(
+    members: impl Iterator<Item = &'a class_like::member::ClassLikeMember<'a>>,
+    content: &str,
+) -> LaravelMetadata {
+    let (property_casts, method_casts) = extract_cast_sources(members, content);
+    let mut declared = 0;
+    if property_casts.is_some() {
+        declared |= model_declaration::CASTS_PROPERTY;
+    }
+    if method_casts.is_some() {
+        declared |= model_declaration::CASTS_METHOD;
+    }
+    let (casts_definitions, cast_sources) = match (property_casts, method_casts) {
+        (Some(property), Some(method)) => {
+            let merged = overlay_casts(&property, &method);
+            (merged, Some(Box::new(CastSources { property, method })))
+        }
+        (Some(only), None) | (None, Some(only)) => (only, None),
+        (None, None) => (Vec::new(), None),
+    };
+
+    LaravelMetadata {
+        casts_definitions,
+        cast_sources,
+        declared,
+        ..Default::default()
+    }
+}
+
+/// Select cast sources independently using the same trait precedence as members.
+pub(crate) fn resolve_effective_model_casts(
+    merged: &mut crate::types::ClassInfo,
+    class: &crate::types::ClassInfo,
+    loader: &dyn Fn(&str) -> Option<std::sync::Arc<crate::types::ClassInfo>>,
+) {
+    use crate::inheritance::ancestry::{find_declaring_ancestor, find_declaring_member_ancestor};
+    use model_declaration::{CASTS_METHOD, CASTS_PROPERTY};
+
+    let entries = |flag| {
+        let declares = |owner: &crate::types::ClassInfo| {
+            owner
+                .laravel()
+                .is_some_and(|meta| declared_flags(meta) & flag != 0)
+        };
+        let inherited;
+        let owner = if declares(class) {
+            class
+        } else {
+            inherited = if flag == CASTS_METHOD {
+                find_declaring_member_ancestor(class, Some("casts"), loader, &declares)
+            } else {
+                find_declaring_ancestor(class, loader, &declares)
+            }?;
+            &inherited.1
+        };
+        let meta = owner.laravel()?;
+        let (property, method) = cast_parts(meta, declared_flags(meta));
+        if flag == CASTS_METHOD {
+            method
+        } else {
+            property
+        }
+        .map(<[_]>::to_vec)
+    };
+    let property = entries(CASTS_PROPERTY);
+    let method = entries(CASTS_METHOD);
+    if property.is_none() && method.is_none() {
+        return;
+    }
+    let meta = merged.laravel_mut();
+    meta.declared &= !(CASTS_PROPERTY | CASTS_METHOD);
+    if property.is_some() {
+        meta.declared |= CASTS_PROPERTY;
+    }
+    if method.is_some() {
+        meta.declared |= CASTS_METHOD;
+    }
+    match (property, method) {
+        (Some(property), Some(method)) => {
+            meta.casts_definitions = overlay_casts(&property, &method);
+            meta.cast_sources = Some(Box::new(CastSources { property, method }));
+        }
+        (Some(only), None) | (None, Some(only)) => {
+            meta.casts_definitions = only;
+            meta.cast_sources = None;
+        }
+        (None, None) => unreachable!(),
     }
 }
 

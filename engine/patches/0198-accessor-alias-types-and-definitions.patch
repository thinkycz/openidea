+#[test]
+fn accessor_aliases_keep_real_php_member_precedence() {
+    let mut user = make_class("App\\Models\\User");
+    user.parent_class = Some(atom(ELOQUENT_MODEL_FQN));
+    user.laravel_mut().casts_definitions = vec![("qualityLabel".into(), "bool".into())];
+    user.methods.push(Arc::new(make_method(
+        "getQualityLabelAttribute",
+        Some("string"),
+    )));
+    user.methods
+        .push(Arc::new(make_method("qualityLabel", Some("int"))));
+    let mut physical =
+        crate::types::PropertyInfo::virtual_property_typed("qualityLabel", Some(&PhpType::bool()));
+    physical.is_virtual = false;
+    user.properties.push(Arc::new(physical));
+    let model = Arc::new(make_class(ELOQUENT_MODEL_FQN));
+    let loader = |name: &str| {
+        if name == ELOQUENT_MODEL_FQN {
+            Some(Arc::clone(&model))
+        } else {
+            None
+        }
+    };
+    let resolved = crate::virtual_members::resolve_class_fully(&user, &loader);
+    assert_eq!(
+        resolved
+            .get_property("qualityLabel")
+            .unwrap()
+            .type_hint_str()
+            .as_deref(),
+        Some("bool")
+    );
+    assert_eq!(
+        resolved
+            .get_method_ci("qualityLabel")
+            .unwrap()
+            .return_type
+            .as_ref()
+            .unwrap()
+            .to_string(),
+        "int"
+    );
+}

+#[test]
+fn accessor_aliases_follow_runtime_getter_precedence() {
+    for (legacy, modern, casts, expected) in [
+        (true, None, true, "string"),
+        (true, None, false, "string"),
+        (false, Some("string"), true, "string"),
+        (false, Some("string"), false, "string"),
+        (false, Some("never"), true, "bool"),
+        (true, Some("int"), true, "string"),
+    ] {
+        let mut user = make_class("App\\Models\\User");
+        user.parent_class = Some(atom(ELOQUENT_MODEL_FQN));
+        if casts {
+            user.laravel_mut().casts_definitions = vec![("qualityLabel".into(), "bool".into())];
+        }
+        if let Some(get_type) = modern {
+            user.methods.push(Arc::new(make_method(
+                "qualityLabel",
+                Some(&format!(
+                    "Illuminate\\Database\\Eloquent\\Casts\\Attribute<{get_type}, string>"
+                )),
+            )));
+        }
+        if legacy {
+            user.methods.push(Arc::new(make_method(
+                "getQualityLabelAttribute",
+                Some("string"),
+            )));
+        }
+        let model = Arc::new(make_class(ELOQUENT_MODEL_FQN));
+        let loader = |name: &str| {
+            if name == ELOQUENT_MODEL_FQN {
+                Some(Arc::clone(&model))
+            } else {
+                None
+            }
+        };
+        let resolved = crate::virtual_members::resolve_class_fully(&user, &loader);
+        let property = resolved
+            .get_property("qualityLabel")
+            .expect("runtime camelCase attribute");
+        assert_eq!(
+            property.type_hint_str().as_deref(),
+            Some(expected),
+            "legacy={legacy} modern={modern:?} casts={casts}"
+        );
+    }
+}

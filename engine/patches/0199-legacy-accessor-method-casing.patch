+#[test]
+fn legacy_accessor_and_mutator_names_follow_php_case_insensitivity() {
+    for name in [
+        "getQualityLabelAttribute",
+        "GETQualityLabelAttribute",
+        "getQualityLabelATTRIBUTE",
+        "getqualityLabelAttribute",
+        "getqualitylabelattribute",
+        "GETQUALITYLABELATTRIBUTE",
+    ] {
+        assert!(
+            is_legacy_accessor(&make_method(name, Some("string"))),
+            "{name}"
+        );
+        let setter = format!("set{}", &name[3..]);
+        assert!(is_legacy_mutator(&make_method(&setter, None)), "{setter}");
+        assert!(is_legacy_mutator(&make_method(
+            &setter.to_uppercase(),
+            None
+        )));
+    }
+    for name in [
+        "getAttribute",
+        "GETATTRIBUTE",
+        "setAttribute",
+        "SETATTRIBUTE",
+        "get",
+        "",
+        "attributes",
+        "getfoo_barAttribute",
+        "😀fooAttribute",
+        "setfoo_barAttribute",
+        "get_underAttribute",
+        "set_underAttribute",
+    ] {
+        assert!(!is_legacy_accessor(&make_method(name, None)), "{name}");
+        assert!(!is_legacy_mutator(&make_method(name, None)), "{name}");
+    }
+}
+
+#[test]
+fn accessor_method_lookup_uses_php_method_casing() {
+    for (declared, queried) in [
+        ("GETQualityLabelATTRIBUTE", "getQualityLabelAttribute"),
+        ("setqualitylabelattribute", "setQualityLabelAttribute"),
+    ] {
+        let mut class = make_class("App\\Models\\Bakery");
+        class
+            .methods
+            .push(Arc::new(make_method(declared, Some("string"))));
+        assert!(
+            is_accessor_or_mutator_method(&class, queried),
+            "{declared} {queried}"
+        );
+    }
+}

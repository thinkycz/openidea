+#[tokio::test]
+async fn trait_accessor_properties_follow_original_method_definitions() {
+    let cases: serde_json::Value =
+        serde_json::from_str(include_str!("fixtures/eloquent_trait_accessors.json")).unwrap();
+    for case in cases.as_array().unwrap() {
+        let files: Vec<(String, String)> = case["files"]
+            .as_object()
+            .unwrap()
+            .iter()
+            .map(|(path, source)| {
+                (
+                    path.replacen("app/", "src/", 1),
+                    source.as_str().unwrap().to_string(),
+                )
+            })
+            .collect();
+        let refs: Vec<(&str, &str)> = files
+            .iter()
+            .map(|(path, source)| (path.as_str(), source.as_str()))
+            .collect();
+        let (backend, dir) = make_workspace(&refs);
+        let caller = case["caller"].as_str().unwrap();
+        let uri = Url::from_file_path(dir.path().join("src/Probe.php")).unwrap();
+        open_php(&backend, &uri, caller).await;
+        let path = case["definition_file"].as_str().unwrap();
+        let source = case["files"][path].as_str().unwrap();
+        let physical = case["physical"].as_bool().unwrap();
+        let prefix = if physical { "$" } else { "function " };
+        let token = format!("{}{}", prefix, case["definition_name"].as_str().unwrap());
+        let offset = source.find(&token).unwrap() + prefix.len();
+        let point = Position::new(0, source[..offset].encode_utf16().count() as u32);
+        for line in [2, 3] {
+            let text = caller.lines().nth(line as usize).unwrap();
+            let column = text[..text.find("->").unwrap() + 2].encode_utf16().count() as u32;
+            let response = goto_definition_at(&backend, &uri, line, column).await;
+            let location = match response {
+                Some(GotoDefinitionResponse::Scalar(location)) => location,
+                Some(GotoDefinitionResponse::Array(mut locations)) => {
+                    assert_eq!(locations.len(), 1);
+                    locations.pop().unwrap()
+                }
+                other => panic!("{} line={line}: {other:?}", case["name"]),
+            };
+            assert_eq!(
+                location.uri,
+                Url::from_file_path(dir.path().join(path.replacen("app/", "src/", 1))).unwrap(),
+                "{} line={line}",
+                case["name"]
+            );
+            assert_eq!(
+                location.range,
+                Range::new(point, point),
+                "{} line={line}",
+                case["name"]
+            );
+        }
+    }
+}

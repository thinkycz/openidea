+
+/// Whether this access reaches a real instance property without magic dispatch.
+pub(crate) fn can_access_instance_property(
+    class: &Arc<ClassInfo>,
+    name: &str,
+    current_class: Option<&ClassInfo>,
+    class_loader: &dyn Fn(&str) -> Option<Arc<ClassInfo>>,
+) -> bool {
+    let physical = class
+        .properties
+        .iter()
+        .any(|property| !property.is_virtual && !property.is_static && property.name == name);
+    match judge_branch(
+        class,
+        name,
+        false,
+        false,
+        current_class,
+        false,
+        class_loader,
+        false,
+    ) {
+        BranchVerdict::AccessiblePrivateAncestor => true,
+        BranchVerdict::Permitted => physical,
+        _ => false,
+    }
 }
 

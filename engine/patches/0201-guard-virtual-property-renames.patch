+//! Runtime property names may require accessor or schema transformations.
+use crate::Backend;
+use crate::class_lookup::find_class_at_offset;
+use crate::diagnostics::member_visibility::can_access_instance_property;
+use crate::symbol_map::{SymbolKind, SymbolSpan};
+use crate::types::Visibility;
+use crate::virtual_members::laravel::{
+    extends_eloquent_model, property_rename_binding_requires_transform,
+};
+use std::sync::Arc;
+
+impl Backend {
+    pub(super) fn eloquent_property_rename_requires_transform(
+        &self,
+        uri: &str,
+        content: &str,
+        span: &SymbolSpan,
+        new_name: Option<&str>,
+    ) -> bool {
+        let SymbolKind::MemberAccess {
+            subject_text,
+            member_name,
+            is_static: false,
+            is_method_call: false,
+            ..
+        } = &span.kind
+        else {
+            return false;
+        };
+        let Some(map) = self.symbol_maps.read().get(uri).cloned() else {
+            return true;
+        };
+        let Some(source) = map.source(content) else {
+            return true;
+        };
+        let ctx = self.file_context(uri);
+        let loader = self.class_loader_with(
+            &ctx.classes,
+            ctx.use_map_at(span.start),
+            ctx.namespace_at(span.start),
+        );
+        let current = find_class_at_offset(&ctx.classes, span.start);
+        self.resolve_subject_to_fqns(
+            subject_text.as_str(source),
+            false,
+            &ctx,
+            span.start,
+            content,
+        )
+        .into_iter()
+        .any(|name| {
+            let Some(class) = loader(&name) else {
+                return false;
+            };
+            if !extends_eloquent_model(&class, &loader) {
+                return false;
+            }
+            let inherited = Arc::new(crate::inheritance::resolve_class_with_inheritance(
+                &class, &loader,
+            ));
+            if inherited.properties.iter().any(|property| {
+                !property.is_virtual
+                    && !property.is_static
+                    && property.name == *member_name
+                    && property.visibility == Visibility::Public
+            }) {
+                return false;
+            }
+            let resolved = crate::virtual_members::resolve_class_fully_cached(
+                &class,
+                &loader,
+                &self.resolved_class_cache,
+            );
+            property_rename_binding_requires_transform(&resolved, member_name, new_name)
+                .unwrap_or_else(|| {
+                    !can_access_instance_property(&inherited, member_name, current, &loader)
+                })
+        })
+    }
+}

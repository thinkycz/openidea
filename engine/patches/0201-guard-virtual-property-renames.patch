+/// The generic property rename must preserve the method PHP will dispatch to.
+pub(crate) fn property_rename_binding_requires_transform(
+    class: &ClassInfo,
+    name: &str,
+    new_name: Option<&str>,
+) -> Option<bool> {
+    let getter = super::helpers::legacy_accessor_method_name(name);
+    let setter = super::helpers::legacy_mutator_method_name(name);
+    if class
+        .get_method_ci(&getter)
+        .is_some_and(|method| !method.is_virtual && is_legacy_accessor(method))
+        || class
+            .get_method_ci(&setter)
+            .is_some_and(|method| !method.is_virtual && is_legacy_mutator(method))
+    {
+        return Some(true);
+    }
+    let camel = super::helpers::snake_to_camel(name);
+    if let Some(method) = class
+        .get_method_ci(&camel)
+        .filter(|method| !method.is_virtual && is_modern_accessor(method))
+    {
+        let getter_selected = matches!(class.get_property(name)?.source.as_ref(),
+            Some(crate::types::PropertySource::Accessor { method: selected, .. }
+                | crate::types::PropertySource::ComputedProperty { method: selected, .. })
+                if selected == method.name.as_str());
+        return Some(
+            !getter_selected
+                || name != method.name.as_str()
+                || new_name.is_some_and(|new_name| {
+                    let bare = new_name.strip_prefix('$').unwrap_or(new_name);
+                    super::helpers::snake_to_camel(bare) != bare
+                }),
+        );
+    }
+    if let Some(crate::types::PropertySource::Relationship { method, .. }) = class
+        .get_property(name)
+        .and_then(|property| property.source.as_ref())
+    {
+        return Some(
+            name != method.as_str()
+                || class
+                    .get_method_ci(method)
+                    .is_none_or(|method| method.is_virtual),
+        );
+    }
+    None
+}

+#[tokio::test]
+async fn virtual_property_rename_requires_complete_runtime_bindings() {
+    use crate::common::{prepare_rename, rename_result};
+    use sha2::{Digest, Sha256};
+    let cases: serde_json::Value =
+        serde_json::from_str(include_str!("fixtures/eloquent_property_rename.json")).unwrap();
+    for case in cases.as_array().unwrap() {
+        let files: Vec<(String, String)> = case["files"]
+            .as_object()
+            .unwrap()
+            .iter()
+            .map(|(path, source)| {
+                (
+                    path.replacen("app/", "src/", 1),
+                    source.as_str().unwrap().to_string(),
+                )
+            })
+            .collect();
+        let refs: Vec<(&str, &str)> = files
+            .iter()
+            .map(|(path, source)| (path.as_str(), source.as_str()))
+            .collect();
+        let (backend, dir) = make_workspace(&refs);
+        let mut sources = files.clone();
+        sources.push((
+            "src/Probe.php".into(),
+            case["caller"].as_str().unwrap().to_string(),
+        ));
+        for (path, source) in &sources {
+            open_php(
+                &backend,
+                &Url::from_file_path(dir.path().join(path)).unwrap(),
+                source,
+            )
+            .await;
+        }
+        let path = case["query_file"]
+            .as_str()
+            .map(|p| p.replacen("app/", "src/", 1))
+            .unwrap_or_else(|| "src/Probe.php".into());
+        let source = sources.iter().find(|(p, _)| p == &path).unwrap().1.as_str();
+        let token = format!("->{}", case["property"].as_str().unwrap());
+        let before = &source[..source.find(&token).unwrap() + 2];
+        let position = Position::new(
+            before.bytes().filter(|&v| v == b'\n').count() as u32,
+            before.rsplit('\n').next().unwrap().encode_utf16().count() as u32,
+        );
+        let uri = Url::from_file_path(dir.path().join(&path)).unwrap();
+        let allowed = case["allowed_new_names"].as_array().unwrap();
+        let prepared = prepare_rename(&backend, &uri, position.line, position.character).await;
+        assert_eq!(
+            prepared.is_some(),
+            !allowed.is_empty(),
+            "{} prepare",
+            case["name"]
+        );
+        for name in ["renamedQualityLabel", "renamed_quality_label"] {
+            let permitted = allowed.iter().any(|v| v.as_str() == Some(name));
+            let standard =
+                rename_result(&backend, &uri, position.line, position.character, name).await;
+            assert_eq!(
+                matches!(standard, Ok(Some(_))),
+                permitted,
+                "{} {name} standard: {standard:?}",
+                case["name"]
+            );
+            let checked = backend
+                .workbench_rename_checked(phpantom_lsp::workbench_rename::RenameCheckedParams {
+                    rename: RenameParams {
+                        text_document_position: TextDocumentPositionParams {
+                            text_document: TextDocumentIdentifier { uri: uri.clone() },
+                            position,
+                        },
+                        new_name: name.into(),
+                        work_done_progress_params: Default::default(),
+                    },
+                    expected_sources: sources
+                        .iter()
+                        .map(
+                            |(path, source)| phpantom_lsp::workbench_rename::ExpectedSource {
+                                uri: Url::from_file_path(dir.path().join(path)).unwrap(),
+                                version: 1,
+                                sha256_utf8: format!("{:x}", Sha256::digest(source.as_bytes())),
+                            },
+                        )
+                        .collect(),
+                })
+                .await;
+            assert_eq!(
+                matches!(checked, Ok(Some(_))),
+                permitted,
+                "{} {name} checked: {checked:?}",
+                case["name"]
+            );
+        }
+    }
+}

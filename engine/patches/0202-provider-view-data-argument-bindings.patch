+    #[tokio::test]
+    async fn named_provider_bindings_keep_template_types_and_exact_member_origins() {
+        let cases: Vec<serde_json::Value> =
+            serde_json::from_str(include_str!("fixtures/named_view_provider_arguments.json"))
+                .unwrap();
+        let model =
+            "<?php\nnamespace App;\nclass Item { /* 😀 */ public string $itemOnly='item'; }\n";
+        let template = "{{-- 😀 provider --}}\n{{ $item->itemOnly }}\n";
+        let composer = "<?php namespace App; class Composer {public function compose($view):void {$view->with(value:new Item(),key:'item');}}";
+        for case in cases {
+            let provider = format!(
+                "<?php namespace App\\Providers; use Illuminate\\Support\\Facades\\View; class ViewServiceProvider {{ function boot():void {{ {} }} }}",
+                case["call"].as_str().unwrap()
+            );
+            let (backend, dir) = create_psr4_workspace(
+                COMPOSER_JSON,
+                &[
+                    ("bootstrap/providers.php", PROVIDERS_PHP),
+                    ("app/Providers/ViewServiceProvider.php", &provider),
+                    ("app/Item.php", model),
+                    (
+                        "app/Other.php",
+                        "<?php namespace App; class Other {public int $otherOnly=7;}",
+                    ),
+                    ("app/Composer.php", composer),
+                    (
+                        "vendor/illuminate/Foundation/Application.php",
+                        APPLICATION_CLASS,
+                    ),
+                    ("resources/views/profile.blade.php", template),
+                    ("resources/views/other.blade.php", template),
+                ],
+            );
+            let uri =
+                open_initialized_blade_template(&backend, "resources/views/profile.blade.php")
+                    .await;
+            for (target, uri) in [
+                ("profile", uri),
+                (
+                    "other",
+                    open_blade_template(&backend, "resources/views/other.blade.php").await,
+                ),
+            ] {
+                let expected =
+                    case["expected"] == true && (target == "profile" || case["scope"] == "shared");
+                let labels = crate::common::complete_labels_at_opened(&backend, &uri, 1, 12).await;
+                assert_eq!(
+                    labels.iter().any(|name| name == "itemOnly"),
+                    expected,
+                    "{} {target}: {labels:?}",
+                    case["name"]
+                );
+                assert!(
+                    !labels.iter().any(|name| name == "otherOnly"),
+                    "{} must ignore the scalar value when key is an array",
+                    case["name"]
+                );
+                let targets = crate::common::definition_locations(
+                    crate::common::goto_definition_at(&backend, &uri, 1, 12).await,
+                );
+                if expected {
+                    let before = &model[..model.find("$itemOnly").unwrap() + 1];
+                    let point = tower_lsp::lsp_types::Position::new(
+                        2,
+                        before.rsplit('\n').next().unwrap().encode_utf16().count() as u32,
+                    );
+                    assert_eq!(targets.len(), 1, "{} {target}: {targets:?}", case["name"]);
+                    assert_eq!(
+                        targets[0].uri,
+                        tower_lsp::lsp_types::Url::from_file_path(dir.path().join("app/Item.php"))
+                            .unwrap()
+                    );
+                    assert_eq!(
+                        targets[0].range,
+                        tower_lsp::lsp_types::Range::new(point, point)
+                    );
+                } else {
+                    assert!(targets.is_empty(), "{} {target}: {targets:?}", case["name"]);
+                }
+            }
+        }
+    }
 }

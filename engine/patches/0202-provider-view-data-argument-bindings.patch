+#[test]
+fn named_provider_view_data_bindings_preserve_runtime_slots() {
+    let cases: Vec<serde_json::Value> = serde_json::from_str(include_str!(
+        "../../../tests/integration/fixtures/named_view_provider_arguments.json"
+    ))
+    .unwrap();
+    for case in cases {
+        let content = format!(
+            "<?php class ViewServiceProvider {{ function boot(): void {{ {} }} }}",
+            case["call"].as_str().unwrap()
+        );
+        let resources = scan(&content);
+        let expected = case["expected"].as_bool().unwrap();
+        if !expected {
+            assert!(
+                resources.shared_view_vars.is_empty() && resources.view_composers.is_empty(),
+                "{} invalid bindings must expose nothing",
+                case["name"]
+            );
+        } else if case["scope"] == "shared" {
+            assert_eq!(resources.shared_view_vars.len(), 1, "{}", case["name"]);
+            let value = &resources.shared_view_vars[0];
+            assert_eq!(value.name, "item", "{}", case["name"]);
+            assert!(
+                expression_at(&content, value.offset).starts_with("new \\App\\Item("),
+                "{} must retain the key's value expression, not a reordered argument or ignored value",
+                case["name"]
+            );
+            assert!(resources.view_composers.is_empty());
+        } else {
+            assert_eq!(resources.view_composers.len(), 1, "{}", case["name"]);
+            let composer = &resources.view_composers[0];
+            assert_eq!(composer.views, ["profile"], "{}", case["name"]);
+            if case["name"] == "composer_class_named_reordered"
+                || case["name"] == "composers_named_table"
+            {
+                assert!(
+                    composer
+                        .class
+                        .as_deref()
+                        .is_some_and(|class| class.ends_with("App\\Composer")),
+                    "{}: {:?}",
+                    case["name"],
+                    composer.class
+                );
+            } else {
+                assert_eq!(composer.inline.len(), 1, "{}", case["name"]);
+                assert_eq!(composer.inline[0].name, "item");
+                assert!(
+                    expression_at(&content, composer.inline[0].offset)
+                        .starts_with("new \\App\\Item("),
+                    "{}",
+                    case["name"]
+                );
+            }
+            assert!(resources.shared_view_vars.is_empty());
+        }
+    }
+}

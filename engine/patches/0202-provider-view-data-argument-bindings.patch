+/// Unknown named parameters cannot bind these non-variadic framework methods.
+fn known_named_arguments(arguments: &ArgumentList<'_>, names: &[&str]) -> bool {
+    arguments.arguments.iter().all(|argument| match argument {
+        Argument::Named(argument) => names.contains(&bytes_to_str(argument.name.value)),
+        Argument::Positional(_) => true,
+    })
+}

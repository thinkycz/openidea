+    /// Provider registrations may retarget any lowered view. Composer bodies
+    /// affect the patterns of their current registrations only.
+    pub(crate) fn blade_provider_dependency_targets(
+        &self,
+        uri: &str,
+    ) -> std::collections::HashSet<String> {
+        if self.is_blade_file(uri) || !self.laravel_provider_scans.read().is_built() {
+            return Default::default();
+        }
+        let mut aliases = self.symbols.source_authority.aliases(uri);
+        aliases.insert(uri.to_owned());
+        let provider = self.is_laravel_provider_list_uri(uri)
+            || self
+                .laravel_provider_scans
+                .read()
+                .scans_for_uris(&aliases)
+                .next()
+                .is_some();
+        let patterns: Vec<String> = if provider {
+            Vec::new()
+        } else {
+            let resources = self.laravel_provider_resources.read();
+            let index = self.symbols.fqn_uri_index.read();
+            let patterns: Vec<_> = resources
+                .view_composers
+                .iter()
+                .filter(|composer| {
+                    composer
+                        .class
+                        .as_ref()
+                        .and_then(|class| index.get(class.trim_start_matches('\\')))
+                        .is_some_and(|source| aliases.contains(source))
+                })
+                .flat_map(|composer| composer.views.iter().cloned())
+                .collect();
+            if patterns.is_empty() {
+                return Default::default();
+            }
+            patterns
+        };
+        let lowered: Vec<_> = self.blade_virtual_content.read().keys().cloned().collect();
+        lowered
+            .into_iter()
+            .filter(|target| {
+                provider
+                    || self.view_names_for_blade_uri(target).iter().any(|name| {
+                        patterns
+                            .iter()
+                            .any(|pattern| view_pattern_matches(pattern, name))
+                    })
+            })
+            .collect()
+    }

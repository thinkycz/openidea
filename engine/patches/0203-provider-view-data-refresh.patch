+#[tokio::test]
+async fn provider_view_data_refreshes_without_template_edits() {
+    use crate::common::{complete_labels_at_opened, open_php, position_after};
+    use tower_lsp::{LanguageServer, lsp_types::*};
+    const TEMPLATE: &str = "{{-- 😀 --}}\n{{ $user-> }}\n";
+    let (backend, dir) = tests::workspace(&[("resources/views/profile.blade.php", TEMPLATE)]);
+    let provider =
+        Url::from_file_path(dir.path().join("app/Providers/ViewServiceProvider.php")).unwrap();
+    let composer =
+        Url::from_file_path(dir.path().join("app/View/Composers/ProfileComposer.php")).unwrap();
+    let profile = crate::common::open_initialized_blade_template(
+        &backend,
+        "resources/views/profile.blade.php",
+    )
+    .await;
+    open_php(&backend, &provider, tests::VIEW_SERVICE_PROVIDER).await;
+    open_php(&backend, &composer, tests::PROFILE_COMPOSER).await;
+    async fn labels(backend: &phpantom_lsp::Backend, uri: &Url) -> Vec<String> {
+        let pos = position_after(TEMPLATE, "$user->");
+        complete_labels_at_opened(backend, uri, pos.line, pos.character).await
+    }
+    assert!(
+        labels(&backend, &profile)
+            .await
+            .iter()
+            .any(|v| v == "email")
+    );
+    let changed = tests::PROFILE_COMPOSER.replace("new User()", "new \\App\\Support\\Menu()");
+    backend
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: composer.clone(),
+                version: 2,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: changed,
+            }],
+        })
+        .await;
+    let current = labels(&backend, &profile).await;
+    assert!(
+        current.iter().any(|v| v == "items()"),
+        "dirty composer: {current:?}"
+    );
+    assert!(!current.iter().any(|v| v == "email"));
+    let removed = tests::VIEW_SERVICE_PROVIDER
+        .replace("View::composer('profile', ProfileComposer::class);", "");
+    backend
+        .did_change(DidChangeTextDocumentParams {
+            text_document: VersionedTextDocumentIdentifier {
+                uri: provider.clone(),
+                version: 2,
+            },
+            content_changes: vec![TextDocumentContentChangeEvent {
+                range: None,
+                range_length: None,
+                text: removed,
+            }],
+        })
+        .await;
+    let current = labels(&backend, &profile).await;
+    assert!(
+        !current.iter().any(|v| v == "items()" || v == "email"),
+        "removed registration: {current:?}"
+    );
+    backend
+        .did_close(DidCloseTextDocumentParams {
+            text_document: TextDocumentIdentifier {
+                uri: provider.clone(),
+            },
+        })
+        .await;
+    assert!(
+        labels(&backend, &profile)
+            .await
+            .iter()
+            .any(|v| v == "items()")
+    );
+    backend
+        .did_close(DidCloseTextDocumentParams {
+            text_document: TextDocumentIdentifier {
+                uri: composer.clone(),
+            },
+        })
+        .await;
+    let current = labels(&backend, &profile).await;
+    assert!(
+        current.iter().any(|v| v == "email"),
+        "discarded composer: {current:?}"
+    );
+    assert!(!current.iter().any(|v| v == "items()"));
+    backend
+        .did_close(DidCloseTextDocumentParams {
+            text_document: TextDocumentIdentifier { uri: provider },
+        })
+        .await;
+    backend
+        .did_close(DidCloseTextDocumentParams {
+            text_document: TextDocumentIdentifier { uri: composer },
+        })
+        .await;
+    assert!(
+        labels(&backend, &profile)
+            .await
+            .iter()
+            .any(|v| v == "email")
+    );

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenStorm",
  "version": "0.1.53",
  "identifier": "cz.thinky.openstorm",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/verify-phpantom.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "OpenStorm",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#E9EAEE",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob: https://avatars.githubusercontent.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; frame-src http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "DeveloperTool",
    "copyright": "Copyright \u00a9 2026 OpenIDEA contributors",
    "license": "Apache-2.0",
    "shortDescription": "A PHP and Laravel IDE",
    "longDescription": "OpenStorm is a PHP and Laravel IDE built on OpenIDEA. Not affiliated with JetBrains.",
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "11.0"
    },
    "resources": {
      "resources/phpantom/": "phpantom/"
    }
  },
  "mainBinaryName": "openidea",
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
